-- Point an ImageLabel or ImageButton at a sprite. sliceScale is the 9-slice corner scale
-- (1080p: 1 / Scale; the SliceScaler script adjusts it to the screen height).
function UIKit.apply(label: ImageLabel | ImageButton, name: string, sliceScale: number?)
	local s = UIKit.Sprites[name]
	assert(s, "UIKit: no sprite " .. name)
	label.Image = s.image
	label.ImageRectOffset = s.offset
	label.ImageRectSize = s.size
	label.BackgroundTransparency = 1
	if s.slice then
		label.ScaleType = Enum.ScaleType.Slice
		label.SliceCenter = s.slice
		label.SliceScale = sliceScale or (1 / UIKit.Scale)
	else
		label.ScaleType = Enum.ScaleType.Stretch
	end
	label:SetAttribute("Sprite", name)
end

return UIKit
