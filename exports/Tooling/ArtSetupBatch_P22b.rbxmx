<ProtectedString name="Source"><![CDATA[return function()
local AssetSetup = require(game:GetService("ServerStorage").ArtPipeline.AssetSetup)
local HttpService = game:GetService("HttpService")
local hexes = HttpService:JSONDecode([==[{"teal":"#2F6F73","mint":"#8CC2B5","cream":"#F2E6C9","porcelain":"#F7F5EE","signal":"#E8743B","hazard":"#F2C14E","blush":"#E8A09A","skyblue":"#9DC4DB","chrome":"#DADFE3","steel":"#8D969D","gunmetal":"#4A5259","rubber":"#23262A","navy":"#1B2A3A","copper":"#B8743A","brass":"#C8A23E","olive":"#5E6A44","pine":"#C49A63","walnut":"#6B4630","leather":"#8C5B3B","rust":"#B5412B","plum":"#6E4766","avocado":"#8A9A46","leaf":"#6F9B4C","forest":"#3D5C35","sandstone":"#A39A8C","stone":"#6F665C","basalt":"#403B37","ash":"#8E8C88","murk":"#2D4A57","crystal":"#8FE3E0","glow":"#7CFF9B"}]==])
local pipe = game:GetService("ServerStorage").Assets.Pipeline
local report = {}
do local m = pipe:FindFirstChild("Cutscene_Strata") if not m then table.insert(report, "Cutscene_Strata: not in Pipeline") else local ok, r = pcall(AssetSetup.run, m, HttpService:JSONDecode([==[{"asset":"Cutscene_Strata","category":"Cutscene","size":[520.0,130.198,4.535],"tris":7814,"parts":[{"name":"Decor","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":true,"swatches":["ash"],"offset":[0.0,63.099,-1.932],"size":[520.0,130.198,4.535]},{"name":"DecorNeonCream","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"swatches":["cream"],"offset":[0.0,70.7,-1.985],"size":[11.8,112.8,1.47]},{"name":"DecorNeonHazard","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"swatches":["hazard"],"offset":[30.2,34.8,-1.5],"size":[212.02,0.5,0.5]}],"sockets":{"Foot":{"p":[0.0,0.0,0.0],"yaw":0.0},"Top":{"p":[0.0,128.0,0.0],"yaw":0.0}},"fbx_sha1":"5eb044ab337374a3","attrs":{"Face":"front -Y; the game turns it to face the Command View's camera"}}]==]), { assetId = "85046200005989", swatchHex = hexes }) table.insert(report, "Cutscene_Strata: " .. tostring(r)) end end
do local m = pipe:FindFirstChild("Cutscene_SourceGlimpse") if not m then table.insert(report, "Cutscene_SourceGlimpse: not in Pipeline") else local ok, r = pcall(AssetSetup.run, m, HttpService:JSONDecode([==[{"asset":"Cutscene_SourceGlimpse","category":"Cutscene","size":[260.0,126.721,9.188],"tris":3776,"parts":[{"name":"Decor","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":true,"swatches":["basalt"],"offset":[0.0,0.0,-3.375],"size":[260.0,124.0,9.188]},{"name":"DecorNeonGlow","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"swatches":["glow"],"offset":[-8.224,1.368,-5.361],"size":[235.88,126.705,3.268]},{"name":"Eye1","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye1","swatches":["glow"],"offset":[0.0,0.0,-4.25],"size":[19.2,9.681,0.5]},{"name":"Eye1Pupil","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye1Pupil","swatches":["rubber"],"offset":[0.0,0.0,-4.61],"size":[3.84,9.016,0.22]},{"name":"Eye2","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye2","swatches":["glow"],"offset":[15.0,6.6,-4.25],"size":[6.21,3.284,0.5]},{"name":"Eye2Pupil","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye2Pupil","swatches":["rubber"],"offset":[15.0,6.6,-4.61],"size":[1.395,3.027,0.22]},{"name":"Eye3","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye3","swatches":["glow"],"offset":[-14.0,8.0,-4.25],"size":[7.434,3.847,0.5]},{"name":"Eye3Pupil","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye3Pupil","swatches":["rubber"],"offset":[-14.0,8.0,-4.61],"size":[1.545,3.593,0.22]},{"name":"Eye4","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye4","swatches":["glow"],"offset":[9.0,-9.4,-4.25],"size":[5.121,2.63,0.5]},{"name":"Eye4Pupil","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye4Pupil","swatches":["rubber"],"offset":[9.0,-9.4,-4.61],"size":[1.024,2.455,0.22]},{"name":"Eye5","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye5","swatches":["glow"],"offset":[-17.5,-5.0,-4.25],"size":[5.575,3.103,0.5]},{"name":"Eye5Pupil","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye5Pupil","swatches":["rubber"],"offset":[-17.5,-5.0,-4.61],"size":[1.374,2.829,0.22]},{"name":"Eye6","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye6","swatches":["glow"],"offset":[21.5,-3.2,-4.25],"size":[4.376,2.212,0.5]},{"name":"Eye6Pupil","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye6Pupil","swatches":["rubber"],"offset":[21.5,-3.2,-4.61],"size":[0.875,2.064,0.22]},{"name":"Eye7","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye7","swatches":["glow"],"offset":[-5.5,12.6,-4.25],"size":[3.99,2.002,0.5]},{"name":"Eye7Pupil","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":false,"role":"Eye7Pupil","swatches":["rubber"],"offset":[-5.5,12.6,-4.61],"size":[0.798,1.866,0.22]}],"sockets":{"Eye":{"p":[0.0,0.0,-4.5],"yaw":0.0}},"fbx_sha1":"be332d69f23a1aa3","attrs":{"Face":"front -Y; origin the great eye; Eye<n> and Eye<n>Pupil open by their height"}}]==]), { assetId = "99512688533587", swatchHex = hexes }) table.insert(report, "Cutscene_SourceGlimpse: " .. tostring(r)) end end
return table.concat(report, "\n")

end
