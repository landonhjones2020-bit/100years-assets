<string name="Name">ArtSetupBatch_P21lobby</string>
<ProtectedString name="Source"><![CDATA[return function()
local SS = game:GetService("ServerStorage")
local folder = SS:FindFirstChild("ArtPipeline") or Instance.new("Folder")
folder.Name = "ArtPipeline"
folder.Parent = SS
local oldm = folder:FindFirstChild("AssetSetup")
if oldm then oldm:Destroy() end
local mod = Instance.new("ModuleScript")
mod.Name = "AssetSetup"
mod.Source = [====[
local CollectionService = game:GetService("CollectionService")
local ServerStorage = game:GetService("ServerStorage")
local AssetSetup = {}
local TOLERANCE = 0.01
local FIDELITY: { [string]: Enum.CollisionFidelity } = {
	none = Enum.CollisionFidelity.Box,
	query = Enum.CollisionFidelity.Box,
	queryhull = Enum.CollisionFidelity.Hull, -- a boss's body: raycasts follow its shape (Prompt 15)
	box = Enum.CollisionFidelity.Box,
	hull = Enum.CollisionFidelity.Hull,
	precise = Enum.CollisionFidelity.PreciseConvexDecomposition,
}
local NO_TEXTURE: { [string]: boolean } = { Neon = true, Glass = true, ForceField = true }
local function vec(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end
local function hexColor(h: string?): Color3
	if not h then
		return Color3.new(1, 1, 1)
	end
	return Color3.fromHex(h)
end
function AssetSetup.run(model: Model, doc: any, opts: { assetId: string, swatchHex: { [string]: string }? }): string
	local report = {}
	local function say(s: string)
		table.insert(report, s)
	end
	local assets = ServerStorage:WaitForChild("Assets")
	local palette = {
		color = assets:GetAttribute("PaletteColor"),
		metalness = assets:GetAttribute("PaletteMetalness"),
		roughness = assets:GetAttribute("PaletteRoughness"),
	}
	assert(palette.color, "ServerStorage.Assets has no PaletteColor attribute")
	if doc.rig then
		return "rigs are set up by the rig step (Motor6Ds from doc.rig), not by AssetSetup.run"
	end
	for _, d in model:GetDescendants() do
		if d:IsA("PackageLink") then
			d:Destroy()
		end
	end
	model.Name = doc.asset
	local pivot = model.WorldPivot
	local problems = 0
	for _, spec in doc.parts do
		local part = model:FindFirstChild(spec.name, true)
		if not (part and part:IsA("MeshPart")) then
			say("missing MeshPart " .. spec.name)
			problems += 1
			continue
		end
		local size = vec(spec.size)
		local offset = vec(spec.offset)
		local rel = pivot:PointToObjectSpace(part.Position)
		if (part.Size - size).Magnitude > TOLERANCE or (rel - offset).Magnitude > TOLERANCE then
			say(string.format("%s: size %s (want %s), offset %s (want %s)", spec.name, tostring(part.Size),
				tostring(size), tostring(rel), tostring(offset)))
			problems += 1
		end
		local queryOnly = spec.collision == "query" or spec.collision == "queryhull"
		local collide = spec.collision ~= "none" and not queryOnly
		part.Anchored = true
		part.CanCollide = collide
		part.CanQuery = collide or queryOnly
		part.CanTouch = collide
		part.CollisionFidelity = FIDELITY[spec.collision] or Enum.CollisionFidelity.Box
		part.CastShadow = spec.castShadow
		part.Transparency = spec.transparency
		part.Material = (Enum.Material :: any)[spec.material]
		for _, old in part:GetChildren() do
			if old:IsA("SurfaceAppearance") then
				old:Destroy()
			end
		end
		if NO_TEXTURE[spec.material] then
			local first = spec.swatches[1]
			local hx = opts.swatchHex and first and opts.swatchHex[first]
			part.TextureID = ""
			part.Color = hexColor(hx)
		else
			part.TextureID = ""
			part.Color = hexColor(spec.tint)
			local sa = Instance.new("SurfaceAppearance")
			sa.ColorMap = palette.color
			if palette.metalness then
				sa.MetalnessMap = palette.metalness
			end
			if palette.roughness then
				sa.RoughnessMap = palette.roughness
			end
			sa.AlphaMode = Enum.AlphaMode.Overlay
			sa.Parent = part
		end
		if spec.role then
			part:SetAttribute("Role", spec.role)
		end
	end
	for _, old in model:GetChildren() do
		if old.Name == "Colliders" or old.Name == "Lights" then
			old:Destroy()
		end
	end
	if doc.colliders then
		local folder = Instance.new("Folder")
		folder.Name = "Colliders"
		for _, c in doc.colliders do
			local box = Instance.new("Part")
			box.Name = c.n
			box.Size = vec(c.s)
			box.CFrame = pivot * CFrame.new(vec(c.p)) * CFrame.Angles(0, math.rad(c.yaw), 0)
			box.Transparency = 1
			box.Anchored = true
			box.CanCollide = true
			box.CanQuery = true
			box.CanTouch = false
			box.CastShadow = false
			if math.max(box.Size.X, box.Size.Z) < 8 then -- a lamp post or a bench must not push the camera in
				CollectionService:AddTag(box, "CameraIgnore")
			end
			box.Parent = folder
		end
		folder.Parent = model
		say(string.format("%d collider(s)", #doc.colliders))
	end
	if doc.lights then
		local holder = Instance.new("Part")
		holder.Name = "Lights"
		holder.Size = Vector3.new(1, 1, 1)
		holder.CFrame = pivot
		holder.Transparency = 1
		holder.Anchored = true
		holder.CanCollide = false
		holder.CanQuery = false
		holder.CanTouch = false
		holder.CastShadow = false
		for i, l in doc.lights do
			local at = Instance.new("Attachment")
			at.Name = "Light" .. i
			at.Position = vec(l.p)
			at.Parent = holder
			local light: Light
			if l.kind == "Spot" then
				local spot = Instance.new("SpotLight")
				spot.Angle = l.angle
				spot.Face = (Enum.NormalId :: any)[l.face]
				spot.Range = l.range
				light = spot
			else
				local point = Instance.new("PointLight")
				point.Range = l.range
				light = point
			end
			light.Color = Color3.fromHex(l.hex)
			light.Brightness = l.brightness
			light.Shadows = l.shadows
			light.Parent = at
		end
		holder.Parent = model
		say(string.format("%d light(s)", #doc.lights))
	end
	model:SetAttribute("AssetId", opts.assetId)
	model:SetAttribute("Category", doc.category)
	model:SetAttribute("Tris", doc.tris)
	model:SetAttribute("FbxSha1", doc.fbx_sha1)
	if doc.attrs then -- the generator's scalar meta (HitTime, LayTime, Role...), set by setup_batch.py
		for name, value in doc.attrs do
			model:SetAttribute(name, value)
		end
	end
	if doc.sockets then
		for name, s in doc.sockets do
			model:SetAttribute("Socket_" .. name, CFrame.new(vec(s.p)) * CFrame.Angles(0, math.rad(s.yaw), 0))
		end
	end
	CollectionService:AddTag(model, "Asset")
	if problems > 0 then
		say(string.format("%d problem(s): left in ServerStorage.Assets.Pipeline", problems))
		return table.concat(report, "\n")
	end
	local folder = assets:FindFirstChild(doc.category)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = doc.category
		folder.Parent = assets
	end
	local old = folder:FindFirstChild(doc.asset)
	if old and old ~= model then
		old:Destroy()
	end
	model:PivotTo(CFrame.new())
	model.Parent = folder
	say(string.format("%s ready in ServerStorage.Assets.%s: %d MeshPart(s), %d tris, size %s",
		doc.asset, doc.category, #doc.parts, doc.tris, tostring(vec(doc.size))))
	return table.concat(report, "\n")
end
function AssetSetup.rig(model: Model, doc: any, opts: { assetId: string, swatchHex: { [string]: string }?,
	faceImage: string?, clips: { [string]: string }? }): string
	local rig = doc.rig
	assert(rig, "AssetSetup.rig needs doc.rig")
	local stripped = table.clone(doc)
	stripped.rig = nil
	local category = doc.category
	stripped.category = "__RigStep"
	local report = AssetSetup.run(model, stripped, opts)
	local assets = ServerStorage:WaitForChild("Assets")
	local holder = assets:FindFirstChild("__RigStep")
	if model.Parent ~= holder then
		return report .. "\nrig step skipped: fix the problems above first"
	end
	local pivot = model.WorldPivot
	local hrp = model:FindFirstChild(rig.root)
	if hrp then
		hrp:Destroy()
	end
	local root = Instance.new("Part")
	root.Name = rig.root
	root.Size = vec(rig.hrpSize)
	root.CFrame = pivot * CFrame.new(vec(rig.hrpCenter))
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = true
	root.CanQuery = false
	root.CanTouch = true
	root.CastShadow = false
	root.Parent = model
	local made = 0
	for _, b in rig.bones do
		local part1 = model:FindFirstChild(b.name)
		local part0 = if b.parent then model:FindFirstChild(b.parent) else root
		assert(part1 and part1:IsA("BasePart"), "missing bone part " .. b.name)
		assert(part0 and part0:IsA("BasePart"), "missing parent part for " .. b.name)
		for _, old in part1:GetChildren() do
			if old:IsA("JointInstance") then
				old:Destroy()
			end
		end
		local j = pivot * CFrame.new(vec(b.joint))
		local m = Instance.new("Motor6D")
		m.Name = b.jointName
		m.Part0 = part0
		m.Part1 = part1
		m.C0 = part0.CFrame:ToObjectSpace(j)
		m.C1 = part1.CFrame:ToObjectSpace(j)
		m.Parent = part1
		made += 1
	end
	local boneSet = {}
	for _, b in rig.bones do
		boneSet[b.name] = true
	end
	local welded = 0
	for _, spec in doc.parts do
		local part = model:FindFirstChild(spec.name)
		if part and part:IsA("BasePart") then
			part.Anchored = false
			part.Massless = true
			if not boneSet[spec.name] and spec.bone then
				local host = model:FindFirstChild(spec.bone)
				assert(host and host:IsA("BasePart"), "missing host part " .. spec.bone)
				local w = Instance.new("WeldConstraint")
				w.Name = "RideOn_" .. spec.bone
				w.Part0 = host :: BasePart
				w.Part1 = part
				w.Parent = part
				welded += 1
			end
		end
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum:Destroy()
	end
	hum = Instance.new("Humanoid")
	hum.RigType = Enum.HumanoidRigType.R15
	hum.HipHeight = rig.hipHeight
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.Parent = model
	Instance.new("Animator").Parent = hum
	model.PrimaryPart = root
	root.PivotOffset = root.CFrame:ToObjectSpace(pivot)
	if opts.faceImage then
		local head = model:FindFirstChild("Head")
		if head then
			local face = head:FindFirstChild("face") or Instance.new("Decal")
			face.Name = "face"
			face.Face = Enum.NormalId.Front
			face.Texture = opts.faceImage
			face.Parent = head
			model:SetAttribute("FaceImage", opts.faceImage)
		end
	end
	model:SetAttribute("Category", category)
	model:SetAttribute("RigType", rig.rigType)
	model:SetAttribute("HipHeight", rig.hipHeight)
	for clip, id in opts.clips or {} do
		model:SetAttribute("Anim_" .. clip, id)
	end
	local folder = assets:FindFirstChild(category)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = category
		folder.Parent = assets
	end
	local old = folder:FindFirstChild(doc.asset)
	if old and old ~= model then
		old:Destroy()
	end
	model:PivotTo(CFrame.new())
	model.Parent = folder
	if holder and #holder:GetChildren() == 0 then
		holder:Destroy()
	end
	return (report:gsub("__RigStep", category))
		.. string.format("\nrig: %s root, %d Motor6D(s), %d welded part(s), HipHeight %.2f", rig.root, made,
			welded, rig.hipHeight)
end
return AssetSetup
]====]
mod.Parent = folder
local AssetSetup = require(mod)
local HttpService = game:GetService("HttpService")
local hexes = HttpService:JSONDecode([==[{"teal":"#2F6F73","mint":"#8CC2B5","cream":"#F2E6C9","porcelain":"#F7F5EE","signal":"#E8743B","hazard":"#F2C14E","blush":"#E8A09A","skyblue":"#9DC4DB","chrome":"#DADFE3","steel":"#8D969D","gunmetal":"#4A5259","rubber":"#23262A","navy":"#1B2A3A","copper":"#B8743A","brass":"#C8A23E","olive":"#5E6A44","pine":"#C49A63","walnut":"#6B4630","leather":"#8C5B3B","rust":"#B5412B","plum":"#6E4766","avocado":"#8A9A46","leaf":"#6F9B4C","forest":"#3D5C35","sandstone":"#A39A8C","stone":"#6F665C","basalt":"#403B37","ash":"#8E8C88","murk":"#2D4A57","crystal":"#8FE3E0","glow":"#7CFF9B"}]==])
local pipe = game:GetService("ServerStorage").Assets.Pipeline
local report = {}
do local m = pipe:FindFirstChild("Lobby_ElevatorPad") if not m then table.insert(report, "Lobby_ElevatorPad: not in Pipeline") else local ok, r = pcall(AssetSetup.run, m, HttpService:JSONDecode([==[{"asset":"Lobby_ElevatorPad","category":"Lobby","size":[13.4,19.9,15.5],"tris":1826,"parts":[{"name":"Floor","material":"SmoothPlastic","transparency":0.0,"collision":"box","castShadow":true,"role":"Floor","swatches":["steel"],"offset":[0.0,0.25,0.0],"size":[12.6,0.5,12.6]},{"name":"Decor","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":true,"swatches":["brass"],"offset":[0.0,9.95,-1.1],"size":[13.4,19.9,15.5]},{"name":"DecorNeonCream","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"swatches":["cream"],"offset":[0.0,12.18,0.0],"size":[2.6,0.16,2.473]},{"name":"Sign","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":true,"role":"Sign","swatches":["navy"],"offset":[0.0,16.9,-8.6],"size":[12.0,4.4,0.3]}],"sockets":{"Rider":{"p":[0.0,0.5,0.0],"yaw":180.0}},"fbx_sha1":"c7dca6ab7ddc6f11","attrs":{"SignFace":"Front"}}]==]), { assetId = "120668863892926", swatchHex = hexes }) table.insert(report, "Lobby_ElevatorPad: " .. tostring(r)) end end
do local m = pipe:FindFirstChild("Lobby_Showroom") if not m then table.insert(report, "Lobby_Showroom: not in Pipeline") else local ok, r = pcall(AssetSetup.run, m, HttpService:JSONDecode([==[{"asset":"Lobby_Showroom","category":"Lobby","size":[138.4,79.446,112.974],"tris":17061,"parts":[{"name":"Decor","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":true,"swatches":["ash"],"offset":[0.0,39.216,-7.287],"size":[138.0,79.032,112.974]},{"name":"Decor2","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":true,"swatches":["ash"],"offset":[-1.643,23.045,-7.637],"size":[135.515,46.69,112.274]},{"name":"DecorGlassSkyblue","material":"Glass","transparency":0.62,"collision":"none","castShadow":false,"swatches":["skyblue"],"offset":[0.0,9.775,-48.0],"size":[118.0,15.45,0.22]},{"name":"DecorGlassSkyblue_","material":"Glass","transparency":0.6,"collision":"none","castShadow":false,"swatches":["skyblue"],"offset":[0.0,6.2,-43.721],"size":[15.326,10.9,6.873]},{"name":"DecorNeonCream","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"swatches":["cream"],"offset":[0.0,13.06,-56.1],"size":[23.7,0.1,7.817]},{"name":"DecorNeonHazard","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"swatches":["hazard"],"offset":[56.4,73.5,-52.4],"size":[12.779,11.292,5.1]},{"name":"Decor_","material":"SmoothPlastic","transparency":0.0,"collision":"none","castShadow":false,"swatches":["hazard"],"offset":[-5.0,37.596,-52.42],"size":[116.638,24.246,4.113]}],"sockets":{"Bay1":{"p":[50.0,0.4,39.55],"yaw":0.0},"Bay2":{"p":[30.0,0.4,39.55],"yaw":0.0},"Bay3":{"p":[10.0,0.4,39.55],"yaw":0.0},"Bay4":{"p":[-10.0,0.4,39.55],"yaw":0.0},"Bay5":{"p":[-30.0,0.4,39.55],"yaw":0.0},"Bay6":{"p":[-50.0,0.4,39.55],"yaw":0.0},"ClassBooth":{"p":[64.3,0.4,-2.0],"yaw":90.0},"Cutaway":{"p":[35.0,0.4,-35.0],"yaw":0.0},"LoadoutBooth":{"p":[-64.3,0.4,-2.0],"yaw":270.0},"Spawn":{"p":[0.0,0.0,-78.0],"yaw":180.0}},"fbx_sha1":"c