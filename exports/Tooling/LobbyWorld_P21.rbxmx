<string name="Name">LobbyWorld_P21</string>
<ProtectedString name="Source"><![CDATA[return function()
-- LobbyWorld: generated by tools/lobby_world.py (Prompt 21). Builds workspace.Lobby.
local SS = game:GetService("ServerStorage")
local Lighting = game:GetService("Lighting")
local A = SS.Assets
local HEX = {ash = "#8E8C88", blush = "#E8A09A", cream = "#F2E6C9", gunmetal = "#4A5259", hazard = "#F2C14E", leaf = "#6F9B4C", leather = "#8C5B3B", mint = "#8CC2B5", navy = "#1B2A3A", plum = "#6E4766", porcelain = "#F7F5EE", rust = "#B5412B", sandstone = "#A39A8C", signal = "#E8743B", skyblue = "#9DC4DB", stone = "#6F665C", teal = "#2F6F73", walnut = "#6B4630"}
local TOP = 160
for _, n in {"Lobby", "LobbyBlockout", "Baseplate", "SpawnLocation"} do
	local o = workspace:FindFirstChild(n)
	if o then o:Destroy() end
end
local root = Instance.new("Folder")
root.Name = "Lobby"
root.Parent = workspace
local count = {}
local function folder(name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = root
	return f
end
-- Blender space (the showroom's frame) to Studio
local function B(x, y, z, yaw)
	return CFrame.new(-x, z or 0, y) * CFrame.Angles(0, math.rad(yaw or 0), 0)
end
local function place(category, asset, cf, parent, name, scale)
	local m = A[category][asset]:Clone()
	m.Name = name or asset
	m:PivotTo(cf)
	if scale and math.abs(scale - 1) > 0.001 then m:ScaleTo(scale) end
	m.Parent = parent
	count[asset] = (count[asset] or 0) + 1
	return m
end
local function slab(parent, name, x0, x1, y0, y1, z0, z1, swatch)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(math.abs(x1 - x0), math.abs(z1 - z0), math.abs(y1 - y0))
	p.CFrame = CFrame.new(-(x0 + x1) / 2, (z0 + z1) / 2, (y0 + y1) / 2)
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if swatch then
		p.Color = Color3.fromHex(HEX[swatch])
	else
		p.Transparency = 1
		p.CastShadow = false
		p.CanTouch = false
	end
	p.Parent = parent
	return p
end
-- A block's bodies and shop fronts go up out of reach: nobody gets onto a roof.
local RAISE = { Building = true, Wall = true, Door = true, Doors = true }
local function seal(model)
	local c = model:FindFirstChild("Colliders")
	if not c then return end
	for _, p in c:GetChildren() do
		if RAISE[p.Name] then
			local base = p.Position.Y - p.Size.Y / 2
			p.Size = Vector3.new(p.Size.X, TOP - base, p.Size.Z)
			p.Position = Vector3.new(p.Position.X, base + p.Size.Y / 2, p.Position.Z)
		end
	end
end

-- the showroom ---------------------------------------------------------------------------------
local show = folder("Showroom")
local origin = CFrame.new()
local shell = place("Lobby", "Lobby_Showroom", origin, show)
place("Lobby", "Lobby_ShowroomHall", origin, show)
place("Lobby", "Lobby_ShowroomFit", origin, show)
place("Lobby", "Lobby_Frontage", origin, show)
local function socket(name)
	return origin * (shell:GetAttribute("Socket_" .. name) :: CFrame)
end
local pads = folder("Pads")
for i, id in {"Solo", "PrivateA", "PublicNormal", "PublicHard", "PublicNightmare", "PrivateB"} do
	local pad = place("Lobby", "Lobby_ElevatorPad", socket("Bay" .. i), pads, "Pad_" .. id)
	pad:SetAttribute("PadId", id)
end
local function booth(asset, socketName, action, label)
	local m = place("Lobby", asset, socket(socketName), show)
	local at = Instance.new("Part")
	at.Name = "PromptAnchor"
	at.Size = Vector3.new(1, 1, 1)
	at.CFrame = m:GetPivot() * (m:GetAttribute("Socket_Prompt") :: CFrame)
	at.Transparency = 1
	at.Anchored = true
	at.CanCollide = false
	at.CanQuery = false
	at.CanTouch = false
	at.CastShadow = false
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = label
	prompt.ObjectText = "Steadfast showroom"
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("LobbyAction", action)
	prompt.Parent = at
	at.Parent = m
end
booth("Lobby_ClassBooth", "ClassBooth", "ClassShop", "Class Shop")
booth("Lobby_LoadoutBooth", "LoadoutBooth", "Loadout", "Loadout")
place("Lobby", "Lobby_BunkerCutaway", socket("Cutaway"), show)
task.wait()

-- Main Street ----------------------------------------------------------------------------------
local street = folder("Street")
for _, b in {{"Bank", -204, -62, 0}, {"Hardware", -138, -62, 0}, {"Atomic", 76, -62, 0}, {"Gazette", 164, -62, 0}, {"Gas", -132, -130, 180}, {"Diner", -66, -130, 180}, {"Market", -6, -130, 180}, {"Vista", 80, -130, 180}, {"Hotel", 162, -130, 180}, {"Soda", 240, -130, 180}} do
	seal(place("Lobby", "Lobby_Block" .. b[1], B(b[2], b[3], 0, b[4]), street, b[1]))
	task.wait()
end
local ground = folder("Ground")
for _, g in {{"Road", -434, 470, -118, -74, -2.5, -0.5, "gunmetal"}, {"CrossRoad1N", -238, -210, -74, 150, -2.5, -0.5, "gunmetal"}, {"CrossRoad1S", -238, -210, -340, -118, -2.5, -0.5, "gunmetal"}, {"CrossWalk11N", -244, -238, -62, 150, -2.5, 0, "ash"}, {"CrossWalk11S", -244, -238, -340, -130, -2.5, 0, "ash"}, {"CrossWalk12N", -210, -204, -62, 150, -2.5, 0, "ash"}, {"CrossWalk12S", -210, -204, -340, -130, -2.5, 0, "ash"}, {"CrossRoad2N", 246, 274, -74, 150, -2.5, -0.5, "gunmetal"}, {"CrossRoad2S", 246, 274, -340, -118, -2.5, -0.5, "gunmetal"}, {"CrossWalk21N", 240, 246, -62, 150, -2.5, 0, "ash"}, {"CrossWalk21S", 240, 246, -340, -130, -2.5, 0, "ash"}, {"CrossWalk22N", 274, 280, -62, 150, -2.5, 0, "ash"}, {"CrossWalk22S", 274, 280, -340, -130, -2.5, 0, "ash"}, {"WalkNorth1", -434, -244, -74, -62, -2.5, 0, "ash"}, {"WalkSouth1", -434, -244, -130, -118, -2.5, 0, "ash"}, {"KerbNorth1", -434, -244, -74, -73.1, -2.4, 0.03, "sandstone"}, {"KerbSouth1", -434, -244, -118.9, -118, -2.4, 0.03, "sandstone"}, {"WalkNorth2", -204, 240, -74, -62, -2.5, 0, "ash"}, {"WalkSouth2", -204, 240, -130, -118, -2.5, 0, "ash"}, {"KerbNorth2", -204, 240, -74, -73.1, -2.4, 0.03, "sandstone"}, {"KerbSouth2", -204, 240, -118.9, -118, -2.4, 0.03, "sandstone"}, {"WalkNorth3", 280, 470, -74, -62, -2.5, 0, "ash"}, {"WalkSouth3", 280, 470, -130, -118, -2.5, 0, "ash"}, {"KerbNorth3", 280, 470, -74, -73.1, -2.4, 0.03, "sandstone"}, {"KerbSouth3", 280, 470, -118.9, -118, -2.4, 0.03, "sandstone"}, {"CornerNorth11", -244, -238, -74, -62, -2.5, 0, "ash"}, {"CornerSouth11", -244, -238, -130, -118, -2.5, 0, "ash"}, {"CornerNorth12", -210, -204, -74, -62, -2.5, 0, "ash"}, {"CornerSouth12", -210, -204, -130, -118, -2.5, 0, "ash"}, {"CornerNorth21", 240, 246, -74, -62, -2.5, 0, "ash"}, {"CornerSouth21", 240, 246, -130, -118, -2.5, 0, "ash"}, {"CornerNorth22", 274, 280, -74, -62, -2.5, 0, "ash"}, {"CornerSouth22", 274, 280, -130, -118, -2.5, 0, "ash"}, {"GroundNorth", -434, 470, -62, 420, -3, -0.06, "leaf"}, {"GroundSouth", -434, 470, -620, -130, -3, -0.06, "leaf"}, {"Alley1", -76, -66, -62, 60, -1, -0.02, "stone"}, {"Alley2", 66, 76, -62, 60, -1, -0.02, "stone"}, {"Dash", -426, -420, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -410, -404, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -394, -388, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -378, -372, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -362, -356, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -346, -340, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -330, -324, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -314, -308, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -298, -292, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -282, -276, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -266, -260, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -250, -244, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -202, -196, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -186, -180, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -170, -164, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -154, -148, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -138, -132, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -122, -116, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -106, -100, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -90, -84, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -74, -68, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -58, -52, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -42, -36, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", -26, -20, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 22, 28, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 38, 44, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 54, 60, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 70, 76, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 86, 92, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 102, 108, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 118, 124, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 134, 140, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 150, 156, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 166, 172, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 182, 188, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 198, 204, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 214, 220, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 230, 236, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 294, 300, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 310, 316, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 326, 332, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 342, 348, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 358, 364, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 374, 380, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 390, 396, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 406, 412, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 422, 428, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 438, 444, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Dash", 454, 460, -96.25, -95.75, -0.6, -0.48, "cream"}, {"Crossing", -9.1, -7.6, -116.8, -75.2, -0.6, -0.48, "porcelain"}, {"Crossing", -6.5, -5, -116.8, -75.2, -0.6, -0.48, "porcelain"}, {"Crossing", -3.9, -2.4, -116.8, -75.2, -0.6, -0.48, "porcelain"}, {"Crossing", -1.3, 0.2, -116.8, -75.2, -0.6, -0.48, "porcelain"}, {"Crossing", 1.3, 2.8, -116.8, -75.2, -0.6, -0.48, "porcelain"}, {"Crossing", 3.9, 5.4, -116.8, -75.2, -0.6, -0.48, "porcelain"}, {"Crossing", 6.5, 8, -116.8, -75.2, -0.6, -0.48, "porcelain"}} do
	local p = slab(ground, g[1], g[2], g[3], g[4], g[5], g[6], g[7], g[8])
	if g[1] == "Dash" or g[1] == "Crossing" or string.sub(g[1], 1, 4) == "Kerb" then
		p.CanCollide = false
		p.CanQuery = false
		p.CastShadow = false
	end
end
slab(ground, "Forecourt", -69, 69, -62 , -62 + 14, -1, 0.07, nil)
local bounds = folder("Bounds")
for _, w in {{-213, -211.5, -132, -60}, {-213, -203.5, -61.5, -60}, {-213, -203.5, -132, -130.5}, {247.5, 249, -132, -60}, {239.5, 249, -61.5, -60}, {239.5, 249, -132, -130.5}, {-76, -66, -38.5, -37}, {66, 76, -38.5, -37}, {-204, -132, -192.5, -191}, {-132.6, -132, -192, -130}, {-204, -203.4, -192, -130}, {-66.6, -66, -170, -130}, {-132, -131.4, -170, -130}, {-132, -66, -167, -166}} do
	slab(bounds, "Bound", w[1], w[2], w[3], w[4], -1, TOP, nil)
end
-- a board fence closes each alley
local dressing = folder("Dressing")
for _, f in {{-76, -66, -39}, {66, 76, -39}} do
	local n = math.floor((f[2] - f[1]) / 1.25)
	for i = 0, n - 1 do
		local h = 8.4 + ((i * 7) % 5) * 0.22
		local x0 = f[1] + i * (f[2] - f[1]) / n
		slab(dressing, "FencePlank", x0 + 0.06, x0 + (f[2] - f[1]) / n - 0.06, f[3], f[3] + 0.3, 0, h, (i % 3 == 1) and "leather" or "walnut")
	end
	slab(dressing, "FenceRail", f[1], f[2], f[3] - 0.25, f[3], 1.6, 2.1, "walnut")
	slab(dressing, "FenceRail", f[1], f[2], f[3] - 0.25, f[3], 6.2, 6.7, "walnut")
end
for _, b in {{-208, -68, 90}, {-208, -80, 90}, {-208, -91, 90}, {-208, -101, 90}, {-208, -112, 90}, {-208, -124, 90}, {244, -68, 90}, {244, -80, 90}, {244, -91, 90}, {244, -101, 90}, {244, -112, 90}, {244, -124, 90}} do
	place("Town", "Town_Barricade", B(b[1], b[2], -0.5 * ((b[2] > -74 or b[2] < -118) and 0 or 1), b[3]), dressing)
end
for _, c in {{"CarSedan", -189.01, -78.3, -0.5, 270.76, "teal"}, {"CarSedan", -163.6, -78.3, -0.5, 269.92, "signal"}, {"CarPickup", -118.85, -78.3, -0.5, 271.17, "hazard"}, {"CarSedan", -91.08, -78.3, -0.5, 270.05, "mint"}, {"CarSedan", 96.02, -78.3, -0.5, 268.94, "blush"}, {"CarSedan", 120.51, -78.3, -0.5, 269.48, "cream"}, {"CarPickup", 172.26, -78.3, -0.5, 268.28, "skyblue"}, {"CarSedan", 196.88, -78.3, -0.5, 268.93, "rust"}, {"CarSedan", 221.2, -78.3, -0.5, 268.17, "navy"}, {"CarSedan", -116.51, -113.7, -0.5, 90.95, "teal"}, {"CarPickup", -90.87, -113.7, -0.5, 90.46, "cream"}, {"CarSedan", -53.4, -113.7, -0.5, 89.32, "plum"}, {"CarSedan", -26.01, -113.7, -0.5, 88.46, "mint"}, {"CarSedan", 35.36, -113.7, -0.5, 89.47, "navy"}, {"CarPickup", 58.96, -113.7, -0.5, 91.27, "signal"}, {"CarSedan", 102.87, -113.7, -0.5, 91.71, "skyblue"}, {"CarSedan", 149.86, -113.7, -0.5, 90.21, "porcelain"}, {"CarSedan", 175.53, -113.7, -0.5, 89.94, "blush"}, {"CarPickup", 219.06, -113.7, -0.5, 88.15, "leaf"}, {"CarPickup", -170, -145.8, 0.06, 270, "rust"}, {"CarSedan", -162.5, -158, 0.06, 0, "skyblue"}, {"CarSedan", -232.5, -22, -0.5, 0, "cream"}, {"CarSedan", 268.5, -176, -0.5, 180, "teal"}, {"CarPickup", 310, -78.3, -0.5, 270, "hazard"}, {"CarSedan", -278, -113.7, -0.5, 90, "blush"}} do
	local car = place("Town", "Town_" .. c[1], B(c[2], c[3], c[4], c[5]), dressing)
	local paint = car:FindFirstChild("Paint")
	if paint and paint:IsA("BasePart") then paint.Color = Color3.fromHex(HEX[c[6]]) end
end
task.wait()
for _, s in {{-187.5, -72.4, 16.9, -78.62, 0.708}, {-178, -119.6, 16.9, 63.53, 0.7754}, {-154.5, -72.4, 16.9, -77.46, 0.7111}, {-144, -119.6, 16.9, 65.51, 0.7627}, {-122.5, -72.4, 16.9, -81.56, 0.7017}, {-115.5, -119.6, 16.9, 63.05, 0.7787}, {-91.5, -72.4, 16.9, -79.2, 0.7066}, {-51, -119.6, 16.9, 88.18, 0.6945}, {-49.5, -72.4, 16.9, -58.88, 0.8108}, {-21, -119.6, 16.9, 84.55, 0.6973}, {-16.5, -72.4, 16.9, -55.86, 0.8386}, {15.5, -119.6, 16.9, 88.79, 0.6943}, {49.5, -72.4, 16.9, -79.2, 0.7066}, {58.5, -119.6, 16.9, 50.08, 0.9051}, {98, -72.4, 16.9, -86.97, 0.6951}, {141.5, -119.6, 16.9, 89.39, 0.6942}, {142, -72.4, 16.9, -50.08, 0.9051}, {181.5, -119.6, 16.9, 88.18, 0.6945}, {183, -72.4, 16.9, -51.53, 0.8865}, {220.5, -119.6, 16.9, 89.39, 0.6942}} do
	place("Town", "Town_Bunting", B(s[1], s[2], s[3], s[4]), dressing, nil, s[5])
end
for _, s in {{-168, -96, 90, 0.8}, {204, -96, 90, 0.8}} do
	place("Town", "Town_WelcomeBanner", B(s[1], s[2], 0, s[3]), dressing, nil, s[4])
end
task.wait()

-- the town beyond the barricades ---------------------------------------------------------------
local beyond = folder("Beyond")
for _, b in {{"Gazette", -320, -62, 0}, {"Vista", -244, -130, 180}, {"Hardware", 280, -62, 0}, {"Bank", 346, -130, 180}} do
	place("Lobby", "Lobby_Block" .. b[1], B(b[2], b[3], 0, b[4]), beyond, b[1])
	task.wait()
end
for _, f in {{"TreeClump", -404, 41.59, -6.36, 1.17}, {"TreeClump", -409.83, -214.56, 189.46, 1.16}, {"TreeClump", -344.85, 36.45, 185.51, 0.94}, {"TreeClump", -345.32, -217.11, -7.17, 1.22}, {"TreeClump", -284.2, 33.37, -3.23, 1.06}, {"TreeClump", -286.48, -214.09, 177.28, 0.91}, {"TreeClump", -174.46, 43.87, -0.1, 1.07}, {"TreeClump", -173.45, -218.53, 173.33, 1.11}, {"TreeClump", -117.78, 37.21, 172.34, 0.96}, {"TreeClump", -63.6, 94.69, -3.68, 1.11}, {"TreeClump", -9.92, 79.86, 169.58, 1.18}, {"TreeClump", -4.38, -225.25, 4.4, 1.14}, {"TreeClump", 50.86, 95.25, -2.23, 1.25}, {"TreeClump", 60.09, -221.37, 189.2, 1.07}, {"TreeClump", 105.37, 30.45, 189.03, 0.96}, {"TreeClump", 96.75, -217.5, 6.57, 1.07}, {"TreeClump", 165.41, 26.94, -5.81, 1}, {"TreeClump", 163.8, -228.93, 169.67, 1.02}, {"TreeClump", 346.95, 34.62, 174.05, 1.24}, {"TreeClump", 347.47, -218.89, -11.32, 0.97}, {"TreeClump", 407.01, 40.31, 9.15, 1.11}, {"TreeClump", 405.53, -221.54, 188.38, 1.01}, {"TreeBig", -254, 57.31, 276.57, 0.9}, {"TreePine", -192, 82.22, 343.43, 0.91}, {"TreeBig", -254, 113.12, 231.79, 1.16}, {"TreePine", -192, 133.01, 92.59, 1.02}, {"TreeBig", -254, -206.5, 326.02, 0.94}, {"TreePine", -192, -196.86, 33.82, 0.91}, {"TreeBig", -254, -270.64, 50.7, 1.16}, {"TreePine", -192, -248.14, 45.55, 1.06}, {"TreeClump", -224, 170, 0, 1.3}, {"TreeClump", -224, -360, 180, 1.3}, {"TreeBig", 230, 57.89, 177.79, 0.97}, {"TreePine", 292, 75.99, 66.22, 1.01}, {"TreeBig", 230, 114.52, 198.01, 0.91}, {"TreePine", 292, 134.53, 314.59, 1.13}, {"TreeBig", 230, -208.51, 2.82, 1.04}, {"TreePine", 292, -197.24, 275.01, 0.95}, {"TreeBig", 230, -267.46, 91.05, 1.11}, {"TreePine", 292, -252.24, 15.09, 1.02}, {"TreeClump", 260, 170, 0, 1.3}, {"TreeClump", 260, -360, 180, 1.3}, {"TreeClump", -374, -96, 90, 1.4}, {"TreeClump", 410, -96, 270, 1.4}, {"Hill", -260, 330, 10, 2.6}, {"Hill", 120, 380, -20, 3.2}, {"Hill", 470, 300, 30, 2.4}, {"Hill", -330, -520, 160, 3}, {"Hill", 60, -560, 200, 3.4}, {"Hill", 420, -480, 170, 2.6}, {"Hill", -554, -80, 80, 2.8}, {"Hill", 590, -110, 100, 2.8}, {"WaterTower", -104, -242, 12, 1}} do
	local m = place("Town", "Town_" .. f[1], B(f[2], f[3], f[1] == "Hill" and -4 or 0, f[4]), beyond, nil, f[5])
	local c = m:FindFirstChild("Colliders")
	if c then c:Destroy() end
end
for _, d in beyond:GetDescendants() do
	if d:IsA("BasePart") then
		d.CanCollide = false
		d.CanQuery = false
		d.CanTouch = false
	end
end
task.wait()

-- spawns: on the pavement, facing the showroom ----------------------------------------------------
local spawns = folder("Spawns")
for _, s in {{-7.5, -68}, {-2.5, -68}, {2.5, -68}, {7.5, -68}} do
	local sp = Instance.new("SpawnLocation")
	sp.Name = "Spawn"
	sp.Size = Vector3.new(4, 1, 4)
	sp.CFrame = CFrame.new(-s[1], -0.5, s[2]) * CFrame.Angles(0, math.pi, 0)
	sp.Anchored = true
	sp.Transparency = 1
	sp.CanCollide = false
	sp.CanQuery = false
	sp.CanTouch = false
	sp.CastShadow = false
	sp.Neutral = true
	sp.Duration = 0
	sp.Parent = spawns
end

-- a sunny morning ----------------------------------------------------------------------------------
Lighting.ClockTime = 10            -- with this latitude the sun stands over the south side and lights the showroom's front
Lighting.GeographicLatitude = -15
Lighting.Brightness = 3.2
Lighting.Ambient = Color3.fromRGB(112, 118, 132)
Lighting.OutdoorAmbient = Color3.fromRGB(150, 158, 172)
Lighting.ColorShift_Top = Color3.fromRGB(255, 244, 224)
Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
Lighting.EnvironmentDiffuseScale = 1
Lighting.EnvironmentSpecularScale = 0.6
Lighting.ExposureCompensation = 0.15
Lighting.ShadowSoftness = 0.25
Lighting.GlobalShadows = true
Lighting.FogEnd = 100000
local atmo = Lighting:FindFirstChildOfClass("Atmosphere")
if atmo then
	atmo.Density = 0.22
	atmo.Offset = 0.1
	atmo.Color = Color3.fromRGB(205, 224, 240)
	atmo.Decay = Color3.fromRGB(150, 180, 210)
	atmo.Glare = 0.15
	atmo.Haze = 1.2
end
local bloom = Lighting:FindFirstChildOfClass("BloomEffect")
if bloom then
	bloom.Intensity = 0.35
	bloom.Size = 20
	bloom.Threshold = 1.6
end
local dof = Lighting:FindFirstChildOfClass("DepthOfFieldEffect")
if dof then dof.Enabled = false end
local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
if rays then
	rays.Intensity = 0.06
	rays.Spread = 0.6
end
local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
clouds.Cover = 0.42
clouds.Density = 0.55
clouds.Color = Color3.fromRGB(255, 255, 255)
clouds.Parent = workspace.Terrain

local parts, tris = 0, 0
for _, d in root:GetDescendants() do
	if d:IsA("BasePart") then parts += 1 end
	if d:IsA("Model") and d:GetAttribute("Tris") then tris += d:GetAttribute("Tris") end
end
local list = {}
for k, v in count do table.insert(list, k .. " x" .. v) end
table.sort(list)
return string.format("workspace.Lobby built: %d parts, about %d triangles\n%s", parts, tris, table.concat(list, ", "))


end
