		SourceOpenIdle = { Rig = "Source", Activity = "OpenIdle", AssetId = "rbxassetid://120477812269121", Looped = true,
			Text = "The Great Eye open, its pupil hunting (A10, Source_OpenIdle)" },
		SourceClose = { Rig = "Source", Activity = "Close", AssetId = "rbxassetid://86623244783953", Looped = false,
			Text = "The lids slam shut over the eye (A10, Source_Close)" },
		SourceAttack = { Rig = "Source", Activity = "Attack", AssetId = "rbxassetid://71429369736907", Looped = false,
			Text = "It rears its arms and brings them down, its eye open (A10, Source_Attack; Hit 0.9 s)" },
		SourceSlam = { Rig = "Source", Activity = "Slam", AssetId = "rbxassetid://95808762165394", Looped = false,
			Text = "The same blow with its eye shut (A10, Source_Slam; Hit 0.9 s)" },
		SourceRoar = { Rig = "Source", Activity = "Roar", AssetId = "rbxassetid://94451380198995", Looped = false,
			Text = "Its arms spread, its lids gape and every eye flares (A10, Source_Roar)" },
		SourceStagger = { Rig = "Source", Activity = "Stagger", AssetId = "rbxassetid://101309093476984", Looped = false,
			Text = "It recoils, its eye wide and its lids fluttering (A10, Source_Stagger)" },
		SourceDeath = { Rig = "Source", Activity = "Death", AssetId = "rbxassetid://74449751138479", Looped = false,
			Text = "It sags into its crater, its eye rolls up and its lids fall shut (A10, Source_Death)" },
		-- A tendril of the Source (A10; Rig SourceTendril; NPCAnimator: Prompt 25. Attack: Hit 0.55 s)
		SourceTendrilIdle = { Rig = "SourceTendril", Activity = "Idle", AssetId = "rbxassetid://116697324036479", Looped = true,
			Text = "A tendril sways over its crater, its eye turning (A10, SourceTendril_Idle)" },
		SourceTendrilAttack = { Rig = "SourceTendril", Activity = "Attack", AssetId = "rbxassetid://139666151004098", Looped = false,
			Text = "It coils back and whips its hooks down (A10, SourceTendril_Attack; Hit 0.55 s)" },
		SourceTendrilRise = { Rig = "SourceTendril", Activity = "Rise", AssetId = "rbxassetid://130729164866804", Looped = false,
			Text = "It bursts up out of the floor (A10, SourceTendril_Rise)" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Badges</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Badges (bible Section 16): survival, depth, victories, residents and combat. 5 to 50
	Glowshards each, once; some unlock Legends (Legends.Get). Hidden lore badges arrive with
	the Codex (Prompt 29). BadgeId is set when the Roblox badges are created.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function b(name: string, group: string, text: string, glowshards: number): { [string]: any }
	return { Name = name, Group = group, Text = text, Glowshards = glowshards }
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Group = Check.enum({ "Survival", "Depth", "Victory", "Residents", "Combat", "Lore" }),
		Text = F.Short,
		Glowshards = Check.integer(5, 50),
		BadgeId = Check.optional(F.PositiveInt),
	}),
	Order = {
		"Year25", "Year50", "Year75", "Year100", "DepthFlooded", "DepthCrystal", "Depth10",
		"CenturyVictory", "DeepVictory", "HardVictory", "NightmareVictory",
		"Year100With30", "NoDeaths", "Rescue50", "LetIn10Wanderers",
		"BeatBroodMother", "BeatDeluge", "BeatCrystalColossus", "BeatSource", "Monsters1000",
	},
	Entries = {
		Year25 = b("Settled In", "Survival", "Reach Year 25.", 5),
		Year50 = b("Halfway There", "Survival", "Reach Year 50.", 10),
		Year75 = b("Three Quarters", "Survival", "Reach Year 75.", 15),
		Year100 = b("Built to Last", "Survival", "Reach Year 100.", 25),
		DepthFlooded = b("Wet Feet", "Depth", "Reach the Flooded Caverns.", 5),
		DepthCrystal = b("Into the Glow", "Depth", "Reach the Crystal Hollows.", 10),
		Depth10 = b("Rock Bottom", "Depth", "Reach depth 10, the Source Chamber.", 20),
		CenturyVictory = b("A Clearing Sky", "Victory", "Win a Century Victory.", 25),
		DeepVictory = b("Dug Too Deep", "Victory", "Win a Deep Victory.", 40),
		HardVictory = b("Hard Times", "Victory", "Win on Hard.", 40),
		NightmareVictory = b("Nightmare's End", "Victory", "Win on Nightmare.", 50),
		Year100With30 = b("Full House", "Residents", "Reach Year 100 with 30 residents alive.", 30),
		NoDeaths = b("Nobody Left Behind", "Residents", "Finish a run with no resident deaths.", 25),
		Rescue50 = b("Search and Rescue", "Residents", "Rescue 50 survivors in total.", 20),
		LetIn10Wanderers = b("Open Door", "Residents", "Let in 10 genuine wanderers.", 15),
		BeatBroodMother = b("Egg Breaker", "Combat", "Beat the Brood Mother.", 10),
		BeatDeluge = b("High and Dry", "Combat", "Beat The Deluge.", 15),
		BeatCrystalColossus = b("Shatterproof", "Combat", "Beat the Crystal Colossus.", 20),
		BeatSource = b("Lights Out", "Combat", "Beat the Source.", 30),
		Monsters1000 = b("Exterminator", "Combat", "Defeat 1,000 monsters.", 20),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Bosses</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Bosses: each era ends with one (bible Section 10). Beating one adds 1 to Years per Cycle
	(Tuning.Clock). Health and phases are provisional, for Prompts 15, 23, 24 and 25.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Year = Check.integer(1, 100),
		Arrives = F.Text,
		Fight = F.Text,
		Health = F.PositiveInt,
		Phases = Check.integer(1, 5),
		Minions = Check.optional(Check.array(Check.ref("Monsters"), 4)),
		Badge = Check.optional(Check.ref("Badges")),
		Asset = F.Asset,
	}),
	Order = { "BroodMother", "Deluge", "CrystalColossus", "Source" },
	Entries = {
		BroodMother = {
			Name = "Brood Mother",
			Year = 25,
			Arrives = "Bursts up through the deepest tunnel.",
			Fight = "Lays egg sacs that hatch Burrow Ticks; break or burn the sacs and hit her glowing belly.",
			Health = 6000,
			Phases = 2,
			Minions = { "BurrowTick" },
			Badge = "BeatBroodMother",
			Asset = "Boss_BroodMother",
		},
		Deluge = {
			Name = "The Deluge",
			Year = 50,
			Arrives = "A giant eel surging up the flooded tunnels.",
			Fight = "Floods every room it passes; strike its head when it surfaces and drain the rooms behind it.",
			Health = 12000,
			Phases = 3,
			Minions = { "Murkling" },
			Badge = "BeatDeluge",
			Asset = "Boss_Deluge",
		},
		CrystalColossus = {
			Name = "Crystal Colossus",
			Year = 75,
			Arrives = "Tears out of the crystal rock.",
			Fight = "Huge, slow and armoured; flares show its weak points; its shards stun.",
			Health = 20000,
			Phases = 3,
			Minions = { "Shardling" },
			Badge = "BeatCrystalColossus",
			Asset = "Boss_CrystalColossus",
		},
		Source = {
			Name = "The Source",
			Year = 100,
			Arrives = "Rises into the bunker, or is fought earlier in its chamber at depth 10.",
			Fight = "Several phases: tendrils in many rooms at once, then the core, so the team has to split up and regroup.",
			Health = 40000,
			Phases = 4,
			Badge = "BeatSource",
			Asset = "Boss_Source",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">CavePieces</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CavePieces: the hand-made pieces caves are put together from (bible Sections 6 and 12; A6;
	Prompt 17). Generated by tools/cave_config.py from the pieces' sidecars (exports/Caves):
	don't edit by hand, change generators/Caves and run the tool.

	Each piece is entered at its pivot (the floor centre of a 14 x 12 opening, facing -Z into the
	piece) and leaves through its Exits (an opening's floor centre; Yaw: the way out, so 0 is -Z).
	Box: the room it takes (Roblox space from the pivot) so pieces never overlap. Weight: how often
	the planner picks it (0: placed on purpose, Entry and CrewPocket). Finds: its Find sockets.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Vec = Check.array(Check.number(), 3)

return {
	Schema = Check.shape({
		Name = F.Name,
		Band = Check.ref("DepthBands"),
		Kind = Check.enum({ "Entry", "Tunnel", "Junction", "Pocket", "Chamber", "Cavern", "Drop", "CrewPocket" }),
		Asset = Check.string(60),
		Weight = Check.number(),
		Finds = Check.integer(0, 8),
		Box = Check.shape({ Min = Vec, Max = Vec }),
		Exits = Check.array(Check.shape({ P = Vec, Yaw = Check.number() }), 4),
		Text = F.Short,
	}),
	Order = { "MinesEntry", "MinesTunnel", "MinesJunction", "MinesPocket", "MinesChamber", "MinesCavern", "MinesDrop", "MinesCrewPocket", "FloodedEntry", "FloodedTunnel", "FloodedJunction", "FloodedPocket", "FloodedChamber", "FloodedCavern", "FloodedDrop", "FloodedCrewPocket", "CrystalEntry", "CrystalTunnel", "CrystalJunction", "CrystalPocket", "CrystalChamber", "CrystalCavern", "CrystalDrop", "CrystalCrewPocket", "SourceEntry" },
	Entries = {
		MinesEntry = { Name = "Mines entry", Band = "Mines", Kind = "Entry", Asset = "Cave_Mines_Entry",
			Weight = 0, Finds = 0, Box = { Min = { -11, -1.5, -28 }, Max = { 11, 16.5, 1.5 } },
			Exits = { { P = { 0, 0, -24 }, Yaw = 0 } }, Text = "The mouth: a rock face where the dug cell's back wall was, and a short tunnel." },
		MinesTunnel = { Name = "Mines tunnel", Band = "Mines", Kind = "Tunnel", Asset = "Cave_Mines_Tunnel",
			Weight = 4, Finds = 1, Box = { Min = { -11, -1.5, -36 }, Max = { 11, 16.5, 0 } },
			Exits = { { P = { 0, 0, -32 }, Yaw = 0 } }, Text = "A straight run." },
		MinesJunction = { Name = "Mines junction", Band = "Mines", Kind = "Junction", Asset = "Cave_Mines_Junction",
			Weight = 3, Finds = 1, Box = { Min = { -30, -1.5, -30 }, Max = { 30, 16.5, 0 } },
			Exits = { { P = { 26, 0, -19 }, Yaw = -90 }, { P = { -26, 0, -19 }, Yaw = 90 } }, Text = "The way splits left and right." },
		MinesPocket = { Name = "Mines pocket", Band = "Mines", Kind = "Pocket", Asset = "Cave_Mines_Pocket",
			Weight = 3, Finds = 2, Box = { Min = { -15, -1.5, -28 }, Max = { 15, 16.5, 0 } },
			Exits = {  }, Text = "A small dead end with two finds." },
		MinesChamber = { Name = "Mines chamber", Band = "Mines", Kind = "Chamber", Asset = "Cave_Mines_Chamber",
			Weight = 3, Finds = 3, Box = { Min = { -22, -1.5, -40 }, Max = { 22, 20.5, 0 } },
			Exits = { { P = { 0, 0, -36 }, Yaw = 0 }, { P = { 18, 0, -24 }, Yaw = -90 } }, Text = "A room with three finds, a way on and a way to the left." },
		MinesCavern = { Name = "Mines cavern", Band = "Mines", Kind = "Cavern", Asset = "Cave_Mines_Cavern",
			Weight = 2, Finds = 4, Box = { Min = { -30, -1.5, -56 }, Max = { 30, 26.5, 0 } },
			Exits = {  }, Text = "A big dead end with a nest spot and four finds." },
		MinesDrop = { Name = "Mines drop", Band = "Mines", Kind = "Drop", Asset = "Cave_Mines_Drop",
			Weight = 2, Finds = 1, Box = { Min = { -11, -10.5, -38 }, Max = { 11, 16.5, 0 } },
			Exits = { { P = { 0, -9, -34 }, Yaw = 0 } }, Text = "The floor falls away down a slope to a lower tunnel." },
		MinesCrewPocket = { Name = "Mines crewpocket", Band = "Mines", Kind = "CrewPocket", Asset = "Cave_Mines_CrewPocket",
			Weight = 0, Finds = 1, Box = { Min = { -19, -1.5, -36 }, Max = { 19, 18.5, 0 } },
			Exits = {  }, Text = "Where a Lost Crew is trapped, guarded." },
		FloodedEntry = { Name = "Flooded entry", Band = "FloodedCaverns", Kind = "Entry", Asset = "Cave_Flooded_Entry",
			Weight = 0, Finds = 0, Box = { Min = { -11, -1.5, -28 }, Max = { 11, 16.5, 1.5 } },
			Exits = { { P = { 0, 0, -24 }, Yaw = 0 } }, Text = "The mouth: a rock face where the dug cell's back wall was, and a short tunnel." },
		FloodedTunnel = { Name = "Flooded tunnel", Band = "FloodedCaverns", Kind = "Tunnel", Asset = "Cave_Flooded_Tunnel",
			Weight = 4, Finds = 1, Box = { Min = { -11, -1.5, -36 }, Max = { 11, 16.5, 0 } },
			Exits = { { P = { 0, 0, -32 }, Yaw = 0 } }, Text = "A straight run." },
		FloodedJunction = { Name = "Flooded junction", Band = "FloodedCaverns", Kind = "Junction", Asset = "Cave_Flooded_Junction",
			Weight = 3, Finds = 1, Box = { Min = { -30, -1.5, -30 }, Max = { 30, 16.5, 0 } },
			Exits = { { P = { 26, 0, -19 }, Yaw = -90 }, { P = { -26, 0, -19 }, Yaw = 90 } }, Text = "The way splits left and right." },
		FloodedPocket = { Name = "Flooded pocket", Band = "FloodedCaverns", Kind = "Pocket", Asset = "Cave_Flooded_Pocket",
			Weight = 3, Finds = 2, Box = { Min = { -15, -1.5, -28 }, Max = { 15, 16.5, 0 } },
			Exits = {  }, Text = "A small dead end with two finds." },
		FloodedChamber = { Name = "Flooded chamber", Band = "FloodedCaverns", Kind = "Chamber", Asset = "Cave_Flooded_Chamber",
			Weight = 3, Finds = 3, Box = { Min = { -22, -1.5, -40 }, Max = { 22, 20.5, 0 } },
			Exits = { { P = { 0, 0, -36 }, Yaw = 0 }, { P = { 18, 0, -24 }, Yaw = -90 } }, Text = "A room with three finds, a way on and a way to the left." },
		FloodedCavern = { Name = "Flooded cavern", Band = "FloodedCaverns", Kind = "Cavern", Asset = "Cave_Flooded_Cavern",
			Weight = 2, Finds = 4, Box = { Min = { -30, -1.5, -56 }, Max = { 30, 26.5, 0 } },
			Exits = {  }, Text = "A big dead end with a nest spot and four finds." },
		FloodedDrop = { Name = "Flooded drop", Band = "FloodedCaverns", Kind = "Drop", Asset = "Cave_Flooded_Drop",
			Weight = 2, Finds = 1, Box = { Min = { -11, -10.5, -38 }, Max = { 11, 16.5, 0 } },
			Exits = { { P = { 0, -9, -34 }, Yaw = 0 } }, Text = "The floor falls away down a slope to a lower tunnel." },
		FloodedCrewPocket = { Name = "Flooded crewpocket", Band = "FloodedCaverns", Kind = "CrewPocket", Asset = "Cave_Flooded_CrewPocket",
			Weight = 0, Finds = 1, Box = { Min = { -19, -1.5, -36 }, Max = { 19, 18.5, 0 } },
			Exits = {  }, Text = "Where a Lost Crew is trapped, guarded." },
		CrystalEntry = { Name = "Crystal entry", Band = "CrystalHollows", Kind = "Entry", Asset = "Cave_Crystal_Entry",
			Weight = 0, Finds = 0, Box = { Min = { -11, -1.5, -28 }, Max = { 11, 16.5, 1.5 } },
			Exits = { { P = { 0, 0, -24 }, Yaw = 0 } }, Text = "The mouth: a rock face where the dug cell's back wall was, and a short tunnel." },
		CrystalTunnel = { Name = "Crystal tunnel", Band = "CrystalHollows", Kind = "Tunnel", Asset = "Cave_Crystal_Tunnel",
			Weight = 4, Finds = 1, Box = { Min = { -11, -1.5, -36 }, Max = { 11, 16.5, 0 } },
			Exits = { { P = { 0, 0, -32 }, Yaw = 0 } }, Text = "A straight run." },
		CrystalJunction = { Name = "Crystal junction", Band = "CrystalHollows", Kind = "Junction", Asset = "Cave_Crystal_Junction",
			Weight = 3, Finds = 1, Box = { Min = { -30, -1.5, -30 }, Max = { 30, 16.5, 0 } },
			Exits = { { P = { 26, 0, -19 }, Yaw = -90 }, { P = { -26, 0, -19 }, Yaw = 90 } }, Text = "The way splits left and right." },
		CrystalPocket = { Name = "Crystal pocket", Band = "CrystalHollows", Kind = "Pocket", Asset = "Cave_Crystal_Pocket",
			Weight = 3, Finds = 2, Box = { Min = { -15, -1.5, -28 }, Max = { 15, 16.5, 0 } },
			Exits = {  }, Text = "A small dead end with two finds." },
		CrystalChamber = { Name = "Crystal chamber", Band = "CrystalHollows", Kind = "Chamber", Asset = "Cave_Crystal_Chamber",
			Weight = 3, Finds = 3, Box = { Min = { -22, -1.5, -40 }, Max = { 22, 20.5, 0 } },
			Exits = { { P = { 0, 0, -36 }, Yaw = 0 }, { P = { 18, 0, -24 }, Yaw = -90 } }, Text = "A room with three finds, a way on and a way to the left." },
		CrystalCavern = { Name = "Crystal cavern", Band = "CrystalHollows", Kind = "Cavern", Asset = "Cave_Crystal_Cavern",
			Weight = 2, Finds = 4, Box = { Min = { -30, -1.5, -56 }, Max = { 30, 26.5, 0 } },
			Exits = {  }, Text = "A big dead end with a nest spot and four finds." },
		CrystalDrop = { Name = "Crystal drop", Band = "CrystalHollows", Kind = "Drop", Asset = "Cave_Crystal_Drop",
			Weight = 2, Finds = 1, Box = { Min = { -11, -10.5, -38 }, Max = { 11, 16.5, 0 } },
