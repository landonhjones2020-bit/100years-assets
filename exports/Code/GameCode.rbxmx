-- The only scripts: everything else is a ModuleScript (bible Section 23).
local ENTRY_SCRIPTS: { [string]: string } = {
	["ServerScriptService.Bootstrap"] = "Script",
	["StarterPlayer.StarterPlayerScripts.ClientBootstrap"] = "LocalScript",
}

-- Roblox's own player and character scripts, which it inserts under StarterPlayer when a
-- playtest starts (PlayerModule also carries InputSetup and ServerAuthority scripts).
local ROBLOX_DEFAULTS: { [string]: boolean } = {
	PlayerModule = true,
	PlayerScriptsLoader = true,
	RbxCharacterSounds = true,
	Animate = true,
	Health = true,
}

-- Scripts inside a player's character (Roblox copies Animate and Health into it).
local function inCharacter(instance: Instance): boolean
	local players = game:GetService("Players")
	local model = instance:FindFirstAncestorOfClass("Model")
	while model do
		if players:GetPlayerFromCharacter(model) then
			return true
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function isRobloxDefault(instance: Instance): boolean
	local node: Instance? = instance
	while node and node.Parent ~= game do
		if ROBLOX_DEFAULTS[node.Name] then
			return node:FindFirstAncestorOfClass("StarterPlayer") ~= nil
		end
		node = node.Parent
	end
	return false
end

local SCRIPT_ROOTS = {
	"Workspace",
	"ReplicatedFirst",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Lighting",
	"SoundService",
}

local function find(path: string): Instance?
	local node: Instance? = game
	for segment in string.gmatch(path, "[^%.]+") do
		if node == game then
			local ok, service = pcall(game.GetService, game, segment)
			node = if ok then service else nil
		else
			node = (node :: Instance):FindFirstChild(segment)
		end
		if not node then
			return nil
		end
	end
	return node
end

local function pathOf(instance: Instance): string
	return instance:GetFullName()
end

-- An art-pipeline sample (A0_Showroom, A0_HUD...): allowed until gameplay replaces it.
local function isSample(instance: Instance): boolean
	local node: Instance? = instance
	while node and node ~= game do
		if string.sub(node.Name, 1, 3) == "A0_" then
			return true
		end
		node = node.Parent
	end
	return false
end

local function fnv1a(text: string): string
	local hash = 2166136261
	for index = 1, #text do
		hash = bit32.bxor(hash, string.byte(text, index))
		hash = (bit32.lshift(hash, 24) + hash * 403) % 4294967296
	end
	return string.format("%08x", hash)
end

local StructureCheck = {}

StructureCheck.Hash = fnv1a

function StructureCheck.Run(options: Options?): Result
	local runtime = options ~= nil and options.Runtime == true
	local sources = options ~= nil and options.Sources == true
	local result: Result = { Errors = {}, Warnings = {}, Passed = 0, Notes = {} }
	local function pass()
		result.Passed += 1
	end
	local function fail(message: string)
		table.insert(result.Errors, message)
	end
	local function warnOf(message: string)
		table.insert(result.Warnings, message)
	end

	-- 1. The skeleton (shared, then this place's own)
	local placeKind: string? = nil
	do
		local constantsModule = find("ReplicatedStorage.Shared.Constants")
		if constantsModule and constantsModule:IsA("ModuleScript") then
			local ok, kind = pcall((require(constantsModule) :: any).PlaceKind)
			placeKind = if ok then kind else nil
		end
	end
	local skeleton = table.clone(SKELETON)
	for _, item in (if placeKind then PLACE_SKELETON[placeKind] else nil) or {} do
		table.insert(skeleton, item)
	end
	for _, item in skeleton do
		local path, className = item[1], item[2]
		local found = find(path)
		if not found then
			fail(`missing {path} ({className})`)
		elseif found.ClassName ~= className then
			fail(`{path} is a {found.ClassName}, should be a {className}`)
		else
			pass()
		end
	end
	for kind, items in PLACE_SKELETON do
		if kind ~= placeKind then
			for _, item in items do
				if find(item[1]) then
					fail(`{item[1]} belongs to the {kind} place only`)
				end
			end
		end
	end

	-- 2. Every installed file, and (from a plugin) whether it was edited after install
	local buildInfo: any = nil
	local buildModule = find("ReplicatedStorage.Shared.BuildInfo")
	if buildModule and buildModule:IsA("ModuleScript") then
		local ok, info = pcall(require, buildModule)
		if ok and type(info) == "table" and type(info.Files) == "table" then
			buildInfo = info
			pass()
		else
			fail("BuildInfo doesn't load or has no Files")
		end
	end
	if buildInfo then
		table.insert(result.Notes, `build {buildInfo.Label}`)
		for path, file in buildInfo.Files do
			local found = find(path)
			if not found then
				fail(`installed file missing: {path} ({file.Class})`)
			elseif found.ClassName ~= file.Class then
				fail(`{path} is a {found.ClassName}, installed as a {file.Class}`)
			else
				pass()
				if sources and found:IsA("LuaSourceContainer") then
					local ok, source = pcall(function()
						return (found :: any).Source
					end)
					if ok and fnv1a(source) ~= file.Hash then
						warnOf(`{path} was edited in Studio after install (the repo copy differs)`)
					end
				end
			end
		end
	end

	-- 3. Services: names, shape and a dependency order with no cycle
	local servicesFolder = find("ServerScriptService.Services")
	if servicesFolder then
		local Loader = require(ReplicatedStorage.Shared.Utilities.Loader) :: any
		local ok, modules = pcall(Loader.Collect, servicesFolder, "Service")
		if not ok then
			fail(tostring(modules))
		else
			local order, problem = Loader.Order(modules)
			if order then
				pass()
				table.insert(result.Notes, `services: {table.concat(order, ", ")}`)
			else
				fail(`services: {problem}`)
			end
		end
		for _, child in servicesFolder:GetChildren() do
			if not child:IsA("ModuleScript") then
				warnOf(`{pathOf(child)}: only ModuleScripts belong in Services`)
			end
		end
	end
	local controllers = find("StarterPlayer.StarterPlayerScripts.Controllers")
	if controllers then
		for _, child in controllers:GetChildren() do
			if not child:IsA("ModuleScript") then
				warnOf(`{pathOf(child)}: only ModuleScripts belong in Controllers`)
			else
				pass()
			end
		end
	end

	-- 4. Stray scripts: only the two bootstraps run code
	local samples = 0
	for _, rootName in SCRIPT_ROOTS do
		local ok, root = pcall(game.GetService, game, rootName)
		if not ok then
			continue
		end
		for _, descendant in (root :: Instance):GetDescendants() do
			if not descendant:IsA("BaseScript") then
				continue
			end
			local path = pathOf(descendant)
			if ENTRY_SCRIPTS[path] == descendant.ClassName then
				pass()
			elseif isSample(descendant) then
				samples += 1
			elseif isRobloxDefault(descendant) or inCharacter(descendant) then
				continue
			else
				warnOf(`stray {descendant.ClassName} {path}: only Bootstrap and ClientBootstrap are scripts; make it a module`)
			end
		end
	end
	if samples > 0 then
		table.insert(result.Notes, `{samples} script(s) in A0_ art samples (allowed until gameplay replaces them)`)
	end

	-- 5. Remotes: only the ones Shared.Remotes defines
	local remotesModule = find("ReplicatedStorage.Shared.Remotes")
	for _, rootName in { "ReplicatedStorage", "Workspace", "ReplicatedFirst" } do
		local root = game:GetService(rootName :: any) :: Instance
		for _, descendant in root:GetDescendants() do
			if
				(descendant:IsA("RemoteEvent") or descendant:IsA("RemoteFunction") or descendant:IsA("UnreliableRemoteEvent"))
				and descendant.Parent ~= remotesModule
			then
				warnOf(`stray remote {pathOf(descendant)}: add it to Shared.Remotes instead`)
			end
		end
	end
	if runtime and remotesModule then
		local Remotes = require(remotesModule :: ModuleScript) :: any
		for name, definition in Remotes.Definitions do
			local found = remotesModule:FindFirstChild(name)
			local className = if definition.Unreliable then "UnreliableRemoteEvent" else "RemoteEvent"
			if not Remotes.InPlace(name) then
				if found then
					fail(`remote {name} exists, but it belongs to the {definition.Place} place only`)
				else
					pass()
				end
			elseif not found then
				fail(`remote {name} wasn't created`)
			elseif found.ClassName ~= className then
				fail(`remote {name} is a {found.ClassName}, should be a {className}`)
			else
				pass()
			end
		end
		for _, child in remotesModule:GetChildren() do
			if Remotes.Definitions[child.Name] == nil then
				warnOf(`unknown remote {child.Name} under Shared.Remotes`)
			end
		end
	end

	-- 6. Config data
	local configModule = find("ReplicatedStorage.Shared.Config")
	if configModule and configModule:IsA("ModuleScript") then
		local ok, Config = pcall(require, configModule)
		if not ok then
			fail(`Config doesn't load: {Config}`)
		else
			local errors = (Config :: any).Errors()
			if #errors == 0 then
				pass()
				table.insert(result.Notes, `config types: {#(Config :: any).Types()}`)
			end
			for _, problem in errors do
				fail(`config: {problem}`)
			end
		end
	end

	-- 7. Place identity
	local constantsModule = find("ReplicatedStorage.Shared.Constants")
	if constantsModule and constantsModule:IsA("ModuleScript") then
		local Constants = require(constantsModule) :: any
		local ok, kind = pcall(Constants.PlaceKind)
		if not ok then
			fail(tostring(kind))
		else
			pass()
			table.insert(result.Notes, `place {kind} ({game.PlaceId})`)
			local attribute = workspace:GetAttribute("PlaceKind")
			if attribute ~= nil and attribute ~= kind then
				fail(`Workspace PlaceKind says {attribute} but this is {kind}`)
			end
			if buildInfo and buildInfo.Place ~= kind then
				fail(`installed build is for {buildInfo.Place}, but this place is {kind}`)
			end
		end
	end

	-- 8. Leftovers. ServerStorage.NS_Pipeline is the working folder of an outside Studio plugin
	-- (the Night Shift importer) that Landon can't remove (2026-11-08: not in Manage Plugins, its
	-- file deleted). It holds an empty Jobs folder and MeshCache, so it is only a warning; scripts
	-- inside it would be an error.
	local leftover = ServerStorage:FindFirstChild("NS_Pipeline")
	if leftover then
		local scripts = 0
		for _, item in leftover:GetDescendants() do
			if item:IsA("LuaSourceContainer") then
				scripts += 1
			end
		end
		if scripts > 0 then
			fail(`ServerStorage.NS_Pipeline (an outside plugin's folder) holds {scripts} script(s): delete it`)
		else
			warnOf("ServerStorage.NS_Pipeline is back (an outside Studio plugin's empty working folder; harmless)")
		end
	else
		pass()
	end

	-- 8b. Place settings the camera relies on (Prompt 5): Roblox's shift lock off (the camera
	-- locks the mouse itself) and Invisicam for Roblox's camera, the fallback
	local StarterPlayer = game:GetService("StarterPlayer")
	if StarterPlayer.EnableMouseLockOption then
		fail("StarterPlayer.EnableMouseLockOption must be off: the over-the-shoulder camera locks the mouse itself")
	else
		pass()
	end
	if StarterPlayer.DevCameraOcclusionMode ~= Enum.DevCameraOcclusionMode.Invisicam then
		fail("StarterPlayer.DevCameraOcclusionMode must be Invisicam (the camera's fallback, bible Section 9)")
	else
		pass()
	end

	-- 8c. The UI layout (bible Section 18, Prompt 6): the Frame (both places) and the HUD (Run)
	-- exist with every part the code uses (Shared.UIContract), ScreenGui settings per rule 7,
	-- Scale-only sizes, text that scales and never drops below 12, and no scripts inside
	local contractModule = find("ReplicatedStorage.Shared.UIContract")
	if contractModule and contractModule:IsA("ModuleScript") then
		local UIContract = require(contractModule) :: any
		local StarterGui = game:GetService("StarterGui")
		for screenName, screen in UIContract.Screens do
			local wanted = placeKind ~= nil and table.find(screen.Places, placeKind) ~= nil
			local gui = StarterGui:FindFirstChild(screenName)
			if not wanted then
				if gui then
					fail(`StarterGui.{screenName} belongs to the {table.concat(screen.Places, " and ")} place only`)
				end
				continue
			end
			if not gui or not gui:IsA("ScreenGui") then
				fail(`missing StarterGui.{screenName} (ScreenGui): build it with tools/ui_luau.py studio/ui/{screenName}.lua`)
				continue
			end
			pass()
			-- a screen that must reach every edge (the cutscene's bars and flash) says Insets = "None"
			local insets = if screen.Insets == "None" then Enum.ScreenInsets.None else Enum.ScreenInsets.CoreUISafeInsets
			if gui.ResetOnSpawn or gui.ZIndexBehavior ~= Enum.ZIndexBehavior.Sibling or gui.ScreenInsets ~= insets then
				fail(`StarterGui.{screenName} needs ScreenInsets {insets.Name}, ResetOnSpawn off and ZIndexBehavior Sibling (bible Section 18)`)
			else
				pass()
			end
			if gui.DisplayOrder ~= screen.DisplayOrder then
				warnOf(`StarterGui.{screenName} DisplayOrder is {gui.DisplayOrder}, expected {screen.DisplayOrder}`)
			end
			local missing = {}
			for _, path in screen.Paths do
				if UIContract.Find(gui, path) then
					pass()
				else
					table.insert(missing, path)
				end
			end
			if #missing > 0 then
				fail(`StarterGui.{screenName} lacks {#missing} part(s) the code uses: {table.concat(missing, ", ", 1, math.min(#missing, 6))}`)
			end
			local offsets, unreadable, scripts = 0, 0, 0
			for _, item in gui:GetDescendants() do
				if item:IsA("GuiObject") then
					local size, position = item.Size, item.Position
					if size.X.Offset ~= 0 or size.Y.Offset ~= 0 or position.X.Offset ~= 0 or position.Y.Offset ~= 0 then
						offsets += 1
					end
				end
				if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
					local limit = item:FindFirstChildOfClass("UITextSizeConstraint")
					if not (item :: any).TextScaled or not limit or limit.MinTextSize < 12 then
						unreadable += 1
					end
				end
				if item:IsA("BaseScript") then
					scripts += 1
				end
			end
			if offsets > 0 then
				fail(`StarterGui.{screenName}: {offsets} element(s) use pixel offsets; all UI is Scale (bible Section 18)`)
			else
				pass()
			end
			if unreadable > 0 then
				fail(`StarterGui.{screenName}: {unreadable} text element(s) without TextScaled and a UITextSizeConstraint of at least 12`)
			else
				pass()
			end
			if scripts > 0 then
				fail(`StarterGui.{screenName} holds {scripts} script(s); the game code drives the UI`)
			else
				pass()
			end
		end
	end

	-- 9. The architecture document
	local doc = find("ServerStorage.Documentation.ARCHITECTURE")
	if doc and doc:IsA("ModuleScript") then
		local ok, text = pcall(require, doc)
		if ok and type(text) == "string" and #text > 200 then
			pass()
		else
			fail("Documentation.ARCHITECTURE must return the document text")
		end
	end

	-- 10. The boot result
	if runtime then
		if ReplicatedStorage:GetAttribute("ServerReady") == true then
			pass()
		else
			fail("ServerReady isn't set: Bootstrap didn't finish")
		end
		local broken = ReplicatedStorage:GetAttribute("ServerBroken")
		if broken then
			fail(`services that failed to start: {broken}`)
		end
		local DevTools = ServerScriptService:FindFirstChild("DevTools")
		if DevTools and not DevTools:FindFirstChild("Invoke") and game:GetService("RunService"):IsStudio() then
			warnOf("DevTools.Invoke wasn't created (DevService didn't start?)")
		end
		-- The run's replicated values (Run place): set, and each one allowed
		local runStateModule = find("ReplicatedStorage.Shared.RunState")
		if placeKind == "Run" and runStateModule and runStateModule:IsA("ModuleScript") then
			local RunState = require(runStateModule) :: any
			if RunState.Get("RunPhase") == nil then
				fail("RunState.RunPhase isn't set: RunDirector didn't start")
			else
				pass()
			end
			for name, value in runStateModule:GetAttributes() do
				local ok, why = RunState.Check(name, value)
				if ok then
					pass()
				else
					fail(`RunState: {why}`)
				end
			end
		end
		-- The bunker's world (Run place): BunkerGrid built it
		if placeKind == "Run" then
			local bunker = workspace:FindFirstChild("Bunker")
			if not bunker then
				fail("workspace.Bunker is missing: BunkerGrid didn't build the bunker")
			else
				for _, name in { "Frame", "Rock", "Dug", "Rooms" } do
					if bunker:FindFirstChild(name) then
						pass()
					else
						fail(`workspace.Bunker.{name} is missing`)
					end
				end
				local rooms = bunker:FindFirstChild("Rooms")
				if rooms and #rooms:GetChildren() == 0 then
					fail("workspace.Bunker.Rooms is empty")
				end
				-- Every room carries its gameplay points; the art kit, when the place has it,
				-- built every room; the Medbay has the spawn and the Blast Door its exit.
				local ServerStorage = game:GetService("ServerStorage")
				local assets = ServerStorage:FindFirstChild("Assets")
				local kit = assets and assets:FindFirstChild("Kit")
				local hasArt = kit ~= nil and kit:FindFirstChild("Kit_Floor") ~= nil
				for _, room in if rooms then rooms:GetChildren() else {} do
					local kind = room:GetAttribute("RoomType")
					local sockets = room:FindFirstChild("Sockets")
					if sockets and sockets:IsA("BasePart") then
						pass()
					else
						fail(`room {room.Name} ({kind}) has no Sockets part`)
					end
					if hasArt and room:GetAttribute("Art") ~= true then
						fail(`room {room.Name} ({kind}) was built from the graybox although the art kit is in ServerStorage.Assets`)
					elseif hasArt then
						pass()
					end
					if kind == "Medbay" then
						if room:FindFirstChild("MedbaySpawn") then
							pass()
						else
							fail(`Medbay {room.Name} has no MedbaySpawn`)
						end
					elseif kind == "BlastDoor" then
						if sockets and sockets:FindFirstChild("SurfaceExit") then
							pass()
						else
							fail(`Blast Door {room.Name} has no SurfaceExit socket`)
						end
					end
				end
			end
		end
	end

	return result
end

function StructureCheck.Format(result: Result): string
	local lines = {
		`StructureCheck: {#result.Errors} errors, {#result.Warnings} warnings, {result.Passed} checks passed`,
	}
	for _, message in result.Errors do
		table.insert(lines, `  ERROR {message}`)
	end
	for _, message in result.Warnings do
		table.insert(lines, `  warn  {message}`)
	end
	for _, message in result.Notes do
		table.insert(lines, `  note  {message}`)
	end
	return table.concat(lines, "\n")
end

return StructureCheck
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000000F3"><Properties><string name="Name">Lib</string></Properties><Item class="ModuleScript" referent="RBX000000EA"><Properties><string name="Name">BrightwaterMap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BrightwaterMap: builds Brightwater Ruins, the surface map, as workspace.Surface in the Run place
	(bible Sections 12 and 23; Prompt 16). It is a tool run in Studio, never by the game:

		require(game.ServerScriptService.Lib.BrightwaterMap).Build()   -- execute_luau, Edit

	* The town sits GROUND studs up, high above the bunker (Section 23; the bunker's floor 1 is at
	  -120, and the place's old Baseplate and A0 showroom stay below at 0).
	* Each place comes from ServerStorage.Assets.Surface.<Asset> when its A5 art exists, else from a
	  graybox stand-in. Containers, survivor spots and find spots sit at the art's sockets
	  (Socket_Container1.., Socket_Survivor1.., Socket_BigFind) or the stand-in's, at least 8 studs
	  apart (the nearest prompt per key wins).
	* Rebuilding keeps every place where it was moved in Studio (its current pivot) and leaves
	  workspace.Surface.Decor alone: Landon's own dressing goes there.
	* SurfaceService reads the result (markers ElevatorExit, ElevatorCall, SurvivorSpot, BigFindSpot,
	  SpawnPoint, CampSpot; containers with Container and Location attributes; gates with MinEra).
	* CampSpot (Prompt 17): where the raider camp holding the surface's Lost Crew may stand (one is
	  picked each run), on open ground, each with a Hint for the radio logs.
	* The layout is shared with the lobby's clean town (Prompt 21): -Z is north, Main Street runs
	  along X at Z = 0, the bunker entrance is in the north hill.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local BrightwaterMap = {}

BrightwaterMap.GROUND = 200

local GROUND = BrightwaterMap.GROUND
local function W(x: number, y: number, z: number): CFrame
	return CFrame.new(x, GROUND + y, z)
end


local C = {
	ash = Color3.fromRGB(122, 112, 104), road = Color3.fromRGB(58, 56, 60), walk = Color3.fromRGB(150, 144, 136),
	line = Color3.fromRGB(196, 172, 96), hill = Color3.fromRGB(104, 92, 84), wall = Color3.fromRGB(176, 162, 146),
	trim = Color3.fromRGB(47, 111, 115), rust = Color3.fromRGB(150, 76, 48), dark = Color3.fromRGB(70, 66, 64),
	cream = Color3.fromRGB(242, 230, 201), steel = Color3.fromRGB(120, 124, 130), wood = Color3.fromRGB(116, 86, 62),
	sand = Color3.fromRGB(176, 156, 112), signal = Color3.fromRGB(232, 116, 59), olive = Color3.fromRGB(96, 104, 70),
}

-- The layout: X and Z of each place's pivot (its ground, bottom centre), its yaw (0: its front
-- faces -Z, north; 180: south, towards Main Street from the north side) and its stand-in.
local PLACES = {
	{ Id = "Entrance", Asset = "Bldg_BunkerEntrance", At = { 0, -205 }, Yaw = 180, Kind = "Entrance" },
	{ Id = "Diner", Location = "Diner", Asset = "Bldg_Diner", At = { -100, -46 }, Yaw = 180, Kind = "Store", W = 44, D = 30 },
	{ Id = "HardwareStore", Location = "HardwareStore", Asset = "Bldg_HardwareStore", At = { 60, -48 }, Yaw = 180, Kind = "Store", W = 40, D = 32 },
	{ Id = "GasStation", Location = "GasStation", Asset = "Bldg_GasStation", At = { 190, -52 }, Yaw = 180, Kind = "Station", W = 56, D = 44 },
	{ Id = "Grocery", Location = "Grocery", Asset = "Bldg_Grocery", At = { -170, 50 }, Yaw = 0, Kind = "Store", W = 50, D = 36 },
	{ Id = "Showroom", Location = "Showroom", Asset = "Bldg_Showroom", At = { -40, 54 }, Yaw = 0, Kind = "Store", W = 54, D = 38 },
	{ Id = "Motel", Location = "Motel", Asset = "Bldg_Motel", At = { 120, 60 }, Yaw = 0, Kind = "Motel", W = 76, D = 26 },
	{ Id = "RadioTower", Location = "RadioTower", Asset = "Bldg_RadioTower", At = { 205, -168 }, Yaw = 200, Kind = "Radio", W = 26, D = 22 },
	{ Id = "WaterTower", Location = "WaterTower", Asset = "Bldg_WaterTower", At = { -215, -150 }, Yaw = 160, Kind = "Tower", W = 26, D = 22 },
	{ Id = "RailYard", Location = "RailYard", Asset = "Bldg_RailYard", At = { -10, 168 }, Yaw = 0, Kind = "Train", W = 150, D = 30 },
	{ Id = "Checkpoint", Location = "Checkpoint", Asset = "Bldg_Checkpoint", At = { 272, 0 }, Yaw = 90, Kind = "Checkpoint", W = 50, D = 44 },
}
-- What the art's sign boards (parts whose Role is Sign) say: the location's name unless set here,
-- and the ink when the board is dark.
local INK = { navy = Color3.fromRGB(27, 42, 58), cream = Color3.fromRGB(242, 230, 201) }
local SIGN_TEXT = { Entrance = "Steadfast Shelter Co.", WaterTower = "Brightwater" }
local SIGN_INK = { WaterTower = INK.cream }
-- Wrecks and clutter: { asset, x, z, yaw }
local DECOR = {
	{ "Prop_CarWreck_A", -235, 9, 80 }, { "Prop_CarWreck_B", -62, -9, 262 }, { "Prop_CarWreck_A", 38, 10, 95 },
	{ "Prop_CarWreck_B", 150, -8, 275 }, { "Prop_CarWreck_A", 236, 9, 70 }, { "Prop_CarWreck_B", 9, -120, 10 },
	{ "Prop_BurntTree", -262, -96, 0 }, { "Prop_BurntTree", -140, -118, 40 }, { "Prop_BurntTree", -42, -112, 90 },
	{ "Prop_BurntTree", 94, -114, 130 }, { "Prop_BurntTree", 150, 118, 200 }, { "Prop_BurntTree", -252, 112, 250 },
	{ "Prop_BurntTree", 252, 150, 300 }, { "Prop_BurntTree", -110, 120, 20 }, { "Prop_BurntTree", 40, -150, 60 },
	{ "Prop_Debris", -128, -24, 0 }, { "Prop_Debris", 92, -26, 70 }, { "Prop_Debris", -200, 26, 140 },
	{ "Prop_Debris", 12, 30, 210 }, { "Prop_Debris", 168, 30, 280 }, { "Prop_Debris", -30, -150, 30 },
	{ "Prop_Debris", 70, 120, 100 }, { "Prop_Debris", -150, 140, 170 },
}
-- Creature spawn points round the edge, all on open ground (the north hill's face is at Z = -212:
-- points behind it were buried in the hill, and creatures spawned there fell out of the town)
local SPAWNS = {
	{ -285, -196 }, { -285, -60 }, { -285, 80 }, { -285, 205 }, { -120, 212 }, { 60, 212 }, { 220, 208 },
	{ 288, 120 }, { 288, -100 }, { 252, -196 }, { 100, -196 }, { -90, -196 }, { -200, -60 }, { 110, -125 },
	{ -70, 112 }, { 170, 112 }, { -250, -165 }, { 240, -40 },
}

-- The raider camp's possible spots (Prompt 17: the surface's Lost Crew; their spots change each run):
-- { x, z, yaw, hint }, each clear of the places, wrecks and trees for its 34-stud square.
local CAMPS = {
	{ -245, 75, 0, "west of the grocery" },
	{ 95, 125, 0, "behind the motel, by the rail yard" },
	{ 230, 115, 0, "south of the military checkpoint" },
	{ -120, -130, 180, "north of the diner, among the burnt trees" },
}

-- Builds (or rebuilds) workspace.Surface; returns a summary.
function BrightwaterMap.Build(): string
	local assets = ServerStorage:FindFirstChild("Assets")
	local ART: any = assets and assets:FindFirstChild("Surface")
	local PROPS: any = assets and assets:FindFirstChild("Props")
	local holder: any = workspace:FindFirstChild("Surface")
	local moved: { [string]: CFrame } = {}
	local decor: any = nil
	if holder then
		for _, child in holder:GetChildren() do
			if child:IsA("Model") and child:GetAttribute("PlaceId") then
				moved[child:GetAttribute("PlaceId")] = child:GetPivot()
			end
		end
		decor = holder:FindFirstChild("Decor")
		if decor then
			decor.Parent = nil
		end
		holder:Destroy()
	end
	holder = Instance.new("Model")
	holder.Name = "Surface"
	holder.ModelStreamingMode = Enum.ModelStreamingMode.Default

	local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, props: { [string]: any }?): any
		local p: any = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cframe
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		for k, v in props or {} do
			p[k] = v
		end
		p.Parent = parent
		return p
	end

	local function marker(parent: Instance, name: string, cframe: CFrame, location: string?): any
		local m = part(parent, name, Vector3.new(1, 1, 1), cframe, C.signal, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
		if location then
			m:SetAttribute("Location", location)
		end
		return m
	end

	-- The ground ---------------------------------------------------------------------------------------
	local ground = Instance.new("Model")
	ground.Name = "Ground"
	ground.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	part(ground, "Ash", Vector3.new(640, 2, 520), W(0, -1, -15), C.ash)
	part(ground, "MainStreet", Vector3.new(600, 0.2, 28), W(0, 0.1, 0), C.road, { CanCollide = false })
	for x = -280, 280, 40 do
		part(ground, "Line", Vector3.new(14, 0.22, 0.8), W(x, 0.11, 0), C.line, { CanCollide = false })
	end
	part(ground, "WalkNorth", Vector3.new(600, 0.3, 8), W(0, 0.15, -18), C.walk)
	part(ground, "WalkSouth", Vector3.new(600, 0.3, 8), W(0, 0.15, 18), C.walk)
	part(ground, "HillLane", Vector3.new(16, 0.2, 172), W(0, 0.1, -108), C.road, { CanCollide = false })
	part(ground, "RailBed", Vector3.new(600, 0.4, 16), W(0, 0.2, 168), C.dark)
	for _, z in { 164, 172 } do
		part(ground, "Rail", Vector3.new(600, 0.5, 0.6), W(0, 0.6, z), C.steel)
	end
	-- the north hill the bunker is dug into, and low hills round the edge
	part(ground, "HillNorth", Vector3.new(660, 44, 80), W(0, 18, -252), C.hill)
	for _, h in { { -330, -15, 40, 540 }, { 330, -15, 40, 540 }, { 0, 252, 700, 40 } } do
		part(ground, "HillEdge", Vector3.new(h[3], 26, h[4]), W(h[1], 6, h[2]), C.hill)
	end
	for _, w in { { -305, -15, 2, 540 }, { 305, -15, 2, 540 }, { 0, 232, 640, 2 }, { 0, -245, 640, 2 } } do
		part(ground, "Boundary", Vector3.new(w[3], 80, w[4]), W(w[1], 40, w[2]), C.hill, { Transparency = 1, CanQuery = false })
	end
	ground.Parent = holder

	-- Stand-ins -------------------------------------------------------------------------------------------
	-- Each returns sockets in the place's own space (its front faces -Z): Container1.., Survivor1..,
	-- BigFind, and for the entrance Exit and Call.
	local function walls(m: any, w: number, d: number, h: number, color: Color3, door: number?)
		part(m, "Floor", Vector3.new(w, 0.6, d), CFrame.new(0, 0.3, 0), C.dark)
		part(m, "Back", Vector3.new(w, h, 1), CFrame.new(0, h / 2, d / 2), color)
		part(m, "Left", Vector3.new(1, h, d), CFrame.new(-w / 2, h / 2, 0), color)
		part(m, "Right", Vector3.new(1, h * 0.7, d), CFrame.new(w / 2, h * 0.35, 0), color) -- ruined
		local gap = door or 10
		local side = (w - gap) / 2
		part(m, "FrontL", Vector3.new(side, h, 1), CFrame.new(-w / 2 + side / 2, h / 2, -d / 2), color)
		part(m, "FrontR", Vector3.new(side, h * 0.5, 1), CFrame.new(w / 2 - side / 2, h * 0.25, -d / 2), color)
		part(m, "Trim", Vector3.new(w + 1, 1.2, 1.4), CFrame.new(0, h, -d / 2), C.trim)
		part(m, "Roof", Vector3.new(w * 0.55, 0.8, d), CFrame.new(-w * 0.22, h + 0.4, 0), C.dark)
	end

	-- Lettering on a sign board's front (-Z) face, lit by the scene like paint.
	local function letter(board: BasePart, text: string, ink: Color3?)
		local gui = Instance.new("SurfaceGui")
		gui.Name = "Lettering"
		gui.Face = Enum.NormalId.Front
		gui.LightInfluence = 1
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(board.Size.X * 40, board.Size.Y * 40)
		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(0.9, 0.8)
		label.Position = UDim2.fromScale(0.05, 0.1)
		label.BackgroundTransparency = 1
		label.Text = string.upper(text)
		label.TextScaled = true
		label.Font = Enum.Font.Oswald
		label.TextColor3 = ink or INK.navy
		label.Parent = gui
		gui.Parent = board
	end
	local function sign(m: Instance, text: string, at: CFrame, w: number)
		letter(part(m, "Sign", Vector3.new(w, 4, 0.6), at, C.cream), text)
	end

	local function backRow(n: number, w: number, d: number): { [string]: CFrame }
		local s: { [string]: CFrame } = {}
		for i = 1, n do
			local x = -w / 2 + 4 + (w - 8) * (if n == 1 then 0.5 else (i - 1) / (n - 1))
			s["Container" .. i] = CFrame.new(x, 0.6, d / 2 - 2.5)
		end
		return s
	end

	local STAND: { [string]: (any, any, number) -> { [string]: CFrame } } = {}
	STAND.Store = function(m: any, p: any, n: number)
		walls(m, p.W, p.D, 14, C.wall, 12)
		sign(m, Config.Get("SurfaceLocations", p.Location).Name, CFrame.new(0, 16.5, -p.D / 2 - 0.4), math.min(p.W - 6, 30))
		local s = backRow(n, p.W, p.D)
		-- prompts at least 8 studs apart: the nearest one per key wins (Exclusivity OnePerButton)
		s.Survivor1 = CFrame.new(p.W / 2 - 5, 0.6, -p.D / 2 + 6)
		s.BigFind = CFrame.new(-p.W / 2 + 6, 0.6, -p.D / 2 + 7)
		return s
	end
	STAND.Station = function(m: any, p: any, n: number)
		part(m, "Slab", Vector3.new(p.W, 0.4, p.D), CFrame.new(0, 0.2, 0), C.walk)
		part(m, "Canopy", Vector3.new(p.W * 0.7, 1.2, 18), CFrame.new(-6, 15, -8), C.cream)
		for _, x in { -22, 10 } do
			part(m, "Post", Vector3.new(1.4, 15, 1.4), CFrame.new(x, 7.5, -8), C.steel)
			part(m, "Pump", Vector3.new(2.4, 5, 2), CFrame.new(x + 5, 2.7, -8), C.signal)
		end
		local shop: any = Instance.new("Model")
		shop.Name = "Shop"
		shop.Parent = m
		walls(shop, 22, 16, 12, C.wall, 8)
		shop.WorldPivot = CFrame.new()
		shop:PivotTo(CFrame.new(14, 0, 12))
		sign(m, "Gas", CFrame.new(-6, 17.2, -17.4), 12)
		local s: { [string]: CFrame } = {}
		for i = 1, n do
			s["Container" .. i] = CFrame.new(6 + (i - 1) * 7, 0.6, 18)
		end
		s.Survivor1 = CFrame.new(8, 0.6, 7)
		s.BigFind = CFrame.new(-20, 0.4, 8)
		return s
	end
	STAND.Motel = function(m: any, p: any, n: number)
		walls(m, p.W, p.D, 12, C.wall, 0)
		m.FrontL:Destroy()
		m.FrontR:Destroy()
		local rooms = 6
		for i = 1, rooms - 1 do
			local x = -p.W / 2 + p.W / rooms * i
			part(m, "Divider", Vector3.new(1, 12, p.D - 6), CFrame.new(x, 6, 3), C.wall)
		end
		part(m, "Walkway", Vector3.new(p.W, 0.4, 6), CFrame.new(0, 0.2, -p.D / 2 - 3), C.walk)
		sign(m, "Motel", CFrame.new(-p.W / 2 + 8, 17, -p.D / 2 - 6), 14)
		local s: { [string]: CFrame } = {}
		for i = 1, n do
			local x = -p.W / 2 + p.W / rooms * (i - 0.5)
			s["Container" .. i] = CFrame.new(x, 0.6, p.D / 2 - 2.5)
		end
		s.Survivor1 = CFrame.new(-p.W / 2 + p.W / rooms * 1.5, 0.6, 2)
		s.Survivor2 = CFrame.new(-p.W / 2 + p.W / rooms * 4.5, 0.6, 2)
		return s
	end
	local function shack(m: Instance, x: number, z: number, w: number, d: number)
		local hut: any = Instance.new("Model")
		hut.Name = "Shack"
		hut.Parent = m
		walls(hut, w, d, 10, C.wood, 6)
		hut.WorldPivot = CFrame.new()
		hut:PivotTo(CFrame.new(x, 0, z))
	end
	STAND.Tower = function(m: any, p: any, n: number)
		for _, xz in { { -6, -6 }, { 6, -6 }, { -6, 6 }, { 6, 6 } } do
			part(m, "Leg", Vector3.new(1.4, 40, 1.4), CFrame.new(xz[1], 20, xz[2]), C.steel)
		end
		part(m, "Tank", Vector3.new(18, 12, 18), CFrame.new(0, 46, 0), C.cream, { Shape = Enum.PartType.Cylinder })
		m.Tank.CFrame = CFrame.new(0, 46, 0) * CFrame.Angles(0, 0, math.pi / 2)
		shack(m, 0, 16, 14, 10)
		local s: { [string]: CFrame } = {}
		for i = 1, n do
			s["Container" .. i] = CFrame.new(-4 + (i - 1) * 8, 0.6, 19.5)
		end
		s.Survivor1 = CFrame.new(0, 0.6, 1)
		return s
	end
	STAND.Radio = function(m: any, p: any, n: number)
		for i = 0, 5 do
			part(m, "Mast", Vector3.new(3 - i * 0.3, 14, 3 - i * 0.3), CFrame.new(0, 7 + i * 14, -4), C.signal)
		end
		part(m, "Light", Vector3.new(1.4, 1.4, 1.4), CFrame.new(0, 92, -4), Color3.fromRGB(255, 80, 60), { Material = Enum.Material.Neon })
		shack(m, 0, 8, 16, 11)
		local s: { [string]: CFrame } = {}
		for i = 1, n do
			s["Container" .. i] = CFrame.new(-5 + (i - 1) * 5, 0.6, 11.5)
		end
		s.Survivor1 = CFrame.new(-10, 0.6, -3)
		s.BigFind = CFrame.new(10, 0.4, -6)
		return s
	end
	STAND.Train = function(m: any, p: any, n: number)
		local cars = { { "Loco", -48, 34, C.dark }, { "Boxcar", -8, 34, C.rust }, { "Boxcar2", 34, 34, C.trim } }
		local s: { [string]: CFrame } = {}
		local i = 0
		for c, car in cars do
			local body: any = Instance.new("Model")
			body.Name = car[1]
			body.Parent = m
			part(body, "Floor", Vector3.new(car[3], 1, 10), CFrame.new(car[2], 2.6, 0), C.dark)
			part(body, "Back", Vector3.new(car[3], 10, 1), CFrame.new(car[2], 7.6, 4.5), car[4])
			part(body, "Front", Vector3.new(car[3] * 0.4, 10, 1), CFrame.new(car[2] - car[3] * 0.3, 7.6, -4.5), car[4])
			part(body, "Roof", Vector3.new(car[3], 1, 10), CFrame.new(car[2], 13, 0), car[4])
			part(body, "Ramp", Vector3.new(5, 1, 6), CFrame.new(car[2] + 4, 1.2, -7) * CFrame.Angles(math.rad(-22), 0, 0), C.wood)
			for k = 1, 2 do
				i += 1
				if i <= n then
					s["Container" .. i] = CFrame.new(car[2] + (k == 1 and -8 or 8), 3.1, 2.4)
				end
			end
			if c == 2 then
				s.BigFind = CFrame.new(car[2], 3.1, -1.5)
			end
		end
		shack(m, -150, -26, 18, 12)
		s.Survivor1 = CFrame.new(-150, 0.6, -24)
		return s
	end
	STAND.Checkpoint = function(m: any, p: any, n: number)
		-- a sandbagged compound across the end of Main Street, its front (the gate) facing the town
		part(m, "Slab", Vector3.new(44, 0.4, 34), CFrame.new(0, 0.2, 13), C.walk)
		for _, side in { -22, 22 } do
			part(m, "Sandbags", Vector3.new(3, 6, 34), CFrame.new(side, 3, 13), C.sand)
		end
		part(m, "BackWall", Vector3.new(44, 8, 2), CFrame.new(0, 4, 30), C.sand)
		part(m, "Booth", Vector3.new(7, 9, 7), CFrame.new(-15, 4.5, 3), C.olive)
		part(m, "Tent", Vector3.new(16, 8, 12), CFrame.new(10, 4, 16), C.olive)
		local gate: any = Instance.new("Model")
		gate.Name = "Gate"
		gate:SetAttribute("MinEra", Config.Get("SurfaceLocations", "Checkpoint").MinEra)
		gate.Parent = m
		local bar = part(gate, "Barrier", Vector3.new(41, 10, 1.2), CFrame.new(0, 5, -4), C.signal)
		bar:SetAttribute("Barrier", true)
		sign(m, "Military Checkpoint", CFrame.new(0, 11.5, -4.8), 22)
		local s: { [string]: CFrame } = {}
		for i = 1, n do
			s["Container" .. i] = CFrame.new(-16 + (i - 1) * 32 / math.max(n - 1, 1), 0.6, 27)
		end
		s.Survivor1 = CFrame.new(16, 0.6, 8)
		s.BigFind = CFrame.new(-6, 0.4, 14)
		return s
	end
	STAND.Entrance = function(m: any, p: any, _n: number)
		part(m, "Headwall", Vector3.new(44, 22, 6), CFrame.new(0, 11, 3), C.walk)
		part(m, "DoorRing", Vector3.new(18, 18, 2), CFrame.new(0, 10, -0.5), C.steel)
		part(m, "Door", Vector3.new(14, 14, 1.2), CFrame.new(0, 8, -1.2), C.dark)
		part(m, "Stripe", Vector3.new(20, 1.2, 1), CFrame.new(0, 1, -1.4), C.line)
		part(m, "Pad", Vector3.new(30, 0.4, 16), CFrame.new(0, 0.2, -8), C.walk)
		sign(m, "Steadfast Shelter Co.", CFrame.new(0, 20, -0.6), 26)
		return { Exit = CFrame.new(0, 0.4, -10), Call = CFrame.new(5, 3, -2.6) } -- Exit faces out, towards the town
	end

	-- A container's prop: a cabinet, a locker or a crate (the art when it exists).
	local CONTAINER_ART = { "Prop_Cabinet", "Prop_Locker", "Prop_SupplyCrate" }
	local function containerModel(i: number): any
		local name = CONTAINER_ART[(i - 1) % #CONTAINER_ART + 1]
		local src = (ART and ART:FindFirstChild(name)) or (PROPS and PROPS:FindFirstChild(name))
		if src then
			return src:Clone()
		end
		local m: any = Instance.new("Model")
		m.Name = name
		local box = part(m, "Body", Vector3.new(4, 3.4, 2.4), CFrame.new(0, 1.7, 0), C.trim)
		part(m, "Lid", Vector3.new(4.2, 0.4, 2.6), CFrame.new(0, 3.6, 0), C.steel)
		box.PivotOffset = CFrame.new(0, -1.7, 0)
		m.PrimaryPart = box
		return m
	end

	local function socketsOf(model: Instance): { [string]: CFrame }
		local s: { [string]: CFrame } = {}
		for k, v in model:GetAttributes() do
			local name = string.match(k, "^Socket_(.+)$")
			if name and typeof(v) == "CFrame" then
				s[name] = v
			end
		end
		return s
	end

	local counts = { Containers = 0, Survivors = 0, Finds = 0, Art = 0, Stand = 0, Signs = 0 }
	for _, p in PLACES do
		local cf = moved[p.Id] or W(p.At[1], 0, p.At[2]) * CFrame.Angles(0, math.rad(p.Yaw), 0)
		local model: any
		local sockets: { [string]: CFrame }
		local src = ART and ART:FindFirstChild(p.Asset)
		local n = if p.Location then Config.Get("SurfaceLocations", p.Location).Containers else 0
		if src then
			model = src:Clone()
			sockets = socketsOf(model)
			counts.Art += 1
			local text = SIGN_TEXT[p.Id] or (p.Location and Config.Get("SurfaceLocations", p.Location).Name)
			if text then
				for _, d in model:GetDescendants() do
					if d:IsA("BasePart") and d:GetAttribute("Role") == "Sign" then
						letter(d, text, SIGN_INK[p.Id])
						counts.Signs += 1
					end
				end
			end
			if p.Location and Config.Get("SurfaceLocations", p.Location).MinEra > 1 then
				-- the art's gate: parts whose Role is Barrier close the place until its era
				model:SetAttribute("MinEra", Config.Get("SurfaceLocations", p.Location).MinEra)
				for _, d in model:GetDescendants() do
					if d:IsA("BasePart") and d:GetAttribute("Role") == "Barrier" then
						d:SetAttribute("Barrier", true)
					end
				end
			end
		else
			model = Instance.new("Model")
			model.Name = p.Asset
			sockets = STAND[p.Kind](model, p, n)
			model.WorldPivot = CFrame.new()
			counts.Stand += 1
		end
		model:SetAttribute("PlaceId", p.Id)
		if p.Location then
			model:SetAttribute("Location", p.Location)
		end
		model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		model:PivotTo(cf)
		model.Parent = holder
		local pivot = model:GetPivot()
		local markers = Instance.new("Folder")
		markers.Name = "Markers"
		markers.Parent = model
		for name, local_ in sockets do
			local at = pivot * local_
			local base = string.match(name, "^(%a+)")
			if base == "Container" then
				local i = tonumber(string.match(name, "(%d+)$")) or 1
				if i <= n then
					local c = containerModel(i)
					c.Name = "Container" .. i
					c:SetAttribute("Container", true)
					c:SetAttribute("Location", p.Location)
					c:PivotTo(at)
					c.Parent = model
					counts.Containers += 1
				end
			elseif base == "Survivor" then
				marker(markers, "SurvivorSpot", at, p.Location)
				counts.Survivors += 1
			elseif base == "BigFind" then
				marker(markers, "BigFindSpot", at, p.Location)
				counts.Finds += 1
			elseif name == "Exit" then
				marker(markers, "ElevatorExit", at)
			elseif name == "Call" then
				marker(markers, "ElevatorCall", at)
			end
		end
	end

	local decorModel = Instance.new("Model")
	decorModel.Name = "Wrecks"
	decorModel.Parent = holder
	for _, d in DECOR do
		local src = (ART and ART:FindFirstChild(d[1])) or (PROPS and PROPS:FindFirstChild(d[1]))
		local m: any
		if src then
			m = src:Clone()
		else
			m = Instance.new("Model")
			m.Name = d[1]
			local size = if string.find(d[1], "Car") then Vector3.new(7, 4, 13) elseif string.find(d[1], "Tree") then Vector3.new(2, 14, 2) else Vector3.new(8, 2.5, 6)
			local b = part(m, "Body", size, CFrame.new(0, size.Y / 2, 0), if string.find(d[1], "Tree") then C.dark else C.rust)
			b.PivotOffset = CFrame.new(0, -size.Y / 2, 0)
			m.PrimaryPart = b
		end
		m:PivotTo(W(d[2], 0, d[3]) * CFrame.Angles(0, math.rad(d[4]), 0))
		m.Parent = decorModel
	end

	local spawns = Instance.new("Folder")
	spawns.Name = "Spawns"
	spawns.Parent = holder
	for _, s in SPAWNS do
		marker(spawns, "SpawnPoint", W(s[1], 1, s[2]))
	end
	for i, c in CAMPS do
		local m = marker(spawns, "CampSpot", W(c[1], 0, c[2]) * CFrame.Angles(0, math.rad(c[3]), 0))
		m:SetAttribute("Hint", c[4])
		m:SetAttribute("Index", i)
	end
	if decor then
		decor.Parent = holder
	else
		local d = Instance.new("Model")
		d.Name = "Decor"
		d.Parent = holder
	end
	holder.Parent = workspace
	return string.format("workspace.Surface built: %d places (%d art, %d stand-ins), %d signs lettered, %d containers, %d survivor spots, %d find spots, %d spawn points, %d camp spots, %d wrecks",
		counts.Art + counts.Stand, counts.Art, counts.Stand, counts.Signs, counts.Containers, counts.Survivors, counts.Finds, #SPAWNS, #CAMPS, #DECOR)
end

return BrightwaterMap
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000EB"><Properties><string name="Name">BunkerKit</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BunkerKit: builds the bunker's world from Rules.Bunker data (bible Section 6).

	It builds from the A1 art kit in ServerStorage.Assets (bible Section 19): the Kit_* shell
	pieces, Kit_Rock_<Band> and Kit_Dug_<Band>, Kit_Shaft_L<level>, Kit_BlastDoor_L<level>,
	Kit_Vent and Room_<Type>_L<level>, each copied to its cell with Grid.CellCFrame. A piece
	the place doesn't have falls back to the Prompt 4 graybox (plain parts with the same
	sizes), so the bunker always builds, even in a place without the art.

	workspace.Bunker
	  Frame     rock around the grid: a column each side, a row above floor 1, a row below 10
	  Rock      one model per Rock cell, named by its key ("3,-2"); alternate cells turned
	  Dug       one model per Dug cell, named by its graph node ("D:2,3")
	  Rooms     one model per room, named by its id ("R4")

	* Every unit streams as Persistent, so the Command View always has the whole bunker
	  (bible Section 23).
	* Every room has walls. A side wall gets a doorway when the cell beyond it is open
	  (rooms connect sideways through doorways in shared walls). Cells of one room have no
	  wall between them.
	* Front walls carry the FrontWall tag (every part of a front wall piece, and the front
	  face of a dug cell): solid while playing, hidden in the Command View (Prompt 7).
	* Furniture, the Blast Door set, the stair, vents, lamps and cave props carry the
	  CameraFade tag: the over-the-shoulder camera passes through them and fades them when
	  they hide the character (Prompt 5). Floors, walls, ceilings and rock stop the camera.
	* Stacked Shafts get a hole in the upper one's floor, a hole in the lower one's ceiling
	  and the stair in the lower one.
	* Each room has a Sockets part (invisible) with an Attachment per gameplay point its art
	  carries: WorkSpot1.., Bed1.., Seat1.., Core, Valve1.., FuseBox, Breaker, Tap, Bench,
	  Respawn, Door, SurfaceExit, Vent, Lift, Chute, Top, Bottom, Light1.. Numbered points
	  count up across the room's cells from left to right; an unnumbered point that repeats
	  gets its cell's number (Breaker, Breaker2). BunkerKit.Socket and .Sockets read them.
	* The Medbay holds the players' spawn on its respawn pad (Section 6).
	* Lights: two per room cell at the ceiling strip, a lantern per dug cell, the Reactor's
	  core glow and the Kitchen's pendants. Each carries the RoomLight tag and a Unit
	  attribute (room id or dug node) for the power system (dark rooms, blackouts).
	* Each room gets one vent (a breach point, Section 10) in its first cell, except the
	  Shaft and the Blast Door (the door is the surface breach point).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Bunker = require(Shared.Rules.Bunker)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)

local BunkerKit = {}

BunkerKit.FRONT_WALL_TAG = "FrontWall"
BunkerKit.ROOM_LIGHT_TAG = "RoomLight"
BunkerKit.CAMERA_FADE_TAG = "CameraFade"

local ASSET_TAG = "Asset" -- marks the source models in ServerStorage.Assets; copies drop it
local HALF_TURN = CFrame.Angles(0, math.pi, 0)

-- Graybox (Prompt 4) ---------------------------------------------------------------------

local DOOR_WIDTH, DOOR_HEIGHT = 8, 10 -- the kit's doorway
local CRUST, BEDROCK, EDGE = 6, 6, 6 -- rock around the grid
local SHAFT_HOLE = { FromX = 2, Depth = 8 } -- the opening between stacked Shafts, at the back right

local ROOM_COLORS: { [string]: Color3 } = {
	BlastDoor = Color3.fromRGB(96, 102, 110),
	Shaft = Color3.fromRGB(214, 168, 46),
	ReactorCore = Color3.fromRGB(58, 148, 160),
	Generator = Color3.fromRGB(210, 120, 40),
	Kitchen = Color3.fromRGB(200, 96, 64),
	WaterPurifier = Color3.fromRGB(70, 130, 190),
	Quarters = Color3.fromRGB(140, 120, 180),
	Medbay = Color3.fromRGB(226, 226, 220),
	Storage = Color3.fromRGB(150, 116, 80),
	Workshop = Color3.fromRGB(170, 150, 90),
}
local DEFAULT_ROOM_COLOR = Color3.fromRGB(170, 170, 160)
local WALL_COLOR = Color3.fromRGB(226, 216, 190) -- Steadfast cream
local FRONT_COLOR = Color3.fromRGB(200, 190, 166)
local CEILING_COLOR = Color3.fromRGB(236, 230, 214)
local LAMP_COLOR = Color3.fromRGB(255, 236, 196)
local BAND_COLORS: { [string]: Color3 } = {
	Mines = Color3.fromRGB(118, 94, 72),
	FloodedCaverns = Color3.fromRGB(74, 94, 108),
	CrystalHollows = Color3.fromRGB(100, 82, 128),
	SourceChamber = Color3.fromRGB(116, 52, 52),
}

-- Art lights ---------------------------------------------------------------------------------

type LightSpec = { Range: number, Brightness: number, Color: Color3 }

local CEILING_LIGHT: LightSpec = { Range = 18, Brightness = 1, Color = Color3.fromRGB(255, 228, 188) }
local DUG_LIGHTS: { [string]: LightSpec } = {
	Mines = { Range = 20, Brightness = 0.9, Color = Color3.fromRGB(255, 196, 120) },
	FloodedCaverns = { Range = 22, Brightness = 0.8, Color = Color3.fromRGB(140, 200, 210) },
	CrystalHollows = { Range = 22, Brightness = 1, Color = Color3.fromHex("8FE3E0") },
	SourceChamber = { Range = 22, Brightness = 1, Color = Color3.fromHex("7CFF9B") },
}
-- Rooms whose own Light sockets are real fixtures (the rest light from the ceiling kit).
local ACCENT_LIGHTS: { [string]: LightSpec } = {
	ReactorCore = { Range = 16, Brightness = 2, Color = Color3.fromHex("8FE3E0") },
	Kitchen = { Range = 12, Brightness = 0.8, Color = Color3.fromRGB(255, 214, 160) },
}
local NO_VENT: { [string]: boolean } = { Shaft = true, BlastDoor = true }

type Folders = { Root: Instance, Frame: Model, Rock: Model, Dug: Folder, Rooms: Folder }
type Socket = { Name: string, CFrame: CFrame }
type Holder = { Part: BasePart, Counters: { [string]: number }, Taken: { [string]: boolean } }

-- Parts --------------------------------------------------------------------------------------

-- An anchored block between two corners.
local function block(parent: Instance, name: string, low: Vector3, high: Vector3, color: Color3, material: Enum.Material): Part?
	local size = high - low
	if size.X <= 0.01 or size.Y <= 0.01 or size.Z <= 0.01 then
		return nil
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = CFrame.new((low + high) / 2)
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- A horizontal slab, with an optional rectangular hole (x and z ranges) cut out of it.
local function slab(
	parent: Instance,
	name: string,
	low: Vector3,
	high: Vector3,
	hole: { MinX: number, MaxX: number, MinZ: number, MaxZ: number }?,
	color: Color3,
	material: Enum.Material
)
	if not hole then
		block(parent, name, low, high, color, material)
		return
	end
	block(parent, name, low, Vector3.new(hole.MinX, high.Y, high.Z), color, material)
	block(parent, name, Vector3.new(hole.MaxX, low.Y, low.Z), high, color, material)
	block(parent, name, Vector3.new(hole.MinX, low.Y, low.Z), Vector3.new(hole.MaxX, high.Y, hole.MinZ), color, material)
	block(parent, name, Vector3.new(hole.MinX, low.Y, hole.MaxZ), Vector3.new(hole.MaxX, high.Y, high.Z), color, material)
end

-- The camera passes through this (and fades it when it hides the character).
local function fadeable(item: Instance)
	CollectionService:AddTag(item, BunkerKit.CAMERA_FADE_TAG)
end

local function newModel(name: string, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent
	return model
end

local function addLight(parent: Instance, spec: LightSpec, unit: string)
	local light = Instance.new("PointLight")
	light.Range = spec.Range
	light.Brightness = spec.Brightness
	light.Color = spec.Color
	light.Shadows = false
	light:SetAttribute("Unit", unit)
	CollectionService:AddTag(light, BunkerKit.ROOM_LIGHT_TAG)
	light.Parent = parent
end

local function lamp(parent: Instance, cell: Vector3, bright: boolean, unit: string)
	local t = Grid.Tuning()
	local y = cell.Y + t.CellHeight - 0.6
	local part = block(
		parent,
		"Lamp",
		Vector3.new(cell.X - 2, y - 0.2, cell.Z + 3),
		Vector3.new(cell.X + 2, y, cell.Z + 5),
		LAMP_COLOR,
		if bright then Enum.Material.Neon else Enum.Material.SmoothPlastic
	)
	if part then
		part.CanCollide = false
		part.CastShadow = false
		fadeable(part)
		addLight(part, {
			Range = if bright then 30 else 18,
			Brightness = if bright then 1.4 else 0.6,
			Color = LAMP_COLOR,
		}, unit)
	end
end

local function label(wall: BasePart, text: string)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label"
	gui.Face = Enum.NormalId.Back -- +Z: into the room
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.2
	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Size = UDim2.new(1, 0, 0, 56)
	textLabel.Position = UDim2.new(0, 0, 0, 16)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextScaled = true
	textLabel.TextColor3 = Color3.fromRGB(40, 44, 48)
	textLabel.Text = text
	textLabel.Parent = gui
	gui.Parent = wall
end

-- Art ----------------------------------------------------------------------------------------

local function art(category: string, name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = if assets then assets:FindFirstChild(category) else nil
	local found = if folder then folder:FindFirstChild(name) else nil
	if found and found:IsA("Model") then
		return found
	end
	return nil
end

-- Has this place got the art kit? Without it the bunker is all graybox.
function BunkerKit.HasArt(): boolean
	return art("Kit", "Kit_Floor") ~= nil
end

-- A copy of an art model with its pivot at `at`.
local function place(source: Model, name: string, parent: Instance, at: CFrame, persistent: boolean?): Model
	local copy = source:Clone()
	copy.Name = name
	CollectionService:RemoveTag(copy, ASSET_TAG)
	if persistent then
		copy.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end
	copy:PivotTo(at)
	copy.Parent = parent
	return copy
end

local function piece(name: string, label_: string, parent: Instance, at: CFrame): Model?
	local source = art("Kit", name)
	return if source then place(source, label_, parent, at) else nil
end

-- "WorkSpot12" -> "WorkSpot", 12; "Core" -> "Core", nil.
local function splitName(name: string): (string, number?)
	local base, digits = string.match(name, "^(.-)(%d+)$")
	if base and base ~= "" then
		return base, tonumber(digits)
	end
	return name, nil
end

-- A placed copy's sockets (its Socket_<name> attributes, in the model's own space) in the
-- world, sorted by name and then number.
local function socketsOf(copy: Model): { Socket }
	local list: { Socket } = {}
	local pivot = copy:GetPivot()
	for key, value in copy:GetAttributes() do
		local name = string.match(key, "^Socket_(.+)$")
		if name and typeof(value) == "CFrame" then
			table.insert(list, { Name = name, CFrame = pivot * value })
		end
	end
	table.sort(list, function(a: Socket, b: Socket): boolean
		local baseA, numberA = splitName(a.Name)
		local baseB, numberB = splitName(b.Name)
		if baseA ~= baseB then
			return baseA < baseB
		end
		return (numberA or 0) < (numberB or 0)
	end)
	return list
end

local function attach(part: BasePart, name: string, at: CFrame): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.CFrame = part.CFrame:ToObjectSpace(at)
	attachment.Parent = part
	return attachment
end

local function newHolder(model: Model, at: Vector3): Holder
	local part = Instance.new("Part")
	part.Name = "Sockets"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.CFrame = CFrame.new(at)
	part.Parent = model
	return { Part = part, Counters = {}, Taken = {} }
end

-- Adds a gameplay point to a room, numbered within the room (see the header).
local function addSocket(holder: Holder, name: string, at: CFrame, cellIndex: number): Attachment
	local base, number = splitName(name)
	local final = name
	if number then
		holder.Counters[base] = (holder.Counters[base] or 0) + 1
		final = base .. holder.Counters[base]
	elseif holder.Taken[name] then
		final = name .. cellIndex
	end
	holder.Taken[final] = true
	return attach(holder.Part, final, at)
end

-- Every socket of a placed copy into the room's holder; returns the new attachments.
local function collect(holder: Holder, copy: Model, cellIndex: number): { Attachment }
	local made = {}
	for _, socket in socketsOf(copy) do
		table.insert(made, addSocket(holder, socket.Name, socket.CFrame, cellIndex))
	end
	return made
end

local function tagFront(model: Model, whole: boolean)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and (whole or item:GetAttribute("Role") == "FrontWall") then
			CollectionService:AddTag(item, BunkerKit.FRONT_WALL_TAG)
		end
	end
end

-- The ceiling piece's two lamps, on its light strip.
local function ceilingLights(copy: Model, unit: string)
	local strip = copy:FindFirstChild("CeilingLight")
	if not (strip and strip:IsA("BasePart")) then
		return
	end
	for _, socket in socketsOf(copy) do
		if string.match(socket.Name, "^Light%d*$") then
			addLight(attach(strip, socket.Name, socket.CFrame), CEILING_LIGHT, unit)
		end
	end
end

-- Rooms: shells ------------------------------------------------------------------------------

type Shape = { ShaftBelow: boolean, ShaftAbove: boolean, LeftOpen: boolean, RightOpen: boolean }

-- A side wall on the plane between two cells: solid, or with a centred doorway.
local function sideWall(parent: Instance, name: string, x0: number, x1: number, floorY: number, z: number, doorway: boolean)
	local t = Grid.Tuning()
	local top = floorY + t.CellHeight
	local back, front = z - t.CellDepth / 2, z + t.CellDepth / 2
	if not doorway then
		block(parent, name, Vector3.new(x0, floorY, back), Vector3.new(x1, top, front), WALL_COLOR, Enum.Material.SmoothPlastic)
		return
	end
	local half = DOOR_WIDTH / 2
	block(parent, name, Vector3.new(x0, floorY, back), Vector3.new(x1, top, z - half), WALL_COLOR, Enum.Material.SmoothPlastic)
	block(parent, name, Vector3.new(x0, floorY, z + half), Vector3.new(x1, top, front), WALL_COLOR, Enum.Material.SmoothPlastic)
	block(parent, name, Vector3.new(x0, floorY + DOOR_HEIGHT, z - half), Vector3.new(x1, top, z + half), WALL_COLOR, Enum.Material.SmoothPlastic)
end

-- Inside a room of several cells the ceiling, back wall and front wall pieces leave the
-- 2-stud strip over the wall line between two cells bare: a steel beam closes the ceiling
-- and steel posts close the walls (the front post belongs to that front wall piece, so it
-- fades and hides with it).
local SEAM_COLOR = Color3.fromHex("8D969D") -- palette: steel
local SEAM_WIDTH = 2.4 -- over the 2-stud strip, a little each side
local SEAM_DEPTH = 0.6

local function seamPart(parent: Instance, name: string, low: Vector3, high: Vector3): Part?
	local part = block(parent, name, low, high, SEAM_COLOR, Enum.Material.SmoothPlastic)
	if part then
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end
	return part
end

local function seams(model: Model, floor: number, column: number, front: Model?)
	local t = Grid.Tuning()
	local cell = Grid.CellPosition(floor, column)
	local x = cell.X - t.CellWidth / 2 - t.WallThickness -- the line between this cell and the one on its left
	local y0, top = cell.Y, cell.Y + t.CellHeight
	local back, frontZ = cell.Z - t.CellDepth / 2, cell.Z + t.CellDepth / 2
	local half = SEAM_WIDTH / 2
	seamPart(model, "CeilingSeam", Vector3.new(x - t.WallThickness, top - 1.5, back), Vector3.new(x + t.WallThickness, top, frontZ))
	seamPart(model, "BackSeam", Vector3.new(x - half, y0, back), Vector3.new(x + half, top, back + SEAM_DEPTH))
	local post = seamPart(front or model, "FrontSeam", Vector3.new(x - half, y0, frontZ - SEAM_DEPTH), Vector3.new(x + half, top, frontZ))
	if post then
		CollectionService:AddTag(post, BunkerKit.FRONT_WALL_TAG)
	end
end

-- The art shell: per cell a floor, a ceiling with its lamps, a back and a front wall, and
-- side walls at the room's two ends (the left one is the right-hand piece turned around).
local function shellArt(model: Model, room: Bunker.Room, shape: Shape)
	for offset = 0, room.Span - 1 do
		local column = room.Column + offset
		local key = Grid.Key(room.Floor, column)
		local at = Grid.CellCFrame(room.Floor, column)
		local floor = piece(if shape.ShaftBelow then "Kit_FloorHole" else "Kit_Floor", `Floor {key}`, model, at)
		local rail = if floor then floor:FindFirstChild("HoleRail") else nil
		if rail then
			fadeable(rail)
		end
		local ceiling = piece(if shape.ShaftAbove then "Kit_CeilingHole" else "Kit_Ceiling", `Ceiling {key}`, model, at)
		if ceiling then
			ceilingLights(ceiling, room.Id)
		end
		piece("Kit_WallBack", `WallBack {key}`, model, at)
		local front = piece("Kit_WallFront", `WallFront {key}`, model, at)
		if offset == 0 then
			piece(if shape.LeftOpen then "Kit_WallSideDoor" else "Kit_WallSide", `WallLeft {key}`, model, at * HALF_TURN)
		else
			seams(model, room.Floor, column, front)
		end
		if front then
			tagFront(front, true)
		end
		if offset == room.Span - 1 then
			piece(if shape.RightOpen then "Kit_WallSideDoor" else "Kit_WallSide", `WallRight {key}`, model, at)
		end
	end
end

-- The graybox shell (Prompt 4): slabs, walls with doorways, a lamp per cell and a label.
local function shellGraybox(model: Model, room: Bunker.Room, info: { [string]: any }, shape: Shape)
	local t = Grid.Tuning()
	local W, H, D, T, S = t.CellWidth, t.CellHeight, t.CellDepth, t.WallThickness, t.SlabThickness
	local first = Grid.CellPosition(room.Floor, room.Column)
	local last = Grid.CellPosition(room.Floor, room.Column + room.Span - 1)
	local y0, z0 = first.Y, first.Z
	local xL, xR = first.X - W / 2 - T, last.X + W / 2 + T
	local color = ROOM_COLORS[room.Type] or DEFAULT_ROOM_COLOR
	local hole = {
		MinX = first.X + SHAFT_HOLE.FromX,
		MaxX = first.X + W / 2,
		MinZ = z0 - D / 2,
		MaxZ = z0 - D / 2 + SHAFT_HOLE.Depth,
	}

	slab(model, "Floor", Vector3.new(xL, y0 - S, z0 - D / 2 - T), Vector3.new(xR, y0, z0 + D / 2 + T), if shape.ShaftBelow then hole else nil, color, Enum.Material.SmoothPlastic)
	slab(model, "Ceiling", Vector3.new(xL + T, y0 + H - 0.5, z0 - D / 2), Vector3.new(xR - T, y0 + H, z0 + D / 2), if shape.ShaftAbove then hole else nil, CEILING_COLOR, Enum.Material.SmoothPlastic)
	local back = block(model, "BackWall", Vector3.new(xL, y0, z0 - D / 2 - T), Vector3.new(xR, y0 + H, z0 - D / 2), WALL_COLOR, Enum.Material.SmoothPlastic)
	local front = block(model, "FrontWall", Vector3.new(xL, y0, z0 + D / 2), Vector3.new(xR, y0 + H, z0 + D / 2 + T), FRONT_COLOR, Enum.Material.SmoothPlastic)
	if front then
		CollectionService:AddTag(front, BunkerKit.FRONT_WALL_TAG)
	end
	sideWall(model, "SideWallLeft", xL, xL + T, y0, z0, shape.LeftOpen)
	sideWall(model, "SideWallRight", xR - T, xR, y0, z0, shape.RightOpen)
	for offset = 0, room.Span - 1 do
		lamp(model, Grid.CellPosition(room.Floor, room.Column + offset), true, room.Id)
	end
	if back then
		label(back, `{info.Name}  L{room.Level}  ({room.Id})`)
	end
end

-- Rooms: insides -----------------------------------------------------------------------------

-- The graybox stair up from a Shaft to the Shaft above: a plank along the back, rising to
-- the right.
local function grayboxStair(parent: Instance, cell: Vector3)
	local t = Grid.Tuning()
	local rise = t.CellHeight + t.SlabThickness
	local run = t.CellWidth - 4
	local zMid = cell.Z - t.CellDepth / 2 + SHAFT_HOLE.Depth / 2
	local angle = math.atan2(rise, run)
	local length = math.sqrt(rise * rise + run * run)
	local normal = Vector3.new(-math.sin(angle), math.cos(angle), 0)
	local mid = Vector3.new(cell.X, cell.Y + rise / 2, zMid) - normal * 0.5
	local plank = Instance.new("Part")
	plank.Name = "Stair"
	plank.Anchored = true
	plank.Size = Vector3.new(length, 1, SHAFT_HOLE.Depth)
	plank.CFrame = CFrame.new(mid) * CFrame.Angles(0, 0, angle)
	plank.Color = ROOM_COLORS.Shaft
	plank.Material = Enum.Material.DiamondPlate
	fadeable(plank)
	plank.Parent = parent
end

-- Graybox stand-ins for a room's furniture when its art is missing, with the same sockets.
local function grayboxInterior(model: Model, room: Bunker.Room, info: { [string]: any }, centre: Vector3, holder: Holder)
	local t = Grid.Tuning()
	local y0, z0 = centre.Y, centre.Z
	local backZ = z0 - t.CellDepth / 2
	if room.Type == "ReactorCore" then
		local base = block(model, "CoreBase", Vector3.new(centre.X - 4, y0, z0 - 8), Vector3.new(centre.X + 4, y0 + 1, z0), Color3.fromRGB(60, 64, 70), Enum.Material.DiamondPlate)
		if base then
			fadeable(base)
		end
		local core = Instance.new("Part")
		core.Name = "Core"
		core.Anchored = true
		core.Shape = Enum.PartType.Cylinder
		core.Size = Vector3.new(10, 5, 5)
		core.CFrame = CFrame.new(centre.X, y0 + 6, z0 - 4) * CFrame.Angles(0, 0, math.rad(90))
		core.Material = Enum.Material.Neon
		core.Color = Color3.fromRGB(90, 200, 230)
		fadeable(core)
		core.Parent = model
		addSocket(holder, "Core", CFrame.new(centre.X, y0, z0 - 4), 1)
	elseif room.Type == "BlastDoor" then
		local door = Instance.new("Part")
		door.Name = "Door"
		door.Anchored = true
		door.Shape = Enum.PartType.Cylinder
		door.Size = Vector3.new(1, 13, 13)
		door.CFrame = CFrame.new(centre.X, y0 + 7, backZ + 0.5) * CFrame.Angles(0, math.rad(90), 0)
		door.Material = Enum.Material.DiamondPlate
		door.Color = Color3.fromRGB(70, 74, 80)
		fadeable(door)
		door.Parent = model
		addSocket(holder, "Door", CFrame.new(centre.X, y0, backZ + 3), 1)
		addSocket(holder, "SurfaceExit", CFrame.new(centre.X, y0 + t.CellHeight, backZ + 3), 1)
	elseif room.Type == "Medbay" then
		addSocket(holder, "Respawn", CFrame.new(centre.X, y0, z0 + 6), 1)
	elseif room.Type == "Quarters" and info.Beds then
		local beds = info.Beds[room.Level]
		for offset = 0, room.Span - 1 do
			local cell = Grid.CellPosition(room.Floor, room.Column + offset)
			local pitch = (t.CellWidth - 2) / beds
			for index = 1, beds do
				local x = cell.X - t.CellWidth / 2 + 1 + pitch * (index - 0.5)
				local bed = block(model, "Bed", Vector3.new(x - 1.4, y0, backZ + 0.5), Vector3.new(x + 1.4, y0 + 1.6, backZ + 7), Color3.fromRGB(120, 104, 160), Enum.Material.Fabric)
				if bed then
					bed:SetAttribute("Bed", offset * beds + index)
					fadeable(bed)
				end
				addSocket(holder, `Bed{index}`, CFrame.new(x, y0 + 1.6, backZ + 3.75), offset + 1)
			end
		end
	end
end

-- A room's insides: the Blast Door set, the Shaft stair, or its furniture per cell, then
-- its vent. Missing art falls back to the graybox. Returns whether the furniture is art.
local function interior(model: Model, room: Bunker.Room, info: { [string]: any }, shape: Shape, centre: Vector3, holder: Holder): boolean
	local first = Grid.CellPosition(room.Floor, room.Column)
	local isArt = false
	if room.Type == "BlastDoor" then
		local source = art("Kit", `Kit_BlastDoor_L{room.Level}`)
		if source then
			local set = place(source, "BlastDoor", model, CFrame.new(centre) * HALF_TURN)
			fadeable(set)
			collect(holder, set, 1)
			isArt = true
		else
			grayboxInterior(model, room, info, centre, holder)
		end
	elseif room.Type == "Shaft" then
		isArt = BunkerKit.HasArt()
		if shape.ShaftAbove then
			local source = art("Kit", `Kit_Shaft_L{room.Level}`)
			if source then
				local stair = place(source, "Stair", model, Grid.CellCFrame(room.Floor, room.Column))
				fadeable(stair)
				collect(holder, stair, 1)
			else
				grayboxStair(model, first)
				isArt = false
			end
		end
	else
		local source = art("Rooms", `Room_{room.Type}_L{room.Level}`)
		if source then
			local accent = ACCENT_LIGHTS[room.Type]
			for offset = 0, room.Span - 1 do
				local column = room.Column + offset
				local copy = place(source, `Interior {Grid.Key(room.Floor, column)}`, model, Grid.CellCFrame(room.Floor, column))
				fadeable(copy)
				for _, attachment in collect(holder, copy, offset + 1) do
					if accent and string.match(attachment.Name, "^Light%d*$") then
						addLight(attachment, accent, room.Id)
					end
				end
			end
			isArt = true
		else
			grayboxInterior(model, room, info, centre, holder)
		end
	end
	if not NO_VENT[room.Type] then
		local vent = piece("Kit_Vent", "Vent", model, Grid.CellCFrame(room.Floor, room.Column))
		if vent then
			fadeable(vent)
			collect(holder, vent, 1)
		end
	end
	return isArt
end

-- The players' spawn on the Medbay's Respawn point: invisible on the art pad, a red pad in
-- the graybox.
local function medbaySpawn(model: Model, holder: Holder, visible: boolean)
	local respawn = holder.Part:FindFirstChild("Respawn")
	if not (respawn and respawn:IsA("Attachment")) then
		return
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "MedbaySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(6, if visible then 1 else 0.2, 6)
	spawn.CFrame = CFrame.new(respawn.WorldPosition + Vector3.new(0, spawn.Size.Y / 2, 0))
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Color = Color3.fromRGB(196, 60, 60)
	if not visible then
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.CanQuery = false
		spawn.CastShadow = false
	end
	for _, child in spawn:GetChildren() do
		if child:IsA("Decal") then
			child:Destroy()
		end
	end
	spawn.Parent = model
end

-- Units --------------------------------------------------------------------------------------

local function buildRoom(bunker: Bunker.Bunker, room: Bunker.Room, parent: Instance): Model
	local info = Config.Get("Rooms", room.Type)
	local first = Grid.CellPosition(room.Floor, room.Column)
	local last = Grid.CellPosition(room.Floor, room.Column + room.Span - 1)
	local centre = (first + last) / 2

	local model = newModel(room.Id, parent)
	model:SetAttribute("RoomId", room.Id)
	model:SetAttribute("RoomType", room.Type)
	model:SetAttribute("Floor", room.Floor)
	model:SetAttribute("Column", room.Column)
	model:SetAttribute("Span", room.Span)
	model:SetAttribute("Level", room.Level)

	local shape: Shape = {
		ShaftBelow = room.Type == "Shaft" and bunker:IsShaft(room.Floor + 1, room.Column),
		ShaftAbove = room.Type == "Shaft" and bunker:IsShaft(room.Floor - 1, room.Column),
		LeftOpen = bunker:IsOpen(room.Floor, room.Column - 1),
		RightOpen = bunker:IsOpen(room.Floor, room.Column + room.Span),
	}
	local holder = newHolder(model, centre)
	local artShell = BunkerKit.HasArt()
	if artShell then
		shellArt(model, room, shape)
	else
		shellGraybox(model, room, info, shape)
	end
	local artInside = interior(model, room, info, shape, centre, holder)
	medbaySpawn(model, holder, not artInside)
	model:SetAttribute("Art", artShell and artInside)
	return model
end

local function buildDug(floor: number, column: number, parent: Instance): Model
	local t = Grid.Tuning()
	local band = Grid.BandOf(floor)
	local name = "D:" .. Grid.Key(floor, column)
	local source = art("Kit", `Kit_Dug_{band.Id}`)
	if source then
		local model = place(source, name, parent, Grid.CellCFrame(floor, column), true)
		model:SetAttribute("Floor", floor)
		model:SetAttribute("Column", column)
		model:SetAttribute("Band", band.Id)
		model:SetAttribute("Art", true)
		tagFront(model, false)
		for _, item in model:GetChildren() do
			if item:IsA("BasePart") and item.Name ~= "Floor" and item.Name ~= "BackRock" and item.Name ~= "FrontWall" then
				fadeable(item) -- timber, carts, pipes and other cave props
			end
		end
		local host = model:FindFirstChild("Floor")
		if host and host:IsA("BasePart") then
			for _, socket in socketsOf(model) do
				if socket.Name == "Light" then
					addLight(attach(host, "Light", socket.CFrame), DUG_LIGHTS[band.Id] or DUG_LIGHTS.Mines, name)
				end
			end
		end
		return model
	end

	local W, H, D, T, S = t.CellWidth, t.CellHeight, t.CellDepth, t.WallThickness, t.SlabThickness
	local cell = Grid.CellPosition(floor, column)
	local rock = BAND_COLORS[band.Id] or BAND_COLORS.Mines
	local model = newModel(name, parent)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	local x0, x1 = cell.X - W / 2 - T, cell.X + W / 2 + T
	block(model, "Floor", Vector3.new(x0, cell.Y - S, cell.Z - D / 2 - T), Vector3.new(x1, cell.Y, cell.Z + D / 2 + T), rock:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Ground)
	block(model, "BackRock", Vector3.new(x0, cell.Y, cell.Z - D / 2 - T), Vector3.new(x1, cell.Y + H, cell.Z - D / 2), rock, Enum.Material.Slate)
	local front = block(model, "FrontWall", Vector3.new(x0, cell.Y, cell.Z + D / 2), Vector3.new(x1, cell.Y + H, cell.Z + D / 2 + T), rock, Enum.Material.Slate)
	if front then
		CollectionService:AddTag(front, BunkerKit.FRONT_WALL_TAG)
	end
	lamp(model, cell, false, name)
	return model
end

-- Construction sites (Prompt 8) ----------------------------------------------------------------

local TIMBER = Color3.fromRGB(118, 94, 72)
local HAZARD = Color3.fromRGB(214, 168, 46)
local SITE_GHOST = { From = 0.8, To = 0.3 } -- the coming room's transparency, from the start to the end

--[[
	A construction site in open cells (BuildService): the coming room's interior art, see-through
	and firming up as the build goes on (SetSiteProgress), behind a timber scaffold with a
	hazard-striped plank. Graybox scaffolding until the art kit has a scaffold piece. Nothing on
	it collides; the camera passes through it. An upgrade site (`upgrade`, Nightmare's upgrades)
	is the scaffold alone: the room is already there and keeps working until it is done.
]]
function BunkerKit.Site(parent: Instance, name: string, roomType: string, floor: number, column: number, span: number, upgrade: boolean?): Model
	local t = Grid.Tuning()
	local model = newModel(name, parent)
	model:SetAttribute("RoomType", roomType)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	model:SetAttribute("Span", span)
	local ghost = Instance.new("Model")
	ghost.Name = "Ghost"
	ghost.Parent = if upgrade then nil else model
	local source = art("Rooms", `Room_{roomType}_L1`)
	for offset = 0, span - 1 do
		local cell = Grid.CellPosition(floor, column + offset)
		if upgrade then
			-- no ghost: the room stands there already
		elseif source then
			place(source, `Interior {Grid.Key(floor, column + offset)}`, ghost, Grid.CellCFrame(floor, column + offset))
		else
			local color = ROOM_COLORS[roomType] or DEFAULT_ROOM_COLOR
			block(ghost, "Block", cell + Vector3.new(-t.CellWidth / 4, 0, -t.CellDepth / 4), cell + Vector3.new(t.CellWidth / 4, t.CellHeight / 3, t.CellDepth / 4), color, Enum.Material.SmoothPlastic)
		end
		-- the scaffold: two posts, a top beam and a striped plank across the back of the cell
		local x0, x1 = cell.X - t.CellWidth / 2 + 2, cell.X + t.CellWidth / 2 - 2
		local z = cell.Z - t.CellDepth / 2 + 3
		for _, x in { x0, x1 } do
			block(model, "Post", Vector3.new(x - 0.5, cell.Y, z - 0.5), Vector3.new(x + 0.5, cell.Y + t.CellHeight - 0.5, z + 0.5), TIMBER, Enum.Material.Wood)
		end
		block(model, "Beam", Vector3.new(x0 - 0.5, cell.Y + t.CellHeight - 2, z - 0.5), Vector3.new(x1 + 0.5, cell.Y + t.CellHeight - 1, z + 0.5), TIMBER, Enum.Material.Wood)
		block(model, "Plank", Vector3.new(x0 - 0.5, cell.Y + t.CellHeight * 0.45, z - 0.3), Vector3.new(x1 + 0.5, cell.Y + t.CellHeight * 0.45 + 1.2, z + 0.3), HAZARD, Enum.Material.SmoothPlastic)
	end
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanTouch = false
			item.CanQuery = false
			item.CastShadow = false
			if item:IsDescendantOf(ghost) then
				item:SetAttribute("SiteSolid", item.Transparency)
			end
		elseif item:IsA("Light") or item:IsA("ProximityPrompt") or item:IsA("Script") then
			item:Destroy()
		end
	end
	fadeable(model)
	BunkerKit.SetSiteProgress(model, 0)
	return model
end

-- Firms the coming room up as its site builds (0 to 1), in steps of 5% so it isn't sent every frame.
function BunkerKit.SetSiteProgress(model: Model, progress: number)
	local ghost = model:FindFirstChild("Ghost")
	if not ghost then
		return
	end
	local alpha = SITE_GHOST.From + (SITE_GHOST.To - SITE_GHOST.From) * math.clamp(progress, 0, 1)
	alpha = math.floor(alpha * 20 + 0.5) / 20
	if model:GetAttribute("SiteAlpha") == alpha then
		return
	end
	model:SetAttribute("SiteAlpha", alpha)
	for _, item in ghost:GetDescendants() do
		if item:IsA("BasePart") then
			local solid = item:GetAttribute("SiteSolid")
			if type(solid) == "number" and solid < 1 then
				item.Transparency = math.max(solid, alpha)
			end
		end
	end
end

-- A rock cell's art, turned half a turn on alternate cells so the face doesn't repeat.
local function rockArt(bandId: string, name: string, parent: Instance, floor: number, column: number): Model?
	local source = art("Kit", `Kit_Rock_{bandId}`)
	if not source then
		return nil
	end
	local at = Grid.CellCFrame(floor, column)
	if (floor + column) % 2 == 1 then
		at *= HALF_TURN
	end
	local model = place(source, name, parent, at)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	model:SetAttribute("Band", bandId)
	return model
end

local function buildRock(floor: number, column: number, parent: Instance)
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local band = Grid.BandOf(floor)
	local key = Grid.Key(floor, column)
	if rockArt(band.Id, key, parent, floor, column) then
		return
	end
	local cell = Grid.CellPosition(floor, column)
	local part = block(
		parent,
		key,
		Vector3.new(cell.X - pitch.X / 2, cell.Y - t.SlabThickness, cell.Z - pitch.Z / 2),
		Vector3.new(cell.X + pitch.X / 2, cell.Y + t.CellHeight, cell.Z + pitch.Z / 2),
		BAND_COLORS[band.Id] or BAND_COLORS.Mines,
		Enum.Material.Slate
	)
	if part then
		part:SetAttribute("Floor", floor)
		part:SetAttribute("Column", column)
		part:SetAttribute("Band", band.Id)
	end
end

local function buildFrame(parent: Model)
	local t = Grid.Tuning()
	if art("Kit", "Kit_Rock_Mines") then
		-- A ring of rock cells: the Mines above floor 1, the Source's rock under floor 10, and
		-- each floor's band at the grid's two sides.
		for floor = t.FloorMin - 1, t.FloorMax + 1 do
			local outside = floor < t.FloorMin or floor > t.FloorMax
			local bandId = if floor < t.FloorMin then "Mines" elseif floor > t.FloorMax then "SourceChamber" else Grid.BandOf(floor).Id
			for column = t.ColumnMin - 1, t.ColumnMax + 1 do
				if outside or column < t.ColumnMin or column > t.ColumnMax then
					rockArt(bandId, `Frame {Grid.Key(floor, column)}`, parent, floor, column)
				end
			end
		end
		return
	end

	local pitch = Grid.Pitch()
	local topCell = Grid.CellPosition(t.FloorMin, t.ColumnMin)
	local bottomCell = Grid.CellPosition(t.FloorMax, t.ColumnMax)
	local left = topCell.X - pitch.X / 2
	local right = bottomCell.X + pitch.X / 2
	local top = topCell.Y + t.CellHeight
	local bottom = bottomCell.Y - t.SlabThickness
	local back, front = topCell.Z - pitch.Z / 2, topCell.Z + pitch.Z / 2
	local crust = BAND_COLORS.Mines:Lerp(Color3.fromRGB(90, 80, 60), 0.5)
	for column = t.ColumnMin, t.ColumnMax do
		local x = Grid.CellPosition(t.FloorMin, column).X
		block(parent, `Crust {column}`, Vector3.new(x - pitch.X / 2, top, back), Vector3.new(x + pitch.X / 2, top + CRUST, front), crust, Enum.Material.Ground)
	end
	block(parent, "Bedrock", Vector3.new(left - EDGE, bottom - BEDROCK, back), Vector3.new(right + EDGE, bottom, front), Color3.fromRGB(40, 34, 34), Enum.Material.Basalt)
	block(parent, "EdgeLeft", Vector3.new(left - EDGE, bottom, back), Vector3.new(left, top + CRUST, front), crust, Enum.Material.Slate)
	block(parent, "EdgeRight", Vector3.new(right, bottom, back), Vector3.new(right + EDGE, top + CRUST, front), crust, Enum.Material.Slate)
end

-- Sync ---------------------------------------------------------------------------------------

local function folders(root: Instance): Folders
	local function child(name: string, className: string): Instance
		local found = root:FindFirstChild(name)
		if not found then
			found = Instance.new(className)
			found.Name = name
			if found:IsA("Model") then
				found.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
			end
			found.Parent = root
		end
		return found :: Instance
	end
	return {
		Root = root,
		Frame = child("Frame", "Model") :: Model,
		Rock = child("Rock", "Model") :: Model,
		Dug = child("Dug", "Folder") :: Folder,
		Rooms = child("Rooms", "Folder") :: Folder,
	}
end

--[[
	Makes the world under `root` match `bunker`. With `dirty` (cell keys), only those cells
	and the units holding them are rebuilt (BunkerGrid passes the changed cells and their
	neighbours); without it, everything is.
]]
function BunkerKit.Sync(bunker: Bunker.Bunker, root: Instance, dirty: { [string]: boolean }?)
	local t = Grid.Tuning()
	local f = folders(root)
	if #f.Frame:GetChildren() == 0 then
		buildFrame(f.Frame)
	end

	local keys: { string } = {}
	if dirty then
		for key in dirty do
			table.insert(keys, key)
		end
	else
		for floor = t.FloorMin, t.FloorMax do
			for column = t.ColumnMin, t.ColumnMax do
				table.insert(keys, Grid.Key(floor, column))
			end
		end
	end

	local units: { [string]: boolean } = {}
	for _, key in keys do
		local floor, column = Grid.Parse(key)
		if not floor or not column or not Grid.OnGrid(floor, column) then
			continue
		end
		local rock = f.Rock:FindFirstChild(key)
		if bunker:State(floor, column) == "Rock" then
			if not rock then
				buildRock(floor, column, f.Rock)
			end
		else
			if rock then
				rock:Destroy()
			end
			local unit = bunker:UnitAt(floor, column)
			if unit then
				units[unit] = true
			end
		end
	end

	-- Models whose unit is gone or is being rebuilt
	for _, model in f.Rooms:GetChildren() do
		if units[model.Name] or bunker:Room(model.Name) == nil then
			model:Destroy()
		end
	end
	for _, model in f.Dug:GetChildren() do
		local floor, column = Grid.Parse(string.sub(model.Name, 3))
		local current = if floor and column then bunker:UnitAt(floor, column) else nil
		if units[model.Name] or current ~= model.Name then
			model:Destroy()
		end
	end

	for unit in units do
		local room = bunker:Room(unit)
		if room then
			buildRoom(bunker, room, f.Rooms)
		else
			local floor, column = Grid.Parse(string.sub(unit, 3))
			if floor and column then
				buildDug(floor, column, f.Dug)
			end
		end
	end
end

-- Queries ------------------------------------------------------------------------------------

-- A room's gameplay point (an Attachment on its Sockets part), in the world.
function BunkerKit.Socket(model: Instance, name: string): CFrame?
	local holder = model:FindFirstChild("Sockets")
	local attachment = if holder then holder:FindFirstChild(name) else nil
	if attachment and attachment:IsA("Attachment") then
		return attachment.WorldCFrame
	end
	return nil
end

-- A room's gameplay points whose names match a Lua pattern ("^WorkSpot%d+$"), or all.
function BunkerKit.Sockets(model: Instance, pattern: string?): { [string]: CFrame }
	local found: { [string]: CFrame } = {}
	local holder = model:FindFirstChild("Sockets")
	if holder then
		for _, item in holder:GetChildren() do
			if item:IsA("Attachment") and (pattern == nil or string.match(item.Name, pattern)) then
				found[item.Name] = item.WorldCFrame
			end
		end
	end
	return found
end

-- Counts parts under the bunker (DevTools).
function BunkerKit.PartCount(root: Instance): number
	local count = 0
	for _, item in root:GetDescendants() do
		if item:IsA("BasePart") then
			count += 1
		end
	end
	return count
end

return BunkerKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000EC"><Properties><string name="Name">ClassAbilities</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ClassAbilities: what each class ability does in the world, and the class devices that stay in it
	(bible Section 14). ClassService owns who has which class, cooldowns, uses and the remotes; this
	module is called with the player's class state and does the rest. Numbers: Tuning.Classes
	(provisional) and Config.Classes.

	Use(state, option, origin, look) -> (ok, text?, effect?, seconds?): ok spends the cooldown or the
	use; text is told to the player (a warning when not ok); effect and seconds are what stays on the
	player (Hold the Line's "Hold", a drone mode), for ClassService's damage filter and the HUD.

	The abilities (Section 14):
	* Survivor, Second Wind: heal SecondWindFraction of max health.
	* Engineer, Deploy Turret: an auto-turret in front of you (Prop_Turret) for its duration
	  (TurretDuration at level 3, shocks with TurretShock): it shoots the nearest monster in Range it
	  can see. One turret each; a new one replaces the old.
	  Barricades (Section 10: the Engineer seals a breach point): every room vent has a Barricade
	  prompt only Engineers see (ForClass); it costs the Barricade recipe (Config.Recipes; BarricadeCost:
	  half at level 2) from the stockpile and takes its Seconds. A barricaded vent opens less often
	  (BreachService's Barricaded, BarricadeWeight); the barricade stays with its room.
	* Medic, Triage Pulse: TriageHeal to every player, resident and rescued survivor within
	  TriageRadius; level 3 also clears radiation and goo slow (resident conditions are Prompt 26).
	  Touch heal (the passive): residents within TouchHealRange of a Medic heal TouchHealPerSecond.
	* Firefighter, Foam Burst: the fire in the room you stand in (else the nearest burning room within
	  FoamRange) goes out at once, and so does a flood (DisasterService:Drain; Prompt 23).
	* Cook, Hearty Meal: the team's max health and stamina x its modifiers for one cycle, residents
	  +MoraleNow; level 2 heals everyone (MealHealFraction). The Cook's Kitchen bonus (Presence) follows
	  them into any Kitchen.
	* Security, Hold the Line: monsters within TauntRadius come for you (MonsterService:Taunt) and you
	  take HoldDamageTaken of their damage, for its duration.
	* Scout, Flare Ping: enemies (red), loot (amber) and survivors (green) within FlareRadius are
	  outlined for its duration, for the whole team.
	* Quartermaster, Emergency Requisition: RequisitionScrap Scrap, or RequisitionFoodWater Food and
	  Water, into the stockpile (up to its caps).
	* Radio Operator, Supply Call: a crate lands in front of you (Prop_SupplyCrate); opened, CrateLoot
	  goes into the stockpile in the bunker, or the opener's pack elsewhere.
	* Hazmat Tech, Decon Field: radiation off everyone in your room (within DeconRadius away from
	  rooms), and the gas out of your room (DisasterService:ClearGas; Prompt 23).
	* Exterminator, Napalm Line: a burning strip (Napalm Length by Width) ahead of you for its
	  duration: monsters in it burn. Burning (flame guns and napalm) hurts Burn.DamagePerSecond for
	  Burn.Seconds; the Exterminator's burning spreads between monsters within Burn.SpreadRadius
	  (never to rooms: players' fire never starts room fires).
	* Marksman, Steady Shot: the next SteadyShots gun shots pierce and crit (WeaponService's shot hook).
	* Driller, Overdrive: OverdriveCells rock cells in a line from your cell (the way you look: left,
	  right or down) dig at once, each adding its Disturbance; not past the dig limit.
	* Scavenger, Magnet Sweep: containers, cave caches and dropped packs within MagnetRadius come to you.
	* Warden, Rally Call: armed residents within RallyFloors floors come to you and fight beside you,
	  RallyDamage times as hard, for its duration (ResidentBrain:Rally). Armed residents come with
	  Prompt 26's gear.
	* Demolitionist, Breaching Charge: a blast (Breaching Damage and Radius, times the explosive
	  modifiers) where you aim within Breaching Range; a rock cell there is cleared.
	* Spelunker, Grapple Line: zip to where you aim (Grapple Range), or pull the teammate you aim at
	  to you. The client moves the character (the Grapple remote).
	* Mad Scientist, Gadget Belt: Shock Trap (stuns what comes within Trap Radius), Teleport Beacon
	  (BeaconSeconds; the team teleports to it: TeleportToBeacon) or Gravity Well (holds and pulls
	  monsters within its Radius for its Seconds), each on its own cooldown.
	* Tinkerer, Drone Mode: the combat drone (always beside a Tinkerer: Prop_CombatDrone) shoots the
	  nearest monster it sees and picks up dropped packs near you; Guard (you take GuardDamageTaken),
	  Assault (AssaultMultiplier damage) or Repair (it repairs the nearest damaged room within
	  RepairRange instead of shooting) for the mode's duration. Level 2: two guns (fires twice as
	  often). Level 3: the drone revives you once per Surge (Drone.ReviveSeconds after you go down).
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Dig = require(Shared.Rules.Dig)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Loot = require(Shared.Rules.Loot)
local Modifiers = require(Shared.Rules.Modifiers)
local Classes = require(Shared.Rules.Classes)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local RunState = require(Shared.RunState)
local Surface = require(Shared.Rules.Surface)
local Hazards = require(ServerScriptService.Lib.Hazards)

local log = Log.new("ClassAbilities")

export type State = {
	Player: Player,
	Class: string,
	Level: number,
	Option: number,
	Effect: string?,
	EffectUntil: number,
	Shots: number,
	DroneRevives: number,
}
export type Context = {
	Combat: any,
	Weapons: any,
	Monsters: any,
	Boss: any,
	Grid: any,
	Economy: any,
	Build: any,
	Disasters: any,
	Dig: any,
	Residents: any,
	Brain: any,
	Breaches: any,
	Surface: any,
	Deep: any,
	Inventory: any,
	Rescue: any,
	Clock: any,
	Session: any,
	State: (Player) -> State?,
	SetBeacon: (until_: number?, by: string?) -> (),
}

type Turret = { Owner: Player, Model: Model, Until: number, NextShot: number, Shock: boolean, Shots: number }
type Drone = { Owner: Player, Part: BasePart, Align: AlignPosition, Turn: AlignOrientation, NextShot: number, NextPickup: number, Shots: number }
type Strip = { Owner: Player, Part: BasePart, CFrame: CFrame, Size: Vector3, Until: number }
type Well = { Owner: Player, Part: BasePart, At: Vector3, Until: number }
type Trap = { Owner: Player, Part: BasePart, At: Vector3, Until: number }
type Burn = { Owner: Player?, Until: number, Spreads: boolean, Fire: Fire?, FireId: number }

local ctx: Context = nil :: any
local rng = Random.new()
local turrets: { [Player]: Turret } = {}
local drones: { [Player]: Drone } = {}
local strips: { Strip } = {}
local wells: { Well } = {}
local traps: { Trap } = {}
local burning: { [string]: Burn } = {} -- monster combatant id
-- Each fire a flame starts has an id, and a spread carries it on: a monster burns once in a given
-- fire (two monsters side by side passed one fire back and forth for good: playtest, Prompt 20).
local fireCount = 0
local lastFire: { [string]: number } = {} -- monster combatant id -> the fire it last burned in
local beacon: { Part: BasePart, Until: number, By: Player }? = nil
local barricaded: { [string]: boolean } = {} -- room id
local barricadeSpots: { [string]: BasePart } = {} -- room id -> the prompt's part
local crates = 0

local Abilities = {}

local function t(): { [string]: any }
	return Classes.Tuning()
end

local function now(): number
	return workspace:GetServerTimeNow()
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function standing(player: Player): boolean
	return player.Parent == Players and player:GetAttribute("Life") == "Alive" and rootOf(player) ~= nil
end

local function holder(name: string): Folder
	local found = workspace:FindFirstChild(name)
	if found and found:IsA("Folder") then
		return found
	end
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = workspace
	return folder
end

local function art(category: string, name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild(category)
	local model = folder and folder:FindFirstChild(name)
	return if model and model:IsA("Model") then model else nil
end

local function fx(player: Player, kind: string, at: Vector3?, data: { [string]: any }?)
	local state = ctx.State(player)
	Remotes.FireAllClients("AbilityFx", player.UserId, if state then state.Class else "", kind, at, data or {})
end

local function bodiesOf(): { Instance }
	local list: { Instance } = {}
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(list, p.Character)
		end
	end
	local monsters = workspace:FindFirstChild("Monsters")
	if monsters then
		table.insert(list, monsters)
	end
	for _, name in { "ClassDevices", "Finds", "Rescues", "Dummies" } do -- Dummies: the dev command's targets
		local folder = workspace:FindFirstChild(name)
		if folder then
			table.insert(list, folder)
		end
	end
	local bunker = workspace:FindFirstChild("Bunker")
	local residents = bunker and bunker:FindFirstChild("Residents")
	if residents then
		table.insert(list, residents)
	end
	return list
end

-- Line of sight between two points, through bodies and devices.
local function clear(from: Vector3, to: Vector3): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = bodiesOf()
	return workspace:Raycast(from, to - from, params) == nil
end

-- The ground under a point (within 40 studs), or the point itself.
local function ground(at: Vector3, ignore: { Instance }?): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or bodiesOf()
	local hit = workspace:Raycast(at + Vector3.new(0, 3, 0), Vector3.new(0, -43, 0), params)
	return if hit then hit.Position else at
end

-- Where the camera's ray lands within `range` of the player (origin must be near them: the camera).
local function aim(player: Player, origin: Vector3, look: Vector3, range: number, hitPlayers: boolean?): RaycastResult?
	local root = rootOf(player)
	if not root or (origin - root.Position).Magnitude > 30 or look.Magnitude < 0.5 then
		return nil
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { player.Character :: Instance }
	if not hitPlayers then
		for _, p in Players:GetPlayers() do
			if p.Character then
				table.insert(ignore, p.Character)
			end
		end
	end
	local devices = workspace:FindFirstChild("ClassDevices")
	if devices then
		table.insert(ignore, devices)
	end
	params.FilterDescendantsInstances = ignore
	local reach = range + (origin - root.Position).Magnitude
	local hit = workspace:Raycast(origin, look.Unit * reach, params)
	if hit and (hit.Position - root.Position).Magnitude <= range + 2 then
		return hit
	end
	return nil
end

local function unitAt(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return ctx.Grid:Bunker():UnitAt(floor, column)
end

local function roomAt(position: Vector3): any
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return ctx.Grid:RoomAt(floor, column)
end

local function roomCentre(room: any): Vector3
	local column = room.Column + (room.Span - 1) / 2
	return Grid.CellPosition(room.Floor, math.floor(column)) + Vector3.new(if room.Span % 2 == 0 then Grid.Pitch().X / 2 else 0, 3, 0)
end

local function playerCombatId(player: Player): string
	local c = ctx.Combat:PlayerCombatant(player)
	return if c then c.Id else `P{player.UserId}`
end

local function stun(model: Model, seconds: number)
	local current = model:GetAttribute("StunnedUntil")
	local untilAt = now() + seconds
	if type(current) ~= "number" or current < untilAt then
		model:SetAttribute("StunnedUntil", untilAt)
	end
end

local function makePart(name: string, size: Vector3, colour: Color3, material: Enum.Material?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = colour
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	return part
end

-- A model from the art pipeline when it exists, else `graybox()`; anchored, no collisions.
local function device(category: string, asset: string, graybox: () -> Model): Model
	local source = art(category, asset)
	local model = if source then source:Clone() else graybox()
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	return model
end

local function socketOf(model: Model, name: string): Vector3?
	-- the art's sockets are Socket_<Name> attributes, relative to the model's pivot (AssetSetup)
	local socket = model:GetAttribute(`Socket_{name}`)
	if typeof(socket) == "CFrame" then
		return (model:GetPivot() * socket).Position
	end
	local found = model:FindFirstChild(name, true)
	if found and found:IsA("Attachment") then
		return found.WorldPosition
	elseif found and found:IsA("BasePart") then
		return found.Position
	end
	return nil
end

-- The nearest living monster within `range` of `from` that `from` can see.
local function nearestMonster(from: Vector3, range: number): any
	local best, bestDistance = nil, range
	for _, c in ctx.Combat:All("Monsters") do
		if c.State == "Alive" then
			local d = (c.Root.Position - from).Magnitude - c.Reach
			if d <= bestDistance and clear(from, c.Root.Position) then
				best, bestDistance = c, d
			end
		end
	end
	return best
end

-- Burning ------------------------------------------------------------------------------------------

-- A monster catches fire (flame guns, napalm): Burn.Seconds of Burn.DamagePerSecond; the owner's
-- BurnSpreadsBetweenMonsters lets it spread. fireId: the fire a spread carries on (none: a new fire).
function Abilities.Burn(targetId: string, owner: Player?, fireId: number?)
	local c = ctx.Combat:Get(targetId)
	if not c or c.State ~= "Alive" or c.Team ~= "Monsters" then
		return
	end
	local b = burning[targetId]
	local seconds = t().Burn.Seconds
	if b then
		b.Until = math.max(b.Until, os.clock() + seconds)
		if owner then
			b.Owner = owner
			b.Spreads = b.Spreads or Modifiers.PlayerValue(owner, "BurnSpreadsBetweenMonsters") ~= nil
		end
		return
	end
	if not fireId then
		fireCount += 1
		fireId = fireCount
	end
	lastFire[targetId] = fireId
	local fire = Instance.new("Fire")
	fire.Size = math.clamp(c.Reach * 1.5, 3, 12)
	fire.Heat = 6
	fire.Parent = c.Root
	burning[targetId] = {
		Owner = owner,
		Until = os.clock() + seconds,
		Spreads = owner ~= nil and Modifiers.PlayerValue(owner, "BurnSpreadsBetweenMonsters") ~= nil,
		Fire = fire,
		FireId = fireId :: number,
	}
end

local function tickBurning(dt: number)
	local b_ = t().Burn
	local spreadTo: { { Id: string, Owner: Player?, FireId: number } } = {}
	for id in lastFire do
		if not burning[id] and not ctx.Combat:Get(id) then
			lastFire[id] = nil
		end
	end
	for id, b in burning do
		local c = ctx.Combat:Get(id)
		if not c or c.State ~= "Alive" or os.clock() >= b.Until then
			if b.Fire then
				b.Fire:Destroy()
			end
			burning[id] = nil
		else
			local source = if b.Owner then playerCombatId(b.Owner) else nil
			ctx.Combat:Damage(id, b_.DamagePerSecond * dt, source, "burning")
			if b.Spreads then
				for _, other in ctx.Combat:All("Monsters") do
					if not burning[other.Id] and lastFire[other.Id] ~= b.FireId and other.State == "Alive"
						and (other.Root.Position - c.Root.Position).Magnitude - other.Reach <= b_.SpreadRadius then
						table.insert(spreadTo, { Id = other.Id, Owner = b.Owner, FireId = b.FireId })
					end
				end
			end
		end
	end
	for _, s in spreadTo do
		Abilities.Burn(s.Id, s.Owner, s.FireId)
	end
end

-- Survivor ------------------------------------------------------------------------------------------

local function secondWind(state: State): (boolean, string?, string?, number?)
	local c = ctx.Combat:PlayerCombatant(state.Player)
	if not c then
		return false, "YOU NEED TO BE STANDING"
	end
	local health, max = ctx.Combat:HealthOf(c.Id)
	if health >= max - 0.5 then
		return false, "YOU'RE AT FULL HEALTH"
	end
	local healed = ctx.Combat:Heal(c.Id, max * t().SecondWindFraction)
	fx(state.Player, "Heal", c.Root.Position, { Radius = 4 })
	return true, `SECOND WIND: +{math.floor(healed + 0.5)} HEALTH`
end

-- Engineer -----------------------------------------------------------------------------------------

local function turretGraybox(): Model
	local model = Instance.new("Model")
	model.Name = "Turret"
	local base = makePart("Base", Vector3.new(2.6, 0.6, 2.6), Color3.fromRGB(70, 78, 72), Enum.Material.Metal)
	base.CFrame = CFrame.new(0, 0.3, 0)
	base.Parent = model
	local post = makePart("Post", Vector3.new(0.6, 1.8, 0.6), Color3.fromRGB(96, 104, 98), Enum.Material.Metal)
	post.CFrame = CFrame.new(0, 1.5, 0)
	post.Parent = model
	local head = makePart("Head", Vector3.new(1.4, 1, 2.2), Color3.fromRGB(196, 150, 54), Enum.Material.Metal)
	head.CFrame = CFrame.new(0, 2.7, 0)
	head.Parent = model
	local barrel = makePart("Barrel", Vector3.new(0.35, 0.35, 1.6), Color3.fromRGB(40, 40, 40), Enum.Material.Metal)
	barrel.CFrame = CFrame.new(0, 2.7, -1.7)
	barrel.Parent = model
	local muzzle = Instance.new("Attachment")
	muzzle.Name = "Muzzle"
	muzzle.Position = Vector3.new(0, 0, -0.8)
	muzzle.Parent = barrel
	model.PrimaryPart = base
	return model
end

local function removeTurret(player: Player)
	local turret = turrets[player]
	turrets[player] = nil
	if turret and turret.Model.Parent then
		turret.Model:Destroy()
	end
end

local function deployTurret(state: State, _origin: Vector3, _look: Vector3): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	removeTurret(player)
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	local at = ground(root.Position + flat.Unit * t().Turret.PlaceDistance)
	local model = device("Props", "Prop_Turret", turretGraybox)
	model.Name = `Turret_{player.UserId}`
	model:SetAttribute("Owner", player.UserId)
	model:PivotTo(CFrame.lookAt(at, at + flat))
	model.Parent = holder("ClassDevices")
	local seconds = Classes.Duration(state.Class, state.Level)
	turrets[player] = {
		Owner = player,
		Model = model,
		Until = os.clock() + seconds,
		NextShot = 0,
		Shock = Modifiers.PlayerValue(player, "TurretShock") ~= nil,
		Shots = 0,
	}
	fx(player, "Deploy", at, {})
	return true, `TURRET DEPLOYED FOR {math.floor(seconds)} S`
end

local function tickTurrets()
	local tt = t().Turret
	for player, turret in turrets do
		if os.clock() >= turret.Until or player.Parent ~= Players or not turret.Model.Parent then
			removeTurret(player)
		elseif os.clock() >= turret.NextShot then
			local muzzle = socketOf(turret.Model, "Muzzle") or (turret.Model:GetPivot().Position + Vector3.new(0, 2.7, 0))
			local target = nearestMonster(muzzle, tt.Range)
			if target then
				turret.NextShot = os.clock() + tt.FireSeconds
				local pivot = turret.Model:GetPivot()
				local flat = Vector3.new(target.Root.Position.X, pivot.Position.Y, target.Root.Position.Z)
				if (flat - pivot.Position).Magnitude > 0.5 then
					turret.Model:PivotTo(CFrame.lookAt(pivot.Position, flat))
				end
				ctx.Combat:Damage(target.Id, tt.Damage, playerCombatId(player), "turret")
				turret.Shots += 1
				local shocks = turret.Shock and turret.Shots % math.max(tt.ShockEvery, 1) == 0
				if shocks and target.Model.Parent then
					stun(target.Model, tt.ShockSeconds)
				end
				Remotes.FireAllClients("AbilityFx", player.UserId, "Engineer", if shocks then "ShockTracer" else "Tracer",
					muzzle, { To = target.Root.Position })
			else
				turret.NextShot = os.clock() + 0.2
			end
		end
	end
end

local function barricadeGraybox(): Model
	local model = Instance.new("Model")
	model.Name = "Barricade"
	for i = 0, 2 do
		local plank = makePart(`Plank{i + 1}`, Vector3.new(5.2, 0.7, 0.25), Color3.fromRGB(122, 92, 60), Enum.Material.WoodPlanks)
		plank.CFrame = CFrame.new(0, (i - 1) * 0.9, 0) * CFrame.Angles(0, 0, math.rad((i - 1) * 6))
		plank.Parent = model
	end
	model.PrimaryPart = model:FindFirstChild("Plank2") :: BasePart
	return model
end

local function barricadeCost(player: Player?): { [string]: number }
	local recipe = Config.Get("Recipes", "Barricade")
	local m = if player then Modifiers.PlayerValue(player, "BarricadeCost") or 1 else 1
	local costs = {}
	for id, amount in recipe.Costs do
		costs[id] = math.max(1, math.ceil(amount * m - 1e-6))
	end
	return costs
end

local function costText(costs: { [string]: number }): string
	local parts = {}
	for _, id in Config.Ids("Resources") do
		if costs[id] then
			table.insert(parts, `{costs[id]} {Config.Get("Resources", id).Name}`)
		end
	end
	return table.concat(parts, ", ")
end

local function placeBarricade(roomId: string, at: Vector3)
	local model = ctx.Grid:RoomModel(roomId)
	if not model then
		return
	end
	local old = model:FindFirstChild("Barricade")
	if old then
		old:Destroy()
	end
	local barricade = device("Props", "Prop_Barricade", barricadeGraybox)
	barricade.Name = "Barricade"
	barricade:PivotTo(CFrame.new(at + Vector3.new(0, 0, 0.6)) * CFrame.Angles(0, math.pi, 0)) -- art faces -Z: turn it to the room
	barricade.Parent = model
	model:SetAttribute("Barricaded", true)
end

-- Barricade prompts at every vent that has none yet (Engineers only), and barricades put back on
-- rooms whose models were rebuilt.
function Abilities.SyncBarricades()
	local seen: { [string]: boolean } = {}
	local folder = holder("ClassDevices")
	for _, point in ctx.Breaches:Points() do
		if point.Kind == "Vent" and point.RoomId then
			local roomId = point.RoomId :: string
			seen[roomId] = true
			local model = ctx.Grid:RoomModel(roomId)
			if barricaded[roomId] then
				if model and not model:GetAttribute("Barricaded") then
					placeBarricade(roomId, point.Source)
				end
				local spot = barricadeSpots[roomId]
				if spot then
					spot:Destroy()
					barricadeSpots[roomId] = nil
				end
			elseif not barricadeSpots[roomId] then
				local recipe = Config.Get("Recipes", "Barricade")
				local spot = makePart(`BarricadeSpot_{roomId}`, Vector3.new(1, 1, 1), Color3.new(1, 1, 1))
				spot.Transparency = 1
				spot.Position = point.Source + Vector3.new(0, -3, 2)
				local prompt = Instance.new("ProximityPrompt")
				prompt.Name = "BarricadePrompt"
				prompt.ActionText = "Barricade"
				prompt.ObjectText = `Vent · {costText(barricadeCost(nil))}`
				prompt.HoldDuration = recipe.Seconds
				prompt.MaxActivationDistance = 10
				prompt.RequiresLineOfSight = false
				prompt.KeyboardKeyCode = Enum.KeyCode.E
				prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
				prompt.Style = Enum.ProximityPromptStyle.Custom
				prompt:SetAttribute("Kind", "Barricade")
				prompt:SetAttribute("ForClass", "Engineer")
				prompt.Triggered:Connect(function(player: Player)
					local state = ctx.State(player)
					if not state or state.Class ~= "Engineer" or not standing(player) or barricaded[roomId] then
						return
					end
					local costs = barricadeCost(player)
					local paid, why = ctx.Economy:Spend(costs, "Barricade")
					if not paid then
						Remotes.FireClient("Alert", player, "Warning", `CAN'T BARRICADE: {string.upper(why or "not enough in the stockpile")}`)
						return
					end
					barricaded[roomId] = true
					local vent = point.Source
					for _, p in ctx.Breaches:Points() do
						if p.RoomId == roomId and p.Kind == "Vent" then
							vent = p.Source
						end
					end
					placeBarricade(roomId, vent)
					spot:Destroy()
					barricadeSpots[roomId] = nil
					local room = ctx.Grid:Room(roomId)
					local name = if room then string.upper(Config.Get("Rooms", room.Type).Name) else "THE ROOM"
					for _, p in ctx.Session:ReadyPlayers() do
						Remotes.FireClient("Alert", p, "Info", `{string.upper(player.DisplayName)} BARRICADED THE {name} VENT ({costText(costs)})`)
					end
					log:Info("%s barricaded %s's vent", player.Name, roomId)
				end)
				prompt.Parent = spot
				spot.Parent = folder
				barricadeSpots[roomId] = spot
			end
		end
	end
	for roomId, spot in barricadeSpots do
		if not seen[roomId] then
			spot:Destroy()
			barricadeSpots[roomId] = nil
		end
	end
	for roomId in barricaded do
		if not ctx.Grid:Room(roomId) then
			barricaded[roomId] = nil
		end
	end
end

function Abilities.Barricaded(): { [string]: boolean }
	return table.clone(barricaded)
end

-- Medic ------------------------------------------------------------------------------------------------

local function triagePulse(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local tt = t()
	local clears = Modifiers.PlayerValue(player, "TriagePulseClears") ~= nil
	local healed, cleared = 0, 0
	for _, c in ctx.Combat:All("Survivors") do
		if c.State == "Alive" and (c.Root.Position - root.Position).Magnitude <= tt.TriageRadius then
			if c.Kind == "Player" or c.Kind == "Survivor" then
				if ctx.Combat:Heal(c.Id, tt.TriageHeal) > 0 then
					healed += 1
				end
				if clears and c.Player then
					local p = c.Player :: Player
					if (ctx.Surface:Radiation(p) or 0) > 0 then
						ctx.Surface:AddRadiation(p, -1e6, "Triage Pulse")
						cleared += 1
					end
					if p:GetAttribute("SlowedUntil") then
						p:SetAttribute("SlowedUntil", nil)
						cleared += 1
					end
				end
			elseif c.Kind == "Resident" and c.ResidentId then
				if ctx.Residents:Heal(c.ResidentId, tt.TriageHeal) > 0 then
					healed += 1
				end
				-- "Pulse also clears conditions" (Prompt 24: the sick and the irradiated)
				if clears then
					if ctx.Disasters:Cure(c.ResidentId, "Triage Pulse", player) then
						cleared += 1
					end
					if ctx.Residents:SetCondition(c.ResidentId, "Irradiated", false, "Triage Pulse") then
						cleared += 1
					end
				end
			end
		end
	end
	if healed == 0 and cleared == 0 then
		return false, "NOBODY NEARBY NEEDS HEALING"
	end
	fx(player, "Pulse", root.Position, { Radius = tt.TriageRadius })
	return true, `TRIAGE PULSE: {healed} HEALED{if cleared > 0 then ` · {cleared} CLEARED` else ""}`
end

local function tickTouchHeal(dt: number)
	local tt = t()
	for _, player in ctx.Session:ReadyPlayers() do
		if Modifiers.PlayerValue(player, "TouchHeal") and standing(player) then
			local root = rootOf(player) :: BasePart
			for _, c in ctx.Combat:All("Survivors") do
				if c.Kind == "Resident" and c.ResidentId and c.State == "Alive"
					and (c.Root.Position - root.Position).Magnitude <= tt.TouchHealRange then
					ctx.Residents:Heal(c.ResidentId, tt.TouchHealPerSecond * dt)
				end
			end
		end
	end
end

-- Firefighter ------------------------------------------------------------------------------------------

local function foamBurst(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	-- "Ends a room's fire or flood at once": the room you stand in, else the nearest within FoamRange
	local room = roomAt(root.Position)
	local target = if room and (Hazards.Fire(room.Id) or Hazards.Flood(room.Id)) then room else nil
	if not target then
		local best = t().FoamRange
		for _, entry in ctx.Disasters:Active() do
			if (entry.Kind == "Fire" or entry.Kind == "Flood") and entry.Room then
				local r = ctx.Grid:Room(entry.Room)
				local d = if r then (roomCentre(r) - root.Position).Magnitude else math.huge
				if r and d <= best then
					target, best = r, d
				end
			end
		end
	end
	if not target then
		return false, "NO FIRE OR FLOOD NEARBY"
	end
	local fire = ctx.Disasters:Extinguish(target.Id, 1e6, "Foam Burst", player)
	local flood = ctx.Disasters:Drain(target.Id, "Foam Burst", player)
	fx(player, "Foam", roomCentre(target), { Radius = 14 })
	local name = string.upper(Config.Get("Rooms", target.Type).Name)
	return true, if fire and flood then `FOAM BURST: THE {name} IS OUT AND DRY`
		elseif flood then `FOAM BURST: THE {name} IS DRY` else `FOAM BURST: THE {name} FIRE IS OUT`
end

-- Cook ----------------------------------------------------------------------------------------------------

local meal: { Until: number, Source: string }? = nil

-- The team's max health multiplier from a Hearty Meal in effect (ClassService's max health).
function Abilities.MealMultiplier(): number
	local m = meal
	if not m or os.clock() >= m.Until then
		return 1
	end
	local cook = Config.Get("Classes", "Cook").Ability
	return Modifiers.Fold(cook.Modifiers, "MaxHealthMult") or 1
end

local function endMeal()
	meal = nil
	ctx.Weapons:SetModifier("HeartyMeal", "StaminaMult", nil)
	for _, p in Players:GetPlayers() do
		ctx.Combat:RefreshMaxHealth(p)
		p:SetAttribute("MealUntil", nil)
	end
end

local function heartyMeal(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local ability = Config.Get("Classes", "Cook").Ability
	local seconds = Config.Get("Tuning", "Clock").CycleSeconds / math.max(ctx.Clock:TimeScale(), 0.01)
	meal = { Until = os.clock() + seconds, Source = player.Name }
	ctx.Weapons:SetModifier("HeartyMeal", "StaminaMult", Modifiers.Fold(ability.Modifiers, "StaminaMult"))
	local morale = Modifiers.Fold(ability.Modifiers, "MoraleNow") or 0
	if morale > 0 then
		ctx.Residents:AddMorale(morale, "Hearty Meal")
	end
	local heals = Modifiers.PlayerValue(player, "MealsHeal") ~= nil
	local fraction = t().MealHealFraction
	for _, p in ctx.Session:ReadyPlayers() do
		ctx.Combat:RefreshMaxHealth(p)
		p:SetAttribute("MealUntil", now() + seconds)
		local c = ctx.Combat:PlayerCombatant(p)
		if heals and c then
			local _, max = ctx.Combat:HealthOf(c.Id)
			ctx.Combat:Heal(c.Id, max * fraction)
		end
	end
	if heals then
		for _, resident in ctx.Residents:All() do
			if resident.State == "Alive" then
				ctx.Residents:Heal(resident.Id, resident.MaxHealth * fraction)
			end
		end
	end
	local root = rootOf(player)
	fx(player, "Meal", if root then root.Position else nil, {})
	for _, p in ctx.Session:ReadyPlayers() do
		Remotes.FireClient("Alert", p, "Info", `HEARTY MEAL: +20% HEALTH AND STAMINA FOR A CYCLE{if heals then " · ALL HEALED" else ""}`)
	end
	log:Info("%s served a Hearty Meal%s", player.Name, if heals then " (heals)" else "")
	task.delay(seconds, function()
		local m = meal
		if m and os.clock() >= m.Until - 0.05 then
			endMeal()
		end
	end)
	return true, nil
end

-- The Cook's Kitchen bonus (Presence) follows them into whichever Kitchen they stand in.
local presence: { [Player]: string } = {} -- player -> the room id holding their bonus
local function tickPresence()
	for player, roomId in table.clone(presence) do
		if player.Parent ~= Players then
			ctx.Economy:SetModifier(`presence:{player.UserId}`, "RoomOutput", nil, roomId)
			presence[player] = nil
		end
	end
	for _, player in ctx.Session:ReadyPlayers() do
		local list = {}
		local class = player:GetAttribute("Class")
		local level = player:GetAttribute("ClassLevel")
		for _, modifier in Modifiers.ClassModifiers(if type(class) == "string" then class else nil, if type(level) == "number" then level else nil) do
			if modifier.Scope == "Presence" and modifier.Key == "RoomOutput" then
				table.insert(list, modifier)
			end
		end
		local root = rootOf(player)
		local room = if root and standing(player) then roomAt(root.Position) else nil
		local wanted: string? = nil
		local value: number? = nil
		for _, modifier in list do
			if room and modifier.Room == room.Type then
				wanted, value = room.Id, modifier.Value
			end
		end
		local had = presence[player]
		if had ~= wanted then
			if had then
				ctx.Economy:SetModifier(`presence:{player.UserId}`, "RoomOutput", nil, had)
			end
			if wanted and value then
				ctx.Economy:SetModifier(`presence:{player.UserId}`, "RoomOutput", value, wanted)
			end
			presence[player] = wanted
		end
	end
end

-- Security -----------------------------------------------------------------------------------------------

local function holdTheLine(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local seconds = Classes.Duration(state.Class, state.Level)
	local drawn = ctx.Monsters:Taunt(playerCombatId(player), root.Position, t().TauntRadius, seconds)
	local character = player.Character
	if character then
		local glow = Instance.new("Highlight")
		glow.Name = "HoldTheLine"
		glow.FillColor = Color3.fromRGB(80, 160, 230)
		glow.FillTransparency = 0.75
		glow.OutlineColor = Color3.fromRGB(150, 210, 255)
		glow.DepthMode = Enum.HighlightDepthMode.Occluded
		glow.Parent = character
		Debris:AddItem(glow, seconds)
	end
	fx(player, "Shield", root.Position, { Radius = t().TauntRadius })
	return true, if drawn > 0 then `HOLD THE LINE: {drawn} MONSTER{if drawn == 1 then "" else "S"} DRAWN TO YOU` else "HOLD THE LINE",
		"Hold", seconds
end

-- Scout ----------------------------------------------------------------------------------------------------

local LOOT_FINDS: { [string]: boolean } = { Cache = true, OreVein = true, GlowshardChest = true, RadioLog = true }

local function outline(model: Model, colour: Color3, seconds: number)
	local old = model:FindFirstChild("FlarePing")
	if old then
		old:Destroy()
	end
	local glow = Instance.new("Highlight")
	glow.Name = "FlarePing"
	glow.FillColor = colour
	glow.FillTransparency = 0.8
	glow.OutlineColor = colour
	glow.OutlineTransparency = 0
	glow.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	glow.Adornee = model
	glow.Parent = model
	Debris:AddItem(glow, seconds)
end

local function flarePing(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local radius = t().FlareRadius
	local seconds = Classes.Duration(state.Class, state.Level)
	local enemies, loot, survivors = 0, 0, 0
	-- Prompt 24: the ping lights what a flare lights (Prism Stalkers, the Crystal Colossus's cores)
	do
		local light = Instance.new("Part")
		light.Name = "FlarePing"
		light.Anchored = true
		light.CanCollide = false
		light.CanQuery = false
		light.CanTouch = false
		light.Transparency = 1
		light.Size = Vector3.new(0.2, 0.2, 0.2)
		light.Position = root.Position
		light:SetAttribute("Radius", radius)
		game:GetService("CollectionService"):AddTag(light, "RevealLight")
		light.Parent = workspace
		game:GetService("Debris"):AddItem(light, seconds)
	end
	for _, c in ctx.Combat:All("Monsters") do
		if c.State == "Alive" and (c.Root.Position - root.Position).Magnitude <= radius then
			outline(c.Model, Color3.fromRGB(232, 70, 50), seconds)
			enemies += 1
		end
	end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { workspace:FindFirstChild("Monsters") or workspace.Terrain }
	params.MaxParts = 4000
	local seen: { [Model]: boolean } = {}
	for _, part in workspace:GetPartBoundsInRadius(root.Position, radius, params) do
		local model = part:FindFirstAncestorOfClass("Model")
		while model and not seen[model] do
			local isLoot = (model:GetAttribute("Container") ~= nil and not model:GetAttribute("Looted") and not model:GetAttribute("Locked"))
				or LOOT_FINDS[model:GetAttribute("Find") or ""] or model:GetAttribute("Feature") == "Cache"
				or model:GetAttribute("BigFind") ~= nil or model:GetAttribute("Bag") ~= nil
			local isSurvivor = model:GetAttribute("RescueId") ~= nil
			if isLoot or isSurvivor then
				seen[model] = true
				if isSurvivor then
					outline(model, Color3.fromRGB(110, 210, 120), seconds)
					survivors += 1
				else
					outline(model, Color3.fromRGB(240, 180, 60), seconds)
					loot += 1
				end
				break
			end
			model = model:FindFirstAncestorOfClass("Model")
		end
	end
	fx(player, "Flare", root.Position, { Radius = radius })
	if enemies + loot + survivors == 0 then
		return true, `FLARE PING: NOTHING WITHIN {radius} STUDS`
	end
	return true, `FLARE PING: {enemies} ENEMIES · {loot} LOOT · {survivors} SURVIVOR{if survivors == 1 then "" else "S"}`
end

-- Quartermaster -------------------------------------------------------------------------------------------

local function requisition(state: State, option: number): (boolean, string?, string?, number?)
	local tt = t()
	local name = Classes.OptionName(state.Class, option) or "Scrap"
	local given: { string } = {}
	if name == "Scrap" then
		local added = ctx.Economy:Add("Scrap", tt.RequisitionScrap, "Emergency Requisition")
		if added > 0 then
			table.insert(given, `+{added} SCRAP`)
		end
	else
		for _, id in { "Food", "Water" } do
			local added = ctx.Economy:Add(id, tt.RequisitionFoodWater, "Emergency Requisition")
			if added > 0 then
				table.insert(given, `+{added} {string.upper(id)}`)
			end
		end
	end
	if #given == 0 then
		return false, "THE STOCKPILE IS FULL"
	end
	local text = `{string.upper(state.Player.DisplayName)}'S EMERGENCY REQUISITION: {table.concat(given, ", ")}`
	for _, p in ctx.Session:ReadyPlayers() do
		Remotes.FireClient("Alert", p, "Info", text)
	end
	return true, nil
end

-- Radio Operator -------------------------------------------------------------------------------------------

local function crateGraybox(): Model
	local model = Instance.new("Model")
	model.Name = "SupplyCrate"
	local box = makePart("Box", Vector3.new(3, 2, 2), Color3.fromRGB(86, 104, 70), Enum.Material.WoodPlanks)
	box.CFrame = CFrame.new(0, 1, 0)
	box.Parent = model
	model.PrimaryPart = box
	return model
end

local function supplyCall(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local tt = t()
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	local at = ground(root.Position + flat.Unit * tt.CrateDistance)
	local model = device("Props", "Prop_SupplyCrate", crateGraybox)
	crates += 1
	model.Name = `SupplyCall_{crates}`
	model:PivotTo(CFrame.lookAt(at, at - flat))
	local _, size = model:GetBoundingBox()
	local spot = makePart("PromptSpot", Vector3.new(1, 1, 1), Color3.new(1, 1, 1))
	spot.Transparency = 1
	spot.Position = at + Vector3.new(0, size.Y + 0.5, 0)
	spot.Parent = model
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "OpenPrompt"
	prompt.ActionText = "Open"
	prompt.ObjectText = "Supply crate"
	prompt.HoldDuration = 1
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Kind", "OpenCrate")
	local left: { Loot.Drop } = Loot.Roll(tt.CrateLoot, rng, {})
	local opened = false
	prompt.Triggered:Connect(function(opener: Player)
		if opened or not standing(opener) then
			return
		end
		local inBunker = Surface.Zone(at) == "Bunker"
		local given: { Loot.Drop } = {}
		local rest: { Loot.Drop } = {}
		if inBunker then
			for _, drop in left do
				if drop.Resource then
					local added = ctx.Economy:Add(drop.Resource, drop.Count, "Supply Call")
					if added > 0 then
						table.insert(given, { Resource = drop.Resource, Count = added })
					end
				end
			end
		else
			given, rest = ctx.Inventory:Give(opener, left)
		end
		if #rest > 0 then
			left = rest
			prompt.ActionText = "Take the rest"
			Remotes.FireClient("Alert", opener, "Warning", `PACK FULL: {Loot.Text(rest)} LEFT IN THE CRATE`)
		else
			opened = true
			model:Destroy()
		end
		if #given > 0 then
			for _, p in ctx.Session:ReadyPlayers() do
				Remotes.FireClient("Alert", p, "Info", `{string.upper(opener.DisplayName)} OPENED THE SUPPLY CRATE: {Loot.Text(given)}`)
			end
		end
	end)
	prompt.Parent = spot
	model.Parent = holder("ClassDevices")
	fx(player, "Crate", at, {})
	return true, "SUPPLY CALL: A CRATE LANDED IN FRONT OF YOU"
end

-- Hazmat Tech ---------------------------------------------------------------------------------------------

local function deconField(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local unit = unitAt(root.Position)
	local radius = t().DeconRadius
	local cleared = 0
	for _, p in ctx.Session:ReadyPlayers() do
		local other = rootOf(p)
		if other and standing(p) then
			local inside = if unit then unitAt(other.Position) == unit else (other.Position - root.Position).Magnitude <= radius
			if inside and (ctx.Surface:Radiation(p) or 0) > 0 then
				ctx.Surface:AddRadiation(p, -1e6, "Decon Field")
				cleared += 1
			end
		end
	end
	-- "Clears radiation and gas from a room and everyone in it"
	local gas = unit ~= nil and ctx.Disasters:ClearGas(unit, "Decon Field", player)
	-- a radiation leak's radiation and the room's irradiated residents (Prompt 24)
	local leak = unit ~= nil and ctx.Disasters:ClearRadiation(unit, "Decon Field", player)
	if cleared == 0 and not gas and not leak then
		return false, "NOTHING HERE NEEDS DECONTAMINATING"
	end
	fx(player, "Decon", root.Position, { Radius = if unit then 14 else radius })
	if cleared == 0 then
		return true, `DECON FIELD: {if gas and leak then "THE GAS AND THE RADIATION ARE" elseif gas then "THE GAS IS" else "THE RADIATION IS"} GONE`
	end
	return true, `DECON FIELD: RADIATION CLEARED FROM {cleared} PLAYER{if cleared == 1 then "" else "S"}{if gas then ", THE GAS IS GONE" else ""}{if leak then ", THE ROOM IS CLEAN" else ""}`
end

-- Exterminator ---------------------------------------------------------------------------------------------

local function napalmLine(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local n = t().Napalm
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit
	local start = ground(root.Position)
	local centre = start + flat * (n.Length / 2 + 1.5)
	local cframe = CFrame.lookAt(centre, centre + flat)
	local seconds = Classes.Duration(state.Class, state.Level)
	local part = makePart("NapalmLine", Vector3.new(n.Width, 0.3, n.Length), Color3.fromRGB(255, 120, 40), Enum.Material.Neon)
	part.Transparency = 0.35
	part.CFrame = cframe + Vector3.new(0, 0.15, 0)
	for i = 1, 3 do
		local a = Instance.new("Attachment")
		a.Position = Vector3.new(0, 0.2, (i - 2) * n.Length / 3)
		a.Parent = part
		local flame = Instance.new("Fire")
		flame.Size = 6
		flame.Heat = 9
		flame.Parent = a
	end
	part.Parent = holder("ClassDevices")
	Debris:AddItem(part, seconds)
	table.insert(strips, { Owner = player, Part = part, CFrame = cframe, Size = part.Size, Until = os.clock() + seconds })
	return true, "NAPALM LINE"
end

local function tickStrips(dt: number)
	local n = t().Napalm
	for i = #strips, 1, -1 do
		local strip = strips[i]
		if os.clock() >= strip.Until or not strip.Part.Parent then
			table.remove(strips, i)
		else
			for _, c in ctx.Combat:All("Monsters") do
				if c.State == "Alive" then
					local localPoint = strip.CFrame:PointToObjectSpace(c.Root.Position)
					if math.abs(localPoint.X) <= strip.Size.X / 2 + c.Reach * 0.5 and math.abs(localPoint.Z) <= strip.Size.Z / 2 + c.Reach * 0.5
						and math.abs(localPoint.Y) <= 8 then
						ctx.Combat:Damage(c.Id, n.DamagePerSecond * dt, playerCombatId(strip.Owner), "burned")
						Abilities.Burn(c.Id, strip.Owner)
					end
				end
			end
		end
	end
end

-- Marksman ----------------------------------------------------------------------------------------------------

local function steadyShot(state: State): (boolean, string?, string?, number?)
	state.Shots = t().SteadyShots
	state.Player:SetAttribute("SteadyShots", state.Shots)
	return true, `STEADY SHOT: THE NEXT {state.Shots} SHOTS PIERCE AND CRIT`
end

-- WeaponService's shot hook: a Steady Shot pierces and crits.
function Abilities.ShotHook(player: Player, _itemId: string): any
	local state = ctx.State(player)
	if not state or state.Shots <= 0 then
		return nil
	end
	state.Shots -= 1
	player:SetAttribute("SteadyShots", if state.Shots > 0 then state.Shots else nil)
	return { Pierce = true, Crit = t().CritMultiplier }
end

-- Driller --------------------------------------------------------------------------------------------------------

local function overdrive(state: State, _origin: Vector3, look: Vector3): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	if not Dig.CanDigWith(ctx.Weapons:Items(player)) then
		return false, "YOU NEED A DRILL OR A PICKAXE"
	end
	local floor, column = Grid.CellAt(root.Position)
	if not floor or not column then
		return false, "OVERDRIVE WORKS IN THE BUNKER'S ROCK"
	end
	local df, dc = 0, 0
	if look.Y < -0.55 then
		df = 1
	elseif look.X >= 0 then
		dc = 1
	else
		dc = -1
	end
	local limit = RunState.Get("DigLimit")
	local dug = 0
	local why: string? = nil
	for i = 1, t().OverdriveCells do
		local f, c = floor + df * i, column + dc * i
		local cellState = if Grid.OnGrid(f, c) then ctx.Grid:State(f, c) else nil
		if cellState ~= "Rock" then
			why = if dug == 0 then "NO ROCK TO DIG THAT WAY" else nil
			break
		end
		if type(limit) == "number" and f > limit then
			why = if dug == 0 then "PAST THE DIG LIMIT: PUSH DEEPER FIRST" else "THE REST IS PAST THE DIG LIMIT"
			break
		end
		local ok, reason = ctx.Dig:DigNow(f, c, "Overdrive", player)
		if not ok then
			why = if dug == 0 then string.upper(reason or "IT WON'T DIG") else nil
			break
		end
		dug += 1
	end
	if dug == 0 then
		return false, why or "NO ROCK TO DIG THAT WAY"
	end
	fx(player, "Overdrive", root.Position, {})
	return true, `OVERDRIVE: {dug} CELL{if dug == 1 then "" else "S"} DUG{if why then ` · {why}` else ""}`
end

-- Scavenger --------------------------------------------------------------------------------------------------------

local function magnetSweep(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local radius = t().MagnetRadius
	local reached = ctx.Surface:SearchNear(player, root.Position, radius)
		+ ctx.Deep:OpenNear(player, root.Position, radius)
		+ ctx.Inventory:CollectBags(player, root.Position, radius)
	if reached == 0 then
		return false, `NO LOOT WITHIN {radius} STUDS`
	end
	fx(player, "Magnet", root.Position, { Radius = radius })
	return true, nil
end

-- Warden ----------------------------------------------------------------------------------------------------------------

local function rallyCall(state: State): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root or not unitAt(root.Position) then
		return false, "RALLY CALL WORKS IN THE BUNKER"
	end
	local myFloor = Grid.CellAt(root.Position)
	local tt = t()
	local ids = {}
	for _, resident in ctx.Residents:All() do
		local body = ctx.Brain:Body(resident.Id)
		if resident.State == "Alive" and Residents.Armed(resident) and body then
			local floor = Grid.CellAt(body:GetPivot().Position)
			if floor and myFloor and math.abs(floor - myFloor) <= tt.RallyFloors then
				table.insert(ids, resident.Id)
			end
		end
	end
	if #ids == 0 then
		return false, `NO ARMED RESIDENTS WITHIN {tt.RallyFloors} FLOORS`
	end
	local seconds = Classes.Duration(state.Class, state.Level)
	local instant = Modifiers.PlayerValue(player, "InstantRally") ~= nil
	local answered = ctx.Brain:Rally(ids, player, seconds, tt.RallyDamage, instant)
	fx(player, "Rally", root.Position, { Radius = 12 })
	return true, `RALLY CALL: {answered} ARMED RESIDENT{if answered == 1 then "" else "S"} ON THEIR WAY`, "Rally", seconds
end

-- Demolitionist ----------------------------------------------------------------------------------------------------------

local function breachingCharge(state: State, origin: Vector3, look: Vector3): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local b = t().Breaching
	local hit = aim(player, origin, look, b.Range)
	local at = if hit then hit.Position else root.Position + Vector3.new(look.X, 0, look.Z).Unit * 6
	ctx.Weapons:Explode(player, at, b.Radius, b.Damage)
	-- a rock cell where it went off is cleared (not past the dig limit)
	local cleared = false
	if hit then
		local floor, column = Grid.CellAt(hit.Position - hit.Normal * 1.5)
		local limit = RunState.Get("DigLimit")
		if floor and column and ctx.Grid:State(floor, column) == "Rock" and (type(limit) ~= "number" or floor <= limit) then
			cleared = ctx.Dig:DigNow(floor, column, "Breaching Charge", player)
		end
	end
	return true, if cleared then "BREACHING CHARGE: THE ROCK CELL IS CLEARED" else "BREACHING CHARGE"
end

-- Spelunker ----------------------------------------------------------------------------------------------------------

local function grappleLine(state: State, origin: Vector3, look: Vector3): (boolean, string?, string?, number?)
	local player = state.Player
	local root = rootOf(player)
	if not root then
		return false, "YOU NEED TO BE STANDING"
	end
	local g = t().Grapple
	local hit = aim(player, origin, look, g.Range, true)
	if not hit then
		return false, `NOTHING TO GRAPPLE WITHIN {g.Range} STUDS`
	end
	local hitModel = hit.Instance:FindFirstAncestorOfClass("Model")
	local other = if hitModel then Players:GetPlayerFromCharacter(hitModel) else nil
	if other and other ~= player then
		if not standing(other) then
			return false, "THEY CAN'T BE PULLED NOW"
		end
		local to = root.Position + root.CFrame.LookVector * 3
		Remotes.FireClient("Grapple", other, to, g.Speed, player.UserId)
		fx(player, "Rope", root.Position, { To = (rootOf(other) :: BasePart).Position })
		return true, `GRAPPLE LINE: PULLING {string.upper(other.DisplayName)}`
	end
	local to = hit.Position + hit.Normal * 2.5 + Vector3.new(0, 1.5, 0)
	Remotes.FireClient("Grapple", player, to, g.Speed, player.UserId)
	fx(player, "Rope", root.Position, { To = hit.Position })
	return true, nil
end

-- Mad Scientist ----------------------------------------------------------------------------------------------------------

local function gadgetSpot(player: Player, origin: Vector3, look: Vector3): Vector3?
	local root = rootOf(player)
	if not root then
		return nil
	end
	local hit = aim(player, origin, look, t().AimRange)
	local at = if hit then hit.Position else root.Position + Vector3.new(look.X, 0, look.Z).Unit * 8
	return ground(at)
end

local function shockTrap(state: State, origin: Vector3, look: Vector3): (boolean, string?, string?, number?)
	local at = gadgetSpot(state.Player, origin, look)
	if not at then
		return false, "YOU NEED TO BE STANDING"
	end
	local tr = t().Trap
	local part = makePart("ShockTrap", Vector3.new(2.4, 0.3, 2.4), Color3.fromRGB(230, 190, 50), Enum.Material.Neon)
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.3, 2.4, 2.4)
	part.CFrame = CFrame.new(at + Vector3.new(0, 0.15, 0)) * CFrame.Angles(0, 0, math.rad(90))
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(140, 200, 255)
	light.Range = tr.Radius
	light.Brightness = 1.5
	light.Parent = part
	part.Parent = holder("ClassDevices")
	table.insert(traps, { Owner = state.Player, Part = part, At = at, Until = os.clock() + tr.Seconds })
	return true, "SHOCK TRAP SET"
end

local function tickTraps()
	local tr = t().Trap
	for i = #traps, 1, -1 do
		local trap = traps[i]
		local sprung = false
		if os.clock() < trap.Until and trap.Part.Parent then
			for _, c in ctx.Combat:All("Monsters") do
				if c.State == "Alive" and (c.Root.Position - trap.At).Magnitude - c.Reach <= tr.Radius then
					stun(c.Model, tr.StunSeconds)
					ctx.Combat:Damage(c.Id, 10, playerCombatId(trap.Owner), "shocked")
					sprung = true
				end
			end
		end
		if sprung or os.clock() >= trap.Until or not trap.Part.Parent then
			if sprung then
				Remotes.FireAllClients("AbilityFx", trap.Owner.UserId, "MadScientist", "Zap", trap.At, { Radius = tr.Radius })
			end
			trap.Part:Destroy()
			table.remove(traps, i)
		end
	end
end

local function teleportBeacon(state: State, origin: Vector3, look: Vector3): (boolean, string?, string?, number?)
	local at = gadgetSpot(state.Player, origin, look)
	if not at then
		return false, "YOU NEED TO BE STANDING"
	end
	local old = beacon
	if old then
		old.Part:Destroy()
	end
	local seconds = t().BeaconSeconds
	local part = makePart("TeleportBeacon", Vector3.new(1, 5, 1), Color3.fromRGB(120, 220, 255), Enum.Material.Neon)
	part.Transparency = 0.2
	part.CFrame = CFrame.new(at + Vector3.new(0, 2.5, 0))
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(120, 220, 255)
	light.Range = 16
	light.Brightness = 2
	light.Parent = part
	part.Parent = holder("ClassDevices")
	local untilAt = os.clock() + seconds
	beacon = { Part = part, Until = untilAt, By = state.Player }
	ctx.SetBeacon(now() + seconds, state.Player.DisplayName)
	task.delay(seconds, function()
		local b = beacon
		if b and b.Until == untilAt then
			b.Part:Destroy()
			beacon = nil
			ctx.SetBeacon(nil, nil)
		end
	end)
	for _, p in ctx.Session:ReadyPlayers() do
		if p ~= state.Player then
			Remotes.FireClient("Alert", p, "Info", `{string.upper(state.Player.DisplayName)} PLACED A TELEPORT BEACON: T TO TELEPORT`)
		end
	end
	return true, `TELEPORT BEACON SET FOR {math.floor(seconds)} S`
end

-- A teammate's TeleportToBeacon.
function Abilities.Teleport(player: Player): (boolean, string?)
	local b = beacon
	if not b or os.clock() >= b.Until or not b.Part.Parent then
		return false, "THERE'S NO TELEPORT BEACON"
	end
	if not standing(player) then
		return false, "YOU NEED TO BE STANDING"
	end
	if ctx.Inventory:Carrying(player) then
		return false, "PUT DOWN WHAT YOU'RE CARRYING FIRST"
	end
	local character = player.Character :: Model
	local angle = rng:NextNumber() * math.pi * 2
	local at = b.Part.Position + Vector3.new(math.cos(angle) * 3, 1, math.sin(angle) * 3)
	character:PivotTo(CFrame.new(at))
	fx(player, "Teleport", at, {})
	return true, nil
end

local function gravityWell(state: State, origin: Vector3, look: Vector3): (boolean, string?, string?, number?)
	local at = gadgetSpot(state.Player, origin, look)
	if not at then
		return false, "YOU NEED TO BE STANDING"
	end
	local g = t().GravityWell
	local part = makePart("GravityWell", Vector3.new(2, 2, 2), Color3.fromRGB(150, 90, 230), Enum.Material.ForceField)
	part.Shape = Enum.PartType.Ball
	part.CFrame = CFrame.new(at + Vector3.new(0, 2, 0))
	part.Parent = holder("ClassDevices")
	Debris:AddItem(part, g.Seconds)
	table.insert(wells, { Owner = state.Player, Part = part, At = at + Vector3.new(0, 2, 0), Until = os.clock() + g.Seconds })
	fx(state.Player, "Well", at, { Radius = g.Radius })
	return true, "GRAVITY WELL"
end

local function tickWells()
	local g = t().GravityWell
	for i = #wells, 1, -1 do
		local well = wells[i]
		if os.clock() >= well.Until or not well.Part.Parent then
			table.remove(wells, i)
		else
			for _, c in ctx.Combat:All("Monsters") do
				local offset = well.At - c.Root.Position
				local flat = Vector3.new(offset.X, 0, offset.Z)
				if c.State == "Alive" and offset.Magnitude - c.Reach <= g.Radius and not ctx.Boss:IsBoss(c.Id) then
					stun(c.Model, 0.35)
					if flat.Magnitude > 1.5 and not c.Root.Anchored then
						c.Root.AssemblyLinearVelocity = flat.Unit * g.Pull + Vector3.new(0, c.Root.AssemblyLinearVelocity.Y, 0)
					end
				end
			end
		end
	end
end

local GADGETS: { [string]: (State, Vector3, Vector3) -> (boolean, string?, string?, number?) } = {
	["Shock Trap"] = shockTrap,
	["Teleport Beacon"] = teleportBeacon,
	["Gravity Well"] = gravityWell,
}

-- Tinkerer --------------------------------------------------------------------------------------------------------

local function droneGraybox(): Model
	local model = Instance.new("Model")
	model.Name = "CombatDrone"
	local body = makePart("Body", Vector3.new(1.6, 0.6, 1.6), Color3.fromRGB(196, 150, 54), Enum.Material.Metal)
	body.Parent = model
	local eye = makePart("Eye", Vector3.new(0.5, 0.5, 0.5), Color3.fromRGB(120, 220, 255), Enum.Material.Neon)
	eye.Shape = Enum.PartType.Ball
	eye.CFrame = CFrame.new(0, -0.1, -0.8)
	eye.Parent = model
	model.PrimaryPart = body
	return model
end

local function removeDrone(player: Player)
	local drone = drones[player]
	drones[player] = nil
	if drone then
		local model = drone.Part:FindFirstAncestorOfClass("Model")
		if model then
			model:Destroy()
		else
			drone.Part:Destroy()
		end
	end
end

local function spawnDrone(player: Player)
	if drones[player] then
		return
	end
	local root = rootOf(player)
	if not root then
		return
	end
	local model = device("Props", "Prop_CombatDrone", droneGraybox)
	model.Name = `Drone_{player.UserId}`
	model:SetAttribute("Owner", player.UserId)
	model:SetAttribute("Mode", "Escort")
	local body = model:FindFirstChild("Drone") -- the art's body (Prop_CombatDrone); the graybox names its own
	local primary = model.PrimaryPart or (if body and body:IsA("BasePart") then body else model:FindFirstChildWhichIsA("BasePart")) :: BasePart
	-- the model's pivot rides on the body from here on (WorldPivot stays behind once physics moves it)
	primary.PivotOffset = primary.CFrame:ToObjectSpace(model:GetPivot())
	model.PrimaryPart = primary
	-- one physics body, server-owned and moved by constraints, so every client sees it glide
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.Massless = part ~= primary
			if part ~= primary then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = primary
				weld.Part1 = part
				weld.Parent = part
			end
		end
	end
	primary.CustomPhysicalProperties = PhysicalProperties.new(0.2, 0.3, 0.5)
	local attachment = Instance.new("Attachment")
	attachment.Name = "DroneAttachment"
	attachment.Parent = primary
	local align = Instance.new("AlignPosition")
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = attachment
	align.MaxForce = 4000
	align.Responsiveness = 18
	align.Parent = primary
	local turn = Instance.new("AlignOrientation")
	turn.Mode = Enum.OrientationAlignmentMode.OneAttachment
	turn.Attachment0 = attachment
	turn.MaxTorque = 4000
	turn.Responsiveness = 15
	turn.Parent = primary
	local light = Instance.new("PointLight")
	light.Range = 10
	light.Brightness = 0.8
	light.Color = Color3.fromRGB(120, 220, 255)
	light.Parent = primary
	local start = root.Position + Vector3.new(2.5, 4, 1.5)
	model:PivotTo(CFrame.new(start))
	align.Position = start
	model.Parent = holder("ClassDevices")
	pcall(function()
		primary:SetNetworkOwner(nil)
	end)
	drones[player] = { Owner = player, Part = primary, Align = align, Turn = turn, NextShot = 0, NextPickup = 0, Shots = 0 }
end

local MODE_COLOURS: { [string]: Color3 } = {
	Escort = Color3.fromRGB(120, 220, 255),
	Guard = Color3.fromRGB(110, 170, 255),
	Assault = Color3.fromRGB(255, 110, 70),
	Repair = Color3.fromRGB(120, 230, 120),
}

local function tickDrones()
	local d = t().Drone
	for player, drone in drones do
		local state = ctx.State(player)
		local root = rootOf(player)
		if not state or state.Class ~= "Tinkerer" or player.Parent ~= Players or not drone.Part.Parent then
			removeDrone(player)
		elseif root then
			local mode = if state.Effect and os.clock() < state.EffectUntil then state.Effect else "Escort"
			local model = drone.Part:FindFirstAncestorOfClass("Model")
			if model and model:GetAttribute("Mode") ~= mode then
				model:SetAttribute("Mode", mode)
				local colour = MODE_COLOURS[mode] or MODE_COLOURS.Escort
				local light = drone.Part:FindFirstChildOfClass("PointLight")
				if light then
					light.Color = colour
				end
				local eye = model:FindFirstChild("Eye")
				if eye and eye:IsA("BasePart") then
					eye.Color = colour -- the eye shows the mode
				end
			end
			local side = root.CFrame.RightVector * 2.5 + root.CFrame.LookVector * (if mode == "Guard" then 2 else -1.5)
			local goal = root.Position + side + Vector3.new(0, 3.5 + math.sin(os.clock() * 2) * 0.3, 0)
			if (drone.Part.Position - goal).Magnitude > 40 then
				drone.Part.CFrame = CFrame.new(goal) -- left far behind (a teleport, the elevator): catch up
			end
			drone.Align.Position = goal
			local from = drone.Part.Position
			if mode == "Repair" then
				-- the nearest damaged room within RepairRange of you
				local best, bestDistance = nil, d.RepairRange
				for _, room in ctx.Grid:Rooms() do
					if room.HP < room.MaxHP then
						local dist = (roomCentre(room) - root.Position).Magnitude
						if dist <= bestDistance then
							best, bestDistance = room, dist
						end
					end
				end
				if best and os.clock() >= drone.NextShot then
					drone.NextShot = os.clock() + 0.5
					ctx.Build:Repair(best.Id, d.RepairPerSecond * 0.5, "Drone", player)
					Remotes.FireAllClients("AbilityFx", player.UserId, "Tinkerer", "RepairBeam", from, { To = roomCentre(best) })
				end
				drone.Turn.CFrame = CFrame.lookAt(from, from + root.CFrame.LookVector)
			else
				local target = nearestMonster(from, d.Range)
				if target then
					drone.Turn.CFrame = CFrame.lookAt(from, target.Root.Position)
					if os.clock() >= drone.NextShot then
						local guns = math.max(1, math.floor(Modifiers.PlayerValue(player, "DroneGuns") or 1))
						drone.NextShot = os.clock() + d.FireSeconds / guns
						local damage = d.Damage * (if mode == "Assault" then d.AssaultMultiplier else 1)
						ctx.Combat:Damage(target.Id, damage, playerCombatId(player), "drone")
						-- from a gun's muzzle: the second gun (level 3) takes every other shot
						drone.Shots += 1
						local muzzle = if model then socketOf(model, if guns > 1 and drone.Shots % 2 == 0 then "Muzzle2" else "Muzzle") else nil
						Remotes.FireAllClients("AbilityFx", player.UserId, "Tinkerer", "Tracer", muzzle or from, { To = target.Root.Position })
					end
				else
					drone.Turn.CFrame = CFrame.lookAt(from, from + root.CFrame.LookVector)
				end
			end
			if os.clock() >= drone.NextPickup then
				drone.NextPickup = os.clock() + 1
				ctx.Inventory:CollectBags(player, root.Position, d.PickupRange)
			end
		end
	end
end

local function droneMode(state: State, option: number): (boolean, string?, string?, number?)
	if not drones[state.Player] then
		spawnDrone(state.Player)
	end
	local name = Classes.OptionName(state.Class, option) or "Guard"
	local seconds = Classes.Duration(state.Class, state.Level)
	return true, `DRONE MODE: {string.upper(name)} FOR {math.floor(seconds)} S`, name, seconds
end

-- The drone revives its owner once per Surge (the Tinkerer's level 3): ClassService calls this when
-- a player goes down.
function Abilities.Downed(player: Player)
	local state = ctx.State(player)
	if not state or state.Class ~= "Tinkerer" or state.DroneRevives <= 0 or not drones[player] then
		return
	end
	state.DroneRevives -= 1
	task.delay(t().Drone.ReviveSeconds, function()
		if player.Parent == Players and player:GetAttribute("Life") == "Downed" then
			local ok = ctx.Combat:Revive(player, nil)
			if ok then
				Remotes.FireClient("Alert", player, "Info", "YOUR DRONE REVIVED YOU")
				local drone = drones[player]
				if drone then
					Remotes.FireAllClients("AbilityFx", player.UserId, "Tinkerer", "RepairBeam", drone.Part.Position,
						{ To = (rootOf(player) or drone.Part).Position })
				end
			end
		end
	end)
end

-- Dispatch ---------------------------------------------------------------------------------------------------------

local HANDLERS: { [string]: (State, number, Vector3, Vector3) -> (boolean, string?, string?, number?) } = {
	Survivor = function(state)
		return secondWind(state)
	end,
	Engineer = function(state, _, origin, look)
		return deployTurret(state, origin, look)
	end,
	Medic = function(state)
		return triagePulse(state)
	end,
	Firefighter = function(state)
		return foamBurst(state)
	end,
	Cook = function(state)
		return heartyMeal(state)
	end,
	Security = function(state)
		return holdTheLine(state)
	end,
	Scout = function(state)
		return flarePing(state)
	end,
	Quartermaster = function(state, option)
		return requisition(state, option)
	end,
	RadioOperator = function(state)
		return supplyCall(state)
	end,
	HazmatTech = function(state)
		return deconField(state)
	end,
	Exterminator = function(state)
		return napalmLine(state)
	end,
	Marksman = function(state)
		return steadyShot(state)
	end,
	Driller = function(state, _, origin, look)
		return overdrive(state, origin, look)
	end,
	Scavenger = function(state)
		return magnetSweep(state)
	end,
	Warden = function(state)
		return rallyCall(state)
	end,
	Demolitionist = function(state, _, origin, look)
		return breachingCharge(state, origin, look)
	end,
	Spelunker = function(state, _, origin, look)
		return grappleLine(state, origin, look)
	end,
	MadScientist = function(state, option, origin, look)
		local fn = GADGETS[Classes.OptionName(state.Class, option) or ""]
		if not fn then
			return false, "NO SUCH GADGET"
		end
		return fn(state, origin, look)
	end,
	Tinkerer = function(state, option)
		return droneMode(state, option)
	end,
}

function Abilities.Has(classId: string): boolean
	return HANDLERS[classId] ~= nil
end

function Abilities.Use(state: State, option: number, origin: Vector3, look: Vector3): (boolean, string?, string?, number?)
	local handler = HANDLERS[state.Class]
	if not handler then
		return false, "THIS CLASS HAS NO ABILITY YET"
	end
	local ok, used, text, effect, seconds = pcall(handler, state, option, origin, look)
	if not ok then
		log:Warn("%s's %s failed: %s", state.Player.Name, state.Class, tostring(used))
		return false, "THAT DIDN'T WORK"
	end
	return used, text, effect, seconds
end

-- A player's class or level is now `state` (or they left: nil): devices that belong to a class.
function Abilities.ClassChanged(player: Player, state: State?)
	if not state or state.Class ~= "Tinkerer" then
		removeDrone(player)
	elseif standing(player) then
		spawnDrone(player)
	end
	if not state or state.Class ~= "Engineer" then
		removeTurret(player)
	end
	if not state then
		local had = presence[player]
		if had then
			ctx.Economy:SetModifier(`presence:{player.UserId}`, "RoomOutput", nil, had)
			presence[player] = nil
		end
	end
end

-- A respawned Tinkerer gets their drone back.
function Abilities.Spawned(player: Player)
	local state = ctx.State(player)
	if state and state.Class == "Tinkerer" then
		removeDrone(player)
		task.delay(0.5, spawnDrone, player)
	end
end

function Abilities.Tick(dt: number)
	for _, step in { tickTurrets, tickDrones, tickTraps, tickWells } do
		local ok, err = pcall(step :: any)
		if not ok then
			log:Warn("tick: %s", tostring(err))
		end
	end
	for _, step in { tickStrips, tickBurning } do
		local ok, err = pcall(step :: any, dt)
		if not ok then
			log:Warn("tick: %s", tostring(err))
		end
	end
end

-- Once a second: the Medic's touch and the Cook's Kitchen.
function Abilities.Slow(dt: number)
	local ok, err = pcall(tickTouchHeal, dt)
	if not ok then
		log:Warn("touch heal: %s", tostring(err))
	end
	ok, err = pcall(tickPresence)
	if not ok then
		log:Warn("presence: %s", tostring(err))
	end
end

function Abilities.Describe(): string
	local lines = {}
	for player, turret in turrets do
		table.insert(lines, string.format("turret: %s, %.0f s left", player.Name, turret.Until - os.clock()))
	end
	for player, drone in drones do
		local model = drone.Part:FindFirstAncestorOfClass("Model")
		table.insert(lines, `drone: {player.Name}, mode {if model then tostring(model:GetAttribute("Mode")) else "?"}`)
	end
	local burns = 0
	for _ in burning do
		burns += 1
	end
	table.insert(lines, `burning monsters {burns}; napalm strips {#strips}; traps {#traps}; wells {#wells}`)
	local b = beacon
	table.insert(lines, if b then string.format("beacon by %s, %.0f s left", b.By.Name, b.Until - os.clock()) else "no beacon")
	local count = 0
	for _ in barricaded do
		count += 1
	end
	table.insert(lines, `barricaded vents {count}; meal {if meal then "on" else "off"}`)
	return table.concat(lines, "\n")
end

function Abilities.Init(context: Context)
	ctx = context
end

return Abilities
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000ED"><Properties><string name="Name">Hazards</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Hazards: what disasters do to the bunker that other systems must see at once (bible Section 10;
	Prompt 13). Run place, server. DisasterService writes it; Lib.PathGraph, ResidentBrain and
	MonsterService read it. It is a module rather than a service so readers need not depend on
	DisasterService (which itself needs the residents and the combatants).

	* Fires: a room id -> the fire's strength (0 to 100).
	* Floods: a room id -> the water's level (0 to 100); Gas: a room id -> its strength (Prompt 23).
	  Refuge(unit) says whether people should keep out of a room for any of the three.
	* Blocked passages: cave-in rubble between two graph units (a doorway, or every passage into
	  a tunnel cell). Routes go around them; when there is no way round, residents are trapped.
	* Version() grows with every change to the blocked passages, so walkers know to plan again.
]]

local Hazards = {}

local fires: { [string]: number } = {}
local floods: { [string]: number } = {}
local gas: { [string]: number } = {}
local radiation: { [string]: number } = {} -- Prompt 24
local blocked: { [string]: string } = {} -- "a|b" (sorted) -> the rubble's id
local version = 0

local function edgeKey(a: string, b: string): string
	return if a < b then `{a}|{b}` else `{b}|{a}`
end

Hazards.EdgeKey = edgeKey

-- Fires --------------------------------------------------------------------------------------------

function Hazards.SetFire(unit: string, strength: number?)
	fires[unit] = if strength and strength > 0 then strength else nil
end

function Hazards.Fire(unit: string?): number?
	return if unit then fires[unit] else nil
end

function Hazards.Fires(): { [string]: number }
	return fires
end

-- Floods and gas (Prompt 23) -----------------------------------------------------------------------

function Hazards.SetFlood(unit: string, level: number?)
	floods[unit] = if level and level > 0 then level else nil
end

function Hazards.Flood(unit: string?): number?
	return if unit then floods[unit] else nil
end

function Hazards.Floods(): { [string]: number }
	return floods
end

function Hazards.SetGas(unit: string, strength: number?)
	gas[unit] = if strength and strength > 0 then strength else nil
end

function Hazards.Gas(unit: string?): number?
	return if unit then gas[unit] else nil
end

function Hazards.GasLeaks(): { [string]: number }
	return gas
end

-- Radiation (Prompt 24): a leak's strength in each unit it fills.
function Hazards.SetRadiation(unit: string, strength: number?)
	radiation[unit] = if strength and strength > 0 then strength else nil
end

function Hazards.Radiation(unit: string?): number?
	return if unit then radiation[unit] else nil
end

function Hazards.RadiationLeaks(): { [string]: number }
	return radiation
end

-- Is `unit` somewhere people should keep out of: burning, flooded to `floodAt`, gassed to `gasAt`
-- or irradiated to `radiationAt`?
function Hazards.Unsafe(unit: string?, floodAt: number, gasAt: number, radiationAt: number?): boolean
	if not unit then
		return false
	end
	return fires[unit] ~= nil or (floods[unit] or 0) >= floodAt or (gas[unit] or 0) >= gasAt
		or (radiationAt ~= nil and (radiation[unit] or 0) >= radiationAt)
end

-- Blocked passages ---------------------------------------------------------------------------------

function Hazards.Block(a: string, b: string, by: string)
	local key = edgeKey(a, b)
	if blocked[key] ~= by then
		blocked[key] = by
		version += 1
	end
end

-- Opens every passage the rubble `by` blocked.
function Hazards.Unblock(by: string)
	for key, owner in table.clone(blocked) do
		if owner == by then
			blocked[key] = nil
			version += 1
		end
	end
end

function Hazards.Blocked(a: string, b: string): boolean
	return blocked[edgeKey(a, b)] ~= nil
end

-- The rubble blocking a passage, if any.
function Hazards.BlockedBy(a: string, b: string): string?
	return blocked[edgeKey(a, b)]
end

function Hazards.AnyBlocked(): boolean
	return next(blocked) ~= nil
end

-- The units next to `unit` that can be walked to (Bunker:Neighbors without blocked passages).
function Hazards.Neighbors(bunker: any, unit: string): { string }
	local list = bunker:Neighbors(unit)
	if next(blocked) == nil then
		return list
	end
	local open = {}
	for _, other in list do
		if not blocked[edgeKey(unit, other)] then
			table.insert(open, other)
		end
	end
	return open
end

function Hazards.Version(): number
	return version
end

-- Forgets everything (a new run in the same server; DevTools).
function Hazards.Clear()
	table.clear(fires)
	table.clear(floods)
	table.clear(gas)
	table.clear(radiation)
	if next(blocked) then
		table.clear(blocked)
		version += 1
	end
end

return Hazards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000EE"><Properties><string name="Name">PathGraph</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PathGraph: walking routes inside the bunker (bible Section 23: residents move along the room
	graph; every room has nodes for doors, work spots, beds and tables). Run place, server.

	A route is the room graph's shortest path (Bunker:Neighbors: doorways sideways, Shafts up and
	down; dug cells count). Its waypoints:
	* inside a room or dug cell, along the front aisle (AISLE studs in front of the cell's centre
	  line, clear of the furniture against the back wall);
	* through a doorway at its middle (DOOR studs in front of centre; the opening is 7 studs clear);
	* up or down a Shaft by its stairs: the lower Shaft cell's Bottom and Top sockets (the stairs
	  climb from its floor to the floor above);
	* the target last (a work spot, a seat, a bed).
	Graybox rooms without sockets fall back to the cell's middle.

	Cave-in rubble (Prompt 13, Lib.Hazards) blocks passages: routes go around it. When rubble is
	the only reason there is no route, Waypoints says "Blocked" (residents are then trapped and
	monsters look for another target).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Grid = require(ReplicatedStorage.Shared.Rules.Grid)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)
local Hazards = require(ServerScriptService.Lib.Hazards)

local PathGraph = {}

local AISLE = 8 -- studs in front of the cell's centre line
-- The doorway's walking line, in front of centre. The kit's opening is 7 studs clear (z -3.5 to
-- 3.5): at 2 a root 4 studs wide (the Geode Golem, the Tide Crab) caught the jamb and never got
-- through (Prompt 24's playtest); at 0.5 it clears both jambs by over a stud.
local DOOR = 0.5
local DOOR_REACH = 6 -- how far either side of a wall the doorway approach starts

-- The shortest route from one graph node to another (both included), or nil. Rubble blocks
-- passages unless `ignoreRubble`.
function PathGraph.Route(bunker: any, from: string, to: string, ignoreRubble: boolean?): { string }?
	if from == to then
		return { from }
	end
	local previous: { [string]: string } = {}
	local seen: { [string]: boolean } = { [from] = true }
	local queue = { from }
	local index = 1
	while index <= #queue do
		local unit = queue[index]
		index += 1
		for _, other in if ignoreRubble then bunker:Neighbors(unit) else Hazards.Neighbors(bunker, unit) do
			if not seen[other] then
				seen[other] = true
				previous[other] = unit
				if other == to then
					local route = { to }
					local at = to
					while previous[at] do
						at = previous[at]
						table.insert(route, 1, at)
					end
					return route
				end
				table.insert(queue, other)
			end
		end
	end
	return nil
end

local function floorY(floor: number, column: number): number
	return Grid.CellPosition(floor, column).Y
end

local function aisle(x: number, floor: number, column: number): Vector3
	local cell = Grid.CellPosition(floor, column)
	return Vector3.new(x, cell.Y, cell.Z + AISLE)
end

-- The cells of `a` and `b` that touch: a horizontal pair on one floor, or a vertical pair.
local function touching(bunker: any, a: string, b: string): ({ number }?, { number }?)
	for _, ca in bunker:CellsOf(a) do
		for _, cb in bunker:CellsOf(b) do
			local same = ca[1] == cb[1] and math.abs(ca[2] - cb[2]) == 1
			local stacked = ca[2] == cb[2] and math.abs(ca[1] - cb[1]) == 1
			if same or stacked then
				return ca, cb
			end
		end
	end
	return nil, nil
end

-- Is rubble the only thing between two nodes? (A route exists without it, none with it.)
function PathGraph.Blocked(bunker: any, from: string, to: string): boolean
	if not Hazards.AnyBlocked() then
		return false
	end
	return PathGraph.Route(bunker, from, to) == nil and PathGraph.Route(bunker, from, to, true) ~= nil
end

--[[
	Waypoints from `fromPosition` (in node `fromUnit`) to `target` (in node `toUnit`). `modelOf`
	gives a room's model (for the Shafts' stair sockets). nil when no route exists, with
	"Blocked" when rubble is what stands in the way.
]]
function PathGraph.Waypoints(bunker: any, modelOf: (string) -> Model?, fromPosition: Vector3, fromUnit: string,
	toUnit: string, target: Vector3): ({ Vector3 }?, string?)
	local route = PathGraph.Route(bunker, fromUnit, toUnit)
	if not route then
		return nil, if PathGraph.Route(bunker, fromUnit, toUnit, true) then "Blocked" else nil
	end
	local points: { Vector3 } = {}
	local startCell = bunker:CellsOf(fromUnit)[1]
	if startCell then
		local floor, column = Grid.CellAt(fromPosition)
		table.insert(points, aisle(fromPosition.X, floor or startCell[1], column or startCell[2]))
	end
	for i = 1, #route - 1 do
		local u, v = route[i], route[i + 1]
		local cu, cv = touching(bunker, u, v)
		if cu and cv then
			if cu[1] == cv[1] then
				-- sideways, through the doorway in the shared wall
				local pu, pv = Grid.CellPosition(cu[1], cu[2]), Grid.CellPosition(cv[1], cv[2])
				local wall = (pu.X + pv.X) / 2
				local dir = if cv[2] > cu[2] then 1 else -1
				local y = pu.Y
				table.insert(points, Vector3.new(wall - dir * DOOR_REACH, y, pu.Z + AISLE))
				table.insert(points, Vector3.new(wall - dir * DOOR_REACH, y, pu.Z + DOOR))
				table.insert(points, Vector3.new(wall + dir * DOOR_REACH, y, pu.Z + DOOR))
				table.insert(points, Vector3.new(wall + dir * DOOR_REACH, y, pu.Z + AISLE))
			else
				-- up or down a Shaft: the lower cell's stairs, Bottom (its floor) to Top (the floor above)
				local lower = if cu[1] > cv[1] then cu else cv
				local lowerUnit = if lower == cu then u else v
				local model = modelOf(lowerUnit)
				local bottom = if model then BunkerKit.Socket(model, "Bottom") else nil
				local top = if model then BunkerKit.Socket(model, "Top") else nil
				local up = cv[1] < cu[1]
				if bottom and top then
					local first, last = if up then bottom.Position else top.Position, if up then top.Position else bottom.Position
					table.insert(points, aisle(first.X, cu[1], cu[2]))
					table.insert(points, first)
					table.insert(points, last)
					table.insert(points, aisle(last.X, cv[1], cv[2]))
				else
					local pv = Grid.CellPosition(cv[1], cv[2])
					table.insert(points, Vector3.new(pv.X, pv.Y, pv.Z + AISLE))
				end
			end
		end
	end
	local floor, column = Grid.CellAt(target + Vector3.new(0, 1, 0))
	if floor and column then
		table.insert(points, Vector3.new(target.X, floorY(floor, column), Grid.CellPosition(floor, column).Z + AISLE))
	end
	table.insert(points, target)
	return points
end

return PathGraph
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000EF"><Properties><string name="Name">ProfileSchema</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileSchema: the shape of a player's saved data (bible Section 23), its defaults, its
	migrations, and the load pipeline: migrate, then reconcile, then validate. Pure (no
	DataStores), so the data tests can run it on fixtures. ProfileService does the I/O.

	Version history:
	  1  2026-11-08  first version (Prompt 2)

	To change the shape: raise VERSION, add MIGRATIONS[old] that turns version old into old+1,
	and update Default() and SHAPE. Never rename or drop a field without a migration: during
	a rolling update old and new servers run side by side, and an old server refuses (never
	overwrites) data newer than it knows.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Check = require(Shared.Utilities.Check)
local Config = require(Shared.Config)
local TableUtil = require(Shared.Utilities.TableUtil)

local ProfileSchema = {}

ProfileSchema.VERSION = 1
ProfileSchema.RECEIPTS_KEPT = 200

-- version -> function turning a profile of that version into the next version
local MIGRATIONS: { [number]: (data: { [string]: any }) -> { [string]: any } } = {}

-- Fields whose value is a fixed-shape record (reconciled field by field); every other table
-- field is a map whose keys belong to the player (classes owned, badges earned...).
local RECORDS: { [string]: boolean } = {
	Talents = true,
	Cosmetics = true,
	Stats = true,
	Quests = true,
	ClassShop = true,
	Loadout = true,
}

local Id = Check.string(64, { pattern = "^[%a][%w_]*$" })

local SHAPE = Check.shape({
	Version = Check.integer(1),
	Glowshards = Check.integer(0, 1e9),
	Classes = Check.map(Id, Check.shape({ Level = Check.integer(1, 3), XP = Check.number({ min = 0 }) }), 100),
	Talents = Check.shape({ Slots = Check.integer(0, 3), Equipped = Check.array(Id, 3) }),
	Legends = Check.map(Id, Check.shape({ Renown = Check.integer(1, 5) }), 200),
	Cosmetics = Check.shape({
		Owned = Check.map(Id, Check.boolean(), 2000),
		Equipped = Check.map(Id, Id, 32),
	}),
	Stats = Check.map(Id, Check.number({ min = 0 }), 64),
	Badges = Check.map(Id, Check.number({ min = 0 }), 500),
	Quests = Check.shape({
		Daily = Check.array(Check.any(), 10),
		Weekly = Check.array(Check.any(), 10),
		LastReset = Check.number({ min = 0 }),
	}),
	ClassShop = Check.shape({
		Day = Check.integer(0), -- the shop day (Rules.ClassShop.Day) these slots are for
		Slots = Check.array(Id, 4),
		RerollsUsed = Check.integer(0),
		Wishlist = Check.optional(Id),
		WishDay = Check.optional(Check.integer(0)), -- the shop day the wish was made, or last shown (Prompt 21)
		Trial = Check.optional(Id), -- today's free-trial class, one of the slots
		TrialUsed = Check.optional(Check.boolean()), -- today's trial run has launched
	}),
	-- What the player brings to a run (Section 14: set in the lobby). Talents, the Legend, the
	-- outfit and skins join it with their prompts.
	Loadout = Check.shape({ Class = Id }),
	AccountLevel = Check.integer(1, 100),
	AccountXP = Check.number({ min = 0 }),
	Settings = Check.map(Id, Check.primitive(64), 64),
	Receipts = Check.array(Check.string(64, { min = 1 }), 200),
	FirstRunDone = Check.boolean(),
})

-- A new player's profile: the free class and the starter Legend are theirs (bible Sections
-- 14 and 15).
function ProfileSchema.Default(): { [string]: any }
	local classes: { [string]: any } = {}
	for _, class in Config.All("Classes") do
		if class.Tier == "Free" then
			classes[class.Id] = { Level = 1, XP = 0 }
		end
	end
	local legends: { [string]: any } = {}
	local starter = Config.Get("Tuning", "Legends").StarterLegend
	legends[starter] = { Renown = 1 }
	return {
		Version = ProfileSchema.VERSION,
		Glowshards = 0,
		Classes = classes,
		Talents = { Slots = 0, Equipped = {} },
		Legends = legends,
		Cosmetics = { Owned = {}, Equipped = {} },
		Stats = { Runs = 0, Wins = 0, BestYear = 0, Deepest = 0 },
		Badges = {},
		Quests = { Daily = {}, Weekly = {}, LastReset = 0 },
		ClassShop = { Day = 0, Slots = {}, RerollsUsed = 0 },
		Loadout = { Class = "Survivor" },
		AccountLevel = 1,
		AccountXP = 0,
		Settings = {},
		Receipts = {},
		FirstRunDone = false,
	}
end

-- Runs every migration from data.Version up to VERSION. Errors if a step is missing.
function ProfileSchema.Migrate(data: { [string]: any }): { [string]: any }
	local version = data.Version
	if type(version) ~= "number" then
		version = 1
		data.Version = 1
	end
	while version < ProfileSchema.VERSION do
		local step = MIGRATIONS[version]
		if not step then
			error(`no migration from profile version {version}`)
		end
		data = step(data)
		version += 1
		data.Version = version
	end
	return data
end

-- Fills in fields the profile is missing (new fields, new record fields) from the defaults.
-- Never touches the player's own keys in maps.
function ProfileSchema.Reconcile(data: { [string]: any }): { [string]: any }
	local defaults = ProfileSchema.Default()
	for field, value in defaults do
		local current = data[field]
		if current == nil then
			data[field] = value
		elseif RECORDS[field] and type(current) == "table" and type(value) == "table" then
			for subField, subValue in value do
				if current[subField] == nil then
					current[subField] = subValue
				end
			end
		end
	end
	return data
end

function ProfileSchema.Validate(data: any): (boolean, string?)
	return SHAPE(data)
end

export type LoadStatus = "New" | "Loaded" | "TooNew" | "Invalid"

--[[
	The whole load pipeline for stored Data (nil for a new player): returns the profile to use
	and a status. TooNew and Invalid return no profile: the player must not play on it (and
	nothing may be written).
]]
function ProfileSchema.Load(stored: any): ({ [string]: any }?, LoadStatus, string?)
	if stored == nil then
		return ProfileSchema.Default(), "New", nil
	end
	if type(stored) ~= "table" then
		return nil, "Invalid", `stored data is a {type(stored)}`
	end
	if type(stored.Version) == "number" and stored.Version > ProfileSchema.VERSION then
		return nil, "TooNew", `version {stored.Version} is newer than {ProfileSchema.VERSION}`
	end
	local data = TableUtil.DeepCopy(stored)
	local ok, result = pcall(ProfileSchema.Migrate, data)
	if not ok then
		return nil, "Invalid", tostring(result)
	end
	data = ProfileSchema.Reconcile(result)
	local valid, why = ProfileSchema.Validate(data)
	if not valid then
		return nil, "Invalid", why
	end
	return data, "Loaded", nil
end

-- What the player's own client sees: everything except the receipt log.
function ProfileSchema.Public(data: { [string]: any }): { [string]: any }
	local copy = TableUtil.DeepCopy(data)
	copy.Receipts = nil
	return copy
end

-- Adds a receipt id, keeping the newest RECEIPTS_KEPT.
function ProfileSchema.AddReceipt(data: { [string]: any }, receiptId: string)
	local receipts = data.Receipts
	table.insert(receipts, receiptId)
	while #receipts > ProfileSchema.RECEIPTS_KEPT do
		table.remove(receipts, 1)
	end
end

ProfileSchema._MIGRATIONS = MIGRATIONS -- for the data tests

return ProfileSchema
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000F0"><Properties><string name="Name">Rejoin</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rejoin: where a player's run is, so one who drops can come back (bible Section 21: "the run id
	and the server's access code stay in MemoryStore under each player's id until the run ends").

	* One MemoryStore hash map, RunRejoin; the key is the player's user id.
	* The record: { Key = "<the Run server's reserved id>", Code = "<its access code>",
	  Difficulty = "Normal", At = os.time() }. Server-side only: access codes never go to clients.
	* The lobby writes it when a pad leaves (Lib.RunLaunch) for Tuning.Lobby.RejoinStartSeconds; the
	  Run server (PartyService) writes it again every RejoinRefreshSeconds for RejoinSeconds while
	  the run is on, and removes it when the run ends. A run whose server died stops being offered
	  within RejoinSeconds.
	* Read(userId) retries a failed MemoryStore call; nothing here errors.
]]

local MemoryStoreService = game:GetService("MemoryStoreService")

local Check = require(game:GetService("ReplicatedStorage").Shared.Utilities.Check)

local Rejoin = {}

Rejoin.MAP = "RunRejoin"

export type Record = { Key: string, Code: string, Difficulty: string?, At: number }

local Schema = Check.shape({
	Key = Check.string(200, { min = 1 }),
	Code = Check.string(400, { min = 1 }),
	Difficulty = Check.optional(Check.string(32)),
	At = Check.number({ min = 0 }),
})

local function map(): MemoryStoreHashMap
	return MemoryStoreService:GetHashMap(Rejoin.MAP)
end

function Rejoin.Read(userId: number): (Record?, string?)
	local lastError = "not read"
	for attempt = 1, 2 do
		local ok, value = pcall(function()
			return map():GetAsync(tostring(userId))
		end)
		if ok then
			if value == nil then
				return nil, "no record"
			end
			local good, why = Schema(value)
			return if good then value :: Record else nil, if good then nil else `a bad record: {why}`
		end
		lastError = tostring(value)
		task.wait(attempt)
	end
	return nil, lastError
end

function Rejoin.Write(userId: number, record: Record, seconds: number): (boolean, string?)
	local good, why = Schema(record)
	if not good then
		return false, `a bad record: {why}`
	end
	local ok, err = pcall(function()
		map():SetAsync(tostring(userId), record, math.clamp(math.floor(seconds), 1, 3888000))
	end)
	return ok, if ok then nil else tostring(err)
end

function Rejoin.Remove(userId: number): boolean
	local ok = pcall(function()
		map():RemoveAsync(tostring(userId))
	end)
	return ok
end

return table.freeze(Rejoin)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000F1"><Properties><string name="Name">RunLaunch</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RunLaunch: sends a party to a fresh Run server (bible Section 21: "On launch, the lobby reserves
	a private Run server and teleports the party there. Loadouts and the party list are written to
	MemoryStore under the run's id first"). The lobby's pads use it (PadService), and so does Play
	Again on the results screen (ResultsService), so a party's classes go with it.

		RunLaunch.Start(players, difficulty, loadouts) -> (ok, why?)

	loadouts: [userId] = { Class = "Medic", Trial = false }. In order: reserve the server, write the
	run's record under its id (Lib.RunRecord: party, difficulty, loadouts, the access code), write
	each player's rejoin record (Lib.Rejoin), teleport. Any step failing stops the launch and says
	why; nothing is left behind but records that expire.

	Studio can't reserve servers or teleport: there the record goes under RunRecord.STUDIO_KEY, so
	a Run playtest started next reads it, and Start says so.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Rejoin = require(script.Parent.Rejoin)
local RunRecord = require(script.Parent.RunRecord)

local RunLaunch = {}

export type Loadouts = { [number]: RunRecord.Loadout }

local function record(players: { Player }, difficulty: string, loadouts: Loadouts, code: string?): RunRecord.Record
	local party, packed = {}, {}
	for _, player in players do
		table.insert(party, player.UserId)
		local loadout = loadouts[player.UserId]
		packed[tostring(player.UserId)] = {
			Class = if loadout then loadout.Class else "Survivor",
			Trial = if loadout and loadout.Trial then true else nil,
		}
	end
	return {
		Version = RunRecord.VERSION,
		Party = party,
		Difficulty = difficulty,
		Loadouts = packed,
		CreatedAt = os.time(),
		Code = code,
	}
end

function RunLaunch.Start(players: { Player }, difficulty: string, loadouts: Loadouts): (boolean, string?)
	if #players == 0 then
		return false, "NOBODY TO SEND"
	end
	if not Config.Find("Difficulties", difficulty) then
		return false, "NO SUCH DIFFICULTY"
	end
	local t = Config.Get("Tuning", "Lobby")
	if RunService:IsStudio() then
		-- ten minutes: long enough to start a Run playtest next, short enough not to haunt later ones
		local ok, why = RunRecord.Write(RunRecord.STUDIO_KEY, record(players, difficulty, loadouts, nil), 600)
		return false, if ok then "TELEPORTS DON'T WORK IN STUDIO (THE RUN'S RECORD IS WRITTEN)" else `NO RECORD: {tostring(why)}`
	end
	local placeId = Constants.PLACE_IDS.Run
	local reserved, code, serverId = pcall(function()
		return TeleportService:ReserveServer(placeId)
	end)
	if not reserved or type(code) ~= "string" or type(serverId) ~= "string" then
		return false, `NO SERVER: {tostring(code)}`
	end
	local wrote, why = RunRecord.Write(serverId, record(players, difficulty, loadouts, code), t.RecordSeconds)
	if not wrote then
		return false, `NO RECORD: {tostring(why)}`
	end
	for _, player in players do
		Rejoin.Write(player.UserId, { Key = serverId, Code = code, Difficulty = difficulty, At = os.time() }, t.RejoinStartSeconds)
	end
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = code
	local sent, err = pcall(function()
		TeleportService:TeleportAsync(placeId, players, options)
	end)
	if not sent then
		for _, player in players do
			Rejoin.Remove(player.UserId)
		end
		RunRecord.Remove(serverId)
		return false, `THE TELEPORT FAILED: {tostring(err)}`
	end
	return true, nil
end

-- Sends one player back into the run their rejoin record names. (ok, why?)
function RunLaunch.Rejoin(player: Player): (boolean, string?)
	local found, why = Rejoin.Read(player.UserId)
	if not found then
		return false, if why == "no record" then "THAT RUN HAS ENDED" else `NO RECORD: {tostring(why)}`
	end
	if RunService:IsStudio() then
		return false, "TELEPORTS DON'T WORK IN STUDIO"
	end
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = found.Code
	local sent, err = pcall(function()
		TeleportService:TeleportAsync(Constants.PLACE_IDS.Run, { player }, options)
	end)
	return sent, if sent then nil else `THE TELEPORT FAILED: {tostring(err)}`
end

return table.freeze(RunLaunch)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000F2"><Properties><string name="Name">RunRecord</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RunRecord: the record the lobby writes before it teleports a party into a Run server (bible
	Sections 21 and 23: "Loadouts and the party list are written to MemoryStore under the run's id
	first. The Run server reads them from there and never trusts teleport data").

	* One MemoryStore hash map, RunRecords; the key is the Run server's reserved-server id
	  (game.PrivateServerId, which TeleportService:ReserveServer gives the lobby). In Studio there
	  is no reserved server: the key is "Studio" (DevTools can write a test record there, so the
	  read path can be tried before Prompt 21's lobby writes real ones).
	* The record (version 1):
		{ Version = 1, Party = { user ids }, Difficulty = "Normal",
		  Loadouts = { ["<user id>"] = { Class = "Medic", Trial = false } }, CreatedAt = os.time(),
		  Code = "<the reserved server's access code>" }
	  Prompt 20 reads Loadouts (ClassService); Prompt 21 writes the record (Lib.RunLaunch) and reads
	  Party, Difficulty and Code (PartyService: who may join, the run's difficulty, and the rejoin
	  records it keeps alive, which need the access code a reserved server can't ask for itself).
	* Mine() is this server's record, read once and shared (Mine(true) reads it again: DevTools).
	* Read(key) retries a failed MemoryStore call a few times; it never errors. Write(key, record,
	  seconds) is the lobby's (and DevTools').
]]

local MemoryStoreService = game:GetService("MemoryStoreService")
local RunService = game:GetService("RunService")

local Check = require(game:GetService("ReplicatedStorage").Shared.Utilities.Check)

local RunRecord = {}

RunRecord.MAP = "RunRecords"
RunRecord.VERSION = 1
RunRecord.STUDIO_KEY = "Studio"

export type Loadout = { Class: string, Trial: boolean? }
export type Record = {
	Version: number,
	Party: { number },
	Difficulty: string?,
	Loadouts: { [string]: Loadout },
	CreatedAt: number,
	Code: string?,
}

local Schema = Check.shape({
	Version = Check.integer(1, 100),
	Party = Check.array(Check.integer(1), 12),
	Difficulty = Check.optional(Check.string(32)),
	Loadouts = Check.map(Check.string(20, { pattern = "^%d+$", min = 1 }), Check.shape({
		Class = Check.string(40, { pattern = "^%a[%w]*$", min = 1 }),
		Trial = Check.optional(Check.boolean()),
	}), 12),
	CreatedAt = Check.number({ min = 0 }),
	Code = Check.optional(Check.string(400)),
})

-- This server's key, or nil when it isn't a reserved Run server (and isn't Studio).
function RunRecord.Key(): string?
	local id = game.PrivateServerId
	if id ~= "" then
		return id
	end
	return if RunService:IsStudio() then RunRecord.STUDIO_KEY else nil
end

local function map(): MemoryStoreHashMap
	return MemoryStoreService:GetHashMap(RunRecord.MAP)
end

-- The record under `key`, or nil and why (none written, a MemoryStore failure, a bad shape).
function RunRecord.Read(key: string): (Record?, string?)
	local lastError = "not read"
	for attempt = 1, 3 do
		local ok, value = pcall(function()
			return map():GetAsync(key)
		end)
		if ok then
			if value == nil then
				return nil, "no record"
			end
			local good, why = Schema(value)
			if not good then
				return nil, `a bad record: {why}`
			end
			return value :: Record, nil
		end
		lastError = tostring(value)
		task.wait(attempt)
	end
	return nil, lastError
end

-- Writes the record for `seconds` (MemoryStore expires it after). The lobby's, and DevTools'.
function RunRecord.Write(key: string, record: Record, seconds: number): (boolean, string?)
	local good, why = Schema(record)
	if not good then
		return false, `a bad record: {why}`
	end
	local ok, err = pcall(function()
		map():SetAsync(key, record, math.clamp(math.floor(seconds), 1, 3888000))
	end)
	return ok, if ok then nil else tostring(err)
end

function RunRecord.Remove(key: string): boolean
	local ok = pcall(function()
		map():RemoveAsync(key)
	end)
	return ok
end

-- This server's own record, read once (the first call yields); nil and why when there is none.
-- `again` reads it afresh (DevTools, after writing a test record).
local mine: { Done: boolean, Reading: boolean, Record: Record?, Why: string? } = { Done = false, Reading = false }
function RunRecord.Mine(again: boolean?): (Record?, string?)
	while mine.Reading do
		task.wait(0.1)
	end
	if again then
		mine.Done, mine.Record, mine.Why = false, nil, nil
	end
	if not mine.Done then
		mine.Reading = true
		local key = RunRecord.Key()
		if key then
			mine.Record, mine.Why = RunRecord.Read(key)
		else
			mine.Why = "not a reserved Run server"
		end
		mine.Done, mine.Reading = true, false
	end
	return mine.Record, mine.Why
end

-- A player's loadout in a record.
function RunRecord.Loadout(record: Record?, userId: number): Loadout?
	if not record then
		return nil
	end
	return record.Loadouts[tostring(userId)]
end

return table.freeze(RunRecord)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000F3"><Properties><string name="Name">SourceFight</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SourceFight: the Source's own fight (bible Sections 5 and 10; Prompt 25), driven by BossService,
	which owns the fight, the Boss collection, the model and its clips. Run place, server.

	Section 10: "Several phases: tendrils in many rooms at once, then the core, so the team has to
	split up and regroup." The arithmetic is Shared.Rules.Boss (SourceStage, SourceTendrils,
	SourceRooms, SourceWound, SourceCoreOver); the numbers are Tuning.Source (provisional).

	* Stages (Tuning.Source.Stages; the fight's Phase is the stage): Tendrils, Core, Tendrils, Core.
	* A Tendrils stage: its eye is shut. Tendrils rise in rooms spread over the bunker's floors (in
	  its chamber some rise round it instead, and the rest in the deepest rooms). Each is a
	  combatant of its own (MonsterType SourceTendril, clips through NPCAnimator): it turns to
	  whoever comes near and slams them, and with nobody in reach it slams its room. Each one cut
	  down wounds the Source (Rules.Boss.SourceWound), and the last ends the stage.
	* A Core stage: the eye opens (BossService's hit modifier makes it the weak point). Roots burst
	  up under survivors: a RootMark part in workspace.Monsters (Radius, LandsAt), which clients
	  draw, then the damage. In a stage with RegrowSeconds a tendril grows back now and then (those
	  take nothing off the Source). The stage ends at its health (SourceCoreOver); the last at its
	  death.
	* The Source's own turning and slams are BossService's (it has every boss's).

	API (ctx is BossService's: its services and helpers):
		SourceFight.new(chamberSockets: { CFrame }?): State
		SourceFight.start(ctx, f)                       -- it is up: stage 1
		SourceFight.tick(ctx, f, dt), SourceFight.frame(ctx, f, dt)
		SourceFight.onDied(ctx, f, id): boolean         -- a tendril's death (true: it was one)
		SourceFight.onDamaged(f, id, source)
		SourceFight.isTendril(f, id): boolean
		SourceFight.open(f): boolean                    -- is its eye open?
		SourceFight.base(f): string                     -- its resting clip: Idle or OpenIdle
		SourceFight.counts(f): (number, number)         -- tendrils standing that hold the stage, and all
		SourceFight.places(f): { string }               -- where they stand, for the HUD
		SourceFight.rooms(f): { string }                -- the rooms they stand in, for the mini-map
		SourceFight.regrow(ctx, f), SourceFight.erupt(ctx, f)   -- now (DevTools)
		SourceFight.skip(ctx, f)                        -- cut every tendril down now (DevTools)
		SourceFight.cleanup(ctx, f, wither)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Boss = require(Shared.Rules.Boss)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)

local log = Log.new("SourceFight")

local SourceFight = {}

export type Tendril = {
	Id: string,
	Model: Model,
	Root: BasePart,
	At: Vector3, -- where its crater is, on the floor
	Yaw: number,
	Shown: number, -- the yaw its model was last put at
	Floor: number?,
	Column: number?,
	RoomId: string?,
	Where: string,
	Holds: boolean, -- cutting it down wounds the Source (a regrown one doesn't)
	BornAt: number,
	Up: boolean,
	Busy: number,
	NextAttack: number,
}

export type State = {
	Stage: number,
	Kind: string, -- "Tendrils" | "Core"
	Open: boolean,
	Tendrils: { [string]: Tendril },
	LastBy: { [string]: string },
	Sockets: { CFrame }, -- its chamber's tendril spots (empty in the bunker)
	Chamber: boolean,
	NextErupt: number,
	NextRegrow: number,
	Marks: { Instance },
}

local RISE_SECONDS = 0.5 -- the crater comes up this fast; the Rise clip brings the trunk up after it
local CELL_BACK = 6 -- a tendril stands this far behind its cell's middle, clear of the doorways

function SourceFight.new(chamberSockets: { CFrame }?): State
	return {
		Stage = 0,
		Kind = "Tendrils",
		Open = false,
		Tendrils = {},
		LastBy = {},
		Sockets = chamberSockets or {},
		Chamber = chamberSockets ~= nil,
		NextErupt = math.huge,
		NextRegrow = math.huge,
		Marks = {},
	}
end

local function t(): { [string]: any }
	return Config.Get("Tuning", "Source")
end

local function stateOf(f: any): State
	return f.Source :: State
end

function SourceFight.open(f: any): boolean
	local s = f.Source :: State?
	return s ~= nil and s.Open
end

function SourceFight.base(f: any): string
	return if SourceFight.open(f) then "OpenIdle" else "Idle"
end

function SourceFight.isTendril(f: any, id: string): boolean
	local s = f.Source :: State?
	return s ~= nil and s.Tendrils[id] ~= nil
end

function SourceFight.counts(f: any): (number, number)
	local s = f.Source :: State?
	local holds, all = 0, 0
	if s then
		for _, tendril in s.Tendrils do
			all += 1
			if tendril.Holds then
				holds += 1
			end
		end
	end
	return holds, all
end

function SourceFight.places(f: any): { string }
	local s = f.Source :: State?
	local list = {}
	if s then
		for _, tendril in s.Tendrils do
			table.insert(list, tendril.Where)
		end
		table.sort(list)
	end
	return list
end

-- The rooms tendrils stand in (the mini-map blinks them).
function SourceFight.rooms(f: any): { string }
	local s = f.Source :: State?
	local list = {}
	if s then
		for _, tendril in s.Tendrils do
			if tendril.RoomId and not table.find(list, tendril.RoomId) then
				table.insert(list, tendril.RoomId)
			end
		end
		table.sort(list)
	end
	return list
end

-- Tendrils -------------------------------------------------------------------------------------------

local function tendrilModel(): (Model, BasePart)
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Monsters")
	local template = folder and folder:FindFirstChild("Monster_SourceTendril")
	local model: Model
	if template and template:IsA("Model") then
		model = template:Clone()
	else
		-- no art in this place: a post with an eye, so the fight still plays
		model = Instance.new("Model")
		local root = Instance.new("Part")
		root.Name = "HumanoidRootPart"
		root.Size = Vector3.new(2.4, 2, 2.4)
		root.Transparency = 1
		root.CFrame = CFrame.new(0, 1, 0)
		root.Parent = model
		local trunk = Instance.new("Part")
		trunk.Name = "Trunk"
		trunk.Size = Vector3.new(2.4, 11, 2.4)
		trunk.Color = Color3.fromHex("#6E4766")
		trunk.CFrame = CFrame.new(0, 5.5, 0)
		trunk.CanCollide = false
		trunk.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = trunk
		weld.Parent = root
		model.PrimaryPart = root
		model.WorldPivot = CFrame.identity
		model:SetAttribute("Graybox", true)
	end
	local root = (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart) :: BasePart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanTouch = false
			part.CanCollide = false
			part.Anchored = part == root
		end
	end
	root.CanQuery = false
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
		humanoid.MaxHealth = math.huge -- CombatService keeps its health
		humanoid.Health = math.huge
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		humanoid.PlatformStand = true
	end
	return model, root
end

local function place(tendril: Tendril, sink: number)
	tendril.Model:PivotTo(CFrame.new(tendril.At - Vector3.new(0, sink, 0)) * CFrame.Angles(0, tendril.Yaw, 0))
	tendril.Shown = tendril.Yaw
end

local function raise(ctx: any, f: any, at: Vector3, yaw: number, where: string, spot: Boss.TendrilSpot?, holds: boolean): Tendril?
	local s = stateOf(f)
	local model, root = tendrilModel()
	model:SetAttribute("Rig", "SourceTendril")
	model:SetAttribute("MonsterType", "SourceTendril")
	model:SetAttribute("Boss", f.BossId)
	model:SetAttribute("Tendril", true)
	model:SetAttribute("Where", where)
	model:SetAttribute("Activity", "Rise")
	local players = math.max(#ctx.session:ReadyPlayers(), 1)
	local tendril: Tendril = {
		Id = "",
		Model = model,
		Root = root,
		At = at,
		Yaw = yaw,
		Shown = yaw,
		Floor = if spot then spot.Floor else nil,
		Column = if spot then spot.Column else nil,
		RoomId = if spot then spot.RoomId else nil,
		Where = where,
		Holds = holds,
		BornAt = os.clock(),
		Up = false,
		Busy = os.clock() + t().TendrilRiseSeconds,
		NextAttack = os.clock() + t().TendrilRiseSeconds + 0.6,
	}
	place(tendril, t().TendrilRiseDepth)
	model.Parent = ctx.holder()
	local id = ctx.combat:Register(model, {
		Kind = "Monster", Team = "Monsters", Health = Boss.TendrilHealth(players), MonsterType = "SourceTendril", Root = root,
	})
	if not id then
		model:Destroy()
		return nil
	end
	tendril.Id = id
	model.Name = `SourceTendril_{id}`
	s.Tendrils[id] = tendril
	ctx.rockBurst(at, 14, f)
	return tendril
end

local function roomName(ctx: any, spot: Boss.TendrilSpot): string
	local room = if spot.RoomId then ctx.grid:Room(spot.RoomId) else nil
	local name = if room then string.upper(Config.Get("Rooms", room.Type).Name) else "THE TUNNEL"
	return `{name} · FLOOR {spot.Floor}`
end

-- The cells the Source's own body fills (a tendril never rises through it).
local function arenaCells(f: any): { [string]: boolean }
	local avoid = {}
	if f.Arena and not stateOf(f).Chamber then
		for c = f.Arena.From, f.Arena.To do
			avoid[Grid.Key(f.Arena.Floor, c)] = true
		end
	end
	return avoid
end

local function raiseInRooms(ctx: any, f: any, count: number, holds: boolean): number
	local s = stateOf(f)
	local taken = arenaCells(f)
	for _, tendril in s.Tendrils do
		if tendril.Floor and tendril.Column then
			taken[Grid.Key(tendril.Floor, tendril.Column)] = true
		end
		if tendril.RoomId then
			local room = ctx.grid:Room(tendril.RoomId)
			if room then
				for c = room.Column, room.Column + room.Span - 1 do
					taken[Grid.Key(room.Floor, c)] = true -- one tendril to a room
				end
			end
		end
	end
	local spots = Boss.SourceRooms(ctx.grid:Bunker(), count, function(n: number): number
		return ctx.rng:NextInteger(1, n)
	end, taken, s.Chamber)
	local made = 0
	for _, spot in spots do
		local cell = Grid.CellPosition(spot.Floor, spot.Column)
		if raise(ctx, f, cell + Vector3.new(0, 0, -CELL_BACK), math.pi, roomName(ctx, spot), spot, holds) then
			made += 1
		end
	end
	return made
end

local function raiseInChamber(ctx: any, f: any, count: number, holds: boolean): number
	local s = stateOf(f)
	local free = {}
	for _, at in s.Sockets do
		local clear = true
		for _, tendril in s.Tendrils do
			if (tendril.At - at.Position).Magnitude < 4 then
				clear = false
			end
		end
		if clear then
			table.insert(free, at)
		end
	end
	local made = 0
	while made < count and #free > 0 do
		local at = table.remove(free, ctx.rng:NextInteger(1, #free)) :: CFrame
		local toSource = Vector3.new(f.X - at.Position.X, 0, f.Z - at.Position.Z)
		-- its back to the Source, looking out at whoever comes
		local yaw = if toSource.Magnitude > 0.5 then math.atan2(toSource.X, toSource.Z) else math.pi
		if raise(ctx, f, at.Position, yaw, "THE CHAMBER", nil, holds) then
			made += 1
		end
	end
	return made
end

local function summary(f: any): string
	local where: { [string]: number } = {}
	local order = {}
	for _, place_ in SourceFight.places(f) do
		if not where[place_] then
			where[place_] = 0
			table.insert(order, place_)
		end
		where[place_] += 1
	end
	local parts = {}
	for _, place_ in order do
		table.insert(parts, if where[place_] > 1 then `{place_} ×{where[place_]}` else place_)
	end
	return table.concat(parts, ", ")
end

-- Stages ---------------------------------------------------------------------------------------------

local function enter(ctx: any, f: any, stage: number)
	local s = stateOf(f)
	local first = s.Stage == 0
	s.Stage = stage
	s.Kind = Boss.SourceStage(stage)
	f.Phase = stage
	if s.Kind == "Tendrils" then
		local wasOpen = s.Open
		s.Open = false
		s.NextErupt = math.huge
		s.NextRegrow = math.huge
		local players = math.max(#ctx.session:ReadyPlayers(), 1)
		local total, inChamber = Boss.SourceTendrils(stage, players, s.Chamber)
		local made = raiseInChamber(ctx, f, inChamber, true)
		made += raiseInRooms(ctx, f, total - made, true)
		if not first then
			-- its lids slam shut and it roars as they come up
			local hold = (if wasOpen then t().CloseSeconds else 0) + t().RoarSeconds
			f.Busy = os.clock() + hold
			f.NextAttack = f.Busy + 1
			if wasOpen then
				ctx.setActivity("Close", true)
				task.delay(t().CloseSeconds, function()
					if ctx.current() == f and f.State == "Fighting" and stateOf(f).Stage == stage then
						ctx.setActivity("Roar", true)
					end
				end)
			else
				ctx.setActivity("Roar", true)
			end
		end
		for _ = 1, Boss.ByPhase(t().Breaches, stage) do
			local ok, err = pcall(function()
				ctx.threat:ExtraBreach()
			end)
			if not ok then
				log:Warn("extra breach: %s", tostring(err))
			end
		end
		if made > 0 then
			ctx.announce("Danger", `{Boss.Title(f.Name)} SHUTS ITS EYE · {made} TENDRILS: {summary(f)} · SPLIT UP AND CUT THEM DOWN`)
		end
		log:Info("%s stage %d: %d tendrils (%s)", f.Name, stage, made, summary(f))
	else
		s.Open = true
		f.Busy = os.clock() + t().OpenSeconds
		f.NextAttack = f.Busy + 1.5
		ctx.setActivity("Open", true)
		local every = Boss.ByPhase(t().EruptSeconds, stage)
		s.NextErupt = if every > 0 then os.clock() + t().OpenSeconds + every * 0.6 else math.huge
		local regrow = Boss.ByPhase(t().RegrowSeconds, stage)
		s.NextRegrow = if regrow > 0 then os.clock() + regrow else math.huge
		ctx.announce("Danger", `{Boss.Title(f.Name)} OPENS ITS EYE · REGROUP AND HIT THE EYE`)
		log:Info("%s stage %d: the core", f.Name, stage)
	end
	if f.Model then
		f.Model:SetAttribute("EyeOpen", s.Open)
		f.Model:SetAttribute("Stage", stage)
	end
	ctx.publish(true)
end

function SourceFight.start(ctx: any, f: any)
	enter(ctx, f, 1)
end

-- Roots ----------------------------------------------------------------------------------------------

local function floorUnder(position: Vector3, fallback: number): number
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = {}
	local monsters = workspace:FindFirstChild("Monsters")
	if monsters then
		table.insert(ignore, monsters)
	end
	for _, player in game:GetService("Players"):GetPlayers() do
		if player.Character then
			table.insert(ignore, player.Character)
		end
	end
	local residents = workspace:FindFirstChild("Residents")
	if residents then
		table.insert(ignore, residents)
	end
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(position, Vector3.new(0, -14, 0), params)
	return if hit then hit.Position.Y else fallback
end

local function rootMark(ctx: any, f: any, at: Vector3)
	local s = stateOf(f)
	local radius = t().EruptRadius
	local mark = ctx.effectPart(at + Vector3.new(0, 0.15, 0), "RootMark")
	mark.Size = Vector3.new(radius * 2, 0.3, radius * 2)
	mark:SetAttribute("Radius", radius)
	mark:SetAttribute("LandsAt", ctx.now() + t().EruptWarnSeconds)
	table.insert(s.Marks, mark)
	task.delay(t().EruptWarnSeconds, function()
		if ctx.current() ~= f or not mark.Parent or f.State ~= "Fighting" then
			mark:Destroy()
			return
		end
		local centre = mark.Position
		local hit = 0
		for _, c in ctx.combat:All("Survivors") do
			local offset = c.Root.Position - centre
			if c.State == "Alive" and Vector3.new(offset.X, 0, offset.Z).Magnitude <= radius + c.Reach and math.abs(offset.Y) < 9 then
				if f.CombatId and ctx.combat:Damage(c.Id, t().EruptDamage, f.CombatId, "root") > 0 then
					hit += 1
				end
			end
		end
		ctx.rockBurst(centre, 12, f)
		mark:SetAttribute("Landed", true)
		task.delay(0.9, function()
			mark:Destroy()
		end)
		if hit > 0 then
			log:Debug("a root hit %d", hit)
		end
	end)
end

function SourceFight.erupt(ctx: any, f: any): number
	local s = stateOf(f)
	local origin = Vector3.new(f.X, f.Y, f.Z)
	local players, others = {}, {}
	for _, c in ctx.combat:All("Survivors") do
		local offset = c.Root.Position - origin
		if c.State == "Alive" and offset.Magnitude <= t().EruptRange and math.abs(offset.Y) < 22 then
			table.insert(if c.Kind == "Player" then players else others, c)
		end
	end
	local count = Boss.ByPhase(t().Eruptions, s.Stage)
	if count <= 0 then
		count = 2 -- asked for outside a Core stage (DevTools)
	end
	local made = 0
	for _, list in { players, others } do
		while made < count and #list > 0 do
			local c = table.remove(list, ctx.rng:NextInteger(1, #list))
			local p = c.Root.Position
			local at = Vector3.new(p.X + ctx.rng:NextNumber(-1.5, 1.5), 0, p.Z + ctx.rng:NextNumber(-1.5, 1.5))
			rootMark(ctx, f, Vector3.new(at.X, floorUnder(p, p.Y - 3), at.Z))
			made += 1
		end
	end
	return made
end

function SourceFight.regrow(ctx: any, f: any): boolean
	local s = stateOf(f)
	local made = 0
	if s.Chamber then
		made = raiseInChamber(ctx, f, 1, false)
	end
	if made == 0 then
		made = raiseInRooms(ctx, f, 1, false)
	end
	if made > 0 then
		ctx.announce("Danger", `A TENDRIL GROWS BACK: {summary(f)}`)
		ctx.publish(true)
	end
	return made > 0
end

-- Each tick -------------------------------------------------------------------------------------------

local function nearest(ctx: any, tendril: Tendril, range: number): (any?, number)
	local best, bestDistance = nil, math.huge
	for _, c in ctx.combat:All("Survivors") do
		local offset = c.Root.Position - tendril.At
		local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
		if c.State == "Alive" and flat <= range and math.abs(offset.Y) < 9 and flat < bestDistance then
			best, bestDistance = c, flat
		end
	end
	return best, bestDistance
end

local function strike(ctx: any, f: any, tendril: Tendril, room: boolean)
	local model = tendril.Model
	local hitTime = (model:GetAttribute("HitTime") :: number?) or 0.55
	model:SetAttribute("Activity", "Attack")
	model:SetAttribute("AttackAt", ctx.now())
	tendril.Busy = os.clock() + hitTime + 0.75
	tendril.NextAttack = os.clock() + t().TendrilAttackSeconds
	task.delay(hitTime, function()
		if ctx.current() ~= f or stateOf(f).Tendrils[tendril.Id] ~= tendril or not model.Parent then
			return
		end
		local at = ctx.socket(model, "Slam").Position
		if model:GetAttribute("Socket_Slam") == nil then
			at = (model:GetPivot() * CFrame.new(0, 0, -7)).Position
		end
		local hit = 0
		for _, c in ctx.combat:All("Survivors") do
			local offset = c.Root.Position - at
			if c.State == "Alive" and Vector3.new(offset.X, 0, offset.Z).Magnitude <= t().TendrilRadius + c.Reach and math.abs(offset.Y) < 9 then
				local amount = if c.Kind == "Player" then t().TendrilDamage else t().TendrilResidentDamage
				if ctx.combat:Damage(c.Id, amount, tendril.Id, "slammed") > 0 then
					hit += 1
				end
			end
		end
		if room and hit == 0 and tendril.RoomId then
			local r = ctx.grid:Room(tendril.RoomId)
			if r and r.HP > 0 then
				ctx.grid:SetHP(tendril.RoomId, math.max(r.HP - t().TendrilRoomDamage, 0))
			end
		end
		ctx.rockBurst(at, 5, f)
	end)
end

local function tickTendril(ctx: any, f: any, tendril: Tendril)
	if os.clock() < tendril.Busy then
		return
	end
	local model = tendril.Model
	if not tendril.Up then
		tendril.Up = true
	end
	local target, distance = nearest(ctx, tendril, t().TendrilSense)
	if os.clock() >= tendril.NextAttack then
		if target and distance <= t().TendrilReach then
			-- someone in reach: it waits until it has turned to them
			local offset = target.Root.Position - tendril.At
			local want = math.atan2(-offset.X, -offset.Z)
			local delta = (want - tendril.Yaw + math.pi) % (math.pi * 2) - math.pi
			if math.abs(delta) < math.rad(28) then
				strike(ctx, f, tendril, false)
				return
			end
		elseif tendril.RoomId then
			strike(ctx, f, tendril, true) -- nobody in reach: the room takes it
			return
		end
	end
	if model:GetAttribute("Activity") ~= "Idle" then
		model:SetAttribute("Activity", "Idle")
	end
end

function SourceFight.tick(ctx: any, f: any, _dt: number)
	local s = stateOf(f)
	if s.Stage == 0 or not f.CombatId then
		return
	end
	for _, tendril in table.clone(s.Tendrils) do
		tickTendril(ctx, f, tendril)
	end
	local health, max = ctx.combat:HealthOf(f.CombatId)
	if s.Kind == "Tendrils" then
		local holds = SourceFight.counts(f)
		if holds == 0 and os.clock() >= f.Busy then
			enter(ctx, f, math.min(s.Stage + 1, #t().Stages))
		end
		return
	end
	if Boss.SourceCoreOver(health, max, s.Stage) and os.clock() >= f.Busy then
		enter(ctx, f, s.Stage + 1)
		return
	end
	if os.clock() >= s.NextErupt then
		s.NextErupt = os.clock() + Boss.ByPhase(t().EruptSeconds, s.Stage)
		SourceFight.erupt(ctx, f)
	end
	if os.clock() >= s.NextRegrow then
		s.NextRegrow = os.clock() + Boss.ByPhase(t().RegrowSeconds, s.Stage)
		local _, all = SourceFight.counts(f)
		if all < t().RegrowMax then
			SourceFight.regrow(ctx, f)
		end
	end
end

-- Every frame: tendrils come up out of the floor and turn to whoever is near (an anchored model
-- isn't smoothed between server ticks).
function SourceFight.frame(ctx: any, f: any, dt: number)
	local s = f.Source :: State?
	if not s then
		return
	end
	for _, tendril in s.Tendrils do
		local age = os.clock() - tendril.BornAt
		local rising = age < RISE_SECONDS
		if not rising and tendril.Up and os.clock() >= tendril.Busy then
			local target = nearest(ctx, tendril, t().TendrilSense)
			if target then
				local offset = target.Root.Position - tendril.At
				local want = math.atan2(-offset.X, -offset.Z)
				local delta = (want - tendril.Yaw + math.pi) % (math.pi * 2) - math.pi
				local step = math.rad(t().TendrilTurnDegreesPerSecond) * dt
				tendril.Yaw += math.clamp(delta, -step, step)
			end
		end
		if rising then
			local k = math.clamp(age / RISE_SECONDS, 0, 1)
			place(tendril, t().TendrilRiseDepth * (1 - k) * (1 - k))
		elseif math.abs(tendril.Yaw - tendril.Shown) > math.rad(0.5) or tendril.Model:GetPivot().Position.Y < tendril.At.Y - 0.01 then
			place(tendril, 0)
		end
	end
end

-- Hits and deaths -------------------------------------------------------------------------------------

function SourceFight.onDamaged(f: any, id: string, source: string?)
	local s = f.Source :: State?
	if s and source and s.Tendrils[id] then
		s.LastBy[id] = source
	end
end

function SourceFight.onDied(ctx: any, f: any, id: string): boolean
	local s = f.Source :: State?
	local tendril = if s then s.Tendrils[id] else nil
	if not s or not tendril then
		return false
	end
	local holdsBefore = SourceFight.counts(f)
	s.Tendrils[id] = nil
	local by = s.LastBy[id]
	s.LastBy[id] = nil
	ctx.rockBurst(tendril.At, 10, f)
	if tendril.Holds and s.Kind == "Tendrils" and f.CombatId and f.State == "Fighting" then
		local health, max = ctx.combat:HealthOf(f.CombatId)
		local wound = Boss.SourceWound(health, max, s.Stage, holdsBefore)
		if wound >= 1 then
			ctx.combat:Damage(f.CombatId, wound, by, "tendril")
		end
		local left = holdsBefore - 1
		if left > 0 then
			ctx.announce("Info", `A TENDRIL IS CUT DOWN · {left} LEFT: {summary(f)}`)
		else
			ctx.announce("Info", "THE LAST TENDRIL IS CUT DOWN")
		end
	end
	ctx.publish(true)
	return true
end

function SourceFight.skip(ctx: any, f: any): number
	local s = stateOf(f)
	local n = 0
	for id in table.clone(s.Tendrils) do
		ctx.combat:Damage(id, 1e9, nil, "dev")
		n += 1
	end
	return n
end

-- Its tendrils go with it: wither (it died) dissolves them where they stand.
function SourceFight.cleanup(ctx: any, f: any, _wither: boolean?)
	local s = f.Source :: State?
	if not s then
		return
	end
	for id, tendril in table.clone(s.Tendrils) do
		s.Tendrils[id] = nil
		ctx.combat:Unregister(id)
		if tendril.Model.Parent then
			ctx.combat:Dissolve(tendril.Model)
		end
	end
	for _, mark in s.Marks do
		mark:Destroy()
	end
	table.clear(s.Marks)
	s.NextErupt = math.huge
	s.NextRegrow = math.huge
end

return SourceFight
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000116"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000000F5"><Properties><string name="Name">BossService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BossService: boss fights (bible Sections 5, 10 and 22). Run place only; Prompt 15 brings the
	Era I boss, the Brood Mother, Prompt 23 the Era II boss, The Deluge, Prompt 24 the Era III
	boss, the Crystal Colossus, Prompt 25 the Source. The arithmetic is
	Shared.Rules.Boss; the numbers are Config.Bosses, Tuning.Bosses and Tuning.<BossId> (provisional).

	* A boss Surge (CycleClock.SurgeStarted with kind Boss) starts its boss's fight. Section 5: the
	  Surge has no timer and ends when the boss dies (ObjectiveService:BossBeaten, which also adds
	  1 to Years per Cycle).
	* Arrival (Section 10: the Brood Mother bursts up through the deepest tunnel): the arena is
	  Rules.Boss.Arena. Cracks, dust, a red light and an alert give ArrivalWarningSeconds of
	  warning; then she rises out of the floor in a burst of rock and roars.
	* Health: Rules.Boss.Health (the team's size; weaker on an account's first run, Section 22).
	  Hits on her armour do ArmourMultiplier; hits on her glowing belly (the model's WeakPoint part)
	  WeakPointMultiplier, the Sharpshooter's own if they have it (WeaponService:SetHitModifier;
	  such hits are Damaged with how "weakpoint").
	* The fight, ticked every TickSeconds while she lives:
	  - she turns to the nearest standing player and walks along her arena towards them (she is
	    too big for a doorway, so she never leaves it);
	  - within SlamReach she rears and slams (the Attack clip's HitTime): SlamDamage to players and
	    residents within SlamRadius of the blow;
	  - every LaySeconds she lays SacsPerLay egg sacs behind her (her Ovipositor socket), up to
	    MaxSacs; a sac (SacHealth; fire does BurnMultiplier) hatches HatchCount Burrow Ticks after
	    HatchSeconds unless it is broken or burned first;
	  - StaggerFraction of her health dealt to her belly within StaggerWindowSeconds staggers her
	    for StaggerSeconds;
	  - each new phase (Config.Bosses' Phases) she roars, lays more often and moves faster.
	* Death: the Death clip, her sacs wither, BossBeaten ends the Surge, Defeated fires; after
	  DeathSeconds she dissolves.
	* The Deluge (Section 10: "A giant eel surging up the flooded tunnels. Floods every room it
	  passes; strike its head when it surfaces and drain the rooms behind it."; Tuning.Deluge). It
	  arrives like any boss, in Rules.Boss.Arena, but it doesn't stay there. The fight's Mode:
	  - Up: it stands out of the floor, turns to whoever is near and bites (the Attack clip's
	    HitTime: BiteDamage within BiteRadius of its Bite socket). Its head is the model's WeakPoint
	    part; enough damage to it staggers it. After SurfaceSeconds (sooner with nobody near for
	    AloneSeconds) it dives;
	  - Diving, Swim: it sinks SwimDepth so only its back fin cuts the floor (hits on it do
	    SubmergedMultiplier), and swims Rules.Bunker.CellPath to the nearest standing player it can
	    reach, re-aimed at every cell, for at most SwimSeconds. Every room it passes bursts a pipe
	    and takes FloodLevel of water (DisasterService:StartFlood, cause "Deluge"; the Shaft takes the
	    water but has no pipe): patching those pipes is "drain the rooms behind it";
	  - Surfacing: it comes up where it is (never in a Shaft), and from its second phase Murklings
	    pour out with it (Config.Bosses' Minions).
	  It moves every frame (an anchored model isn't smoothed between server ticks); it decides every
	  TickSeconds like the Brood Mother.
	* The Crystal Colossus (Prompt 24; Section 10: "Tears out of the crystal rock. Huge, slow and
	  armored; flares show its weak points; its shards stun."; Tuning.CrystalColossus). It strides
	  out of the rock behind its arena's back wall and walks its arena like the Brood Mother, slower.
	  Every hit does its ArmourMultiplier until its cores are Lit: a flare, a lamp or the Scout's
	  Flare Ping within reach (parts tagged RevealLight; MonsterService:Lit), or its own charge for
	  FlashSeconds as it throws its shards. Lit, its cores (the model's WeakPoint parts) glow and a
	  hit on one is a weak-point hit. It slams like the Brood Mother (its Slam socket). Every
	  VolleySeconds it throws Shards crystal shards: each has a mark on the floor (a ShardMark part
	  in workspace.Monsters with Radius and LandsAt, which clients draw) and lands ShardWarnSeconds
	  later for ShardDamage and a stun (players: the StunnedUntil attribute, which stops their
	  movement and their hands; residents are slowed); from its second phase Shardlings crawl out
	  of the first Shardlings of them.

	* The Source (Prompt 25; Section 10: "Rises into the bunker, or is fought earlier in its chamber at
	  depth 10. Several phases: tendrils in many rooms at once, then the core, so the team has to
	  split up and regroup."; Tuning.Source; its stages, tendrils and roots are Lib.SourceFight).
	  - In the bunker: the final Surge (CycleClock's kind Final) starts its fight like an era
	    boss's: it rises through the floor of Rules.Boss.Arena and never walks. Beating it ends the
	    final Surge (ObjectiveService:BossBeaten), which is the Century Victory (CycleClock,
	    RunDirector).
	  - In its chamber: when the Source Chamber opens (DeepService.CaveOpened, band SourceChamber)
	    it is there asleep on the piece's Core socket (a model with the Asleep attribute; no fight,
	    so an era boss can still come). It wakes when a player comes within WakeRange or hurts it:
	    the same fight, its tendrils round it and in the deepest rooms. Killing it there is the
	    Deep Victory: RunDirector:Win("Deep") at once (Section 5), whatever the year.
	  - Left asleep until the final Surge, it sinks out of its chamber and rises in the bunker.
	  - Its eye (the model's WeakPoint part) is shut in a Tendrils stage: every hit does
	    ClosedMultiplier. Open, the eye is the weak point and the rest armour.
	* Two bosses never fight at once. A boss whose Surge starts while another fight is on (the
	  Source woken in its chamber) waits, and comes when that fight is over.

	Replication: the Boss collection, "Fight" -> { Id, Name, Health, Max, Phase, Phases, State,
	At = { X, Y, Z } (where it breaks in; The Deluge: where it is), ArriveAt (server time), Sacs,
	Mode (The Deluge: Up, Diving, Swim, Surfacing), Lit (the Crystal Colossus: its cores show),
	Stage ("Tendrils" | "Core"), Tendrils (how many still hold the stage), Places (where they
	stand), Rooms (those rooms' ids) and Chamber (the Source) } while a fight is on.
	The model is in workspace.Monsters with Rig, Activity and AttackAt attributes. Unlike other
	monsters (Section 23: clips play on clients), her clips play here on the server and replicate
	(ServerAnimated, which NPCAnimator skips): one model, and the server must see her belly where
	players see it when it judges a hit.

	API:
		BossService:BeginFight(bossId): (boolean, string?) -- a fight now (CycleClock's boss Surge; DevTools)
		BossService:Active(): string?
		BossService:Stun(combatId, why): boolean       -- Prompt 20: crits and explosions of the class levels
		BossService:IsBoss(combatId): boolean           -- the boss itself, not an egg sac
		BossService:IsEggSac(combatId): boolean         -- one of its egg sacs (a broken sac isn't a kill)
		BossService.Started: Signal<string>             -- bossId
		BossService.Defeated: Signal<string, Player?>   -- bossId, who struck the last blow
		BossService:Sleeping(): boolean                 -- the Source is asleep in its chamber
	Dev: boss, boss.start, boss.hurt, boss.lay, boss.freeze, boss.end, boss.dive, boss.surface,
	boss.volley, boss.light, boss.wake, boss.tendrils, boss.cut, boss.roots, boss.regrow, boss.stage.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Boss = require(Shared.Rules.Boss)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)
local SourceFight = require(ServerScriptService.Lib.SourceFight)

local log = Log.new("BossService")

local BossService = {
	Name = "BossService",
	Dependencies = {
		"CycleClock", "RunDirector", "BunkerGrid", "SessionService", "CombatService", "MonsterService", "WeaponService",
		"ObjectiveService", "ThreatDirector", "DisasterService", "DeepService", "ReplicationService", "DevService",
	},
	Started = Signal.new() :: Signal.Signal<string>,
	Defeated = Signal.new() :: Signal.Signal<string, Player?>,
}

local RISE_DEPTH = 13 -- how far under the floor she starts
local DELUGE_RISE_DEPTH = 15 -- The Deluge stands 14.5 studs to the tips of its hood
local SOURCE_RISE_DEPTH = 15 -- the Source stands 14 studs to the tips of its crown
local SLEEP_HEALTH = 1e9 -- asleep it only has to notice being hurt
local HATCH_TAG_PREFIX = "Boss:"

-- How each boss's arrival and glow look, and the words for it. Water: its bursts are water, not rock.
local LOOK: { [string]: {
	Glow: Color3, GlowAt: Vector3, GlowRange: number, GlowBrightness: number, -- its own light, about its pivot
	Dust: Color3, Chips: Color3, Water: boolean, Clips: { string }, Up: string, Phase: string,
} } = {
	BroodMother = {
		Glow = Color3.fromRGB(124, 255, 155), GlowAt = Vector3.new(0, 10, 2), GlowRange = 24, GlowBrightness = 1.2,
		Dust = Color3.fromRGB(140, 128, 112), Chips = Color3.fromRGB(70, 64, 58), Water = false,
		Clips = { "Idle", "Walk", "Attack", "LayEggs", "Stagger", "Death" },
		Up = "BREAKS THROUGH! HIT HER GLOWING BELLY, BREAK HER EGG SACS",
		Phase = "SHRIEKS: SHE LAYS FASTER AND HITS HARDER",
	},
	Deluge = {
		-- in front of its face and low, so the players it looks down at see what is looking
		Glow = Color3.fromRGB(150, 232, 226), GlowAt = Vector3.new(0, 7, -10), GlowRange = 40, GlowBrightness = 2.6,
		Dust = Color3.fromRGB(150, 196, 204), Chips = Color3.fromRGB(196, 232, 238), Water = true,
		Clips = { "Idle", "Swim", "Attack", "Stagger", "Death" },
		Up = "SURFACES! STRIKE ITS HEAD WHEN IT IS UP, PATCH THE PIPES IT BURSTS",
		Phase = "ROARS: IT SWIMS FASTER AND BRINGS MORE WITH IT",
	},
	CrystalColossus = {
		Glow = Color3.fromRGB(143, 227, 224), GlowAt = Vector3.new(0, 8, -6), GlowRange = 34, GlowBrightness = 1.8,
		Dust = Color3.fromRGB(150, 132, 160), Chips = Color3.fromRGB(176, 238, 234), Water = false,
		Clips = { "Idle", "Walk", "Attack", "Volley", "Stagger", "Death" },
		Up = "TEARS OUT OF THE ROCK! LIGHT IT WITH A FLARE, THEN HIT ITS GLOWING CORES",
		Phase = "CRACKS: MORE SHARDS, AND SHARDLINGS CRAWL OUT OF THEM",
	},
	Source = {
		-- in front of its eye, so whoever it looks at sees what is looking
		Glow = Color3.fromRGB(124, 255, 155), GlowAt = Vector3.new(0, 7, -10), GlowRange = 44, GlowBrightness = 1.5,
		Dust = Color3.fromRGB(96, 70, 92), Chips = Color3.fromRGB(124, 255, 155), Water = false,
		Clips = { "Idle", "Open", "OpenIdle", "Close", "Attack", "Slam", "Roar", "Stagger", "Death" },
		Up = "RISES INTO THE BUNKER!",
		Phase = "", -- its stages have their own words (Lib.SourceFight)
	},
}

-- Where a boss starts from as it arrives, from where it will stand: under the floor, or (the
-- Crystal Colossus: "Tears out of the crystal rock") inside the rock behind its cell's back wall.
local EMERGE: { [string]: Vector3 } = {
	BroodMother = Vector3.new(0, -RISE_DEPTH, 0),
	Deluge = Vector3.new(0, -DELUGE_RISE_DEPTH, 0),
	CrystalColossus = Vector3.new(0, 0, -22),
	Source = Vector3.new(0, -SOURCE_RISE_DEPTH, 0),
}

type Sac = { CombatId: string, Model: Model, HatchAt: number }
type Fight = {
	BossId: string,
	Name: string,
	T: { [string]: any },
	Arena: Boss.Arena,
	Left: number,
	Right: number,
	X: number,
	Y: number,
	Z: number,
	Yaw: number,
	Model: Model?,
	Root: BasePart?,
	CombatId: string?,
	Max: number,
	Phase: number,
	State: string, -- "Warning" | "Rising" | "Fighting" | "Dying"
	ArriveAt: number,
	Busy: number,
	NextAttack: number,
	NextLay: number,
	Sacs: { [string]: Sac },
	Hits: { { At: number, Amount: number } },
	LastHitBy: string?,
	PublishedAt: number,
	Sent: string,
	Effects: { Instance },
	Tracks: { [string]: AnimationTrack },
	Playing: AnimationTrack?,
	-- The Deluge
	Mode: string, -- "" | "Up" | "Diving" | "Swim" | "Surfacing"
	ModeUntil: number,
	SwimFrom: number,
	Sink: number, -- studs under the floor
	Floor: number,
	Column: number,
	Path: { { number } },
	PathIndex: number,
	Passed: { [string]: boolean }, -- rooms flooded on this swim
	Face: Vector3?,
	AloneSince: number?,
	Roar: boolean, -- a phase began under water: it roars as it comes up
	Wake: Part?,
	-- The Crystal Colossus
	Lit: boolean, -- its cores show (a flare, a lamp, its own charge)
	LitUntil: number, -- shown until then whatever the light (os.clock)
	NextVolley: number,
	WantX: number,
	Moving: boolean,
	-- The Source
	Source: SourceFight.State?,
	Chamber: boolean, -- fought in its chamber: its death is the Deep Victory
}

-- The Source asleep in its chamber (no fight yet).
type Sleeper = { Model: Model, Root: BasePart, At: CFrame, CombatId: string?, Sockets: { CFrame }, Idle: AnimationTrack? }

local clock: any = nil
local director: any = nil
local grid: any = nil
local session: any = nil
local combat: any = nil
local monsters: any = nil
local weapons: any = nil
local objectives: any = nil
local threat: any = nil
local disasters: any = nil
local deep: any = nil
local collection: any = nil
local rng = Random.new()

local fight: Fight? = nil
local sleeper: Sleeper? = nil
local chamberEmpty = false -- the Source has left its chamber or died: nothing sleeps there again
local waiting: string? = nil -- a boss whose Surge started while another fight was on
local sourceCtx: any = nil
local sacIds: { [string]: boolean } = {} -- every egg sac's combatant id this run (ids aren't reused)

-- Helpers --------------------------------------------------------------------------------------------

local function now(): number
	return workspace:GetServerTimeNow()
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function holder(): Instance
	local f = workspace:FindFirstChild("Monsters")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Monsters"
		f.Parent = workspace
	end
	return f :: Instance
end

local function art(asset: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local bosses = assets and assets:FindFirstChild("Bosses")
	local found = bosses and bosses:FindFirstChild(asset)
	return if found and found:IsA("Model") then found else nil
end

local function socket(model: Model, name: string): CFrame
	local value = model:GetAttribute(`Socket_{name}`)
	return model:GetPivot() * (if typeof(value) == "CFrame" then value else CFrame.identity)
end

local function loadClip(animator: Animator, rig: string, activity: string): AnimationTrack?
	for _, clip in Config.All("Animations") do
		if clip.Rig == rig and clip.Activity == activity then
			local animation = Instance.new("Animation")
			animation.AnimationId = clip.AssetId
			local ok, loaded = pcall(function()
				return animator:LoadAnimation(animation)
			end)
			if ok and loaded then
				loaded.Looped = clip.Looped
				return loaded
			end
			log:Warn("couldn't load the %s %s clip: %s", rig, activity, tostring(loaded))
		end
	end
	return nil
end

-- Her clips, played here (see the header); Config.Animations' clips for her Rig.
local function track(f: Fight, activity: string): AnimationTrack?
	local cached = f.Tracks[activity]
	if cached then
		return cached
	end
	local model = f.Model
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return nil
	end
	local loaded = loadClip(animator, f.BossId, activity)
	if loaded then
		f.Tracks[activity] = loaded
	end
	return loaded
end

local function play(f: Fight, activity: string, restart: boolean?)
	local wanted = track(f, activity)
	if f.Playing and f.Playing ~= wanted then
		f.Playing:Stop(0.2)
		f.Playing = nil
	end
	if wanted and (restart or not wanted.IsPlaying) then
		wanted:Play(0.15)
		f.Playing = wanted
	end
end

local function setActivity(activity: string, restart: boolean?)
	local f = fight
	if not f or not f.Model then
		return
	end
	if f.Model:GetAttribute("Activity") ~= activity or restart then
		f.Model:SetAttribute("Activity", activity)
		play(f, activity, restart)
	end
end

local function pivot(f: Fight): CFrame
	return CFrame.new(f.X, f.Y - f.Sink, f.Z) * CFrame.Angles(0, f.Yaw, 0)
end

local function look(f: Fight)
	return LOOK[f.BossId] or LOOK.BroodMother
end

local function where(arena: Boss.Arena): string
	return `FLOOR {arena.Floor} · COLUMN {Boss.ArenaMiddle(arena)}`
end

local function publish(force: boolean?)
	local f = fight
	if not f then
		collection:Remove("Fight")
		return
	end
	local health = 0
	if f.CombatId then
		health = (combat:HealthOf(f.CombatId))
	elseif f.State == "Warning" or f.State == "Rising" then
		health = f.Max
	end
	local count = 0
	for _ in f.Sacs do
		count += 1
	end
	local holds, places = 0, nil
	if f.Source then
		holds = (SourceFight.counts(f))
		places = SourceFight.places(f)
	end
	local sent = `{math.ceil(health)}|{f.Phase}|{f.State}|{count}|{f.Mode}|{f.Floor}|{f.Column}|{f.Lit}|{holds}|{if places then table.concat(places, ";") else ""}|{SourceFight.open(f)}`
	if not force and (sent == f.Sent or os.clock() - f.PublishedAt < Boss.Tuning().PublishSeconds) then
		return
	end
	f.Sent = sent
	f.PublishedAt = os.clock()
	local at = Grid.CellPosition(f.Arena.Floor, Boss.ArenaMiddle(f.Arena))
	collection:Set("Fight", {
		Id = f.BossId,
		Name = f.Name,
		Health = math.ceil(health),
		Max = f.Max,
		Phase = f.Phase,
		Phases = Config.Get("Bosses", f.BossId).Phases,
		State = f.State,
		At = { X = f.X, Y = if f.Mode ~= "" or f.Chamber then f.Y else at.Y, Z = f.Z },
		ArriveAt = f.ArriveAt,
		Sacs = count,
		Mode = if f.Mode ~= "" then f.Mode else nil,
		Lit = if f.BossId == "CrystalColossus" then f.Lit else nil,
		Stage = if f.Source and f.Source.Stage > 0 then f.Source.Kind else nil,
		Tendrils = if f.Source then holds else nil,
		Places = places,
		Rooms = if f.Source then SourceFight.rooms(f) else nil,
		Chamber = if f.Chamber then true else nil,
	})
end

-- Effects ---------------------------------------------------------------------------------------------

local function effectPart(at: Vector3, name: string): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(14, 1, 14)
	part.CFrame = CFrame.new(at)
	part.Parent = holder()
	return part
end

local function rockBurst(at: Vector3, chips: number, f: Fight?)
	local colours = if f then LOOK[f.BossId] or LOOK.BroodMother else LOOK.BroodMother
	local part = effectPart(at + Vector3.new(0, 0.5, 0), "BossBurst")
	part:SetAttribute("Water", colours.Water)
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(colours.Dust)
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 12) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(1.5, 3)
	dust.Speed = NumberRange.new(8, 18)
	dust.SpreadAngle = Vector2.new(70, 70)
	dust.Acceleration = Vector3.new(0, -4, 0)
	dust.Rate = 0
	dust.Parent = part
	local rocks = Instance.new("ParticleEmitter")
	rocks.Color = ColorSequence.new(colours.Chips)
	rocks.Size = NumberSequence.new(if colours.Water then 0.35 else 0.6)
	rocks.Lifetime = NumberRange.new(1, 1.6)
	rocks.Speed = NumberRange.new(20, 34)
	rocks.SpreadAngle = Vector2.new(45, 45)
	rocks.Acceleration = Vector3.new(0, -60, 0)
	rocks.Rate = 0
	rocks.Parent = part
	dust:Emit(60)
	rocks:Emit(chips)
	task.delay(4, function()
		part:Destroy()
	end)
end

-- Cracks, dust and a blinking red light where she will break in (like a breach's warning).
local function warning(f: Fight, seconds: number)
	local at = Vector3.new(f.X, f.Y + 0.2, f.Z)
	local part = effectPart(at, "BossWarning")
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(look(f).Dust)
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(1.2, 2.4)
	dust.Speed = NumberRange.new(1, 4)
	dust.SpreadAngle = Vector2.new(90, 90)
	dust.Rate = 18
	dust.Parent = part
	local light = Instance.new("PointLight")
	light.Color = if look(f).Water then Color3.fromRGB(70, 150, 232) else Color3.fromRGB(232, 80, 59)
	light.Range = 26
	light.Brightness = 2
	light.Parent = part
	table.insert(f.Effects, part)
	task.spawn(function()
		local endsAt = os.clock() + seconds
		while os.clock() < endsAt and part.Parent do
			dust.Rate = 18 + 40 * (1 - (endsAt - os.clock()) / seconds)
			light.Brightness = if light.Brightness > 1 then 0.4 else 3
			task.wait(0.4)
		end
		part:Destroy()
	end)
end

-- The fight's model ---------------------------------------------------------------------------------

local function graybox(bossId: string): Model
	local model = Instance.new("Model")
	model.Name = bossId
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(5, 4, 7)
	root.Transparency = 1
	root.Anchored = true
	root.Parent = model
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(16, 8, 18)
	body.Color = Color3.fromHex("#403B37")
	body.CFrame = CFrame.new(0, 5, 0)
	body.CanCollide = false
	body.Parent = model
	local belly = Instance.new("Part")
	belly.Name = "Belly"
	belly.Size = Vector3.new(6, 3, 8)
	belly.Color = Color3.fromHex("#7CFF9B")
	belly.Material = Enum.Material.Neon
	belly.CFrame = CFrame.new(0, 2.5, 5)
	belly.CanCollide = false
	belly:SetAttribute("Role", "WeakPoint")
	belly.Parent = model
	root.CFrame = CFrame.new(0, 4.95, 0)
	for _, part in { body, belly } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid
	model.PrimaryPart = root
	root.PivotOffset = CFrame.new(0, -4.95, 0)
	model:SetAttribute("Graybox", true)
	return model
end

-- The Deluge before its art: a neck standing out of the floor, a head (its weak point), a back fin.
local function grayboxEel(bossId: string): Model
	local model = Instance.new("Model")
	model.Name = bossId
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(5, 4, 5)
	root.Transparency = 1
	root.Anchored = true
	root.CFrame = CFrame.new(0, 4, 0)
	root.Parent = model
	local function block(name: string, size: Vector3, at: Vector3, colour: string, weak: boolean)
		local part = Instance.new("Part")
		part.Name = name
		part.Size = size
		part.Color = Color3.fromHex(colour)
		part.Material = if weak then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part.CFrame = CFrame.new(at)
		part.CanCollide = false
		if weak then
			part:SetAttribute("Role", "WeakPoint")
		end
		part.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
	end
	block("Neck", Vector3.new(5, 12, 5), Vector3.new(0, 4, 0), "#2F4A52", false)
	block("Head", Vector3.new(5, 4, 8), Vector3.new(0, 11, -2), "#58D6E8", true)
	block("Fin", Vector3.new(0.6, 5, 14), Vector3.new(0, 11.5, 8), "#3B6A72", false)
	block("Back", Vector3.new(5, 5, 16), Vector3.new(0, 6.5, 9), "#2F4A52", false)
	local humanoid = Instance.new("Humanoid")
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid
	model.PrimaryPart = root
	root.PivotOffset = CFrame.new(0, -4, 0)
	model:SetAttribute("Graybox", true)
	return model
end

local function makeModel(bossId: string): (Model, BasePart)
	local entry = Config.Get("Bosses", bossId)
	local template = art(entry.Asset)
	local model = if template then template:Clone() elseif bossId == "Deluge" then grayboxEel(bossId) else graybox(bossId)
	local colours = LOOK[bossId] or LOOK.BroodMother
	model.Name = bossId
	local root = (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart) :: BasePart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanTouch = false
			part.Anchored = part == root
		end
	end
	-- Her invisible root box mustn't catch shots meant for her belly (a part that collides is
	-- always queryable, so it stops colliding too: players can step under her).
	root.CanCollide = false
	root.CanQuery = false
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
		humanoid.MaxHealth = math.huge -- CombatService keeps her health; the Humanoid only animates
		humanoid.Health = math.huge
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		humanoid.PlatformStand = true
	end
	-- Her glow lights the tunnel around her, so her body reads in the dark (the art has no lights).
	local glowAt = Instance.new("Attachment")
	glowAt.Name = "BossGlow"
	glowAt.Position = root.CFrame:PointToObjectSpace(model:GetPivot() * colours.GlowAt)
	glowAt.Parent = root
	local glow = Instance.new("PointLight")
	glow.Color = colours.Glow
	glow.Range = colours.GlowRange
	glow.Brightness = colours.GlowBrightness
	glow.Shadows = false
	glow.Parent = glowAt
	model:SetAttribute("Rig", bossId)
	model:SetAttribute("MonsterType", bossId)
	model:SetAttribute("Boss", bossId)
	model:SetAttribute("Activity", "Roar")
	model:SetAttribute("ServerAnimated", true) -- NPCAnimator leaves her to the server
	return model, root
end

local function weakParts(model: Model): { BasePart }
	local list = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("Role") == "WeakPoint" then
			table.insert(list, part)
		end
	end
	return list
end

-- Egg sacs ---------------------------------------------------------------------------------------------

local function removeSac(f: Fight, id: string, how: string)
	local sac = f.Sacs[id]
	if not sac then
		return
	end
	f.Sacs[id] = nil
	if how ~= "Broken" then -- a broken sac is dissolved by CombatService
		combat:Unregister(sac.CombatId)
		if sac.Model.Parent then
			combat:Dissolve(sac.Model)
		end
	end
	publish(true)
end

local function sacModel(): Model
	local template = art("Boss_BroodMother_EggSac")
	if template then
		return template:Clone()
	end
	local model = Instance.new("Model")
	model.Name = "EggSac"
	local mound = Instance.new("Part")
	mound.Name = "Mound"
	mound.Size = Vector3.new(3.6, 1, 3.2)
	mound.Color = Color3.fromHex("#6E4766")
	mound.Parent = model
	local eggs = Instance.new("Part")
	eggs.Name = "Eggs"
	eggs.Shape = Enum.PartType.Ball
	eggs.Size = Vector3.new(2.4, 2.4, 2.4)
	eggs.Material = Enum.Material.Neon
	eggs.Color = Color3.fromHex("#7CFF9B")
	eggs.CFrame = CFrame.new(0, 1.2, 0)
	eggs.Parent = model
	model.PrimaryPart = mound
	mound.CFrame = CFrame.new(0, 0.5, 0)
	model.WorldPivot = CFrame.identity
	return model
end

local function laySac(f: Fight, at: Vector3)
	local model = sacModel()
	local x = math.clamp(at.X, f.Left - f.T.ArenaMargin + 3, f.Right + f.T.ArenaMargin - 3)
	local z = math.clamp(at.Z, f.Z - 11, f.Z + 11)
	model:PivotTo(CFrame.new(x, f.Y, z) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	local root: BasePart? = nil
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanTouch = false
			if part.Name == "Mound" or (not root and part.CanQuery) then
				root = part
			end
		end
	end
	model.Name = "EggSac"
	model:SetAttribute("Boss", f.BossId)
	model.Parent = holder()
	local id = combat:Register(model, {
		Kind = "Monster", Team = "Monsters", Health = f.T.SacHealth, MonsterType = "EggSac", Root = root,
	})
	if not id then
		model:Destroy()
		return
	end
	model.Name = `EggSac_{id}`
	sacIds[id] = true
	f.Sacs[id] = { CombatId = id, Model = model, HatchAt = os.clock() + f.T.HatchSeconds }
	rockBurst(Vector3.new(x, f.Y, z), 6)
end

local function hatch(f: Fight, id: string)
	local sac = f.Sacs[id]
	if not sac then
		return
	end
	local entry = Config.Get("Bosses", f.BossId)
	local kind = if entry.Minions then entry.Minions[1] else "BurrowTick"
	local hatches = sac.Model:GetAttribute("Hatches")
	if type(hatches) == "string" and Config.Find("Monsters", hatches) then
		kind = hatches
	end
	local base = sac.Model:GetPivot()
	for i = 1, f.T.HatchCount do
		local angle = (i / f.T.HatchCount) * math.pi * 2
		local spot = base * CFrame.new(math.cos(angle) * 2, 0.5, math.sin(angle) * 2)
		monsters:Spawn(kind, CFrame.new(spot.Position), HATCH_TAG_PREFIX .. f.BossId)
	end
	removeSac(f, id, "Hatched")
	log:Info("an egg sac hatched %d %s", f.T.HatchCount, kind)
end

-- The fight -----------------------------------------------------------------------------------------------

local function nearestPlayer(f: Fight): (Player?, Vector3?)
	local best, bestPosition, bestScore = nil, nil, math.huge
	for _, player in session:ReadyPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and player:GetAttribute("Life") == "Alive" then
			local position = root.Position
			local floor = Grid.CellAt(position)
			-- players on her floor first (she can reach them), then anyone
			local score = (position - Vector3.new(f.X, f.Y, f.Z)).Magnitude + (if floor == f.Arena.Floor then 0 else 1000)
			if score < bestScore then
				best, bestPosition, bestScore = player, position, score
			end
		end
	end
	return best, bestPosition
end

local function turnTowards(f: Fight, target: Vector3, dt: number)
	local flat = Vector3.new(target.X - f.X, 0, target.Z - f.Z)
	if flat.Magnitude < 0.5 then
		return
	end
	-- her front is -Z: the yaw that looks along flat
	local want = math.atan2(-flat.X, -flat.Z)
	local delta = (want - f.Yaw + math.pi) % (math.pi * 2) - math.pi
	local step = math.rad(f.T.TurnDegreesPerSecond) * dt
	f.Yaw += math.clamp(delta, -step, step)
end

local function slamPoint(f: Fight): Vector3
	local model = f.Model
	if model and model:GetAttribute("Socket_Slam") == nil then
		return (pivot(f) * CFrame.new(0, 0, -f.T.SlamReach * 0.55)).Position -- no socket: in front of it
	end
	return if model then socket(model, "Slam").Position else Vector3.new(f.X, f.Y, f.Z)
end

local function attack(f: Fight, clip: string?)
	local model = f.Model :: Model
	local hitTime = (model:GetAttribute("HitTime") :: number?) or 0.8
	setActivity(clip or "Attack", true)
	model:SetAttribute("AttackAt", now())
	f.Busy = os.clock() + hitTime + 0.8
	f.NextAttack = os.clock() + Boss.ByPhase(f.T.AttackSeconds, f.Phase)
	task.delay(hitTime, function()
		if fight ~= f or f.State ~= "Fighting" or not f.CombatId then
			return
		end
		local at = slamPoint(f)
		local hit = 0
		for _, c in combat:All("Survivors") do
			local offset = c.Root.Position - at
			if c.State == "Alive" and Vector3.new(offset.X, 0, offset.Z).Magnitude <= f.T.SlamRadius and math.abs(offset.Y) < 9 then
				if combat:Damage(c.Id, f.T.SlamDamage, f.CombatId, "slammed") > 0 then
					hit += 1
				end
			end
		end
		rockBurst(at, 10)
		if hit > 0 then
			log:Debug("slam hit %d", hit)
		end
	end)
end

local function lay(f: Fight)
	local model = f.Model :: Model
	local layTime = (model:GetAttribute("LayTime") :: number?) or 1.4
	setActivity("LayEggs")
	f.Busy = os.clock() + layTime + 0.8
	f.NextLay = os.clock() + Boss.ByPhase(f.T.LaySeconds, f.Phase)
	task.delay(layTime, function()
		if fight ~= f or f.State ~= "Fighting" or not f.Model then
			return
		end
		local at = socket(f.Model, "Ovipositor").Position
		local count = 0
		for _ in f.Sacs do
			count += 1
		end
		for i = 1, Boss.ByPhase(f.T.SacsPerLay, f.Phase) do
			if count >= f.T.MaxSacs then
				break
			end
			local spread = if i == 1 then Vector3.zero else Vector3.new((i % 2 == 0 and 1 or -1) * 4, 0, 2)
			laySac(f, at + spread)
			count += 1
		end
		log:Info("%s laid eggs (%d sacs now)", f.Name, count)
	end)
end

local function stagger(f: Fight)
	setActivity("Stagger")
	f.Busy = os.clock() + f.T.StaggerSeconds
	f.NextAttack = math.max(f.NextAttack, f.Busy + 0.5)
	if f.Mode == "Up" then
		f.ModeUntil += f.T.StaggerSeconds -- it stays up that much longer
	end
	table.clear(f.Hits)
	if f.Model then
		f.Model:SetAttribute("StaggeredAt", now())
	end
	log:Info("%s staggered", f.Name)
end

local function tickBroodMother(f: Fight, dt: number)
	if not f.Model or not f.CombatId then
		return
	end
	local health, max = combat:HealthOf(f.CombatId)
	local phase = Boss.Phase(f.BossId, if max > 0 then health / max else 0)
	if phase > f.Phase then
		f.Phase = phase
		setActivity("Roar")
		f.Busy = os.clock() + f.T.RoarSeconds
		f.NextLay = math.min(f.NextLay, os.clock() + f.T.RoarSeconds + 1)
		announce("Danger", `{Boss.Title(f.Name)} {look(f).Phase}`)
		log:Info("%s phase %d", f.Name, phase)
	end
	for id, sac in table.clone(f.Sacs) do
		if os.clock() >= sac.HatchAt then
			hatch(f, id)
		end
	end
	publish()
	if os.clock() < f.Busy then
		return
	end
	local target, position = nearestPlayer(f)
	if not target or not position then
		setActivity("Idle")
		return
	end
	turnTowards(f, position, dt)
	local count = 0
	for _ in f.Sacs do
		count += 1
	end
	if os.clock() >= f.NextLay and count < f.T.MaxSacs then
		f.Model:PivotTo(pivot(f))
		lay(f)
		return
	end
	local flat = Vector3.new(position.X - f.X, 0, position.Z - f.Z)
	if flat.Magnitude <= f.T.SlamReach and os.clock() >= f.NextAttack then
		local facing = (pivot(f)).LookVector
		if flat.Unit:Dot(Vector3.new(facing.X, 0, facing.Z).Unit) > 0.7 then
			f.Model:PivotTo(pivot(f))
			attack(f)
			return
		end
	end
	local wantX = math.clamp(position.X, f.Left, f.Right)
	local gap = wantX - f.X
	if math.abs(gap) > 1 and flat.Magnitude > f.T.SlamReach * 0.6 then
		local speed = Boss.ByPhase(f.T.MoveSpeed, f.Phase)
		f.X += math.clamp(gap, -speed * dt, speed * dt)
		setActivity("Walk")
	else
		setActivity("Idle")
	end
	f.Model:PivotTo(pivot(f))
end

-- The Deluge ------------------------------------------------------------------------------------------------

local function wakeRate(f: Fight, rate: number)
	local wake = f.Wake
	local emitter = wake and wake:FindFirstChildOfClass("ParticleEmitter")
	if emitter then
		emitter.Rate = rate
	end
	local light = wake and wake:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = rate > 0
	end
end

-- The spray and the light where its crest cuts the floor: what players follow while it is under.
local function makeWake(f: Fight)
	local part = effectPart(Vector3.new(f.X, f.Y + 0.4, f.Z), "DelugeWake")
	part.Size = Vector3.new(6, 0.4, 6)
	local spray = Instance.new("ParticleEmitter")
	spray.Texture = "rbxasset://textures/particles/smoke_main.dds"
	spray.Color = ColorSequence.new(look(f).Chips)
	spray.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6), NumberSequenceKeypoint.new(1, 4.6) })
	spray.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	spray.Lifetime = NumberRange.new(0.6, 1.2)
	spray.Speed = NumberRange.new(8, 16)
	spray.SpreadAngle = Vector2.new(40, 40)
	spray.Acceleration = Vector3.new(0, -30, 0)
	spray.LightEmission = 0.4
	spray.Rate = 0
	spray.Parent = part
	local light = Instance.new("PointLight")
	light.Color = look(f).Glow
	light.Range = 20
	light.Brightness = 2.2
	light.Shadows = false
	light.Enabled = false
	light.Parent = part
	f.Wake = part
	table.insert(f.Effects, part)
end

-- Every room it passes bursts a pipe and takes water (the Shaft takes the water, with no pipe).
local function floodPassed(f: Fight)
	local room = grid:Bunker():RoomAt(f.Floor, f.Column)
	if room and not f.Passed[room.Id] then
		f.Passed[room.Id] = true
		disasters:StartFlood(room.Id, "Deluge", f.T.FloodLevel, room.Type ~= "Shaft")
	end
end

-- Where it comes up for someone in this cell: the cell itself, or the nearest open cell on that
-- floor that isn't a Shaft.
local function surfaceCell(bunker: any, floor: number, column: number): (number, number)
	if not bunker:IsShaft(floor, column) then
		return floor, column
	end
	for reach = 1, 4 do
		for _, c in { column - reach, column + reach } do
			if bunker:IsOpen(floor, c) and not bunker:IsShaft(floor, c) then
				return floor, c
			end
		end
	end
	return floor, column
end

-- The way to the nearest standing player it can reach; with nobody, to a room picked at random.
local function delugeRoute(f: Fight)
	local bunker = grid:Bunker()
	local here = Vector3.new(f.X, f.Y, f.Z)
	local wanted: { { Distance: number, Floor: number, Column: number } } = {}
	for _, player in session:ReadyPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and player:GetAttribute("Life") == "Alive" then
			local floor, column = Grid.CellAt(root.Position)
			if floor and column and bunker:IsOpen(floor, column) then
				table.insert(wanted, { Distance = (root.Position - here).Magnitude, Floor = floor, Column = column })
			end
		end
	end
	table.sort(wanted, function(a, b)
		return a.Distance < b.Distance
	end)
	for _, w in wanted do
		local floor, column = surfaceCell(bunker, w.Floor, w.Column)
		local path = bunker:CellPath(f.Floor, f.Column, floor, column)
		if path then
			f.Path, f.PathIndex = path, 2
			return
		end
	end
	if f.PathIndex <= #f.Path then
		return -- nobody to hunt: it carries on where it was going
	end
	local rooms = {}
	for _, room in bunker:AllRooms() do
		if room.Type ~= "Shaft" then
			table.insert(rooms, room)
		end
	end
	if #rooms > 0 then
		local room = rooms[rng:NextInteger(1, #rooms)]
		local path = bunker:CellPath(f.Floor, f.Column, room.Floor, room.Column)
		if path then
			f.Path, f.PathIndex = path, 2
			return
		end
	end
	f.Path, f.PathIndex = {}, 1
end

local function delugeDive(f: Fight)
	f.Mode = "Diving"
	f.ModeUntil = os.clock() + f.T.DiveSeconds
	f.Face = nil
	f.AloneSince = nil
	table.clear(f.Passed)
	local room = grid:Bunker():RoomAt(f.Floor, f.Column)
	if room then
		f.Passed[room.Id] = true -- it flooded this one as it came up
	end
	setActivity("Swim")
	if f.Model then
		f.Model:SetAttribute("DivedAt", now())
	end
	publish(true)
	log:Info("%s dives at floor %d column %d", f.Name, f.Floor, f.Column)
end

local function delugeSurface(f: Fight)
	f.Mode = "Surfacing"
	f.ModeUntil = os.clock() + f.T.SurfaceRiseSeconds
	wakeRate(f, 0)
	floodPassed(f)
	local at = Vector3.new(f.X, f.Y, f.Z)
	rockBurst(at, 60, f)
	if f.Roar then
		setActivity("Roar", true)
	else
		setActivity("Idle")
	end
	if f.Model then
		f.Model:SetAttribute("SurfacedAt", now())
	end
	-- Murklings pour out with it (Config.Bosses' Minions)
	local entry = Config.Get("Bosses", f.BossId)
	local kind = if entry.Minions then entry.Minions[1] else nil
	local count = Boss.ByPhase(f.T.Murklings, f.Phase)
	if kind and count > 0 then
		for i = 1, count do
			local angle = (i / count) * math.pi * 2
			local spot = at + Vector3.new(math.cos(angle) * 7, 0.5, math.sin(angle) * 7)
			monsters:Spawn(kind, CFrame.new(spot), HATCH_TAG_PREFIX .. f.BossId)
		end
	end
	publish(true)
	log:Info("%s surfaces at floor %d column %d (%d %s with it)", f.Name, f.Floor, f.Column, count, tostring(kind))
end

-- Its bite: whoever is within BiteRadius of where its jaws come down.
local function bite(f: Fight)
	local model = f.Model :: Model
	local hitTime = (model:GetAttribute("HitTime") :: number?) or 0.7
	setActivity("Attack", true)
	model:SetAttribute("AttackAt", now())
	f.Busy = os.clock() + hitTime + 0.8
	f.NextAttack = os.clock() + Boss.ByPhase(f.T.AttackSeconds, f.Phase)
	task.delay(hitTime, function()
		if fight ~= f or f.State ~= "Fighting" or f.Mode ~= "Up" or not f.CombatId or not f.Model then
			return
		end
		local at = if f.Model:GetAttribute("Socket_Bite") ~= nil
			then socket(f.Model, "Bite").Position
			else (pivot(f) * CFrame.new(0, 1, -f.T.BiteReach * 0.7)).Position
		local hit = 0
		for _, c in combat:All("Survivors") do
			local offset = c.Root.Position - at
			if c.State == "Alive" and Vector3.new(offset.X, 0, offset.Z).Magnitude <= f.T.BiteRadius and math.abs(offset.Y) < 9 then
				if combat:Damage(c.Id, f.T.BiteDamage, f.CombatId, "bitten") > 0 then
					hit += 1
				end
			end
		end
		rockBurst(at, 14, f)
		if hit > 0 then
			log:Debug("bite hit %d", hit)
		end
	end)
end

-- The nearest standing survivor (players and residents) on its floor, and how far.
local function nearestSurvivor(f: Fight): (Vector3?, number)
	local best, bestDistance = nil, math.huge
	for _, c in combat:All("Survivors") do
		if c.State == "Alive" then
			local offset = c.Root.Position - Vector3.new(f.X, f.Y, f.Z)
			local flat = Vector3.new(offset.X, 0, offset.Z).Magnitude
			if math.abs(offset.Y) < 9 and flat < bestDistance then
				best, bestDistance = c.Root.Position, flat
			end
		end
	end
	return best, bestDistance
end

-- Its decisions, every TickSeconds.
local function tickDeluge(f: Fight, _dt: number)
	if not f.Model or not f.CombatId then
		return
	end
	local at0 = os.clock()
	local health, max = combat:HealthOf(f.CombatId)
	local phase = Boss.Phase(f.BossId, if max > 0 then health / max else 0)
	if phase > f.Phase then
		f.Phase = phase
		announce("Danger", `{Boss.Title(f.Name)} {look(f).Phase}`)
		log:Info("%s phase %d", f.Name, phase)
		if f.Mode == "Up" then
			setActivity("Roar", true)
			f.Busy = at0 + f.T.RoarSeconds
			f.ModeUntil += f.T.RoarSeconds
		else
			f.Roar = true
		end
	end
	publish()
	if f.Mode ~= "Up" or at0 < f.Busy then
		return
	end
	if at0 >= f.ModeUntil then
		delugeDive(f)
		return
	end
	local position, distance = nearestSurvivor(f)
	f.Face = position
	if not position or distance > f.T.BiteReach * 2 then
		-- nobody near: it doesn't wait about
		f.AloneSince = f.AloneSince or at0
		if at0 - f.AloneSince >= f.T.AloneSeconds then
			delugeDive(f)
			return
		end
	else
		f.AloneSince = nil
	end
	if position and distance <= f.T.BiteReach and at0 >= f.NextAttack then
		local flat = Vector3.new(position.X - f.X, 0, position.Z - f.Z)
		local facing = pivot(f).LookVector
		if flat.Magnitude < 1 or flat.Unit:Dot(Vector3.new(facing.X, 0, facing.Z).Unit) > 0.75 then
			bite(f)
			return
		end
	end
	setActivity("Idle")
end

-- Its movement, every frame.
local function frameDeluge(f: Fight, dt: number)
	local model = f.Model
	if not model or f.State ~= "Fighting" or f.Mode == "" then
		return
	end
	local t = f.T
	local at0 = os.clock()
	if f.Mode == "Up" then
		if f.Face and at0 >= f.Busy then
			local before = f.Yaw
			turnTowards(f, f.Face, dt)
			if f.Yaw ~= before then
				model:PivotTo(pivot(f))
			end
		end
		return
	end
	if f.Mode == "Diving" then
		f.Sink = math.min(t.SwimDepth, f.Sink + t.SwimDepth / t.DiveSeconds * dt)
		if f.Sink >= t.SwimDepth then
			f.Mode = "Swim"
			f.SwimFrom = at0
			f.ModeUntil = at0 + Boss.ByPhase(t.SwimSeconds, f.Phase)
			delugeRoute(f)
			wakeRate(f, 60)
			publish(true)
		end
	elseif f.Mode == "Swim" then
		local remaining = Boss.ByPhase(t.SwimSpeed, f.Phase) * dt
		local bunker = grid:Bunker()
		while remaining > 0 and f.Mode == "Swim" do
			local cell = f.Path[f.PathIndex]
			local late = at0 >= f.ModeUntil
			if not cell then
				-- there: up it comes (after a breath under, so a dive is never a blink), or on to the next
				if at0 - f.SwimFrom >= 2 or late then
					delugeSurface(f)
				end
				break
			end
			local goal = Grid.CellPosition(cell[1], cell[2])
			local offset = goal - Vector3.new(f.X, f.Y, f.Z)
			local distance = offset.Magnitude
			if math.abs(offset.X) > 0.05 then
				-- its front is -Z
				local want = math.atan2(-offset.X, -offset.Z)
				local delta = (want - f.Yaw + math.pi) % (math.pi * 2) - math.pi
				local step = math.rad(360) * dt
				f.Yaw += math.clamp(delta, -step, step)
			end
			if distance <= remaining then
				f.X, f.Y, f.Z = goal.X, goal.Y, goal.Z
				f.Floor, f.Column = cell[1], cell[2]
				f.PathIndex += 1
				remaining -= distance
				floodPassed(f)
				if late and not bunker:IsShaft(f.Floor, f.Column) then
					delugeSurface(f)
				else
					delugeRoute(f) -- whoever it hunts has moved
				end
			else
				local step = offset.Unit * remaining
				f.X += step.X
				f.Y += step.Y
				f.Z += step.Z
				remaining = 0
			end
		end
	elseif f.Mode == "Surfacing" then
		f.Sink = math.max(0, f.Sink - t.SwimDepth / t.SurfaceRiseSeconds * dt)
		if f.Sink <= 0 then
			f.Mode = "Up"
			f.ModeUntil = at0 + Boss.ByPhase(t.SurfaceSeconds, f.Phase)
			f.NextAttack = at0 + 0.8
			f.AloneSince = nil
			if f.Roar then
				f.Roar = false
				f.Busy = at0 + t.RoarSeconds
				f.ModeUntil += t.RoarSeconds
			end
			publish(true)
		end
	end
	model:PivotTo(pivot(f))
	if f.Wake then
		f.Wake.CFrame = CFrame.new(f.X, f.Y + 0.4, f.Z)
	end
end

-- The Crystal Colossus (Prompt 24) ----------------------------------------------------------------------------

local CORE_DARK = Color3.fromRGB(46, 40, 52)
local CORE_LIT = Color3.fromRGB(232, 116, 59) -- Signal Orange: shoot here

-- Its cores (the model's WeakPoint parts): dark stone until a light shows them, then they glow.
local function setLit(f: Fight, lit: boolean)
	if f.Lit == lit then
		return
	end
	f.Lit = lit
	local model = f.Model
	if not model then
		return
	end
	for _, part in weakParts(model) do
		part.Material = if lit then Enum.Material.Neon else Enum.Material.Slate
		part.Color = if lit then CORE_LIT else CORE_DARK
	end
	model:SetAttribute("Lit", if lit then true else nil)
	publish(true)
	log:Debug("%s cores %s", f.Name, if lit then "lit" else "dark")
end

-- A flare or a lamp on it (Section 10: "flares show its weak points"), or its own charge.
local function colossusLit(f: Fight): boolean
	if os.clock() < f.LitUntil then
		return true
	end
	return monsters:Lit(Vector3.new(f.X, f.Y + 6, f.Z))
end

-- A shard's mark on the floor: it lands ShardWarnSeconds later (the client draws the ring and the
-- falling shard from the mark's attributes), hurting and stunning whoever is still inside.
local function shardMark(f: Fight, at: Vector3, hatch: boolean)
	local t = f.T
	local mark = effectPart(Vector3.new(at.X, f.Y + 0.15, at.Z), "ShardMark")
	mark.Size = Vector3.new(t.ShardRadius * 2, 0.3, t.ShardRadius * 2)
	mark:SetAttribute("Radius", t.ShardRadius)
	mark:SetAttribute("LandsAt", now() + t.ShardWarnSeconds)
	table.insert(f.Effects, mark)
	task.delay(t.ShardWarnSeconds, function()
		if fight ~= f or not mark.Parent then
			mark:Destroy()
			return
		end
		local centre = mark.Position
		local hit = 0
		for _, c in combat:All("Survivors") do
			local offset = c.Root.Position - centre
			if c.State == "Alive" and Vector3.new(offset.X, 0, offset.Z).Magnitude <= t.ShardRadius + c.Reach and math.abs(offset.Y) < 9 then
				if f.CombatId and combat:Damage(c.Id, t.ShardDamage, f.CombatId, "shard") > 0 then
					hit += 1
					-- "its shards stun"
					if c.Kind == "Player" and c.Player then
						c.Player:SetAttribute("StunnedUntil", now() + t.StunSeconds)
					elseif c.Model then
						c.Model:SetAttribute("SlowedUntil", now() + t.StunSeconds)
					end
				end
			end
		end
		rockBurst(centre, 16, f)
		mark:SetAttribute("Landed", true)
		task.delay(0.6, function()
			mark:Destroy()
		end)
		if hatch and f.State == "Fighting" then
			local entry = Config.Get("Bosses", f.BossId)
			local kind = if entry.Minions then entry.Minions[1] else nil
			if kind and monsters:Count(HATCH_TAG_PREFIX .. f.BossId) < t.MaxShardlings then
				monsters:Spawn(kind, CFrame.new(centre + Vector3.new(0, 0.5, 0)), HATCH_TAG_PREFIX .. f.BossId)
			end
		end
		if hit > 0 then
			log:Debug("a shard hit %d", hit)
		end
	end)
end

-- It plants itself and throws its shards at whoever it can see on its floor: players first.
local function volley(f: Fight)
	local model = f.Model :: Model
	local t = f.T
	local throwTime = (model:GetAttribute("VolleyTime") :: number?) or 0.9
	setActivity("Volley", true)
	model:SetAttribute("VolleyAt", now())
	f.Moving = false
	f.Busy = os.clock() + throwTime + 1
	f.NextVolley = os.clock() + Boss.ByPhase(t.VolleySeconds, f.Phase)
	f.NextAttack = math.max(f.NextAttack, f.Busy + 0.5)
	f.LitUntil = math.max(f.LitUntil, os.clock() + throwTime + t.FlashSeconds) -- its charge shows its cores
	task.delay(throwTime, function()
		if fight ~= f or f.State ~= "Fighting" then
			return
		end
		local here = Vector3.new(f.X, f.Y, f.Z)
		local players, others = {}, {}
		for _, c in combat:All("Survivors") do
			local offset = c.Root.Position - here
			if c.State == "Alive" and math.abs(offset.Y) < 9 and Vector3.new(offset.X, 0, offset.Z).Magnitude <= t.VolleyRange then
				table.insert(if c.Kind == "Player" then players else others, c)
			end
		end
		local targets = {}
		for _, list in { players, others } do
			while #list > 0 do
				table.insert(targets, table.remove(list, rng:NextInteger(1, #list)))
			end
		end
		local count = Boss.ByPhase(t.Shards, f.Phase)
		local hatches = Boss.ByPhase(t.Shardlings, f.Phase)
		for i = 1, count do
			local c = targets[(i - 1) % math.max(#targets, 1) + 1]
			local at: Vector3
			if c then
				-- the first shard at each target lands on them; the rest fall around them
				local spread = if i <= #targets then 0 else t.ShardRadius * 1.4
				local angle = rng:NextNumber() * math.pi * 2
				at = c.Root.Position + Vector3.new(math.cos(angle) * spread, 0, math.sin(angle) * spread)
			else
				at = here + Vector3.new(rng:NextNumber(-14, 14), 0, rng:NextNumber(2, 12))
			end
			-- shards land inside its arena's floor
			at = Vector3.new(math.clamp(at.X, f.Left - t.ArenaMargin + 2, f.Right + t.ArenaMargin - 2), f.Y,
				math.clamp(at.Z, f.Z - 12, f.Z + 15))
			shardMark(f, at, i <= hatches)
		end
		log:Info("%s threw %d shards (%d will hatch)", f.Name, count, math.min(hatches, count))
	end)
end

-- Its decisions, every TickSeconds.
local function tickColossus(f: Fight, _dt: number)
	if not f.Model or not f.CombatId then
		return
	end
	local at0 = os.clock()
	local health, max = combat:HealthOf(f.CombatId)
	local phase = Boss.Phase(f.BossId, if max > 0 then health / max else 0)
	if phase > f.Phase then
		f.Phase = phase
		f.Moving = false
		setActivity("Roar", true)
		f.Busy = at0 + f.T.RoarSeconds
		f.NextVolley = math.min(f.NextVolley, f.Busy + 1)
		announce("Danger", `{Boss.Title(f.Name)} {look(f).Phase}`)
		log:Info("%s phase %d", f.Name, phase)
	end
	setLit(f, colossusLit(f))
	publish()
	if at0 < f.Busy then
		f.Moving = false
		return
	end
	local target, position = nearestPlayer(f)
	if not target or not position then
		f.Moving = false
		f.Face = nil
		setActivity("Idle")
		return
	end
	f.Face = position
	if at0 >= f.NextVolley then
		volley(f)
		return
	end
	local flat = Vector3.new(position.X - f.X, 0, position.Z - f.Z)
	if flat.Magnitude <= f.T.SlamReach and at0 >= f.NextAttack then
		local facing = pivot(f).LookVector
		if flat.Magnitude < 1 or flat.Unit:Dot(Vector3.new(facing.X, 0, facing.Z).Unit) > 0.7 then
			f.Moving = false
			attack(f)
			return
		end
	end
	f.WantX = math.clamp(position.X, f.Left, f.Right)
	f.Moving = math.abs(f.WantX - f.X) > 1 and flat.Magnitude > f.T.SlamReach * 0.6
	setActivity(if f.Moving then "Walk" else "Idle")
end

-- Its stride and its turn, every frame.
local function frameColossus(f: Fight, dt: number)
	local model = f.Model
	if not model or f.State ~= "Fighting" or os.clock() < f.Busy then
		return
	end
	local moved = false
	if f.Face then
		local before = f.Yaw
		turnTowards(f, f.Face, dt)
		moved = f.Yaw ~= before
	end
	if f.Moving then
		local gap = f.WantX - f.X
		local speed = Boss.ByPhase(f.T.MoveSpeed, f.Phase)
		local step = math.clamp(gap, -speed * dt, speed * dt)
		if math.abs(step) > 1e-4 then
			f.X += step
			moved = true
		end
	end
	if moved then
		model:PivotTo(pivot(f))
	end
end

-- The Source ------------------------------------------------------------------------------------------------

-- Its stages, tendrils and roots are Lib.SourceFight's; its own body does what every boss's does:
-- it turns to whoever is nearest and slams whoever comes within reach of its arms. It never walks.
local function tickSource(f: Fight, dt: number)
	if not f.Model or not f.CombatId then
		return
	end
	SourceFight.tick(sourceCtx, f, dt)
	publish()
	if fight ~= f or f.State ~= "Fighting" or os.clock() < f.Busy then
		return
	end
	local base = SourceFight.base(f)
	local target, position = nearestPlayer(f)
	if not target or not position then
		setActivity(base)
		return
	end
	turnTowards(f, position, dt)
	local flat = Vector3.new(position.X - f.X, 0, position.Z - f.Z)
	if flat.Magnitude <= f.T.SlamReach and math.abs(position.Y - f.Y) < 12 and os.clock() >= f.NextAttack then
		local facing = (pivot(f)).LookVector
		if flat.Magnitude < 0.5 or flat.Unit:Dot(Vector3.new(facing.X, 0, facing.Z).Unit) > 0.7 then
			f.Model:PivotTo(pivot(f))
			attack(f, if SourceFight.open(f) then "Attack" else "Slam")
			return
		end
	end
	setActivity(base)
	f.Model:PivotTo(pivot(f))
end

local function tick(dt: number)
	local f = fight
	if not f or f.State ~= "Fighting" then
		return
	end
	if f.BossId == "Source" then
		tickSource(f, dt)
	elseif f.BossId == "Deluge" then
		tickDeluge(f, dt)
	elseif f.BossId == "CrystalColossus" then
		tickColossus(f, dt)
	else
		tickBroodMother(f, dt)
	end
end

local function cleanup(f: Fight)
	for _, t in f.Tracks do
		t:Stop(0)
	end
	for id in table.clone(f.Sacs) do
		removeSac(f, id, "Gone")
	end
	if f.Source then
		SourceFight.cleanup(sourceCtx, f, false)
	end
	for _, effect in f.Effects do
		effect:Destroy()
	end
	if f.CombatId then
		combat:Unregister(f.CombatId)
		f.CombatId = nil
	end
	if f.Model and f.Model.Parent then
		combat:Dissolve(f.Model)
	end
end

local function rise(f: Fight)
	if fight ~= f then
		return
	end
	local model, root = makeModel(f.BossId)
	f.Model = model
	f.Root = root
	f.State = "Rising"
	local finalPivot = pivot(f)
	local from = EMERGE[f.BossId] or EMERGE.BroodMother
	model:PivotTo(finalPivot + from)
	model.Parent = holder()
	local id = combat:Register(model, {
		Kind = "Monster", Team = "Monsters", Health = f.Max, MonsterType = f.BossId, Root = root, KeepModel = true,
	})
	if not id then
		log:Warn("%s couldn't register", f.Name)
		model:Destroy()
		fight = nil
		publish(true)
		return
	end
	f.CombatId = id
	model.Name = `{f.BossId}_{id}`
	local colossus = f.BossId == "CrystalColossus"
	play(f, if colossus then "Walk" else "Roar", true)
	for _, activity in look(f).Clips do
		track(f, activity) -- loaded now, so each is ready (and its length known) when she needs it
	end
	local wall = Vector3.new(f.X, f.Y + 6, f.Z - 13)
	rockBurst(if colossus then wall else Vector3.new(f.X, f.Y, f.Z), 40, f)
	if colossus then
		setLit(f, false) -- its cores are dark until a light finds them
	end
	publish(true)
	announce("Danger", `{Boss.Title(f.Name)} {look(f).Up}`)
	local seconds = if colossus then f.T.EmergeSeconds else Boss.Tuning().RiseSeconds
	local started = os.clock()
	local bursts = 1
	while fight == f and os.clock() - started < seconds do
		local k = math.clamp((os.clock() - started) / seconds, 0, 1)
		-- she bursts up and slows; the Colossus strides out at its own pace
		local eased = if colossus then k else 1 - (1 - k) * (1 - k)
		model:PivotTo(finalPivot + from * (1 - eased))
		if colossus and k * 3 >= bursts then
			bursts += 1
			rockBurst(wall + Vector3.new(rng:NextNumber(-5, 5), rng:NextNumber(-4, 3), 0), 24, f) -- the wall coming apart
		end
		task.wait()
	end
	if fight ~= f then
		return
	end
	model:PivotTo(finalPivot)
	if colossus then
		play(f, "Roar", true)
	end
	f.State = "Fighting"
	f.Busy = os.clock() + f.T.RoarSeconds
	f.NextAttack = f.Busy + 1
	if f.BossId == "Deluge" then
		f.Mode = "Up"
		f.ModeUntil = f.Busy + Boss.ByPhase(f.T.SurfaceSeconds, 1)
		makeWake(f)
		floodPassed(f)
	elseif colossus then
		f.NextVolley = f.Busy + Boss.ByPhase(f.T.VolleySeconds, 1) * 0.5
	elseif f.BossId == "Source" then
		SourceFight.start(sourceCtx, f)
	else
		f.NextLay = os.clock() + Boss.ByPhase(f.T.LaySeconds, 1) * 0.5
	end
	publish(true)
	log:Info("%s is up (%d health, arena floor %d, columns %d to %d)", f.Name, f.Max, f.Arena.Floor, f.Arena.From, f.Arena.To)
end

local function newFight(bossId: string, name: string, t: { [string]: any }, arena: Boss.Arena, at: Vector3, yaw: number, max: number): Fight
	local left, right = Boss.ArenaSpan(arena, t.ArenaMargin)
	return {
		BossId = bossId,
		Name = name,
		T = t,
		Arena = arena,
		Left = left,
		Right = right,
		X = at.X,
		Y = at.Y,
		Z = at.Z,
		Yaw = yaw,
		Model = nil,
		Root = nil,
		CombatId = nil,
		Max = max,
		Phase = 1,
		State = "Warning",
		ArriveAt = now(),
		Busy = 0,
		NextAttack = 0,
		NextLay = 0,
		Sacs = {},
		Hits = {},
		LastHitBy = nil,
		PublishedAt = 0,
		Sent = "",
		Effects = {},
		Tracks = {},
		Playing = nil,
		Mode = "",
		ModeUntil = 0,
		SwimFrom = 0,
		Sink = 0,
		Floor = arena.Floor,
		Column = Boss.ArenaMiddle(arena),
		Path = {},
		PathIndex = 1,
		Passed = {},
		Face = nil,
		AloneSince = nil,
		Roar = false,
		Wake = nil,
		Lit = true, -- as the art has them; rise() darkens them
		LitUntil = 0,
		NextVolley = 0,
		WantX = at.X,
		Moving = false,
		Source = nil,
		Chamber = false,
	}
end

-- The Source asleep in its chamber --------------------------------------------------------------------

-- Left asleep until the final Surge, it sinks out of its chamber: "Rises into the bunker".
local function leaveChamber()
	local s = sleeper
	if not s then
		return
	end
	sleeper = nil
	chamberEmpty = true
	if s.CombatId then
		combat:Unregister(s.CombatId)
	end
	if s.Idle then
		s.Idle:Stop(0.3)
	end
	local model = s.Model
	model:SetAttribute("Asleep", nil)
	rockBurst(s.At.Position, 30)
	local seconds = Config.Get("Tuning", "Source").LeaveSeconds
	task.spawn(function()
		local started = os.clock()
		while model.Parent and os.clock() - started < seconds do
			local k = (os.clock() - started) / seconds
			model:PivotTo(s.At + Vector3.new(0, -(SOURCE_RISE_DEPTH + 4) * k * k, 0))
			task.wait()
		end
		model:Destroy()
	end)
	announce("Danger", "THE SOURCE HAS LEFT ITS CHAMBER")
	log:Info("the Source left its chamber asleep")
end

-- The Source Chamber is open: the Source is in it, asleep, until someone comes close or hurts it.
local function placeSleeper()
	if sleeper or chamberEmpty or objectives:IsBossBeaten("Source") or (fight and fight.BossId == "Source") then
		return
	end
	local chamber = deep:SourceChamber()
	if not chamber or not Boss.Fight("Source") then
		return
	end
	local model, root = makeModel("Source")
	model:SetAttribute("Activity", "Idle")
	model:SetAttribute("Asleep", true)
	model:PivotTo(chamber.Core)
	model.Parent = holder()
	local id = combat:Register(model, {
		Kind = "Monster", Team = "Monsters", Health = SLEEP_HEALTH, MonsterType = "Source", Root = root, KeepModel = true,
	})
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local animator = humanoid and humanoid:FindFirstChildOfClass("Animator")
	local idle = if animator then loadClip(animator, "Source", "Idle") else nil
	if idle then
		idle:Play(0)
	end
	sleeper = { Model = model, Root = root, At = chamber.Core, CombatId = id, Sockets = chamber.Tendrils, Idle = idle }
	log:Info("the Source sleeps in its chamber (%s)", chamber.Key)
end

-- It wakes where it sleeps: the same fight as in the bunker, and its death is the Deep Victory.
local function wake(why: string): (boolean, string?)
	local s = sleeper
	if not s then
		return false, "the Source isn't asleep in its chamber"
	end
	if fight then
		return false, `{fight.Name} is here`
	end
	if director:Phase() ~= "Playing" then
		return false, "the run isn't being played"
	end
	local entry = Config.Get("Bosses", "Source")
	local t = Boss.Fight("Source") :: { [string]: any }
	local arena: Boss.Arena = Boss.Arena(grid:Bunker()) or { Floor = 10, From = 0, To = 0, Kind = "Cell" }
	sleeper = nil
	chamberEmpty = true
	if s.CombatId then
		combat:Unregister(s.CombatId)
	end
	local players = math.max(#session:ReadyPlayers(), 1)
	local _, yaw = s.At:ToOrientation()
	local f = newFight("Source", entry.Name, t, arena, s.At.Position, yaw, Boss.Health("Source", players, threat:IsFirstRun()))
	f.Chamber = true
	f.Left, f.Right = f.X, f.X
	f.Source = SourceFight.new(s.Sockets)
	f.Model = s.Model
	f.Root = s.Root
	s.Model:SetAttribute("Asleep", nil)
	local id = combat:Register(s.Model, {
		Kind = "Monster", Team = "Monsters", Health = f.Max, MonsterType = "Source", Root = s.Root, KeepModel = true,
	})
	if not id then
		log:Warn("the Source couldn't register")
		s.Model:Destroy()
		return false, "it couldn't register"
	end
	f.CombatId = id
	s.Model.Name = `Source_{id}`
	if s.Idle then
		f.Tracks.Idle = s.Idle
		f.Playing = s.Idle
	end
	fight = f
	for _, activity in look(f).Clips do
		track(f, activity)
	end
	f.State = "Fighting"
	f.Busy = os.clock() + t.RoarSeconds
	f.NextAttack = f.Busy + 1
	setActivity("Roar", true)
	rockBurst(s.At.Position, 30, f)
	announce("Danger", "THE SOURCE WAKES · KILL IT HERE AND THE RUN IS WON")
	log:Info("the Source wakes in its chamber (%s): %d health, %d players", why, f.Max, players)
	BossService.Started:Fire("Source")
	SourceFight.start(sourceCtx, f)
	publish(true)
	return true, nil
end

function BossService:Sleeping(): boolean
	return sleeper ~= nil
end

-- With no fight on: the sleeper wakes when a player comes close, and a boss that waited comes.
local function between()
	if fight or director:Phase() ~= "Playing" then
		return
	end
	local pending = waiting
	if pending then
		waiting = nil
		local kind, bossId = clock:Surge()
		if (kind == "Boss" or kind == "Final") and bossId == pending and not objectives:IsBossBeaten(pending) then
			local ok, why = BossService:BeginFight(pending)
			if not ok then
				log:Warn("the %s Surge has no fight: %s", pending, tostring(why))
			end
			return
		end
	end
	local s = sleeper
	if s then
		local range = Config.Get("Tuning", "Source").WakeRange
		for _, player in session:ReadyPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and player:GetAttribute("Life") == "Alive"
				and (root.Position - s.At.Position).Magnitude <= range then
				wake(`{player.Name} came close`)
				return
			end
		end
	end
end

function BossService:BeginFight(bossId: string): (boolean, string?)
	if fight then
		return false, `{fight.Name} is already here`
	end
	local entry = Config.Find("Bosses", bossId)
	local t = Boss.Fight(bossId)
	if not entry or not t then
		return false, `no fight for {bossId} yet`
	end
	local arena = Boss.Arena(grid:Bunker())
	if not arena then
		return false, "no open cell for her to break into"
	end
	if bossId == "Source" then
		if objectives:IsBossBeaten("Source") then
			return false, "the Source is dead"
		end
		leaveChamber() -- if it is still asleep down there
		chamberEmpty = true
	end
	local left, right = Boss.ArenaSpan(arena, t.ArenaMargin)
	local cell = Grid.CellPosition(arena.Floor, Boss.ArenaMiddle(arena))
	local players = math.max(#session:ReadyPlayers(), 1)
	local warningSeconds = Boss.Tuning().ArrivalWarningSeconds
	-- a little towards the back of the cell, so her front has room; facing the front of the bunker
	local at = Vector3.new(math.clamp(cell.X, left, right), cell.Y, cell.Z - 2)
	if bossId == "Deluge" or bossId == "Source" then
		at = Vector3.new(cell.X, cell.Y, cell.Z) -- they come up in the middle of their cell
	end
	local f = newFight(bossId, entry.Name, t, arena, at, math.pi, Boss.Health(bossId, players, threat:IsFirstRun()))
	f.ArriveAt = now() + warningSeconds
	f.WantX = cell.X
	if bossId == "Source" then
		f.Source = SourceFight.new(nil)
	end
	fight = f
	warning(f, warningSeconds)
	publish(true)
	announce("Danger", `{Boss.Title(entry.Name)} IS BREAKING THROUGH: {where(arena)} · {warningSeconds} S`)
	log:Info("%s breaks in at %s in %d s (%d health, %d players)", entry.Name, where(arena), warningSeconds, f.Max, players)
	BossService.Started:Fire(bossId)
	task.delay(warningSeconds, rise, f)
	return true, nil
end

-- Crits (the Marksman's level 3) and explosions (the Demolitionist's level 3) stagger the boss
-- (Prompt 20), at most every Tuning.Classes.BossStunCooldown seconds and never while she is busy.
local lastStun = -math.huge
function BossService:Stun(combatId: string, why: string): boolean
	local f = fight
	if not f or f.CombatId ~= combatId or f.State ~= "Fighting" or os.clock() < f.Busy then
		return false
	end
	if f.Mode ~= "" and f.Mode ~= "Up" then
		return false -- under water
	end
	if os.clock() - lastStun < Config.Get("Tuning", "Classes").BossStunCooldown then
		return false
	end
	lastStun = os.clock()
	stagger(f)
	log:Info("%s staggered by %s", f.Name, why)
	return true
end

function BossService:Active(): string?
	return if fight then fight.BossId else nil
end

-- Is this combatant the boss (not one of its egg sacs)? True for the killing blow too: Damaged
-- fires before Died.
function BossService:IsBoss(combatId: string): boolean
	return fight ~= nil and fight.CombatId == combatId
end

-- Was this combatant one of a boss's egg sacs (alive or not)?
function BossService:IsEggSac(combatId: string): boolean
	return sacIds[combatId] == true
end

local function onDied(id: string)
	local f = fight
	if not f then
		return
	end
	if f.Sacs[id] then
		removeSac(f, id, "Broken")
		log:Info("an egg sac was broken")
		return
	end
	if f.Source and SourceFight.onDied(sourceCtx, f, id) then
		return -- one of its tendrils
	end
	if id ~= f.CombatId or f.State == "Dying" then
		return
	end
	f.State = "Dying"
	f.CombatId = nil -- CombatService unregistered her
	if f.Mode ~= "" then
		-- The Deluge dies where it is, out of the floor
		f.Mode = "Up"
		f.Sink = 0
		wakeRate(f, 0)
		if f.Model then
			f.Model:PivotTo(pivot(f))
		end
	end
	setActivity("Death")
	local death = f.Tracks.Death
	if death then
		-- hold the last frame until she dissolves
		task.spawn(function()
			while death.IsPlaying and fight == f do
				if death.Length > 0 and death.TimePosition >= death.Length - 0.1 then
					death:AdjustSpeed(0)
					break
				end
				task.wait()
			end
		end)
	end
	for sacId in table.clone(f.Sacs) do
		removeSac(f, sacId, "Withered")
	end
	if f.Source then
		SourceFight.cleanup(sourceCtx, f, true) -- its tendrils and roots die with it
		-- and so does everything it made: the run is over or about to be, and nobody should lose a
		-- resident behind the victory's moment and the report (the second playtest did)
		monsters:Clear()
	end
	publish(true)
	local killer: Player? = nil
	for _, player in Players:GetPlayers() do
		if `P{player.UserId}` == f.LastHitBy then
			killer = player
		end
	end
	announce("Info", `{Boss.Title(f.Name)} IS DEAD{if killer then ` · FINISHED BY {string.upper(killer.DisplayName)}` else ""}`)
	log:Info("%s is dead (last blow: %s)", f.Name, if killer then killer.Name else "-")
	-- Defeated first: BossBeaten ends the Surge and the year moves on, and the run's story
	-- should say the year she fell.
	BossService.Defeated:Fire(f.BossId, killer)
	if f.Chamber then
		-- Section 5: "destroy the Source in its chamber, at any point in the run. The run ends at
		-- once". The win first: beaten in the final Surge too, this is the Deep Victory, not the
		-- Century's (CycleClock ends that Surge on BossBeaten only while the run is being played).
		deep:DimChamber(Boss.Tuning().DeathSeconds)
		if not director:Win("Deep") then
			log:Warn("the Source died in its chamber but the run couldn't be won (%s)", director:Phase())
		end
	end
	objectives:BossBeaten(f.BossId)
	task.delay(Boss.Tuning().DeathSeconds, function()
		if fight == f then
			cleanup(f)
			fight = nil
			publish(true)
		end
	end)
end

local function onDamaged(id: string, amount: number, source: string?, how: string?)
	local s = sleeper
	if s and id == s.CombatId then
		if amount > 0 and source and not fight then
			task.defer(wake, "hurt") -- after this hit is done with the sleeper's combatant
		end
		return
	end
	local f = fight
	if f and f.Source then
		SourceFight.onDamaged(f, id, source)
	end
	if not f or id ~= f.CombatId then
		return
	end
	if source then
		f.LastHitBy = source
	end
	if how == "weakpoint" and f.State == "Fighting" and (f.Mode == "" or f.Mode == "Up") then
		table.insert(f.Hits, { At = os.clock(), Amount = amount })
		while #f.Hits > 0 and os.clock() - f.Hits[1].At > f.T.StaggerWindowSeconds do
			table.remove(f.Hits, 1)
		end
		if os.clock() >= f.Busy and Boss.Staggers(f.Hits, os.clock(), f.T.StaggerWindowSeconds, f.T.StaggerFraction * f.Max) then
			stagger(f)
		end
	end
	publish()
end

-- Armour, weak points and burning sacs (WeaponService's hit modifier).
local function hitModifier(target: any, point: Vector3?, how: string, player: Player): (number, string?)
	local s = sleeper
	if s and target.Id == s.CombatId then
		return Config.Get("Tuning", "Source").ClosedMultiplier, nil -- asleep, its eye shut
	end
	local f = fight
	if not f then
		return 1, nil
	end
	if target.Id == f.CombatId and f.Model then
		if f.Mode == "Swim" or f.Mode == "Diving" then
			return f.T.SubmergedMultiplier, nil -- only its back fin shows
		end
		if f.Source and not SourceFight.open(f) then
			return f.T.ClosedMultiplier, nil -- its eye is shut: cut its tendrils down
		end
		if f.BossId == "CrystalColossus" and not f.Lit then
			return f.T.ArmourMultiplier, nil -- all armour until a light shows its cores
		end
		local weak = false
		if point then
			local tolerance = Boss.Tuning().WeakPointTolerance + (if how == "struck" or how == "smashed" then 2 else 0)
				+ (if how == "blast" then 3 else 0)
			for _, part in weakParts(f.Model) do
				if Boss.OnPart(point, part.CFrame, part.Size, tolerance) then
					weak = true
					break
				end
			end
		end
		local classValue = Modifiers.PlayerValue(player, "WeakPointMultiplier")
		if f.BossId == "CrystalColossus" and not weak then
			return f.T.ArmourMultiplier, nil -- "Huge, slow and armored"
		end
		return Boss.HitMultiplier(weak, classValue), if weak then "weakpoint" else nil
	end
	if f.Sacs[target.Id] and how == "burned" then
		return f.T.BurnMultiplier, nil
	end
	return 1, nil
end

-- DevTools ---------------------------------------------------------------------------------------------------

local function describe(): string
	local f = fight
	if not f then
		local s = sleeper
		if s then
			local p = s.At.Position
			return string.format("no boss fight; the Source sleeps in its chamber at (%.0f, %.0f, %.0f)", p.X, p.Y, p.Z)
		end
		return "no boss fight" .. (if waiting then ` ({waiting} waits)` else "")
	end
	local health, max = 0, f.Max
	if f.CombatId then
		health, max = combat:HealthOf(f.CombatId)
	end
	local count = 0
	for _ in f.Sacs do
		count += 1
	end
	if f.Mode ~= "" then
		return string.format("%s: %s (%s, %.0f s left), %d/%d health, phase %d, floor %d column %d (%.0f, %.0f, %.0f), %.1f under, path %d of %d, %s",
			f.Name, f.State, f.Mode, math.max(f.ModeUntil - os.clock(), 0), math.ceil(health), max, f.Phase, f.Floor, f.Column,
			f.X, f.Y, f.Z, f.Sink, f.PathIndex, #f.Path, tostring(f.Model and f.Model:GetAttribute("Activity")))
	end
	local line = string.format("%s: %s, %d/%d health, phase %d, arena floor %d columns %d to %d (x %.0f to %.0f), at x %.1f, %d egg sacs, %s",
		f.Name, f.State, math.ceil(health), max, f.Phase, f.Arena.Floor, f.Arena.From, f.Arena.To, f.Left, f.Right, f.X, count,
		tostring(f.Model and f.Model:GetAttribute("Activity")))
	if f.BossId == "CrystalColossus" then
		line ..= string.format(", cores %s, next volley in %.0f s", if f.Lit then "LIT" else "dark", math.max(f.NextVolley - os.clock(), 0))
	end
	if f.Source then
		local holds, all = SourceFight.counts(f)
		line ..= string.format("\nstage %d (%s), eye %s, %s, tendrils %d holding of %d: %s", f.Source.Stage, f.Source.Kind,
			if SourceFight.open(f) then "OPEN" else "shut", if f.Chamber then "in its chamber" else "in the bunker", holds, all,
			table.concat(SourceFight.places(f), "; "))
	end
	return line
end

local function registerCommands(dev: any)
	dev:Register("boss", {
		Description = "The boss fight now: state, health, phase, arena, egg sacs.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("boss.start", {
		Description = "Start a boss's fight now, outside its Surge (Studio testing).",
		Usage = "boss.start [BroodMother|Deluge|CrystalColossus|Source]",
		Run = function(_player, args): string?
			local ok, why = BossService:BeginFight(tostring(args[1] or "BroodMother"))
			return if ok then describe() else `can't: {why}`
		end,
	})
	dev:Register("boss.hurt", {
		Description = "Take health off the boss (weak: as belly hits, which can stagger her).",
		Usage = "boss.hurt <amount> [weak]",
		Run = function(player, args): string?
			local f = fight
			local amount = tonumber(args[1])
			if not f or not f.CombatId or not amount then
				return "usage: boss.hurt <amount> [weak] (during a fight)"
			end
			local source = if player then `P{player.UserId}` else nil
			combat:Damage(f.CombatId, amount, source, if args[2] == "weak" then "weakpoint" else "dev")
			return describe()
		end,
	})
	dev:Register("boss.lay", {
		Description = "The boss lays eggs now.",
		Run = function(): string?
			local f = fight
			if not f or f.State ~= "Fighting" then
				return "no boss fighting"
			end
			f.Busy = 0
			f.NextLay = 0
			return describe()
		end,
	})
	dev:Register("boss.freeze", {
		Description = "The boss stands still (no turning, walking, slams or eggs; sacs still hatch) for a while (Studio testing).",
		Usage = "boss.freeze [seconds]",
		Run = function(_player, args): string?
			local f = fight
			if not f or f.State ~= "Fighting" then
				return "no boss fighting"
			end
			local seconds = tonumber(args[1]) or 20
			f.Busy = os.clock() + seconds
			if f.Mode == "Up" then
				f.ModeUntil = f.Busy + 1
			end
			setActivity("Idle")
			return `frozen for {seconds} s\n{describe()}`
		end,
	})
	dev:Register("boss.volley", {
		Description = "The Crystal Colossus throws its shards now (Studio testing).",
		Run = function(): string?
			local f = fight
			if not f or f.State ~= "Fighting" or f.BossId ~= "CrystalColossus" then
				return "the Crystal Colossus isn't fighting"
			end
			f.Busy = 0
			f.NextVolley = 0
			return describe()
		end,
	})
	dev:Register("boss.light", {
		Description = "Show the Crystal Colossus's cores for a while, as a flare would (Studio testing).",
		Usage = "boss.light [seconds]",
		Run = function(_player, args): string?
			local f = fight
			if not f or f.BossId ~= "CrystalColossus" then
				return "no Crystal Colossus"
			end
			f.LitUntil = os.clock() + (tonumber(args[1]) or f.T.LitSeconds)
			return describe()
		end,
	})
	dev:Register("boss.dive", {
		Description = "The Deluge dives now (Studio testing).",
		Run = function(): string?
			local f = fight
			if not f or f.State ~= "Fighting" or f.Mode ~= "Up" then
				return "The Deluge isn't up"
			end
			f.Busy = 0
			delugeDive(f)
			return describe()
		end,
	})
	dev:Register("boss.surface", {
		Description = "The Deluge comes up at the next cell it reaches (Studio testing).",
		Run = function(): string?
			local f = fight
			if not f or f.State ~= "Fighting" or f.Mode ~= "Swim" then
				return "The Deluge isn't swimming"
			end
			f.ModeUntil = 0
			f.SwimFrom = 0
			return describe()
		end,
	})
	dev:Register("boss.wake", {
		Description = "Wake the Source asleep in its chamber (Studio testing).",
		Run = function(): string?
			local ok, why = wake("dev")
			return if ok then describe() else `can't: {why}`
		end,
	})
	dev:Register("boss.tendrils", {
		Description = "The Source's tendrils: where each stands and its health.",
		Run = function(): string?
			local f = fight
			if not f or not f.Source then
				return "the Source isn't fighting"
			end
			local lines = {}
			for id, tendril in f.Source.Tendrils do
				local health, max = combat:HealthOf(id)
				local p = tendril.At
				table.insert(lines, string.format("%s %s (%.0f, %.0f, %.0f) %d/%d%s %s", id, tendril.Where, p.X, p.Y, p.Z, math.ceil(health), max,
					if tendril.Holds then "" else " regrown", tostring(tendril.Model:GetAttribute("Activity"))))
			end
			table.sort(lines)
			return if #lines > 0 then table.concat(lines, "\n") else "no tendrils"
		end,
	})
	dev:Register("boss.cut", {
		Description = "Cut every tendril of the Source down now (Studio testing).",
		Run = function(): string?
			local f = fight
			if not f or not f.Source then
				return "the Source isn't fighting"
			end
			local n = SourceFight.skip(sourceCtx, f)
			return `cut {n} down\n{describe()}`
		end,
	})
	dev:Register("boss.roots", {
		Description = "The Source's roots burst up under the survivors near it now (Studio testing).",
		Run = function(): string?
			local f = fight
			if not f or not f.Source or f.State ~= "Fighting" then
				return "the Source isn't fighting"
			end
			return `{SourceFight.erupt(sourceCtx, f)} roots`
		end,
	})
	dev:Register("boss.regrow", {
		Description = "The Source grows a tendril back now (Studio testing).",
		Run = function(): string?
			local f = fight
			if not f or not f.Source or f.State ~= "Fighting" then
				return "the Source isn't fighting"
			end
			return if SourceFight.regrow(sourceCtx, f) then describe() else "nowhere for one to rise"
		end,
	})
	dev:Register("boss.end", {
		Description = "Take the boss away without beating her (cleanup).",
		Run = function(): string?
			local f = fight
			if not f then
				return "no boss fight"
			end
			cleanup(f)
			fight = nil
			waiting = nil
			publish(true)
			return "the boss is gone"
		end,
	})
end

-- Lifecycle ----------------------------------------------------------------------------------------------------

function BossService:Init(registry)
	clock = registry.CycleClock
	director = registry.RunDirector
	grid = registry.BunkerGrid
	session = registry.SessionService
	combat = registry.CombatService
	monsters = registry.MonsterService
	weapons = registry.WeaponService
	objectives = registry.ObjectiveService
	threat = registry.ThreatDirector
	disasters = registry.DisasterService
	deep = registry.DeepService
	collection = registry.ReplicationService:Collection("Boss")
	sourceCtx = {
		combat = combat,
		monsters = monsters,
		session = session,
		grid = grid,
		threat = threat,
		rng = rng,
		announce = announce,
		holder = holder,
		socket = socket,
		rockBurst = rockBurst,
		effectPart = effectPart,
		setActivity = setActivity,
		publish = publish,
		now = now,
		current = function(): Fight?
			return fight
		end,
	}
	registerCommands(registry.DevService)
end

function BossService:Start()
	local function begin(bossId: string)
		local ok, why = BossService:BeginFight(bossId)
		if not ok and fight then
			-- the Source was woken in its chamber: this boss comes when that fight is over
			waiting = bossId
			log:Info("the %s Surge waits: %s", bossId, tostring(why))
		elseif not ok then
			log:Warn("the %s Surge has no fight: %s", bossId, tostring(why))
		end
	end
	clock.SurgeStarted:Connect(function(kind: string, bossId: string?)
		-- an era's boss, or the final Surge's Source ("the Source rises into the bunker")
		if (kind == "Boss" or kind == "Final") and bossId then
			begin(bossId)
		end
	end)
	director.PhaseChanged:Connect(function(new: string)
		if new == "Ended" then
			waiting = nil
			local f = fight
			if f and f.State == "Dying" then
				return -- it died to end the run (the Deep Victory): its death plays out
			end
			if f then
				cleanup(f)
				fight = nil
				publish(true)
			end
		end
	end)
	deep.CaveOpened:Connect(function(_key: string, band: string)
		if band == "SourceChamber" then
			local ok, err = pcall(placeSleeper)
			if not ok then
				log:Warn("the Source's chamber: %s", tostring(err))
			end
		end
	end)
	combat.Died:Connect(onDied)
	combat.Damaged:Connect(onDamaged)
	weapons:SetHitModifier(hitModifier)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		local f = fight
		if f and f.Mode ~= "" then
			local ok, err = pcall(frameDeluge, f, math.min(dt, 0.1))
			if not ok then
				log:Warn("frame: %s", tostring(err))
			end
		elseif f and f.BossId == "CrystalColossus" then
			local ok, err = pcall(frameColossus, f, math.min(dt, 0.1))
			if not ok then
				log:Warn("frame: %s", tostring(err))
			end
		elseif f and f.Source then
			local ok, err = pcall(SourceFight.frame, sourceCtx, f, math.min(dt, 0.1))
			if not ok then
				log:Warn("frame: %s", tostring(err))
			end
		end
		acc += dt
		local step = Boss.Tuning().TickSeconds
		if acc >= step then
			local elapsed = math.min(acc, 0.5)
			acc = 0
			local ok, err = pcall(tick, elapsed)
			if not ok then
				log:Warn("tick: %s", tostring(err))
			end
			ok, err = pcall(between)
			if not ok then
				log:Warn("between fights: %s", tostring(err))
			end
		end
	end)
	log:Info("boss fights ready")
end

return BossService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000F6"><Properties><string name="Name">BreachService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BreachService: where monsters break in, the warning, and the spawns (bible Section 10).
	Run place only; Prompt 12.

	Breach points (Section 10; Section 6: every dug cell next to rock is a way in)
	* every room's vent (BunkerKit's Kit_Vent; the Shaft and the Blast Door have none);
	* every dug cell next to rock, on any floor (Landon, 2026-11-08: every tunnel touching rock
	  counts, not only the deepest band's);
	* cave openings and living nests in dug cells (DigService adds them, Prompt 14; the caves
	  behind the openings come with Prompt 17), and the Blast Door's surface threats with raids
	  (Prompt 16).
	Each point has a weight: DarkRoomWeight in a dark room (Section 6: dark rooms spawn monsters
	twice as often), BarricadeWeight when barricaded (its Barricaded attribute; the Engineer's
	barricades come with Prompt 20).

	Open(pointId, groups, tag)
	* BreachWarningSeconds of warning (Section 10: cracks, dust and a rumble give 10 seconds):
	  dust pours from the point and a red lamp pulses there; every player gets the BreachWarning
	  remote (the HUD's alert, the mini-map's marker) and the Breaches collection carries it for
	  the Command View's Threat overlay.
	* Then the monsters come out one by one (SpawnSpacingSeconds) through MonsterService.

	API:
		BreachService:Points(): { { Id, Kind, RoomId?, Floor, Column, Weight, Dark } }
		BreachService:Pick(rng): point?                    -- weighted
		BreachService:Open(pointId, groups, tag?): boolean
		BreachService:SetExtraPoint(id, point?)            -- Prompt 14: cave openings and nests
		BreachService:SetModifier(source, "DarkSpawnBonus", value?) -- Prompt 19: Deep Lamps scales the
		                                                   -- extra weight of dark rooms (0.5 halves it)
		BreachService.Opened: Signal<string, string?>      -- point id, tag (after the warning)
	Dev: breaches, breach.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)
local Threat = require(Shared.Rules.Threat)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("BreachService")

local BreachService = {
	Name = "BreachService",
	Dependencies = { "BunkerGrid", "PowerService", "MonsterService", "SessionService", "ReplicationService", "DevService" },
	Opened = Signal.new() :: Signal.Signal<string, string?>,
}

export type Point = {
	Id: string, -- "V:<roomId>" (a vent), "D:<floor>,<column>" (a dug cell at the rock), or one another service adds
	Kind: string, -- "Vent", "Rock", or another service's ("Cave", "Nest": DigService, Prompt 14)
	RoomId: string?,
	Floor: number,
	Column: number,
	Weight: number,
	Dark: boolean,
	At: CFrame, -- where monsters come out, on the floor, facing into the bunker
	Source: Vector3, -- the vent or the rock face, for the dust
}

local NO_VENT: { [string]: boolean } = { Shaft = true, BlastDoor = true }

local grid: any = nil
local power: any = nil
local monsters: any = nil
local session: any = nil
local dev: any = nil
local collection: any = nil

local warnings: { [string]: { EndsAt: number, Tag: string? } } = {}
local extra: { [string]: Point } = {} -- points other services add (Prompt 14: cave openings, nests)
local darkBonus: { [string]: number } = {} -- source -> DarkSpawnBonus (Prompt 19: Deep Lamps)

local function threatTuning(): { [string]: any }
	return Config.Get("Tuning", "Threat")
end

local function ventOf(room: any): (Vector3?, CFrame?)
	local model = grid:RoomModel(room.Id)
	if not model then
		return nil, nil
	end
	local vent = model:FindFirstChild("Vent", true)
	local socket = BunkerKit.Socket(model, "Vent")
	local position = if socket then socket.Position elseif vent and vent:IsA("BasePart") then vent.Position
		elseif vent and vent:IsA("Model") then (vent:GetBoundingBox()).Position else nil
	return position, socket
end

local function roomPoint(room: any, dark: boolean): Point
	local cell = Grid.CellPosition(room.Floor, room.Column)
	local vent = ventOf(room)
	local source = vent or (cell + Vector3.new(0, 6, -6))
	-- monsters drop from the vent to the floor in front of it, a little into the room
	local out = Vector3.new(source.X, cell.Y + 0.5, math.min(source.Z + 4, cell.Z + 4))
	local t = threatTuning()
	-- a dark room's extra weight, scaled by DarkSpawnBonus (Deep Lamps halves it: 2 becomes 1.5)
	local bonus = 1
	for _, v in darkBonus do
		bonus *= v
	end
	local weight = if dark then 1 + (t.DarkRoomWeight - 1) * bonus else 1
	return {
		Id = `V:{room.Id}`,
		Kind = "Vent",
		RoomId = room.Id,
		Floor = room.Floor,
		Column = room.Column,
		Weight = weight,
		Dark = dark,
		At = CFrame.lookAt(out, out + Vector3.new(0, 0, 1)),
		Source = source,
	}
end

-- Every dug cell next to rock, on any floor (Landon's answer to the Prompt 12 question: every
-- tunnel touching rock is a way in, not only the deepest band's).
local function rockPoints(): { Point }
	local list: { Point } = {}
	local t = Grid.Tuning()
	for floor = t.FloorMin, t.FloorMax do
		for column = t.ColumnMin, t.ColumnMax do
			local state = grid:State(floor, column)
			if state == "Dug" then
				local rockSide: number? = nil
				for _, dc in { -1, 1 } do
					if Grid.OnGrid(floor, column + dc) and grid:State(floor, column + dc) == "Rock" then
						rockSide = dc
					end
				end
				local below = Grid.OnGrid(floor + 1, column) and grid:State(floor + 1, column) == "Rock"
				if rockSide or below then
					local cell = Grid.CellPosition(floor, column)
					local side = rockSide or 0
					local source = cell + Vector3.new(side * (Grid.Pitch().X / 2 - 1), 3, 0)
					local out = cell + Vector3.new(side * (Grid.Pitch().X / 2 - 5), 0.5, 4)
					table.insert(list, {
						Id = `D:{floor},{column}`,
						Kind = "Rock",
						RoomId = nil,
						Floor = floor,
						Column = column,
						Weight = 1,
						Dark = false,
						At = CFrame.lookAt(out, out + Vector3.new(-side, 0, 1)),
						Source = source,
					})
				end
			end
		end
	end
	return list
end

function BreachService:Points(): { Point }
	local list: { Point } = {}
	for _, room in grid:Rooms() do
		if not NO_VENT[room.Type] then
			local point = roomPoint(room, power:IsDark(room.Id))
			local model = grid:RoomModel(room.Id)
			if model and model:GetAttribute("Barricaded") then
				point.Weight *= threatTuning().BarricadeWeight
			end
			table.insert(list, point)
		end
	end
	for _, point in rockPoints() do
		table.insert(list, point)
	end
	for _, point in extra do
		table.insert(list, point)
	end
	return list
end

-- A breach point another service owns (Prompt 14: a cave opening, a living nest); nil removes it.
function BreachService:SetModifier(source: string, key: string, value: number?)
	assert(key == "DarkSpawnBonus", `BreachService:SetModifier: {key} isn't a breach modifier`)
	darkBonus[source] = value
end

function BreachService:SetExtraPoint(id: string, point: Point?)
	extra[id] = point
end

function BreachService:Pick(rng: Random, exclude: { [string]: boolean }?): Point?
	local candidates = {}
	for _, point in BreachService:Points() do
		if not (exclude and exclude[point.Id]) then
			table.insert(candidates, point)
		end
	end
	local picked = Threat.Pick(candidates :: any, rng)
	return picked :: any
end

local function pointById(id: string): Point?
	for _, point in BreachService:Points() do
		if point.Id == id then
			return point
		end
	end
	return nil
end

local function placeName(point: Point): string
	if point.RoomId then
		local room = grid:Room(point.RoomId)
		if room then
			return string.upper(Config.Get("Rooms", room.Type).Name)
		end
	end
	if point.Kind == "Cave" then
		return `THE CAVE OPENING, FLOOR {point.Floor}`
	elseif point.Kind == "Nest" then
		return `THE NEST, FLOOR {point.Floor}`
	end
	return `THE ROCK, FLOOR {point.Floor}`
end

-- the warning in the world: dust from the vent or the rock, and a pulsing red lamp
local function warningEffect(point: Point, seconds: number)
	local part = Instance.new("Part")
	part.Name = `Breach_{point.Id}`
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(4, 1, 1)
	part.Position = point.Source
	local dust = Instance.new("ParticleEmitter")
	dust.Color = ColorSequence.new(Color3.fromRGB(150, 140, 128))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.6) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(1.2, 2.2)
	dust.Speed = NumberRange.new(2, 5)
	dust.SpreadAngle = Vector2.new(35, 35)
	dust.Acceleration = Vector3.new(0, -4, 0)
	dust.Rate = 26
	dust.Parent = part
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(232, 80, 59)
	light.Range = 16
	light.Brightness = 2
	light.Parent = part
	part.Parent = workspace:FindFirstChild("Monsters") or workspace
	task.spawn(function()
		local endsAt = os.clock() + seconds
		while os.clock() < endsAt and part.Parent do
			light.Brightness = if light.Brightness > 1 then 0.4 else 2.6
			task.wait(0.45)
		end
		dust.Rate = 60 -- the burst as they come out
		task.wait(1.2)
		part:Destroy()
	end)
end

local function publish(point: Point)
	local warning = warnings[point.Id]
	if warning then
		collection:Set(point.Id, {
			Floor = point.Floor,
			Column = point.Column,
			RoomId = point.RoomId,
			EndsAt = warning.EndsAt,
		})
	else
		collection:Remove(point.Id)
	end
end

function BreachService:Open(pointId: string, groups: { Threat.Group }, tag: string?): boolean
	local point = pointById(pointId)
	if not point or #groups == 0 then
		return false
	end
	local seconds = threatTuning().BreachWarningSeconds
	local endsAt = workspace:GetServerTimeNow() + seconds
	warnings[point.Id] = { EndsAt = endsAt, Tag = tag }
	publish(point)
	warningEffect(point, seconds)
	local total = 0
	for _, group in groups do
		total += group.Count
	end
	for _, player in session:ReadyPlayers() do
		Remotes.FireClient("BreachWarning", player, point.Floor, point.Column, seconds, placeName(point), total, point.RoomId)
	end
	log:Info("breach at %s in %d s: %d monsters (%s)", point.Id, seconds, total, tag or "-")
	task.delay(seconds, function()
		warnings[point.Id] = nil
		publish(point)
		BreachService.Opened:Fire(point.Id, tag)
		local spacing = threatTuning().SpawnSpacingSeconds
		local n = 0
		for _, group in groups do
			for _ = 1, group.Count do
				local offset = CFrame.new(((n % 3) - 1) * 2.2, 0, -math.floor(n / 3) * 0.6)
				monsters:Spawn(group.Type, point.At * offset, tag)
				n += 1
				task.wait(spacing)
			end
		end
	end)
	return true
end

function BreachService:Warnings(): number
	local n = 0
	for _ in warnings do
		n += 1
	end
	return n
end

function BreachService:Init(registry)
	grid = registry.BunkerGrid
	power = registry.PowerService
	monsters = registry.MonsterService
	session = registry.SessionService
	dev = registry.DevService
	collection = registry.ReplicationService:Collection("Breaches")

	dev:Register("breaches", {
		Description = "The breach points and their weights (Prompt 12).",
		Usage = "breaches",
		Run = function(): string?
			local lines = {}
			for _, point in BreachService:Points() do
				table.insert(lines, `{point.Id} {point.Kind} floor {point.Floor} weight {point.Weight}{if point.Dark then " (dark)" else ""}`)
			end
			return if #lines > 0 then table.concat(lines, "\n") else "no breach points"
		end,
	})
	dev:Register("breach", {
		Description = "Open a breach now: a point (or a weighted pick), a monster type and how many.",
		Usage = "breach [pointId|any] [Type] [count]",
		Run = function(_player, args): string?
			local rng = Random.new()
			local pointId = tostring(args[1] or "any")
			if pointId == "any" then
				local point = BreachService:Pick(rng)
				if not point then
					return "no breach points"
				end
				pointId = point.Id
			end
			local monsterType = tostring(args[2] or "BurrowTick")
			if not Config.Find("Monsters", monsterType) then
				return `no monster {monsterType}`
			end
			local count = math.clamp(math.floor(tonumber(args[3]) or 3), 1, 25)
			local ok = BreachService:Open(pointId, { { Type = monsterType, Count = count } }, "Dev")
			return if ok then `breach at {pointId}: {count} {monsterType} in {threatTuning().BreachWarningSeconds} s` else `no point {pointId}`
		end,
	})
end

function BreachService:Start()
	log:Info("breach points ready")
end

return BreachService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000F7"><Properties><string name="Name">BuildService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BuildService: construction, upgrades, merges and teardown (bible Sections 6 and 8). Run
	place only.

	* Proposing: a player proposes from the Command View (the Propose remote).
	  Rules.Construction.Plan checks it against the bunker, the unlocks, the stockpile, Lab
	  research, and the cells already held by open votes and construction sites. Then
	  VoteService puts it to the team (in a solo run it applies at once).
	* When the vote passes, it is planned again (anything may have changed meanwhile) and paid
	  for (EconomyService), and then:
	  * Build: a construction site goes on the cell. It takes 20 s a cell
	    (Tuning.Rooms.BuildSecondsPerCell), 25% faster for every player standing in it
	    (HelperBuildSpeed; residents join with Prompt 10). When it's done the room is placed
	    (BunkerGrid).
	  * Upgrade: the room's level goes up at once (Landon, Nov 8, 2026). On a difficulty with
	    UpgradesTakeTime (Nightmare) it becomes a construction site over the room instead, as
	    long as building would take; the room keeps working at its old level until it is done.
	  * Merge: the two rooms become one at once.
	  * TearDown: the room goes at once and its cells are open cells again. Part of what it cost
	    comes back (Landon, Nov 8, 2026): the plan's Refund, Tuning.Rooms.TearDownRefund of every
	    level's cost so far (Rules.Construction.Refund), up to the stockpile's caps.
	* Sites replicate in the Sites collection: id -> { Kind ("Build" or "Upgrade"), Type, Floor,
	  Column, Span, Level (an upgrade's new level), RoomId (an upgrade's room), Progress (0 to
	  1), Helpers, Seconds }. In the world they stand in workspace.Bunker.Sites (BunkerKit.Site).
	* Rooms won from blueprint drafts and cryo pods: Unlock(roomType) (Prompts 17 and 19). They
	  replicate in the Unlocked collection (room type -> true) for the Command View's menu.
	* Class modifiers (Prompt 20): SetModifier(source, "BuildCost" | "BuildSpeed", value?). Build
	  and upgrade costs (and tear-down refunds) take the BuildCost product (the Quartermaster;
	  RunState BuildCost tells the Command View); sites build BuildSpeed times as fast (the Warden).
	* Repairs (Prompt 13; Section 6: at 0 HP a room is wrecked and stops until repaired with the
	  Welder; residents slowly repair the room they work in; Section 11: Smarts is repair speed):
	  * the Welder: a player using it (WeaponService.ToolTick) repairs the first damaged room in
	    front of them within WelderReach, WelderPerSecond (RepairSpeed: the Engineer twice as
	    fast). Their Welding attribute names the room (or "" when nothing there needs it);
	  * residents at work in their own room (body there, Activity Work) repair it
	    ResidentRepairPerSecond times Smarts over ResidentSmartsBase, every second;
	  * a wrecked room works again at Tuning.Repairs.RepairedAt of its HP (Rules.Bunker).
	  The team hears when a room is wrecked (not the Reactor Core: its meltdown says enough) and
	  when it works again.

	API:
		BuildService:Propose(player, proposal): (boolean, string?)
		BuildService:Unlock(roomType), :Unlocked(): { [string]: boolean }
		BuildService:SetCellCheck(fn(floor, column) -> (ok, why?))  -- Prompt 14: what a dug cell holds
		BuildService:Reserved(exceptVoteId?): { [string]: boolean }  -- votes' and sites' cells
		BuildService:FinishSite(id): boolean                           -- DevTools
		BuildService:Repair(roomId, amount, how, player?): number      -- HP it added (fractions carry)
		BuildService:SetModifier(source, key, value?)                  -- BuildCost, BuildSpeed (Prompt 20)
		BuildService.Proposed: Signal<Player, string>   -- proposer, action (first-run objective 2)
		BuildService.Built: Signal<string, string>      -- room id, action (Build, Upgrade, Merge)
		BuildService.TornDown: Signal<string, string>   -- room id, room type
		BuildService.Repaired: Signal<string, number, string, Player?> -- room id, HP, "Welder" or "Residents", who
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Bunker = require(Shared.Rules.Bunker)
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Disasters = require(Shared.Rules.Disasters)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("BuildService")

local BuildService = {
	Name = "BuildService",
	Dependencies = {
		"BunkerGrid", "EconomyService", "VoteService", "SessionService", "RunDirector", "ReplicationService",
		"WeaponService", "CombatService", "ResidentService", "DevService",
	},
	Proposed = Signal.new() :: Signal.Signal<Player, string>,
	Built = Signal.new() :: Signal.Signal<string, string>,
	TornDown = Signal.new() :: Signal.Signal<string, string>,
	Repaired = Signal.new() :: Signal.Signal<string, number, string, Player?>,
}

type Site = {
	Id: string,
	Kind: "Build" | "Upgrade",
	RoomId: string?, -- Upgrade: the room
	Level: number?, -- Upgrade: its new level
	Type: string,
	Floor: number,
	Column: number,
	Span: number,
	Cells: { string },
	Seconds: number,
	Done: number, -- seconds of work done (helpers make it grow faster)
	Helpers: number,
	Sent: number, -- the progress last replicated
	Model: Model?,
}

local grid: any = nil
local economy: any = nil
local votes: any = nil
local session: any = nil
local director: any = nil
local sitesCollection: any = nil
local unlockedCollection: any = nil
local sites: { [string]: Site } = {}
local siteCount = 0
local unlocked: { [string]: boolean } = {}
local weapons: any = nil
local combat: any = nil
local residents: any = nil
local repairCarry: { [string]: number } = {} -- room id -> HP of repair not yet whole
local repairing: { [string]: { Welders: number, Residents: number } } = {} -- this second's repairs (DevTools)

local function roomName(roomType: string): string
	return Config.Get("Rooms", roomType).Name
end

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function announce(text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), "Info", text)
end

-- "The stockpile is 70 Scrap short." -> "the stockpile is 70 Scrap short" (the banner adds FAILED:)
local function clause(text: string): string
	local trimmed = string.gsub(text, "%.$", "")
	return (string.gsub(trimmed, "^%u", string.lower))
end

function BuildService:Reserved(exceptVoteId: string?): { [string]: boolean }
	local cells = votes:Reserved(exceptVoteId)
	for _, site in sites do
		for _, key in site.Cells do
			cells[key] = true
		end
	end
	return cells
end

-- Class modifiers (Prompt 20): key -> source -> value.
local modifiers: { [string]: { [string]: number } } = {}
local setRun = RunState.Writer("BuildService")

local function product(key: string): number
	local value = 1
	for _, v in modifiers[key] or {} do
		value *= v
	end
	return value
end

function BuildService:SetModifier(source: string, key: string, value: number?)
	assert(key == "BuildCost" or key == "BuildSpeed", `BuildService:SetModifier: {key} isn't a build modifier`)
	modifiers[key] = modifiers[key] or {}
	modifiers[key][source] = value
	if key == "BuildCost" then
		local cost = product("BuildCost")
		setRun("BuildCost", if math.abs(cost - 1) > 1e-6 then cost else nil)
	end
end

local function context(exceptVoteId: string?): Construction.Context
	return {
		Era = table.find(Config.Ids("Eras"), RunState.Get("Era") or "") or 1,
		Deepest = grid:DeepestFloor(),
		Unlocked = unlocked,
		Stock = economy:Stock(),
		Research = economy:Research(),
		Reserved = BuildService:Reserved(exceptVoteId),
		CostMultiplier = product("BuildCost"),
	}
end

-- Sites ---------------------------------------------------------------------------------------------

local function publishSite(site: Site)
	local progress = math.floor(math.min(1, site.Done / site.Seconds) * 100) / 100
	site.Sent = progress
	sitesCollection:Set(site.Id, {
		Kind = site.Kind,
		RoomId = site.RoomId,
		Level = site.Level,
		Type = site.Type,
		Floor = site.Floor,
		Column = site.Column,
		Span = site.Span,
		Progress = progress,
		Helpers = site.Helpers,
		Seconds = site.Seconds,
	})
end

local function sitesFolder(): Instance?
	local root = grid:Root()
	if not root then
		return nil
	end
	local folder = root:FindFirstChild("Sites")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Sites"
		folder.Parent = root
	end
	return folder
end

local function startSite(plan: Construction.Plan)
	siteCount += 1
	local upgrade = plan.Action == "Upgrade"
	local site: Site = {
		Id = `S{siteCount}`,
		Kind = if upgrade then "Upgrade" else "Build",
		RoomId = if upgrade then plan.RoomId else nil,
		Level = if upgrade then plan.Level else nil,
		Type = plan.RoomType,
		Floor = plan.Floor,
		Column = plan.Column,
		Span = plan.Span,
		Cells = Construction.Cells(plan),
		Seconds = Construction.Seconds(plan.Span),
		Done = 0,
		Helpers = 0,
		Sent = -1,
	}
	local folder = sitesFolder()
	if folder then
		site.Model = BunkerKit.Site(folder, site.Id, site.Type, site.Floor, site.Column, site.Span, upgrade)
	end
	sites[site.Id] = site
	publishSite(site)
	if upgrade then
		log:Info("%s: upgrading %s to level %d (%d s)", site.Id, tostring(site.RoomId), site.Level or 0, site.Seconds)
		announce(`UPGRADING THE {string.upper(roomName(site.Type))}: STAND IN IT TO HELP`)
	else
		log:Info("%s: building a %s at %s (%d s)", site.Id, site.Type, Grid.Key(site.Floor, site.Column), site.Seconds)
		announce(`BUILDING A {string.upper(roomName(site.Type))}: STAND IN IT TO HELP`)
	end
end

local function upgradeNow(roomId: string, roomType: string, level: number)
	local ok, err = grid:SetLevel(roomId, level)
	if ok then
		announce(`{string.upper(roomName(roomType))} UPGRADED TO LEVEL {level}`)
		BuildService.Built:Fire(roomId, "Upgrade")
	else
		log:Warn("upgrade of %s failed: %s", roomId, tostring(err))
	end
end

local function finishSite(site: Site)
	sites[site.Id] = nil
	sitesCollection:Remove(site.Id)
	if site.Model then
		site.Model:Destroy()
	end
	if site.Kind == "Upgrade" then
		log:Info("%s done: %s is level %d", site.Id, tostring(site.RoomId), site.Level or 0)
		upgradeNow(site.RoomId :: string, site.Type, site.Level :: number)
		return
	end
	local roomId, why = grid:PlaceRoom(site.Type, site.Floor, site.Column, site.Span)
	if roomId then
		log:Info("%s done: %s is %s", site.Id, site.Type, roomId)
		announce(`{string.upper(roomName(site.Type))} BUILT`)
		BuildService.Built:Fire(roomId, "Build")
	else
		log:Warn("%s couldn't place its %s: %s", site.Id, site.Type, tostring(why))
	end
end

function BuildService:FinishSite(id: string): boolean
	local site = sites[id]
	if not site then
		return false
	end
	finishSite(site)
	return true
end

-- Players standing in a site's cells (alive).
local function helpersAt(site: Site): number
	local n = 0
	for _, player in session:ReadyPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			local floor, column = Grid.CellAt(root.Position)
			if floor == site.Floor and column and column >= site.Column and column < site.Column + site.Span then
				n += 1
			end
		end
	end
	return n
end

local function tick(dt: number)
	for _, site in sites do
		site.Helpers = helpersAt(site)
		site.Done += dt * Construction.Rate(site.Helpers) * product("BuildSpeed")
		if site.Done >= site.Seconds then
			finishSite(site)
		else
			local progress = site.Done / site.Seconds
			if site.Model then
				BunkerKit.SetSiteProgress(site.Model, progress)
			end
			local current = sitesCollection:Get(site.Id)
			if progress - site.Sent >= 0.01 or (current and current.Helpers ~= site.Helpers) then
				publishSite(site)
			end
		end
	end
end

-- Applying a passed proposal ------------------------------------------------------------------------

local function apply(plan: Construction.Plan)
	local paid, why = economy:Spend(plan.Costs, plan.Label)
	if not paid then
		log:Warn("%s passed but couldn't be paid: %s", plan.Label, tostring(why))
		announce(`{plan.Label}: {string.upper(why or "can't pay")}`)
		return
	end
	if plan.Action == "Build" then
		startSite(plan)
	elseif plan.Action == "Upgrade" then
		local difficulty = Config.Find("Difficulties", director:Difficulty())
		if difficulty and difficulty.UpgradesTakeTime then
			startSite(plan)
		else
			upgradeNow(plan.RoomId :: string, plan.RoomType, plan.Level :: number)
		end
	elseif plan.Action == "Merge" then
		local merged, err = grid:MergeRooms(plan.RoomId :: string, plan.Other :: string)
		if merged then
			announce(`{string.upper(roomName(plan.RoomType))} MERGED`)
			BuildService.Built:Fire(merged, "Merge")
		else
			log:Warn("merge of %s and %s failed: %s", tostring(plan.RoomId), tostring(plan.Other), tostring(err))
		end
	elseif plan.Action == "TearDown" then
		local roomId = plan.RoomId :: string
		local ok, err = grid:RemoveRoom(roomId)
		if ok then
			local back = {}
			for _, id in Config.Ids("Resources") do
				local amount = plan.Refund and plan.Refund[id]
				if amount and amount > 0 then
					local added = economy:Add(id, amount, `refund for {plan.Label}`)
					if added > 0 then
						back[id] = added
					end
				end
			end
			announce(if next(back) then `{string.upper(roomName(plan.RoomType))} TORN DOWN: {Construction.CostText(back)} BACK`
				else `{string.upper(roomName(plan.RoomType))} TORN DOWN`)
			BuildService.TornDown:Fire(roomId, plan.RoomType)
		else
			log:Warn("teardown of %s failed: %s", roomId, tostring(err))
		end
	end
end

-- Proposals ------------------------------------------------------------------------------------------

-- The ghost outline's label in the Command View: "KITCHEN?", "LEVEL 2?", "MERGE?", "TEAR DOWN?".
local function ghostLabel(plan: Construction.Plan): string
	if plan.Action == "Build" then
		return `{string.upper(roomName(plan.RoomType))}?`
	elseif plan.Action == "Upgrade" then
		return `LEVEL {plan.Level}?`
	elseif plan.Action == "Merge" then
		return "MERGE?"
	end
	return "TEAR DOWN?"
end

-- Something in a dug cell that has to be dealt with before a room goes on it (Prompt 14: a nest, a
-- cache, a cave opening; DigService sets the check).
local cellCheck: ((floor: number, column: number) -> (boolean, string?))? = nil

function BuildService:SetCellCheck(fn: ((floor: number, column: number) -> (boolean, string?))?)
	cellCheck = fn
end

local function cellsClear(plan: Construction.Plan): (boolean, string?)
	local check = cellCheck
	if not check or plan.Action ~= "Build" then
		return true, nil
	end
	for _, key in Construction.Cells(plan) do
		local floor, column = Grid.Parse(key)
		if floor and column then
			local ok, why = check(floor, column)
			if not ok then
				return false, why
			end
		end
	end
	return true, nil
end

function BuildService:Propose(player: Player, proposal: Construction.Proposal): (boolean, string?)
	local ok, why = votes:CanPropose(player)
	if not ok then
		return false, why
	end
	local plan, reason = Construction.Plan(grid:Bunker(), proposal, context(nil))
	if not plan then
		return false, reason
	end
	local clear, blocked = cellsClear(plan)
	if not clear then
		return false, blocked
	end
	local voteId: string? = nil
	local latest: Construction.Plan = plan
	local id, err = votes:Open({
		Kind = "Build",
		Proposer = player,
		Title = plan.Label,
		Costs = plan.Costs,
		Refund = plan.Refund,
		Subject = { Floor = plan.Floor, Column = plan.Column, Span = plan.Span, Label = ghostLabel(plan) },
		Cells = Construction.Cells(plan),
		Check = function(): (boolean, string?)
			local again, why2 = Construction.Plan(grid:Bunker(), proposal, context(voteId))
			if again then
				local clear2, blocked2 = cellsClear(again)
				if not clear2 then
					return false, blocked2
				end
				latest = again
				return true, nil
			end
			return false, clause(why2 or "it can't be done any more")
		end,
		OnPass = function()
			apply(latest)
		end,
	})
	if not id then
		return false, err
	end
	voteId = id
	log:Info("%s proposed %s (%s)", player.Name, plan.Label, id)
	BuildService.Proposed:Fire(player, plan.Action)
	return true, nil
end

function BuildService:Unlock(roomType: string)
	assert(Config.Find("Rooms", roomType), `BuildService: no room type {roomType}`)
	unlocked[roomType] = true
	unlockedCollection:Set(roomType, true)
end

function BuildService:Unlocked(): { [string]: boolean }
	return table.clone(unlocked)
end

-- Lifecycle ------------------------------------------------------------------------------------------

local function describeSites(): string
	local lines = {}
	for id, site in sites do
		table.insert(lines, string.format("%s %s %s at %s: %.0f%% (%d helping, %.1f of %d s)", id, site.Kind, site.Type,
			Grid.Key(site.Floor, site.Column), math.min(1, site.Done / site.Seconds) * 100, site.Helpers, site.Done, site.Seconds))
	end
	table.sort(lines)
	return if #lines > 0 then table.concat(lines, "\n") else "no construction sites"
end

-- Repairs (Prompt 13) -----------------------------------------------------------------------------

function BuildService:Repair(roomId: string, amount: number, how: string, player: Player?): number
	local room = grid:Room(roomId)
	if not room or room.HP >= room.MaxHP or amount <= 0 then
		repairCarry[roomId] = nil
		return 0
	end
	local carry = (repairCarry[roomId] or 0) + amount
	local whole = math.floor(carry)
	repairCarry[roomId] = carry - whole
	if whole < 1 then
		return 0
	end
	local before = room.HP
	local hp = grid:SetHP(roomId, before + whole) or before
	local done = hp - before
	if done > 0 then
		BuildService.Repaired:Fire(roomId, done, how, player)
	end
	return done
end

local function unitAt(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

-- The room a Welder points at: the first damaged room along the player's facing within
-- WelderReach (their own room first), else the first room there (to say it needs nothing).
local function weldTarget(at: CFrame): (string?, boolean)
	local reach = Disasters.Repairs().WelderReach
	local first: string? = nil
	for _, d in { 0, 3, 6, reach } do
		local unit = unitAt(at.Position + at.LookVector * d)
		local room = if unit then grid:Room(unit) else nil
		if room then
			first = first or room.Id
			if room.HP < room.MaxHP then
				return room.Id, true
			end
		end
	end
	return first, false
end

local function onToolTick(player: Player, tool: string, at: CFrame, dt: number)
	if tool ~= "Welder" then
		return
	end
	local roomId, needs = weldTarget(at)
	player:SetAttribute("Welding", if roomId and needs then roomId else "")
	if roomId and needs then
		local speed = Modifiers.PlayerValue(player, "RepairSpeed") or 1
		BuildService:Repair(roomId, Disasters.WelderPerSecond(speed) * dt, "Welder", player)
		local entry = repairing[roomId] or { Welders = 0, Residents = 0 }
		entry.Welders += 1
		repairing[roomId] = entry
	end
end

-- Residents repair the room they work in while they are at work in it (Section 6).
local function residentRepairs(dt: number)
	local rates: { [string]: number } = {}
	local counts: { [string]: number } = {}
	for _, c in combat:All("Survivors") do
		if c.Kind == "Resident" and c.State == "Alive" and c.ResidentId and c.Model:GetAttribute("Activity") == "Work" then
			local resident = residents:Get(c.ResidentId)
			if resident and resident.State == "Alive" and resident.Job and unitAt(c.Root.Position) == resident.Job then
				rates[resident.Job] = (rates[resident.Job] or 0) + Disasters.ResidentRepairPerSecond(resident.Stats.Smarts or 0)
				counts[resident.Job] = (counts[resident.Job] or 0) + 1
			end
		end
	end
	for roomId, rate in rates do
		local room = grid:Room(roomId)
		if room and room.HP < room.MaxHP then
			BuildService:Repair(roomId, rate * dt, "Residents")
			local entry = repairing[roomId] or { Welders = 0, Residents = 0 }
			entry.Residents = counts[roomId]
			repairing[roomId] = entry
		end
	end
end

local function describeRepairs(): string
	local lines = {}
	for _, room in grid:Rooms() do
		if room.HP < room.MaxHP or room.Wrecked then
			local entry = repairing[room.Id]
			table.insert(lines, string.format("%s %s: %d/%d HP%s; works again at %d%s", room.Id, room.Type, room.HP, room.MaxHP,
				if room.Wrecked then " WRECKED" else "", Bunker.RepairedAt(room.MaxHP),
				if entry then `; last second {entry.Welders} welder ticks, {entry.Residents} residents` else ""))
		end
	end
	return if #lines > 0 then table.concat(lines, "\n") else "every room is at full HP"
end

function BuildService:Init(registry)
	grid = registry.BunkerGrid
	weapons = registry.WeaponService
	combat = registry.CombatService
	residents = registry.ResidentService
	economy = registry.EconomyService
	votes = registry.VoteService
	session = registry.SessionService
	director = registry.RunDirector
	sitesCollection = registry.ReplicationService:Collection("Sites")
	unlockedCollection = registry.ReplicationService:Collection("Unlocked")
	Remotes.OnServer("Propose", function(player: Player, action: string, floor: number, column: number, detail: string)
		local proposal: Construction.Proposal = {
			Action = action :: Construction.Action,
			Floor = floor,
			Column = column,
			RoomType = if action == "Build" then detail else nil,
			Other = if action == "Merge" then detail else nil,
		}
		local ok, why = BuildService:Propose(player, proposal)
		if not ok and why then
			alert(player, "Warning", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("build", {
		Description = "Propose construction as you would from the Command View.",
		Usage = "build <Build|Upgrade|Merge|TearDown> <floor> <column> [roomType|otherRoomId]",
		Run = function(caller: Player?, args): string?
			-- from Studio's server tools there's no caller: act as the first player in the run
			local player = caller or session:ReadyPlayers()[1]
			if not player then
				return "nobody is in the run to propose as"
			end
			local action, floor, column = tostring(args[1] or ""), tonumber(args[2]), tonumber(args[3])
			if not table.find({ "Build", "Upgrade", "Merge", "TearDown" }, action) or not floor or not column then
				return "usage: build <Build|Upgrade|Merge|TearDown> <floor> <column> [roomType|otherRoomId]"
			end
			local detail = if args[4] ~= nil then tostring(args[4]) else nil
			local ok, why = BuildService:Propose(player, {
				Action = action :: Construction.Action,
				Floor = floor,
				Column = column,
				RoomType = if action == "Build" then detail else nil,
				Other = if action == "Merge" then detail else nil,
			})
			return if ok then `proposed\n{describeSites()}` else `refused: {why}`
		end,
	})
	dev:Register("sites", {
		Description = "Construction sites and their progress.",
		Usage = "sites",
		Run = function(): string?
			return describeSites()
		end,
	})
	dev:Register("site.finish", {
		Description = "Finish a construction site now (or every site).",
		Usage = "site.finish [id]",
		Run = function(_player: Player, args): string?
			local id = if args[1] ~= nil then tostring(args[1]) else nil
			local done = 0
			for siteId in table.clone(sites) do
				if id == nil or siteId == id then
					if BuildService:FinishSite(siteId) then
						done += 1
					end
				end
			end
			return `finished {done} site(s)\n{describeSites()}`
		end,
	})
	dev:Register("repairs", {
		Description = "Damaged and wrecked rooms, and who is repairing them (Prompt 13).",
		Usage = "repairs",
		Run = function(): string?
			return describeRepairs()
		end,
	})
	dev:Register("repair", {
		Description = "Repair a room by an amount of HP (or fully), as a Welder would.",
		Usage = "repair <roomId> [hp]",
		Run = function(_player: Player, args): string?
			local id = tostring(args[1] or "")
			local room = grid:Room(id)
			if not room then
				return "usage: repair <roomId> [hp] (see grid.rooms)"
			end
			BuildService:Repair(id, tonumber(args[2]) or (room.MaxHP - room.HP), "Welder", nil)
			return describeRepairs()
		end,
	})
	dev:Register("unlock", {
		Description = "Unlock a room type as if a blueprint draft had won it.",
		Usage = "unlock <roomType>",
		Run = function(_player: Player, args): string?
			local roomType = tostring(args[1] or "")
			if not Config.Find("Rooms", roomType) then
				return "usage: unlock <roomType>"
			end
			BuildService:Unlock(roomType)
			return `unlocked {roomType}`
		end,
	})
end

function BuildService:Start()
	local acc, repairAcc = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc >= 0.25 then
			tick(acc)
			acc = 0
		end
		repairAcc += dt
		if repairAcc >= 1 then
			table.clear(repairing)
			if director:Phase() == "Playing" then
				local ok, err = pcall(residentRepairs, repairAcc)
				if not ok then
					log:Warn("resident repairs: %s", tostring(err))
				end
			end
			repairAcc = 0
		end
	end)
	weapons.ToolTick:Connect(onToolTick)
	-- the team hears when a room is wrecked and when it works again (Prompt 13)
	grid.Wrecked:Connect(function(roomId: string)
		local room = grid:Room(roomId)
		if room and room.Type ~= "ReactorCore" then
			Remotes.FireClients("Alert", session:ReadyPlayers(), "Danger",
				`THE {string.upper(roomName(room.Type))} IS WRECKED: REPAIR IT WITH A WELDER`)
		end
	end)
	grid.Repaired:Connect(function(roomId: string)
		local room = grid:Room(roomId)
		if room then
			announce(`THE {string.upper(roomName(room.Type))} IS REPAIRED AND WORKING AGAIN`)
		end
	end)
end

return BuildService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000F8"><Properties><string name="Name">BunkerGrid</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BunkerGrid: the bunker's cells, rooms, levels, merges and the room graph (bible Sections 6
	and 23). Run place only.

	The data and its rules are Shared.Rules.Bunker (Rock, Dug and room cells; dig left, right
	or down; rooms on Dug cells, MaxCells, Unique, Fixed, floor rules; matching rooms merge;
	levels 1 to 3; the graph of doorways and Shafts). This service holds the run's one bunker,
	starts it from Tuning.StartingBunker, builds the world from it (Lib.BunkerKit, graybox
	until the A1 art) and replicates it:
	* Cells collection: "floor,column" -> { Room = id } for every open cell ({} when Dug);
	* Rooms collection: id -> { Type, Floor, Column, Span, Level, HP, MaxHP, Wrecked }.

	HP (Prompt 13): SetHP is how damage and repairs land. A room at 0 HP is Wrecked until it is
	repaired to Tuning.Repairs.RepairedAt of its maximum (Rules.Bunker); Wrecked and Repaired
	fire when that changes. SetHPModifier applies the RoomHP (every room) and BlastDoorHealth
	(the Blast Door) multipliers from draft cards and classes.

	Votes, costs and build time are BuildService's (Prompt 8); dig time, cell rolls and Push
	Deeper are DigService's (Prompt 14). They call the methods below.

	API:
		BunkerGrid:Bunker(): Bunker               -- the live data: read only
		BunkerGrid:State(floor, column), :Room(id), :RoomAt(floor, column), :Rooms(), :RoomsOfType(type)
		BunkerGrid:Dig(floor, column): (boolean, string?)
		BunkerGrid:PlaceRoom(type, floor, column, span, level?): (string?, string?)
		BunkerGrid:RemoveRoom(id): (boolean, string?)
		BunkerGrid:MergeRooms(a, b): (string?, string?)
		BunkerGrid:SetLevel(id, level): (boolean, string?)
		BunkerGrid:SetHP(id, hp): number?
		BunkerGrid:SetHPModifier(source, key, value?)  -- RoomHP or BlastDoorHealth; nil clears
		BunkerGrid:Neighbors(unit), :Graph(), :DeepestFloor()
		BunkerGrid:RoomModel(id): Model?, :Root(): Folder
		BunkerGrid.Changed: Signal<{ string }>    -- the cell keys whose state changed
		BunkerGrid.RoomChanged: Signal<string>    -- a room was added, changed or removed
	BunkerGrid.Wrecked: Signal<string>        -- a room's HP reached 0 (Prompt 13: the Reactor Core melts down)
	BunkerGrid.Repaired: Signal<string>       -- a wrecked room works again
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Bunker = require(Shared.Rules.Bunker)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("BunkerGrid")

local BunkerGrid = {
	Name = "BunkerGrid",
	Dependencies = { "ReplicationService", "DevService" },
	Changed = Signal.new() :: Signal.Signal<{ string }>,
	RoomChanged = Signal.new() :: Signal.Signal<string>,
	Wrecked = Signal.new() :: Signal.Signal<string>,
	Repaired = Signal.new() :: Signal.Signal<string>,
}

-- Which room types an HP modifier key scales (Config.Modifiers, Prompt 13).
local HP_KEYS: { [string]: string } = { RoomHP = "All", BlastDoorHealth = "BlastDoor" }

local CODES: { [string]: string } = {
	BlastDoor = "BLD", Shaft = "SHF", ReactorCore = "RCT", Generator = "GEN", Kitchen = "KIT",
	WaterPurifier = "WTR", Quarters = "QTR", Medbay = "MED", Storage = "STO", Workshop = "WRK",
	Armory = "ARM", RadioRoom = "RAD", Lounge = "LNG", Lab = "LAB", DrillBay = "DRL",
	Greenhouse = "GRN", TrainingRoom = "TRN", DeconRoom = "DCN", CryoBay = "CRY",
	TradingPost = "TRD", Memorial = "MEM",
}

local bunker: Bunker.Bunker = Bunker.new()
local root: Folder? = nil
local cellsCollection: any = nil
local roomsCollection: any = nil
local hpModifiers: { [string]: { [string]: number } } = {} -- key -> source -> multiplier

-- Replication and the world ---------------------------------------------------------------

local function publishRoom(id: string)
	local room = bunker:Room(id)
	if room then
		roomsCollection:Set(id, {
			Type = room.Type,
			Floor = room.Floor,
			Column = room.Column,
			Span = room.Span,
			Level = room.Level,
			HP = room.HP,
			MaxHP = room.MaxHP,
			Wrecked = room.Wrecked,
		})
	elseif roomsCollection:Get(id) ~= nil then
		roomsCollection:Remove(id)
	end
end

local function publishCell(key: string)
	local floor, column = Grid.Parse(key)
	if not floor or not column then
		return
	end
	local state, id = bunker:State(floor, column)
	if state == "Dug" then
		cellsCollection:Set(key, {})
	elseif state == "Room" then
		cellsCollection:Set(key, { Room = id })
	elseif cellsCollection:Get(key) ~= nil then
		cellsCollection:Remove(key)
	end
end

-- The cells of these rooms and cells, and their neighbours left, right, above and below.
local function around(cells: { { number } }): { [string]: boolean }
	local dirty: { [string]: boolean } = {}
	for _, cell in cells do
		local floor, column = cell[1], cell[2]
		for _, offset in { { 0, 0 }, { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
			local f, c = floor + offset[1], column + offset[2]
			if Grid.OnGrid(f, c) then
				dirty[Grid.Key(f, c)] = true
			end
		end
	end
	return dirty
end

local function roomCells(room: Bunker.Room): { { number } }
	local cells = {}
	for offset = 0, room.Span - 1 do
		table.insert(cells, { room.Floor, room.Column + offset })
	end
	return cells
end

-- After a change: replicate the changed cells and rooms, rebuild the world around them.
local function changed(cells: { { number } }, roomIds: { string })
	local keys = {}
	for _, cell in cells do
		local key = Grid.Key(cell[1], cell[2])
		table.insert(keys, key)
		publishCell(key)
	end
	for _, id in roomIds do
		publishRoom(id)
	end
	if root then
		BunkerKit.Sync(bunker, root, around(cells))
	end
	BunkerGrid.Changed:Fire(keys)
	for _, id in roomIds do
		BunkerGrid.RoomChanged:Fire(id)
	end
end

-- API ----------------------------------------------------------------------------------------

function BunkerGrid:Bunker(): Bunker.Bunker
	return bunker
end

function BunkerGrid:Root(): Folder?
	return root
end

function BunkerGrid:State(floor: number, column: number): (Bunker.CellState?, string?)
	return bunker:State(floor, column)
end

function BunkerGrid:Room(id: string): Bunker.Room?
	return bunker:Room(id)
end

function BunkerGrid:RoomAt(floor: number, column: number): Bunker.Room?
	return bunker:RoomAt(floor, column)
end

function BunkerGrid:Rooms(): { Bunker.Room }
	return bunker:AllRooms()
end

function BunkerGrid:RoomsOfType(roomType: string): { Bunker.Room }
	return bunker:RoomsOfType(roomType)
end

function BunkerGrid:Neighbors(unit: string): { string }
	return bunker:Neighbors(unit)
end

function BunkerGrid:Graph(): { [string]: { string } }
	return bunker:Graph()
end

function BunkerGrid:DeepestFloor(): number
	return bunker:DeepestFloor()
end

function BunkerGrid:RoomModel(id: string): Model?
	local folder = root and root:FindFirstChild("Rooms")
	local model = folder and folder:FindFirstChild(id)
	return if model and model:IsA("Model") then model else nil
end

function BunkerGrid:Dig(floor: number, column: number): (boolean, string?)
	local ok, why = bunker:Dig(floor, column)
	if ok then
		log:Info("dug %s", Grid.Key(floor, column))
		changed({ { floor, column } }, {})
	end
	return ok, why
end

function BunkerGrid:PlaceRoom(roomType: string, floor: number, column: number, span: number, level: number?): (string?, string?)
	local id, why = bunker:Place(roomType, floor, column, span, level)
	if id then
		local room = bunker:Room(id) :: Bunker.Room
		log:Info("%s %s on floor %d, columns %d to %d", id, roomType, floor, column, column + span - 1)
		changed(roomCells(room), { id })
	end
	return id, why
end

function BunkerGrid:RemoveRoom(id: string): (boolean, string?)
	local room = bunker:Room(id)
	local cells = if room then roomCells(room) else {}
	local ok, why = bunker:Remove(id)
	if ok then
		log:Info("%s torn down", id)
		changed(cells, { id })
	end
	return ok, why
end

function BunkerGrid:MergeRooms(a: string, b: string): (string?, string?)
	local first, second = bunker:Room(a), bunker:Room(b)
	local cells = {}
	for _, room in { first, second } do
		if room then
			for _, cell in roomCells(room) do
				table.insert(cells, cell)
			end
		end
	end
	local id, why = bunker:Merge(a, b)
	if id then
		log:Info("%s and %s merged into %s", a, b, id)
		changed(cells, { a, b })
	end
	return id, why
end

function BunkerGrid:SetLevel(id: string, level: number): (boolean, string?)
	local ok, why = bunker:SetLevel(id, level)
	if ok then
		changed(roomCells(bunker:Room(id) :: Bunker.Room), { id })
	end
	return ok, why
end

function BunkerGrid:SetHP(id: string, hp: number): number?
	local room = bunker:Room(id)
	if not room then
		return nil
	end
	local before, wasWrecked = room.HP, room.Wrecked
	local result = bunker:SetHP(id, hp)
	if result and (result ~= before or room.Wrecked ~= wasWrecked) then
		roomsCollection:Patch(id, { HP = result, Wrecked = room.Wrecked })
		BunkerGrid.RoomChanged:Fire(id)
		if room.Wrecked and not wasWrecked then
			log:Info("%s (%s) is wrecked", id, room.Type)
			BunkerGrid.Wrecked:Fire(id)
		elseif wasWrecked and not room.Wrecked then
			log:Info("%s (%s) is repaired", id, room.Type)
			BunkerGrid.Repaired:Fire(id)
		end
	end
	return result
end

-- RoomHP (every room) and BlastDoorHealth (the Blast Door) multipliers, by source (a draft card,
-- a class); nil clears that source's. Every room keeps its share of its HP.
function BunkerGrid:SetHPModifier(source: string, key: string, value: number?)
	local target = HP_KEYS[key]
	assert(target, `BunkerGrid:SetHPModifier: {key} isn't an HP modifier`)
	hpModifiers[key] = hpModifiers[key] or {}
	hpModifiers[key][source] = value
	local product = 1
	for _, v in hpModifiers[key] do
		product *= v
	end
	bunker:SetHPScale(target, product)
	for _, room in bunker:AllRooms() do
		publishRoom(room.Id)
	end
end

-- DevTools ----------------------------------------------------------------------------------

local function map(): string
	local t = Grid.Tuning()
	local lines = {}
	local header = { "floor  " }
	for column = t.ColumnMin, t.ColumnMax do
		table.insert(header, string.format("%5d", column))
	end
	table.insert(lines, table.concat(header))
	local last = math.min(t.FloorMax, math.max(bunker:DeepestFloor() + 1, 3))
	for floor = t.FloorMin, last do
		local row = { string.format("%5d  ", floor) }
		for column = t.ColumnMin, t.ColumnMax do
			local state, id = bunker:State(floor, column)
			local token = "  ###"
			if state == "Dug" then
				token = "  ..."
			elseif state == "Room" and id then
				local room = bunker:Room(id) :: Bunker.Room
				token = `  {CODES[room.Type] or string.sub(room.Type, 1, 3)}`
			end
			table.insert(row, token)
		end
		table.insert(lines, table.concat(row))
	end
	return table.concat(lines, "\n")
end

local function roomList(): string
	local lines = {}
	for _, room in bunker:AllRooms() do
		table.insert(lines, `{room.Id} {room.Type} L{room.Level} floor {room.Floor} columns {room.Column}..{room.Column + room.Span - 1} HP {room.HP}/{room.MaxHP}{if room.Wrecked then " WRECKED" else ""}`)
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("grid", {
		Description = "The bunker map (### rock, ... dug, room codes) and its size.",
		Run = function(): string?
			local parts = if root then BunkerKit.PartCount(root) else 0
			return `{map()}\n{#bunker:AllRooms()} rooms, deepest floor {bunker:DeepestFloor()}, {parts} parts`
		end,
	})
	dev:Register("grid.rooms", {
		Description = "Every room: id, type, level, cells and HP.",
		Run = function(): string?
			return roomList()
		end,
	})
	dev:Register("grid.graph", {
		Description = "The room graph: each room or dug cell and what it connects to.",
		Run = function(): string?
			local lines = {}
			local graph = bunker:Graph()
			for _, unit in bunker:Units() do
				table.insert(lines, `{unit}: {table.concat(graph[unit], ", ")}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("grid.dig", {
		Description = "Dig a rock cell (no time, no vote: DigService adds those).",
		Usage = "grid.dig <floor> <column>",
		Run = function(_player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: grid.dig <floor> <column>"
			end
			local ok, why = BunkerGrid:Dig(floor, column)
			return if ok then map() else `can't dig: {why}`
		end,
	})
	dev:Register("grid.build", {
		Description = "Place a room on dug cells (no vote or cost: BuildService adds those).",
		Usage = "grid.build <RoomType> <floor> <column> [span] [level]",
		Run = function(_player, args): string?
			local roomType = tostring(args[1] or "")
			local floor, column = tonumber(args[2]), tonumber(args[3])
			local span, level = tonumber(args[4]) or 1, tonumber(args[5])
			if not floor or not column then
				return "usage: grid.build <RoomType> <floor> <column> [span] [level]"
			end
			local id, why = BunkerGrid:PlaceRoom(roomType, floor, column, span, level)
			return if id then `{id} placed\n{map()}` else `can't build: {why}`
		end,
	})
	dev:Register("grid.remove", {
		Description = "Tear a room down (its cells become dug).",
		Usage = "grid.remove <roomId>",
		Run = function(_player, args): string?
			local ok, why = BunkerGrid:RemoveRoom(tostring(args[1] or ""))
			return if ok then map() else `can't remove: {why}`
		end,
	})
	dev:Register("grid.merge", {
		Description = "Merge two matching rooms side by side.",
		Usage = "grid.merge <roomId> <roomId>",
		Run = function(_player, args): string?
			local id, why = BunkerGrid:MergeRooms(tostring(args[1] or ""), tostring(args[2] or ""))
			return if id then `merged into {id}\n{roomList()}` else `can't merge: {why}`
		end,
	})
	dev:Register("grid.level", {
		Description = "Set a room's level (1 to 3).",
		Usage = "grid.level <roomId> <level>",
		Run = function(_player, args): string?
			local ok, why = BunkerGrid:SetLevel(tostring(args[1] or ""), tonumber(args[2]) or 0)
			return if ok then roomList() else `can't set the level: {why}`
		end,
	})
	dev:Register("grid.hp", {
		Description = "Set a room's HP (0 wrecks it; a wrecked room works again at Tuning.Repairs.RepairedAt).",
		Usage = "grid.hp <roomId> <hp>",
		Run = function(_player, args): string?
			local id, hp = tostring(args[1] or ""), tonumber(args[2])
			if not hp or not bunker:Room(id) then
				return "usage: grid.hp <roomId> <hp> (see grid.rooms)"
			end
			BunkerGrid:SetHP(id, hp)
			local room = bunker:Room(id) :: Bunker.Room
			return `{id} {room.Type}: {room.HP}/{room.MaxHP}{if room.Wrecked then ", WRECKED" else ""}`
		end,
	})
	dev:Register("grid.sockets", {
		Description = "A room's gameplay points (work spots, beds, valves...) and where they are.",
		Usage = "grid.sockets <roomId>",
		Run = function(_player, args): string?
			local model = BunkerGrid:RoomModel(tostring(args[1] or ""))
			if not model then
				return "usage: grid.sockets <roomId> (see grid.rooms)"
			end
			local lines = {}
			for name, at in BunkerKit.Sockets(model) do
				local p = at.Position
				table.insert(lines, string.format("%s (%.1f, %.1f, %.1f)", name, p.X, p.Y, p.Z))
			end
			table.sort(lines)
			return `{model.Name}: {#lines} sockets\n{table.concat(lines, "\n")}`
		end,
	})
	dev:Register("grid.art", {
		Description = "Which units are built from the art kit and which from the graybox.",
		Run = function(): string?
			if not root then
				return "no bunker world yet"
			end
			local art, gray = {}, {}
			for _, folderName in { "Rooms", "Dug" } do
				local folder = root:FindFirstChild(folderName)
				for _, model in if folder then folder:GetChildren() else {} do
					table.insert(if model:GetAttribute("Art") then art else gray, model.Name)
				end
			end
			local lights = 0
			for _, item in root:GetDescendants() do
				if item:IsA("PointLight") then
					lights += 1
				end
			end
			return `art kit: {if BunkerKit.HasArt() then "yes" else "missing"}\nart: {table.concat(art, ", ")}\ngraybox: {table.concat(gray, ", ")}\n{lights} lights, {BunkerKit.PartCount(root)} parts`
		end,
	})
	dev:Register("grid.rebuild", {
		Description = "Rebuild the whole bunker world from the data.",
		Run = function(): string?
			if not root then
				return "no bunker world yet"
			end
			local began = os.clock()
			root:ClearAllChildren()
			BunkerKit.Sync(bunker, root, nil)
			return `rebuilt {BunkerKit.PartCount(root)} parts in {string.format("%.1f", (os.clock() - began) * 1000)} ms`
		end,
	})
end

-- Lifecycle -----------------------------------------------------------------------------------

function BunkerGrid:Init(registry)
	bunker = Bunker.FromStart()
	cellsCollection = registry.ReplicationService:Collection("Cells")
	roomsCollection = registry.ReplicationService:Collection("Rooms")
	for key in bunker.Cells do
		publishCell(key)
	end
	for _, room in bunker:AllRooms() do
		publishRoom(room.Id)
	end
	registerCommands(registry.DevService)
end

function BunkerGrid:Start()
	local began = os.clock()
	local old = workspace:FindFirstChild("Bunker")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Bunker"
	BunkerKit.Sync(bunker, folder, nil)
	folder.Parent = workspace
	root = folder

	-- Players spawn in the Medbay (their respawn point); other spawns in the place sleep.
	for _, item in workspace:GetDescendants() do
		if item:IsA("SpawnLocation") and not item:IsDescendantOf(folder) then
			item.Enabled = false
		end
	end
	local open = 0
	for _ in bunker.Cells do
		open += 1
	end
	log:Info(
		"bunker built from the %s: %d rooms, %d open cells, %d parts in %.1f ms",
		if BunkerKit.HasArt() then "art kit" else "graybox",
		#bunker:AllRooms(),
		open,
		BunkerKit.PartCount(folder),
		(os.clock() - began) * 1000
	)
end

return BunkerGrid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000F9"><Properties><string name="Name">ClassService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ClassService: the class each player brings and what it does (bible Section 14; Section 9: Q is
	the class ability). Run place only; Prompt 20. The rules are Shared.Rules.Classes and
	Rules.Modifiers; what each ability does in the world is Lib.ClassAbilities.

	Which class
	* The lobby writes the run's record to MemoryStore before the teleport (Lib.RunRecord, keyed by
	  this reserved server's PrivateServerId; Prompt 21 writes it). When a player's session is ready
	  their class is the record's, if their profile owns it (Classes) or it is their free trial;
	  their class level is the profile's (a trial plays at level 1). With no record, or a class they
	  don't own, they are the Survivor. In Studio the record's key is "Studio" (dev `record`).
	* The class goes on the player (Class, ClassLevel, ClassTrial attributes: every system reads
	  effects through Modifiers.PlayerValue, so level 2 and 3 apply everywhere) and the kit into
	  their hands (WeaponService:SetClass).

	The ability (Q, LB, the touch Ability button; Rules.Classes)
	* UseAbility(option, camera position, look) from the client. The server checks the run is
	  playing, the player stands, and the ability is ready: its cooldown in seconds or cycles, or a
	  use left (uses come back when each Surge starts, each cycle, each era). Lib.ClassAbilities runs
	  it; one that can't do anything says why and costs nothing. A hold of the key picks the next
	  option (PickAbilityOption); the Mad Scientist's gadgets each keep their own cooldown.
	* What the HUD reads, on the Player: AbilityReadyAt (server time; nil = ready), AbilityReadyCycle,
	  AbilityUses and AbilityMax, AbilityOption (the option's name), AbilityOptionReadyAt (that
	  option's own cooldown), AbilityEffect and AbilityActiveUntil (an effect in play: Hold the Line,
	  a drone mode), SteadyShots.

	Passives and levels (Config.Classes' modifiers)
	* Effects on the holder are read where they apply (PlayerValue): the Medic's revive time (the
	  client's prompt), the Security's +30 health (CombatService:SetMaxHealthFn), the Exterminator's
	  CreatureDamage (WeaponService:AddHitModifier), the Demolitionist's explosives, the Marksman's
	  zoom, and the passives of earlier prompts.
	* Effects on the whole bunker (Scope Bunker: StockpileCaps, BuildCost, BuildSpeed, ResidentXP,
	  RoomOutput of a room type, AllOutput, FoodUse, FireSpread, BlastDoorHealth) go to their systems
	  as the strongest holder's value: two Quartermasters don't stack. They follow whoever is in the
	  run as classes change and players leave.
	* The damage filter (CombatService:AddDamageFilter): Hold the Line and the drone's Guard cut what
	  their player takes; residents hit harder near a Security (NearbyResidentDamage, the strongest
	  one in NearbyResidentRange), armed (ArmedResidentDamage), and rallied (RallyDamage).
	* Hits (WeaponService.Hit): flame hits set monsters burning; a crit (Marksman 3) or a blast
	  (Demolitionist 3) staggers a boss (BossService:Stun); a kill by a level 3 Exterminator lowers
	  Disturbance by KillDisturbance.
	* The Warden breaks tied votes and drafts with their own ballot (VoteService:SetTieBreaker); a
	  level 2 Warden picks the stat residents raise when they level (ChooseLevelStat; RunState
	  LevelStat, cleared when no such Warden is left).

	Class experience (Section 14: about 3 runs for level 2 and 10 for level 3)
	* ResultsService pays it with the run's Glowshards: RunXP(player, years, paidYears) is the class
	  and the experience the run earned (Rules.Classes.RunXP; none for a trial); the level follows
	  the experience (Rules.Classes.LevelFor) and Refresh(player) puts a new level in play at once.

	API: Get(player): State?, SetClass(player, classId, level?, trial?, why?), RunXP(player, years,
	paidYears?): (string?, number), Refresh(player).
	Dev: class <Id> [level], class.level <1-3>, class.own <Id> [level] [xp], ability [option],
	ability.ready, classes, classxp <years>, resident.arm <id> [item], record <Class> [trial].
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Classes = require(Shared.Rules.Classes)
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Abilities = require(ServerScriptService.Lib.ClassAbilities)
local RunRecord = require(ServerScriptService.Lib.RunRecord)

local log = Log.new("ClassService")
local set = RunState.Writer("ClassService")
local IS_STUDIO = RunService:IsStudio()

export type State = {
	Player: Player,
	Class: string,
	Level: number,
	Trial: boolean,
	Option: number,
	ReadyAt: number, -- server time the shared cooldown ends
	ReadyCycle: number?, -- the cycle a cycle cooldown ends on (Hearty Meal)
	OptionReadyAt: { [number]: number }, -- own cooldowns (the Mad Scientist's gadgets)
	Uses: number?, -- uses left this Surge, cycle or era
	Effect: string?, -- an effect in play: "Hold", "Rally", a drone mode
	EffectUntil: number, -- os.clock()
	EffectEndsAt: number, -- the same, server time (for the HUD)
	Shots: number, -- Steady Shot shots left
	DroneRevives: number, -- the drone's revives left this Surge
}

local ClassService = {
	Name = "ClassService",
	Dependencies = {
		"SessionService", "ProfileService", "RunDirector", "CycleClock", "CombatService", "WeaponService", "MonsterService",
		"BossService", "BunkerGrid", "EconomyService", "BuildService", "DisasterService", "DigService", "ResidentService",
		"ResidentBrain", "BreachService", "SurfaceService", "DeepService", "InventoryService", "RescueService", "VoteService",
		"DevService",
	},
}

local session: any = nil
local profiles: any = nil
local director: any = nil
local clock: any = nil
local combat: any = nil
local weapons: any = nil
local boss: any = nil
local grid: any = nil
local economy: any = nil
local build: any = nil
local disasters: any = nil
local dig: any = nil
local residents: any = nil
local brain: any = nil
local votes: any = nil

local states: { [Player]: State } = {}
local record: RunRecord.Record? = nil
local recordRead = false
local lastHit: { [string]: string } = {} -- monster combatant id -> "P<user id>" who hit it last

local function now(): number
	return workspace:GetServerTimeNow()
end

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function alertAll(kind: string, text: string)
	for _, player in session:ReadyPlayers() do
		alert(player, kind, text)
	end
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- The HUD's attributes --------------------------------------------------------------------------------

local function publish(state: State)
	local player = state.Player
	local ability = Classes.Ability(state.Class)
	player:SetAttribute("Class", state.Class)
	player:SetAttribute("ClassLevel", state.Level)
	player:SetAttribute("ClassTrial", if state.Trial then true else nil)
	player:SetAttribute("AbilityReadyAt", if state.ReadyAt > now() then state.ReadyAt else nil)
	player:SetAttribute("AbilityReadyCycle", if state.ReadyCycle and state.ReadyCycle > clock:Cycle() then state.ReadyCycle else nil)
	player:SetAttribute("AbilityUses", state.Uses)
	player:SetAttribute("AbilityMax", Classes.UsesFor(state.Class, state.Level))
	player:SetAttribute("AbilityOption", Classes.OptionName(state.Class, state.Option))
	local own = state.OptionReadyAt[state.Option]
	player:SetAttribute("AbilityOptionReadyAt", if own and own > now() then own else nil)
	local active = state.Effect ~= nil and os.clock() < state.EffectUntil
	player:SetAttribute("AbilityEffect", if active then state.Effect else nil)
	player:SetAttribute("AbilityActiveUntil", if active then state.EffectEndsAt else nil)
	player:SetAttribute("SteadyShots", if state.Shots > 0 then state.Shots else nil)
	player:SetAttribute("AbilityName", if ability then ability.Name else nil)
end

-- Bunker-wide class effects ---------------------------------------------------------------------------

-- The systems that take a bunker-wide key: fn(value or nil, room?).
local BUNKER: { [string]: (number?, string?) -> () } = {
	StockpileCaps = function(v)
		economy:SetModifier("class", "StockpileCaps", v)
	end,
	AllOutput = function(v)
		economy:SetModifier("class", "AllOutput", v)
	end,
	FoodUse = function(v)
		economy:SetModifier("class", "FoodUse", v)
	end,
	RoomOutput = function(v, room)
		economy:SetModifier("class", "RoomOutput", v, room)
	end,
	BuildCost = function(v)
		build:SetModifier("class", "BuildCost", v)
	end,
	BuildSpeed = function(v)
		build:SetModifier("class", "BuildSpeed", v)
	end,
	ResidentXP = function(v)
		residents:SetModifier("class", "ResidentXP", v)
	end,
	FireSpread = function(v)
		disasters:SetModifier("class", "FireSpread", v)
	end,
	BlastDoorHealth = function(v)
		grid:SetHPModifier("class", "BlastDoorHealth", v)
	end,
}

local applied: { [string]: number } = {} -- "key|room" -> value in play

-- How strong a value is, by its key's unit: the farthest from neutral wins.
local function strength(key: string, value: number): number
	local info = Config.Find("Modifiers", key)
	if info and (info.Unit == "Multiplier" or info.Unit == "Chance") then
		return math.abs(math.log(math.max(value, 1e-6)))
	end
	return math.abs(value)
end

local function refreshBunker()
	local best: { [string]: { Key: string, Room: string?, Value: number } } = {}
	for _, state in states do
		if state.Player.Parent == Players then
			for _, modifier in Modifiers.ClassModifiers(state.Class, state.Level) do
				local info = Config.Find("Modifiers", modifier.Key)
				local scope = modifier.Scope or (if info then info.Scope else nil)
				if scope == "Bunker" and BUNKER[modifier.Key] then
					local id = `{modifier.Key}|{modifier.Room or ""}`
					local have = best[id]
					if not have or strength(modifier.Key, modifier.Value) > strength(modifier.Key, have.Value) then
						best[id] = { Key = modifier.Key, Room = modifier.Room, Value = modifier.Value }
					end
				end
			end
		end
	end
	for id, entry in best do
		if applied[id] ~= entry.Value then
			BUNKER[entry.Key](entry.Value, entry.Room)
			applied[id] = entry.Value
		end
	end
	for id in table.clone(applied) do
		if not best[id] then
			local key, room = string.match(id, "^([^|]+)|(.*)$")
			if key and BUNKER[key] then
				BUNKER[key](nil, if room ~= "" then room else nil)
			end
			applied[id] = nil
		end
	end
	-- a level 2 Warden's stat choice ends when none is left
	if RunState.Get("LevelStat") ~= nil then
		local any = false
		for _, state in states do
			if state.Player.Parent == Players and Modifiers.PlayerValue(state.Player, "ChoosesLevelStat") then
				any = true
			end
		end
		if not any then
			residents:SetLevelStat(nil)
			set("LevelStat", nil)
		end
	end
end

-- Setting a class ---------------------------------------------------------------------------------------

function ClassService:Get(player: Player): State?
	return states[player]
end

function ClassService:SetClass(player: Player, classId: string, level: number?, trial: boolean?, why: string?)
	local class = Config.Find("Classes", classId)
	if not class then
		classId = "Survivor"
	end
	local lvl = math.clamp(math.floor(level or 1), 1, Classes.Tuning().LevelMax)
	local old = states[player]
	local state: State = {
		Player = player,
		Class = classId,
		Level = lvl,
		Trial = trial == true,
		Option = 1,
		ReadyAt = 0,
		ReadyCycle = nil,
		OptionReadyAt = {},
		Uses = Classes.UsesFor(classId, lvl),
		Effect = nil,
		EffectUntil = 0,
		EffectEndsAt = 0,
		Shots = 0,
		DroneRevives = math.floor(Modifiers.ClassValue(classId, "DroneRevivesPerSurge", lvl) or 0),
	}
	-- the same class at a new level keeps its cooldowns
	if old and old.Class == classId then
		state.ReadyAt, state.ReadyCycle, state.OptionReadyAt, state.Option = old.ReadyAt, old.ReadyCycle, old.OptionReadyAt, old.Option
		local newMax, oldMax = Classes.UsesFor(classId, lvl), Classes.UsesFor(classId, old.Level)
		if newMax and old.Uses then
			state.Uses = math.clamp(old.Uses + newMax - (oldMax or newMax), 0, newMax)
		end
		state.Shots = old.Shots
	end
	states[player] = state
	player:SetAttribute("Class", classId)
	player:SetAttribute("ClassLevel", lvl)
	weapons:SetClass(player, classId, lvl)
	publish(state)
	Abilities.ClassChanged(player, state)
	combat:RefreshMaxHealth(player)
	refreshBunker()
	log:Info("%s is a level %d %s%s (%s)", player.Name, lvl, classId, if trial then " (trial)" else "", why or "set")
end

local function readRecord()
	if recordRead then
		return
	end
	recordRead = true
	local key = RunRecord.Key()
	if not key then
		log:Info("no run record: not a reserved Run server")
		return
	end
	local found, why = RunRecord.Mine() -- read once for the whole server (PartyService reads it too)
	record = found
	if found then
		log:Info("run record %s: %d loadouts", key, (function()
			local n = 0
			for _ in found.Loadouts do
				n += 1
			end
			return n
		end)())
	else
		log:Info("no run record under %s (%s)", key, tostring(why))
	end
end

-- The class a player brings: the record's, if they own it or it is their trial; else the Survivor.
local function chosen(player: Player): (string, number, boolean)
	readRecord()
	local loadout = RunRecord.Loadout(record, player.UserId)
	local profile = profiles:Get(player)
	if loadout and Config.Find("Classes", loadout.Class) then
		local owned = profile and profile.Classes[loadout.Class]
		if owned then
			return loadout.Class, owned.Level, false
		elseif loadout.Trial then
			return loadout.Class, 1, true
		end
		log:Warn("%s's record names %s, which they don't own: the Survivor", player.Name, loadout.Class)
	end
	local survivor = profile and profile.Classes.Survivor
	return "Survivor", if survivor then survivor.Level else 1, false
end

-- Class experience ----------------------------------------------------------------------------------------

function ClassService:RunXP(player: Player, years: number, paidYears: number?): (string?, number)
	local state = states[player]
	if not state or state.Trial then
		return nil, 0
	end
	return state.Class, Classes.RunXP(years, paidYears)
end

-- The profile's level for the player's class put in play (after the run paid a level up).
function ClassService:Refresh(player: Player)
	local state = states[player]
	local profile = profiles:Get(player)
	local entry = if state and profile then profile.Classes[state.Class] else nil
	if state and entry and not state.Trial and entry.Level ~= state.Level then
		ClassService:SetClass(player, state.Class, entry.Level, false, "a class level up")
	end
end

-- The ability ----------------------------------------------------------------------------------------------

local function perText(per: string?): string
	return if per == "Surge" then "THE NEXT SURGE" elseif per == "Cycle" then "THE NEXT CYCLE" elseif per == "Era" then "THE NEXT ERA" else "LATER"
end

local function ready(state: State, option: number): (boolean, string?)
	local ability = Classes.Ability(state.Class)
	if not ability then
		return false, "THIS CLASS HAS NO ABILITY"
	end
	if state.Uses ~= nil and state.Uses <= 0 then
		return false, `NO USES LEFT: MORE AT {perText(Classes.UsesPer(state.Class))}`
	end
	if state.ReadyCycle and clock:Cycle() < state.ReadyCycle then
		local left = state.ReadyCycle - clock:Cycle()
		return false, `{string.upper(ability.Name)} IS READY IN {left} CYCLE{if left == 1 then "" else "S"}`
	end
	local waitUntil = if Classes.OwnCooldowns(state.Class) then state.OptionReadyAt[option] or 0 else state.ReadyAt
	if waitUntil > now() + 0.05 then
		return false, `{string.upper(Classes.OptionName(state.Class, option) or ability.Name)} IS READY IN {math.ceil(waitUntil - now())} S`
	end
	return true, nil
end

local function spend(state: State, option: number)
	local ability = Classes.Ability(state.Class)
	if not ability then
		return
	end
	if state.Uses ~= nil then
		state.Uses = math.max(state.Uses - 1, 0)
	end
	if ability.CooldownCycles then
		state.ReadyCycle = clock:Cycle() + ability.CooldownCycles
	end
	if ability.CooldownSeconds then
		local seconds = ability.CooldownSeconds / math.max(clock:TimeScale(), 0.01)
		if Classes.OwnCooldowns(state.Class) then
			state.OptionReadyAt[option] = now() + seconds
		else
			state.ReadyAt = now() + seconds
		end
	end
end

local function use(player: Player, optionArg: number, origin: Vector3, look: Vector3): (boolean, string?)
	local state = states[player]
	if not state then
		return false, "YOU HAVE NO CLASS YET"
	end
	if director:Phase() ~= "Playing" then
		return false, "THE RUN ISN'T UNDER WAY"
	end
	if player:GetAttribute("Life") ~= "Alive" or not rootOf(player) then
		return false, "YOU NEED TO BE STANDING"
	end
	if player:GetAttribute("Carrying") then
		return false, "YOUR HANDS ARE FULL"
	end
	local option = if optionArg > 0 then Classes.OptionIndex(state.Class, optionArg) else state.Option
	local ok, why = ready(state, option)
	if not ok then
		return false, why
	end
	local used, text, effect, seconds = Abilities.Use(state, option, origin, look)
	if not used then
		return false, text
	end
	spend(state, option)
	if effect and seconds and seconds > 0 then
		state.Effect = effect
		state.EffectUntil = os.clock() + seconds
		state.EffectEndsAt = now() + seconds
	end
	publish(state)
	local optionName = Classes.OptionName(state.Class, option)
	log:Info("%s used %s%s", player.Name, (Classes.Ability(state.Class) :: any).Name, if optionName then ` ({optionName})` else "")
	return true, text
end

local function onUseAbility(player: Player, option: number, origin: Vector3, look: Vector3)
	local ok, text = use(player, option, origin, look)
	if text then
		alert(player, if ok then "Info" else "Warning", text)
	end
end

local function onPickOption(player: Player, index: number)
	local state = states[player]
	if not state or #Classes.Options(state.Class) == 0 then
		return
	end
	state.Option = Classes.OptionIndex(state.Class, index)
	publish(state)
end

local function onTeleport(player: Player)
	local ok, why = Abilities.Teleport(player)
	if not ok and why then
		alert(player, "Warning", why)
	end
end

local function onChooseStat(player: Player, stat: string)
	if not Modifiers.PlayerValue(player, "ChoosesLevelStat") then
		alert(player, "Warning", "ONLY A LEVEL 2 WARDEN CHOOSES THE LEVEL-UP STAT")
		return
	end
	local id: string? = nil
	if stat ~= "" then
		id = Config.Find("Stats", stat) and stat or nil
		if not id then
			return
		end
	end
	residents:SetLevelStat(id)
	set("LevelStat", id)
	alertAll("Info", if id then `{string.upper(player.DisplayName)}: RESIDENTS' LEVELS NOW RAISE {string.upper(id)}`
		else `{string.upper(player.DisplayName)}: RESIDENTS' LEVELS RAISE THEIR JOB'S STAT AGAIN`)
end

-- Uses come back ------------------------------------------------------------------------------------------

local function refill(per: string)
	for _, state in states do
		if Classes.UsesPer(state.Class) == per then
			state.Uses = Classes.UsesFor(state.Class, state.Level)
			publish(state)
		end
		if per == "Surge" then
			state.DroneRevives = math.floor(Modifiers.ClassValue(state.Class, "DroneRevivesPerSurge", state.Level) or 0)
		end
	end
end

-- Damage ----------------------------------------------------------------------------------------------------

local function damageFilter(target: any, amount: number, source: any, _how: string?): number
	local tt = Classes.Tuning()
	if target.Kind == "Player" and target.Player then
		local state = states[target.Player]
		if state and state.Effect and os.clock() < state.EffectUntil then
			if state.Effect == "Hold" then
				amount *= tt.HoldDamageTaken
			elseif state.Effect == "Guard" then
				amount *= tt.Drone.GuardDamageTaken
			end
		end
	end
	if source and source.Kind == "Resident" and target.Team == "Monsters" and source.ResidentId then
		local nearby = 1
		for _, p in session:ReadyPlayers() do
			local v = Modifiers.PlayerValue(p, "NearbyResidentDamage")
			local root = rootOf(p)
			if v and v > nearby and root and p:GetAttribute("Life") == "Alive"
				and (root.Position - source.Root.Position).Magnitude <= tt.NearbyResidentRange then
				nearby = v
			end
		end
		amount *= nearby
		local resident = residents:Get(source.ResidentId)
		if resident and resident.Weapon then
			local armed = 1
			for _, p in session:ReadyPlayers() do
				local v = Modifiers.PlayerValue(p, "ArmedResidentDamage")
				if v and v > armed then
					armed = v
				end
			end
			amount *= armed
		end
		amount *= brain:RallyBonus(source.ResidentId)
	end
	return amount
end

local function hitModifier(target: any, _point: Vector3?, _how: string, player: Player): number
	if target.Kind == "Monster" then
		return Modifiers.PlayerValue(player, "CreatureDamage") or 1
	end
	return 1
end

-- kind: the hit's own kind (a crit on the Brood Mother's belly is still a crit, though she counts it as
-- a "weakpoint" hit)
local function onHit(player: Player, targetId: string, _done: number, how: string, _point: Vector3?, kind: string?)
	kind = kind or how
	if kind == "burned" then
		Abilities.Burn(targetId, player)
	elseif kind == "crit" and boss:IsBoss(targetId) and Modifiers.PlayerValue(player, "CritsStaggerBosses") then
		boss:Stun(targetId, `{player.Name}'s crit`)
	elseif kind == "blast" and boss:IsBoss(targetId) and Modifiers.PlayerValue(player, "ExplosionsStunBosses") then
		boss:Stun(targetId, `{player.Name}'s explosion`)
	end
end

-- DevTools ---------------------------------------------------------------------------------------------------

local function describe(state: State): string
	local ability = Classes.Ability(state.Class)
	local parts = { `{state.Player.Name}: {state.Class} L{state.Level}{if state.Trial then " (trial)" else ""}` }
	if ability then
		table.insert(parts, ability.Name)
	end
	local option = Classes.OptionName(state.Class, state.Option)
	if option then
		table.insert(parts, `option {option}`)
	end
	if state.Uses ~= nil then
		table.insert(parts, `uses {state.Uses}/{Classes.UsesFor(state.Class, state.Level)}`)
	end
	local waitUntil = if Classes.OwnCooldowns(state.Class) then state.OptionReadyAt[state.Option] or 0 else state.ReadyAt
	table.insert(parts, if waitUntil > now() then string.format("ready in %.0f s", waitUntil - now()) else "ready")
	if state.ReadyCycle and state.ReadyCycle > clock:Cycle() then
		table.insert(parts, `ready at cycle {state.ReadyCycle}`)
	end
	if state.Effect and os.clock() < state.EffectUntil then
		table.insert(parts, string.format("%s for %.0f s", state.Effect, state.EffectUntil - os.clock()))
	end
	if state.Shots > 0 then
		table.insert(parts, `steady shots {state.Shots}`)
	end
	return table.concat(parts, " · ")
end

local function target(player: Player?, arg: any): Player?
	if type(arg) == "string" and arg ~= "" then
		for _, p in Players:GetPlayers() do
			if string.lower(p.Name) == string.lower(arg) or tostring(p.UserId) == arg then
				return p
			end
		end
	end
	return player
end

local function registerCommands(dev: any)
	dev:Register("classes", {
		Description = "Every player's class, level, ability and cooldown, and the class devices in play.",
		Usage = "classes",
		Run = function(): string?
			local lines = {}
			for _, state in states do
				table.insert(lines, describe(state))
			end
			table.sort(lines)
			local applied_ = {}
			for id, v in applied do
				table.insert(applied_, `{id}={v}`)
			end
			table.sort(applied_)
			table.insert(lines, `bunker-wide: {if #applied_ > 0 then table.concat(applied_, ", ") else "none"}`)
			table.insert(lines, Abilities.Describe())
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("class", {
		Description = "Take a class (its kit and ability) at a level, for testing (Prompt 21's loadouts set it for real).",
		Usage = "class <ClassId> [level] [player]",
		Run = function(player, args): string?
			local who = target(player, args[3])
			if not who then
				return "players only"
			end
			local id = tostring(args[1] or "")
			if not Config.Find("Classes", id) then
				return `no class {id}`
			end
			ClassService:SetClass(who, id, tonumber(args[2]) or 1, false, "dev")
			return describe(states[who])
		end,
	})
	dev:Register("class.level", {
		Description = "Set your class level (1 to 3) for this run.",
		Usage = "class.level <1-3> [player]",
		Run = function(player, args): string?
			local who = target(player, args[2])
			local state = who and states[who]
			if not who or not state then
				return "players only"
			end
			ClassService:SetClass(who, state.Class, tonumber(args[1]) or 1, state.Trial, "dev")
			return describe(states[who])
		end,
	})
	dev:Register("class.own", {
		Description = "Put a class in your profile (Studio only), with a level and experience.",
		Usage = "class.own <ClassId> [level] [xp]",
		Run = function(player, args): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			if not player then
				return "players only"
			end
			local id = tostring(args[1] or "")
			if not Config.Find("Classes", id) then
				return `no class {id}`
			end
			local level = math.clamp(math.floor(tonumber(args[2]) or 1), 1, 3)
			local xp = math.max(0, tonumber(args[3]) or Classes.LevelXP(level))
			local ok = profiles:Update(player, function(data: any)
				data.Classes[id] = { Level = level, XP = xp }
			end)
			return if ok then `{id} is in your profile at level {level} ({xp} experience)` else "the profile couldn't be written"
		end,
	})
	dev:Register("ability", {
		Description = "Use your class ability as Q would, aimed where your character faces.",
		Usage = "ability [option] [player]",
		Run = function(player, args): string?
			local who = target(player, args[2])
			local root = who and rootOf(who)
			if not who or not root then
				return "players only"
			end
			local origin = root.Position + Vector3.new(0, 2, 0)
			local ok, text = use(who, math.floor(tonumber(args[1]) or 0), origin, root.CFrame.LookVector)
			return `{if ok then "used" else "refused"}: {text or ""}`
		end,
	})
	dev:Register("ability.ready", {
		Description = "Make your ability ready now (cooldowns and uses back).",
		Usage = "ability.ready [player]",
		Run = function(player, args): string?
			local who = target(player, args[1])
			local state = who and states[who]
			if not state then
				return "players only"
			end
			state.ReadyAt, state.ReadyCycle, state.OptionReadyAt = 0, nil, {}
			state.Uses = Classes.UsesFor(state.Class, state.Level)
			publish(state)
			return describe(state)
		end,
	})
	dev:Register("classxp", {
		Description = "Pay your class's experience for a run that reached this many years, as the results would (saved).",
		Usage = "classxp <years>",
		Run = function(player, args): string?
			if not player then
				return "players only"
			end
			local classId, xp = ClassService:RunXP(player, tonumber(args[1]) or 50, 0)
			if not classId then
				return "no class experience (no class, or a trial)"
			end
			local result = ""
			local ok = profiles:Update(player, function(data: any)
				local entry = data.Classes[classId]
				if not entry then
					result = `{classId} isn't in your profile (class.own)`
					return
				end
				entry.XP += xp
				local level = math.max(entry.Level, Classes.LevelFor(entry.XP))
				result = `{classId}: +{xp} experience, {entry.XP} in all, level {entry.Level} -> {level}`
				entry.Level = level
			end)
			if ok then
				task.spawn(function()
					profiles:SaveNow(player)
				end)
				ClassService:Refresh(player)
			end
			return if ok then result else "the profile couldn't be written"
		end,
	})
	dev:Register("resident.arm", {
		Description = "Give a resident a weapon (gear is Prompt 26), so they answer the Warden's Rally Call; none disarms.",
		Usage = "resident.arm <id|all> [ItemId|none]",
		Run = function(_, args): string?
			local item: string? = tostring(args[2] or "LeadPipe")
			if item == "none" then
				item = nil
			elseif not Config.Find("Items", item :: string) then
				return `no item {item}`
			end
			local which = tostring(args[1] or "")
			local n = 0
			for _, resident in residents:All() do
				if (which == "all" or resident.Id == which) and residents:Arm(resident.Id, item) then
					n += 1
				end
			end
			return `{n} resident{if n == 1 then "" else "s"} {if item then `armed with {item}` else "disarmed"}`
		end,
	})
	dev:Register("record", {
		Description = "Write a test run record in Studio (MemoryStore, key \"Studio\") with your class, and read it back as a new player would.",
		Usage = "record <ClassId> [trial]",
		Run = function(player, args): string?
			if not IS_STUDIO or not player then
				return "Studio players only"
			end
			local id = tostring(args[1] or "")
			if not Config.Find("Classes", id) then
				return `no class {id}`
			end
			local entry: RunRecord.Record = {
				Version = RunRecord.VERSION,
				Party = { player.UserId },
				Difficulty = director:Difficulty(),
				Loadouts = { [tostring(player.UserId)] = { Class = id, Trial = args[2] == "trial" } },
				CreatedAt = os.time(),
			}
			local ok, why = RunRecord.Write(RunRecord.STUDIO_KEY, entry, 600)
			if not ok then
				return `couldn't write: {why}`
			end
			record = RunRecord.Mine(true) -- read it back, as a new player's session would
			recordRead = true
			local class, level, trial = chosen(player)
			ClassService:SetClass(player, class, level, trial, "the run record")
			return `record written and read: {describe(states[player])}`
		end,
	})
end

-- Lifecycle -------------------------------------------------------------------------------------------------

function ClassService:Init(registry)
	session = registry.SessionService
	profiles = registry.ProfileService
	director = registry.RunDirector
	clock = registry.CycleClock
	combat = registry.CombatService
	weapons = registry.WeaponService
	boss = registry.BossService
	grid = registry.BunkerGrid
	economy = registry.EconomyService
	build = registry.BuildService
	disasters = registry.DisasterService
	dig = registry.DigService
	residents = registry.ResidentService
	brain = registry.ResidentBrain
	votes = registry.VoteService
	Abilities.Init({
		Combat = combat,
		Weapons = weapons,
		Monsters = registry.MonsterService,
		Boss = boss,
		Grid = grid,
		Economy = economy,
		Build = build,
		Disasters = disasters,
		Dig = dig,
		Residents = residents,
		Brain = brain,
		Breaches = registry.BreachService,
		Surface = registry.SurfaceService,
		Deep = registry.DeepService,
		Inventory = registry.InventoryService,
		Rescue = registry.RescueService,
		Clock = clock,
		Session = session,
		State = function(player: Player): any
			return states[player]
		end,
		SetBeacon = function(untilAt: number?, by: string?)
			set("BeaconUntil", untilAt)
			set("BeaconBy", by)
		end,
	})
	registerCommands(registry.DevService)
end

function ClassService:Start()
	combat:SetMaxHealthFn(function(player: Player): number
		local base = Config.Get("Tuning", "Player").Health + (Modifiers.PlayerValue(player, "MaxHealth") or 0)
		return base * Abilities.MealMultiplier()
	end)
	combat:AddDamageFilter("classes", damageFilter)
	weapons:AddHitModifier("classes", hitModifier)
	weapons:SetShotHook(Abilities.ShotHook)
	weapons.Hit:Connect(onHit)
	-- the Warden's ballot breaks ties (Section 14); the first Warden by user id who voted
	votes:SetTieBreaker(function(_voteId: string, ballots: { [number]: string }): string?
		local wardens = {}
		for _, p in session:ReadyPlayers() do
			if Modifiers.PlayerValue(p, "BreaksVoteTies") then
				table.insert(wardens, p.UserId)
			end
		end
		table.sort(wardens)
		for _, userId in wardens do
			if ballots[userId] then
				return ballots[userId]
			end
		end
		return nil
	end)

	session.PlayerReady:Connect(function(player: Player)
		local class, level, trial = chosen(player)
		ClassService:SetClass(player, class, level, trial, "joined")
	end)
	for _, player in session:ReadyPlayers() do
		if not states[player] then
			local class, level, trial = chosen(player)
			ClassService:SetClass(player, class, level, trial, "joined")
		end
	end
	Players.PlayerRemoving:Connect(function(player: Player)
		states[player] = nil
		Abilities.ClassChanged(player, nil)
		task.defer(refreshBunker)
	end)
	local function watch(player: Player)
		player.CharacterAdded:Connect(function()
			Abilities.Spawned(player)
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in Players:GetPlayers() do
		watch(player)
	end

	combat.Downed:Connect(function(id: string)
		local c = combat:Get(id)
		if c and c.Player then
			Abilities.Downed(c.Player)
		end
	end)
	combat.Damaged:Connect(function(targetId: string, _amount: number, sourceId: string?)
		if sourceId and string.sub(sourceId, 1, 1) == "P" then
			local c = combat:Get(targetId)
			if c == nil or c.Team == "Monsters" then
				lastHit[targetId] = sourceId
			end
		end
	end)
	combat.Died:Connect(function(id: string)
		local by = lastHit[id]
		lastHit[id] = nil
		local userId = if by then tonumber(string.sub(by, 2)) else nil
		local player = if userId then Players:GetPlayerByUserId(userId) else nil
		if player and Modifiers.PlayerValue(player, "KillsLowerDisturbance") then
			dig:AddDisturbance(-Classes.Tuning().KillDisturbance, "Exterminator")
		end
	end)

	clock.SurgeStarted:Connect(function()
		refill("Surge")
	end)
	clock.CycleStarted:Connect(function()
		refill("Cycle")
		for _, state in states do
			publish(state) -- a cycle cooldown may be over
		end
	end)
	clock.EraChanged:Connect(function()
		refill("Era")
	end)

	local syncQueued = false
	grid.RoomChanged:Connect(function()
		if not syncQueued then
			syncQueued = true
			task.delay(0.5, function()
				syncQueued = false
				local ok, err = pcall(Abilities.SyncBarricades)
				if not ok then
					log:Warn("barricades: %s", tostring(err))
				end
			end)
		end
	end)
	task.defer(function()
		local ok, err = pcall(Abilities.SyncBarricades)
		if not ok then
			log:Warn("barricades: %s", tostring(err))
		end
	end)

	Remotes.OnServer("UseAbility", onUseAbility)
	Remotes.OnServer("PickAbilityOption", onPickOption)
	Remotes.OnServer("TeleportToBeacon", onTeleport)
	Remotes.OnServer("ChooseLevelStat", onChooseStat)

	local fast, slow = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		fast += dt
		slow += dt
		if fast >= 0.1 then
			local step = math.min(fast, 0.5)
			fast = 0
			Abilities.Tick(step)
		end
		if slow >= 1 then
			local step = math.min(slow, 2)
			slow = 0
			Abilities.Slow(step)
			for _, state in states do
				if state.Effect and os.clock() >= state.EffectUntil then
					state.Effect = nil
					publish(state)
				end
			end
		end
	end)
	log:Info("classes ready: %d classes, the run record %s", #Config.Ids("Classes"), tostring(RunRecord.Key()))
end

return ClassService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000FA"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CombatService: everyone who can be hurt, in one place (bible Section 23: one loop for every
	combatant: players, armed residents, monsters, turrets, bosses). Run place only; Prompt 11.

	Combatants
	* Register(model, spec) -> id. A combatant has a team ("Survivors" or "Monsters"), health,
	  a reach (how far its body goes from its root) and a second of position history at
	  Tuning.Combat.HistoryHz, for Section 23's checks against where a target was over the last
	  250 ms. Get(id), OfInstance(part), All(team?), History(id).
	* Players register when they spawn and residents' bodies when ResidentBrain makes them
	  (their health stays with ResidentService). Monsters come with Prompt 12; until then a dev
	  dummy stands in.
	* Damage(targetId, amount, sourceId?, how?): no friendly fire (Section 9), and a dodge's
	  invulnerable moment takes nothing. Damage filters (AddDamageFilter, Prompt 20) scale it
	  first: Hold the Line halves what a Security takes, residents near one hit harder.
	  Heal(id, amount).
	* Signals: Damaged(id, amount, sourceId?, how?), Downed(id), Revived(id, byUserId?),
	  Died(id). Dead monsters dissolve into glowing dust (Section 3); a combatant registered with
	  KeepModel (a boss, Prompt 15) is left for its own service, which calls Dissolve(model).

	Players (Section 9)
	* Health: Tuning.Player.Health, or what SetMaxHealthFn says (Prompt 20: the Security's +30,
	  Hearty Meal's +20%); RefreshMaxHealth(player) applies a change at once (a raised max adds
	  its difference, a lowered one caps). Roblox's own regeneration is removed: health comes back
	  only by healing.
	* At 0 health a player is Downed for DownedSeconds and crawls (CrawlSpeed). Teammates see a
	  revive prompt: hold Interact for ReviveSeconds (a Medic's client holds it for their own 1 s,
	  Prompt 20). A revived player gets up with ReviveHealthFraction of their health.
	* Not revived in time: dead. RespawnSeconds later they come back at the nearest working
	  Medbay (not wrecked, not dark), or in the Blast Door hall when no Medbay works.
	* Each player's life shows as attributes on the Player: Life ("Alive", "Downed", "Dead"),
	  LifeEndsAt (when the downed or respawn wait ends, server time) and InvulnerableUntil.
	* A player's Humanoid never reaches 0 health: the hit that would take it there leaves it at
	  1 and downs the player (at 0 the server kills a Humanoid whatever the client does). The
	  client also turns the Dead state off for its own character, and Died is still handled as a
	  fallback.

	Dev: combat, hurt, heal, down, revive, kill, god, dummy, dummy.attack, dummy.clear.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Rules.Combat)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local Hazards = require(game:GetService("ServerScriptService").Lib.Hazards)

local log = Log.new("CombatService")

export type Team = "Survivors" | "Monsters"
export type Kind = "Player" | "Resident" | "Monster" | "Survivor" -- Survivor: a rescued survivor on the way home (Prompt 16)
export type Combatant = {
	Id: string,
	Kind: Kind,
	Team: Team,
	Model: Model,
	Root: BasePart,
	Reach: number,
	Health: number, -- monsters' own; players and residents keep theirs where they live
	MaxHealth: number,
	State: "Alive" | "Downed" | "Dead",
	History: { Combat.Sample },
	InvulnerableUntil: number,
	Player: Player?,
	ResidentId: string?,
	MonsterType: string?,
	KeepModel: boolean?, -- a boss: its own service plays its death before it dissolves (Prompt 15)
}
export type Spec = {
	Kind: Kind,
	Team: Team,
	Root: BasePart?,
	Health: number?,
	Player: Player?,
	ResidentId: string?,
	MonsterType: string?,
	Id: string?,
	KeepModel: boolean?, -- don't dissolve the model at death (a boss plays its death clip first)
}

local CombatService = {
	Name = "CombatService",
	Dependencies = { "SessionService", "BunkerGrid", "PowerService", "ResidentService", "DevService" },
	Damaged = Signal.new() :: Signal.Signal<string, number, string?, string?>,
	Downed = Signal.new() :: Signal.Signal<string>,
	Revived = Signal.new() :: Signal.Signal<string, number?>,
	Died = Signal.new() :: Signal.Signal<string>,
}

local grid: any = nil
local power: any = nil
local residents: any = nil
local dev: any = nil

local combatants: { [string]: Combatant } = {}
-- Prompt 20: classes scale damage (fn(target, amount, source?, how?) -> amount) and set max health
local filters: { { Name: string, Fn: (Combatant, number, Combatant?, string?) -> number } } = {}
local maxHealthFn: ((Player) -> number)? = nil
local byModel: { [Model]: string } = {}
local monsterCount = 0
local fellAt: { [Player]: Vector3 } = {} -- where a player went down, for the respawn choice
local respawnAt: { [Player]: CFrame } = {}
local lifeTask: { [Player]: thread } = {}
local dummyAttack = false

local function now(): number
	return workspace:GetServerTimeNow()
end

local function playerId(player: Player): string
	return `P{player.UserId}`
end

-- The model's reach: half its widest side, so a hit anywhere on its body is near its root.
local function reachOf(model: Model): number
	local _, size = model:GetBoundingBox()
	return math.max(size.X, size.Y, size.Z) / 2
end

local function setLife(player: Player, life: string, endsAt: number?)
	player:SetAttribute("Life", life)
	player:SetAttribute("LifeEndsAt", endsAt)
end

local function humanoidOf(c: Combatant): Humanoid?
	return c.Model:FindFirstChildOfClass("Humanoid")
end

-- Combatants -----------------------------------------------------------------------------

function CombatService:Register(model: Model, spec: Spec): string?
	local root = spec.Root or model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		log:Warn("%s has no root part to register", model:GetFullName())
		return nil
	end
	local id = spec.Id
	if not id then
		monsterCount += 1
		id = `M{monsterCount}`
	end
	local health = spec.Health or 100
	local record: Combatant = {
		Id = id :: string,
		Kind = spec.Kind,
		Team = spec.Team,
		Model = model,
		Root = root,
		Reach = reachOf(model),
		Health = health,
		MaxHealth = health,
		State = "Alive",
		History = {},
		InvulnerableUntil = 0,
		Player = spec.Player,
		ResidentId = spec.ResidentId,
		MonsterType = spec.MonsterType,
		KeepModel = spec.KeepModel,
	}
	combatants[record.Id] = record
	byModel[model] = record.Id
	model:SetAttribute("CombatantId", record.Id)
	model:SetAttribute("Team", record.Team)
	if record.Kind == "Monster" or record.Kind == "Survivor" then
		model:SetAttribute("Health", health)
		model:SetAttribute("MaxHealth", health)
	end
	return record.Id
end

function CombatService:Unregister(id: string)
	local record = combatants[id]
	if not record then
		return
	end
	combatants[id] = nil
	if byModel[record.Model] == id then
		byModel[record.Model] = nil
	end
end

function CombatService:Get(id: string): Combatant?
	return combatants[id]
end

-- The combatant a part belongs to (its model, or a model above it).
function CombatService:OfInstance(instance: Instance?): Combatant?
	local node = instance
	while node and node ~= workspace do
		if node:IsA("Model") then
			local id = byModel[node]
			if id then
				return combatants[id]
			end
		end
		node = node.Parent
	end
	return nil
end

function CombatService:All(team: Team?): { Combatant }
	local list = {}
	for _, c in combatants do
		if team == nil or c.Team == team then
			table.insert(list, c)
		end
	end
	table.sort(list, function(a, b)
		return a.Id < b.Id
	end)
	return list
end

function CombatService:History(id: string): { Combat.Sample }
	local record = combatants[id]
	return if record then record.History else {}
end

function CombatService:PlayerCombatant(player: Player): Combatant?
	return combatants[playerId(player)]
end

function CombatService:SetInvulnerable(id: string, untilTime: number)
	local record = combatants[id]
	if record then
		record.InvulnerableUntil = math.max(record.InvulnerableUntil, untilTime)
		if record.Player then
			record.Player:SetAttribute("InvulnerableUntil", record.InvulnerableUntil)
		end
	end
end

function CombatService:HealthOf(id: string): (number, number)
	local record = combatants[id]
	if not record then
		return 0, 0
	end
	if record.Kind == "Player" then
		local h = humanoidOf(record)
		return if h then h.Health else 0, if h then h.MaxHealth else 0
	elseif record.Kind == "Resident" and record.ResidentId then
		local resident = residents:Get(record.ResidentId)
		return if resident then resident.Health else 0, if resident then resident.MaxHealth else 0
	end
	return record.Health, record.MaxHealth
end

-- Monsters' death: glowing dust, then gone (Section 3) --------------------------------------

local function dissolve(model: Model)
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if root then
		local dust = Instance.new("ParticleEmitter")
		dust.Name = "Dust"
		dust.Color = ColorSequence.new(Color3.fromRGB(124, 255, 155), Color3.fromRGB(46, 120, 70))
		dust.LightEmission = 0.9
		dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		dust.Lifetime = NumberRange.new(0.6, 1.2)
		dust.Speed = NumberRange.new(2, 6)
		dust.SpreadAngle = Vector2.new(180, 180)
		dust.Acceleration = Vector3.new(0, 4, 0)
		dust.Rate = 0
		dust.Parent = root
		dust:Emit(60)
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.Anchored = true
			TweenService:Create(part, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		elseif part:IsA("Decal") or part:IsA("Texture") then
			TweenService:Create(part, TweenInfo.new(0.8), { Transparency = 1 }):Play()
		end
	end
	task.delay(1.4, function()
		model:Destroy()
	end)
end

-- Fades a model out with a puff of Source dust and destroys it (what a dead monster does).
function CombatService:Dissolve(model: Model)
	dissolve(model)
end

-- Players: down, revive, die, respawn ---------------------------------------------------------

local function clearLifeTask(player: Player)
	local running = lifeTask[player]
	lifeTask[player] = nil
	if running and coroutine.status(running) == "suspended" then
		task.cancel(running)
	end
end

local function removePrompt(record: Combatant)
	local prompt = record.Root:FindFirstChild("RevivePrompt")
	if prompt then
		prompt:Destroy()
	end
end

-- The working Medbays' respawn points (Section 9), nearest first is Combat.Nearest's job. A
-- burning Medbay isn't one (Prompt 13): nobody comes back into a fire.
local function respawnPlaces(): { Combat.Place }
	local places = {}
	for _, room in grid:RoomsOfType("Medbay") do
		if not room.Wrecked and not power:IsDark(room.Id) and not Hazards.Fire(room.Id) then
			local model = grid:RoomModel(room.Id)
			local respawn = model and model:FindFirstChild("Respawn", true)
			local position = if respawn and respawn:IsA("Attachment")
				then respawn.WorldPosition
				else Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, 0, 4)
			table.insert(places, { Id = room.Id, Position = position })
		end
	end
	return places
end

-- The Blast Door hall, where players come back when no Medbay works.
local function blastDoorHall(): Vector3
	local doors = grid:RoomsOfType("BlastDoor")
	local door = doors[1]
	if door then
		local column = door.Column + (door.Span - 1) / 2
		return Grid.CellPosition(door.Floor, column) + Vector3.new(0, 0, 8)
	end
	return Grid.CellPosition(1, 0) + Vector3.new(0, 0, 8)
end

local function respawnPoint(from: Vector3?): (CFrame, string)
	local place = Combat.Nearest(from or Vector3.zero, respawnPlaces())
	local position = if place then place.Position else blastDoorHall()
	return CFrame.new(position + Vector3.new(0, 3, 0)), if place then `Medbay {place.Id}` else "the Blast Door hall"
end

local function die(player: Player, why: string)
	local record = CombatService:PlayerCombatant(player)
	clearLifeTask(player)
	if record then
		fellAt[player] = record.Root.Position
		removePrompt(record)
		record.State = "Dead"
		CombatService:Unregister(record.Id)
		CombatService.Died:Fire(record.Id)
	end
	local seconds = Config.Get("Tuning", "Player").RespawnSeconds
	setLife(player, "Dead", now() + seconds)
	log:Info("%s died (%s); back in %d s", player.Name, why, seconds)
	local character = player.Character
	if character then
		character:Destroy()
	end
	lifeTask[player] = task.delay(seconds, function()
		lifeTask[player] = nil
		if player.Parent ~= Players then
			return
		end
		local cframe, where = respawnPoint(fellAt[player])
		respawnAt[player] = cframe
		fellAt[player] = nil
		log:Info("%s respawns at %s", player.Name, where)
		player:LoadCharacter()
	end)
end

function CombatService:Revive(player: Player, by: Player?): (boolean, string?)
	local record = CombatService:PlayerCombatant(player)
	if not record or record.State ~= "Downed" then
		return false, "not downed"
	end
	local h = humanoidOf(record)
	if not h then
		return false, "no character"
	end
	clearLifeTask(player)
	removePrompt(record)
	record.State = "Alive"
	local fraction = Combat.Tuning().ReviveHealthFraction
	h.Health = math.max(1, math.floor(h.MaxHealth * fraction + 0.5))
	setLife(player, "Alive", nil)
	CombatService.Revived:Fire(record.Id, if by then by.UserId else nil)
	log:Info("%s was revived%s", player.Name, if by then ` by {by.Name}` else "")
	return true, nil
end

local function down(player: Player, record: Combatant)
	if record.State ~= "Alive" then
		return
	end
	local p = Config.Get("Tuning", "Player")
	record.State = "Downed"
	setLife(player, "Downed", now() + p.DownedSeconds)
	CombatService.Downed:Fire(record.Id)
	log:Info("%s is down", player.Name)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive"
	prompt.ObjectText = player.DisplayName
	prompt.HoldDuration = p.ReviveSeconds
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Owner", player.UserId)
	prompt:SetAttribute("Kind", "Revive")
	prompt.Triggered:Connect(function(by: Player)
		if by == player then
			return
		end
		local helper = CombatService:PlayerCombatant(by)
		if not helper or helper.State ~= "Alive" then
			return
		end
		CombatService:Revive(player, by)
	end)
	prompt.Parent = record.Root

	clearLifeTask(player)
	lifeTask[player] = task.delay(p.DownedSeconds, function()
		lifeTask[player] = nil
		if record.State == "Downed" then
			die(player, "not revived in time")
		end
	end)
end

local function watchCharacter(player: Player, character: Model)
	local h = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not h or not root or character.Parent == nil then
		return
	end
	-- No regeneration: Roblox's Health script goes (Section 9: health comes back by healing)
	local function dropRegen(child: Instance)
		if child.Name == "Health" and child:IsA("Script") then
			child:Destroy()
		end
	end
	local regen = character:FindFirstChild("Health")
	if regen then
		dropRegen(regen)
	end
	character.ChildAdded:Connect(dropRegen)

	local maxHealth = CombatService:MaxHealthOf(player)
	h.BreakJointsOnDeath = false
	h.RequiresNeck = false
	h.MaxHealth = maxHealth
	h.Health = maxHealth
	local spawnAt = respawnAt[player]
	respawnAt[player] = nil
	if spawnAt then
		task.defer(function()
			if character.Parent then
				character:PivotTo(spawnAt)
			end
		end)
	end

	local old = CombatService:PlayerCombatant(player)
	if old then
		CombatService:Unregister(old.Id)
	end
	local id = CombatService:Register(character, {
		Kind = "Player",
		Team = "Survivors",
		Root = root,
		Health = maxHealth,
		Player = player,
		Id = playerId(player),
	})
	if not id then
		return
	end
	local record = combatants[id]
	setLife(player, "Alive", nil)
	player:SetAttribute("InvulnerableUntil", 0)

	h.HealthChanged:Connect(function(health: number)
		if health <= 0 and record.State == "Alive" and combatants[id] == record then
			down(player, record)
		end
	end)
	h.Died:Connect(function()
		if combatants[id] == record and record.State ~= "Dead" then
			die(player, "the character died")
		end
	end)
	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil and combatants[id] == record then
			CombatService:Unregister(id)
		end
	end)
end

-- Damage and healing ---------------------------------------------------------------------------

-- Hurts a combatant; returns the damage done (0 for a teammate, an invulnerable dodge, or a
-- combatant already down).
function CombatService:Damage(targetId: string, amount: number, sourceId: string?, how: string?): number
	local target = combatants[targetId]
	if not target or amount <= 0 or target.State ~= "Alive" then
		return 0
	end
	local source = if sourceId then combatants[sourceId] else nil
	if source and source.Team == target.Team then
		return 0 -- no friendly fire (Section 9)
	end
	if now() < target.InvulnerableUntil then
		return 0
	end
	for _, filter in filters do
		local ok, scaled = pcall(filter.Fn, target, amount, source, how)
		if ok and type(scaled) == "number" and scaled == scaled then
			amount = math.max(scaled, 0)
		elseif not ok then
			log:Warn("damage filter %s: %s", filter.Name, tostring(scaled))
		end
	end
	if amount <= 0 then
		return 0
	end
	local done = amount
	if target.Kind == "Player" then
		local h = humanoidOf(target)
		if not h then
			return 0
		end
		if h.Health - amount <= 0 then
			-- A player's Humanoid never reaches 0: at 0 the server kills it whatever the client's
			-- states (playtest, Nov 8, 2026). It stays at 1 and the player is Downed instead; the
			-- HUD shows 0 while down (CombatController).
			done = h.Health
			h.Health = 1
			CombatService.Damaged:Fire(targetId, done, sourceId, how)
			if target.Player then
				down(target.Player, target)
			end
			return done
		end
		h.Health -= amount
	elseif target.Kind == "Resident" then
		if target.ResidentId then
			residents:Hurt(target.ResidentId, amount, how or "attacked")
		end
	else
		done = math.min(amount, target.Health)
		target.Health = math.max(target.Health - amount, 0)
		target.Model:SetAttribute("Health", target.Health)
		if target.Health <= 0 then
			target.State = "Dead"
			CombatService:Unregister(target.Id)
			CombatService.Damaged:Fire(targetId, done, sourceId, how)
			CombatService.Died:Fire(targetId)
			if not target.KeepModel then
				dissolve(target.Model)
			end
			return done
		end
	end
	CombatService.Damaged:Fire(targetId, done, sourceId, how)
	return done
end

function CombatService:Heal(id: string, amount: number): number
	local target = combatants[id]
	if not target or target.State ~= "Alive" or amount <= 0 then
		return 0
	end
	if target.Kind == "Player" then
		local h = humanoidOf(target)
		if not h then
			return 0
		end
		local before = h.Health
		h.Health = math.min(h.Health + amount, h.MaxHealth)
		return h.Health - before
	end
	local before = target.Health
	target.Health = math.min(target.Health + amount, target.MaxHealth)
	target.Model:SetAttribute("Health", target.Health)
	return target.Health - before
end

-- Classes (Prompt 20) -----------------------------------------------------------------------------

-- A filter every hit passes through before it lands; a later Add with the same name replaces it.
function CombatService:AddDamageFilter(name: string, fn: (Combatant, number, Combatant?, string?) -> number)
	for i, filter in filters do
		if filter.Name == name then
			table.remove(filters, i)
			break
		end
	end
	table.insert(filters, { Name = name, Fn = fn })
end

function CombatService:SetMaxHealthFn(fn: ((Player) -> number)?)
	maxHealthFn = fn
end

function CombatService:MaxHealthOf(player: Player): number
	local base = Config.Get("Tuning", "Player").Health
	local fn = maxHealthFn
	if fn then
		local ok, value = pcall(fn, player)
		if ok and type(value) == "number" and value >= 1 then
			return math.floor(value + 0.5)
		elseif not ok then
			log:Warn("max health: %s", tostring(value))
		end
	end
	return base
end

-- A player's max health changed (a class, Hearty Meal): a higher max adds the difference, a lower
-- one caps their health. A downed player keeps the 1 their Humanoid holds.
function CombatService:RefreshMaxHealth(player: Player)
	local record = CombatService:PlayerCombatant(player)
	local h = if record then humanoidOf(record) else nil
	if not record or not h then
		return
	end
	local new = CombatService:MaxHealthOf(player)
	local old = h.MaxHealth
	if math.abs(new - old) < 0.5 then
		return
	end
	h.MaxHealth = new
	record.MaxHealth = new
	if record.State == "Alive" then
		h.Health = if new > old then math.min(h.Health + (new - old), new) else math.min(h.Health, new)
	end
end

-- Residents' bodies ------------------------------------------------------------------------------

local function watchResidents()
	local bunkerRoot = grid:Root()
	if not bunkerRoot then
		log:Warn("no bunker yet: residents aren't combatants")
		return
	end
	local function attach(folder: Instance)
		if not folder:IsA("Folder") or folder.Name ~= "Residents" then
			return
		end
		local function add(body: Instance)
			if body:IsA("Model") then
				local residentId = body:GetAttribute("ResidentId") or body.Name
				if type(residentId) == "string" and string.match(residentId, "^N%d+$") then
					CombatService:Register(body, { Kind = "Resident", Team = "Survivors", ResidentId = residentId, Id = residentId })
				end
			end
		end
		for _, body in folder:GetChildren() do
			add(body)
		end
		folder.ChildAdded:Connect(add)
		folder.ChildRemoved:Connect(function(body: Instance)
			local id = if body:IsA("Model") then byModel[body] else nil
			if id then
				CombatService:Unregister(id)
			end
		end)
	end
	local existing = bunkerRoot:FindFirstChild("Residents")
	if existing then
		attach(existing)
	end
	bunkerRoot.ChildAdded:Connect(attach)
end

-- History --------------------------------------------------------------------------------------

local function record(t: number, keep: number)
	for _, c in combatants do
		local root = c.Root
		if root.Parent then
			local history = c.History
			table.insert(history, { T = t, P = root.Position })
			while #history > 0 and history[1].T < t - keep do
				table.remove(history, 1)
			end
		end
	end
end

-- Dev: a target dummy until Prompt 12's monsters ----------------------------------------------

local function spawnDummy(player: Player?, monsterId: string, health: number?): (string?, string?)
	player = player or Players:GetPlayers()[1] -- run from Studio's command bar: the first player
	local monster = Config.Find("Monsters", monsterId)
	if not monster then
		return nil, `no monster {monsterId}`
	end
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Monsters")
	local template = folder and folder:FindFirstChild(monster.Asset)
	if not (template and template:IsA("Model")) then
		return nil, `no model {monster.Asset} in ServerStorage.Assets.Monsters`
	end
	local model = template:Clone()
	model.Name = `Dummy_{monsterId}`
	local at = CFrame.new(Grid.CellPosition(2, 2) + Vector3.new(0, 0, 6))
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		look = if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)
		local spot = root.Position + look * 12
		at = CFrame.lookAt(spot, Vector3.new(root.Position.X, spot.Y, root.Position.Z))
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
		end
	end
	local primary = model.PrimaryPart
	if primary then
		primary.Anchored = true
	end
	-- stand it on the floor under the spot
	local hit = workspace:Raycast(at.Position + Vector3.new(0, 4, 0), Vector3.new(0, -20, 0))
	local floorY = if hit then hit.Position.Y else at.Position.Y - 3
	model:PivotTo(at)
	local cf, size = model:GetBoundingBox()
	model:PivotTo(at + Vector3.new(0, floorY - (cf.Position.Y - size.Y / 2), 0))
	local holder = workspace:FindFirstChild("Dummies") or Instance.new("Folder")
	holder.Name = "Dummies"
	holder.Parent = workspace
	model.Parent = holder
	local id = CombatService:Register(model, {
		Kind = "Monster",
		Team = "Monsters",
		Health = health or monster.Health,
		MonsterType = monsterId,
	})
	return id, nil
end

local function dummyAttackLoop()
	while true do
		task.wait(0.25)
		if dummyAttack then
			for _, c in combatants do
				if c.Kind == "Monster" and c.State == "Alive" and not c.Model:GetAttribute("Attacking") then
					local monster = Config.Find("Monsters", c.MonsterType)
					if monster then
						-- the nearest standing player in range
						local best, bestDistance = nil, math.huge
						for _, other in combatants do
							if other.Kind == "Player" and other.State == "Alive" then
								local distance = (other.Root.Position - c.Root.Position).Magnitude - c.Reach
								if distance <= monster.Range and distance < bestDistance then
									best, bestDistance = other, distance
								end
							end
						end
						if best then
							local target = best
							c.Model:SetAttribute("Attacking", true)
							task.spawn(function()
								local look = Vector3.new(target.Root.Position.X, c.Root.Position.Y, target.Root.Position.Z)
								if (look - c.Root.Position).Magnitude > 0.1 then
									c.Model:PivotTo(CFrame.lookAt(c.Root.Position, look) * (c.Root.CFrame:Inverse() * c.Model:GetPivot()))
								end
								-- the rig's attack clip (its Anim_Attack attribute, from the art pipeline)
								local animator = c.Model:FindFirstChildWhichIsA("Animator", true)
								local clipId = c.Model:GetAttribute("Anim_Attack")
								local hitAt = 0.7
								if animator and type(clipId) == "string" then
									local clip = Instance.new("Animation")
									clip.AnimationId = clipId
									local ok, track = pcall(function()
										return (animator :: Animator):LoadAnimation(clip)
									end)
									if ok and track then
										track:Play()
									end
								end
								task.wait(hitAt) -- the windup; the hit is checked again when it lands
								if combatants[c.Id] and target.State == "Alive" then
									local distance = (target.Root.Position - c.Root.Position).Magnitude - c.Reach
									if distance <= monster.Range + 1 then
										CombatService:Damage(target.Id, monster.Damage, c.Id, "struck")
									end
								end
								task.wait(math.max(monster.AttackSeconds - hitAt, 0.2))
								if c.Model.Parent then
									c.Model:SetAttribute("Attacking", nil)
								end
							end)
						end
					end
				end
			end
		end
	end
end

-- Lifecycle --------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	for _, c in CombatService:All() do
		local health, max = CombatService:HealthOf(c.Id)
		table.insert(lines, string.format("%s %s %s (%s): %d/%d %s, history %d", c.Id, c.Kind, c.Model.Name, c.Team,
			math.ceil(health), math.ceil(max), c.State, #c.History))
	end
	return if #lines > 0 then table.concat(lines, "\n") else "no combatants"
end

local function target(player: Player?, name: any): Player?
	if type(name) == "string" and name ~= "" then
		for _, p in Players:GetPlayers() do
			if string.lower(p.Name) == string.lower(name) or string.lower(p.DisplayName) == string.lower(name) then
				return p
			end
		end
		return nil
	end
	return player
end

function CombatService:Init(registry)
	grid = registry.BunkerGrid
	power = registry.PowerService
	residents = registry.ResidentService
	dev = registry.DevService

	dev:Register("combat", {
		Description = "Every combatant: health, state and position history.",
		Usage = "combat",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("hurt", {
		Description = "Hurt a player (you by default), as a monster would.",
		Usage = "hurt [amount] [player]",
		Run = function(player, args): string?
			local who = target(player, args[2])
			local c = who and CombatService:PlayerCombatant(who)
			if not c then
				return "no such player in the fight"
			end
			local done = CombatService:Damage(c.Id, tonumber(args[1]) or 25, nil, "dev")
			local health, max = CombatService:HealthOf(c.Id)
			return `{who and who.Name}: -{done}, {math.ceil(health)}/{max}`
		end,
	})
	dev:Register("heal", {
		Description = "Heal a player (you by default).",
		Usage = "heal [amount] [player]",
		Run = function(player, args): string?
			local who = target(player, args[2])
			local c = who and CombatService:PlayerCombatant(who)
			if not c then
				return "no such player in the fight"
			end
			local done = CombatService:Heal(c.Id, tonumber(args[1]) or 100)
			return `{who and who.Name}: +{done}`
		end,
	})
	dev:Register("down", {
		Description = "Down a player (you by default).",
		Usage = "down [player]",
		Run = function(player, args): string?
			local who = target(player, args[1])
			local c = who and CombatService:PlayerCombatant(who)
			if not c then
				return "no such player in the fight"
			end
			CombatService:Damage(c.Id, 10000, nil, "dev")
			return `{who and who.Name}: {who and who:GetAttribute("Life")}`
		end,
	})
	dev:Register("revive", {
		Description = "Revive a downed player (you by default), as a teammate would.",
		Usage = "revive [player]",
		Run = function(player, args): string?
			local who = target(player, args[1])
			if not who then
				return "no such player"
			end
			local ok, why = CombatService:Revive(who, nil)
			return if ok then `{who.Name} is up` else `can't: {why}`
		end,
	})
	dev:Register("god", {
		Description = "A player takes no damage for a while (you by default; Studio testing, e.g. a boss fight).",
		Usage = "god [seconds] [player]",
		Run = function(player, args): string?
			local who = target(player, args[2])
			local c = who and CombatService:PlayerCombatant(who)
			if not c then
				return "no such player in the fight"
			end
			local seconds = tonumber(args[1]) or 600
			CombatService:SetInvulnerable(c.Id, now() + seconds)
			return `{who and who.Name} takes no damage for {seconds} s (until they respawn)`
		end,
	})
	dev:Register("kill", {
		Description = "Skip a downed player's wait: dead now, back after the respawn time.",
		Usage = "kill [player]",
		Run = function(player, args): string?
			local who = target(player, args[1])
			if not who then
				return "no such player"
			end
			die(who, "dev")
			return `{who.Name} is dead`
		end,
	})
	dev:Register("dummy", {
		Description = "A monster that stands still to be hit, in front of you (until Prompt 12's monsters).",
		Usage = "dummy [MonsterId] [health]",
		Run = function(player, args): string?
			local id, why = spawnDummy(player, tostring(args[1] or "HollowMiner"), tonumber(args[2]))
			return if id then `{id} is up` else `can't: {why}`
		end,
	})
	dev:Register("dummy.attack", {
		Description = "Dummies strike the nearest standing player in reach (on or off).",
		Usage = "dummy.attack [on|off]",
		Run = function(_player, args): string?
			dummyAttack = if args[1] == nil then not dummyAttack else args[1] == "on"
			return `dummies attack: {dummyAttack}`
		end,
	})
	dev:Register("dummy.clear", {
		Description = "Remove every dummy.",
		Usage = "dummy.clear",
		Run = function(): string?
			local count = 0
			for _, c in CombatService:All("Monsters") do
				if string.match(c.Model.Name, "^Dummy_") then
					CombatService:Unregister(c.Id)
					c.Model:Destroy()
					count += 1
				end
			end
			return `{count} removed`
		end,
	})
end

function CombatService:Start()
	local t = Combat.Tuning()
	Players.RespawnTime = Config.Get("Tuning", "Player").RespawnSeconds
	local function joined(player: Player)
		setLife(player, "Alive", nil)
		player.CharacterAdded:Connect(function(character)
			watchCharacter(player, character)
		end)
		if player.Character then
			task.spawn(watchCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(joined)
	for _, player in Players:GetPlayers() do
		joined(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		clearLifeTask(player)
		local c = CombatService:PlayerCombatant(player)
		if c then
			CombatService:Unregister(c.Id)
		end
		fellAt[player] = nil
		respawnAt[player] = nil
	end)

	watchResidents()

	local step = 1 / math.max(t.HistoryHz, 1)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= step then
			acc = 0
			record(now(), t.HistorySeconds + 0.2)
		end
	end)
	task.spawn(dummyAttackLoop)
	log:Info("combat ready: players %d health, downed %d s, respawn %d s", Config.Get("Tuning", "Player").Health,
		Config.Get("Tuning", "Player").DownedSeconds, Config.Get("Tuning", "Player").RespawnSeconds)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000FB"><Properties><string name="Name">CutsceneService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CutsceneService: the server's small part in the intro cutscene (bible Section 4; Prompt 22).
	The cutscene itself is played by each client (CutsceneController): it is personal, a player can
	skip it, and the run's clock starts at the 30-second mark whatever anyone does (RunDirector's
	Intro phase).

	* The set. The client can't reach ServerStorage, so at the start this puts the set together in
	  ReplicatedStorage.CutsceneSet from Config.CutscenePaths (made in Blender) and the art in
	  ServerStorage.Assets: Pieces (every placed model, with its Kind and its place in the list),
	  Ground (roads, pavements and grass as plain blocks) and Effects (the Cutscene models that
	  stand nowhere until the client moves them: the bomb, the cloud, the ring, the rock above the
	  bunker, the Source's hollow). It is laid out around the world's origin: the client clones it
	  and moves the copy to Tuning.Cutscene.SetOrigin. Nothing of it is ever in workspace on the
	  server, so nobody can walk onto it. KeepSetSeconds into the run it is destroyed, which frees
	  it on every client (in Studio it stays, for the dev replay).
	* The first run. "An account's first run plays it in full": each player's IntroFirstRun
	  attribute says whether this is theirs (the profile's FirstRunDone), set as their session
	  becomes ready.

	Dev: `intro` (the set and each player's flag), `intro.first [true|false] [player]`.
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)

local log = Log.new("CutsceneService")

local SET_NAME = "CutsceneSet"
local ASSET_TAG = "Asset" -- marks the source models in ServerStorage.Assets; copies drop it
local ATTRIBUTE = "IntroFirstRun"

local CutsceneService = {
	Name = "CutsceneService",
	Dependencies = { "RunDirector", "SessionService", "ProfileService", "DevService" },
}

local run: any = nil
local session: any = nil
local profiles: any = nil
local dev: any = nil
local missing: { string } = {}
local placed = 0

local function art(category: string, name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = if assets then assets:FindFirstChild(category) else nil
	local found = if folder then folder:FindFirstChild(name) else nil
	return if found and found:IsA("Model") then found else nil
end

-- Scenery: nothing touches it, nothing queries it, nothing is simulated.
local function still(root: Instance)
	for _, item in root:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
		end
	end
end

local function copy(source: Model, name: string): Model
	local model = source:Clone()
	model.Name = name
	CollectionService:RemoveTag(model, ASSET_TAG)
	local colliders = model:FindFirstChild("Colliders")
	if colliders then
		colliders:Destroy()
	end
	return model
end

local function build(): Model
	local path = Config.Get("CutscenePaths", "Intro")
	local set = Instance.new("Model")
	set.Name = SET_NAME
	local pieces = Instance.new("Folder")
	pieces.Name = "Pieces"
	pieces.Parent = set
	local used: { [string]: boolean } = {}
	table.clear(missing)
	placed = 0
	for index, spot in path.Set do
		used[spot.Asset] = true
		local source = art(spot.Category, spot.Asset)
		if not source then
			if not table.find(missing, spot.Asset) then
				table.insert(missing, spot.Asset)
			end
			continue
		end
		local model = copy(source, spot.Name)
		if spot.Kind ~= "Still" then
			local lights = model:FindFirstChild("Lights") -- street lamps and signs are off: it is morning
			if lights then
				lights:Destroy()
			end
		end
		if math.abs(spot.Scale - 1) > 0.001 then
			model:ScaleTo(spot.Scale)
		end
		model:PivotTo(CFrame.new(spot.P[1], spot.P[2], spot.P[3]) * CFrame.Angles(0, math.rad(spot.Yaw), 0))
		if spot.Paint then
			local paint = model:FindFirstChild("Paint")
			if paint and paint:IsA("BasePart") then
				paint.Color = Color3.fromHex(spot.Paint)
			end
		end
		still(model)
		model:SetAttribute("Kind", spot.Kind)
		model:SetAttribute("Index", index)
		model.Parent = pieces
		placed += 1
	end
	local ground = Instance.new("Folder")
	ground.Name = "Ground"
	ground.Parent = set
	for _, slab in path.Ground do
		local part = Instance.new("Part")
		part.Name = slab.Name
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Material = Enum.Material.SmoothPlastic
		part.TopSurface = Enum.SurfaceType.Smooth
		part.BottomSurface = Enum.SurfaceType.Smooth
		part.Color = Color3.fromHex(slab.Hex)
		part.Size = Vector3.new(slab.Size[1], slab.Size[2], slab.Size[3])
		part.CFrame = CFrame.new(slab.P[1], slab.P[2], slab.P[3])
		part.Parent = ground
	end
	local effects = Instance.new("Folder")
	effects.Name = "Effects"
	effects.Parent = set
	local assets = ServerStorage:FindFirstChild("Assets")
	local category = if assets then assets:FindFirstChild("Cutscene") else nil
	if category then
		for _, source in category:GetChildren() do
			if source:IsA("Model") and not used[source.Name] then
				local model = copy(source, source.Name)
				still(model)
				model.Parent = effects
			end
		end
	end
	return set
end

local function flag(player: Player)
	local data = profiles:Get(player)
	player:SetAttribute(ATTRIBUTE, data ~= nil and data.FirstRunDone == false)
end

local function describe(): string
	local set = ReplicatedStorage:FindFirstChild(SET_NAME)
	local lines = {
		if set
			then `intro set: {placed} pieces, {#set.Ground:GetChildren()} ground blocks, {#set.Effects:GetChildren()} effects`
			else "intro set: gone (the run has started)",
	}
	if #missing > 0 then
		table.insert(lines, `  not in ServerStorage.Assets: {table.concat(missing, ", ")}`)
	end
	for _, player in session:ReadyPlayers() do
		table.insert(lines, `  {player.Name}: first run {tostring(player:GetAttribute(ATTRIBUTE))}`)
	end
	return table.concat(lines, "\n")
end

function CutsceneService:Init(registry)
	run = registry.RunDirector
	session = registry.SessionService
	profiles = registry.ProfileService
	dev = registry.DevService
	dev:Register("intro", {
		Description = "the intro cutscene's set and each player's first-run flag",
		Run = function(_player: Player?, _args: { any }): string
			return describe()
		end,
	})
	dev:Register("intro.first", {
		Description = "say whether this is the player's first run (the cutscene plays in full, no Skip)",
		Usage = "intro.first [true|false] [player]",
		Run = function(player: Player?, args: { any }): string
			local target = player
			if type(args[2]) == "string" then
				for _, other in session:ReadyPlayers() do
					if string.lower(other.Name) == string.lower(args[2]) then
						target = other
					end
				end
			end
			target = target or session:ReadyPlayers()[1]
			if not target then
				return "no player"
			end
			target:SetAttribute(ATTRIBUTE, args[1] ~= false)
			return describe()
		end,
	})
end

function CutsceneService:Start()
	local began = os.clock()
	local set = build()
	set.Parent = ReplicatedStorage
	if #missing > 0 then
		log:Warn("the intro's set is missing art: %s", table.concat(missing, ", "))
	end
	log:Info("the intro's set is ready: %d pieces in %.0f ms", placed, (os.clock() - began) * 1000)
	for _, player in session:ReadyPlayers() do
		flag(player)
	end
	session.PlayerReady:Connect(flag)
	run.PhaseChanged:Connect(function(new: string)
		if new == "Playing" and not RunService:IsStudio() then
			task.delay(Config.Get("Tuning", "Cutscene").KeepSetSeconds, function()
				local live = ReplicatedStorage:FindFirstChild(SET_NAME)
				if live then
					live:Destroy()
				end
			end)
		end
	end)
end

return CutsceneService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000FC"><Properties><string name="Name">CycleClock</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CycleClock: 4:30 cycles, day and Surge phases, the year counter, Years per Cycle and skips
	(bible Sections 5 and 23). Run place only.

	A cycle is a 3:00 day (building, digging, trips outside) then a 1:30 Surge (a breach wave
	below, a storm above, one disaster). The siren sounds 20 seconds before the Surge. A Surge
	ends when its time is up, or earlier when ThreatDirector calls EndSurge (its last monster
	died and its disaster is fixed). A boss Surge (an era boss, or the final Surge's Source)
	has no timer and ignores EndSurge: it ends when its boss is beaten (ObjectiveService's
	BossDefeated; Landon, Nov 8, 2026). Then the year counter jumps by Years per Cycle and the
	next cycle starts. The arithmetic (Years per Cycle, era bosses, the final Surge, Endless)
	is Shared.Rules.Clock; the published values are Shared.RunState.

	Skips: when every player in the run has pressed Ready (the SetReady remote) or is resting
	in a Quarters bed (SetResting, called by the bed interaction), the day jumps to the siren.
	Ready and resting both count only during a day before the siren, and both reset at the
	siren (Landon, Nov 8, 2026), so a player still in bed when a day starts lies down again.

	RunDirector drives it: Begin when the intro ends, Halt on a victory or a defeat, Resume
	(after SetEndless) for Keep Going. When the final Surge ends (the Source is beaten) the
	clock halts by itself, before the year jumps, and fires CenturySurvived.

	API:
		CycleClock.CycleStarted: Signal<number>              -- the cycle number (residents eat and drink)
		CycleClock.SirenStarted: Signal<SurgeKind, string?>  -- 20 s to the Surge: its kind and boss
		CycleClock.SurgeStarted: Signal<SurgeKind, string?>
		CycleClock.SurgeEnded: Signal<SurgeKind, string>     -- how: "Time", "Cleared" or "Boss"
		CycleClock.YearChanged: Signal<number, number>       -- year, previous year (aging)
		CycleClock.EraChanged: Signal<string, string>        -- era, previous era
		CycleClock.CenturySurvived: Signal<()>
		CycleClock.Skipped: Signal<()>                       -- everyone was ready
		CycleClock:Begin(), :Halt(), :Resume(), :SetEndless(on)
		CycleClock:EndSurge(): boolean                       -- ThreatDirector: this Surge is cleared (not a boss Surge)
		CycleClock:SetResting(player, on): boolean           -- a player lies down in or leaves a Quarters bed
		CycleClock:Phase(), :Year(), :Cycle(), :Era(), :YearsPerCycle(), :Surge(), :TimeLeft(), :IsRunning(), :TimeScale()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Clock = require(Shared.Rules.Clock)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("CycleClock")

export type CyclePhase = RunState.CyclePhase
export type SurgeKind = Clock.SurgeKind

local CycleClock = {
	Name = "CycleClock",
	Dependencies = { "SessionService", "ObjectiveService", "DevService" },
	CycleStarted = Signal.new() :: Signal.Signal<number>,
	SirenStarted = Signal.new() :: Signal.Signal<SurgeKind, string?>,
	SurgeStarted = Signal.new() :: Signal.Signal<SurgeKind, string?>,
	SurgeEnded = Signal.new() :: Signal.Signal<SurgeKind, string>,
	YearChanged = Signal.new() :: Signal.Signal<number, number>,
	EraChanged = Signal.new() :: Signal.Signal<string, string>,
	CenturySurvived = Signal.new() :: Signal.Signal<()>,
	Skipped = Signal.new() :: Signal.Signal<()>,
}

local MAX_TIME_SCALE = 100

local session: any = nil
local objectives: any = nil
local set: (string, any) -> () = function() end
local tuning: { [string]: any } = {}

local state: Clock.State = Clock.NewState()
local begun = false
local running = false -- the timers are live
local halted = false -- RunDirector stopped the clock (a victory or a defeat)
local devPaused = false -- DevTools paused it
local cycleEndPending = false -- stopped after the final Surge, before the year jumps
local openEnded = false -- this phase has no timer (a boss Surge)
local phase: CyclePhase? = nil
local surgeKind: SurgeKind = "Tutorial"
local surgeBoss: string? = nil
local phaseLength = 0 -- seconds of clock time
local endsAt = 0 -- server time
local sirenAt: number? = nil -- server time; nil once the siren sounds, and during Surges
local siren = false
local leftWhenStopped = 0 -- clock seconds left in the phase when the clock stopped
local sirenInWhenStopped: number? = nil
local scale = 1
local ready: { [Player]: boolean } = {}
local resting: { [Player]: boolean } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Publishing ------------------------------------------------------------------------------

local function publishTimes()
	set("PhaseLength", phaseLength)
	set("PhaseOpen", if openEnded then true else nil)
	if openEnded then
		set("PhaseEndsAt", nil)
		set("PhaseLeft", nil)
	elseif running then
		set("PhaseEndsAt", endsAt)
		set("PhaseLeft", nil)
	else
		set("PhaseEndsAt", nil)
		set("PhaseLeft", leftWhenStopped / scale)
	end
end

local function publishSurge()
	set("SurgeKind", surgeKind)
	set("SurgeBoss", surgeBoss)
end

local function publishYear()
	set("Cycle", state.Cycle)
	set("Year", state.Year)
	set("Era", Clock.EraOf(state.Year))
	set("YearsPerCycle", Clock.YearsPerCycle(state.Completed))
end

-- Ready and skips -------------------------------------------------------------------------

local startSiren: () -> ()
local skipToSiren: (why: string) -> ()

-- A skip is possible during a day, before the siren.
local function canSkip(): boolean
	return running and phase == "Day" and sirenAt ~= nil
end

local function countReady(leaving: Player?)
	local inRun = 0
	local count = 0
	for _, player in session:ReadyPlayers() do
		if player ~= leaving then
			inRun += 1
			if ready[player] or resting[player] then
				count += 1
			end
		end
	end
	set("ReadyCount", count)
	set("ReadyNeeded", inRun)
	if inRun > 0 and count == inRun and canSkip() then
		skipToSiren("everyone is ready")
	end
end

local function setReady(player: Player, on: boolean)
	if (ready[player] == true) == on then
		return
	end
	ready[player] = if on then true else nil
	player:SetAttribute("Ready", on)
	countReady()
end

local function clearReady()
	for player in ready do
		if player.Parent then
			player:SetAttribute("Ready", false)
		end
	end
	table.clear(ready)
end

local function clearResting()
	for player in resting do
		if player.Parent then
			player:SetAttribute("Resting", false)
		end
	end
	table.clear(resting)
end

-- The SetReady remote and DevTools: Ready only counts during a day, before the siren.
local function requestReady(player: Player, on: boolean): boolean
	if not session:IsReady(player) then
		return false
	end
	if on and not canSkip() then
		return false
	end
	setReady(player, on)
	return true
end

-- Phases ----------------------------------------------------------------------------------

startSiren = function()
	sirenAt = nil
	siren = true
	set("Siren", true)
	clearReady()
	clearResting()
	countReady()
	log:Debug("cycle %d: siren (%s Surge)", state.Cycle, surgeKind)
	CycleClock.SirenStarted:Fire(surgeKind, surgeBoss)
end

skipToSiren = function(why: string)
	endsAt = now() + tuning.SurgeSirenSeconds / scale
	publishTimes()
	log:Info("cycle %d: %s; the day skips to the siren", state.Cycle, why)
	CycleClock.Skipped:Fire()
	startSiren()
end

local function startDay()
	phase = "Day"
	phaseLength = tuning.DaySeconds
	local t = now()
	endsAt = t + phaseLength / scale
	sirenAt = t + math.max(0, phaseLength - tuning.SurgeSirenSeconds) / scale
	siren = false
	openEnded = false
	surgeKind, surgeBoss = Clock.SurgeKind(state)
	clearReady()
	clearResting()
	set("CyclePhase", "Day")
	set("Siren", false)
	publishSurge()
	publishTimes()
	log:Info("cycle %d, Year %d: day (next Surge: %s)", state.Cycle, state.Year, surgeKind)
	CycleClock.CycleStarted:Fire(state.Cycle)
	countReady()
end

local function startSurge()
	surgeKind, surgeBoss = Clock.StartSurge(state)
	phase = "Surge"
	openEnded = Clock.IsOpenEnded(surgeKind)
	phaseLength = if openEnded then 0 else tuning.SurgeSeconds
	endsAt = if openEnded then math.huge else now() + phaseLength / scale
	sirenAt = nil
	siren = false
	clearReady()
	set("CyclePhase", "Surge")
	set("Siren", false)
	publishSurge()
	publishTimes()
	countReady()
	log:Info("cycle %d, Year %d: %s Surge %s", state.Cycle, state.Year, surgeKind, surgeBoss or "")
	CycleClock.SurgeStarted:Fire(surgeKind, surgeBoss)
end

local function endCycle()
	cycleEndPending = false
	local oldEra = Clock.EraOf(state.Year)
	local before, due = Clock.EndCycle(state)
	publishYear()
	if state.Year ~= before then
		CycleClock.YearChanged:Fire(state.Year, before)
	end
	local era = Clock.EraOf(state.Year)
	if era ~= oldEra then
		CycleClock.EraChanged:Fire(era, oldEra)
	end
	if due then
		log:Info("Year %d: %s comes at the next Surge", state.Year, due)
	end
	startDay()
end

local function freeze()
	if not running then
		return
	end
	local t = now()
	leftWhenStopped = if openEnded then 0 else math.max(0, endsAt - t) * scale
	sirenInWhenStopped = if sirenAt then math.max(0, sirenAt - t) * scale else nil
	running = false
	publishTimes()
end

local function thaw()
	if running or not begun or halted or devPaused then
		return
	end
	running = true
	if cycleEndPending then
		endCycle()
		return
	end
	local t = now()
	endsAt = if openEnded then math.huge else t + leftWhenStopped / scale
	sirenAt = if sirenInWhenStopped then t + sirenInWhenStopped / scale else nil
	publishTimes()
	countReady()
end

local function endSurge(how: string)
	local kind = surgeKind
	log:Info("cycle %d: %s Surge over (%s)", state.Cycle, kind, how)
	openEnded = false
	endsAt = now() -- nothing is left of it, however it ended
	cycleEndPending = true -- the year jumps next; if the clock stops first, Resume does it
	CycleClock.SurgeEnded:Fire(kind, how)
	if kind == "Final" then
		-- The century is over. Hold before the year jumps until RunDirector decides: a
		-- Century Victory, and Keep Going resumes the clock into Endless.
		if not halted then
			halted = true
			freeze()
			publishTimes()
			CycleClock.CenturySurvived:Fire()
		end
		return
	end
	if running then
		endCycle()
	end
end

local function tick()
	if not running then
		return
	end
	local t = now()
	if sirenAt and t >= sirenAt then
		startSiren()
	end
	if running and t >= endsAt then
		if phase == "Day" then
			startSurge()
		elseif phase == "Surge" then
			endSurge("Time")
		end
	end
end

local function setScale(value: number)
	local wasRunning = running
	if wasRunning then
		freeze()
	end
	scale = value
	if wasRunning then
		thaw()
	else
		publishTimes()
	end
	set("TimeScale", if scale == 1 then nil else scale)
end

-- API -------------------------------------------------------------------------------------

-- RunDirector: the intro is over; cycle 1 starts.
function CycleClock:Begin()
	if begun then
		return
	end
	begun = true
	running = true
	state.Completed = objectives:Completed()
	publishYear()
	startDay()
	if devPaused or halted then
		freeze()
	end
end

-- RunDirector: stop the clock (a victory or a defeat).
function CycleClock:Halt()
	halted = true
	freeze()
end

-- RunDirector: carry on after a Halt (Keep Going).
function CycleClock:Resume()
	if not halted then
		return
	end
	halted = false
	thaw()
end

-- RunDirector: Endless mode (no year cap, no more era bosses, Endless Surges).
function CycleClock:SetEndless(on: boolean)
	state.Endless = on
	if phase == "Day" then
		surgeKind, surgeBoss = Clock.SurgeKind(state)
		publishSurge()
	elseif on and phase == "Surge" and openEnded then
		-- A Deep Victory during a boss's Surge or the final one (the Source killed in its chamber,
		-- Prompt 25): Endless has no era bosses and no final Surge, so that Surge is over, and the
		-- cycle ends when the clock resumes.
		log:Info("cycle %d: the %s Surge ends with Keep Going", state.Cycle, surgeKind)
		openEnded = false
		cycleEndPending = true
		CycleClock.SurgeEnded:Fire(surgeKind, "Endless")
	end
end

-- ThreatDirector: the Surge's last monster died and its disaster is fixed. A boss Surge
-- carries on until its boss is beaten, so this returns false then.
function CycleClock:EndSurge(): boolean
	if not running or phase ~= "Surge" or openEnded then
		return false
	end
	endSurge("Cleared")
	return true
end

-- The bed interaction: a player lies down in (or gets out of) a Quarters bed. Lying down
-- counts only during a day before the siren, like Ready; returns whether it counted.
function CycleClock:SetResting(player: Player, on: boolean): boolean
	if on and not canSkip() then
		return false
	end
	if (resting[player] == true) == on then
		return true
	end
	resting[player] = if on then true else nil
	player:SetAttribute("Resting", on)
	countReady()
	return true
end

-- Is the current phase a boss Surge with no timer?
function CycleClock:IsOpenEnded(): boolean
	return openEnded
end

function CycleClock:Phase(): CyclePhase?
	return phase
end

function CycleClock:Year(): number
	return state.Year
end

function CycleClock:Cycle(): number
	return state.Cycle
end

function CycleClock:Era(): string
	return Clock.EraOf(state.Year)
end

function CycleClock:YearsPerCycle(): number
	return Clock.YearsPerCycle(state.Completed)
end

-- The coming (during a day) or current Surge: its kind and boss.
function CycleClock:Surge(): (SurgeKind, string?)
	return surgeKind, surgeBoss
end

-- Real seconds left in the current phase.
function CycleClock:TimeLeft(): number
	if running then
		return math.max(0, endsAt - now())
	end
	return leftWhenStopped / scale
end

function CycleClock:IsRunning(): boolean
	return running
end

-- DevTools' time scale (1 normally): the economy runs at the same speed as the clock.
function CycleClock:TimeScale(): number
	return scale
end

-- DevTools --------------------------------------------------------------------------------

local function describe(): string
	local endless = if state.Endless then ", Endless" else ""
	local lines = {
		`cycle {state.Cycle}, Year {state.Year} ({Clock.EraOf(state.Year)}), {Clock.YearsPerCycle(state.Completed)} years per cycle{endless}`,
	}
	if not begun then
		table.insert(lines, "not started: the clock starts when the intro ends")
	else
		local stopped = ""
		if not running then
			local why = {}
			if devPaused then
				table.insert(why, "paused")
			end
			if halted then
				table.insert(why, "halted")
			end
			stopped = ` (stopped: {table.concat(why, ", ")})`
		end
		local sirenText = if siren then ", siren" else ""
		if openEnded then
			table.insert(lines, `{phase}: no timer, until {surgeBoss or "its boss"} is beaten{stopped}`)
		else
			table.insert(lines, `{phase} {string.format("%.1f", CycleClock:TimeLeft())} s left of {phaseLength} s{sirenText}{stopped}`)
		end
		local which = if phase == "Surge" then "this" else "next"
		local bossText = if surgeBoss then ` ({surgeBoss})` else ""
		local dueText = if state.PendingBoss then `, due: {state.PendingBoss}` else ""
		table.insert(lines, `{which} Surge: {surgeKind}{bossText}{dueText}`)
	end
	table.insert(lines, `ready {RunState.Get("ReadyCount") or 0}/{RunState.Get("ReadyNeeded") or 0}`)
	if scale ~= 1 then
		table.insert(lines, `time scale {scale}`)
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("clock", {
		Description = "The cycle clock: cycle, year, phase, time left, the coming Surge, ready count.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("clock.speed", {
		Description = "Run the clock faster or slower (1 is normal).",
		Usage = "clock.speed <0.1 to 100>",
		Run = function(_player, args): string?
			local value = tonumber(args[1])
			if not value or value < 0.1 or value > MAX_TIME_SCALE then
				return `usage: clock.speed <0.1 to {MAX_TIME_SCALE}>`
			end
			setScale(value)
			return describe()
		end,
	})
	dev:Register("clock.pause", {
		Description = "Pause the clock.",
		Run = function(): string?
			devPaused = true
			freeze()
			set("Paused", true)
			return describe()
		end,
	})
	dev:Register("clock.resume", {
		Description = "Resume a paused clock.",
		Run = function(): string?
			devPaused = false
			set("Paused", nil)
			thaw()
			return describe()
		end,
	})
	dev:Register("clock.next", {
		Description = "Jump to the next moment: day to siren, siren to Surge, Surge to the next cycle.",
		Run = function(): string?
			if not begun then
				return "the clock starts when the intro ends (run.skipintro)"
			elseif not running then
				return "the clock is stopped:\n" .. describe()
			end
			if phase == "Day" and sirenAt ~= nil then
				skipToSiren("DevTools")
			elseif phase == "Day" then
				startSurge()
			else
				endSurge("Time")
			end
			return describe()
		end,
	})
	dev:Register("clock.clear", {
		Description = "End the Surge as cleared (what ThreatDirector does when it is over).",
		Run = function(): string?
			if openEnded then
				return `a boss Surge lasts until its boss is beaten: boss.beat {surgeBoss or ""}`
			end
			if not CycleClock:EndSurge() then
				return "no running Surge to clear"
			end
			return describe()
		end,
	})
	dev:Register("boss.beat", {
		Description = "Beat a boss (the current Surge's by default), as the boss fight will: its objective, its Surge ends.",
		Usage = "boss.beat [bossId]",
		Run = function(_player, args): string?
			local id = if args[1] ~= nil then tostring(args[1]) else surgeBoss
			if not id then
				return "usage: boss.beat <bossId> (no boss Surge now)"
			end
			if not objectives:BossBeaten(id) then
				return `{id}: unknown, or already beaten`
			end
			return `{id} beaten\n{describe()}`
		end,
	})
	dev:Register("year", {
		Description = "Set the year counter (bosses come only when a cycle's jump reaches an era's end).",
		Usage = "year <1 to 100, more in Endless>",
		Run = function(_player, args): string?
			local value = tonumber(args[1])
			local top = if state.Endless then 100000 else tuning.FinalYear
			if not value or value ~= math.floor(value) or value < 1 or value > top then
				return `usage: year <1 to {top}>`
			end
			local before = state.Year
			local oldEra = Clock.EraOf(before)
			state.Year = value
			publishYear()
			if phase == "Day" then
				surgeKind, surgeBoss = Clock.SurgeKind(state)
				publishSurge()
			end
			if value ~= before then
				CycleClock.YearChanged:Fire(value, before)
			end
			if Clock.EraOf(value) ~= oldEra then
				CycleClock.EraChanged:Fire(Clock.EraOf(value), oldEra)
			end
			return describe()
		end,
	})
	dev:Register("ready.all", {
		Description = "Set Ready for every player, as if each pressed the button.",
		Usage = "ready.all [true|false]",
		Run = function(_player, args): string?
			local on = args[1] ~= false
			for _, player in session:ReadyPlayers() do
				requestReady(player, on)
			end
			return describe()
		end,
	})
	dev:Register("rest.all", {
		Description = "Put every player in (or out of) a Quarters bed, as the bed interaction will.",
		Usage = "rest.all [true|false]",
		Run = function(_player, args): string?
			local on = args[1] ~= false
			for _, player in session:ReadyPlayers() do
				CycleClock:SetResting(player, on)
			end
			return describe()
		end,
	})
end

-- Lifecycle -------------------------------------------------------------------------------

function CycleClock:Init(registry)
	session = registry.SessionService
	objectives = registry.ObjectiveService
	set = RunState.Writer("CycleClock")
	tuning = Clock.Tuning()
	publishYear()
	set("ReadyCount", 0)
	set("ReadyNeeded", 0)

	Remotes.OnServer("SetReady", function(player: Player, on: boolean)
		requestReady(player, on)
	end)
	registerCommands(registry.DevService)
end

function CycleClock:Start()
	objectives.Changed:Connect(function()
		state.Completed = objectives:Completed()
		set("YearsPerCycle", Clock.YearsPerCycle(state.Completed))
	end)
	objectives.BossDefeated:Connect(function(bossId: string)
		-- A boss Surge ends when its boss falls (even if a DevTools pause holds the clock;
		-- the year then jumps on resume).
		if begun and not halted and phase == "Surge" and openEnded and surgeBoss == bossId then
			endSurge("Boss")
		end
	end)
	session.PlayerReady:Connect(function(player: Player)
		player:SetAttribute("Ready", false)
		player:SetAttribute("Resting", false)
		countReady()
	end)
	session.PlayerLeaving:Connect(function(player: Player)
		ready[player] = nil
		resting[player] = nil
		countReady(player)
	end)
	RunService.Heartbeat:Connect(tick)
end

return CycleClock
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000FD"><Properties><string name="Name">DeepService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DeepService: the Deep, the caves behind the bunker (bible Sections 6, 11, 12 and 23; Run place,
	Prompt 17). The arithmetic is Shared.Rules.Deep; the pieces Config.CavePieces (A6); the numbers
	Tuning.Deep (provisional); the logs Config.RadioLogs.

	* Caves (Section 12: "When a dug cell breaks into a cave, a cave area opens behind it. Caves are
	  put together from hand-made pieces for that band, so no two runs match"): when a cave opening
	  appears in a dug cell (DigService.FeatureAdded), its cave is put together behind the grid from
	  the band's pieces (Rules.Deep.Plan, clear of every cave already open) in workspace.Deep. The
	  dug cell's back rock steps aside for the Entry's rock face (again whenever the grid rebuilds
	  the cell), the mouth's stand-in goes (DigService:OpenCave), exits with no room left are
	  plugged with rubble, and each piece's Light sockets get a lantern's light. Caves stay open
	  (Section 12): the mouth stays a breach point (DigService) and monsters walk in and out
	  through it (MonsterService:SetCaveExit).
	* Finds (Section 12: ore veins, caches, radio logs, cryo pods, trapped miners, Glowshard chests):
	  each Find socket rolls Rules.Deep.RollFind (cryo pods from Era II; the team's best FindChance,
	  the Spelunker's level 2):
	  - Ore vein: MINE: Loot OreVein (the band's ore, "much richer than digging alone") into the
	    miner's pack. Anyone can mine (a Bible Question).
	  - Cache: OPEN: Loot Cache into the opener's pack (radio logs play, throwables to the hotbar).
	  - Radio log: LISTEN: the recorder plays its log (below) to whoever listens.
	  - Trapped miner: RescueService, Kind Miner (Rare at MinerRareChance); brought home, a resident.
	  - Cryo pod: a big find (InventoryService); the Cryo Bay unlocks when the first is found.
	  - Glowshard chest (rare): OPEN: 1 to 3 Glowshards to everyone in the run (a Bible Question).
	  What doesn't fit in a pack stays for TAKE THE REST.
	* Guards and nests (Section 12: monsters; nests): pieces with Spawn sockets hold guards
	  (GuardChance) worth GuardBudget of the band's monsters (Rules.Deep.Roster); a cavern's Nest
	  socket holds a nest (NestChance, else a cache). They come out when a player first comes within
	  WakeRange of their piece, asleep at their posts until one comes within GuardRange
	  (MonsterService guards). A cave nest is a monster combatant: while it lives it raises
	  Disturbance every cycle like a dug nest (NestPerCycle) and feeds breaches through the cave's
	  mouth; destroyed, it pays Loot Nest into the killer's pack, drops Disturbance by NestDestroyed
	  (Section 10) and stops feeding breaches.
	* Lost Crews (Section 12: one in each band of the Deep, their spots change each run, guarded by
	  a nest below): at the start each band's crew is put in a rock cell (Rules.Deep.CrewCell, at
	  least CrewMinDepth from anything open) whose roll becomes a cave opening (DigService:SetRoll);
	  that cave ends in the band's CrewPocket with the crew trapped there (three, one Rare:
	  RescueService Kind Crew, Tag the objective) and a nest with NestBudget of guards. The surface's
	  crew is SurfaceService's raider camp. When the first of a crew comes home, its objective is
	  done (ObjectiveService: +2 Years per Cycle); if all three are lost, so is the crew.
	* Radio logs (Section 12: radio logs give hints about where each crew is): from Find spots and
	  from loot (InventoryService's RadioLog special): the next log not yet heard this run; while a
	  crew is still lost, HintChance of the time a crew's log, ending with where that crew was last
	  heard from (Rules.Deep.Hint; the surface's from SurfaceService:CrewWhere). The RadioLog remote
	  shows it (DeepController).
	* Cryo pods (Sections 6 and 11): found in caves and in dug cells (DigService's CryoPod result,
	  Era II). Hauled home (unloaded at the hall or a Storage room) they wait (RunState CryoPods);
	  Cryo Bays thaw them with their Thawing output (EconomyService:Rate), ThawPoints a pod, into a
	  Rare or Legendary resident (LegendaryChance) who steps out in the Cryo Bay.
	* Drops and darkness (Section 12): a player in the Deep carries a light (DeepLight: LightRange
	  times LightRadius, the Spelunker's double); a fall past FallDamageFrom studs hurts
	  (NoFallDamage). The Deep's lighting is the client's (SurfaceController).

	API: Caves(): number, CaveAt(position): string?, Pods(): number, OpenNear(player, position, radius) (Prompt 20:
	Magnet Sweep); Prompt 18: DistressSpot(): (CFrame?, string?),
	CrewCall(): (logId?, where?) and PlayLog(player, logId, hint?) for the Radio Room.
	Signals: CaveOpened(cellKey, band, pieces), CrewHome(objectiveId, leader?), Thawed(residentId, tier),
	ChestOpened(player, glowshards).
	Dev: deep, deep.cave <floor> <column>, deep.find <kind>, deep.tp <floor> <column>, cryo.add [n],
	radiolog [id], crews.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Deep = require(Shared.Rules.Deep)
local Dig = require(Shared.Rules.Dig)
local Economy = require(Shared.Rules.Economy)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Loot = require(Shared.Rules.Loot)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local Surface = require(Shared.Rules.Surface)
local Threat = require(Shared.Rules.Threat)

local log = Log.new("DeepService")

local DeepService = {
	Name = "DeepService",
	Dependencies = {
		"BunkerGrid", "CycleClock", "RunDirector", "SessionService", "DigService", "InventoryService", "RescueService",
		"MonsterService", "CombatService", "ResidentService", "ResidentBrain", "EconomyService", "BuildService",
		"ObjectiveService", "BreachService", "ProfileService", "SurfaceService", "WeaponService", "DevService",
	},
	CaveOpened = Signal.new() :: Signal.Signal<string, string, number>,
	CrewHome = Signal.new() :: Signal.Signal<string, Player?>,
	Thawed = Signal.new() :: Signal.Signal<string, string>,
	ChestOpened = Signal.new() :: Signal.Signal<Player, number>,
}

local CAMERA_IGNORE_TAG = "CameraIgnore"
-- loot nothing hands out yet: gear (Prompt 26), blueprints (19), recruits (18), the Lamp (placeables)
local SKIP: { [string]: boolean } = { Recruit = true, Lamp = true } -- blueprints: Prompt 19 (DraftService); gear: Prompt 26
local LANTERN: { [string]: Color3 } = {
	Mines = Color3.fromRGB(255, 178, 104),
	FloodedCaverns = Color3.fromRGB(150, 232, 214),
	CrystalHollows = Color3.fromRGB(180, 255, 205),
	SourceChamber = Color3.fromRGB(150, 226, 172), -- the Source's own light, paler than its veins
}
-- The Source Chamber is a hall, not a tunnel: its lamps reach further and burn lower (the first
-- playtest's hall was one flat green: the rock's red and the Source's own glow have to read).
local CHAMBER_LAMP = { Range = 2.2, Brightness = 0.5 }
local OWN_LIGHT = Color3.fromRGB(255, 236, 206)
local PLUG_SCALE = 1.45 -- the doorway rubble (8 x 10) over a cave's 14 x 12 opening
local FIND_PROMPT: { [string]: { Action: string, Object: string, Hold: string } } = {
	OreVein = { Action = "MINE", Object = "Ore vein · Drill or Pickaxe", Hold = "MineSeconds" },
	Cache = { Action = "OPEN", Object = "Cache", Hold = "OpenSeconds" },
	RadioLog = { Action = "LISTEN", Object = "Radio log", Hold = "ListenSeconds" },
	GlowshardChest = { Action = "OPEN", Object = "Glowshard chest", Hold = "ChestSeconds" },
}

type Piece = {
	Index: number,
	Spec: any,
	CFrame: CFrame,
	Box: Deep.Box,
	Model: Model,
	Guards: number, -- the guards' budget (0: none)
	Posts: { CFrame },
	Woken: boolean,
}
type Cave = {
	Key: string,
	Floor: number,
	Column: number,
	Band: string,
	Folder: Model,
	Pieces: { Piece },
	Crew: string?, -- the Lost Crew's objective
}
type Find = {
	Id: string,
	Kind: string,
	Cave: string,
	Band: string,
	Model: Model,
	Prompt: ProximityPrompt,
	Left: { Loot.Drop }?,
	LogId: string?,
	Hint: string?,
}
type Nest = { Id: string, Cave: string, Model: Model }
type Crew = { Objective: string, Band: string, Floor: number, Column: number, State: string } -- Hidden, Found, Home, Lost

local grid: any = nil
local clock: any = nil
local director: any = nil
local session: any = nil
local dig: any = nil
local inventory: any = nil
local weapons: any = nil -- Landon (Prompt 17): ore veins need a Drill or a Pickaxe
local rescue: any = nil
local monsterService: any = nil
local combat: any = nil
local residents: any = nil
local brain: any = nil
local economy: any = nil
local builds: any = nil
local objectives: any = nil
local breaches: any = nil
local profiles: any = nil
local surface: any = nil
local set: (string, any) -> () = function() end

local caves: { [string]: Cave } = {}
local boxes: { Deep.Box } = {} -- every placed piece (the planner keeps clear of them)
local finds: { [string]: Find } = {}
local nests: { [string]: Nest } = {} -- combatant id -> nest
local nestHits: { [string]: string } = {} -- a nest's combatant id -> who hit it last
local crews: { [string]: Crew } = {} -- objective -> crew (the Deep's)
local crewCells: { [string]: string } = {} -- cell key -> objective
local crewSeen: { [string]: boolean } = {} -- crews whose members were ever out (lost when none are left)
local heard: { [string]: boolean } = {} -- radio logs played this run
local pods = 0
local thaw = 0
local counter = 0
local rng = Random.new()

-- Helpers -----------------------------------------------------------------------------------------

local function t(): { [string]: any }
	return Deep.Tuning()
end

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function alertAll(kind: string, text: string)
	for _, player in Players:GetPlayers() do
		alert(player, kind, text)
	end
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function alive(player: Player): boolean
	return player.Parent == Players and player:GetAttribute("Life") == "Alive"
end

local function eraNumber(): number
	return Threat.EraNumber(clock:Era())
end

-- A class modifier at the player's class level (Prompt 20).
local function classValue(player: Player?, key: string): number?
	return Modifiers.PlayerValue(player, key)
end

local function holder(): Folder
	local f = workspace:FindFirstChild("Deep")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Deep"
		f.Parent = workspace
	end
	return f :: Folder
end

local function art(category: string, name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild(category)
	local found = folder and folder:FindFirstChild(name)
	return if found and found:IsA("Model") then found else nil
end

-- A model's sockets matching a pattern ("^Find"), in the world, in name order.
local function sockets(model: Model, pattern: string): { CFrame }
	local list: { { Name: string, At: CFrame } } = {}
	for key, value in model:GetAttributes() do
		local name = string.match(key, "^Socket_(.+)$")
		if name and string.match(name, pattern) and typeof(value) == "CFrame" then
			table.insert(list, { Name = name, At = value })
		end
	end
	table.sort(list, function(a, b)
		return a.Name < b.Name
	end)
	local pivot = model:GetPivot()
	local out = {}
	for _, item in list do
		table.insert(out, pivot * item.At)
	end
	return out
end

local function anchorAll(model: Model)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end
end

local function nearestOnBox(box: Deep.Box, position: Vector3): Vector3
	return position:Max(box.Min):Min(box.Max)
end

local function lightAt(parent: Instance, at: CFrame, color: Color3, range: number, brightness: number)
	local part = Instance.new("Part")
	part.Name = "Lantern"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	part.CFrame = at
	part.Parent = parent
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false -- many lanterns: shadows only from players' own lights (phones, Section 26)
	light.Parent = part
	-- Prompt 24: a lamp shows a Prism Stalker ("Invisible until lit by a flare or lamp")
	part:SetAttribute("Radius", range)
	CollectionService:AddTag(part, "RevealLight")
end

local function bandName(band: string): string
	local entry = Config.Find("DepthBands", band)
	return if entry then entry.Name else band
end

-- Where a cave's monsters come out into the bunker (and walk back in): the dug cell in front.
local function mouthBreach(c: Cave, id: string): any
	local cell = Grid.CellPosition(c.Floor, c.Column)
	local out = Deep.MouthPoint(c.Floor, c.Column)
	return {
		Id = id,
		Kind = "Cave",
		RoomId = nil,
		Floor = c.Floor,
		Column = c.Column,
		Weight = 1,
		Dark = false,
		At = CFrame.lookAt(out, out + Vector3.new(0, 0, 1)),
		Source = cell + Vector3.new(0, 3, -13),
	}
end

-- Radio logs --------------------------------------------------------------------------------------

-- The crews still lost, and where each was last heard from.
local function lostCrews(): { { Objective: string, Where: string } }
	local list = {}
	for _, crew in crews do
		if crew.State == "Hidden" or crew.State == "Found" then
			local trapped = crew.State == "Hidden"
			for _, r in rescue:Tagged(crew.Objective) do
				if r.State == "Trapped" then
					trapped = true
				end
			end
			if trapped then
				table.insert(list, { Objective = crew.Objective, Where = Deep.Hint(crew.Floor, crew.Column) })
			end
		end
	end
	local up = surface:CrewWhere()
	if up then
		table.insert(list, { Objective = "CrewSurface", Where = up })
	end
	table.sort(list, function(a, b)
		return a.Objective < b.Objective
	end)
	return list
end

local function crewLog(objectiveId: string): string?
	for _, id in Config.Ids("RadioLogs") do
		if Config.Get("RadioLogs", id).Crew == objectiveId then
			return id
		end
	end
	return nil
end

-- The next log to play, and where its crew was last heard from (or nil). While a crew is still
-- lost, HintChance of the time it is that crew's own call; else the story goes on in order.
local function chooseLog(): (string?, string?)
	local era = eraNumber()
	local lost = {}
	for _, crew in lostCrews() do
		if crewLog(crew.Objective) then
			table.insert(lost, crew)
		end
	end
	if #lost > 0 and rng:NextNumber() < t().HintChance then
		local crew = lost[rng:NextInteger(1, #lost)]
		local id = crewLog(crew.Objective) :: string
		heard[id] = true
		return id, crew.Where
	end
	local story = {}
	for _, id in Config.Ids("RadioLogs") do
		local entry = Config.Get("RadioLogs", id)
		if (entry.MinEra or 1) <= era and not entry.Crew then
			table.insert(story, id)
		end
	end
	for _, id in story do
		if not heard[id] then
			heard[id] = true
			return id, nil
		end
	end
	if #lost > 0 then
		local crew = lost[rng:NextInteger(1, #lost)]
		return crewLog(crew.Objective), crew.Where
	end
	return story[rng:NextInteger(1, math.max(#story, 1))], nil -- every log heard: they repeat
end

local function playLog(player: Player, id: string, hint: string?)
	local entry = Config.Get("RadioLogs", id)
	Remotes.FireClient("RadioLog", player, entry.Title, entry.From, entry.Text, hint)
	log:Info("%s heard %s%s", player.Name, id, if hint then ` (hint: {hint})` else "")
end

-- Glowshard chests --------------------------------------------------------------------------------

-- A chest's Glowshards go to everyone in the run (a Bible Question), straight into their profiles.
local function payChest(opener: Player, shards: number): number
	if shards <= 0 then
		return 0
	end
	local paid = 0
	for _, player in session:ReadyPlayers() do
		local ok = profiles:Update(player, function(data: any)
			data.Glowshards += shards
		end)
		if ok then
			paid += 1
		end
	end
	alertAll("Info", `{string.upper(opener.DisplayName)} OPENED A GLOWSHARD CHEST: +{shards} GLOWSHARD{if shards == 1 then "" else "S"} FOR EVERYONE`)
	log:Info("%s opened a Glowshard chest: %d each to %d players", opener.Name, shards, paid)
	DeepService.ChestOpened:Fire(opener, shards)
	return shards
end

-- Finds -------------------------------------------------------------------------------------------

local function removeFind(f: Find)
	if finds[f.Id] ~= f then
		return
	end
	finds[f.Id] = nil
	f.Model:Destroy()
end

-- Loot into the player's pack; what doesn't fit stays in the find (TAKE THE REST).
local function takeLoot(f: Find, player: Player, tableId: string, verb: string)
	local drops = f.Left or Loot.Roll(tableId, rng, { BandOre = Config.Get("DepthBands", f.Band).Ore, Skip = SKIP })
	local given, left = inventory:Give(player, drops)
	if #left > 0 then
		f.Left = left
		f.Prompt.ActionText = "TAKE THE REST"
		alert(player, "Warning", `PACK FULL: {inventory:PackLine(player)} · THE REST STAYS`)
	else
		removeFind(f)
	end
	if #given > 0 then
		alert(player, "Info", `{verb}: {Loot.Text(given)} · {inventory:PackLine(player)}`)
	end
end

local function onFind(f: Find, player: Player)
	if finds[f.Id] ~= f or not alive(player) then
		return
	end
	if f.Kind == "OreVein" then
		-- Landon (Prompt 17): only with a digging tool, as digging needs
		if not (weapons:Carries(player, "Drill") or weapons:Carries(player, "Pickaxe")) then
			alert(player, "Warning", "YOU NEED A DRILL OR A PICKAXE TO MINE THE VEIN")
			return
		end
		takeLoot(f, player, "OreVein", "MINED")
	elseif f.Kind == "Cache" then
		takeLoot(f, player, "Cache", "THE CACHE")
	elseif f.Kind == "GlowshardChest" then
		local drops = Loot.Roll("GlowshardChest", rng, {})
		local shards = 0
		for _, drop in drops do
			if drop.Special == "Glowshards" then
				shards += drop.Count
			end
		end
		removeFind(f)
		payChest(player, math.max(shards, 1))
	elseif f.Kind == "RadioLog" then
		if not f.LogId then
			f.LogId, f.Hint = chooseLog()
			f.Prompt.ObjectText = "Radio log · heard"
		end
		local id = f.LogId
		if id then
			playLog(player, id, f.Hint)
		end
	end
end

local function findModel(kind: string, band: string): Model
	local source = if kind == "OreVein" then art("Props", `Prop_OreVein_{Config.Get("DepthBands", band).Ore or "Iron"}`)
		elseif kind == "Cache" then art("Props", "Prop_SupplyCrate")
		else art("Props", `Prop_{kind}`)
	if source then
		return source:Clone()
	end
	local model = Instance.new("Model")
	local box = Instance.new("Part")
	box.Name = "Body"
	box.Size = if kind == "OreVein" then Vector3.new(5, 3.5, 4) else Vector3.new(2.4, 2, 2)
	box.Color = if kind == "OreVein" then Color3.fromRGB(150, 92, 60) elseif kind == "GlowshardChest" then Color3.fromHex("#7CFF9B")
		else Color3.fromRGB(96, 102, 110)
	box.Material = Enum.Material.SmoothPlastic
	box.PivotOffset = CFrame.new(0, -box.Size.Y / 2, 0)
	box.Parent = model
	model.PrimaryPart = box
	return model
end

local function placeFind(c: Cave, kind: string, at: CFrame): string?
	if kind == "Nothing" then
		return nil
	elseif kind == "TrappedMiner" then
		local level = t().MinerLevel
		return rescue:Trap(at, {
			Kind = "Miner",
			Tier = if rng:NextNumber() < t().MinerRareChance then "Rare" else "Common",
			Level = rng:NextInteger(level.Min, level.Max),
			Where = `the {bandName(c.Band)}`,
			Tag = `Cave:{c.Key}`,
		})
	elseif kind == "CryoPod" then
		return DeepService:PlacePod(at, `Cave:{c.Key}`)
	end
	local spec = FIND_PROMPT[kind]
	if not spec then
		return nil
	end
	counter += 1
	local id = `D{counter}`
	local model = findModel(kind, c.Band)
	model.Name = `{kind}_{id}`
	model:SetAttribute("Find", kind)
	model:SetAttribute("FindId", id)
	anchorAll(model)
	model:PivotTo(at)
	model.Parent = c.Folder
	local _, size = model:GetBoundingBox()
	local spot = Instance.new("Part")
	spot.Name = "FindPrompt"
	spot.Anchored = true
	spot.CanCollide = false
	spot.CanQuery = false
	spot.CanTouch = false
	spot.Transparency = 1
	spot.Size = Vector3.new(1, 1, 1)
	spot.CFrame = CFrame.new(at.Position + Vector3.new(0, math.min(size.Y, 4) + 0.5, 0))
	spot.Parent = model
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = spec.Action
	prompt.ObjectText = spec.Object
	prompt.HoldDuration = t()[spec.Hold]
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Kind", kind)
	prompt.Parent = spot
	local f: Find = { Id = id, Kind = kind, Cave = c.Key, Band = c.Band, Model = model, Prompt = prompt, Left = nil, LogId = nil, Hint = nil }
	finds[id] = f
	prompt.Triggered:Connect(function(player: Player)
		onFind(f, player)
	end)
	return id
end

-- The team's best FindChance (the Spelunker's level 2): cryo pods and caches turn up more often.
local function teamFindChance(): number
	local best = 1
	for _, player in Players:GetPlayers() do
		best = math.max(best, classValue(player, "FindChance") or 1)
	end
	return best
end

-- Cryo pods -----------------------------------------------------------------------------------------

local function unlockCryo()
	if builds:Unlocked().CryoBay then
		return
	end
	builds:Unlock("CryoBay")
	alertAll("Info", "A CRYO POD! THE CRYO BAY IS UNLOCKED: HAUL THE POD HOME AND BUILD ONE TO THAW IT")
end

-- Puts a cryo pod (a big find) in the world; the Cryo Bay unlocks with the first (Section 6).
function DeepService:PlacePod(at: CFrame, tag: string?): string?
	local id = inventory:PlaceFind("CryoPod", at, tag)
	unlockCryo()
	return id
end

function DeepService:Pods(): number
	return pods
end

local function thawOne()
	local rooms = grid:RoomsOfType("CryoBay")
	local room = rooms[rng:NextInteger(1, math.max(#rooms, 1))]
	local tier = Deep.CryoTier(rng:NextNumber())
	local level = t().CryoLevel
	local id = residents:Add(tier, rng:NextInteger(level.Min, level.Max))
	local body = brain:Body(id)
	if body and room then
		body:PivotTo(Grid.CellCFrame(room.Floor, room.Column) * CFrame.new(0, 0, 2))
	end
	local record = residents:Get(id)
	local name = if record then Residents.Name(record) else id
	alertAll("Info", `{string.upper(name)} ({string.upper(tier)}) THAWS OUT IN THE CRYO BAY AND JOINS THE BUNKER`)
	log:Info("a cryo pod thawed: %s (%s)", id, tier)
	DeepService.Thawed:Fire(id, tier)
end

local function thawTick(dt: number)
	if pods <= 0 then
		thaw = 0
		return
	end
	local rate = 0
	for _, room in grid:RoomsOfType("CryoBay") do
		rate += economy:Rate(room.Id)
	end
	if rate <= 0 then
		return
	end
	thaw += rate * dt / Economy.CycleSeconds()
	if thaw >= t().ThawPoints then
		thaw -= t().ThawPoints
		pods -= 1
		set("CryoPods", pods)
		thawOne()
	end
end

-- Nests -------------------------------------------------------------------------------------------

local function placeNest(c: Cave, at: CFrame)
	local source = art("Props", "Prop_Nest")
	local model: Model
	if source then
		model = source:Clone()
	else
		model = Instance.new("Model")
		local p = Instance.new("Part")
		p.Name = "Graybox"
		p.Size = Vector3.new(7, 5, 6)
		p.Color = Color3.fromHex("#6E4766")
		p.PivotOffset = CFrame.new(0, -2.5, 0)
		p.Parent = model
		model.PrimaryPart = p
	end
	model.Name = `Nest_{c.Key}`
	model:SetAttribute("Find", "Nest")
	anchorAll(model)
	model:PivotTo(at)
	if not model.PrimaryPart then
		local best, volume = nil, 0
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") and part.Size.X * part.Size.Y * part.Size.Z > volume then
				best, volume = part, part.Size.X * part.Size.Y * part.Size.Z
			end
		end
		model.PrimaryPart = best
	end
	model.Parent = c.Folder
	local id = combat:Register(model, { Kind = "Monster", Team = "Monsters", Health = Dig.Tuning().NestHealth, MonsterType = "Nest" })
	if not id then
		model:Destroy()
		return
	end
	nests[id] = { Id = id, Cave = c.Key, Model = model }
	breaches:SetExtraPoint(`CN:{id}`, mouthBreach(c, `CN:{id}`))
end

local function destroyNest(n: Nest, killer: Player?)
	if nests[n.Id] ~= n then
		return
	end
	nests[n.Id] = nil
	nestHits[n.Id] = nil
	breaches:SetExtraPoint(`CN:{n.Id}`, nil)
	local c = caves[n.Cave]
	local band = if c then c.Band else "Mines"
	local drops = Loot.Roll("Nest", rng, { BandOre = Config.Get("DepthBands", band).Ore, Skip = SKIP })
	local text = "NOTHING"
	if killer and killer.Parent == Players then
		local given, left = inventory:Give(killer, drops)
		text = if #given > 0 then `{Loot.Text(given)} INTO {string.upper(killer.DisplayName)}'S PACK` else "THE PACK WAS FULL"
		if #left > 0 then
			alert(killer, "Warning", `PACK FULL: {inventory:PackLine(killer)}`)
		end
	else
		local given = {}
		for _, drop in drops do
			if drop.Resource then
				local added = economy:Add(drop.Resource, drop.Count, "cave nest")
				if added > 0 then
					table.insert(given, { Resource = drop.Resource, Count = added })
				end
			end
		end
		text = if #given > 0 then Loot.Text(given) else "NOTHING"
	end
	local drop = Dig.DisturbanceTuning().NestDestroyed
	dig:AddDisturbance(-drop, "NestDestroyed")
	alertAll("Info", `THE CAVE NEST IS DESTROYED: {text} · DISTURBANCE -{drop}`)
	log:Info("cave nest %s destroyed by %s", n.Id, if killer then killer.Name else "-")
end

-- Guards ------------------------------------------------------------------------------------------

local function usable(monsterType: string): boolean
	local spec = Config.Find("Monsters", monsterType)
	return spec ~= nil and art("Monsters", spec.Asset) ~= nil
end

local function spawnGuards(c: Cave, budget: number, posts: { CFrame })
	if budget <= 0 or #posts == 0 then
		return
	end
	local roster = Deep.Roster(c.Band, usable)
	if #roster == 0 then
		return
	end
	local n = 0
	for _, group in Threat.Groups(budget, roster, rng) do
		for _ = 1, group.Count do
			n += 1
			local post = posts[(n - 1) % #posts + 1]
			local jitter = Vector3.new(rng:NextNumber(-2.5, 2.5), 2, rng:NextNumber(-2.5, 2.5))
			monsterService:Spawn(group.Type, post + jitter, `Cave:{c.Key}`, { Guard = t().GuardRange })
		end
	end
	log:Info("%d guards came out in the cave at %s", n, c.Key)
end

local function wakeTick()
	local positions: { Vector3 } = {}
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root and alive(player) and Surface.Zone(root.Position) ~= "Surface" then
			table.insert(positions, root.Position)
		end
	end
	if #positions == 0 then
		return
	end
	local range = t().WakeRange
	for _, c in caves do
		for _, piece in c.Pieces do
			if not piece.Woken and piece.Guards > 0 then
				for _, at in positions do
					if (nearestOnBox(piece.Box, at) - at).Magnitude <= range then
						piece.Woken = true
						spawnGuards(c, piece.Guards, piece.Posts)
						break
					end
				end
			end
		end
	end
end

-- Lost Crews --------------------------------------------------------------------------------------

local function trapCrew(c: Cave, crew: Crew, piece: Piece?)
	local spots: { CFrame } = if piece then sockets(piece.Model, "^Crew") else {}
	if #spots == 0 then
		-- no room met the crew's pocket: they're in the cave's last piece
		local last = c.Pieces[#c.Pieces]
		local at = if last then last.CFrame * CFrame.new(0, 0, -10)
			else Deep.MouthCFrame(c.Floor, c.Column) * CFrame.new(0, 0, 4) * CFrame.Angles(0, math.pi, 0) -- in the dug cell
		spots = { at * CFrame.new(-3, 0, 0), at, at * CFrame.new(3, 0, 0) }
	end
	local level = t().CrewLevel
	local rare = rng:NextInteger(1, 3)
	for i = 1, 3 do
		rescue:Trap(spots[(i - 1) % #spots + 1], { -- the pocket's Crew sockets face its way in
			Kind = "Crew",
			Tier = if i == rare then "Rare" else "Common",
			Level = rng:NextInteger(level.Min, level.Max),
			Where = `the {bandName(crew.Band)}`,
			Tag = crew.Objective,
		})
	end
	crew.State = "Found"
	crewSeen[crew.Objective] = true
	alertAll("Info", `A LOST CREW! THE {string.upper(bandName(crew.Band))} CREW IS TRAPPED IN THIS CAVE, GUARDED BY A NEST`)
end

local function setupCrews()
	local seed = RunState.Get("DigSeed")
	local bunker = grid:Bunker()
	for _, objective in Config.All("Objectives") do
		local band = objective.Where
		if objective.Kind == "LostCrew" and t().CrewFloors[band] and #Deep.Pieces(band, "CrewPocket") > 0 then
			local floor, column = Deep.CrewCell(if type(seed) == "number" then seed else 1, band, function(f: number, col: number): boolean
				return bunker:IsOpen(f, col)
			end)
			if floor and column then
				crews[objective.Id] = { Objective = objective.Id, Band = band, Floor = floor, Column = column, State = "Hidden" }
				crewCells[Grid.Key(floor, column)] = objective.Id
				dig:SetRoll(floor, column, "CaveOpening")
				log:Info("%s is behind %s", objective.Id, Grid.Key(floor, column))
			end
		end
	end
	if #rescue:Tagged("CrewSurface") > 0 then
		crewSeen.CrewSurface = true
	end
end

-- The Source Chamber (Prompt 25; Section 6: floor 10 is the Source Chamber). Whichever floor 10 cell
-- the team digs first opens on it: every one of them rolls a cave opening until the chamber stands
-- (a cell whose rock is already another cave's stays a dark mouth, and the next cell tries again).
local chamberKey: string? = nil

local function setupChamber()
	local floor = Grid.Tuning().FloorMax
	if Deep.Band(floor) ~= "SourceChamber" or #Deep.Pieces("SourceChamber", "Entry") == 0 then
		return
	end
	for column = Grid.Tuning().ColumnMin, Grid.Tuning().ColumnMax do
		if not crewCells[Grid.Key(floor, column)] then
			dig:SetRoll(floor, column, "CaveOpening")
		end
	end
end

local function chamberOpened(key: string)
	chamberKey = key
	local floor = Grid.Tuning().FloorMax
	for column = Grid.Tuning().ColumnMin, Grid.Tuning().ColumnMax do
		local other = Grid.Key(floor, column)
		if other ~= key and not crewCells[other] then
			dig:SetRoll(floor, column, nil) -- the rest of floor 10 is plain rock again
		end
	end
end

-- The Source Chamber once it is open: where the Source sits and where its tendrils can rise.
function DeepService:SourceChamber(): { Key: string, Model: Model, Core: CFrame, Tendrils: { CFrame } }?
	local c = if chamberKey then caves[chamberKey] else nil
	local piece = if c then c.Pieces[1] else nil
	if not c or not piece then
		return nil
	end
	local core = sockets(piece.Model, "^Core$")[1]
	if not core then
		return nil
	end
	return { Key = c.Key, Model = piece.Model, Core = core, Tendrils = sockets(piece.Model, "^Tendril") }
end

-- The Source is dead in its chamber: its light goes out of the rock over `seconds`.
function DeepService:DimChamber(seconds: number)
	local chamber = DeepService:SourceChamber()
	if not chamber then
		return
	end
	local info = TweenInfo.new(seconds, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
	for _, d in chamber.Model:GetDescendants() do
		if d:IsA("PointLight") then
			TweenService:Create(d, info, { Brightness = d.Brightness * 0.12, Color = Color3.fromRGB(196, 120, 96) }):Play()
		elseif d:IsA("BasePart") and d.Material == Enum.Material.Neon and d.Name ~= "Lantern" then
			TweenService:Create(d, info, { Color = Color3.fromRGB(38, 58, 46) }):Play()
		end
	end
end

local function crewArrived(r: any, leader: Player?, _residentId: string)
	local objectiveId = r.Tag
	local objective = if type(objectiveId) == "string" then Config.Find("Objectives", objectiveId) else nil
	if not objective or objective.Kind ~= "LostCrew" then
		return
	end
	local crew = crews[objective.Id]
	if crew then
		crew.State = "Home"
	end
	if objectives:Complete(objective.Id) then
		alertAll("Info", `{string.upper(objective.Name)}: HOME! +{objective.YearsPerCycle} YEARS PER CYCLE`)
		DeepService.CrewHome:Fire(objective.Id, leader)
	end
end

local function crewMemberLost(_rescueId: string, kind: string)
	if kind ~= "Crew" then
		return
	end
	for objectiveId in crewSeen do
		if not objectives:IsComplete(objectiveId) and #rescue:Tagged(objectiveId) == 0 then
			crewSeen[objectiveId] = nil
			local crew = crews[objectiveId]
			if crew then
				crew.State = "Lost"
			end
			local objective = Config.Get("Objectives", objectiveId)
			alertAll("Danger", `{string.upper(objective.Name)}: ALL OF THEM ARE LOST`)
		end
	end
end

-- Caves -------------------------------------------------------------------------------------------

-- The dug cell's back rock steps aside for the cave's mouth (the Entry's rock face stands there);
-- anything else in the opening stops colliding (the Mines' timber frame).
local function openMouth(c: Cave)
	local root = grid:Root()
	local dug = root and root:FindFirstChild("Dug")
	local model = dug and dug:FindFirstChild(`D:{c.Key}`)
	if not model or model:GetAttribute("CaveOpen") then
		return
	end
	model:SetAttribute("CaveOpen", true)
	local mouth = Deep.MouthCFrame(c.Floor, c.Column).Position
	local lo = Vector3.new(mouth.X - 7.5, mouth.Y + 0.5, mouth.Z - 1)
	local hi = Vector3.new(mouth.X + 7.5, mouth.Y + 12, mouth.Z + 4)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.Name ~= "Floor" and part.Name ~= "FrontWall" then
			if part.Name == "BackRock" then
				part.Transparency = 1
				part.CanCollide = false
				part.CanQuery = false
				part.CastShadow = false
				CollectionService:AddTag(part, CAMERA_IGNORE_TAG)
			elseif part.CanCollide then
				local half = part.Size / 2
				local cf = part.CFrame
				local extent = Vector3.new(
					math.abs(cf.RightVector.X) * half.X + math.abs(cf.UpVector.X) * half.Y + math.abs(cf.LookVector.X) * half.Z,
					math.abs(cf.RightVector.Y) * half.X + math.abs(cf.UpVector.Y) * half.Y + math.abs(cf.LookVector.Y) * half.Z,
					math.abs(cf.RightVector.Z) * half.X + math.abs(cf.UpVector.Z) * half.Y + math.abs(cf.LookVector.Z) * half.Z
				)
				local pMin, pMax = cf.Position - extent, cf.Position + extent
				if pMin.X < hi.X and pMax.X > lo.X and pMin.Y < hi.Y and pMax.Y > lo.Y and pMin.Z < hi.Z and pMax.Z > lo.Z then
					part.CanCollide = false
				end
			end
		end
	end
end

local function grayPiece(spec: any): Model
	local model = Instance.new("Model")
	local lo, hi = spec.Box.Min, spec.Box.Max
	local floor = Instance.new("Part")
	floor.Name = "Floor"
	floor.Size = Vector3.new(hi[1] - lo[1], 1, hi[3] - lo[3])
	floor.CFrame = CFrame.new((lo[1] + hi[1]) / 2, -0.5, (lo[3] + hi[3]) / 2)
	floor.Color = Color3.fromRGB(70, 64, 60)
	floor.Material = Enum.Material.Slate
	floor.Parent = model
	model.PrimaryPart = floor
	model.WorldPivot = CFrame.new()
	return model
end

local function plug(c: Cave, at: CFrame)
	local source = art("Kit", "Kit_Rubble_Doorway")
	local model: Model
	if source then
		model = source:Clone()
		model:ScaleTo(PLUG_SCALE)
	else
		model = Instance.new("Model")
		local p = Instance.new("Part")
		p.Name = "Rubble"
		p.Size = Vector3.new(14, 12, 3)
		p.Color = Color3.fromRGB(96, 88, 80)
		p.Material = Enum.Material.Slate
		p.PivotOffset = CFrame.new(0, -6, 0)
		p.Parent = model
		model.PrimaryPart = p
	end
	model.Name = "Plug"
	anchorAll(model)
	model:PivotTo(at)
	model.Parent = c.Folder
	local block = Instance.new("Part")
	block.Name = "PlugBlock"
	block.Anchored = true
	block.CanQuery = false
	block.CanTouch = false
	block.Transparency = 1
	block.Size = Vector3.new(15, 13, 2)
	block.CFrame = at * CFrame.new(0, 6.5, 0)
	CollectionService:AddTag(block, CAMERA_IGNORE_TAG)
	block.Parent = model
end

local function placePiece(c: Cave, placement: Deep.Placement, index: number, findChance: number): Piece
	local spec = Config.Get("CavePieces", placement.Piece)
	local source = art("Caves", spec.Asset)
	local model = if source then source:Clone() else grayPiece(spec)
	model.Name = `{index} {spec.Id}`
	model:SetAttribute("Piece", spec.Id)
	anchorAll(model)
	model:PivotTo(placement.CFrame)
	model.Parent = c.Folder
	local piece: Piece = {
		Index = index,
		Spec = spec,
		CFrame = placement.CFrame,
		Box = placement.Box,
		Model = model,
		Guards = 0,
		Posts = sockets(model, "^Spawn"),
		Woken = false,
	}
	if c.Band == "SourceChamber" then
		-- the miners' own lantern in the gallery, then the chamber's glow
		for _, at in sockets(model, "^Light1$") do
			lightAt(model, at, LANTERN.Mines, t().LampRange, t().LampBrightness)
		end
		for _, at in sockets(model, "^Light[2-9]$") do
			lightAt(model, at, LANTERN.SourceChamber, t().LampRange * CHAMBER_LAMP.Range, t().LampBrightness * CHAMBER_LAMP.Brightness)
		end
	else
		for _, at in sockets(model, "^Light") do
			lightAt(model, at, LANTERN[c.Band] or LANTERN.Mines, t().LampRange, t().LampBrightness)
		end
	end
	local era = eraNumber()
	for _, at in sockets(model, "^Find") do
		placeFind(c, Deep.RollFind(rng:NextNumber(), era, findChance), at)
	end
	local nestAt = sockets(model, "^Nest$")[1]
	if spec.Kind == "CrewPocket" and nestAt then
		-- the crew's guard (Section 12): a nest, and its monsters round it
		placeNest(c, nestAt)
		piece.Guards = t().NestBudget
		piece.Posts = { nestAt * CFrame.new(-5, 0, 2), nestAt * CFrame.new(5, 0, 2), nestAt * CFrame.new(0, 0, 5) }
	elseif nestAt then
		if rng:NextNumber() < t().NestChance then
			placeNest(c, nestAt)
			piece.Guards = t().NestBudget
			if #piece.Posts == 0 then
				piece.Posts = { nestAt * CFrame.new(-5, 0, 3), nestAt * CFrame.new(5, 0, 3) }
			end
		else
			placeFind(c, "Cache", nestAt)
		end
	end
	if piece.Guards == 0 and #piece.Posts > 0 and rng:NextNumber() < t().GuardChance then
		piece.Guards = t().GuardBudget
	end
	return piece
end

function DeepService:Caves(): number
	local n = 0
	for _ in caves do
		n += 1
	end
	return n
end

-- The cave (its dug cell's key) a position is in, if any.
--[[
	Where a Deep expedition radioing for help is cut off (Prompt 18), and how to say where: a piece of
	an open cave (not its mouth, a drop or a crew's pocket), on its floor; with no cave open, at the
	rock face of the bunker's deepest floor.
]]
function DeepService:DistressSpot(): (CFrame?, string?)
	local options = {}
	for _, c in caves do
		for _, piece in c.Pieces do
			local kind = piece.Spec.Kind
			if kind ~= "Entry" and kind ~= "Drop" and kind ~= "CrewPocket" then
				table.insert(options, { Cave = c, Piece = piece })
			end
		end
	end
	if #options > 0 then
		local pick = options[rng:NextInteger(1, #options)]
		local box = pick.Piece.Spec.Box
		local at = pick.Piece.CFrame * CFrame.new(0, 0, (box.Min[3] + box.Max[3]) / 2)
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { pick.Cave.Folder }
		local hit = workspace:Raycast(at.Position + Vector3.new(0, 8, 0), Vector3.new(0, -20, 0), params)
		if hit then
			at = CFrame.new(hit.Position) * at.Rotation
		end
		return at, `a cave off {Deep.Hint(pick.Cave.Floor, pick.Cave.Column)}`
	end
	-- no cave open: the outermost dug cell of the deepest floor, against the rock
	local floor = grid:DeepestFloor()
	local t = Grid.Tuning()
	for column = math.max(math.abs(t.ColumnMin), t.ColumnMax), 0, -1 do
		for _, c in (if column == 0 then { 0 } else { -column, column }) do
			if Grid.OnGrid(floor, c) and grid:State(floor, c) ~= "Rock" then
				local at = Grid.CellPosition(floor, c) + Vector3.new(0, 0, -t.CellDepth / 2 + 4)
				return CFrame.new(at), `the rock face at {Deep.Hint(floor, c)}`
			end
		end
	end
	return nil, nil
end

-- A Lost Crew's own call and where they were last heard from, for the Radio Room (Prompt 18), or nil when none is out.
function DeepService:CrewCall(): (string?, string?)
	local lost = {}
	for _, crew in lostCrews() do
		if crewLog(crew.Objective) then
			table.insert(lost, crew)
		end
	end
	if #lost == 0 then
		return nil, nil
	end
	local crew = lost[rng:NextInteger(1, #lost)]
	local id = crewLog(crew.Objective) :: string
	heard[id] = true
	return id, crew.Where
end

-- Plays a radio log (Config.RadioLogs) for a player, with a hint.
function DeepService:PlayLog(player: Player, id: string, hint: string?)
	playLog(player, id, hint)
end

-- Magnet Sweep (Prompt 20): the caches within `radius` of `position` open into the player's pack.
function DeepService:OpenNear(player: Player, position: Vector3, radius: number): number
	local n = 0
	for _, f in table.clone(finds) do
		if f.Kind == "Cache" and (f.Model:GetPivot().Position - position).Magnitude <= radius then
			onFind(f, player)
			n += 1
		end
	end
	return n
end

function DeepService:CaveAt(position: Vector3): string?
	for key, c in caves do
		for _, piece in c.Pieces do
			if Deep.Inside(piece.Box, position) then
				return key
			end
		end
	end
	return nil
end

local function buildCave(floor: number, column: number)
	local key = Grid.Key(floor, column)
	if caves[key] then
		return
	end
	local band = Deep.Band(floor)
	if #Deep.Pieces(band, "Entry") == 0 then
		log:Info("no cave pieces for the %s yet: the cave at %s stays a dark mouth", band, key)
		return
	end
	local objectiveId = crewCells[key]
	local crew = if objectiveId then crews[objectiveId] else nil
	if crew and crew.State ~= "Hidden" then
		crew = nil
	end
	local plan = Deep.Plan(band, Deep.MouthCFrame(floor, column), rng, boxes, { Crew = crew ~= nil })
	if #plan.Pieces == 0 then
		-- another cave already fills the rock behind: the mouth stays a dark hole (still a breach point)
		log:Info("the rock behind %s is another cave's: no cave of its own", key)
		if crew then
			-- the crew can't be lost to that: they're in the dug cell, against the back wall
			local fake: Cave = { Key = key, Floor = floor, Column = column, Band = band, Folder = holder() :: any, Pieces = {}, Crew = objectiveId }
			trapCrew(fake, crew, nil)
		end
		return
	end
	local folder = Instance.new("Model")
	folder.Name = `Cave {key}`
	folder:SetAttribute("Cell", key)
	folder:SetAttribute("Band", band)
	folder.Parent = holder()
	local c: Cave = { Key = key, Floor = floor, Column = column, Band = band, Folder = folder, Pieces = {}, Crew = objectiveId }
	caves[key] = c
	local findChance = teamFindChance()
	local pocket: Piece? = nil
	for i, placement in plan.Pieces do
		local piece = placePiece(c, placement, i, findChance)
		table.insert(c.Pieces, piece)
		if piece.Spec.Kind == "CrewPocket" then
			pocket = piece
		end
	end
	for _, at in plan.Plugs do
		plug(c, at)
	end
	openMouth(c)
	dig:OpenCave(floor, column)
	if crew then
		trapCrew(c, crew, pocket)
		local last = c.Pieces[#c.Pieces]
		if not pocket and last then
			-- no room for their pocket: they're at the end of the cave, still guarded (Section 12)
			local nestAt = last.CFrame * CFrame.new(0, 0, -6)
			placeNest(c, nestAt)
			last.Guards = t().NestBudget
			last.Posts = { nestAt * CFrame.new(-5, 0, 2), nestAt * CFrame.new(5, 0, 2) }
			last.Woken = false
		end
	end
	set("Caves", DeepService:Caves())
	log:Info("a cave opened at %s (%s): %d pieces, %d plugs%s", key, band, #c.Pieces, #plan.Plugs, if crew then ", the Lost Crew" else "")
	if band == "SourceChamber" then
		chamberOpened(key)
	end
	DeepService.CaveOpened:Fire(key, band, #c.Pieces)
end

-- Where a cave position comes out into the bunker (MonsterService walks monsters through it).
local function caveExit(position: Vector3): Vector3?
	local key = DeepService:CaveAt(position)
	local c = if key then caves[key] else nil
	if not c then
		-- between pieces or just outside one: the nearest cave's mouth
		local best, bestDistance = nil, math.huge
		for _, other in caves do
			for _, piece in other.Pieces do
				local d = (nearestOnBox(piece.Box, position) - position).Magnitude
				if d < bestDistance then
					best, bestDistance = other, d
				end
			end
		end
		c = best
	end
	return if c then Deep.MouthPoint(c.Floor, c.Column) else nil
end

-- Players in the Deep: their own light, and falls ------------------------------------------------

local function lightTick()
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root then
			local light = root:FindFirstChild("DeepLight")
			local inDeep = Surface.Zone(root.Position) == "Deep"
			if inDeep and not light then
				local l = Instance.new("PointLight")
				l.Name = "DeepLight"
				l.Color = OWN_LIGHT
				l.Shadows = true
				l.Parent = root
				light = l
			end
			if light and light:IsA("PointLight") then
				light.Enabled = inDeep
				light.Range = Deep.LightRange(classValue(player, "LightRadius"))
				light.Brightness = t().LightBrightness
			end
		end
	end
end

-- Falls (Section 12: drops): the server watches characters fall (a Humanoid's states are its
-- client's, so it reads the root's speed) and land; a drop in the Deep past FallDamageFrom hurts.
local FALLING = -8 -- studs a second down: falling, not walking down a slope
local falls: { [Player]: { Top: number, At: Vector3 } } = {}

local function fallStep()
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		local f = falls[player]
		if not root then
			falls[player] = nil
		else
			local vy = root.AssemblyLinearVelocity.Y
			if vy < FALLING then
				if not f then
					falls[player] = { Top = root.Position.Y, At = root.Position }
				end
			elseif f and math.abs(vy) < 2 then
				falls[player] = nil
				local drop = f.Top - root.Position.Y
				local flat = Vector3.new(root.Position.X - f.At.X, 0, root.Position.Z - f.At.Z).Magnitude
				-- only in the Deep, and not a teleport (DevTools, a respawn)
				if drop > 0 and drop < 120 and flat < 80 and Surface.Zone(root.Position) == "Deep" then
					local damage = Deep.FallDamage(drop, (classValue(player, "NoFallDamage") or 0) ~= 0)
					local c = combat:PlayerCombatant(player)
					if damage > 0 and c and alive(player) then
						local done = combat:Damage(c.Id, damage, nil, "fell")
						log:Info("%s fell %.1f studs in the Deep: %d damage", player.Name, drop, done)
					end
				end
			end
		end
	end
end

-- Loop --------------------------------------------------------------------------------------------

-- Section 12's "radiation in the Crystal Hollows" (Prompt 24): who stands in a cave of a band that
-- has it carries CaveRadiation (a rate per second); SurfaceService's radiation tick adds it, and the
-- client hazes the picture.
local function radiationTick()
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		local rate = 0
		if root and Surface.Zone(root.Position) == "Deep" then
			local key = DeepService:CaveAt(root.Position)
			local c = if key then caves[key] else nil
			rate = if c then Deep.CaveRadiation(c.Band) else 0
		end
		local had = player:GetAttribute("CaveRadiation")
		if rate > 0 then
			if had ~= rate then
				player:SetAttribute("CaveRadiation", rate)
				if not had then
					alert(player, "Warning", "THE CRYSTAL GLOWS HOT: YOUR RADIATION CLIMBS IN THESE CAVES")
				end
			end
		elseif had ~= nil then
			player:SetAttribute("CaveRadiation", nil)
		end
	end
end

local function loop()
	local last = os.clock()
	while true do
		task.wait(1)
		local dt = math.min(os.clock() - last, 3)
		last = os.clock()
		for name, fn in { wake = wakeTick, light = lightTick, radiation = radiationTick, thaw = function()
			-- the Cryo Bay works like any room: while the clock runs, at its speed (EconomyService)
			if clock:IsRunning() then
				thawTick(dt * clock:TimeScale())
			end
		end } do
			local ok, err = pcall(fn)
			if not ok then
				log:Warn("%s: %s", name, tostring(err))
			end
		end
	end
end

local function onGridChanged()
	for _, c in caves do
		openMouth(c) -- a rebuilt dug cell brings its back rock back
	end
end

local function clear()
	for _, n in nests do
		breaches:SetExtraPoint(`CN:{n.Id}`, nil)
	end
	table.clear(nests)
end

-- DevTools ----------------------------------------------------------------------------------------

local function describe(): string
	local lines = { `{DeepService:Caves()} caves, {#boxes} pieces in the Deep, cryo pods waiting {pods} (thaw {string.format("%.2f", thaw)}/{t().ThawPoints})` }
	for key, c in caves do
		local kinds = {}
		for _, piece in c.Pieces do
			table.insert(kinds, `{piece.Spec.Kind}{if piece.Guards > 0 then (if piece.Woken then "*" else "+") else ""}`)
		end
		table.insert(lines, `cave {key} ({c.Band}): {table.concat(kinds, " ")}{if c.Crew then ` · {c.Crew}` else ""}`)
	end
	local counts: { [string]: number } = {}
	for _, f in finds do
		counts[f.Kind] = (counts[f.Kind] or 0) + 1
	end
	local parts = {}
	for kind, n in counts do
		table.insert(parts, `{kind} {n}`)
	end
	table.sort(parts)
	local nestCount = 0
	for _ in nests do
		nestCount += 1
	end
	table.insert(lines, `finds: {if #parts > 0 then table.concat(parts, ", ") else "none"} · cave nests {nestCount}`)
	return table.concat(lines, "\n")
end

local function describeCrews(): string
	local lines = {}
	for _, objective in Config.All("Objectives") do
		if objective.Kind == "LostCrew" then
			local crew = crews[objective.Id]
			local members = rescue:Tagged(objective.Id)
			local states = {}
			for _, r in members do
				table.insert(states, r.State)
			end
			local where = if crew then `{Grid.Key(crew.Floor, crew.Column)} ({Deep.Hint(crew.Floor, crew.Column)}), {crew.State}`
				elseif objective.Id == "CrewSurface" then (surface:CrewWhere() or "the camp's crew is out")
				else "not placed (its band has no cave pieces yet)"
			table.insert(lines, `{if objectives:IsComplete(objective.Id) then "done" else "    "} {objective.Id}: {where}{if #states > 0 then ` · {table.concat(states, ", ")}` else ""}`)
		end
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("deep", {
		Description = "The Deep: caves (pieces, + guards asleep, * woken), finds, cave nests, cryo pods (Prompt 17).",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("deep.cave", {
		Description = "Dig a rock cell now and break into a cave behind it (or build the cave behind a dug cave opening).",
		Usage = "deep.cave <floor> <column>",
		Run = function(player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: deep.cave <floor> <column>"
			end
			if grid:State(floor, column) == "Rock" then
				if not crewCells[Grid.Key(floor, column)] then
					dig:SetRoll(floor, column, "CaveOpening")
				end
				local ok, why = dig:DigNow(floor, column, "DevTools", player)
				if not ok then
					return `can't dig: {why}`
				end
			else
				buildCave(floor, column)
			end
			return describe()
		end,
	})
	dev:Register("deep.tp", {
		Description = "Go into the cave behind a cell (to its first piece's end).",
		Usage = "deep.tp <floor> <column> [piece]",
		Run = function(player, args): string?
			local c = caves[Grid.Key(tonumber(args[1]) or 0, tonumber(args[2]) or 0)]
			local p = player or Players:GetPlayers()[1]
			local root = if p then rootOf(p) else nil
			if not c or not root then
				return "usage: deep.tp <floor> <column> [piece] (a cave that is open)"
			end
			local piece = c.Pieces[math.clamp(tonumber(args[3]) or 1, 1, #c.Pieces)]
			local at = piece.CFrame * CFrame.new(0, 3, -8)
			root.CFrame = CFrame.lookAt(at.Position, (at * CFrame.new(0, 0, -5)).Position)
			return `in {piece.Spec.Id} of the cave at {c.Key}`
		end,
	})
	dev:Register("deep.find", {
		Description = "Put a find in front of you: OreVein, Cache, RadioLog, GlowshardChest, TrappedMiner, CryoPod.",
		Usage = "deep.find <kind>",
		Run = function(player, args): string?
			local p = player or Players:GetPlayers()[1]
			local root = if p then rootOf(p) else nil
			local kind = tostring(args[1] or "")
			if not root or not (FIND_PROMPT[kind] or kind == "TrappedMiner" or kind == "CryoPod") then
				return "usage: deep.find <OreVein|Cache|RadioLog|GlowshardChest|TrappedMiner|CryoPod>"
			end
			local key = DeepService:CaveAt(root.Position)
			local c = if key then caves[key] else nil
			local fake: Cave = c or { Key = "dev", Floor = 1, Column = 0, Band = "Mines", Folder = holder() :: any, Pieces = {}, Crew = nil }
			local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit
			local at = CFrame.lookAt(root.Position + look * 6 - Vector3.new(0, 3, 0), root.Position - Vector3.new(0, 3, 0))
			local id = placeFind(fake, kind, at)
			return `{kind}: {id or "nothing"}`
		end,
	})
	dev:Register("cryo.add", {
		Description = "Cryo pods home and waiting to thaw, as if hauled (the Cryo Bay unlocks).",
		Usage = "cryo.add [n]",
		Run = function(_player, args): string?
			local n = math.max(math.floor(tonumber(args[1]) or 1), 0)
			pods += n
			set("CryoPods", pods)
			unlockCryo()
			return describe()
		end,
	})
	dev:Register("radiolog", {
		Description = "Play a radio log to you (the next one, or by id).",
		Usage = "radiolog [id]",
		Run = function(player, args): string?
			local p = player or Players:GetPlayers()[1]
			if not p then
				return "no player"
			end
			local id, hint = tostring(args[1] or ""), nil
			if not Config.Find("RadioLogs", id) then
				local chosen, h = chooseLog()
				id, hint = chosen or "", h
			else
				local objective = Config.Get("RadioLogs", id).Crew
				for _, crew in lostCrews() do
					if crew.Objective == objective then
						hint = crew.Where
					end
				end
			end
			if id == "" then
				return "no radio logs"
			end
			playLog(p, id, hint)
			return `{id}{if hint then ` · {hint}` else ""}`
		end,
	})
	dev:Register("crews", {
		Description = "The Lost Crews: where each is, and how they are.",
		Run = function(): string?
			return describeCrews()
		end,
	})
end

-- Lifecycle ---------------------------------------------------------------------------------------

function DeepService:Init(registry)
	grid = registry.BunkerGrid
	clock = registry.CycleClock
	director = registry.RunDirector
	session = registry.SessionService
	dig = registry.DigService
	inventory = registry.InventoryService
	weapons = registry.WeaponService
	rescue = registry.RescueService
	monsterService = registry.MonsterService
	combat = registry.CombatService
	residents = registry.ResidentService
	brain = registry.ResidentBrain
	economy = registry.EconomyService
	builds = registry.BuildService
	objectives = registry.ObjectiveService
	breaches = registry.BreachService
	profiles = registry.ProfileService
	surface = registry.SurfaceService
	set = RunState.Writer("DeepService")
	registerCommands(registry.DevService)
end

function DeepService:Start()
	set("Caves", 0)
	set("CryoPods", 0)
	holder()
	dig.FeatureAdded:Connect(function(kind: string, floor: number, column: number)
		if kind == "CaveOpening" and caves[Grid.Key(floor, column)] then
			dig:OpenCave(floor, column) -- DevTools put the opening back: the cave is already there
		elseif kind == "CaveOpening" then
			local ok, err = pcall(buildCave, floor, column)
			if not ok then
				log:Error("the cave at %s: %s", Grid.Key(floor, column), tostring(err))
			end
		end
	end)
	dig:SetResultHandler("CryoPod", function(floor: number, column: number, _finisher: Player?): string
		DeepService:PlacePod(Grid.CellCFrame(floor, column) * CFrame.new(-5, 0, 4) * CFrame.Angles(0, math.rad(15), 0), "Dug")
		return "A CRYO POD! CARRY IT HOME TO THE HALL OR A STORAGE ROOM"
	end)
	inventory:SetDelivery("CryoPod", function(player: Player, _kind: string): { Loot.Drop }
		pods += 1
		set("CryoPods", pods)
		local bays = #grid:RoomsOfType("CryoBay")
		alertAll("Info", `{string.upper(player.DisplayName)} BROUGHT A CRYO POD HOME ({pods} WAITING): `
			.. (if bays > 0 then "THE CRYO BAY WILL THAW IT" else "BUILD A CRYO BAY TO THAW IT"))
		return {}
	end)
	inventory:SetSpecial("RadioLog", function(player: Player, count: number): number
		local id, hint = chooseLog()
		if id then
			playLog(player, id, hint)
		end
		return if id then count else 0
	end)
	inventory:SetSpecial("Glowshards", function(player: Player, count: number): number
		return payChest(player, count)
	end)
	rescue:SetArrival("Crew", crewArrived)
	rescue.Lost:Connect(crewMemberLost)
	monsterService:SetCaveExit(caveExit)
	combat.Damaged:Connect(function(id: string, _amount: number, source: string?)
		if source and nests[id] then
			nestHits[id] = source
		end
	end)
	combat.Died:Connect(function(id: string)
		local n = nests[id]
		if not n then
			return
		end
		local killer: Player? = nil
		local source = nestHits[id]
		for _, player in Players:GetPlayers() do
			if `P{player.UserId}` == source then
				killer = player
			end
		end
		destroyNest(n, killer)
	end)
	clock.CycleStarted:Connect(function(cycle: number)
		local n = 0
		for _ in nests do
			n += 1
		end
		if cycle > 1 and n > 0 then
			dig:AddDisturbance(n * Dig.Tuning().NestPerCycle, "CaveNests")
		end
	end)
	grid.Changed:Connect(onGridChanged)
	RunService.Heartbeat:Connect(function()
		local ok, err = pcall(fallStep)
		if not ok then
			log:Warn("falls: %s", tostring(err))
		end
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		falls[player] = nil
	end)
	director.RunEnded:Connect(clear)
	local ok, err = pcall(setupCrews)
	if not ok then
		log:Error("the Lost Crews: %s", tostring(err))
	end
	ok, err = pcall(setupChamber)
	if not ok then
		log:Error("the Source Chamber: %s", tostring(err))
	end
	task.spawn(loop)
	local placed = 0
	for _ in crews do
		placed += 1
	end
	log:Info("the Deep ready: %d cave pieces, %d Lost Crews hidden in the rock", #Config.Ids("CavePieces"), placed)
end

return DeepService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000FE"><Properties><string name="Name">DevService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DevService: DevTools commands (bible Section 23: test commands gated to Studio and
	admins).

	Services register their own commands in Init:

		registry.DevService:Register("year", {
			Description = "Set the year counter.",
			Usage = "year <number>",
			Run = function(player, args) ... return "Year is now 25" end,
		})

	Three ways in, all through Execute:
	* in a game, an allowed player types `/dev <command> [args]` in chat (DevController sends
	  the DevCommand remote; permission is checked here, never trusted from the client);
	* in a Studio playtest, tools call ServerScriptService.DevTools.Invoke (a
	  BindableFunction made only in Studio): `Invoke:Invoke("test")`;
	* in Studio, the data tests and StructureCheck run once when the server starts.

	Allowed: everyone in Studio; outside Studio only Constants.ADMIN_USER_IDS. Players get a
	DevAllowed attribute so their client can show the command.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local BuildInfo = require(Shared.BuildInfo) :: any
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local TableUtil = require(Shared.Utilities.TableUtil)
local Types = require(Shared.Types)

local log = Log.new("DevService")
local IS_STUDIO = RunService:IsStudio()
local MAX_OUTPUT = 3000

local DevService = {
	Name = "DevService",
	Dependencies = {},
}

local commands: { [string]: Types.DevCommand } = {}

function DevService:IsAllowed(player: Player?): boolean
	if IS_STUDIO then
		return true
	end
	return player ~= nil and Constants.ADMIN_USER_IDS[player.UserId] == true
end

function DevService:Register(name: string, command: Types.DevCommand)
	assert(type(name) == "string" and string.find(name, "^[%w_%.%-]+$"), "DevService: command names are words")
	assert(commands[name] == nil, `DevService: command {name} is already registered`)
	assert(type(command.Run) == "function" and type(command.Description) == "string", "DevService: bad command")
	commands[name] = command
end

-- Runs a command for a player (nil = Studio tooling). Returns ok and the output text.
function DevService:Execute(player: Player?, name: string, args: { any }): (boolean, string)
	if not DevService:IsAllowed(player) then
		return false, "not allowed"
	end
	local command = commands[name]
	if not command then
		return false, `no command {name}; try help`
	end
	local who = if player then player.Name else "studio"
	local shown = {}
	for _, arg in args do
		table.insert(shown, tostring(arg))
	end
	log:Info("%s ran %s %s", who, name, table.concat(shown, " "))
	local ok, result = xpcall(command.Run, debug.traceback, player, args)
	if not ok then
		log:Error("%s failed: %s", name, tostring(result))
		return false, `{name} failed: {tostring(result)}`
	end
	local text = if result == nil then "done" else tostring(result)
	if #text > MAX_OUTPUT then
		text = string.sub(text, 1, MAX_OUTPUT) .. "\n...(cut)"
	end
	return true, text
end

local function splitLine(line: string): (string, { any })
	local words = {}
	for word in string.gmatch(line, "%S+") do
		local number = tonumber(word)
		if word == "true" then
			table.insert(words, true)
		elseif word == "false" then
			table.insert(words, false)
		elseif number ~= nil and number == number and math.abs(number) ~= math.huge then
			table.insert(words, number)
		else
			table.insert(words, word)
		end
	end
	local name = table.remove(words, 1)
	return tostring(name or "help"), words
end

local function runChecks(): string
	local DevTools = ServerScriptService:FindFirstChild("DevTools")
	if not DevTools then
		return "DevTools folder missing"
	end
	local lines = {}
	local structure = require(DevTools:FindFirstChild("StructureCheck") :: ModuleScript) :: any
	local tests = require(DevTools:FindFirstChild("DataTests") :: ModuleScript) :: any
	table.insert(lines, structure.Format(structure.Run({ Runtime = true })))
	table.insert(lines, tests.Format(tests.Run()))
	return table.concat(lines, "\n")
end

local function registerBuiltIns()
	DevService:Register("help", {
		Description = "List commands.",
		Run = function(): string?
			local lines = {}
			for _, name in TableUtil.SortedKeys(commands) do
				local command = commands[name]
				table.insert(lines, `{command.Usage or name}: {command.Description}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	DevService:Register("version", {
		Description = "Build, place and server.",
		Run = function(): string?
			return `{Constants.GAME_NAME} {BuildInfo.Label} | {Constants.PlaceKind()} | job {game.JobId} | Studio {IS_STUDIO}`
		end,
	})
	DevService:Register("ping", {
		Description = "Round trip check.",
		Run = function(player: Player?): string?
			local who = if player then player.Name else "studio"
			return `pong {who} at {string.format("%.3f", workspace:GetServerTimeNow())}`
		end,
	})
	DevService:Register("structure", {
		Description = "Run StructureCheck (instances, scripts, remotes, config).",
		Run = function(): string?
			local DevTools = ServerScriptService:FindFirstChild("DevTools")
			local structure = require((DevTools :: Instance):FindFirstChild("StructureCheck") :: ModuleScript) :: any
			return structure.Format(structure.Run({ Runtime = true }))
		end,
	})
	DevService:Register("test", {
		Description = "Run the data tests.",
		Usage = "test [name filter]",
		Run = function(_player: Player?, args: { any }): string?
			local DevTools = ServerScriptService:FindFirstChild("DevTools")
			local tests = require((DevTools :: Instance):FindFirstChild("DataTests") :: ModuleScript) :: any
			return tests.Format(tests.Run(if args[1] then tostring(args[1]) else nil))
		end,
	})
	DevService:Register("log", {
		Description = "Show or set the server log level (Debug, Info, Warn, Error).",
		Usage = "log [level]",
		Run = function(_player: Player?, args: { any }): string?
			local level = args[1]
			if level ~= nil then
				if not Log.IsLevel(level) then
					return "levels: Debug, Info, Warn, Error"
				end
				Log.SetLevel(level :: Log.Level)
			end
			return `server log level {Log.GetLevel()}`
		end,
	})
	DevService:Register("logs", {
		Description = "The last server log lines.",
		Usage = "logs [count]",
		Run = function(_player: Player?, args: { any }): string?
			local count = if type(args[1]) == "number" then args[1] else 20
			return table.concat(Log.Recent(count), "\n")
		end,
	})
	DevService:Register("remotes", {
		Description = "Traffic and rejections per remote.",
		Run = function(): string?
			local lines = {}
			local stats = Remotes.Stats()
			for _, name in TableUtil.SortedKeys(stats) do
				local s = stats[name]
				table.insert(
					lines,
					`{name}: received {s.Received}, rejected {s.Rejected}, rate-limited {s.Limited}, failed {s.Failed}`
				)
			end
			return table.concat(lines, "\n")
		end,
	})
	DevService:Register("players", {
		Description = "Players and their session state.",
		Run = function(): string?
			local lines = {}
			for _, player in Players:GetPlayers() do
				table.insert(
					lines,
					`{player.Name} ({player.UserId}) ready={tostring(player:GetAttribute("ClientReady") == true)}`
				)
			end
			return if #lines > 0 then table.concat(lines, "\n") else "no players"
		end,
	})
end

function DevService:Init(_registry)
	registerBuiltIns()
	Remotes.OnServer("DevCommand", function(player: Player, name: string, args: { any })
		local ok, text = DevService:Execute(player, name, args)
		if not ok and text == "not allowed" then
			log:Warn("%s (%d) tried dev command %s without permission", player.Name, player.UserId, name)
			return
		end
		local prefix = if ok then "" else "error: "
		Remotes.FireClient("Notice", player, prefix .. text)
	end)
end

function DevService:Start()
	local function mark(player: Player)
		player:SetAttribute("DevAllowed", DevService:IsAllowed(player))
	end
	Players.PlayerAdded:Connect(mark)
	for _, player in Players:GetPlayers() do
		mark(player)
	end

	if IS_STUDIO then
		local DevTools = ServerScriptService:FindFirstChild("DevTools")
		if DevTools then
			local invoke = Instance.new("BindableFunction")
			invoke.Name = "Invoke"
			invoke.OnInvoke = function(line: any, ...: any): string
				if type(line) ~= "string" then
					return "usage: Invoke:Invoke(\"command arg1 arg2\")"
				end
				local name, args = splitLine(line)
				for _, extra in { ... } do
					table.insert(args, extra)
				end
				local ok, text = DevService:Execute(nil, name, args)
				return (if ok then "" else "error: ") .. text
			end
			invoke.Parent = DevTools
			if DevTools:GetAttribute("RunChecksOnStart") ~= false then
				task.defer(function()
					log:Info("Studio start checks:\n%s", runChecks())
				end)
			end
		end
	end
end

return DevService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000FF"><Properties><string name="Name">DigService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DigService: digging, what a dug cell holds, Push Deeper, the Drill Bay's queue and
	Disturbance (bible Sections 6, 7, 10 and 14). Run place only; Prompt 14. The arithmetic is
	Shared.Rules.Dig and Shared.Rules.Loot; the numbers are Config.DepthBands, Config.DigResults,
	Config.LootTables, Tuning.Digging and Tuning.Disturbance (provisional ones marked there).

	* Digging (Section 6): every Rock cell left of, right of or below an open cell has a dig
	  prompt at each face it can be dug from (Rules.Dig.Faces): on the wall line for a side, on
	  the floor of the cell above for digging down. Players who carry a Drill or a Pickaxe hold
	  Interact there (the prompt only shows to them); the cell takes its band's DigSeconds, the
	  Driller digs twice as fast (DigSpeed) and players on one cell stack. Progress stays when
	  they let go. The prompt's Progress attribute drives its gauge.
	* The Drill Bay (Sections 6 and 7): any player marks rock cells for its queue in the Command
	  View (MarkDig, no vote). Each working Drill Bay digs the first queued cell it can at
	  ResidentDigMultiplier of a player for each unit of its crew's output.
	* Push Deeper (Section 6): the first cell of a new band (floors 4, 7 and 10) needs a vote.
	  Trying to dig past RunState.DigLimit opens it (VoteService, Kind PushDeeper; solo runs pass
	  at once); a pass moves DigLimit to the band's last floor.
	* When a cell opens (BunkerGrid:Dig): Disturbance rises (DisturbancePerCell, DigDisturbance:
	  the Driller's level 3, Deep Charges), the cell's roll is applied (Rules.Dig.Roll, the same
	  all run, so the Driller's hints match), and now and then its passage caves in
	  (CaveInChance; Section 10: digging causes cave-ins).
	  * Ore pocket: the band's ore (Loot OrePocket; the Driller's DugOre) into the stockpile.
	  * Cave opening: a dark cave mouth in the back wall and a breach point (Section 10). The cave
	    behind it is Prompt 17's.
	  * Cache: a crate; holding Interact opens it: resources into the stockpile, throwables to
	    the player who opened it (Loot Cache; gear and radio logs wait for their prompts).
	  * Nest: monsters pour out at once (ThreatDirector:Burst), it is a breach point while it
	    lives and raises Disturbance every cycle (NestPerCycle); destroying it (it is a monster
	    combatant, NestHealth) pays Loot Nest and drops Disturbance by NestDestroyed.
	  * Cryo pod (Era II, Prompt 17): the handler DeepService sets (SetResultHandler) puts a pod in
	    the cell, a big find to carry home.
	  * Hazard pockets (gas and water, Prompt 23) count as Empty until their system exists.
	  A few cells hold a fixed result this run (SetRoll, Prompt 17: the Lost Crews' caves); RunState
	  DigOverrides carries them so the Driller's hints match.
	  Nothing is built on a cell with a nest, a cache or a cave opening (BuildService:SetCellCheck).
	* Disturbance (Section 10): RunState.Disturbance 0 to 100. Digging, explosives
	  (WeaponService.Exploded, Explosive) and living nests raise it; it falls DecayPerCycle each
	  cycle and NestDestroyed when a nest is destroyed. Crossing ExtraBreachAt brings an extra
	  small breach (ThreatDirector:ExtraBreach); reaching TremorAt is a Tremor: a full breach wave
	  at once (ThreatDirector:Tremor), a cave-in (Section 10: Tremors cause cave-ins), the camera
	  shakes (RunState.TremorAt), and the meter drops to AfterTremor.
	* The Command View sees digging in front of each rock cell being dug or queued: a hazard
	  frame and a bar that fills with progress.

	Replication: the Digs collection, "S:<floor>,<column>" -> { Floor, Column, Progress, Diggers,
	Queue, Bay, Vote } for cells being dug or queued, "F:<floor>,<column>" -> { Floor, Column,
	Kind } for what dug cells hold (CaveOpening, Cache, Nest). RunState Disturbance, DigLimit,
	DigSeed, DigOverrides, TremorAt and Nests.

	API:
		DigService:Disturbance(): number
		DigService:AddDisturbance(amount, source)        -- Overdrive, Breaching Charges (Prompt 20)
		DigService:DigNow(floor, column, cause, player?): (boolean, string?) -- abilities, DevTools
		DigService:Mark(floor, column, on, player?): (boolean, string?)
		DigService:SetModifier(source, key, value?)      -- DigSpeed, DigDisturbance (team-wide)
		DigService:Feature(floor, column): string?
		DigService:SetRoll(floor, column, result?)        -- fix a cell's roll this run (Prompt 17)
		DigService:SetResultHandler(result, fn?)          -- fn(floor, column, finisher): text (Prompt 17's cryo pods)
		DigService:OpenCave(floor, column)                -- the cave behind is built: the mouth's stand-in goes
		DigService.Dug: Signal<number, number, string, string, Player?> -- floor, column, result, cause, who finished it
		DigService.FeatureAdded: Signal<string, number, number> -- kind, floor, column (Prompt 17 builds caves on it)
	Dev: digs, dig, dig.roll, dig.mark, disturbance, disturbance.add, tremor, pushdeeper, nest, cache, cave.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Dig = require(Shared.Rules.Dig)
local Disasters = require(Shared.Rules.Disasters)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Loot = require(Shared.Rules.Loot)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("DigService")

local DigService = {
	Name = "DigService",
	Dependencies = {
		"BunkerGrid", "CycleClock", "RunDirector", "SessionService", "ReplicationService", "EconomyService", "WeaponService",
		"CombatService", "VoteService", "BuildService", "BreachService", "ThreatDirector", "DisasterService", "InventoryService",
		"DevService",
	},
	Dug = Signal.new() :: Signal.Signal<number, number, string, string, Player?>,
	FeatureAdded = Signal.new() :: Signal.Signal<string, number, number>,
}

-- Results whose systems exist; the rest count as Empty (hazard pockets: Prompt 23).
local AVAILABLE: { [string]: boolean } = {
	Empty = true, OrePocket = true, CaveOpening = true, Cache = true, Nest = true, CryoPod = true,
	HazardPocket = true, -- Prompt 23: gas or water bursts out (DisasterService:HazardPocket)
}
-- Loot specials nothing hands out yet: gear (Prompt 26), blueprints (19), recruits (18). Radio logs
-- go to InventoryService's handler (Prompt 17).
local SKIP_SPECIALS: { [string]: boolean } = { Recruit = true, Glowshards = true } -- blueprints: Prompt 19 (DraftService); gear: Prompt 26
local CAMERA_IGNORE_TAG = "CameraIgnore"
local MARK_COLOR = Color3.fromHex("#F2C14E") -- Hazard Yellow
local FILL_COLOR = Color3.fromHex("#E8743B") -- Signal Orange
local MAX_QUEUE = 12

type Site = {
	Key: string,
	Floor: number,
	Column: number,
	Progress: number,
	Diggers: { [Player]: number }, -- player -> speed
	Bay: boolean, -- a Drill Bay is digging it this tick
	Sent: string,
}
type Feature = {
	Key: string,
	Floor: number,
	Column: number,
	Kind: string, -- "CaveOpening" | "Cache" | "Nest"
	Model: Model?,
	CombatId: string?,
}

local grid: any = nil
local clock: any = nil
local director: any = nil
local session: any = nil
local economy: any = nil
local weapons: any = nil
local combat: any = nil
local votes: any = nil
local builds: any = nil
local breaches: any = nil
local threat: any = nil
local disasters: any = nil
local inventory: any = nil
local collection: any = nil
local set: (string, any) -> () = function() end

local rng = Random.new()
local sites: { [string]: Site } = {}
local queue: { string } = {}
local features: { [string]: Feature } = {}
local disturbance = 0
local limit = 3
local seed = 0
local votesOpen: { [number]: string } = {} -- a band's first floor -> its vote id
local retryAt: { [number]: number } = {}
local modifiers: { [string]: { [string]: number } } = {} -- key -> source -> value
local overrides: Dig.Overrides = {} -- cells whose roll is fixed this run (Prompt 17)
local resultHandlers: { [string]: (number, number, Player?) -> string } = {}
local prompts: { [string]: { Part: BasePart, Prompt: ProximityPrompt, Key: string } } = {} -- "<key>|<side>"
local markers: { [string]: Model } = {}
local folder: Folder? = nil

-- Helpers -------------------------------------------------------------------------------------------

local function now(): number
	return workspace:GetServerTimeNow()
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function eraNumber(): number
	return table.find(Config.Ids("Eras"), clock:Era()) or 1
end

local function teamValue(key: string): number
	local value = 1
	for _, v in modifiers[key] or {} do
		value *= v
	end
	return value
end

local function classValue(player: Player?, key: string): number
	if not player then
		return 1
	end
	return Modifiers.PlayerValue(player, key) or 1 -- at the player's class level (Prompt 20)
end

local function holder(): Folder?
	if folder and folder.Parent then
		return folder
	end
	local root = grid:Root()
	if not root then
		return nil
	end
	local found = root:FindFirstChild("Digging")
	if not found then
		found = Instance.new("Folder")
		found.Name = "Digging"
		found.Parent = root
	end
	folder = found :: Folder
	return folder
end

local function art(category: string, name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local f = assets and assets:FindFirstChild(category)
	local found = f and f:FindFirstChild(name)
	return if found and found:IsA("Model") then found else nil
end

local function bandName(floor: number): string
	return string.upper(Grid.BandOf(floor).Name)
end

local function where(floor: number, column: number): string
	return `FLOOR {floor} · COLUMN {column}`
end

local function inRun(): boolean
	return director:Phase() == "Playing"
end

-- Disturbance --------------------------------------------------------------------------------------

local function tremorCaveIn()
	local bunker = grid:Bunker()
	local doorways = Disasters.Doorways(bunker)
	local deepest = grid:DeepestFloor()
	local near = {}
	for _, d in doorways do
		if d.Floor >= deepest - 1 then
			table.insert(near, d)
		end
	end
	local list = if #near > 0 then near else doorways
	if #list == 0 then
		return
	end
	local pick = list[rng:NextInteger(1, #list)]
	disasters:CaveIn(pick.Floor, pick.Column, pick.Side, "Tremor")
end

local function setDisturbance(value: number, source: string)
	local before = disturbance
	disturbance = math.clamp(value, 0, Dig.DisturbanceTuning().Max)
	local extra, tremor = Dig.Crossed(before, disturbance)
	if tremor then
		disturbance = Dig.AfterTremor()
		log:Info("TREMOR (%s): Disturbance %.0f -> %.0f", source, before, disturbance)
		set("TremorAt", now())
		announce("Danger", "TREMOR! THE DEEP IS AWAKE: MONSTERS ARE BREAKING IN EVERYWHERE")
		if inRun() then
			local ok, err = pcall(function()
				threat:Tremor()
				tremorCaveIn()
			end)
			if not ok then
				log:Warn("tremor: %s", tostring(err))
			end
		end
	elseif extra then
		log:Info("Disturbance passed %d (%s): an extra breach", Dig.DisturbanceTuning().ExtraBreachAt, source)
		if inRun() then
			local ok, err = pcall(function()
				threat:ExtraBreach()
			end)
			if not ok then
				log:Warn("extra breach: %s", tostring(err))
			end
		end
	end
	set("Disturbance", math.floor(disturbance * 10 + 0.5) / 10)
end

function DigService:Disturbance(): number
	return disturbance
end

function DigService:AddDisturbance(amount: number, source: string)
	setDisturbance(Dig.AddDisturbance(disturbance, amount), source)
end

function DigService:SetModifier(source: string, key: string, value: number?)
	modifiers[key] = modifiers[key] or {}
	modifiers[key][source] = value
end

-- Sites and the Command View's marks ----------------------------------------------------------------

local function siteOf(key: string): Site?
	return sites[key]
end

local function getSite(floor: number, column: number): Site
	local key = Grid.Key(floor, column)
	local site = sites[key]
	if not site then
		site = { Key = key, Floor = floor, Column = column, Progress = 0, Diggers = {}, Bay = false, Sent = "" }
		sites[key] = site
	end
	return site
end

local function diggerCount(site: Site): number
	local n = 0
	for _ in site.Diggers do
		n += 1
	end
	return n
end

local function updateMarker(site: Site?, key: string)
	local floor, column = Grid.Parse(key)
	local queued = table.find(queue, key)
	local show = site ~= nil and (site.Progress > 0 or diggerCount(site) > 0 or site.Bay) or queued ~= nil
	local marker = markers[key]
	if not show or not floor or not column then
		if marker then
			marker:Destroy()
			markers[key] = nil
		end
		return
	end
	local parent = holder()
	if not parent then
		return
	end
	if not marker then
		local model = Instance.new("Model")
		model.Name = `Mark_{key}`
		local cell = Grid.CellPosition(floor, column)
		local pitch = Grid.Pitch()
		local t = Grid.Tuning()
		local z = cell.Z + pitch.Z / 2 + 1.2 -- in front of the rock face, where the Command View looks
		local w, h = t.CellWidth - 4, t.CellHeight - 3
		local centre = Vector3.new(cell.X, cell.Y + t.CellHeight / 2, z)
		local function bar(name: string, size: Vector3, at: Vector3, color: Color3)
			local p = Instance.new("Part")
			p.Name = name
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Color = color
			p.Size = size
			p.Position = at
			CollectionService:AddTag(p, CAMERA_IGNORE_TAG)
			p.Parent = model
			return p
		end
		bar("Top", Vector3.new(w, 0.5, 0.3), centre + Vector3.new(0, h / 2, 0), MARK_COLOR)
		bar("Bottom", Vector3.new(w, 0.5, 0.3), centre - Vector3.new(0, h / 2, 0), MARK_COLOR)
		bar("Left", Vector3.new(0.5, h, 0.3), centre - Vector3.new(w / 2, 0, 0), MARK_COLOR)
		bar("Right", Vector3.new(0.5, h, 0.3), centre + Vector3.new(w / 2, 0, 0), MARK_COLOR)
		local fill = bar("Fill", Vector3.new(0.1, 1.6, 0.35), centre - Vector3.new(w / 2 - 0.05, h / 2 - 1.6, 0), FILL_COLOR)
		fill:SetAttribute("Left", (centre - Vector3.new(w / 2 - 0.5, h / 2 - 1.6, 0)))
		fill:SetAttribute("Width", w - 1)
		model:SetAttribute("Cell", key)
		model.Parent = parent
		markers[key] = model
		marker = model
	end
	local fill = (marker :: Model):FindFirstChild("Fill") :: BasePart?
	if fill then
		local progress = if site then site.Progress else 0
		local width = (fill:GetAttribute("Width") :: number?) or 20
		local left = fill:GetAttribute("Left") :: Vector3?
		local length = math.max(width * progress, 0.1)
		fill.Size = Vector3.new(length, fill.Size.Y, fill.Size.Z)
		if left then
			fill.Position = left + Vector3.new(length / 2, 0, 0)
		end
		fill.Transparency = if progress > 0 then 0 else 1
	end
end

local function publishSite(key: string)
	local site = siteOf(key)
	local queued = table.find(queue, key)
	local floor, column = Grid.Parse(key)
	if not floor or not column then
		return
	end
	local band = Grid.BandOf(floor)
	local vote = votesOpen[band.Floors.From] ~= nil and Dig.NeedsVote(floor, limit)
	if not site and not queued then
		collection:Remove(`S:{key}`)
	else
		local progress = if site then math.floor(site.Progress * 100) / 100 else 0
		local diggers = if site then diggerCount(site) else 0
		local bay = site ~= nil and site.Bay
		local sent = `{progress}|{diggers}|{queued or 0}|{bay}|{vote}`
		if not site or site.Sent ~= sent then
			collection:Set(`S:{key}`, {
				Floor = floor, Column = column, Progress = progress, Diggers = diggers, Queue = queued, Bay = bay, Vote = vote,
			})
			if site then
				site.Sent = sent
			end
		end
	end
	-- the prompts' gauges and words
	for _, entry in prompts do
		if entry.Key == key then
			entry.Prompt:SetAttribute("Progress", if site then site.Progress else 0)
		end
	end
	updateMarker(site, key)
end

local function dropSite(key: string)
	sites[key] = nil
	local index = table.find(queue, key)
	if index then
		table.remove(queue, index)
		for _, other in queue do
			publishSite(other)
		end
	end
	publishSite(key)
end

function DigService:Mark(floor: number, column: number, on: boolean, player: Player?): (boolean, string?)
	local key = Grid.Key(floor, column)
	if not Grid.OnGrid(floor, column) or grid:State(floor, column) ~= "Rock" then
		return false, "Only rock can go on the dig queue."
	end
	local index = table.find(queue, key)
	if on then
		if index then
			return true, nil
		end
		if #queue >= MAX_QUEUE then
			return false, `The dig queue is full ({MAX_QUEUE} cells).`
		end
		table.insert(queue, key)
		log:Info("%s queued %s (%d in the queue)", if player then player.Name else "DevTools", key, #queue)
	else
		if not index then
			return true, nil
		end
		table.remove(queue, index)
		log:Info("%s took %s off the queue", if player then player.Name else "DevTools", key)
	end
	for _, other in queue do
		publishSite(other)
	end
	publishSite(key)
	return true, nil
end

-- Features: what dug cells hold -----------------------------------------------------------------------

local function publishFeature(f: Feature?, key: string)
	if f then
		collection:Set(`F:{key}`, { Floor = f.Floor, Column = f.Column, Kind = f.Kind })
	else
		collection:Remove(`F:{key}`)
	end
	local nests = 0
	for _, other in features do
		if other.Kind == "Nest" then
			nests += 1
		end
	end
	set("Nests", nests)
end

-- Monsters come out in front of the cave mouth or the nest's maw (the back of the cell is -Z).
local function breachPoint(f: Feature, kind: string): any
	local cell = Grid.CellPosition(f.Floor, f.Column)
	local out = cell + Vector3.new(0, 0.5, if kind == "Nest" then -2.5 else -6)
	return {
		Id = `{if kind == "Nest" then "N" else "O"}:{f.Key}`,
		Kind = kind,
		RoomId = nil,
		Floor = f.Floor,
		Column = f.Column,
		Weight = 1,
		Dark = false,
		At = CFrame.lookAt(out, out + Vector3.new(0, 0, 1)),
		Source = cell + Vector3.new(0, 3, -13),
	}
end

local function placeModel(f: Feature, source: Model?, offset: CFrame): Model
	local model: Model
	if source then
		model = source:Clone()
	else
		model = Instance.new("Model")
	end
	model.Name = `{f.Kind}_{f.Key}`
	model:SetAttribute("Cell", f.Key)
	model:SetAttribute("Feature", f.Kind)
	local parent = holder()
	model.Parent = parent
	if #model:GetChildren() == 0 then
		-- graybox until the art arrives
		local p = Instance.new("Part")
		p.Name = "Graybox"
		p.Size = if f.Kind == "Nest" then Vector3.new(7, 5, 6) elseif f.Kind == "Cache" then Vector3.new(3, 2.4, 2.4)
			else Vector3.new(10, 9, 1)
		p.Color = if f.Kind == "Nest" then Color3.fromHex("#6E4766") elseif f.Kind == "Cache" then Color3.fromHex("#5E6A44")
			else Color3.fromHex("#1B2A3A")
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.Parent = model
		model.PrimaryPart = p
		p.CFrame = Grid.CellCFrame(f.Floor, f.Column) * offset * CFrame.new(0, p.Size.Y / 2, 0)
		model.WorldPivot = Grid.CellCFrame(f.Floor, f.Column) * offset
	else
		model:PivotTo(Grid.CellCFrame(f.Floor, f.Column) * offset)
		if not model.PrimaryPart then
			-- the biggest part is the root (CombatService registers a nest by it)
			local best, volume = nil, 0
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") and part.Size.X * part.Size.Y * part.Size.Z > volume then
					best, volume = part, part.Size.X * part.Size.Y * part.Size.Z
				end
			end
			model.PrimaryPart = best
		end
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			if f.Kind ~= "Nest" then
				part.CanCollide = false
			end
		end
	end
	return model
end

local function removeFeature(key: string, how: string)
	local f = features[key]
	if not f then
		return
	end
	features[key] = nil
	if f.Kind == "CaveOpening" then
		breaches:SetExtraPoint(`O:{key}`, nil)
	elseif f.Kind == "Nest" then
		breaches:SetExtraPoint(`N:{key}`, nil)
		if f.CombatId then
			combat:Unregister(f.CombatId)
		end
	end
	if f.Model then
		f.Model:Destroy()
	end
	publishFeature(nil, key)
	log:Info("%s at %s gone (%s)", f.Kind, key, how)
end

local function giveDrops(drops: { Loot.Drop }, player: Player?, why: string): { Loot.Drop }
	local given: { Loot.Drop } = {}
	for _, drop in drops do
		if drop.Resource then
			local added = economy:Add(drop.Resource, drop.Count, why)
			if added and added > 0 then
				table.insert(given, { Resource = drop.Resource, Count = added })
			end
		elseif drop.Item and player then
			local took = weapons:GiveThrowable(player, drop.Item, drop.Count)
			if took > 0 then
				table.insert(given, { Item = drop.Item, Count = took })
			end
		elseif drop.Special and player then
			-- a radio log plays for the player who found it (InventoryService's handlers, Prompt 17)
			local took = inventory:GiveSpecial(player, drop.Special, drop.Count)
			if took > 0 then
				table.insert(given, { Special = drop.Special, Count = took })
			end
		end
	end
	return given
end

local function openCache(f: Feature, player: Player)
	if features[f.Key] ~= f then
		return
	end
	local band = Grid.BandOf(f.Floor)
	local drops = Loot.Roll("Cache", rng, { BandOre = band.Ore, Skip = SKIP_SPECIALS })
	local given = giveDrops(drops, player, `cache {f.Key}`)
	removeFeature(f.Key, "Opened")
	announce("Info", `{string.upper(player.DisplayName)} OPENED THE CACHE: {if #given > 0 then Loot.Text(given) else "NOTHING LEFT IN IT"}`)
end

local function destroyNest(f: Feature, killer: Player?)
	if features[f.Key] ~= f then
		return
	end
	local band = Grid.BandOf(f.Floor)
	local drops = Loot.Roll("Nest", rng, { BandOre = band.Ore, Skip = SKIP_SPECIALS })
	local given = giveDrops(drops, killer, `nest {f.Key}`)
	f.Model = nil -- CombatService dissolves a dead combatant's model itself
	f.CombatId = nil
	removeFeature(f.Key, "Destroyed")
	DigService:AddDisturbance(-Dig.DisturbanceTuning().NestDestroyed, "NestDestroyed")
	announce("Info", `THE NEST IS DESTROYED: {if #given > 0 then Loot.Text(given) else "NOTHING"} · DISTURBANCE -{Dig.DisturbanceTuning().NestDestroyed}`)
end

local function addFeature(kind: string, floor: number, column: number): Feature
	local key = Grid.Key(floor, column)
	removeFeature(key, "Replaced")
	local f: Feature = { Key = key, Floor = floor, Column = column, Kind = kind, Model = nil, CombatId = nil }
	features[key] = f
	local depth = Grid.Tuning().CellDepth
	if kind == "CaveOpening" then
		-- 2 studs off the back wall: the dug cell's rock face bulges up to 2 studs into the room
		f.Model = placeModel(f, art("Kit", "Kit_CaveMouth"), CFrame.new(0, 0, depth / 2 - 2))
		breaches:SetExtraPoint(`O:{key}`, breachPoint(f, "Cave"))
	elseif kind == "Cache" then
		-- towards the back and to the right, clear of the dug cells' dressing (the Mines' ore cart)
		local model = placeModel(f, art("Props", "Prop_SupplyCrate"), CFrame.new(-6, 0, 5) * CFrame.Angles(0, math.rad(-18), 0))
		f.Model = model
		local _, size = model:GetBoundingBox()
		local spot = Instance.new("Part")
		spot.Name = "CachePrompt"
		spot.Anchored = true
		spot.CanCollide = false
		spot.CanQuery = false
		spot.CanTouch = false
		spot.Transparency = 1
		spot.Size = Vector3.new(1, 1, 1)
		spot.CFrame = model:GetPivot() + Vector3.new(0, size.Y + 0.5, 0)
		spot.Parent = model
		local p = Instance.new("ProximityPrompt")
		p.ActionText = "Open the cache"
		p.ObjectText = "Dug up · loot for the team"
		p.HoldDuration = Dig.Tuning().CacheOpenSeconds
		p.MaxActivationDistance = 9
		p.RequiresLineOfSight = false
		p.Style = Enum.ProximityPromptStyle.Custom
		p:SetAttribute("Kind", "OpenCache")
		p.Parent = spot
		p.Triggered:Connect(function(player: Player)
			openCache(f, player)
		end)
	elseif kind == "Nest" then
		local model = placeModel(f, art("Props", "Prop_Nest"), CFrame.new(0, 0, 8))
		f.Model = model
		-- an ordinary monster id (M<n>): FireWeapon only takes those as hits
		local id = combat:Register(model, {
			Kind = "Monster", Team = "Monsters", Health = Dig.Tuning().NestHealth, MonsterType = "Nest",
		})
		f.CombatId = id
		breaches:SetExtraPoint(`N:{key}`, breachPoint(f, "Nest"))
	end
	publishFeature(f, key)
	DigService.FeatureAdded:Fire(kind, floor, column)
	return f
end

function DigService:Feature(floor: number, column: number): string?
	local f = features[Grid.Key(floor, column)]
	return if f then f.Kind else nil
end

-- The cave behind a cave opening is built (DeepService): its stand-in mouth goes, the breach point
-- stays (Section 12: caves stay open, so they are routes monsters take).
function DigService:OpenCave(floor: number, column: number)
	local f = features[Grid.Key(floor, column)]
	if f and f.Kind == "CaveOpening" and f.Model then
		f.Model:Destroy()
		f.Model = nil
	end
end

-- Fixes what a cell holds this run (nil puts it back to its roll). Prompt 17: the Lost Crews' caves.
function DigService:SetRoll(floor: number, column: number, result: string?)
	assert(result == nil or Config.Find("DigResults", result), `DigService:SetRoll: no dig result {tostring(result)}`)
	overrides[Grid.Key(floor, column)] = result
	set("DigOverrides", Dig.EncodeOverrides(overrides))
end

-- What a result does when a cell opens with it, for results another service owns (cryo pods).
function DigService:SetResultHandler(result: string, fn: ((number, number, Player?) -> string)?)
	resultHandlers[result] = fn
end

-- Opening a cell ----------------------------------------------------------------------------------------

local function sideOf(floor: number, column: number, from: { Floor: number, Column: number }?): string?
	if not from or from.Floor ~= floor then
		return nil
	end
	return if from.Column < column then "Left" else "Right"
end

local function applyRoll(result: string, floor: number, column: number, finisher: Player?): string
	local band = Grid.BandOf(floor)
	if result == "OrePocket" then
		if not band.Ore then
			return "the rock is bare"
		end
		local drops = Loot.Roll("OrePocket", rng, { BandOre = band.Ore, OreMultiplier = classValue(finisher, "DugOre") })
		local given = giveDrops(drops, finisher, `ore pocket {Grid.Key(floor, column)}`)
		return `AN ORE POCKET: {if #given > 0 then Loot.Text(given) else "THE STOCKPILE IS FULL"}`
	elseif result == "CaveOpening" then
		addFeature("CaveOpening", floor, column)
		return "A CAVE OPENING: SOMETHING CAN COME THROUGH IT"
	elseif result == "Cache" then
		addFeature("Cache", floor, column)
		return "A CACHE: OPEN IT FOR THE TEAM"
	elseif result == "HazardPocket" then
		local kind = disasters:HazardPocket(floor, column, finisher)
		return if kind == "Flood" then "A HAZARD POCKET! WATER BURSTS OUT" elseif kind == "GasLeak" then "A HAZARD POCKET! GAS BURSTS OUT" else ""
	elseif result == "Nest" then
		local f = addFeature("Nest", floor, column)
		local at = Grid.CellCFrame(f.Floor, f.Column) * CFrame.new(0, 0.5, 3) * CFrame.Angles(0, math.pi, 0)
		local ok, err = pcall(function()
			threat:Burst(Dig.Tuning().NestBudget, at, `Nest:{f.Key}`)
		end)
		if not ok then
			log:Warn("nest burst: %s", tostring(err))
		end
		return "A NEST! MONSTERS POUR OUT · DESTROY IT"
	end
	local handler = resultHandlers[result]
	if handler then
		local ok, text = pcall(handler, floor, column, finisher)
		if not ok then
			log:Warn("%s at %s: %s", result, Grid.Key(floor, column), tostring(text))
			return ""
		end
		return text
	end
	return ""
end

local function open(floor: number, column: number, cause: string, finisher: Player?, from: { Floor: number, Column: number }?): (boolean, string?)
	local ok, why = grid:Dig(floor, column)
	if not ok then
		return false, why
	end
	local key = Grid.Key(floor, column)
	sites[key] = nil
	local index = table.find(queue, key)
	if index then
		table.remove(queue, index)
	end
	-- Section 10: every dug cell adds Disturbance (the Driller's level 3, Deep Charges)
	local amount = Dig.Tuning().DisturbancePerCell * classValue(finisher, "DigDisturbance") * teamValue("DigDisturbance")
	DigService:AddDisturbance(amount, "Digging")
	local result = Dig.Roll(seed, floor, column, eraNumber(), AVAILABLE, overrides)
	local found = applyRoll(result, floor, column, finisher)
	log:Info("dug %s (%s, %s): %s", key, cause, if finisher then finisher.Name else "-", result)
	announce(if result == "Nest" or result == "HazardPocket" then "Danger" else "Info",
		`DUG THROUGH TO {where(floor, column)}{if found ~= "" then `: {found}` else ""}`)
	for _, other in queue do
		publishSite(other)
	end
	publishSite(key)
	-- Section 10: digging causes cave-ins, now and then the passage it was dug through
	local side = sideOf(floor, column, from)
	if side and rng:NextNumber() < Dig.Tuning().CaveInChance then
		task.defer(function()
			disasters:CaveIn(floor, column, side, "Digging")
		end)
	end
	DigService.Dug:Fire(floor, column, result, cause, finisher)
	return true, nil
end

function DigService:DigNow(floor: number, column: number, cause: string, player: Player?): (boolean, string?)
	local faces = Dig.Faces(grid:Bunker(), floor, column)
	return open(floor, column, cause, player, faces[1])
end

-- Push Deeper ------------------------------------------------------------------------------------------

local function setLimit(value: number)
	limit = value
	set("DigLimit", limit)
end

local function askPushDeeper(player: Player, floor: number, column: number)
	local band = Grid.BandOf(floor)
	local first = band.Floors.From
	if votesOpen[first] then
		Remotes.FireClient("Alert", player, "Info", `THE PUSH DEEPER VOTE IS ON: VOTE ON THE BANNER`)
		return
	end
	local wait = (retryAt[first] or 0) - os.clock()
	if wait > 0 then
		Remotes.FireClient("Alert", player, "Warning", `THE TEAM SAID NO TO PUSHING DEEPER: ASK AGAIN IN {math.ceil(wait)} S`)
		return
	end
	local key = Grid.Key(floor, column)
	local id, err = votes:Open({
		Kind = "PushDeeper",
		Proposer = player,
		Title = `PUSH DEEPER: THE {string.upper(band.Name)}`,
		Subject = { Floor = floor, Column = column, Span = 1, Label = "PUSH DEEPER" },
		Cells = { key },
		Check = function(): (boolean, string?)
			return true, nil
		end,
		OnPass = function()
			votesOpen[first] = nil
			if limit < Dig.LimitAfter(floor) then
				setLimit(Dig.LimitAfter(floor))
			end
			log:Info("Push Deeper passed: the %s (dig to floor %d)", band.Name, limit)
			announce("Info", `PUSH DEEPER: THE TEAM OPENS THE {string.upper(band.Name)} · DIG DOWN TO FLOOR {limit}`)
			for k in sites do
				publishSite(k)
			end
		end,
		OnFail = function(reason: string)
			votesOpen[first] = nil
			retryAt[first] = os.clock() + Dig.Tuning().VoteRetrySeconds
			log:Info("Push Deeper failed: %s", reason)
			for k in sites do
				publishSite(k)
			end
		end,
	})
	if not id then
		Remotes.FireClient("Alert", player, "Warning", string.upper(err or "THE VOTE COULDN'T START"))
		return
	end
	if id ~= "solo" and limit < floor then
		votesOpen[first] = id
	end
	publishSite(key)
end

-- Players digging ----------------------------------------------------------------------------------------

local function canDigNow(player: Player): boolean
	return player:GetAttribute("Life") == "Alive" and Dig.CanDigWith(weapons:Items(player))
end

local function startDigging(player: Player, key: string)
	local floor, column = Grid.Parse(key)
	if not floor or not column or not inRun() then
		return
	end
	if not Dig.CanDigWith(weapons:Items(player)) then
		Remotes.FireClient("Alert", player, "Warning", "DIGGING NEEDS A DRILL OR A PICKAXE")
		return
	end
	local ok = grid:Bunker():CanDig(floor, column)
	if not ok then
		return
	end
	if Dig.NeedsVote(floor, limit) then
		askPushDeeper(player, floor, column)
		return
	end
	local site = getSite(floor, column)
	site.Diggers[player] = classValue(player, "DigSpeed") * teamValue("DigSpeed")
	publishSite(key)
end

local function stopDigging(player: Player, key: string)
	local site = sites[key]
	if site and site.Diggers[player] then
		site.Diggers[player] = nil
		publishSite(key)
	end
end

-- Dig prompts ---------------------------------------------------------------------------------------------

local function promptText(floor: number, face: Dig.Face): (string, string)
	local action = if face.Side == "Above" then "Dig down" else "Dig"
	local object
	if Dig.NeedsVote(floor, limit) then
		object = `{Grid.BandOf(floor).Name} · Push Deeper vote first`
	else
		object = `{Grid.BandOf(floor).Name} · {Dig.Seconds(floor)} s · Drill or Pickaxe`
	end
	return action, object
end

local function refreshPrompts()
	local parent = holder()
	if not parent then
		return
	end
	local bunker = grid:Bunker()
	local t = Grid.Tuning()
	local wanted: { [string]: { Floor: number, Column: number, Face: Dig.Face } } = {}
	for floor = t.FloorMin, t.FloorMax do
		for column = t.ColumnMin, t.ColumnMax do
			if bunker:State(floor, column) == "Rock" then
				for _, face in Dig.Faces(bunker, floor, column) do
					wanted[`{Grid.Key(floor, column)}|{face.Side}`] = { Floor = floor, Column = column, Face = face }
				end
			end
		end
	end
	for id, entry in prompts do
		if not wanted[id] then
			entry.Part:Destroy()
			prompts[id] = nil
		end
	end
	for id, w in wanted do
		local key = Grid.Key(w.Floor, w.Column)
		local action, object = promptText(w.Floor, w.Face)
		local entry = prompts[id]
		if not entry then
			local part = Instance.new("Part")
			part.Name = `Dig_{id}`
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			part.Transparency = 1
			part.Size = Vector3.new(1, 1, 1)
			part.Position = Dig.FacePoint(w.Face, w.Floor, w.Column)
			CollectionService:AddTag(part, CAMERA_IGNORE_TAG)
			part.Parent = parent
			local p = Instance.new("ProximityPrompt")
			p.Style = Enum.ProximityPromptStyle.Custom
			p.RequiresLineOfSight = false
			p.MaxActivationDistance = Dig.Tuning().PromptReach
			-- the cell is dug when its progress is full; the hold itself never runs out first
			p.HoldDuration = math.max(Dig.Seconds(w.Floor) * 2, 10)
			p:SetAttribute("Kind", "DigCell")
			p:SetAttribute("Cell", key)
			p.Parent = part
			p.PromptButtonHoldBegan:Connect(function(player: Player)
				startDigging(player, key)
			end)
			p.PromptButtonHoldEnded:Connect(function(player: Player)
				stopDigging(player, key)
			end)
			p.Triggered:Connect(function(player: Player)
				stopDigging(player, key)
			end)
			entry = { Part = part, Prompt = p, Key = key }
			prompts[id] = entry
		end
		local e = entry :: any
		e.Prompt.ActionText = action
		e.Prompt.ObjectText = object
		local site = sites[key]
		e.Prompt:SetAttribute("Progress", if site then site.Progress else 0)
	end
end

-- The tick ---------------------------------------------------------------------------------------------------

local function drillBaySpeed(): number
	local base = Config.Get("Rooms", "DrillBay").Output.Base
	local speed = 0
	for _, room in grid:RoomsOfType("DrillBay") do
		if not room.Wrecked then
			local rate = economy:Rate(room.Id)
			speed += Dig.DrillBaySpeed(rate, base)
		end
	end
	return speed
end

local function bayTarget(): string?
	local bunker = grid:Bunker()
	for _, key in queue do
		local floor, column = Grid.Parse(key)
		if floor and column and bunker:CanDig(floor, column) and not Dig.NeedsVote(floor, limit) then
			return key
		end
	end
	return nil
end

local function near(player: Player, key: string): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return false
	end
	for _, entry in prompts do
		if entry.Key == key and (entry.Part.Position - root.Position).Magnitude <= Dig.Tuning().PromptReach + 4 then
			return true
		end
	end
	return false
end

local function tick(dt: number)
	if not inRun() then
		return
	end
	-- the Drill Bay's queue
	local target = bayTarget()
	local baySpeed = if target then drillBaySpeed() else 0
	for key, site in sites do
		local wasBay = site.Bay
		site.Bay = key == target and baySpeed > 0
		if wasBay ~= site.Bay then
			publishSite(key)
		end
	end
	if target and baySpeed > 0 and not sites[target] then
		local floor, column = Grid.Parse(target)
		if floor and column then
			local site = getSite(floor, column)
			site.Bay = true
		end
	end
	for key, site in table.clone(sites) do
		local speeds = {}
		local finisher: Player? = nil
		for player, speed in table.clone(site.Diggers) do
			if player.Parent ~= Players or not canDigNow(player) or not near(player, key) then
				site.Diggers[player] = nil
			else
				table.insert(speeds, speed)
				finisher = player
			end
		end
		if site.Bay and baySpeed > 0 then
			table.insert(speeds, baySpeed)
		end
		if #speeds > 0 then
			if not grid:Bunker():CanDig(site.Floor, site.Column) then
				dropSite(key)
			elseif Dig.NeedsVote(site.Floor, limit) then
				site.Diggers = {}
				publishSite(key)
			else
				site.Progress = math.min(site.Progress + Dig.Rate(speeds, site.Floor) * dt, 1)
				if site.Progress >= 1 then
					local faces = Dig.Faces(grid:Bunker(), site.Floor, site.Column)
					local from = faces[1]
					if finisher then
						-- the face the finisher stood at
						local character = finisher.Character
						local root = character and character:FindFirstChild("HumanoidRootPart")
						if root and root:IsA("BasePart") then
							local best = math.huge
							for _, face in faces do
								local d = (Dig.FacePoint(face, site.Floor, site.Column) - root.Position).Magnitude
								if d < best then
									best, from = d, face
								end
							end
						end
					end
					open(site.Floor, site.Column, if finisher then "Player" else "DrillBay", finisher, from)
				else
					publishSite(key)
				end
			end
		elseif site.Progress <= 0 and not table.find(queue, key) then
			sites[key] = nil
			publishSite(key)
		else
			publishSite(key)
		end
	end
end

-- Each cycle (Section 10): Disturbance falls, living nests raise it.
local function onCycle()
	local t = Dig.DisturbanceTuning()
	local nests = 0
	for _, f in features do
		if f.Kind == "Nest" then
			nests += 1
		end
	end
	local change = nests * Dig.Tuning().NestPerCycle - t.DecayPerCycle
	if change ~= 0 then
		DigService:AddDisturbance(change, "Cycle")
	end
end

-- The world changed: prompts follow the open cells; features in cells that closed go.
local function onGridChanged()
	for key, f in table.clone(features) do
		local floor, column = Grid.Parse(key)
		if floor and column and grid:State(floor, column) ~= "Dug" and f.Kind ~= "CaveOpening" then
			removeFeature(key, "Gone")
		end
	end
	for key in table.clone(sites) do
		local floor, column = Grid.Parse(key)
		if floor and column and grid:State(floor, column) ~= "Rock" then
			dropSite(key)
		end
	end
	refreshPrompts()
end

-- DevTools -----------------------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	table.insert(lines, string.format("Disturbance %.1f (%s), dig limit floor %d, deepest floor %d, seed %d", disturbance,
		Dig.Level(disturbance), limit, grid:DeepestFloor(), seed))
	for key, site in sites do
		table.insert(lines, string.format("site %s: %.0f%%, %d diggers%s%s", key, site.Progress * 100, diggerCount(site),
			if site.Bay then ", the Drill Bay" else "", if table.find(queue, key) then `, queued {table.find(queue, key)}` else ""))
	end
	if #queue > 0 then
		table.insert(lines, `queue: {table.concat(queue, " ")} (Drill Bay speed {string.format("%.2f", drillBaySpeed())})`)
	end
	for key, f in features do
		table.insert(lines, `{f.Kind} at {key}{if f.CombatId then ` ({f.CombatId})` else ""}`)
	end
	local promptCount = 0
	for _ in prompts do
		promptCount += 1
	end
	table.insert(lines, `{promptCount} dig prompts`)
	for first, id in votesOpen do
		table.insert(lines, `Push Deeper vote for floor {first}: {id}`)
	end
	return table.concat(lines, "\n")
end

local function cellArgs(args: { any }): (number?, number?)
	return tonumber(args[1]), tonumber(args[2])
end

local function registerCommands(dev: any)
	dev:Register("digs", {
		Description = "Digging now: Disturbance, the dig limit, sites, the Drill Bay's queue, what dug cells hold.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("dig", {
		Description = "Dig a rock cell now, with its roll and Disturbance (no time, no vote).",
		Usage = "dig <floor> <column>",
		Run = function(player, args): string?
			local floor, column = cellArgs(args)
			if not floor or not column then
				return "usage: dig <floor> <column>"
			end
			local ok, why = DigService:DigNow(floor, column, "DevTools", player)
			return if ok then describe() else `can't dig: {why}`
		end,
	})
	dev:Register("dig.roll", {
		Description = "What a cell holds when it is dug (this run's roll), and the Driller's hint.",
		Usage = "dig.roll <floor> <column>",
		Run = function(_player, args): string?
			local floor, column = cellArgs(args)
			if not floor or not column then
				return "usage: dig.roll <floor> <column>"
			end
			return `{Dig.Roll(seed, floor, column, eraNumber(), AVAILABLE, overrides)} (hint {Dig.Hint(seed, floor, column, eraNumber(), AVAILABLE, overrides) or "none"})`
		end,
	})
	dev:Register("dig.mark", {
		Description = "Put a rock cell on the Drill Bay's queue (or off with 'off').",
		Usage = "dig.mark <floor> <column> [off]",
		Run = function(player, args): string?
			local floor, column = cellArgs(args)
			if not floor or not column then
				return "usage: dig.mark <floor> <column> [off]"
			end
			local ok, why = DigService:Mark(floor, column, args[3] ~= "off", player)
			return if ok then describe() else why
		end,
	})
	dev:Register("disturbance", {
		Description = "Set Disturbance (thresholds fire as in play).",
		Usage = "disturbance <value>",
		Run = function(_player, args): string?
			local n = tonumber(args[1])
			if not n then
				return "usage: disturbance <value>"
			end
			setDisturbance(n, "DevTools")
			return describe()
		end,
	})
	dev:Register("disturbance.add", {
		Description = "Add to Disturbance (or take away with a negative number), as digging would.",
		Usage = "disturbance.add <n>",
		Run = function(_player, args): string?
			local n = tonumber(args[1])
			if not n then
				return "usage: disturbance.add <n>"
			end
			DigService:AddDisturbance(n, "DevTools")
			return describe()
		end,
	})
	dev:Register("tremor", {
		Description = "A Tremor now (Disturbance to 100).",
		Run = function(): string?
			setDisturbance(Dig.DisturbanceTuning().TremorAt, "DevTools")
			return describe()
		end,
	})
	dev:Register("pushdeeper", {
		Description = "Open the next band without a vote (or set the dig limit).",
		Usage = "pushdeeper [floor]",
		Run = function(_player, args): string?
			local floor = tonumber(args[1]) or (limit + 1)
			setLimit(math.clamp(Dig.LimitAfter(math.clamp(floor, 1, Grid.Tuning().FloorMax)), 1, Grid.Tuning().FloorMax))
			refreshPrompts()
			return describe()
		end,
	})
	for _, kind in { "Nest", "Cache", "CaveOpening" } do
		local name = if kind == "CaveOpening" then "cave" else string.lower(kind)
		dev:Register(name, {
			Description = `Put a {kind} in a dug cell, as if digging had found it.`,
			Usage = `{name} <floor> <column>`,
			Run = function(player, args): string?
				local floor, column = cellArgs(args)
				if not floor or not column or grid:State(floor, column) ~= "Dug" then
					return `usage: {name} <floor> <column> (a dug cell)`
				end
				local found = applyRoll(kind, floor, column, player)
				return `{found}\n{describe()}`
			end,
		})
	end
end

-- Lifecycle -----------------------------------------------------------------------------------------------------

function DigService:Init(registry)
	grid = registry.BunkerGrid
	clock = registry.CycleClock
	director = registry.RunDirector
	session = registry.SessionService
	economy = registry.EconomyService
	weapons = registry.WeaponService
	combat = registry.CombatService
	votes = registry.VoteService
	builds = registry.BuildService
	breaches = registry.BreachService
	threat = registry.ThreatDirector
	disasters = registry.DisasterService
	inventory = registry.InventoryService
	collection = registry.ReplicationService:Collection("Digs")
	set = RunState.Writer("DigService")
	registerCommands(registry.DevService)
end

function DigService:Start()
	seed = Random.new():NextInteger(1, 2 ^ 30)
	limit = Dig.StartLimit()
	set("DigSeed", seed)
	set("DigLimit", limit)
	set("Disturbance", 0)
	set("Nests", 0)
	set("DigOverrides", Dig.EncodeOverrides(overrides))
	grid.Changed:Connect(onGridChanged)
	clock.CycleStarted:Connect(function(cycle: number)
		if cycle > 1 then
			onCycle()
		end
	end)
	weapons.Exploded:Connect(function()
		if inRun() then
			DigService:AddDisturbance(Dig.DisturbanceTuning().Explosive, "Explosive")
		end
	end)
	local lastHit: { [string]: string } = {} -- a nest's combatant id -> who hit it last
	local function isNest(id: string): boolean
		for _, f in features do
			if f.CombatId == id then
				return true
			end
		end
		return false
	end
	combat.Damaged:Connect(function(id: string, _amount: number, source: string?)
		if source and isNest(id) then
			lastHit[id] = source
		end
	end)
	combat.Died:Connect(function(id: string)
		for _, f in features do
			if f.CombatId == id then
				local killer: Player? = nil
				for _, player in Players:GetPlayers() do
					if `P{player.UserId}` == lastHit[id] then
						killer = player
					end
				end
				lastHit[id] = nil
				destroyNest(f, killer)
				return
			end
		end
	end)
	builds:SetCellCheck(function(floor: number, column: number): (boolean, string?)
		local f = features[Grid.Key(floor, column)]
		if not f then
			return true, nil
		elseif f.Kind == "Nest" then
			return false, "A nest is in that cell: destroy it first"
		elseif f.Kind == "Cache" then
			return false, "A cache is in that cell: open it first"
		end
		return false, "A cave opening is in that cell: it stays open to the Deep"
	end)
	Remotes.OnServer("MarkDig", function(player: Player, floor: number, column: number, on: boolean)
		local ok, why = DigService:Mark(floor, column, on, player)
		if not ok and why then
			Remotes.FireClient("Alert", player, "Warning", string.upper(why))
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc >= Dig.Tuning().TickSeconds then
			local elapsed = math.min(acc, 1)
			acc = 0
			local ok, err = pcall(tick, elapsed)
			if not ok then
				log:Warn("tick: %s", tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		for key, site in sites do
			if site.Diggers[player] then
				site.Diggers[player] = nil
				publishSite(key)
			end
		end
	end)
	task.defer(refreshPrompts)
	log:Info("digging ready: dig to floor %d without a vote", limit)
end

return DigService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000100"><Properties><string name="Name">DisasterService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DisasterService: fires, blackouts, cave-ins, the Reactor meltdown and electrical surges (bible
	Section 10, with Sections 5, 6 and 23). Run place only; Prompt 13. The arithmetic is
	Shared.Rules.Disasters; the numbers are Config.Disasters and Tuning.Disasters (provisional).

	* Fire: a room burns with a strength (0 to 100) that grows. Every SpreadSeconds (15; FireSpread
	  multipliers slow it) a fire strong enough spreads through a doorway to the next room. It
	  burns the room's HP, the residents in it and the players in it (Firefighters take a
	  quarter). Residents caught in it beat it down (ResidentBrain's Extinguish), an Extinguisher
	  sprays it down (WeaponService.ToolTick; the Firefighter 3x), a Foam Grenade puts out every
	  fire in its burst (WeaponService.Foamed). At 0 it is out.
	* Blackout: a floor or the whole grid goes dark (PowerService:SetBlackout) for
	  DurationSeconds (BlackoutDuration multipliers), unless someone resets the fuse box in the
	  Reactor Core first (hold Interact FuseSeconds).
	* Cave-in: rubble blocks a doorway, or fills a dug cell (a tunnel), and can trap residents
	  (Lib.Hazards blocks the passages; routes go around; residents with no way round are
	  trapped). Anyone under it is hurt. Melee smashes it (WeaponService.Swung; the Fire Axe and
	  the Sledgehammer three times as hard; a level 3 Firefighter's Fire Axe at once, Prompt 20)
	  and a Drill or a Pickaxe digs through it in one hold.
	  Digging and Tremors (Prompt 14) bring cave-ins: CaveIn(floor, column, side?).
	* The meltdown (Section 10's Reactor overload; Landon, 2026-11-08): a Reactor Core at 0 HP
	  (BunkerGrid.Wrecked), or an overclocked one (Prompt 19), starts a 60-second meltdown. Three
	  valves in the Reactor Core turned at the same time stop it; with 1 or 2 players each turned
	  valve stays turned for 10 seconds. A meltdown that runs out loses the run
	  ("ReactorDestroyed"). It also starts a fire in the Reactor Core (Section 10: Reactor
	  overloads cause fires). The Reactor stays wrecked until it is repaired.
	* Electrical surge (Section 10: random, more often in Era III; ThreatDirector rolls one a
	  day): sparks damage the machines in one room for DurationSeconds; welding the room ends it
	  (BuildService.Repaired). Left alone it may end in a fire or a blackout of its floor.
	* The Surge's one disaster (Section 5): ThreatDirector pays for it from the Surge's budget
	  (SurgeDisaster) and it starts SurgeDelaySeconds into the Surge, a fire in a random room or
	  a blackout. A Surge can't end early while its disaster, a fire or a meltdown is on
	  (HoldsSurge; Section 5).

	* Flood (Prompt 23): water in a room with a level (0 to 100). A burst pipe raises it until
	  someone patches the pipe (hold Interact); then it drains. Water high enough pours through a
	  doorway or down the Shaft every SpreadSeconds (never up), and a room it has reached rises
	  towards its source. It ruins the room, slows and hurts whoever is deep in it (the Firefighter
	  a quarter). StartFlood(room, cause, level?, pipe?); a Bloat Toad's burst and The Deluge
	  bring water without a pipe. Foam Burst drains a room at once (Drain).
	* Gas leak (Prompt 23): gas in a room with a strength (0 to 100) that fills while its vent
	  leaks, for DurationSeconds, unless someone seals the vent (hold Interact); then the room airs
	  out. It hurts everyone in it (GasImmune players not at all; the bunker's GasStrength scales
	  it). Decon Field clears a room at once (ClearGas).
	* A hazard pocket found by digging bursts gas or water into the digger's room (HazardPocket); in
	  the Crystal Hollows it opens a crystal seam that leaks radiation into it (Prompt 24).
	* Radiation leak (Prompt 24; Section 10: "Surface storms against a weak Blast Door. Floor 1 fills
	  with radiation. Seal or upgrade the door; Decon Room."). As each Surge's storm hits, from Era
	  III, it may get through the Blast Door (Rules.Disasters.DoorLeakChance: its level, its lost
	  HP). The leak has a strength (0 to 100) on every open cell of the door's floor: it fills until
	  someone seals the door (hold Interact), the door goes up a level, or DurationSeconds pass;
	  then it fades. A working Decon Room slows the fill. Players in it gain radiation (their
	  InRadiation attribute; SurfaceService keeps the meter); residents lose health, leave, and
	  from IrradiateAt are Irradiated until a Decon Room clears them (ResidentService).
	* Outbreak (Prompt 24; Section 10: "A sickness spreads between residents. Medbay treatment and
	  quarantine in Quarters."). From Era III someone who comes in from the Deep may carry it
	  (FromTheDeep: RescueService, ExpeditionService). The Sick pass it on to others in their room
	  every SpreadSeconds; a sick resident with no job keeps to a Quarters bed and passes nothing on
	  (quarantine); a working Medbay cures one patient every CureSeconds. It ends when nobody is sick.

	Disasters run while the run is playing (like monsters and residents, they go on when DevTools
	pause the cycle clock).

	Replication: the Disasters collection, id -> one of
	  { Kind = "Fire", Room, Strength, Cause }                       id "F:<room>"
	  { Kind = "Blackout", Floor?, Rooms, EndsAt, Cause }             id "B:<n>" (Floor nil: the grid)
	  { Kind = "Rubble", Shape, Floor, Column, Side?, HP, MaxHP, Cause, Edges }  id "C:<n>"
	  { Kind = "Meltdown", Room, EndsAt, Valves, Solo, Cause }        id "M:<n>"; Valves: 0 open,
	                                                                  -1 held, else turned until
	  { Kind = "Surge", Room, EndsAt, Cause }                         id "S:<room>"
	  { Kind = "Flood", Room, Level, Pipe, Cause }                    id "W:<room>"
	  { Kind = "Gas", Room, Strength, Leaking, EndsAt, Cause }        id "G:<room>"
	  { Kind = "Radiation", Floor, Room?, Door?, Units, Strength, Leaking, EndsAt, Cause }  id "R:Door" or "R:<room>"
	  { Kind = "Outbreak", Sick, Quarantined, Patient?, Cure, Treating, Cause }      id "O:<n>"
	and RunState Fires, BlackoutRooms, Rubble, Floods, GasLeaks, Meltdown, MeltdownEndsAt, ValvesTurned.
	workspace.Bunker.Disasters holds the fuse box and valve prompts, the rubble, burst pipes
	("Pipe:<room>") and leaking vents ("GasVent:<room>"). Players in water or gas carry the Wading
	and InGas attributes (the level or strength where they stand).

	API:
		DisasterService:StartFire(roomId, cause, strength?): string?
		DisasterService:Extinguish(roomId, amount, how, player?): boolean   -- true when it went out
		DisasterService:StartBlackout(floor?, cause): string?             -- floor nil: the whole grid
		DisasterService:EndBlackout(how, player?)
		DisasterService:CaveIn(floor, column, side?, cause): (string?, string?) -- side "Left"/"Right": a doorway
		DisasterService:ClearRubble(id, how, player?)
		DisasterService:StartMeltdown(cause): boolean
		DisasterService:StartElectricalSurge(roomId, cause): string?
		DisasterService:StartFlood(roomId, cause, level?, pipe?): string?  -- pipe false: no burst pipe
		DisasterService:PatchPipe(roomId, how, player?): boolean
		DisasterService:Drain(roomId, how, player?): boolean               -- at once (Foam Burst)
		DisasterService:Flooded(roomId): number?
		DisasterService:StartGasLeak(roomId, cause, strength?): string?
		DisasterService:SealVent(roomId, how, player?): boolean
		DisasterService:ClearGas(roomId, how, player?): boolean            -- at once (Decon Field)
		DisasterService:Gassed(roomId): number?
		DisasterService:HazardPocket(floor, column, player?): string?      -- "Flood", "GasLeak", "RadiationLeak" or nil
		DisasterService:StartRadiationLeak(cause, roomId?, strength?): string? -- roomId nil: the Blast Door's, its whole floor
		DisasterService:SealLeak(id, how, player?): boolean
		DisasterService:ClearRadiation(roomId, how, player?): boolean       -- at once (Decon Field)
		DisasterService:Irradiated(unit): number?
		DisasterService:StartOutbreak(cause, residentId?): string?
		DisasterService:FromTheDeep(residentId, why): boolean               -- rolls for a carrier
		DisasterService:Cure(residentId, how, player?): boolean
		DisasterService:SurgeDisaster(budget, rng): number   -- ThreatDirector: the ThreatCost spent
		DisasterService:HoldsSurge(): boolean                -- ThreatDirector: don't end the Surge yet
		DisasterService:SetModifier(source, key, value?)     -- FireSpread, BlackoutDuration
		DisasterService:Active(): { [string]: any }          -- the collection's entries
		DisasterService.Started: Signal<string, string>      -- id, kind
		DisasterService.Ended: Signal<string, string, string> -- id, kind, how
	Dev: disasters, fire, fire.out, blackout, blackout.end, cavein, rubble.clear, meltdown,
	meltdown.stop, valve, esurge, disaster.surge, flood, flood.patch, flood.drain, gas, gas.seal,
	gas.clear, pocket, leak, leak.storm, leak.seal, leak.clear, outbreak, outbreak.cure, outbreak.deep.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Rules.Combat)
local Config = require(Shared.Config)
local Disasters = require(Shared.Rules.Disasters)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local ResidentRules = require(Shared.Rules.Residents)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)
local Hazards = require(ServerScriptService.Lib.Hazards)

local log = Log.new("DisasterService")

local DisasterService = {
	Name = "DisasterService",
	Dependencies = {
		"BunkerGrid", "PowerService", "CycleClock", "RunDirector", "CombatService", "WeaponService",
		"ResidentService", "BuildService", "SessionService", "ReplicationService", "DevService",
	},
	Started = Signal.new() :: Signal.Signal<string, string>,
	Ended = Signal.new() :: Signal.Signal<string, string, string>,
}

local CAMERA_FADE_TAG = BunkerKit.CAMERA_FADE_TAG
local CAMERA_IGNORE_TAG = "CameraIgnore"
local ROCK = Color3.fromRGB(104, 92, 78)
local ROCK_DARK = Color3.fromRGB(72, 64, 56)
local TIMBER = Color3.fromRGB(118, 94, 72)

type Fire = { Id: string, Room: string, Strength: number, NextSpread: number, Carry: number, Cause: string, Sent: number }
type Blackout = { Id: string, Floor: number?, Units: { [string]: boolean }, EndsAt: number, Cause: string }
type Rubble = {
	Id: string,
	Shape: Disasters.Shape,
	Floor: number,
	Column: number,
	Side: string?,
	HP: number,
	MaxHP: number,
	Cause: string,
	Model: Model?,
	Points: { Vector3 }, -- where melee can hit it (each blocked face)
	Height: number,
	Edges: { { string } },
}
type Meltdown = { Id: string, Room: string, EndsAt: number, Valves: { number }, Cause: string, Sent: string }
type Surge = { Id: string, Room: string, EndsAt: number, Carry: number, Cause: string }
type Flood = {
	Id: string, Room: string, Level: number, Pipe: boolean, NextSpread: number, Carry: number, Cause: string,
	Sent: number, SentPipe: boolean, Prop: Instance?,
}
type Gas = {
	Id: string, Room: string, Strength: number, Leaking: boolean, EndsAt: number, Cause: string,
	Sent: number, SentLeaking: boolean, Prop: Instance?,
}
-- A radiation leak (Prompt 24): the Blast Door's fills its floor (Room nil), a hazard pocket's one room.
type Leak = {
	Id: string, Floor: number, Room: string?, Strength: number, Leaking: boolean, EndsAt: number, Cause: string,
	Sent: number, SentLeaking: boolean, Prop: Instance?, Units: { [string]: boolean }, DoorLevel: number?,
	Door: string?, -- the Blast Door's room, for a door leak (the Command View blinks it)
}
type Outbreak = {
	Id: string, Cause: string, NextSpread: number, Cure: number, Patient: string?, Immune: { [string]: boolean }, Sent: string,
}

local grid: any = nil
local power: any = nil
local clock: any = nil
local director: any = nil
local combat: any = nil
local weapons: any = nil
local residents: any = nil
local builds: any = nil
local session: any = nil
local collection: any = nil
local set: (string, any) -> () = function() end

local rng = Random.new()
local fires: { [string]: Fire } = {} -- by room id
local blackout: Blackout? = nil
local rubble: { [string]: Rubble } = {}
local meltdown: Meltdown? = nil
local surges: { [string]: Surge } = {} -- by room id
local floods: { [string]: Flood } = {} -- by room id (Prompt 23)
local gases: { [string]: Gas } = {} -- by room id (Prompt 23)
local leaks: { [string]: Leak } = {} -- radiation, by id: "R:Door" or "R:<room>" (Prompt 24)
local outbreak: Outbreak? = nil -- Prompt 24
local surgeDisaster: { Kind: string, Id: string?, Cycle: number }? = nil
local modifiers: { [string]: { [string]: number } } = {} -- key -> source -> value
local counter = 0
local folder: Folder? = nil
local fuseBox: BasePart? = nil
local valveParts: { BasePart } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function nextId(prefix: string): string
	counter += 1
	return `{prefix}:{counter}`
end

local function roomName(roomType: string): string
	local info = Config.Find("Rooms", roomType)
	return if info then string.upper(info.Name) else string.upper(roomType)
end

local function nameOf(roomId: string): string
	local room = grid:Room(roomId)
	return if room then `THE {roomName(room.Type)}` else "A ROOM"
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function playerCount(): number
	return math.max(#session:ReadyPlayers(), 1)
end

local function modifierValue(key: string): number
	local value = 1
	for _, v in modifiers[key] or {} do
		value *= v
	end
	return value
end

local function unitAt(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

local function holder(): Folder?
	if folder and folder.Parent then
		return folder
	end
	local root = grid:Root()
	if not root then
		return nil
	end
	local found = root:FindFirstChild("Disasters")
	if not found then
		found = Instance.new("Folder")
		found.Name = "Disasters"
		found.Parent = root
	end
	folder = found :: Folder
	return folder
end

-- The living players and residents in each unit.
local function occupants(): { [string]: { any } }
	local by: { [string]: { any } } = {}
	for _, c in combat:All("Survivors") do
		if c.State == "Alive" and c.Root.Parent then
			local unit = unitAt(c.Root.Position)
			if unit then
				by[unit] = by[unit] or {}
				table.insert(by[unit], c)
			end
		end
	end
	return by
end

-- Replication -----------------------------------------------------------------------------------------

local function publishCounts()
	local fireCount, rubbleCount, floodCount, gasCount = 0, 0, 0, 0
	for _ in fires do
		fireCount += 1
	end
	for _ in floods do
		floodCount += 1
	end
	for _ in gases do
		gasCount += 1
	end
	for _ in rubble do
		rubbleCount += 1
	end
	local dark = 0
	if blackout then
		for unit in blackout.Units do
			if grid:Room(unit) then
				dark += 1
			end
		end
	end
	set("Fires", fireCount)
	set("Rubble", rubbleCount)
	set("Floods", floodCount)
	set("GasLeaks", gasCount)
	local leakCount, sick = 0, 0
	for _ in leaks do
		leakCount += 1
	end
	if outbreak then
		for _, resident in residents:All() do
			if resident.Sick and resident.State ~= "Dead" then
				sick += 1
			end
		end
	end
	set("RadiationLeaks", leakCount)
	set("Sick", sick)
	set("BlackoutRooms", dark)
	set("Meltdown", if meltdown then true else nil)
	set("MeltdownEndsAt", if meltdown then meltdown.EndsAt else nil)
	set("ValvesTurned", if meltdown then Disasters.ValvesOn(meltdown.Valves, now()) else nil)
end

local function publishFire(fire: Fire)
	fire.Sent = math.ceil(fire.Strength)
	collection:Set(fire.Id, { Kind = "Fire", Room = fire.Room, Strength = fire.Sent, Cause = fire.Cause })
end

local function publishRubble(r: Rubble)
	local edges = {}
	for _, edge in r.Edges do
		table.insert(edges, `{edge[1]}|{edge[2]}`)
	end
	collection:Set(r.Id, {
		Kind = "Rubble", Shape = r.Shape, Floor = r.Floor, Column = r.Column, Side = r.Side,
		HP = math.ceil(r.HP), MaxHP = r.MaxHP, Cause = r.Cause, Edges = edges,
	})
end

local function valveStates(m: Meltdown): { number }
	local t = now()
	local list = {}
	for i, value in m.Valves do
		list[i] = if value == Disasters.HELD then Disasters.HELD elseif value > t then value else 0
	end
	return list
end

local function publishMeltdown(m: Meltdown)
	local valves = valveStates(m)
	local key = table.concat(valves, ",")
	if key == m.Sent then
		return
	end
	m.Sent = key
	collection:Set(m.Id, {
		Kind = "Meltdown", Room = m.Room, EndsAt = m.EndsAt, Valves = valves,
		Solo = playerCount() <= Disasters.Tuning().Meltdown.SoloPlayers, Cause = m.Cause,
	})
end

-- Fire --------------------------------------------------------------------------------------------------

function DisasterService:StartFire(roomId: string, cause: string, strength: number?): string?
	local room = grid:Room(roomId)
	if not room or not Disasters.Burns(room.Type) or fires[roomId] then
		return nil
	end
	local fire: Fire = {
		Id = `F:{roomId}`,
		Room = roomId,
		Strength = strength or Disasters.Tuning().Fire.StartStrength,
		NextSpread = now() + Disasters.SpreadSeconds(modifierValue("FireSpread")),
		Carry = 0,
		Cause = cause,
		Sent = -1,
	}
	fires[roomId] = fire
	Hazards.SetFire(roomId, fire.Strength)
	publishFire(fire)
	publishCounts()
	log:Info("fire in %s (%s): %s", roomId, room.Type, cause)
	announce("Danger", if cause == "Spread" then `THE FIRE SPREADS TO {nameOf(roomId)}`
		else `FIRE IN {nameOf(roomId)}: PUT IT OUT BEFORE IT SPREADS`)
	DisasterService.Started:Fire(fire.Id, "Fire")
	return fire.Id
end

local function putOut(fire: Fire, how: string, player: Player?)
	if fires[fire.Room] ~= fire then
		return
	end
	fires[fire.Room] = nil
	Hazards.SetFire(fire.Room, nil)
	collection:Remove(fire.Id)
	publishCounts()
	log:Info("fire in %s out (%s%s)", fire.Room, how, if player then `, {player.Name}` else "")
	if how ~= "Gone" then
		announce("Info", `FIRE OUT IN {nameOf(fire.Room)}{if player then ` · {string.upper(player.DisplayName)}` else ""}`)
	end
	DisasterService.Ended:Fire(fire.Id, "Fire", how)
end

-- Puts `amount` of strength out of a room's fire. Returns true when it went out.
function DisasterService:Extinguish(roomId: string, amount: number, how: string, player: Player?): boolean
	local fire = fires[roomId]
	if not fire or amount <= 0 then
		return false
	end
	fire.Strength -= amount
	if fire.Strength <= 0 then
		putOut(fire, how, player)
		return true
	end
	Hazards.SetFire(roomId, fire.Strength)
	if math.ceil(fire.Strength) ~= fire.Sent then
		publishFire(fire)
	end
	return false
end

local function tickFires(dt: number, t: number, inside: { [string]: { any } })
	for roomId, fire in table.clone(fires) do
		local room = grid:Room(roomId)
		if not room then
			putOut(fire, "Gone")
			continue
		end
		local people = inside[roomId] or {}
		local fighters = 0
		for _, c in people do
			if c.Kind == "Resident" and c.Model:GetAttribute("Activity") == "Extinguish" then
				-- Prompt 26: the Firefighter trait "Puts out fires 3x faster"
				local person = if c.ResidentId then residents:Get(c.ResidentId) else nil
				fighters += if person then ResidentRules.Trait(person, "ExtinguishSpeed") or 1 else 1
			end
		end
		fire.Strength = Disasters.FireStep(fire.Strength, dt, fighters, 0)
		if fire.Strength <= 0 then
			putOut(fire, "Residents")
			continue
		end
		-- the room burns
		fire.Carry += Disasters.FireRoomDamage(fire.Strength, dt)
		if fire.Carry >= 1 and room.HP > 0 then
			local whole = math.floor(fire.Carry)
			fire.Carry -= whole
			grid:SetHP(roomId, room.HP - whole)
		end
		-- and so does everyone in it (Section 10: residents; the Firefighter's passive says players too)
		for _, c in people do
			if c.Kind == "Resident" then
				combat:Damage(c.Id, Disasters.FireResidentDamage(fire.Strength, dt), nil, "fire")
			elseif c.Kind == "Player" and c.Player then
				local taken = Modifiers.PlayerValue(c.Player, "FireFloodDamageTaken") or 1
				combat:Damage(c.Id, Disasters.FirePlayerDamage(fire.Strength, dt, taken), nil, "fire")
			end
		end
		-- it spreads to the next room (Section 10: every 15 seconds)
		if t >= fire.NextSpread then
			fire.NextSpread = t + Disasters.SpreadSeconds(modifierValue("FireSpread"))
			if Disasters.CanSpread(fire.Strength) then
				local targets = Disasters.SpreadTargets(grid:Bunker(), roomId, fires)
				if #targets > 0 then
					DisasterService:StartFire(targets[rng:NextInteger(1, #targets)], "Spread")
				end
			end
		end
		Hazards.SetFire(roomId, fire.Strength)
		if math.ceil(fire.Strength) ~= fire.Sent then
			publishFire(fire)
		end
	end
end

-- The Extinguisher: the first burning room along the player's facing within reach.
local function onToolTick(player: Player, tool: string, at: CFrame, dt: number)
	if tool ~= "Extinguisher" then
		return
	end
	local f = Disasters.Tuning().Fire
	local target: string? = nil
	for _, d in { 0, 4, 8, 12, f.ExtinguisherReach } do
		local unit = unitAt(at.Position + at.LookVector * d)
		if unit and fires[unit] then
			target = unit
			break
		end
	end
	player:SetAttribute("Spraying", target or "")
	if target then
		local speed = Modifiers.PlayerValue(player, "ExtinguishSpeed") or 1
		DisasterService:Extinguish(target, f.ExtinguisherPerSecond * speed * dt, "Extinguisher", player)
	end
end

-- A Foam Grenade puts out every fire whose room its burst reaches.
local function onFoamed(at: Vector3, radius: number, player: Player)
	local t = Grid.Tuning()
	for roomId, fire in table.clone(fires) do
		local room = grid:Room(roomId)
		if room then
			for offset = 0, room.Span - 1 do
				local cell = Grid.CellPosition(room.Floor, room.Column + offset)
				local low = cell - Vector3.new(t.CellWidth / 2, 0, t.CellDepth / 2)
				local high = cell + Vector3.new(t.CellWidth / 2, t.CellHeight, t.CellDepth / 2)
				local nearest = Vector3.new(math.clamp(at.X, low.X, high.X), math.clamp(at.Y, low.Y, high.Y), math.clamp(at.Z, low.Z, high.Z))
				if (nearest - at).Magnitude <= radius then
					putOut(fire, "Foam", player)
					break
				end
			end
		end
	end
end

-- Blackouts ---------------------------------------------------------------------------------------------

local function fusePosition(): Vector3?
	local reactor = grid:RoomsOfType("ReactorCore")[1]
	if not reactor then
		return nil
	end
	local model = grid:RoomModel(reactor.Id)
	local socket = if model then BunkerKit.Socket(model, "FuseBox") else nil
	if socket then
		return socket.Position + Vector3.new(0, 4, 0)
	end
	return Grid.CellPosition(reactor.Floor, reactor.Column) + Vector3.new(-12, 4, -6)
end

-- A crystal seam splits the back wall where nothing stands in front of it: the first clear stretch
-- of a few, low ones first, then above the furniture, then under the ceiling (Prompt 24's
-- playtests: the first seam grew behind the Medbay's cabinet and the second behind the Kitchen's
-- stove, where nobody could see them). Walls, floors and long runs of pipe are as wide as the
-- cell and don't count.
local SEAM_SIZE = Vector3.new(5.6, 5.2, 1.6)
local SEAM_VIEW = 5 -- studs in front of the wall that must be clear, so nothing hides it
local function wallClear(model: Instance, centre: Vector3, size: Vector3, widest: number): boolean
	local half = size / 2
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Transparency < 1 and math.max(d.Size.X, d.Size.Z) < widest then
			local cf = d.CFrame
			local s = d.Size / 2
			local ex = math.abs(cf.RightVector.X) * s.X + math.abs(cf.UpVector.X) * s.Y + math.abs(cf.LookVector.X) * s.Z
			local ey = math.abs(cf.RightVector.Y) * s.X + math.abs(cf.UpVector.Y) * s.Y + math.abs(cf.LookVector.Y) * s.Z
			local ez = math.abs(cf.RightVector.Z) * s.X + math.abs(cf.UpVector.Z) * s.Y + math.abs(cf.LookVector.Z) * s.Z
			local o = cf.Position - centre
			if math.abs(o.X) < ex + half.X and math.abs(o.Y) < ey + half.Y and math.abs(o.Z) < ez + half.Z then
				return false
			end
		end
	end
	return true
end

local function seamSpot(room: any): CFrame
	local g = Grid.Tuning()
	local model = grid:RoomModel(room.Id)
	local back = -(g.CellDepth / 2 - 0.8)
	-- from the wall's face (posters and vent grilles count: a seam through one is a muddle) out into the room
	local view = Vector3.new(SEAM_SIZE.X, SEAM_SIZE.Y, SEAM_VIEW + 0.8)
	local last: CFrame? = nil
	for _, height in { 3, g.CellHeight * 0.6, g.CellHeight * 0.735 } do
		for span = 0, (room.Span or 1) - 1 do
			local cell = Grid.CellPosition(room.Floor, room.Column + span)
			for _, x in { -0.25, 0.25, 0, -0.38, 0.38, -0.12, 0.12 } do
				local at = cell + Vector3.new(g.CellWidth * x, height, back)
				if not model or wallClear(model, at + Vector3.new(0, 0, (SEAM_VIEW - 0.8) / 2), view, g.CellWidth * 0.8) then
					return CFrame.new(at)
				end
				if x == -0.25 and span == 0 then
					last = CFrame.new(at) -- nothing clear anywhere: under the ceiling, where the least stands
				end
			end
		end
	end
	return last :: CFrame
end

-- The door's seal clamps the jamb, this far along the wall from the door's middle: the lift's own
-- prompt (RIDE UP) is at the middle, and of two prompts on one key Roblox shows the one nearer the
-- middle of the screen, so a seal there could not be reached (Prompt 24's playtest).
local DOOR_SEAL_SIDE = 8

local function promptPart(name: string, position: Vector3): BasePart?
	local parent = holder()
	if not parent then
		return nil
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.Position = position
	CollectionService:AddTag(part, CAMERA_IGNORE_TAG)
	part.Parent = parent
	return part
end

local function prompt(part: BasePart, kind: string, action: string, object: string, hold: number, distance: number): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold
	p.MaxActivationDistance = distance
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Custom -- drawn by PromptController (Prompt 11)
	p:SetAttribute("Kind", kind)
	p.Parent = part
	return p
end

function DisasterService:EndBlackout(how: string, player: Player?)
	local current = blackout
	if not current then
		return
	end
	blackout = nil
	power:SetBlackout(nil)
	if fuseBox then
		fuseBox:Destroy()
		fuseBox = nil
	end
	collection:Remove(current.Id)
	publishCounts()
	log:Info("blackout %s over (%s)", current.Id, how)
	if how == "Fixed" then
		announce("Info", `FUSE BOX RESET{if player then ` BY {string.upper(player.DisplayName)}` else ""}: THE LIGHTS ARE BACK`)
	elseif how == "Expired" then
		announce("Info", "THE BLACKOUT IS OVER: THE LIGHTS ARE BACK")
	end
	DisasterService.Ended:Fire(current.Id, "Blackout", how)
end

function DisasterService:StartBlackout(floor: number?, cause: string): string?
	local units = Disasters.BlackoutUnits(grid:Bunker(), floor)
	if next(units) == nil then
		return nil
	end
	if blackout then
		DisasterService:EndBlackout("Replaced")
	end
	local id = nextId("B")
	local current: Blackout = {
		Id = id,
		Floor = floor,
		Units = units,
		EndsAt = now() + Disasters.BlackoutSeconds(modifierValue("BlackoutDuration")),
		Cause = cause,
	}
	blackout = current
	power:SetBlackout(units)
	local at = fusePosition()
	if at then
		local part = promptPart("FuseBox", at)
		if part then
			local p = prompt(part, "FuseBox", "Reset fuse box", "Reactor Core", Disasters.Tuning().FuseSeconds, 8)
			p.Triggered:Connect(function(player: Player)
				if blackout == current then
					DisasterService:EndBlackout("Fixed", player)
				end
			end)
			fuseBox = part
		end
	end
	local rooms = {}
	for unit in units do
		if grid:Room(unit) then
			table.insert(rooms, unit)
		end
	end
	table.sort(rooms)
	collection:Set(id, { Kind = "Blackout", Floor = floor, Rooms = rooms, EndsAt = current.EndsAt, Cause = cause })
	publishCounts()
	log:Info("blackout %s: %s (%s)", id, if floor then `floor {floor}` else "the whole grid", cause)
	announce("Danger", `BLACKOUT: {if floor then `FLOOR {floor} IS` else "THE WHOLE BUNKER IS"} DARK · RESET THE FUSE BOX IN THE REACTOR CORE`)
	DisasterService.Started:Fire(id, "Blackout")
	return id
end

-- Cave-ins ----------------------------------------------------------------------------------------------

local function art(name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local kit = assets and assets:FindFirstChild("Kit")
	local found = kit and kit:FindFirstChild(name)
	return if found and found:IsA("Model") then found else nil
end

-- Where rubble stands: for each blocked face, its centre, its size (thickness, height, width) and
-- the side a digger stands on.
type Face = { Centre: Vector3, Size: Vector3 }

local function facesOf(r: Rubble): { Face }
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local cell = Grid.CellPosition(r.Floor, r.Column)
	local faces: { Face } = {}
	if r.Shape == "Tunnel" then
		for _, dir in { -1, 1 } do
			table.insert(faces, {
				Centre = Vector3.new(cell.X + dir * pitch.X / 2, cell.Y + t.CellHeight / 2, cell.Z),
				Size = Vector3.new(2, t.CellHeight, t.CellDepth),
			})
		end
		return faces
	end
	local otherColumn = if r.Side == "Left" then r.Column - 1 else r.Column + 1
	local bunker = grid:Bunker()
	local roomSide = bunker:RoomAt(r.Floor, r.Column) ~= nil or bunker:RoomAt(r.Floor, otherColumn) ~= nil
	local wallX = (cell.X + Grid.CellPosition(r.Floor, otherColumn).X) / 2
	-- a room's side wall has the 8 x 10 doorway (the kit's); between two dug cells it is open rock
	local width = if roomSide then 8 else t.CellDepth
	local height = if roomSide then 10 else t.CellHeight
	table.insert(faces, { Centre = Vector3.new(wallX, cell.Y + height / 2, cell.Z), Size = Vector3.new(2, height, width) })
	return faces
end

-- A graybox pile: rocks and a broken timber across the face, sitting on the floor.
local function grayboxPile(parent: Model, face: Face, seed: number)
	local local_rng = Random.new(seed)
	local base = face.Centre - Vector3.new(0, face.Size.Y / 2, 0)
	local count = math.clamp(math.floor(face.Size.Z / 2.2), 4, 14)
	for i = 1, count do
		local rock = Instance.new("Part")
		rock.Name = "Rock"
		local s = local_rng:NextNumber(1.8, 3.6)
		rock.Size = Vector3.new(s * local_rng:NextNumber(0.9, 1.6), s * local_rng:NextNumber(0.7, 1.1), s * local_rng:NextNumber(0.9, 1.4))
		local z = -face.Size.Z / 2 + (i - 0.5) * face.Size.Z / count + local_rng:NextNumber(-0.6, 0.6)
		local pileHeight = face.Size.Y * 0.75 * (1 - math.abs(z) / (face.Size.Z / 2 + 2))
		local y = local_rng:NextNumber(0.3, math.max(pileHeight, 1))
		rock.CFrame = CFrame.new(base + Vector3.new(local_rng:NextNumber(-1.8, 1.8), y, z))
			* CFrame.Angles(local_rng:NextNumber(-0.6, 0.6), local_rng:NextNumber(0, math.pi), local_rng:NextNumber(-0.6, 0.6))
		rock.Material = Enum.Material.Slate
		rock.Color = if i % 3 == 0 then ROCK_DARK else ROCK
		rock.Parent = parent
	end
	local beam = Instance.new("Part")
	beam.Name = "Timber"
	beam.Size = Vector3.new(0.9, 0.9, math.min(face.Size.Z * 0.9, 12))
	beam.CFrame = CFrame.new(base + Vector3.new(0.4, face.Size.Y * 0.35, 0.5)) * CFrame.Angles(0.5, 0.15, 0)
	beam.Material = Enum.Material.Wood
	beam.Color = TIMBER
	beam.Parent = parent
end

local function buildRubble(r: Rubble): Model?
	local parent = holder()
	if not parent then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = r.Id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model:SetAttribute("Shape", r.Shape)
	model:SetAttribute("HP", r.HP)
	model:SetAttribute("MaxHP", r.MaxHP)
	local faces = facesOf(r)
	local pile = Instance.new("Model")
	pile.Name = "Pile"
	pile.Parent = model
	for i, face in faces do
		-- the invisible block: nothing walks through until it is cleared
		local block = Instance.new("Part")
		block.Name = "Block"
		block.Anchored = true
		block.CanCollide = true
		block.CanQuery = false
		block.CanTouch = false
		block.CastShadow = false
		block.Transparency = 1
		block.Size = face.Size
		block.CFrame = CFrame.new(face.Centre)
		CollectionService:AddTag(block, CAMERA_IGNORE_TAG)
		block.Parent = model
		-- what you see: the art kit's pile, or a graybox one. A room's 8-wide doorway gets the
		-- doorway pile; a tunnel's ends and the open rock between two dug cells (32 wide) get the
		-- tunnel's rockfall.
		local source = art(if face.Size.Z > 12 then "Kit_Rubble_Tunnel" else "Kit_Rubble_Doorway")
		local floorAt = face.Centre - Vector3.new(0, face.Size.Y / 2, 0)
		if source then
			local copy = source:Clone()
			copy.Name = `Pile{i}`
			-- a filled tunnel: each pile sits inside the tunnel cell, its outer toe at the cell's
			-- end, so nothing spills into the room or the cell next door (a doorway's pile spills
			-- into both sides, as rubble through a doorway would)
			local at = floorAt
			if r.Shape == "Tunnel" then
				local inward = math.sign(Grid.CellPosition(r.Floor, r.Column).X - face.Centre.X)
				at += Vector3.new(inward * source:GetExtentsSize().Z / 2, 0, 0)
			end
			-- art faces -Z with its width along X: turn it to lie across the wall line
			copy:PivotTo(CFrame.new(at) * CFrame.Angles(0, math.pi / 2, 0))
			copy.Parent = pile
		else
			local group = Instance.new("Model")
			group.Name = `Pile{i}`
			group.Parent = pile
			grayboxPile(group, face, r.Floor * 100 + r.Column * 7 + i)
		end
		-- the dig prompt (a Drill or a Pickaxe), on the face at chest height, from either side
		local spot = promptPart(`Dig{i}`, Vector3.new(face.Centre.X, floorAt.Y + 3.5, face.Centre.Z + math.min(face.Size.Z / 2 - 1, 4)))
		if spot then
			spot.Parent = model
			local p = prompt(spot, "DigRubble", "Dig through", "Rubble · Drill or Pickaxe",
				Disasters.DigSeconds(r.Shape), 9)
			p:SetAttribute("Rubble", r.Id)
			p.Triggered:Connect(function(player: Player)
				if rubble[r.Id] ~= r then
					return
				end
				if Disasters.CanDig(weapons:Items(player)) then
					DisasterService:ClearRubble(r.Id, "Dug", player)
				else
					Remotes.FireClient("Alert", player, "Warning", "DIGGING NEEDS A DRILL OR A PICKAXE: SMASH IT WITH A MELEE WEAPON")
				end
			end)
		end
	end
	for _, part in pile:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			CollectionService:AddTag(part, CAMERA_FADE_TAG)
		end
	end
	local _, size = pile:GetBoundingBox()
	r.Height = size.Y
	model.Parent = parent
	return model
end

-- The pile sinks as it is broken up (readable from across a room), then goes.
local function showDamage(r: Rubble)
	local model = r.Model
	local pile = model and model:FindFirstChild("Pile")
	if not model or not pile or not pile:IsA("Model") then
		return
	end
	model:SetAttribute("HP", math.ceil(r.HP))
	local base = pile:GetAttribute("BaseCFrame")
	if typeof(base) ~= "CFrame" then
		base = pile:GetPivot()
		pile:SetAttribute("BaseCFrame", base)
	end
	local sink = (1 - math.clamp(r.HP / r.MaxHP, 0, 1)) * r.Height * 0.55
	pile:PivotTo((base :: CFrame) - Vector3.new(0, sink, 0))
end

local function blockEdges(r: Rubble)
	Hazards.Unblock(r.Id)
	r.Edges = Disasters.RubbleEdges(grid:Bunker(), r.Shape, r.Floor, r.Column, r.Side)
	for _, edge in r.Edges do
		Hazards.Block(edge[1], edge[2], r.Id)
	end
end

function DisasterService:ClearRubble(id: string, how: string, player: Player?)
	local r = rubble[id]
	if not r then
		return
	end
	rubble[id] = nil
	Hazards.Unblock(id)
	if r.Model then
		r.Model:Destroy()
	end
	collection:Remove(id)
	publishCounts()
	log:Info("rubble %s cleared (%s%s)", id, how, if player then `, {player.Name}` else "")
	announce("Info", `THE WAY IS CLEAR{if player then ` · {string.upper(player.DisplayName)} ` .. (if how == "Dug" then "DUG THROUGH" else "SMASHED THROUGH") else ""}`)
	DisasterService.Ended:Fire(id, "Rubble", how)
end

-- Hurts whoever the rubble falls on (Section 10) and moves players out of the block.
local function fallOn(r: Rubble)
	local damage = Disasters.Tuning().CaveIn.Damage
	local tunnel = if r.Shape == "Tunnel" then grid:Bunker():UnitAt(r.Floor, r.Column) else nil
	for _, c in combat:All("Survivors") do
		if c.State == "Alive" and c.Root.Parent then
			local position = c.Root.Position
			local under = tunnel ~= nil and unitAt(position) == tunnel
			for _, face in facesOf(r) do
				local offset = position - face.Centre
				local inBlock = math.abs(offset.X) <= face.Size.X / 2 + 1 and math.abs(offset.Z) <= face.Size.Z / 2
					and math.abs(offset.Y) <= face.Size.Y / 2 + 3
				if inBlock then
					under = true
					if c.Kind == "Player" then
						-- step out of the block, on the side they stood
						local dir = if offset.X >= 0 then 1 else -1
						c.Root.CFrame = c.Root.CFrame + Vector3.new(dir * (face.Size.X / 2 + 2.5 - math.abs(offset.X)), 0, 0)
					end
				end
			end
			if under then
				combat:Damage(c.Id, damage, nil, "cave-in")
			end
		end
	end
end

function DisasterService:CaveIn(floor: number, column: number, side: string?, cause: string): (string?, string?)
	local shape: Disasters.Shape = if side then "Doorway" else "Tunnel"
	if side and side ~= "Left" and side ~= "Right" then
		return nil, "side must be Left or Right"
	end
	local edges = Disasters.RubbleEdges(grid:Bunker(), shape, floor, column, side)
	if #edges == 0 then
		return nil, if shape == "Tunnel" then "only a dug cell with a way into it can cave in" else "there is no doorway there"
	end
	for _, other in rubble do
		for _, edge in other.Edges do
			for _, new in edges do
				if Hazards.EdgeKey(edge[1], edge[2]) == Hazards.EdgeKey(new[1], new[2]) then
					return nil, "rubble already blocks it"
				end
			end
		end
	end
	local id = nextId("C")
	local hp = Disasters.RubbleHP(shape)
	local r: Rubble = {
		Id = id, Shape = shape, Floor = floor, Column = column, Side = side, HP = hp, MaxHP = hp,
		Cause = cause, Model = nil, Points = {}, Height = 6, Edges = edges,
	}
	for _, face in facesOf(r) do
		table.insert(r.Points, face.Centre)
	end
	rubble[id] = r
	blockEdges(r)
	r.Model = buildRubble(r)
	fallOn(r)
	publishRubble(r)
	publishCounts()
	local here = grid:Bunker():UnitAt(floor, column)
	local hereRoom = if here then grid:Room(here) else nil
	local where = if hereRoom then nameOf(hereRoom.Id) else `THE TUNNEL ON FLOOR {floor}`
	log:Info("cave-in %s: %s at %d,%d%s (%s)", id, shape, floor, column, if side then ` {side}` else "", cause)
	announce("Danger", `CAVE-IN: RUBBLE BLOCKS {if shape == "Tunnel" then where else `A DOORWAY OF {where}`} · DIG OR SMASH THROUGH IT`)
	DisasterService.Started:Fire(id, "Rubble")
	return id, nil
end

-- A melee swing landing: the first rubble in its arc takes the hit.
local function onSwung(player: Player, at: CFrame, reach: number, arc: number, damage: number, item: string, _heavy: boolean)
	for id, r in table.clone(rubble) do
		for _, point in r.Points do
			if Combat.InArc(at, point, reach, arc, 4) then
				r.HP -= Disasters.RubbleDamage(item, damage)
				-- the Firefighter's level 3: the Fire Axe clears rubble at once (Prompt 20)
				if item == "FireAxe" and Modifiers.PlayerValue(player, "RubbleClearInstant") then
					r.HP = 0
				end
				if r.HP <= 0 then
					DisasterService:ClearRubble(id, "Smashed", player)
				else
					showDamage(r)
					publishRubble(r)
				end
				return
			end
		end
	end
end

-- The meltdown ------------------------------------------------------------------------------------------

local function valvePositions(roomId: string): { Vector3 }
	local room = grid:Room(roomId)
	local model = grid:RoomModel(roomId)
	local list = {}
	if model then
		for i = 1, 3 do
			local socket = BunkerKit.Socket(model, `Valve{i}`)
			if socket then
				table.insert(list, socket.Position + Vector3.new(0, 3.5, 0))
			end
		end
	end
	if #list < 3 and room then
		table.clear(list)
		local cell = Grid.CellPosition(room.Floor, room.Column)
		for _, offset in { Vector3.new(-12, 3.5, -10), Vector3.new(12, 3.5, -10), Vector3.new(0, 3.5, -1.5) } do
			table.insert(list, cell + offset)
		end
	end
	return list
end

local function clearValves()
	for _, part in valveParts do
		part:Destroy()
	end
	table.clear(valveParts)
end

local function endMeltdown(how: string)
	local m = meltdown
	if not m then
		return
	end
	meltdown = nil
	clearValves()
	collection:Remove(m.Id)
	publishCounts()
	log:Info("meltdown %s over (%s)", m.Id, how)
	if how == "Fixed" then
		local room = grid:Room(m.Room)
		announce("Info", if room and room.Wrecked then "THE REACTOR IS STABLE · REPAIR IT TO GET ITS POWER BACK"
			else "THE REACTOR IS STABLE")
	elseif how == "Lost" then
		announce("Danger", "THE REACTOR CORE MELTED DOWN")
	end
	DisasterService.Ended:Fire(m.Id, "Meltdown", how)
end

function DisasterService:StartMeltdown(cause: string): boolean
	if meltdown or director:Phase() ~= "Playing" then
		return false
	end
	local reactor = grid:RoomsOfType("ReactorCore")[1]
	if not reactor then
		return false
	end
	local seconds = Config.Get("Disasters", "ReactorOverload").TimerSeconds or 60
	local m: Meltdown = { Id = nextId("M"), Room = reactor.Id, EndsAt = now() + seconds, Valves = { 0, 0, 0 }, Cause = cause, Sent = "" }
	meltdown = m
	clearValves()
	for i, position in valvePositions(reactor.Id) do
		local part = promptPart(`Valve{i}`, position)
		if part then
			part:SetAttribute("Valve", i)
			local p = prompt(part, "Valve", "Turn valve", `Valve {i}`, Disasters.Tuning().ValveSeconds, 7)
			p.Triggered:Connect(function(player: Player)
				if meltdown == m then
					m.Valves[i] = Disasters.ValveTurned(playerCount(), now())
					log:Info("%s turned valve %d", player.Name, i)
					publishMeltdown(m)
				end
			end)
			p.TriggerEnded:Connect(function(_player: Player)
				if meltdown == m then
					m.Valves[i] = Disasters.ValveReleased(m.Valves[i], playerCount(), now())
					publishMeltdown(m)
				end
			end)
			table.insert(valveParts, part)
		end
	end
	publishMeltdown(m)
	publishCounts()
	log:Warn("REACTOR MELTDOWN (%s): %d s", cause, seconds)
	announce("Danger", if playerCount() <= Disasters.Tuning().Meltdown.SoloPlayers
		then `REACTOR MELTDOWN IN {seconds} S: TURN ALL THREE VALVES IN THE REACTOR CORE · EACH STAYS TURNED {Disasters.Tuning().Meltdown.SoloValveSeconds} S`
		else `REACTOR MELTDOWN IN {seconds} S: TURN ALL THREE VALVES IN THE REACTOR CORE AT ONCE`)
	DisasterService.Started:Fire(m.Id, "Meltdown")
	if Disasters.Tuning().Meltdown.StartsFire then
		DisasterService:StartFire(reactor.Id, "Meltdown")
	end
	return true
end

local function tickMeltdown(t: number)
	local m = meltdown
	if not m then
		return
	end
	if Disasters.MeltdownStopped(m.Valves, t) then
		endMeltdown("Fixed")
		return
	end
	if t >= m.EndsAt then
		endMeltdown("Lost")
		director:Lose("ReactorDestroyed") -- Section 5: the Reactor Core melts down
		return
	end
	publishMeltdown(m)
	set("ValvesTurned", Disasters.ValvesOn(m.Valves, t))
end

-- Electrical surges -------------------------------------------------------------------------------------

function DisasterService:StartElectricalSurge(roomId: string, cause: string): string?
	local room = grid:Room(roomId)
	if not room or surges[roomId] or room.Type == "Shaft" then
		return nil
	end
	local info = Config.Get("Disasters", "ElectricalSurge")
	local s: Surge = { Id = `S:{roomId}`, Room = roomId, EndsAt = now() + (info.DurationSeconds or 20), Carry = 0, Cause = cause }
	surges[roomId] = s
	collection:Set(s.Id, { Kind = "Surge", Room = roomId, EndsAt = s.EndsAt, Cause = cause })
	log:Info("electrical surge in %s (%s)", roomId, cause)
	announce("Warning", `ELECTRICAL SURGE IN {nameOf(roomId)}: WELD IT BEFORE IT SPARKS A FIRE`)
	DisasterService.Started:Fire(s.Id, "Surge")
	return s.Id
end

local function endSurge(s: Surge, how: string, player: Player?)
	if surges[s.Room] ~= s then
		return
	end
	surges[s.Room] = nil
	collection:Remove(s.Id)
	log:Info("electrical surge in %s over (%s)", s.Room, how)
	if how == "Fixed" then
		announce("Info", `THE SURGE IN {nameOf(s.Room)} IS WELDED{if player then ` · {string.upper(player.DisplayName)}` else ""}`)
	end
	DisasterService.Ended:Fire(s.Id, "Surge", how)
end

local function tickSurges(dt: number, t: number)
	local info = Config.Get("Disasters", "ElectricalSurge")
	for roomId, s in table.clone(surges) do
		local room = grid:Room(roomId)
		if not room then
			endSurge(s, "Gone")
			continue
		end
		s.Carry += (info.RoomDamagePerSecond or 0) * dt
		if s.Carry >= 1 and room.HP > 0 then
			local whole = math.floor(s.Carry)
			s.Carry -= whole
			grid:SetHP(roomId, room.HP - whole)
		end
		if t >= s.EndsAt then
			endSurge(s, "Expired")
			local after = Disasters.SurgeAftermath(rng)
			if after == "Fire" then
				DisasterService:StartFire(roomId, "ElectricalSurge")
			elseif after == "Blackout" then
				DisasterService:StartBlackout(room.Floor, "ElectricalSurge")
			end
		end
	end
end

-- The Surge's disaster (Section 5) ------------------------------------------------------------------------

-- Floods (Prompt 23) -------------------------------------------------------------------------------------

local function publishFlood(flood: Flood)
	flood.Sent = math.ceil(flood.Level)
	flood.SentPipe = flood.Pipe
	collection:Set(flood.Id, { Kind = "Flood", Room = flood.Room, Level = flood.Sent, Pipe = flood.Pipe, Cause = flood.Cause })
end

-- Where a room's burst pipe is: on the back wall of one of its cells, under the ceiling.
local function pipePosition(room: any): Vector3
	local g = Grid.Tuning()
	local n = (tonumber(string.match(room.Id, "%d+")) or 0) + counter
	local cell = Grid.CellPosition(room.Floor, room.Column + n % room.Span)
	return cell + Vector3.new(if n % 2 == 0 then -7 else 7, g.CellHeight * 0.62, -(g.CellDepth / 2 - 1.2))
end

-- A fitting on a wall with its prompt: the art's model if it is there (ServerStorage.Assets.Kit),
-- else a plain block.
local function fitting(name: string, asset: string, at: CFrame, size: Vector3, colour: Color3): Instance?
	local parent = holder()
	if not parent then
		return nil
	end
	local source = art(asset)
	local item: Instance
	if source then
		local model = source:Clone()
		CollectionService:RemoveTag(model, "Asset")
		model:PivotTo(at)
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.Anchored = true
				part.CanCollide = false
				part.CanQuery = false
				CollectionService:AddTag(part, CAMERA_IGNORE_TAG)
			end
		end
		item = model
	else
		local part = Instance.new("Part")
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Material = Enum.Material.Metal
		part.Color = colour
		part.Size = size
		part.CFrame = at
		CollectionService:AddTag(part, CAMERA_IGNORE_TAG)
		item = part
	end
	item.Name = name
	item.Parent = parent
	return item
end

local function endFlood(flood: Flood, how: string, player: Player?)
	if floods[flood.Room] ~= flood then
		return
	end
	floods[flood.Room] = nil
	Hazards.SetFlood(flood.Room, nil)
	if flood.Prop then
		flood.Prop:Destroy()
	end
	collection:Remove(flood.Id)
	publishCounts()
	log:Info("flood in %s over (%s%s)", flood.Room, how, if player then `, {player.Name}` else "")
	if how ~= "Gone" then
		announce("Info", `{nameOf(flood.Room)} IS DRY{if player then ` · {string.upper(player.DisplayName)}` else ""}`)
	end
	DisasterService.Ended:Fire(flood.Id, "Flood", how)
end

-- The burst pipe is patched: the water stops rising and the room drains.
function DisasterService:PatchPipe(roomId: string, how: string, player: Player?): boolean
	local flood = floods[roomId]
	if not flood or not flood.Pipe then
		return false
	end
	flood.Pipe = false
	if flood.Prop then
		flood.Prop:Destroy()
		flood.Prop = nil
	end
	publishFlood(flood)
	log:Info("pipe patched in %s (%s%s) at level %.0f", roomId, how, if player then `, {player.Name}` else "", flood.Level)
	announce("Info", `PIPE PATCHED IN {nameOf(roomId)}{if player then ` · {string.upper(player.DisplayName)}` else ""}: IT IS DRAINING`)
	return true
end

-- Ends a room's flood at once (the Firefighter's Foam Burst: "Ends a room's fire or flood at once").
function DisasterService:Drain(roomId: string, how: string, player: Player?): boolean
	local flood = floods[roomId]
	if not flood then
		return false
	end
	endFlood(flood, how, player)
	return true
end

-- Water in a room. `pipe` (default true): a burst pipe feeds it until someone patches it; false:
-- so much water and no more (a Bloat Toad's burst, water pouring in from next door). Into a room
-- that is already flooded it adds `level` and, if asked, bursts a pipe there too.
function DisasterService:StartFlood(roomId: string, cause: string, level: number?, pipe: boolean?): string?
	local room = grid:Room(roomId)
	if not room then
		return nil
	end
	local f = Disasters.Tuning().Flood
	local burst = pipe ~= false
	local flood = floods[roomId]
	if flood then
		flood.Level = math.clamp(flood.Level + (level or 0), 0, 100)
		if not burst or flood.Pipe then
			Hazards.SetFlood(roomId, flood.Level)
			publishFlood(flood)
			return flood.Id
		end
	else
		flood = {
			Id = `W:{roomId}`, Room = roomId, Level = math.clamp(level or f.StartLevel, 1, 100), Pipe = false,
			NextSpread = now() + Disasters.FloodSpreadSeconds(), Carry = 0, Cause = cause, Sent = -1, SentPipe = false,
		}
		floods[roomId] = flood
	end
	if burst then
		flood.Pipe = true
		local at = pipePosition(room)
		local prop = fitting(`Pipe:{roomId}`, "Kit_BurstPipe", CFrame.new(at), Vector3.new(5, 1.4, 1.4), Color3.fromRGB(141, 150, 157))
		flood.Prop = prop
		local base = if prop and prop:IsA("Model") then prop.PrimaryPart or prop:FindFirstChildWhichIsA("BasePart", true) else prop
		if prop and base and base:IsA("BasePart") then
			prop:SetAttribute("Room", roomId)
			local p = prompt(base, "PatchPipe", "Patch the pipe", "Burst pipe", f.PatchSeconds, 14)
			p.Triggered:Connect(function(player: Player)
				DisasterService:PatchPipe(roomId, "Patched", player)
			end)
		end
	end
	Hazards.SetFlood(roomId, flood.Level)
	publishFlood(flood)
	publishCounts()
	log:Info("flood in %s (%s): %s, level %.0f%s", roomId, room.Type, cause, flood.Level, if flood.Pipe then ", a burst pipe" else "")
	if cause ~= "Spread" then
		announce("Danger", if cause == "Deluge" then `THE DELUGE FLOODS {nameOf(roomId)}{if flood.Pipe then ": PATCH ITS PIPE" else ""}`
			elseif flood.Pipe then `A PIPE HAS BURST IN {nameOf(roomId)}: PATCH IT`
			else `{nameOf(roomId)} IS FLOODING`)
	elseif room.Type == "Shaft" then
		announce("Danger", `WATER IS POURING DOWN THE SHAFT TO FLOOR {room.Floor}`)
	else
		announce("Danger", `THE WATER REACHES {nameOf(roomId)}`)
	end
	DisasterService.Started:Fire(flood.Id, "Flood")
	return flood.Id
end

-- The water's level in a room (nil: dry).
function DisasterService:Flooded(roomId: string): number?
	local flood = floods[roomId]
	return if flood then flood.Level else nil
end

local function tickFloods(dt: number, t: number, inside: { [string]: { any } })
	if next(floods) == nil then
		return
	end
	local bunker = grid:Bunker()
	local levels: { [string]: number } = {}
	for roomId, flood in floods do
		levels[roomId] = flood.Level
	end
	local drain = modifierValue("FloodDrainSpeed")
	for roomId, flood in table.clone(floods) do
		local room = grid:Room(roomId)
		if not room then
			endFlood(flood, "Gone")
			continue
		end
		local fed = if flood.Pipe then nil else Disasters.FloodFed(bunker, roomId, levels)
		flood.Level = Disasters.FloodStep(flood.Level, dt, flood.Pipe, fed, drain)
		if flood.Level <= 0 then
			endFlood(flood, "Drained")
			continue
		end
		-- the water ruins the room (Section 6: "fires and floods hurt rooms")
		flood.Carry += Disasters.FloodRoomDamage(flood.Level, dt)
		if flood.Carry >= 1 and room.HP > 0 then
			local whole = math.floor(flood.Carry)
			flood.Carry -= whole
			grid:SetHP(roomId, room.HP - whole)
		end
		-- and anyone deep in it
		if Disasters.FloodDepth(flood.Level) > 0 then
			for _, c in inside[roomId] or {} do
				if c.Kind == "Resident" then
					combat:Damage(c.Id, Disasters.FloodResidentDamage(flood.Level, dt), nil, "flood")
				elseif c.Kind == "Player" and c.Player then
					local taken = Modifiers.PlayerValue(c.Player, "FireFloodDamageTaken") or 1
					combat:Damage(c.Id, Disasters.FloodPlayerDamage(flood.Level, dt, taken), nil, "flood")
				end
			end
		end
		-- it pours on (Section 10: "pours down the Shaft")
		if t >= flood.NextSpread then
			flood.NextSpread = t + Disasters.FloodSpreadSeconds()
			if Disasters.FloodCanSpread(flood.Level) then
				local targets = Disasters.FloodSpreadTargets(bunker, roomId, floods)
				if #targets > 0 then
					DisasterService:StartFlood(targets[rng:NextInteger(1, #targets)], "Spread", Disasters.Tuning().Flood.OverflowStartLevel, false)
				end
			end
		end
		Hazards.SetFlood(roomId, flood.Level)
		if math.ceil(flood.Level) ~= flood.Sent or flood.Pipe ~= flood.SentPipe then
			publishFlood(flood)
		end
	end
end

-- Gas leaks (Prompt 23) --------------------------------------------------------------------------------

local function publishGas(gas: Gas)
	gas.Sent = math.ceil(gas.Strength)
	gas.SentLeaking = gas.Leaking
	collection:Set(gas.Id, { Kind = "Gas", Room = gas.Room, Strength = gas.Sent, Leaking = gas.Leaking, EndsAt = gas.EndsAt, Cause = gas.Cause })
end

-- A room's vent (the kit's Vent socket or part), else a spot high on its back wall.
local function ventPosition(room: any): Vector3
	local model = grid:RoomModel(room.Id)
	if model then
		local socket = BunkerKit.Socket(model, "Vent")
		if socket then
			return socket.Position
		end
		local vent = model:FindFirstChild("Vent", true)
		if vent and vent:IsA("BasePart") then
			return vent.Position
		elseif vent and vent:IsA("Model") then
			return (vent:GetBoundingBox()).Position
		end
	end
	local g = Grid.Tuning()
	return Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, g.CellHeight * 0.7, -(g.CellDepth / 2 - 1.2))
end

local function endGas(gas: Gas, how: string, player: Player?)
	if gases[gas.Room] ~= gas then
		return
	end
	gases[gas.Room] = nil
	Hazards.SetGas(gas.Room, nil)
	if gas.Prop then
		gas.Prop:Destroy()
	end
	collection:Remove(gas.Id)
	publishCounts()
	log:Info("gas in %s gone (%s%s)", gas.Room, how, if player then `, {player.Name}` else "")
	if how ~= "Gone" then
		announce("Info", `THE AIR IS CLEAR IN {nameOf(gas.Room)}{if player then ` · {string.upper(player.DisplayName)}` else ""}`)
	end
	DisasterService.Ended:Fire(gas.Id, "Gas", how)
end

-- The vent is sealed (or the leak has run its time): no more gas comes in and the room airs out.
function DisasterService:SealVent(roomId: string, how: string, player: Player?): boolean
	local gas = gases[roomId]
	if not gas or not gas.Leaking then
		return false
	end
	gas.Leaking = false
	if gas.Prop then
		gas.Prop:Destroy()
		gas.Prop = nil
	end
	publishGas(gas)
	log:Info("gas vent in %s shut (%s%s) at strength %.0f", roomId, how, if player then `, {player.Name}` else "", gas.Strength)
	if how ~= "Expired" then
		announce("Info", `VENT SEALED IN {nameOf(roomId)}{if player then ` · {string.upper(player.DisplayName)}` else ""}: THE GAS IS THINNING`)
	end
	return true
end

-- Clears a room's gas at once (the Hazmat Tech's Decon Field: "Clears radiation and gas from a room").
function DisasterService:ClearGas(roomId: string, how: string, player: Player?): boolean
	local gas = gases[roomId]
	if not gas then
		return false
	end
	endGas(gas, how, player)
	return true
end

function DisasterService:StartGasLeak(roomId: string, cause: string, strength: number?): string?
	local room = grid:Room(roomId)
	if not room or gases[roomId] then
		return nil
	end
	local g = Disasters.Tuning().Gas
	local gas: Gas = {
		Id = `G:{roomId}`, Room = roomId, Strength = math.clamp(strength or g.StartStrength, 1, 100), Leaking = true,
		EndsAt = now() + Disasters.GasSeconds(), Cause = cause, Sent = -1, SentLeaking = true,
	}
	gases[roomId] = gas
	local prop = fitting(`GasVent:{roomId}`, "Kit_GasVent", CFrame.new(ventPosition(room) + Vector3.new(0, 0, 0.6)), Vector3.new(3, 3, 0.6),
		Color3.fromRGB(94, 106, 68))
	gas.Prop = prop
	local base = if prop and prop:IsA("Model") then prop.PrimaryPart or prop:FindFirstChildWhichIsA("BasePart", true) else prop
	if prop and base and base:IsA("BasePart") then
		prop:SetAttribute("Room", roomId)
		local p = prompt(base, "SealVent", "Seal the vent", "Gas leak", g.SealSeconds, 14)
		p.Triggered:Connect(function(player: Player)
			DisasterService:SealVent(roomId, "Sealed", player)
		end)
	end
	Hazards.SetGas(roomId, gas.Strength)
	publishGas(gas)
	publishCounts()
	log:Info("gas leak in %s (%s): %s", roomId, room.Type, cause)
	announce("Danger", `GAS IN {nameOf(roomId)}: SEAL THE VENT OR GET OUT`)
	DisasterService.Started:Fire(gas.Id, "Gas")
	return gas.Id
end

-- A room's gas strength (nil: clear air).
function DisasterService:Gassed(roomId: string): number?
	local gas = gases[roomId]
	return if gas then gas.Strength else nil
end

local function flagOn(value: any): boolean
	return value == true or (type(value) == "number" and value > 0)
end

local function tickGas(dt: number, t: number, inside: { [string]: { any } })
	if next(gases) == nil then
		return
	end
	local strength = modifierValue("GasStrength")
	for roomId, gas in table.clone(gases) do
		if not grid:Room(roomId) then
			endGas(gas, "Gone")
			continue
		end
		if gas.Leaking and t >= gas.EndsAt then
			DisasterService:SealVent(roomId, "Expired") -- Section 10: "or air the room out"
		end
		gas.Strength = Disasters.GasStep(gas.Strength, dt, gas.Leaking)
		if gas.Strength <= 0 then
			endGas(gas, "Aired")
			continue
		end
		for _, c in inside[roomId] or {} do
			if c.Kind == "Resident" then
				-- Prompt 26: a Hazmat Suit ignores gas, the Hardy take half
				local person = if c.ResidentId then residents:Get(c.ResidentId) else nil
				local taken = if person then ResidentRules.GasTaken(person) else 1
				if taken > 0 then
					combat:Damage(c.Id, Disasters.GasResidentDamage(gas.Strength, dt, strength) * taken, nil, "gas")
				end
			elseif c.Kind == "Player" and c.Player then
				local immune = flagOn(Modifiers.PlayerValue(c.Player, "GasImmune"))
				local taken = Modifiers.PlayerValue(c.Player, "GasDamageTaken")
				local damage = Disasters.GasPlayerDamage(gas.Strength, dt, strength, immune, if type(taken) == "number" then taken else 1)
				if damage > 0 then
					combat:Damage(c.Id, damage, nil, "gas")
				end
			end
		end
		Hazards.SetGas(roomId, gas.Strength)
		if math.ceil(gas.Strength) ~= gas.Sent or gas.Leaking ~= gas.SentLeaking then
			publishGas(gas)
		end
	end
end

-- Radiation leaks (Prompt 24) ------------------------------------------------------------------------

local function leakUnits(leak: Leak): { [string]: boolean }
	local units: { [string]: boolean } = {}
	if leak.Room then
		if grid:Room(leak.Room) then
			units[leak.Room] = true
		end
		return units
	end
	local g = Grid.Tuning()
	local bunker = grid:Bunker()
	for column = g.ColumnMin, g.ColumnMax do
		local unit = bunker:UnitAt(leak.Floor, column)
		if unit then
			units[unit] = true
		end
	end
	return units
end

local function publishLeak(leak: Leak)
	leak.Sent = math.ceil(leak.Strength)
	leak.SentLeaking = leak.Leaking
	local list = {}
	for unit in leak.Units do
		table.insert(list, unit)
	end
	table.sort(list)
	collection:Set(leak.Id, {
		Kind = "Radiation", Floor = leak.Floor, Room = leak.Room, Door = leak.Door, Units = list, Strength = leak.Sent,
		Leaking = leak.Leaking, EndsAt = leak.EndsAt, Cause = leak.Cause,
	})
end

local function leakWhere(leak: Leak): string
	return if leak.Room then nameOf(leak.Room) else `FLOOR {leak.Floor}`
end

-- A working Decon Room "slows leaks" (Section 6).
local function workingDecon(): boolean
	for _, room in grid:RoomsOfType("DeconRoom") do
		if not room.Wrecked and not power:IsDark(room.Id) then
			return true
		end
	end
	return false
end

local function endLeak(leak: Leak, how: string, player: Player?)
	if leaks[leak.Id] ~= leak then
		return
	end
	leaks[leak.Id] = nil
	for unit in leak.Units do
		Hazards.SetRadiation(unit, nil)
	end
	-- another leak may still fill some of those
	for _, other in leaks do
		for unit in other.Units do
			Hazards.SetRadiation(unit, other.Strength)
		end
	end
	if leak.Prop then
		leak.Prop:Destroy()
	end
	collection:Remove(leak.Id)
	publishCounts()
	log:Info("radiation on %s gone (%s%s)", leakWhere(leak), how, if player then `, {player.Name}` else "")
	if how ~= "Gone" then
		announce("Info", `THE RADIATION IS GONE FROM {leakWhere(leak)}{if player then ` · {string.upper(player.DisplayName)}` else ""}`)
	end
	DisasterService.Ended:Fire(leak.Id, "Radiation", how)
end

-- The door is sealed, or went up a level, or the storm has passed: nothing more comes in and
-- the radiation fades.
function DisasterService:SealLeak(id: string, how: string, player: Player?): boolean
	local leak = leaks[id]
	if not leak or not leak.Leaking then
		return false
	end
	leak.Leaking = false
	if leak.Prop then
		leak.Prop:Destroy()
		leak.Prop = nil
	end
	publishLeak(leak)
	log:Info("radiation leak %s shut (%s%s) at strength %.0f", id, how, if player then `, {player.Name}` else "", leak.Strength)
	if how == "Upgraded" then
		announce("Info", "THE NEW BLAST DOOR HOLDS: THE RADIATION IS FADING")
	elseif how ~= "Expired" then
		announce("Info", `{if leak.Room then "SEAM" else "BLAST DOOR"} SEALED{if player then ` · {string.upper(player.DisplayName)}` else ""}: THE RADIATION IS FADING`)
	end
	return true
end

-- Clears a room's radiation at once (the Hazmat Tech's Decon Field): a leak that is shut is gone;
-- one still leaking starts to fill again. The irradiated residents in the room are cleared too.
function DisasterService:ClearRadiation(roomId: string, how: string, player: Player?): boolean
	local any = false
	for _, leak in table.clone(leaks) do
		if leak.Units[roomId] then
			any = true
			if leak.Leaking then
				leak.Strength = 1
				publishLeak(leak)
			else
				endLeak(leak, how, player)
			end
		end
	end
	for _, c in (occupants())[roomId] or {} do
		if c.Kind == "Resident" and c.ResidentId and residents:SetCondition(c.ResidentId, "Irradiated", false, how) then
			any = true
		end
	end
	return any
end

-- The radiation in a unit (nil: none).
function DisasterService:Irradiated(unit: string): number?
	return Hazards.Radiation(unit)
end

-- A radiation leak: the Blast Door's (roomId nil: "Floor 1 fills with radiation"), or one room's
-- (a hazard pocket in the Crystal Hollows).
function DisasterService:StartRadiationLeak(cause: string, roomId: string?, strength: number?): string?
	local r = Disasters.Tuning().Radiation
	local door = grid:RoomsOfType("BlastDoor")[1]
	local room = if roomId then grid:Room(roomId) else door
	if not room then
		return nil
	end
	local id = if roomId then `R:{roomId}` else "R:Door"
	if leaks[id] then
		return nil
	end
	local leak: Leak = {
		Id = id, Floor = room.Floor, Room = roomId, Strength = math.clamp(strength or (if roomId then r.PocketStrength else r.StartStrength), 1, 100),
		Leaking = true, EndsAt = now() + Disasters.RadiationSeconds(), Cause = cause, Sent = -1, SentLeaking = true,
		Units = {}, DoorLevel = if roomId then nil else room.Level, Door = if roomId then nil else room.Id,
	}
	leak.Units = leakUnits(leak)
	leaks[id] = leak
	-- what a player seals: the Blast Door's seal, or the crystal seam in the room's back wall
	local g = Grid.Tuning()
	local at: CFrame
	if roomId then
		at = seamSpot(room)
	else
		local model = grid:RoomModel(room.Id)
		local socket = if model then BunkerKit.Socket(model, "Door") else nil
		at = if socket then CFrame.new(socket.Position + Vector3.new(DOOR_SEAL_SIDE, 3, 1.2))
			else CFrame.new(Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, 4, -(g.CellDepth / 2 - 1.5)))
	end
	local prop = fitting(if roomId then `RadSeam:{roomId}` else "DoorSeal", if roomId then "Kit_CrystalSeam" else "Kit_DoorSeal", at,
		Vector3.new(4, 4, 0.8), Color3.fromRGB(124, 255, 155))
	leak.Prop = prop
	local base = if prop and prop:IsA("Model") then prop.PrimaryPart or prop:FindFirstChildWhichIsA("BasePart", true) else prop
	if prop and base and base:IsA("BasePart") then
		prop:SetAttribute("Leak", id)
		local p = prompt(base, "SealLeak", if roomId then "Seal the seam" else "Seal the door", "Radiation leak", r.SealSeconds, 14)
		p.Triggered:Connect(function(player: Player)
			DisasterService:SealLeak(id, "Sealed", player)
		end)
	end
	for unit in leak.Units do
		Hazards.SetRadiation(unit, leak.Strength)
	end
	publishLeak(leak)
	publishCounts()
	log:Info("radiation leak %s (%s)", id, cause)
	if roomId then
		announce("Danger", `RADIATION IN {nameOf(roomId)}: SEAL THE CRYSTAL SEAM OR GET OUT`)
	else
		announce("Danger", `THE STORM IS THROUGH THE BLAST DOOR: RADIATION ON FLOOR {room.Floor} · SEAL THE DOOR`)
	end
	DisasterService.Started:Fire(id, "Radiation")
	return id
end

-- Section 10: "Surface storms against a weak Blast Door". Rolled as each Surge's storm hits.
local function stormAtTheDoor()
	local door = grid:RoomsOfType("BlastDoor")[1]
	if not door or leaks["R:Door"] then
		return
	end
	local era = table.find(Config.Ids("Eras"), clock:Era()) or 1
	local chance = Disasters.DoorLeakChance(era, door.Level, if door.MaxHP > 0 then door.HP / door.MaxHP else 0, door.Wrecked == true)
	local roll = rng:NextNumber()
	log:Info("the storm at the Blast Door (level %d, %d/%d HP): leak chance %.2f, rolled %.2f", door.Level, door.HP, door.MaxHP, chance, roll)
	if roll < chance then
		DisasterService:StartRadiationLeak("Storm")
	end
end

local function tickRadiation(dt: number, t: number, inside: { [string]: { any } })
	if next(leaks) == nil then
		return
	end
	local r = Disasters.Tuning().Radiation
	local slow = if workingDecon() then r.DeconSlow else 1
	for id, leak in table.clone(leaks) do
		local units = leakUnits(leak)
		if next(units) == nil then
			endLeak(leak, "Gone")
			continue
		end
		for unit in leak.Units do
			if not units[unit] then
				Hazards.SetRadiation(unit, nil)
			end
		end
		leak.Units = units
		if leak.Leaking then
			local door = if leak.DoorLevel then grid:RoomsOfType("BlastDoor")[1] else nil
			if door and leak.DoorLevel and door.Level > leak.DoorLevel then
				DisasterService:SealLeak(id, "Upgraded") -- Section 10: "Seal or upgrade the door"
			elseif t >= leak.EndsAt then
				DisasterService:SealLeak(id, "Expired")
			end
		end
		leak.Strength = Disasters.RadiationStep(leak.Strength, dt, leak.Leaking, slow)
		if leak.Strength <= 0 then
			endLeak(leak, "Faded")
			continue
		end
		for unit in units do
			Hazards.SetRadiation(unit, leak.Strength)
			for _, c in inside[unit] or {} do
				if c.Kind == "Resident" then
					-- Prompt 26: the Hardy "resist radiation": half the harm, and Irradiated only at twice the strength
					local person = if c.ResidentId then residents:Get(c.ResidentId) else nil
					local taken = if person then ResidentRules.Trait(person, "RadiationGain") or 1 else 1
					combat:Damage(c.Id, Disasters.RadiationResidentDamage(leak.Strength, dt) * taken, nil, "radiation")
					if leak.Strength * taken >= r.IrradiateAt and c.ResidentId then
						residents:SetCondition(c.ResidentId, "Irradiated", true, "the leak")
					end
				end
			end
		end
		if math.ceil(leak.Strength) ~= leak.Sent or leak.Leaking ~= leak.SentLeaking then
			publishLeak(leak)
		end
	end
end

-- Outbreaks (Prompt 24) ------------------------------------------------------------------------------

local function sickResidents(): { any }
	local list = {}
	for _, resident in residents:All() do
		if resident.Sick and (resident.State == "Alive" or resident.State == "Down") then
			table.insert(list, resident)
		end
	end
	table.sort(list, function(a, b)
		return (tonumber(string.match(a.Id, "%d+")) or 0) < (tonumber(string.match(b.Id, "%d+")) or 0)
	end)
	return list
end

local function residentName(resident: any): string
	return string.upper(`{resident.First} {resident.Last}`)
end

-- Medbays that can treat: standing, lit and staffed.
local function workingMedbays(): number
	local n = 0
	for _, room in grid:RoomsOfType("Medbay") do
		if not room.Wrecked and not power:IsDark(room.Id) and #residents:Workers(room.Id) > 0 then
			n += 1
		end
	end
	return n
end

-- The team's best OutbreakCureSpeed (the Hazmat Tech's level 3: "Outbreaks cured twice as fast").
local function cureSpeed(): number
	local best = 1
	for _, player in session:ReadyPlayers() do
		local value = Modifiers.PlayerValue(player, "OutbreakCureSpeed")
		if type(value) == "number" and value > best then
			best = value
		end
	end
	return best
end

local function publishOutbreak(o: Outbreak, sick: { any }, treating: boolean)
	local quarantined = 0
	for _, resident in sick do
		if resident.Job == nil then
			quarantined += 1
		end
	end
	local patient = if o.Patient then residents:Get(o.Patient) else nil
	local fraction = math.clamp(o.Cure / Disasters.CureSeconds(cureSpeed()), 0, 1)
	local sent = `{#sick}|{quarantined}|{o.Patient or ""}|{math.floor(fraction * 20)}|{treating}`
	if sent == o.Sent then
		return
	end
	o.Sent = sent
	collection:Set(o.Id, {
		Kind = "Outbreak", Sick = #sick, Quarantined = quarantined, Patient = if patient then `{patient.First} {patient.Last}` else nil,
		Cure = fraction, Treating = treating, Cause = o.Cause,
	})
end

local function endOutbreak(how: string)
	local o = outbreak
	if not o then
		return
	end
	outbreak = nil
	collection:Remove(o.Id)
	publishCounts()
	log:Info("the outbreak is over (%s)", how)
	if how ~= "Gone" then
		announce("Info", "THE OUTBREAK IS OVER: NOBODY IS SICK")
	end
	DisasterService.Ended:Fire(o.Id, "Outbreak", how)
end

-- A resident is cured (the Medbay, a level 3 Medic's Triage Pulse; DevTools). They can't catch
-- this outbreak again.
function DisasterService:Cure(residentId: string, how: string, player: Player?): boolean
	if not residents:SetCondition(residentId, "Sick", false, how) then
		return false
	end
	local o = outbreak
	if o then
		o.Immune[residentId] = true
		if o.Patient == residentId then
			o.Patient, o.Cure = nil, 0
		end
	end
	local resident = residents:Get(residentId)
	local left = #sickResidents()
	if resident and left > 0 then
		announce("Info", `{residentName(resident)} IS CURED{if player then ` · {string.upper(player.DisplayName)}` else ""} ({left} STILL SICK)`)
	end
	return true
end

-- An outbreak begins with one carrier (given, or picked from the residents who are well).
function DisasterService:StartOutbreak(cause: string, residentId: string?): string?
	local carrier = if residentId then residents:Get(residentId) else nil
	if not carrier then
		local well = {}
		for _, resident in residents:All() do
			if resident.State == "Alive" and not resident.Sick then
				table.insert(well, resident)
			end
		end
		if #well == 0 then
			return nil
		end
		table.sort(well, function(a, b)
			return a.Id < b.Id
		end)
		carrier = well[rng:NextInteger(1, #well)]
	end
	if carrier.State ~= "Alive" or carrier.Sick then
		return nil
	end
	local o = outbreak
	if not o then
		counter += 1
		o = { Id = `O:{counter}`, Cause = cause, NextSpread = now() + Disasters.Tuning().Outbreak.SpreadSeconds, Cure = 0, Patient = nil, Immune = {}, Sent = "" }
		outbreak = o
		log:Info("an outbreak (%s): %s is sick", cause, carrier.Id)
		announce("Danger", `OUTBREAK: {residentName(carrier)} IS SICK · TAKE THE SICK OFF WORK TO QUARANTINE THEM`)
		DisasterService.Started:Fire(o.Id, "Outbreak")
	end
	residents:SetCondition(carrier.Id, "Sick", true, if cause == "TheDeep" then "brought up from the Deep" else nil)
	publishCounts()
	return o.Id
end

-- Someone has come in from the Deep (a rescue, a Lost Crew, an expedition home; Section 10: the
-- Deep causes outbreaks): CarrierChance of the time, from era FromEra, they carry the sickness.
function DisasterService:FromTheDeep(residentId: string, why: string): boolean
	local era = table.find(Config.Ids("Eras"), clock:Era()) or 1
	local resident = residents:Get(residentId)
	if not resident or resident.State ~= "Alive" or resident.Sick then
		return false
	end
	local roll = rng:NextNumber()
	local carries = Disasters.CarriesSickness(era, roll)
	log:Info("%s came in from the Deep (%s): rolled %.2f, %s", residentId, why, roll, if carries then "a carrier" else "well")
	if not carries then
		return false
	end
	return DisasterService:StartOutbreak("TheDeep", residentId) ~= nil
end

local function tickOutbreak(dt: number, t: number, inside: { [string]: { any } })
	local sick = sickResidents()
	local o = outbreak
	if not o then
		if #sick > 0 then
			-- someone is sick with no outbreak on record (a dev command): give them one
			counter += 1
			o = { Id = `O:{counter}`, Cause = "Unknown", NextSpread = t + Disasters.Tuning().Outbreak.SpreadSeconds, Cure = 0, Patient = nil, Immune = {}, Sent = "" }
			outbreak = o
		else
			return
		end
	end
	if #sick == 0 then
		endOutbreak("Cured")
		return
	end
	local tuning = Disasters.Tuning().Outbreak
	-- where everyone is
	local where: { [string]: string } = {}
	for unit, list in inside do
		for _, c in list do
			if c.Kind == "Resident" and c.ResidentId then
				where[c.ResidentId] = unit
			end
		end
	end
	if t >= o.NextSpread then
		o.NextSpread = t + tuning.SpreadSeconds
		local people = {}
		for _, resident in residents:All() do
			if resident.State == "Alive" then
				local unit = where[resident.Id]
				local room = if unit then grid:Room(unit) else nil
				table.insert(people, {
					Id = resident.Id, Room = unit, Sick = resident.Sick == true, Immune = o.Immune[resident.Id] == true,
					-- quarantine: off work and in Quarters
					Quarantined = resident.Sick == true and resident.Job == nil and room ~= nil and room.Type == "Quarters",
				})
			end
		end
		local caught: { [string]: boolean } = {}
		for _, person in people do
			if person.Sick and not caught[person.Id] then
				local targets = Disasters.OutbreakTargets(people, person)
				local open = {}
				for _, id in targets do
					if not caught[id] then
						table.insert(open, id)
					end
				end
				if #open > 0 and rng:NextNumber() < tuning.SpreadChance then
					local id = open[rng:NextInteger(1, #open)]
					caught[id] = true
					if residents:SetCondition(id, "Sick", true, "caught it at work") then
						local resident = residents:Get(id)
						if resident then
							announce("Warning", `{residentName(resident)} CAUGHT THE SICKNESS ({#sick + 1} SICK)`)
						end
						table.insert(sick, resident)
					end
				end
			end
		end
	end
	-- Medbay treatment: one patient at a time for each working Medbay's share
	local medbays = workingMedbays()
	if medbays > 0 then
		if not o.Patient or not residents:HasCondition(o.Patient, "Sick") then
			o.Patient, o.Cure = sick[1].Id, 0
		end
		o.Cure += dt * medbays
		if o.Cure >= Disasters.CureSeconds(cureSpeed()) then
			DisasterService:Cure(o.Patient :: string, "the Medbay")
			sick = sickResidents()
			if #sick == 0 then
				endOutbreak("Cured")
				return
			end
		end
	end
	publishOutbreak(o, sick, medbays > 0)
end

-- What players stand in, for their own screen and legs: the Wading, InGas and InRadiation
-- attributes (SurfaceService adds a leak's radiation to the player's own from InRadiation).
local function markPlayers(inside: { [string]: { any } })
	local wading: { [Player]: number } = {}
	local breathing: { [Player]: number } = {}
	local glowing: { [Player]: number } = {}
	for _, leak in leaks do
		for unit in leak.Units do
			for _, c in inside[unit] or {} do
				if c.Kind == "Player" and c.Player then
					glowing[c.Player] = math.max(glowing[c.Player] or 0, math.ceil(leak.Strength))
				end
			end
		end
	end
	for roomId, flood in floods do
		for _, c in inside[roomId] or {} do
			if c.Kind == "Player" and c.Player then
				wading[c.Player] = math.ceil(flood.Level)
			end
		end
	end
	for roomId, gas in gases do
		for _, c in inside[roomId] or {} do
			if c.Kind == "Player" and c.Player then
				breathing[c.Player] = math.ceil(gas.Strength)
			end
		end
	end
	for _, player in session:ReadyPlayers() do
		if player:GetAttribute("Wading") ~= wading[player] then
			player:SetAttribute("Wading", wading[player])
		end
		if player:GetAttribute("InGas") ~= breathing[player] then
			player:SetAttribute("InGas", breathing[player])
		end
		if player:GetAttribute("InRadiation") ~= glowing[player] then
			player:SetAttribute("InRadiation", glowing[player])
		end
	end
end

-- A hazard pocket found by digging (Section 7: "Gas or water bursts out"; DigService): into the
-- room the digger stands in, else the nearest room on that floor. Returns what burst out.
function DisasterService:HazardPocket(floor: number, column: number, player: Player?): string?
	local band = nil
	for _, id in Config.Ids("DepthBands") do
		local b = Config.Get("DepthBands", id)
		if floor >= b.Floors.From and floor <= b.Floors.To then
			band = b
		end
	end
	local kind = if band then Disasters.HazardKind(band.Hazards, rng) else nil
	if not kind then
		return nil
	end
	local target: string? = nil
	local root = if player and player.Character then player.Character:FindFirstChild("HumanoidRootPart") else nil
	local standing = if root and root:IsA("BasePart") then unitAt(root.Position) else nil
	if standing and grid:Room(standing) then
		target = standing
	else
		local best = math.huge
		for _, room in grid:Rooms() do
			if room.Floor == floor then
				local d = math.min(math.abs(room.Column - column), math.abs(room.Column + room.Span - 1 - column))
				if d < best then
					best, target = d, room.Id
				end
			end
		end
	end
	if player then
		local c = combat:PlayerCombatant(player)
		if c then
			combat:Damage(c.Id, Disasters.Tuning().HazardPocket.Damage, nil,
				if kind == "Flood" then "flood" elseif kind == "RadiationLeak" then "radiation" else "gas")
		end
	end
	if not target then
		log:Info("a hazard pocket at %d,%d burst into bare rock: no room on that floor", floor, column)
		return kind
	end
	if kind == "Flood" then
		DisasterService:StartFlood(target, "HazardPocket")
	elseif kind == "RadiationLeak" then
		DisasterService:StartRadiationLeak("HazardPocket", target) -- the Crystal Hollows (Prompt 24)
	else
		DisasterService:StartGasLeak(target, "HazardPocket")
	end
	return kind
end

-- The Surge disasters this service can start (Landon, Prompt 13: cave-ins too, and floods and gas
-- leaks from Era II, built with Prompt 23).
local SURGE_STARTS: { [string]: boolean } = { Fire = true, Blackout = true, CaveIn = true, Flood = true, GasLeak = true }

local function startKind(kind: string, cause: string): string?
	if kind == "Fire" then
		local options = {}
		for _, room in grid:Rooms() do
			if Disasters.Burns(room.Type) and not fires[room.Id] then
				table.insert(options, room.Id)
			end
		end
		if #options == 0 then
			return nil
		end
		return DisasterService:StartFire(options[rng:NextInteger(1, #options)], cause)
	elseif kind == "CaveIn" then
		-- Landon (Prompt 13): a Surge can bring a cave-in, at any doorway in the bunker
		local doorways = Disasters.Doorways(grid:Bunker())
		if #doorways == 0 then
			return nil
		end
		local pick = doorways[rng:NextInteger(1, #doorways)]
		local id = DisasterService:CaveIn(pick.Floor, pick.Column, pick.Side, cause)
		return id
	elseif kind == "Flood" or kind == "GasLeak" then
		local options = {}
		for _, room in grid:Rooms() do
			-- a pipe bursts or a vent leaks in a room people use (the Shaft only carries water down)
			if room.Type ~= "Shaft" and not floods[room.Id] and not gases[room.Id] then
				table.insert(options, room.Id)
			end
		end
		if #options == 0 then
			return nil
		end
		local roomId = options[rng:NextInteger(1, #options)]
		return if kind == "Flood" then DisasterService:StartFlood(roomId, cause) else DisasterService:StartGasLeak(roomId, cause)
	elseif kind == "Blackout" then
		local floors: { number } = {}
		for _, room in grid:Rooms() do
			if not table.find(floors, room.Floor) then
				table.insert(floors, room.Floor)
			end
		end
		table.sort(floors)
		return DisasterService:StartBlackout(Disasters.BlackoutFloor(floors, rng), cause)
	end
	log:Warn("no Surge start for the disaster %s yet", kind)
	return nil
end

-- ThreatDirector: picks and pays for the Surge's one disaster; returns its ThreatCost (0: none).
function DisasterService:SurgeDisaster(budget: number, pick: Random?): number
	local era = table.find(Config.Ids("Eras"), clock:Era()) or 1
	local kind = Disasters.SurgePick(era, budget, pick or rng, SURGE_STARTS)
	if not kind then
		return 0
	end
	local entry = { Kind = kind, Id = nil :: string?, Cycle = clock:Cycle() }
	surgeDisaster = entry
	task.delay(Disasters.Tuning().SurgeDelaySeconds, function()
		if surgeDisaster ~= entry then
			return
		end
		if clock:Phase() ~= "Surge" or director:Phase() ~= "Playing" then
			surgeDisaster = nil
			return
		end
		entry.Id = startKind(kind, "Surge")
		if not entry.Id then
			surgeDisaster = nil
		end
	end)
	return Config.Get("Disasters", kind).ThreatCost
end

local function isActive(id: string): boolean
	return collection:Get(id) ~= nil
end

function DisasterService:HoldsSurge(): boolean
	if meltdown or next(fires) then
		return true
	end
	for _, flood in floods do
		if flood.Pipe then
			return true -- a burst pipe nobody has patched
		end
	end
	local entry = surgeDisaster
	if entry then
		return entry.Id == nil or isActive(entry.Id)
	end
	return false
end

-- Modifiers and queries --------------------------------------------------------------------------------

function DisasterService:SetModifier(source: string, key: string, value: number?)
	assert(key == "FireSpread" or key == "BlackoutDuration" or key == "FloodDrainSpeed" or key == "GasStrength",
		`DisasterService:SetModifier: {key} isn't a disaster modifier`)
	modifiers[key] = modifiers[key] or {}
	modifiers[key][source] = value
end

function DisasterService:Active(): { [string]: any }
	return collection:All()
end

-- The tick --------------------------------------------------------------------------------------------

local function tick(dt: number)
	if director:Phase() ~= "Playing" then
		return
	end
	local t = now()
	local inside = occupants()
	tickFires(dt, t, inside)
	tickFloods(dt, t, inside)
	tickGas(dt, t, inside)
	tickRadiation(dt, t, inside)
	tickOutbreak(dt, t, inside)
	markPlayers(inside)
	if blackout and t >= blackout.EndsAt then
		DisasterService:EndBlackout("Expired")
	end
	tickMeltdown(t)
	tickSurges(dt, t)
	publishCounts()
end

-- The world changed: rubble re-reads the passages it blocks; a blackout takes in new rooms on
-- its floor; fires in rooms that went are out.
local function onGridChanged()
	for id, r in table.clone(rubble) do
		if r.Shape == "Tunnel" and grid:Bunker():State(r.Floor, r.Column) ~= "Dug" then
			DisasterService:ClearRubble(id, "Gone")
		else
			blockEdges(r)
			publishRubble(r)
		end
	end
	if blackout then
		local units = Disasters.BlackoutUnits(grid:Bunker(), blackout.Floor)
		blackout.Units = units
		power:SetBlackout(units)
	end
end

-- DevTools --------------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	local t = now()
	for roomId, fire in fires do
		local room = grid:Room(roomId)
		table.insert(lines, string.format("fire %s %s: strength %.1f, spreads in %.0f s, HP %s (%s)", roomId,
			if room then room.Type else "?", fire.Strength, math.max(fire.NextSpread - t, 0),
			if room then `{room.HP}/{room.MaxHP}` else "?", fire.Cause))
	end
	if blackout then
		local n = 0
		for _ in blackout.Units do
			n += 1
		end
		table.insert(lines, string.format("blackout %s: %s, %d units, %.0f s left (%s)", blackout.Id,
			if blackout.Floor then `floor {blackout.Floor}` else "the whole grid", n, blackout.EndsAt - t, blackout.Cause))
	end
	for id, r in rubble do
		local edges = {}
		for _, edge in r.Edges do
			table.insert(edges, `{edge[1]}|{edge[2]}`)
		end
		table.insert(lines, string.format("rubble %s: %s at %d,%d%s, %d/%d HP, blocks %s (%s)", id, r.Shape, r.Floor, r.Column,
			if r.Side then ` {r.Side}` else "", math.ceil(r.HP), r.MaxHP, table.concat(edges, " "), r.Cause))
	end
	if meltdown then
		local valves = {}
		for i, value in meltdown.Valves do
			valves[i] = if value == Disasters.HELD then "held" elseif value > t then string.format("%.1fs", value - t) else "open"
		end
		table.insert(lines, string.format("meltdown %s in %s: %.1f s left, valves %s, %d players (%s)", meltdown.Id, meltdown.Room,
			meltdown.EndsAt - t, table.concat(valves, " "), playerCount(), meltdown.Cause))
	end
	for roomId, s in surges do
		table.insert(lines, string.format("electrical surge %s: %.0f s left (%s)", roomId, s.EndsAt - t, s.Cause))
	end
	for roomId, flood in floods do
		local room = grid:Room(roomId)
		table.insert(lines, string.format("flood %s %s: level %.1f, %s, pours on in %.0f s (%s)", roomId, if room then room.Type else "?",
			flood.Level, if flood.Pipe then "the pipe is running" else "no pipe", math.max(flood.NextSpread - t, 0), flood.Cause))
	end
	for roomId, gas in gases do
		local room = grid:Room(roomId)
		table.insert(lines, string.format("gas %s %s: strength %.1f, %s (%s)", roomId, if room then room.Type else "?", gas.Strength,
			if gas.Leaking then string.format("leaking for %.0f s more", gas.EndsAt - t) else "airing out", gas.Cause))
	end
	for id, leak in leaks do
		local count = 0
		for _ in leak.Units do
			count += 1
		end
		table.insert(lines, string.format("radiation %s: %s, strength %.1f over %d units, %s%s (%s)", id, leakWhere(leak), leak.Strength, count,
			if leak.Leaking then string.format("leaking for %.0f s more", leak.EndsAt - t) else "fading",
			if workingDecon() then ", a Decon Room slows it" else "", leak.Cause))
	end
	if outbreak then
		local names = {}
		for _, resident in sickResidents() do
			table.insert(names, `{resident.Id} {resident.First}{if resident.Job == nil then " (off work)" else ""}`)
		end
		table.insert(lines, string.format("outbreak %s (%s): %d sick: %s; patient %s, cure %.0f of %.0f s, %d working Medbays, spreads in %.0f s",
			outbreak.Id, outbreak.Cause, #names, table.concat(names, ", "), tostring(outbreak.Patient), outbreak.Cure,
			Disasters.CureSeconds(cureSpeed()), workingMedbays(), math.max(outbreak.NextSpread - t, 0)))
	end
	do
		local door = grid:RoomsOfType("BlastDoor")[1]
		local era = table.find(Config.Ids("Eras"), clock:Era()) or 1
		if door then
			table.insert(lines, string.format("the Blast Door: level %d, %d/%d HP: a storm leaks %.0f%% of the time in era %d", door.Level, door.HP,
				door.MaxHP, Disasters.DoorLeakChance(era, door.Level, if door.MaxHP > 0 then door.HP / door.MaxHP else 0, door.Wrecked == true) * 100, era))
		end
	end
	if surgeDisaster then
		table.insert(lines, `this Surge's disaster: {surgeDisaster.Kind} {surgeDisaster.Id or "(starting)"}`)
	end
	table.insert(lines, `holds the Surge: {DisasterService:HoldsSurge()}`)
	return table.concat(lines, "\n")
end

local function roomArg(arg: any): string?
	local text = tostring(arg or "")
	if grid:Room(text) then
		return text
	end
	local ofType = grid:RoomsOfType(text)[1]
	return if ofType then ofType.Id else nil
end

local function registerCommands(dev: any)
	dev:Register("flood", {
		Description = "Burst a pipe in a room (by id or type), or just pour water in (nopipe).",
		Usage = "flood <roomId|RoomType> [level] [nopipe]",
		Run = function(_player, args): string?
			local roomId = roomArg(args[1])
			if not roomId then
				return "usage: flood <roomId|RoomType> [level] [nopipe]"
			end
			local id = DisasterService:StartFlood(roomId, "DevTools", tonumber(args[2]), args[3] ~= "nopipe" and args[2] ~= "nopipe")
			return if id then describe() else "no such room"
		end,
	})
	dev:Register("flood.patch", {
		Description = "Patch a room's burst pipe, or every pipe.",
		Usage = "flood.patch [roomId|RoomType]",
		Run = function(player, args): string?
			local only = if args[1] then roomArg(args[1]) else nil
			for roomId in table.clone(floods) do
				if only == nil or roomId == only then
					DisasterService:PatchPipe(roomId, "DevTools", player)
				end
			end
			return describe()
		end,
	})
	dev:Register("flood.drain", {
		Description = "Dry a room at once, or every room.",
		Usage = "flood.drain [roomId|RoomType]",
		Run = function(_player, args): string?
			local only = if args[1] then roomArg(args[1]) else nil
			for roomId in table.clone(floods) do
				if only == nil or roomId == only then
					DisasterService:Drain(roomId, "DevTools")
				end
			end
			return describe()
		end,
	})
	dev:Register("gas", {
		Description = "A gas leak in a room (by id or type).",
		Usage = "gas <roomId|RoomType> [strength]",
		Run = function(_player, args): string?
			local roomId = roomArg(args[1])
			if not roomId then
				return "usage: gas <roomId|RoomType> [strength]"
			end
			local id = DisasterService:StartGasLeak(roomId, "DevTools", tonumber(args[2]))
			return if id then describe() else "no such room, or it is already leaking there"
		end,
	})
	dev:Register("gas.seal", {
		Description = "Seal a room's leaking vent, or every one.",
		Usage = "gas.seal [roomId|RoomType]",
		Run = function(player, args): string?
			local only = if args[1] then roomArg(args[1]) else nil
			for roomId in table.clone(gases) do
				if only == nil or roomId == only then
					DisasterService:SealVent(roomId, "DevTools", player)
				end
			end
			return describe()
		end,
	})
	dev:Register("gas.clear", {
		Description = "Clear a room's gas at once, or every room's.",
		Usage = "gas.clear [roomId|RoomType]",
		Run = function(_player, args): string?
			local only = if args[1] then roomArg(args[1]) else nil
			for roomId in table.clone(gases) do
				if only == nil or roomId == only then
					DisasterService:ClearGas(roomId, "DevTools")
				end
			end
			return describe()
		end,
	})
	dev:Register("pocket", {
		Description = "A hazard pocket bursts at a cell (gas or water by its depth band), as if the invoking player dug it.",
		Usage = "pocket <floor> <column>",
		Run = function(player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: pocket <floor> <column>"
			end
			local kind = DisasterService:HazardPocket(floor, column, player)
			return `a hazard pocket at {floor},{column}: {kind or "nothing (no gas or water in that band)"}\n{describe()}`
		end,
	})
	dev:Register("leak", {
		Description = "A radiation leak: with no room, the storm through the Blast Door (its whole floor); with a room, a crystal seam there.",
		Usage = "leak [roomId|RoomType] [strength]",
		Run = function(_player, args): string?
			local roomId = if args[1] and args[1] ~= "door" then roomArg(args[1]) else nil
			if args[1] and args[1] ~= "door" and not roomId then
				return `no room {args[1]}`
			end
			local id = DisasterService:StartRadiationLeak("Dev", roomId, tonumber(args[2]))
			return `{id or "no leak (one is on there already, or no Blast Door)"}\n{describe()}`
		end,
	})
	dev:Register("leak.storm", {
		Description = "Roll the storm against the Blast Door now, as each Surge does.",
		Run = function(): string?
			stormAtTheDoor()
			return describe()
		end,
	})
	dev:Register("leak.seal", {
		Description = "Seal every radiation leak (as a player at the door or the seam).",
		Run = function(player): string?
			local n = 0
			for id in table.clone(leaks) do
				if DisasterService:SealLeak(id, "Sealed", player) then
					n += 1
				end
			end
			return `{n} sealed\n{describe()}`
		end,
	})
	dev:Register("leak.clear", {
		Description = "End every radiation leak at once.",
		Run = function(): string?
			local n = 0
			for _, leak in table.clone(leaks) do
				endLeak(leak, "Dev")
				n += 1
			end
			return `{n} cleared`
		end,
	})
	dev:Register("outbreak", {
		Description = "Start an outbreak (or add a carrier): a resident id, or one picked for you.",
		Usage = "outbreak [residentId]",
		Run = function(_player, args): string?
			local id = DisasterService:StartOutbreak("Dev", if args[1] then tostring(args[1]) else nil)
			return `{id or "no outbreak (nobody well to carry it)"}\n{describe()}`
		end,
	})
	dev:Register("outbreak.cure", {
		Description = "Cure a sick resident, or all of them.",
		Usage = "outbreak.cure [residentId|all]",
		Run = function(player, args): string?
			local n = 0
			for _, resident in sickResidents() do
				if args[1] == nil or args[1] == "all" or args[1] == resident.Id then
					if DisasterService:Cure(resident.Id, "Dev", player) then
						n += 1
					end
				end
			end
			return `{n} cured\n{describe()}`
		end,
	})
	dev:Register("outbreak.deep", {
		Description = "A resident comes in from the Deep: roll for the sickness (force: a carrier for sure).",
		Usage = "outbreak.deep <residentId> [force]",
		Run = function(_player, args): string?
			local id = tostring(args[1] or "")
			if args[2] == "force" then
				return `{DisasterService:StartOutbreak("TheDeep", id) or "no"}\n{describe()}`
			end
			return `carrier: {DisasterService:FromTheDeep(id, "Dev")}\n{describe()}`
		end,
	})
	dev:Register("disasters", {
		Description = "Every disaster now: fires, the blackout, rubble, the meltdown, electrical surges.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("fire", {
		Description = "Start a fire in a room (by id or type).",
		Usage = "fire <roomId|RoomType> [strength]",
		Run = function(_player, args): string?
			local roomId = roomArg(args[1])
			if not roomId then
				return "usage: fire <roomId|RoomType> [strength]"
			end
			local id = DisasterService:StartFire(roomId, "DevTools", tonumber(args[2]))
			return if id then describe() else "it can't burn there (no such room, fireproof, or already burning)"
		end,
	})
	dev:Register("fire.out", {
		Description = "Put out a room's fire, or every fire.",
		Usage = "fire.out [roomId|RoomType]",
		Run = function(_player, args): string?
			local only = if args[1] then roomArg(args[1]) else nil
			for roomId, fire in table.clone(fires) do
				if only == nil or roomId == only then
					putOut(fire, "DevTools")
				end
			end
			return describe()
		end,
	})
	dev:Register("blackout", {
		Description = "A blackout on a floor, or the whole grid.",
		Usage = "blackout [floor|grid]",
		Run = function(_player, args): string?
			local floor = tonumber(args[1])
			if not floor and args[1] ~= "grid" then
				floor = (grid:RoomsOfType("ReactorCore")[1] or { Floor = 2 }).Floor
			end
			local id = DisasterService:StartBlackout(floor, "DevTools")
			return if id then describe() else "nothing to darken there"
		end,
	})
	dev:Register("blackout.end", {
		Description = "End the blackout, as if the fuse box were reset.",
		Run = function(): string?
			DisasterService:EndBlackout("DevTools")
			return describe()
		end,
	})
	dev:Register("cavein", {
		Description = "Rubble falls: in a doorway (side Left or Right of the cell) or filling a dug cell.",
		Usage = "cavein <floor> <column> [Left|Right]",
		Run = function(_player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: cavein <floor> <column> [Left|Right]"
			end
			local side = if args[3] then tostring(args[3]) else nil
			if side then
				side = string.upper(string.sub(side, 1, 1)) .. string.lower(string.sub(side, 2))
			end
			local id, why = DisasterService:CaveIn(floor, column, side, "DevTools")
			return if id then describe() else `no cave-in: {why}`
		end,
	})
	dev:Register("rubble.clear", {
		Description = "Clear rubble (by id, or all of it).",
		Usage = "rubble.clear [id]",
		Run = function(_player, args): string?
			for id in table.clone(rubble) do
				if args[1] == nil or id == tostring(args[1]) then
					DisasterService:ClearRubble(id, "DevTools")
				end
			end
			return describe()
		end,
	})
	dev:Register("meltdown", {
		Description = "Start a Reactor meltdown (as if the Reactor Core reached 0 HP, without the damage).",
		Run = function(): string?
			return if DisasterService:StartMeltdown("DevTools") then describe() else "no meltdown (one is on, no Reactor Core, or the run isn't playing)"
		end,
	})
	dev:Register("meltdown.stop", {
		Description = "Stop the meltdown, as if the valves were turned.",
		Run = function(): string?
			endMeltdown("DevTools")
			return describe()
		end,
	})
	dev:Register("valve", {
		Description = "Turn a meltdown valve as a player would (held: a team keeps holding it).",
		Usage = "valve <1|2|3> [held|release]",
		Run = function(_player, args): string?
			local m = meltdown
			local i = tonumber(args[1])
			if not m or not i or not m.Valves[i] then
				return "usage: valve <1|2|3> [held|release] during a meltdown"
			end
			if args[2] == "release" then
				m.Valves[i] = Disasters.ValveReleased(m.Valves[i], playerCount(), now())
			else
				m.Valves[i] = Disasters.ValveTurned(playerCount(), now())
			end
			publishMeltdown(m)
			return describe()
		end,
	})
	dev:Register("esurge", {
		Description = "An electrical surge in a room (by id or type).",
		Usage = "esurge <roomId|RoomType>",
		Run = function(_player, args): string?
			local roomId = roomArg(args[1])
			local id = if roomId then DisasterService:StartElectricalSurge(roomId, "DevTools") else nil
			return if id then describe() else "usage: esurge <roomId|RoomType> (not the Shaft, one per room)"
		end,
	})
	dev:Register("disaster.surge", {
		Description = "Start a Surge's disaster now (Fire or Blackout; random when not given).",
		Usage = "disaster.surge [Fire|Blackout]",
		Run = function(_player, args): string?
			local kind = if args[1] then tostring(args[1]) else Disasters.SurgePick(1, math.huge, rng) or "Fire"
			local id = startKind(kind, "Surge")
			return if id then describe() else `couldn't start {kind}`
		end,
	})
end

-- Lifecycle ---------------------------------------------------------------------------------------------

function DisasterService:Init(registry)
	grid = registry.BunkerGrid
	power = registry.PowerService
	clock = registry.CycleClock
	director = registry.RunDirector
	combat = registry.CombatService
	weapons = registry.WeaponService
	residents = registry.ResidentService
	builds = registry.BuildService
	session = registry.SessionService
	collection = registry.ReplicationService:Collection("Disasters")
	set = RunState.Writer("DisasterService")
	registerCommands(registry.DevService)
end

function DisasterService:Start()
	Hazards.Clear()
	-- Prompt 26: a Clumsy resident's accident ("a minor fire or flood in their room"): half a fire's
	-- starting strength, or a puddle with no burst pipe to patch
	residents.Accident:Connect(function(residentId: string, roomId: string)
		local person = residents:Get(residentId)
		local who = if person then ResidentRules.Name(person) else "a resident"
		local d = Config.Get("Tuning", "Disasters")
		local ok, err = pcall(function()
			if rng:NextNumber() < 0.5 then
				DisasterService:StartFire(roomId, "Clumsy", d.Fire.StartStrength * 0.5)
			else
				DisasterService:StartFlood(roomId, "Clumsy", d.Flood.ResidentFleeLevel * 0.5, false)
			end
		end)
		if not ok then
			log:Warn("%s's accident in %s: %s", who, roomId, tostring(err))
		else
			log:Info("%s had an accident in %s", who, roomId)
		end
	end)
	-- Section 10 (Landon, 2026-11-08): a Reactor Core at 0 HP starts the meltdown
	grid.Wrecked:Connect(function(roomId: string)
		local room = grid:Room(roomId)
		if room and room.Type == "ReactorCore" then
			DisasterService:StartMeltdown("ReactorDestroyed")
		end
	end)
	grid.RoomChanged:Connect(function(roomId: string)
		if not grid:Room(roomId) then
			local fire = fires[roomId]
			if fire then
				putOut(fire, "Gone")
			end
			local s = surges[roomId]
			if s then
				endSurge(s, "Gone")
			end
			local flood = floods[roomId]
			if flood then
				endFlood(flood, "Gone")
			end
			local gas = gases[roomId]
			if gas then
				endGas(gas, "Gone")
			end
		end
	end)
	grid.Changed:Connect(onGridChanged)
	-- Prompt 24: the storm that comes with every Surge may get through a weak Blast Door
	clock.SurgeStarted:Connect(function()
		local ok, err = pcall(stormAtTheDoor)
		if not ok then
			log:Warn("storm at the door: %s", tostring(err))
		end
	end)
	weapons.ToolTick:Connect(onToolTick)
	weapons.Foamed:Connect(onFoamed)
	weapons.Swung:Connect(onSwung)
	builds.Repaired:Connect(function(roomId: string, _amount: number, how: string, player: Player?)
		local s = surges[roomId]
		if s and how == "Welder" then
			endSurge(s, "Fixed", player)
		end
	end)
	clock.SurgeEnded:Connect(function()
		surgeDisaster = nil
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		local step = Disasters.Tuning().TickSeconds
		if acc >= step then
			local elapsed = math.min(acc, 1)
			acc = 0
			local ok, err = pcall(tick, elapsed)
			if not ok then
				log:Warn("tick: %s", tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if meltdown then
			meltdown.Sent = "" -- the solo rule may change: send the valves again
		end
	end)
	publishCounts()
	log:Info("disasters ready")
end

return DisasterService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000101"><Properties><string name="Name">DraftService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DraftService: the blueprint draft (bible Section 8, the Appendix's card pool; Prompt 19). Run
	place only.

	* After every Surge (CycleClock.SurgeEnded) it draws Tuning.Draft.Cards (3) cards from the pool
	  (Rules.Draft: weighted, room cards heavier in Era I) and opens the team's draft vote
	  (VoteService, Config.Votes.Draft: most picks after 20 s, ties at random). The vote telegram
	  shows the cards under the year clock (Landon, Prompt 19). Solo runs pick too: the player's
	  pick is the card (Section 8, rule 6). The winning card applies at once and leaves the pool for
	  the run; the others go back.
	* Only cards the run can use come up: each of its modifiers has a home below (HANDLERS), a room
	  card's room isn't unlocked yet, the Steel Blast Door only below the door's top level. Cards
	  whose systems come with later prompts (Ammo Press and Black Market: Prompt 30) stay out until
	  their handlers exist.
	* What each card does (Config.Modifiers names the system):
	  * Room cards unlock their room (BuildService:Unlock).
	  * Bunker perks: RoomHP (BunkerGrid), FireSpread, BlackoutDuration, FloodDrainSpeed and
	    GasStrength (DisasterService),
	    DarkSpawnBonus (BreachService), BlastDoorLevel (the Blast Door goes up a level).
	  * Resident boons: ResidentLevels and MoraleNow (ResidentService), RecruitsNow and
	    RareRecruitNow (ExpeditionService:Recruit at the Blast Door).
	  * Player boons: WeaponRarityUp and StaminaMult (WeaponService; they hold for the rest of the
	    run, players who join later included), MedkitsPerPlayer (carried Medkits for everyone in the
	    run now).
	  * Risk deals: DigSpeed and DigDisturbance (DigService), RoomOutput on the Reactor Core
	    (EconomyService, which PowerService reads) and ReactorOverloadChance (each Surge, that
	    chance of the Reactor overload: DisasterService:StartMeltdown, OverloadDelay into the
	    Surge), BountyKills and BountyScrap (monster kills counted until the next Surge starts;
	    met, the Scrap is paid at once), NextTripLoot and NextStormEarlySeconds (SurfaceService:
	    double loot until the next storm, which hits that many seconds before its Surge).
	* Found blueprints (Landon, Prompt 19): a blueprint in loot is one card, drawn from the pool
	  when it's found (InventoryService's "Blueprint" special). Found on the surface or in the
	  Deep it goes into the finder's pack and counts once unloaded (InventoryService.CardsHome);
	  found in the bunker (a dug cache) or brought home by an expedition it is home at once. A card
	  that's home joins the next draft as an extra choice, FoundPerDraft at a time, stamped with
	  who found it; the team still votes, and if it isn't picked it goes back to the pool. A card
	  drafted meanwhile is swapped for another when it comes home.
	* Rerolls: RerollDraft (the remote) uses a free reroll, FreeDraftRerollsPerEra (the level 3
	  Mad Scientist: one per era). The paid Blueprint Reroll (49 Robux) is Prompt 28's and calls
	  Reroll(player, "Paid"). A reroll draws fresh cards (the found one stays), clears the picks
	  and starts the time over. Players carry DraftRerolls (free rerolls left this era).

	API:
		DraftService:Open(): (string?, string?)               -- a draft now (dev; normally after a Surge)
		DraftService:Reroll(player, how): (boolean, string?)  -- "Free" or "Paid"
		DraftService:AddFound(cardId?, by?, how): string?     -- a found blueprint is home
		DraftService:Take(cardId, how): boolean               -- apply a card (the vote's winner)
		DraftService:Taken(): { string }                      -- cards taken this run, in order
		DraftService.Drafted: Signal<string, string>          -- card id, how ("Draft", "Dev")
		DraftService.FoundHome: Signal<string, string>        -- card id, who or what found it
	Dev: draft, draft.open, draft.take <card>, draft.found [card], draft.reroll, draft.cards, bounty.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Draft = require(Shared.Rules.Draft)
local Expeditions = require(Shared.Rules.Expeditions)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("DraftService")

local DraftService = {
	Name = "DraftService",
	Dependencies = {
		"CycleClock", "RunDirector", "SessionService", "VoteService", "BuildService", "BunkerGrid", "EconomyService",
		"DisasterService", "DigService", "BreachService", "ResidentService", "ExpeditionService", "WeaponService",
		"SurfaceService", "MonsterService", "InventoryService", "DevService",
	},
	Drafted = Signal.new() :: Signal.Signal<string, string>,
	FoundHome = Signal.new() :: Signal.Signal<string, string>,
}

type Found = { Card: string, By: string, UserId: number? }
type Current = { VoteId: string, Drawn: { string }, Found: Found? }

local clock: any = nil
local director: any = nil
local session: any = nil
local votes: any = nil
local build: any = nil
local grid: any = nil
local economy: any = nil
local disasters: any = nil
local dig: any = nil
local breaches: any = nil
local residents: any = nil
local expeditions: any = nil
local weapons: any = nil
local surface: any = nil
local monsters: any = nil
local inventory: any = nil

local taken: { [string]: boolean } = {}
local takenOrder: { string } = {}
local waiting: { Found } = {} -- found blueprints home, waiting for a draft
local current: Current? = nil
local rerollsUsed: { [number]: { [string]: number } } = {} -- UserId -> era -> free rerolls used
local overload: { [string]: number } = {} -- card -> chance of a Reactor overload each Surge
local bounty: { Need: number, Scrap: number, Kills: number, Card: string }? = nil
local rng = Random.new()

local function alertAll(kind: string, text: string)
	for _, player in Players:GetPlayers() do
		Remotes.FireClient("Alert", player, kind, text)
	end
end

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function eraNumber(): number
	local era = Config.Find("Eras", clock:Era())
	return if era then era.Number else 1
end

local function blastDoor(): any
	return grid:RoomsOfType("BlastDoor")[1]
end

-- Modifier homes ----------------------------------------------------------------------------------

-- How each modifier a card carries is applied: (value, the modifier, the card's id). A card is
-- offered only when every one of its keys is here.
local HANDLERS: { [string]: (number, { [string]: any }, string) -> () } = {
	RoomHP = function(value, _m, card)
		grid:SetHPModifier(card, "RoomHP", value)
	end,
	FireSpread = function(value, _m, card)
		disasters:SetModifier(card, "FireSpread", value)
	end,
	BlackoutDuration = function(value, _m, card)
		disasters:SetModifier(card, "BlackoutDuration", value)
	end,
	FloodDrainSpeed = function(value, _m, card) -- Prompt 23
		disasters:SetModifier(card, "FloodDrainSpeed", value)
	end,
	GasStrength = function(value, _m, card)
		disasters:SetModifier(card, "GasStrength", value)
	end,
	DarkSpawnBonus = function(value, _m, card)
		breaches:SetModifier(card, "DarkSpawnBonus", value)
	end,
	BlastDoorLevel = function(value)
		local door = blastDoor()
		if door then
			local level = math.min(door.Level + math.floor(value), 3)
			grid:SetLevel(door.Id, level)
			alertAll("Info", `THE BLAST DOOR IS NOW LEVEL {level}`)
		end
	end,
	ResidentLevels = function(value, _m, card)
		residents:AddLevels(math.floor(value), Config.Get("DraftCards", card).Name)
	end,
	MoraleNow = function(value, _m, card)
		residents:AddMorale(value, Config.Get("DraftCards", card).Name)
	end,
	RecruitsNow = function(value, _m, card)
		local name = Config.Get("DraftCards", card).Name
		local chance = Config.Get("Tuning", "Expeditions").RadioRareChance
		for _ = 1, math.floor(value) do
			expeditions:Recruit(Expeditions.RecruitTier(rng:NextNumber(), chance), `answered the {name}`)
		end
	end,
	RareRecruitNow = function(value, _m, card)
		local name = Config.Get("DraftCards", card).Name
		for _ = 1, math.floor(value) do
			expeditions:Recruit("Rare", `joined as a {name}`)
		end
	end,
	WeaponRarityUp = function(value, _m, card)
		weapons:SetModifier(card, "WeaponRarityUp", value)
	end,
	StaminaMult = function(value, _m, card)
		weapons:SetModifier(card, "StaminaMult", value)
	end,
	MedkitsPerPlayer = function(value)
		for _, player in session:ReadyPlayers() do
			weapons:AddMedkits(player, math.floor(value))
		end
	end,
	DigSpeed = function(value, _m, card)
		dig:SetModifier(card, "DigSpeed", value)
	end,
	DigDisturbance = function(value, _m, card)
		dig:SetModifier(card, "DigDisturbance", value)
	end,
	RoomOutput = function(value, m, card)
		economy:SetModifier(card, "RoomOutput", value, m.Room)
	end,
	ReactorOverloadChance = function(value, _m, card)
		overload[card] = value
	end,
	BountyKills = function(value, _m, card)
		local b = bounty or { Need = 0, Scrap = 0, Kills = 0, Card = card }
		b.Need = math.floor(value)
		b.Card = card
		bounty = b
	end,
	BountyScrap = function(value, _m, card)
		local b = bounty or { Need = 0, Scrap = 0, Kills = 0, Card = card }
		b.Scrap = math.floor(value)
		bounty = b
	end,
	NextTripLoot = function(value)
		surface:SetLootBoost(value)
	end,
	NextStormEarlySeconds = function(value)
		surface:SetStormEarly(value)
	end,
}

-- Can the run use this card now?
local function usable(card: { [string]: any }): boolean
	for _, m in card.Modifiers or {} do
		if not HANDLERS[m.Key] then
			return false
		end
	end
	if card.Kind == "Room" then
		return card.Room ~= nil and not build:Unlocked()[card.Room]
	end
	for _, m in card.Modifiers or {} do
		if m.Key == "BlastDoorLevel" then
			local door = blastDoor()
			if not door or door.Level >= 3 then
				return false
			end
		end
	end
	return true
end

local function heldBack(): { [string]: boolean }
	local held: { [string]: boolean } = {}
	for _, f in waiting do
		held[f.Card] = true
	end
	if current then
		for _, id in current.Drawn do
			held[id] = true
		end
		if current.Found then
			held[current.Found.Card] = true
		end
	end
	return held
end

-- Applying a card ----------------------------------------------------------------------------------

function DraftService:Take(cardId: string, how: string): boolean
	local card = Config.Find("DraftCards", cardId)
	if not card or taken[cardId] then
		return false
	end
	taken[cardId] = true
	table.insert(takenOrder, cardId)
	if card.Kind == "Room" and card.Room then
		build:Unlock(card.Room)
	end
	for _, m in card.Modifiers or {} do
		local handler = HANDLERS[m.Key]
		if handler then
			local ok, err = pcall(handler, m.Value, m, cardId)
			if not ok then
				log:Error("%s: %s failed: %s", cardId, m.Key, tostring(err))
			end
		else
			log:Warn("%s: nothing applies %s yet", cardId, m.Key)
		end
	end
	if bounty and bounty.Card == cardId and bounty.Need > 0 then
		alertAll("Info", `BOUNTY: KILL {bounty.Need} MONSTERS BEFORE THE NEXT SURGE FOR {bounty.Scrap} SCRAP`)
	end
	log:Info("%s taken (%s)", cardId, how)
	DraftService.Drafted:Fire(cardId, how)
	return true
end

function DraftService:Taken(): { string }
	return table.clone(takenOrder)
end

-- Found blueprints ---------------------------------------------------------------------------------

-- A card for a blueprint just found (nil when the pool has nothing left to find).
local function drawFound(): string?
	local pool = Draft.Pool(taken, heldBack(), usable)
	return Draft.Draw(pool, 1, eraNumber(), rng)[1]
end

function DraftService:AddFound(cardId: string?, by: string?, how: string): string?
	local card = cardId
	if card and (taken[card] or heldBack()[card] or not Config.Find("DraftCards", card) or not usable(Config.Get("DraftCards", card))) then
		card = nil -- drafted meanwhile, or already waiting: another card
	end
	card = card or drawFound()
	if not card then
		log:Info("a blueprint came home (%s), but the pool has no card left for it", how)
		return nil
	end
	local finder = by or how
	table.insert(waiting, { Card = card, By = finder })
	local face = Draft.Face(card)
	alertAll("Info", `BLUEPRINT HOME: {string.upper(face.Name)} JOINS THE NEXT DRAFT`)
	log:Info("found blueprint %s home (%s, %s)", card, finder, how)
	DraftService.FoundHome:Fire(card, finder)
	return card
end

-- Drafts --------------------------------------------------------------------------------------------

local function optionFor(id: string, found: Found?): any
	local face = Draft.Face(id)
	return {
		Id = id,
		Title = string.upper(face.Name),
		Kind = face.Kind,
		Label = face.Label,
		Text = face.Text,
		Found = if found then string.upper(found.By) else nil, -- the card's FOUND stamp says the rest
	}
end

local function optionsOf(c: Current): { any }
	local options = {}
	for _, id in c.Drawn do
		table.insert(options, optionFor(id, nil))
	end
	if c.Found then
		table.insert(options, optionFor(c.Found.Card, c.Found))
	end
	return options
end

local function freeRerolls(player: Player): number
	local per = Modifiers.PlayerValue(player, "FreeDraftRerollsPerEra") or 0
	local used = (rerollsUsed[player.UserId] or {})[clock:Era()] or 0
	return math.max(math.floor(per) - used, 0)
end

local function publishRerolls()
	for _, player in Players:GetPlayers() do
		local left = freeRerolls(player)
		player:SetAttribute("DraftRerolls", if left > 0 then left else nil)
	end
end

local function closeDraft(c: Current, winner: string?)
	if current ~= c then
		return
	end
	current = nil
	if c.Found and winner ~= c.Found.Card then
		log:Info("found blueprint %s wasn't picked: back to the pool", c.Found.Card)
	end
	if winner then
		if director:Phase() == "Playing" then
			DraftService:Take(winner, "Draft")
		else
			log:Info("the run ended before %s could apply", winner)
		end
	end
end

function DraftService:Open(): (string?, string?)
	if director:Phase() ~= "Playing" then
		return nil, "the run isn't under way"
	end
	if current then
		return nil, "a draft is already open"
	end
	local t = Draft.Tuning()
	local held = heldBack()
	local found: Found? = nil
	if t.FoundPerDraft > 0 and #waiting > 0 then
		-- the next found card that can still be used (drafted meanwhile or no longer usable: back to the pool)
		while #waiting > 0 and not found do
			local f = table.remove(waiting, 1) :: Found
			held[f.Card] = nil
			if not taken[f.Card] and usable(Config.Get("DraftCards", f.Card)) then
				found = f
			end
		end
	end
	local pool = Draft.Pool(taken, held, usable)
	if found then
		local at = table.find(pool, found.Card)
		if at then
			table.remove(pool, at)
		end
	end
	local drawn = Draft.Draw(pool, t.Cards, eraNumber(), rng)
	if #drawn == 0 and not found then
		log:Info("no draft: the pool is empty")
		return nil, "the pool is empty"
	end
	local c: Current = { VoteId = "", Drawn = drawn, Found = found }
	current = c
	local id, why = votes:Open({
		Kind = "Draft",
		Title = "BLUEPRINT DRAFT",
		Options = optionsOf(c),
		OnPass = function(pick: string?)
			closeDraft(c, pick)
		end,
		OnFail = function(_reason: string)
			closeDraft(c, nil)
		end,
	})
	if not id then
		current = nil
		if found then
			table.insert(waiting, 1, found)
		end
		return nil, why
	end
	c.VoteId = id
	publishRerolls()
	log:Info("draft %s: %s%s", id, table.concat(drawn, ", "), if found then ` + found {found.Card}` else "")
	return id, nil
end

function DraftService:Reroll(player: Player, how: string): (boolean, string?)
	local c = current
	if not c then
		return false, "There's no draft to reroll."
	end
	local liveId = votes:Live()
	if liveId ~= c.VoteId then
		return false, "The draft isn't on the banner yet."
	end
	if how == "Free" and freeRerolls(player) <= 0 then
		return false, "You have no free reroll left this era."
	end
	-- fresh cards: the pool without the ones showing (unless that leaves nothing new)
	local held = heldBack()
	local pool = Draft.Pool(taken, held, usable)
	if #pool == 0 then
		return false, "There are no other cards to draw."
	end
	local drawn = Draft.Draw(pool, Draft.Tuning().Cards, eraNumber(), rng)
	c.Drawn = drawn
	if not votes:SetOptions(c.VoteId, optionsOf(c)) then
		return false, "The draft can't be rerolled now."
	end
	if how == "Free" then
		local used = rerollsUsed[player.UserId] or {}
		used[clock:Era()] = (used[clock:Era()] or 0) + 1
		rerollsUsed[player.UserId] = used
	end
	publishRerolls()
	alertAll("Info", `{string.upper(player.DisplayName)} REROLLED THE BLUEPRINTS`)
	log:Info("%s rerolled the draft (%s): %s", player.Name, how, table.concat(drawn, ", "))
	return true, nil
end

-- Risk deals over time ------------------------------------------------------------------------------

local function overloadChance(): number
	local none = 1
	for _, chance in overload do
		none *= 1 - math.clamp(chance, 0, 1)
	end
	return 1 - none
end

local function onSurgeStarted()
	-- Bounty Contract: time is up
	local b = bounty
	if b and b.Need > 0 then
		alertAll("Warning", `THE BOUNTY RAN OUT: {b.Kills} OF {b.Need} KILLS`)
		log:Info("bounty expired at %d of %d", b.Kills, b.Need)
		bounty = nil
	end
	-- Overclock: this Surge's chance of a Reactor overload
	local chance = overloadChance()
	if chance > 0 and rng:NextNumber() < chance then
		local delay = Draft.Tuning().OverloadDelay
		local cycle = clock:Cycle()
		task.delay(rng:NextNumber(delay.Min, delay.Max), function()
			if clock:Cycle() == cycle and clock:Phase() == "Surge" and director:Phase() == "Playing" then
				if disasters:StartMeltdown("Overclock") then
					alertAll("Danger", "THE OVERCLOCKED REACTOR IS OVERLOADING")
				end
			end
		end)
		log:Info("Overclock: a Reactor overload this Surge (chance %.2f)", chance)
	end
end

local function onMonsterDied()
	local b = bounty
	if not b or b.Need <= 0 or director:Phase() ~= "Playing" then
		return
	end
	b.Kills += 1
	if b.Kills >= b.Need then
		local paid = economy:Add("Scrap", b.Scrap, "the Bounty Contract")
		alertAll("Info", `BOUNTY MET: {b.Need} KILLS · +{paid} SCRAP`)
		log:Info("bounty met: +%d Scrap", paid)
		bounty = nil
	elseif b.Kills % math.max(Draft.Tuning().BountyAlertEvery, 1) == 0 then
		alertAll("Info", `BOUNTY: {b.Kills} OF {b.Need} KILLS`)
	end
end

-- Lifecycle -----------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	if current then
		local found = if current.Found then ` + found {current.Found.Card} ({current.Found.By})` else ""
		table.insert(lines, `draft {current.VoteId}: {table.concat(current.Drawn, ", ")}{found}`)
	else
		table.insert(lines, "no draft open")
	end
	table.insert(lines, `taken ({#takenOrder}): {if #takenOrder > 0 then table.concat(takenOrder, ", ") else "none"}`)
	local w = {}
	for _, f in waiting do
		table.insert(w, `{f.Card} ({f.By})`)
	end
	table.insert(lines, `found, waiting: {if #w > 0 then table.concat(w, ", ") else "none"}`)
	local pool = Draft.Pool(taken, heldBack(), usable)
	table.insert(lines, `pool now ({#pool}): {table.concat(pool, ", ")}`)
	if bounty then
		table.insert(lines, `bounty: {bounty.Kills} of {bounty.Need} for {bounty.Scrap} Scrap`)
	end
	local chance = overloadChance()
	if chance > 0 then
		table.insert(lines, string.format("Reactor overload chance each Surge: %.2f", chance))
	end
	return table.concat(lines, "\n")
end

function DraftService:Init(registry)
	clock = registry.CycleClock
	director = registry.RunDirector
	session = registry.SessionService
	votes = registry.VoteService
	build = registry.BuildService
	grid = registry.BunkerGrid
	economy = registry.EconomyService
	disasters = registry.DisasterService
	dig = registry.DigService
	breaches = registry.BreachService
	residents = registry.ResidentService
	expeditions = registry.ExpeditionService
	weapons = registry.WeaponService
	surface = registry.SurfaceService
	monsters = registry.MonsterService
	inventory = registry.InventoryService

	-- found blueprints: a card goes into the finder's pack (surface, the Deep), or straight home (the bunker)
	inventory:SetSpecial("Blueprint", function(player: Player, count: number): number
		local took = 0
		for _ = 1, count do
			local card = drawFound()
			if not card then
				return count -- nothing left to find: the blueprint is taken, as nothing
			end
			if surface:Zone(player) == "Bunker" then
				DraftService:AddFound(card, player.DisplayName, "found in the bunker")
				took += 1
			elseif inventory:GiveCard(player, card) then
				took += 1
				alert(player, "Info", `BLUEPRINT: {string.upper(Draft.Face(card).Name)} · HAUL IT HOME FOR THE NEXT DRAFT`)
			end
		end
		return took
	end)

	Remotes.OnServer("RerollDraft", function(player: Player, voteId: string)
		if not current or current.VoteId ~= voteId then
			alert(player, "Info", "That draft is over.")
			return
		end
		local ok, why = DraftService:Reroll(player, "Free")
		if not ok and why then
			alert(player, "Info", why)
		end
	end)

	local dev = registry.DevService
	dev:Register("draft", {
		Description = "The draft: the open one, cards taken, found blueprints waiting, the pool (Prompt 19).",
		Usage = "draft",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("draft.open", {
		Description = "Open a draft now (normally one opens after every Surge).",
		Usage = "draft.open",
		Run = function(): string?
			local id, why = DraftService:Open()
			return if id then `opened {id}\n{describe()}` else `no draft: {why}`
		end,
	})
	dev:Register("draft.take", {
		Description = "Apply a card now, as if the team had drafted it.",
		Usage = "draft.take <card id>",
		Run = function(_player: Player?, args): string?
			local id = tostring(args[1] or "")
			local card = Config.Find("DraftCards", id)
			if not card then
				return `no card {id}; ids: {table.concat(Config.Ids("DraftCards"), ", ")}`
			end
			if taken[id] then
				return `{id} is already taken`
			end
			if not usable(card) then
				return `{id} can't be used now (its system comes later, its room is unlocked, or the door is at its top level)`
			end
			DraftService:Take(id, "Dev")
			return describe()
		end,
	})
	dev:Register("draft.found", {
		Description = "A found blueprint is home (a card, else one drawn): it joins the next draft.",
		Usage = "draft.found [card id]",
		Run = function(player: Player?, args): string?
			local card = DraftService:AddFound(if args[1] then tostring(args[1]) else nil,
				if player then player.DisplayName else "the dev tools", "dev")
			return if card then `found {card}\n{describe()}` else "no card left to find"
		end,
	})
	dev:Register("draft.reroll", {
		Description = "Reroll the live draft as you (a free reroll, or 'paid' to skip the class check).",
		Usage = "draft.reroll [paid]",
		Run = function(player: Player?, args): string?
			local who = player or session:ReadyPlayers()[1]
			if not who then
				return "nobody is in the run"
			end
			local ok, why = DraftService:Reroll(who, if tostring(args[1] or "") == "paid" then "Paid" else "Free")
			return if ok then describe() else `no reroll: {why}`
		end,
	})
	dev:Register("draft.cards", {
		Description = "Every card: kind, weight now, usable, taken.",
		Usage = "draft.cards",
		Run = function(): string?
			local lines = {}
			for _, id in Config.Ids("DraftCards") do
				local card = Config.Get("DraftCards", id)
				table.insert(lines, `{id} ({card.Kind}) w{Draft.Weight(card, eraNumber())}{if taken[id] then " taken" elseif usable(card) then "" else " not usable"}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("bounty", {
		Description = "Bounty Contract progress, or add kills to it.",
		Usage = "bounty [kills to add]",
		Run = function(_player: Player?, args): string?
			if not bounty then
				return "no bounty"
			end
			for _ = 1, math.clamp(math.floor(tonumber(args[1]) or 0), 0, 100) do
				onMonsterDied()
			end
			return if bounty then `bounty: {bounty.Kills} of {bounty.Need} for {bounty.Scrap} Scrap` else "bounty met"
		end,
	})
end

function DraftService:Start()
	clock.SurgeEnded:Connect(function(_kind: string, _how: string)
		-- after the final Surge the run is over (CenturySurvived): no draft
		task.defer(function()
			if director:Phase() == "Playing" then
				local _, why = DraftService:Open()
				if why then
					log:Debug("no draft after the Surge: %s", why)
				end
			end
		end)
	end)
	clock.SurgeStarted:Connect(onSurgeStarted)
	clock.EraChanged:Connect(publishRerolls)
	monsters.Died:Connect(onMonsterDied)
	inventory.CardsHome:Connect(function(player: Player, cards: { string })
		for _, card in cards do
			DraftService:AddFound(card, player.DisplayName, "hauled home")
		end
	end)
	expeditions.BlueprintsHome:Connect(function(count: number, destination: string)
		for _ = 1, count do
			DraftService:AddFound(nil, if destination == "Deep" then "the Deep expedition" else "the surface expedition", "an expedition")
		end
	end)
	session.PlayerReady:Connect(function(_player: Player)
		publishRerolls()
	end)
	for _, player in Players:GetPlayers() do
		player:GetAttributeChangedSignal("ClassLevel"):Connect(publishRerolls)
		player:GetAttributeChangedSignal("Class"):Connect(publishRerolls)
	end
	Players.PlayerAdded:Connect(function(player: Player)
		player:GetAttributeChangedSignal("ClassLevel"):Connect(publishRerolls)
		player:GetAttributeChangedSignal("Class"):Connect(publishRerolls)
	end)
	RunState.Changed("RunPhase"):Connect(function()
		if RunState.Get("RunPhase") ~= "Playing" then
			bounty = nil
		end
	end)
end

return DraftService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000102"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	EconomyService: the team's shared stockpile, production, consumption and caps (bible
	Sections 5, 13 and 23). Run place only.

	* The stockpile (Prompt 8): every stocked resource in Config.Resources starts at its Start
	  amount (Section 6). Caps: each resource's Cap plus CapPerStorageCell for every Storage
	  cell, times bunker-wide StockpileCaps modifiers (the Quartermaster, Prompt 20). Adding
	  stops at the cap; a stock above a lower cap keeps what it has but can't grow.
	* Production (Prompt 9): rooms make things all the time while the run clock runs (Section
	  5). A room's output per cycle is Rules.Economy.Output, Section 13's formula, from its crew,
	  level and span, whether it is lit (PowerService pushes the dark rooms in with SetPowered)
	  and bunker-wide modifiers (RoomOutput, AllOutput; the difficulty's ResourceMultiplier on
	  stock). Whole units go into the stockpile as they are made; the fractions carry over. Lab
	  research adds to Research. Outputs that aren't stock (the Lounge's morale, the Radio
	  Room's recruits, training, crafting, thawing, decon) get a rate here for the systems that
	  use them later (Rate).
	* Consumption (Prompt 9): at the start of every cycle each resident eats FoodPerCycle Food
	  (times their FoodUse and bunker-wide FoodUse) and drinks WaterPerCycle Water
	  (Tuning.Residents). If the stockpile can't cover it, it gives what it has, Shortfall fires
	  with what was missing (ResidentService makes the hungry pay in health and morale, Prompt 10)
	  and the team gets an alert.
	* The crew and the eaters come from ResidentService (Prompt 10) through SetResidents. Until
	  then nobody works or eats unless DevTools staffs rooms (`staff`) or seats eaters (`eaters`).
	* Replication: amounts are RunState values (one per resource, plus Research); every room
	  that makes something is in the Production collection: id -> { Rate (per cycle), Makes
	  (a resource id or an Output kind), Idle ("NoCrew", "Dark", "Wrecked" or nil), Workers }.

	API:
		EconomyService:Get(id), :Stock(), :Cap(id), :CanAfford(costs), :Spend(costs, reason)
		EconomyService:Add(id, amount, reason): number    -- what was added (the cap stops it)
		EconomyService:Research(), :AddResearch(amount)
		EconomyService:SetResidents(source)             -- ResidentService: { Crew = fn(roomId), Eaters = fn() }
		EconomyService:RefreshCrew()                    -- ResidentService: a crew changed
		EconomyService:Crew(roomId): Crew?
		EconomyService:SetPowered(dark)                 -- PowerService: the dark rooms
		EconomyService:Rate(roomId): (number, string?, string?)  -- per cycle, what, why idle
		EconomyService:SetModifier(source, key, value?, room?)   -- bunker-wide; nil clears; room: a type or a room id
		EconomyService:Multiplier(key, roomType?, roomId?), :OutputMultiplier(roomType, roomId?)
		EconomyService.Changed: Signal<string>            -- a resource id, or "Research"
		EconomyService.CrewChanged: Signal<()>            -- crews or output modifiers changed
		EconomyService.Ate: Signal<number, taken, missing>       -- cycle, what was taken, what was short
		EconomyService.Shortfall: Signal<{ [string]: number }>      -- what was missing
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Economy = require(Shared.Rules.Economy)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("EconomyService")
local set = RunState.Writer("EconomyService")

export type Crew = Economy.Crew
export type Eater = { Id: string, FoodUse: number? }
export type Residents = {
	Crew: (roomId: string) -> Crew?,
	Eaters: () -> { Eater },
}

type RoomRate = { Rate: number, Makes: string?, Resource: string?, Idle: string?, Workers: number }

local EconomyService = {
	Name = "EconomyService",
	Dependencies = { "BunkerGrid", "CycleClock", "SessionService", "ReplicationService", "DevService" },
	Changed = Signal.new() :: Signal.Signal<string>,
	CrewChanged = Signal.new() :: Signal.Signal<()>,
	Ate = Signal.new() :: Signal.Signal<number, { [string]: number }, { [string]: number }>,
	Shortfall = Signal.new() :: Signal.Signal<{ [string]: number }>,
}

-- Bunker-wide modifier keys this service applies (Config.Modifiers, Prompt 9).
local MODIFIER_KEYS = { "RoomOutput", "AllOutput", "StockpileCaps", "FoodUse" }
local TICK_SECONDS = 0.5 -- production
local REFRESH_SECONDS = 2 -- rates again, in case

local grid: any = nil
local clock: any = nil
local session: any = nil
local productionCollection: any = nil
local stock: { [string]: number } = {}
local research = 0
local residents: Residents? = nil
local devCrew: { [string]: Crew } = {} -- DevTools: room id -> a pretend crew (Studio)
local devEaters = 0 -- DevTools: pretend residents who eat and drink
local dark: { [string]: boolean } = {} -- PowerService: dark room ids
local progress: { [string]: number } = {} -- room id -> fraction of its next unit
local carry: { [string]: number } = { Food = 0, Water = 0 }
local modifiers: { [string]: { Key: string, Value: number, Room: string? } } = {}
local rates: { [string]: RoomRate } = {}

local function stocked(): { string }
	local ids = {}
	for _, id in Config.Ids("Resources") do
		if Config.Get("Resources", id).Kind == "Stock" then
			table.insert(ids, id)
		end
	end
	return ids
end

local function publish(id: string)
	set(id, stock[id])
	EconomyService.Changed:Fire(id)
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function roomName(roomType: string): string
	return Config.Get("Rooms", roomType).Name
end

-- The stockpile ------------------------------------------------------------------------------

function EconomyService:Get(id: string): number
	return stock[id] or 0
end

function EconomyService:Stock(): { [string]: number }
	return table.clone(stock)
end

function EconomyService:Cap(id: string): number
	local resource = Config.Get("Resources", id)
	local cells = 0
	for _, room in grid:RoomsOfType("Storage") do
		cells += room.Span
	end
	return math.floor((resource.Cap + resource.CapPerStorageCell * cells) * EconomyService:Multiplier("StockpileCaps"))
end

function EconomyService:CanAfford(costs: { [string]: number }): (boolean, string?, number?)
	return Construction.CanAfford(costs, stock)
end

function EconomyService:Spend(costs: { [string]: number }, reason: string): (boolean, string?)
	local ok, short, missing = Construction.CanAfford(costs, stock)
	if not ok and short then
		return false, `the stockpile is {missing} {Config.Get("Resources", short).Name} short`
	end
	for id, amount in costs do
		if amount > 0 and stock[id] ~= nil then
			stock[id] -= amount
			publish(id)
		end
	end
	if next(costs) then
		log:Info("spent %s on %s", Construction.CostText(costs), reason)
	end
	return true, nil
end

-- Takes a little of a resource with no line in the log: a resident's shot from the shared Ammo
-- pool (Section 11), many times a fight. False (and nothing taken) when there isn't enough.
function EconomyService:Use(id: string, amount: number): boolean
	if amount <= 0 then
		return true
	end
	if (stock[id] or 0) < amount then
		return false
	end
	stock[id] -= amount
	publish(id)
	return true
end

function EconomyService:Add(id: string, amount: number, reason: string): number
	assert(stock[id] ~= nil, `EconomyService: {id} isn't a stocked resource`)
	assert(amount >= 0 and amount == amount, "EconomyService: Add takes a positive amount (Spend takes away)")
	local room = math.max(0, EconomyService:Cap(id) - stock[id])
	local added = math.min(math.floor(amount), room)
	if added > 0 then
		stock[id] += added
		publish(id)
		log:Debug("+%d %s (%s)", added, id, reason)
	end
	return added
end

function EconomyService:Research(): number
	return research
end

function EconomyService:AddResearch(amount: number)
	assert(amount >= 0 and amount == amount, "EconomyService: AddResearch takes a positive amount")
	research += amount
	set("Research", research)
	EconomyService.Changed:Fire("Research")
end

-- Modifiers ------------------------------------------------------------------------------------

-- The product of bunker-wide modifiers with `key`; RoomOutput only where its Room matches the
-- room type, or the room's own id (Prompt 20: the Cook's Kitchen while they stand in it).
function EconomyService:Multiplier(key: string, roomType: string?, roomId: string?): number
	local value = 1
	for _, modifier in modifiers do
		if modifier.Key == key and (modifier.Room == nil or modifier.Room == roomType or (roomId ~= nil and modifier.Room == roomId)) then
			value *= modifier.Value
		end
	end
	return value
end

-- Everything bunker-wide on a room's output (power included): RoomOutput and AllOutput.
function EconomyService:OutputMultiplier(roomType: string, roomId: string?): number
	return EconomyService:Multiplier("RoomOutput", roomType, roomId) * EconomyService:Multiplier("AllOutput")
end

local recompute: () -> () -- below

-- A bunker-wide modifier from `source` (a draft card, a class, a Legend); a nil value clears it.
-- `room` is a room type, or one room's id ("R4").
function EconomyService:SetModifier(source: string, key: string, value: number?, room: string?)
	assert(table.find(MODIFIER_KEYS, key), `EconomyService: {key} isn't a modifier it applies`)
	modifiers[`{source}|{key}|{room or "*"}`] = if value then { Key = key, Value = value, Room = room } else nil
	recompute()
	EconomyService.CrewChanged:Fire() -- power rooms' output may have changed (Overclock)
end

-- Crews and production -------------------------------------------------------------------------

function EconomyService:SetResidents(source: Residents?)
	residents = source
	EconomyService:RefreshCrew()
end

function EconomyService:RefreshCrew()
	recompute()
	EconomyService.CrewChanged:Fire()
end

function EconomyService:Crew(roomId: string): Crew?
	local pretend = devCrew[roomId]
	if pretend then
		return pretend
	end
	local source = residents
	if source then
		local ok, crew = pcall(source.Crew, roomId)
		if ok then
			return crew
		end
		log:Warn("Crew(%s) failed: %s", roomId, tostring(crew))
	end
	return nil
end

function EconomyService:Eaters(): { Eater }
	local list: { Eater } = {}
	local source = residents
	if source then
		local ok, got = pcall(source.Eaters)
		if ok and type(got) == "table" then
			list = table.clone(got)
		elseif not ok then
			log:Warn("Eaters() failed: %s", tostring(got))
		end
	end
	for i = 1, devEaters do
		table.insert(list, { Id = `dev{i}` })
	end
	return list
end

function EconomyService:SetPowered(darkRooms: { [string]: boolean })
	dark = table.clone(darkRooms)
	recompute()
end

local function resourceMultiplier(): number
	local difficulty = Config.Find("Difficulties", RunState.Get("Difficulty") or "Normal")
	return if difficulty then difficulty.ResourceMultiplier else 1
end

local function rateOf(room: any): RoomRate?
	local kind, resource = Economy.Makes(room.Type, room.Floor)
	if not kind then
		return nil
	end
	local crew = EconomyService:Crew(room.Id)
	local workers = if crew then crew.Workers else 0
	local idle: string? = nil
	if room.Wrecked then
		idle = "Wrecked"
	elseif dark[room.Id] then
		idle = "Dark"
	elseif workers <= 0 or Economy.CrewFactor(crew) <= 0 then
		idle = "NoCrew"
	end
	local multiplier = EconomyService:OutputMultiplier(room.Type, room.Id)
	if kind == "Resource" then
		multiplier *= resourceMultiplier()
	end
	local rate = if idle then 0 else Economy.Output(room.Type, room.Level, room.Span, crew, true, multiplier)
	return { Rate = rate, Makes = resource or kind, Resource = resource, Idle = idle, Workers = workers }
end

local function rounded(rate: number): number
	return math.floor(rate * 10 + 0.5) / 10
end

recompute = function()
	if not grid then
		return
	end
	local seen: { [string]: boolean } = {}
	for _, room in grid:Rooms() do
		local r = rateOf(room)
		if r then
			seen[room.Id] = true
			local old = rates[room.Id]
			rates[room.Id] = r
			if not old or rounded(old.Rate) ~= rounded(r.Rate) or old.Idle ~= r.Idle or old.Makes ~= r.Makes
				or old.Workers ~= r.Workers then
				productionCollection:Set(room.Id, { Rate = rounded(r.Rate), Makes = r.Makes, Idle = r.Idle, Workers = r.Workers })
			end
		end
	end
	for id in table.clone(rates) do
		if not seen[id] then
			rates[id] = nil
			progress[id] = nil
			productionCollection:Remove(id)
		end
	end
end

-- Output per cycle, what it makes, and why it is idle ("NoCrew", "Dark", "Wrecked").
function EconomyService:Rate(roomId: string): (number, string?, string?)
	local r = rates[roomId]
	if not r then
		return 0, nil, nil
	end
	return r.Rate, r.Makes, r.Idle
end

local function produce(seconds: number)
	local cycle = Economy.CycleSeconds()
	for id, r in rates do
		local research_ = r.Makes == "Research"
		if r.Rate > 0 and (r.Resource ~= nil or research_) then
			local whole, rest = Economy.Accrue(progress[id] or 0, r.Rate, seconds, cycle)
			progress[id] = rest
			if whole > 0 then
				if research_ then
					EconomyService:AddResearch(whole)
				elseif r.Resource and stock[r.Resource] ~= nil then
					EconomyService:Add(r.Resource, whole, id)
				end
			end
		end
	end
end

-- Food and water at the start of a cycle --------------------------------------------------------

local function eat(cycle: number)
	local eaters = EconomyService:Eaters()
	if #eaters == 0 then
		return
	end
	local t = Config.Get("Tuning", "Residents")
	local bunkerUse = EconomyService:Multiplier("FoodUse")
	local uses: { [string]: { number } } = { Food = {}, Water = {} }
	for _, eater in eaters do
		table.insert(uses.Food, (eater.FoodUse or 1) * bunkerUse)
		table.insert(uses.Water, 1)
	end
	local taken: { [string]: number } = {}
	local missing: { [string]: number } = {}
	for _, id in { "Food", "Water" } do
		local need, rest = Economy.Eat(uses[id], if id == "Food" then t.FoodPerCycle else t.WaterPerCycle, carry[id])
		carry[id] = rest
		local take = math.min(need, stock[id] or 0)
		if take > 0 then
			stock[id] -= take
			publish(id)
		end
		taken[id] = take
		if need > take then
			missing[id] = need - take
		end
	end
	log:Info("cycle %d: %d residents ate %d Food and drank %d Water", cycle, #eaters, taken.Food, taken.Water)
	EconomyService.Ate:Fire(cycle, taken, missing)
	if next(missing) then
		local parts = {}
		for _, id in { "Food", "Water" } do
			if missing[id] then
				table.insert(parts, `{missing[id]} {string.upper(id)}`)
			end
		end
		log:Warn("cycle %d: the stockpile ran short by %s", cycle, table.concat(parts, " and "))
		announce("Danger", `THE STOCKPILE RAN SHORT: {table.concat(parts, " AND ")} MISSING`)
		EconomyService.Shortfall:Fire(missing)
	end
end

-- DevTools --------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	for _, id in stocked() do
		table.insert(lines, `{id} {stock[id]}/{EconomyService:Cap(id)}`)
	end
	return "stockpile: " .. table.concat(lines, ", ") .. `; research {research}`
end

local function describeProduction(): string
	local lines = {}
	local totals: { [string]: number } = {}
	for _, room in grid:Rooms() do
		local r = rates[room.Id]
		if r then
			table.insert(lines, string.format("%s %s L%d: %.1f %s a cycle (%d working%s)", room.Id, room.Type, room.Level,
				r.Rate, r.Makes or "?", r.Workers, if r.Idle then `, idle: {r.Idle}` else ""))
			if r.Makes then
				totals[r.Makes] = (totals[r.Makes] or 0) + r.Rate
			end
		end
	end
	table.sort(lines)
	local sums = {}
	for what, amount in totals do
		table.insert(sums, string.format("%s %.1f", what, amount))
	end
	table.sort(sums)
	return `production a cycle: {if #sums > 0 then table.concat(sums, ", ") else "nothing"}\n`
		.. table.concat(lines, "\n") .. `\neaters {#EconomyService:Eaters()}; carry Food {string.format("%.2f", carry.Food)}`
end

local function resourceId(text: any): string?
	if type(text) ~= "string" then
		return nil
	end
	for _, id in stocked() do
		if string.lower(id) == string.lower(text) then
			return id
		end
	end
	return nil
end

-- "R3" or a room type (every room of it).
local function roomsNamed(text: string): { any }
	local room = grid:Room(text)
	if room then
		return { room }
	end
	for _, id in Config.Ids("Rooms") do
		if string.lower(id) == string.lower(text) then
			return grid:RoomsOfType(id)
		end
	end
	return {}
end

function EconomyService:Init(registry)
	grid = registry.BunkerGrid
	clock = registry.CycleClock
	session = registry.SessionService
	productionCollection = registry.ReplicationService:Collection("Production")
	local dev = registry.DevService
	dev:Register("stock", {
		Description = "The team's stockpile and its caps.",
		Usage = "stock",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("stock.set", {
		Description = "Set a resource's amount (ignores the cap).",
		Usage = "stock.set <resource> <amount>",
		Run = function(_player: Player, args): string?
			local id, amount = resourceId(args[1]), tonumber(args[2])
			if not id or not amount or amount < 0 then
				return "usage: stock.set <resource> <amount>"
			end
			stock[id] = math.floor(amount)
			publish(id)
			return describe()
		end,
	})
	dev:Register("stock.add", {
		Description = "Add to a resource (up to its cap).",
		Usage = "stock.add <resource> <amount>",
		Run = function(_player: Player, args): string?
			local id, amount = resourceId(args[1]), tonumber(args[2])
			if not id or not amount or amount < 0 then
				return "usage: stock.add <resource> <amount>"
			end
			EconomyService:Add(id, amount, "DevTools")
			return describe()
		end,
	})
	dev:Register("research", {
		Description = "Lab research so far; with an amount, add that much.",
		Usage = "research [amount]",
		Run = function(_player: Player, args): string?
			local amount = tonumber(args[1])
			if amount and amount > 0 then
				EconomyService:AddResearch(amount)
			end
			return `research {research}`
		end,
	})
	dev:Register("production", {
		Description = "What every room makes a cycle, and why idle rooms are idle.",
		Usage = "production",
		Run = function(): string?
			return describeProduction()
		end,
	})
	dev:Register("staff", {
		Description = "Studio: give rooms a pretend crew until residents arrive (Prompt 10).",
		Usage = "staff <roomId|roomType> <statSum> [workers] [morale]",
		Run = function(_player: Player, args): string?
			local found = roomsNamed(tostring(args[1] or ""))
			local statSum = tonumber(args[2])
			if #found == 0 or not statSum or statSum < 0 then
				return "usage: staff <roomId|roomType> <statSum> [workers] [morale]"
			end
			for _, room in found do
				local slots = Config.Get("Tuning", "Rooms").WorkerSlotsPerCell[room.Level] * room.Span
				local workers = math.clamp(math.floor(tonumber(args[3]) or math.ceil(statSum / 5)), 0, slots)
				if statSum == 0 or workers == 0 then
					devCrew[room.Id] = nil
				else
					devCrew[room.Id] = { Workers = workers, StatSum = statSum, Morale = tonumber(args[4]) or 1 }
				end
			end
			EconomyService:RefreshCrew()
			return describeProduction()
		end,
	})
	dev:Register("staff.clear", {
		Description = "Studio: remove every pretend crew.",
		Usage = "staff.clear",
		Run = function(): string?
			table.clear(devCrew)
			EconomyService:RefreshCrew()
			return describeProduction()
		end,
	})
	dev:Register("eaters", {
		Description = "Studio: pretend residents who eat and drink each cycle until residents arrive.",
		Usage = "eaters <count>",
		Run = function(_player: Player, args): string?
			local count = tonumber(args[1])
			if not count or count < 0 then
				return `eaters {devEaters}; usage: eaters <count>`
			end
			devEaters = math.floor(count)
			return `eaters {#EconomyService:Eaters()}`
		end,
	})
	dev:Register("eat", {
		Description = "Run the start-of-cycle meal now.",
		Usage = "eat",
		Run = function(): string?
			eat(RunState.Get("Cycle") or 0)
			return describe()
		end,
	})
end

function EconomyService:Start()
	for _, id in stocked() do
		stock[id] = Config.Get("Resources", id).Start
		publish(id)
	end
	set("Research", research)
	grid.RoomChanged:Connect(function(roomId: string)
		if not grid:Room(roomId) then
			devCrew[roomId] = nil
		end
		recompute()
	end)
	clock.CycleStarted:Connect(eat)
	RunState.Changed("Difficulty"):Connect(recompute)
	recompute()
	local acc, since = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		since += dt
		if since >= REFRESH_SECONDS then
			since = 0
			recompute()
		end
		if acc >= TICK_SECONDS then
			if clock:IsRunning() then
				produce(acc * clock:TimeScale())
			end
			acc = 0
		end
	end)
	log:Debug("stockpile ready: %s", describe())
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000103"><Properties><string name="Name">ExpeditionService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ExpeditionService: resident expeditions, distress calls and the Radio Room (bible Sections 6, 8,
	11, 12 and 23; Run place, Prompt 18). The arithmetic is Shared.Rules.Expeditions, the numbers
	Tuning.Expeditions (provisional), the log lines Config.ExpeditionLogs.

	* Sending (Section 12: "From the Radio Room or the Blast Door, send 1 to 3 residents to the
	  surface or the Deep for 1, 2 or 3 cycles, with gear and supplies"; Section 8: never voted):
	  an EXPEDITIONS console prompt in the Blast Door hall and in every Radio Room opens the
	  Expeditions screen (ExpeditionsController). Its SendExpedition remote is checked here: the
	  sender within UseRange of a console, the team (Rules.Expeditions.Check), the supplies. Food and
	  Water for every member for every cycle, and the Medkits packed, come out of the stockpile; each
	  member leaves their job and walks out through the Blast Door (ResidentService:SetAway,
	  ResidentBrain). Gear waits for resident gear (Prompt 26). A Deep expedition goes to the band
	  of the bunker's deepest floor (its ore).
	* Away (Section 12: "They leave the map. Every cycle their log gets a line"): at each dawn
	  (CycleClock.CycleStarted) an expedition out since an earlier cycle lives one cycle: its members
	  eat their packed Food and Water and gain XPPerExpeditionCycle; the team finds the destination's
	  loot (Rules.Expeditions.Scale: Scrap, Food, Water, the band's ore; one recruit at most a trip;
	  gear and blueprints wait for Prompts 26 and 19); and one thing happens (Rules.Expeditions
	  .Event): nothing, someone hurt (a packed Medkit halves it), someone lost (a packed Medkit makes
	  it a bad hurt instead), or a distress call. The line goes in the expedition's log and in its
	  members' run logs. After their last cycle they come home through the Blast Door with what they
	  found and what's left of the supplies, and go back to their old jobs if there's room. A
	  fast team (average Speed FastSpeed or more when they set out) comes home a cycle sooner,
	  never under 1, with the full trip's finds (Landon, Prompt 18).
	* Distress calls (Section 12: "a marker appears and players have until the end of the next day
	  phase to reach them, or they are lost along with their loot"): the call comes CallDelay seconds
	  into that day, DistressCallLeadSeconds sooner (the Radio Operator). Only a working Radio Room
	  (staffed and powered) hears it (Landon, Prompt 18): unheard, the team and its finds are lost.
	  Heard, it is on everyone's radio card and in the alerts. The team is pinned down at a survivor
	  spot in Brightwater Ruins
	  (SurfaceService:DistressSpot) or in a cave the bunker has opened (DeepService:DistressSpot), each
	  member with a HELP prompt (RescueService, Kind Expedition); the Expeditions collection carries
	  the marker. Helped, they follow home like a rescue; the first one home brings the finds. Whoever
	  is still pinned down when the day phase of the cycle after the call ends (the Surge starts) is
	  lost, and with nobody left to bring them, so are the finds.
	* The Radio Room (Charm; Section 6: "Recruits survivors, places supply calls, hears distress
	  calls"): its Recruits output (EconomyService:Rate) times RecruitRate (the Radio Operator, Wren
	  Holloway) brings a recruit to the Blast Door at each whole point, Rare at RadioRareChance times
	  RareRecruitChance. While a Lost Crew is still out and a Radio Room works, every RadioHintCycles
	  cycles it picks up that crew's call (Section 12: "Radio logs and the Radio Room give hints about
	  where each crew is"; DeepService:CrewCall). No recruit comes past Constants.CAPS.Residents.
	  The Radio Operator's Supply Call is Prompt 20's.

	API:
		ExpeditionService:Send(destination, memberIds, cycles, medkits, player?): (string?, string?)
		ExpeditionService:Recruit(tier?, how): string?        -- a newcomer at the Blast Door (draft cards, Prompt 19)
		ExpeditionService:SetModifier(source, key, value?)    -- RecruitRate, RareRecruitChance, DistressCallLeadSeconds
		ExpeditionService:Active(): number
	Signals: Sent(id, destination, names), Returned(id, destination, names, finds), Lost(id, destination, names),
	Distress(id, where), Reached(id, player), Recruited(residentId, how).
	Replication: the Expeditions collection, id -> { Destination, Band, Members = { { Id, Name, Status } }, Cycles,
	Trip, Done, LeftAt, Back, State, Log, Finds, Recruits, Food, Water, Medkits, CallCycle, Deadline,
	Marker = { X, Y, Z }, Where }; RunState RadioWorks (a Radio Room can hear a call).
	Dev: exp, exp.send, exp.cycle, exp.call, exp.home, exp.deadline, recruit, radio.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Economy = require(Shared.Rules.Economy)
local Expeditions = require(Shared.Rules.Expeditions)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Loot = require(Shared.Rules.Loot)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("ExpeditionService")

local ExpeditionService = {
	Name = "ExpeditionService",
	Dependencies = {
		"BunkerGrid", "CycleClock", "RunDirector", "SessionService", "EconomyService", "ResidentService",
		"ResidentBrain", "RescueService", "SurfaceService", "DeepService", "DisasterService", "ReplicationService", "DevService",
	},
	Sent = Signal.new() :: Signal.Signal<string, string, string>,
	Returned = Signal.new() :: Signal.Signal<string, string, string, string>,
	Lost = Signal.new() :: Signal.Signal<string, string, string>,
	Distress = Signal.new() :: Signal.Signal<string, string>,
	Reached = Signal.new() :: Signal.Signal<string, Player>,
	Recruited = Signal.new() :: Signal.Signal<string, string>,
	BlueprintsHome = Signal.new() :: Signal.Signal<number, string>, -- Prompt 19: count, destination
}

-- loot nothing hands out yet: gear (Prompt 26), blueprints (Prompt 19); recruits are this service's
local SKIP: { [string]: boolean } = {} -- blueprints come home for the draft (Prompt 19), gear for the locker (Prompt 26)
local HALL = Vector3.new(0, 0, 6) -- from the Blast Door's Door socket into the hall (where the elevator lets out)
local BLAST_CONSOLE = Vector3.new(-10, 2.5, 1) -- the hall's console without the art kit's GuardDesk: left of the door
local RADIO_CONSOLE_BACK = 5 -- a Radio Room's console: this far in from its back wall (or its Console socket)
local RADIO_SCALE = 1.5 -- the radio set on a Radio Room's console (Prop_RadioLog, A6) until A7 brings the room's art
local MODIFIER_KEYS = { "RecruitRate", "RareRecruitChance", "DistressCallLeadSeconds" }

type Member = {
	Id: string,
	Name: string,
	Job: string?, -- the job they left, to go back to
	Status: string, -- Away, Pinned, Following, Home, Lost
	Rescue: string?, -- RescueService id while pinned down or following
}
type Expedition = {
	Id: string,
	Destination: string,
	Band: string?,
	Ore: string?,
	Members: { Member },
	Cycles: number, -- the length picked
	Trip: number, -- the cycles they are away: one less for a fast team (Landon, Prompt 18)
	Done: number,
	LeftAt: number,
	Food: number,
	Water: number,
	Medkits: number,
	Finds: { [string]: number },
	Recruits: number,
	Blueprints: number, -- Prompt 19: found blueprints, each a card for the draft once home
	Gear: number, -- Prompt 26: found gear, each a piece for the gear locker once home
	Log: { string },
	State: string, -- Away, Calling, Distress, Reached, Home, Lost
	CallIn: number?, -- running seconds until the call (Calling)
	CallCycle: number?,
	Deadline: number?,
	Marker: Vector3?,
	Where: string?,
	Delivered: boolean,
	FindsText: string?, -- what they brought home (once delivered)
}

local grid: any = nil
local clock: any = nil
local director: any = nil
local session: any = nil
local economy: any = nil
local residents: any = nil
local brain: any = nil
local rescue: any = nil
local surface: any = nil
local deep: any = nil
local disasters: any = nil
local collection: any = nil

local expeditions: { [string]: Expedition } = {}
local counter = 0
local radioProgress = 0
local lastHintCycle = 0
local radioHeard: boolean? = nil
local setState: (name: string, value: any) -> () = function() end
local bunkerModifiers: { [string]: { [string]: number } } = {} -- key -> source -> value
local rng = Random.new()

-- Helpers ------------------------------------------------------------------------------------------

local function t(): { [string]: any }
	return Expeditions.Tuning()
end

local function alertAll(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function order(id: string): number
	return tonumber(string.match(id, "%d+")) or 0
end

local function sortedActive(): { Expedition }
	local list = {}
	for _, e in expeditions do
		table.insert(list, e)
	end
	table.sort(list, function(a: Expedition, b: Expedition): boolean
		return order(a.Id) < order(b.Id)
	end)
	return list
end

local function destinationText(e: Expedition): string
	if e.Destination == "Deep" then
		local band = e.Band and Config.Find("DepthBands", e.Band)
		return if band then Expeditions.Place(band.Name) else "the Deep"
	end
	return "the surface"
end

local function namesOf(e: Expedition, statuses: { [string]: boolean }?): { string }
	local list = {}
	for _, m in e.Members do
		if not statuses or statuses[m.Status] then
			table.insert(list, m.Name)
		end
	end
	return list
end

local function membersWith(e: Expedition, status: string): { Member }
	local list = {}
	for _, m in e.Members do
		if m.Status == status then
			table.insert(list, m)
		end
	end
	return list
end

local function statsOf(members: { Member }): { Expeditions.Stats }
	local list = {}
	for _, m in members do
		local resident = residents:Get(m.Id)
		table.insert(list, if resident then Residents.EffectiveStats(resident) else {}) -- with their outfit on
	end
	return list
end

-- A member's own effects: their traits' modifiers (Prompt 26: a Strong Back carries more, the
-- Lucky find more, a Scrounger more Scrap); a Legend's signature is Prompt 27.
local function effectsOf(members: { Member }): { { any } }
	local list = {}
	for _, m in members do
		local own = {}
		local resident = residents:Get(m.Id)
		for _, traitId in (if resident then resident.Traits or {} else {}) do
			local trait = Config.Find("Traits", traitId)
			for _, modifier in (if trait then trait.Modifiers else {}) do
				table.insert(own, modifier)
			end
		end
		table.insert(list, own)
	end
	return list
end

-- Bunker-wide modifiers: the best player's class value (the Radio Operator) with the run's own sources.
local function bunkerValue(key: string): number
	local info = Config.Get("Modifiers", key)
	local add = info.Unit == "Add"
	local best = if add then 0 else 1
	for _, player in Players:GetPlayers() do
		local value = Modifiers.PlayerValue(player, key)
		if value then
			best = math.max(best, value)
		end
	end
	for _, value in bunkerModifiers[key] or {} do
		best = if add then best + value else best * value
	end
	return best
end

local function pick(list: { string }): string?
	return if #list > 0 then list[rng:NextInteger(1, #list)] else nil
end

-- A place on the way for this cycle's line: a place in Brightwater Ruins (open this era), or the band.
local function placeFor(e: Expedition): string
	if e.Destination == "Deep" then
		return destinationText(e)
	end
	local era = table.find(Config.Ids("Eras"), clock:Era()) or 1
	local open = {}
	for _, id in Config.Ids("SurfaceLocations") do
		local location = Config.Get("SurfaceLocations", id)
		if location.MinEra <= era then
			table.insert(open, location.Name)
		end
	end
	local name = pick(open)
	return if name then Expeditions.Place(name) else "the ruins"
end

local function line(e: Expedition, event: string, fields: { [string]: string }): string?
	local text = pick(Expeditions.Lines(e.Destination, event))
	return if text then Expeditions.Fill(text, fields) else nil
end

-- A line in the expedition's log and its members' run logs.
local function note(e: Expedition, text: string?, members: { Member }?)
	if not text then
		return
	end
	local year = clock:Year()
	table.insert(e.Log, `Year {year}: {text}`)
	if #e.Log > 12 then
		table.remove(e.Log, 1)
	end
	for _, m in members or e.Members do
		if m.Status ~= "Lost" then
			residents:Note(m.Id, `{if e.Destination == "Deep" then "Deep" else "surface"} expedition: {text}`)
		end
	end
end

local function publish(e: Expedition)
	local members = {}
	for _, m in e.Members do
		table.insert(members, { Id = m.Id, Name = m.Name, Status = m.Status })
	end
	collection:Set(e.Id, {
		Destination = e.Destination,
		Band = e.Band,
		Members = members,
		Cycles = e.Cycles,
		Trip = e.Trip,
		Done = e.Done,
		LeftAt = e.LeftAt,
		Back = e.LeftAt + e.Trip,
		State = e.State,
		Log = table.clone(e.Log),
		Finds = table.clone(e.Finds),
		Recruits = e.Recruits,
		Blueprints = e.Blueprints,
		Gear = e.Gear,
		Food = e.Food,
		Water = e.Water,
		Medkits = e.Medkits,
		CallCycle = e.CallCycle,
		Deadline = e.Deadline,
		Marker = if e.Marker then { X = e.Marker.X, Y = e.Marker.Y, Z = e.Marker.Z } else nil,
		Where = e.Where,
	})
end

local function findsText(finds: { [string]: number }, recruits: number, blueprints: number?, gear: number?): string
	local parts = {}
	for _, id in Config.Ids("Resources") do
		local amount = finds[id]
		if amount and amount > 0 then
			table.insert(parts, `+{amount} {string.upper(Config.Get("Resources", id).Name)}`)
		end
	end
	if recruits > 0 then
		table.insert(parts, if recruits == 1 then "A RECRUIT" else `{recruits} RECRUITS`)
	end
	if blueprints and blueprints > 0 then
		table.insert(parts, if blueprints == 1 then "A BLUEPRINT" else `{blueprints} BLUEPRINTS`)
	end
	if gear and gear > 0 then
		table.insert(parts, if gear == 1 then "A PIECE OF GEAR" else `{gear} PIECES OF GEAR`)
	end
	return if #parts > 0 then table.concat(parts, " · ") else "NOTHING FOUND"
end

-- The Blast Door hall --------------------------------------------------------------------------------

local function doorSocket(): CFrame?
	local door = grid:RoomsOfType("BlastDoor")[1]
	local model = door and grid:RoomModel(door.Id)
	return model and BunkerKit.Socket(model, "Door")
end

-- Where the i-th of a group steps into the hall, facing in.
local function hallSpot(i: number): CFrame?
	local socket = doorSocket()
	if not socket then
		return nil
	end
	local at = socket.Position + HALL + Vector3.new(((i - 1) % 3 - 1) * 3, 0, math.floor((i - 1) / 3) * 3)
	return CFrame.lookAt(at, at + Vector3.new(0, 0, 1))
end

local function stepIn(residentId: string, at: CFrame?)
	local body = brain:Body(residentId)
	if body and at then
		body:PivotTo(at)
	end
end

-- Recruits ---------------------------------------------------------------------------------------------

function ExpeditionService:Recruit(tier: string?, how: string): string?
	if residents:Count() >= Constants.CAPS.Residents then
		alertAll("Warning", `THE BUNKER IS FULL ({Constants.CAPS.Residents}): A RECRUIT WAS TURNED AWAY`)
		log:Info("a recruit (%s) was turned away: the bunker is full", how)
		return nil
	end
	local level = t().RadioLevel
	local id = residents:Add(tier or "Common", rng:NextInteger(level.Min, level.Max))
	stepIn(id, hallSpot(rng:NextInteger(1, 3)))
	residents:Note(id, how)
	local record = residents:Get(id)
	local name = if record then string.upper(Residents.Name(record)) else id
	alertAll("Info", `{name}{if tier and tier ~= "Common" then ` ({string.upper(tier)})` else ""} JOINS THE BUNKER: {string.upper(how)}`)
	log:Info("%s (%s) joined: %s", id, tier or "Common", how)
	ExpeditionService.Recruited:Fire(id, how)
	return id
end

local function radioRate(): number
	local rate = 0
	for _, room in grid:RoomsOfType("RadioRoom") do
		local value, makes = economy:Rate(room.Id)
		if makes == "Recruits" or makes == nil then
			rate += value
		end
	end
	return rate * bunkerValue("RecruitRate")
end

local function radioWorks(): boolean
	for _, room in grid:RoomsOfType("RadioRoom") do
		if (economy:Rate(room.Id)) > 0 then
			return true
		end
	end
	return false
end

local function radioRecruit()
	local chance = t().RadioRareChance * bunkerValue("RareRecruitChance")
	ExpeditionService:Recruit(Expeditions.RecruitTier(rng:NextNumber(), chance), "answered the Radio Room's call")
end

-- A Lost Crew's call, picked up by a working Radio Room (Section 12: crew hints).
local function crewCall(force: boolean?): boolean
	if not force and not radioWorks() then
		return false
	end
	local logId, where = deep:CrewCall()
	if not logId then
		return false
	end
	for _, player in session:ReadyPlayers() do
		deep:PlayLog(player, logId, where)
	end
	alertAll("Info", "THE RADIO ROOM PICKED UP A LOST CREW'S CALL")
	return true
end

-- Sending -----------------------------------------------------------------------------------------------

local function consoles(): Folder?
	local root = grid:Root()
	return if root then root:FindFirstChild("ExpeditionConsoles") :: Folder? else nil
end

local function nearConsole(player: Player): boolean
	local root = rootOf(player)
	local holder = consoles()
	if not root or not holder then
		return false
	end
	for _, anchor in holder:GetChildren() do
		if anchor:IsA("BasePart") and (anchor.Position - root.Position).Magnitude <= t().UseRange then
			return true
		end
	end
	return false
end

function ExpeditionService:Send(destination: string, memberIds: { string }, cycles: number, medkits: number, player: Player?): (string?, string?)
	if director:Phase() ~= "Playing" then
		return nil, "Expeditions go out while the run is on."
	end
	if player and not nearConsole(player) then
		return nil, "Send expeditions from the Blast Door hall or a Radio Room."
	end
	local seen: { [string]: boolean } = {}
	local candidates = {}
	local teamStats = {}
	for _, id in memberIds do
		local resident = residents:Get(id)
		if not resident then
			return nil, "That resident isn't in the bunker."
		elseif seen[id] then
			return nil, "Pick each resident once."
		end
		seen[id] = true
		table.insert(candidates, { State = resident.State, Trapped = resident.Trapped })
		table.insert(teamStats, resident.Stats)
	end
	local ok, why = Expeditions.Check(destination, candidates, cycles, medkits)
	if not ok then
		return nil, why
	end
	local supplies = Expeditions.Supplies(#memberIds, cycles)
	local costs: { [string]: number } = { Food = supplies.Food, Water = supplies.Water }
	if medkits > 0 then
		costs.Medkits = medkits
	end
	local paid, short = economy:Spend(costs, "an expedition's supplies")
	if not paid then
		return nil, `Not enough supplies: {short}.`
	end
	counter += 1
	local band = if destination == "Deep" then Grid.BandOf(math.max(grid:DeepestFloor(), 1)) else nil
	local e: Expedition = {
		Id = `E{counter}`,
		Destination = destination,
		Band = if band then band.Id else nil,
		Ore = if band then band.Ore else nil,
		Members = {},
		Cycles = cycles,
		Trip = Expeditions.Trip(cycles, teamStats),
		Done = 0,
		LeftAt = clock:Cycle(),
		Food = supplies.Food,
		Water = supplies.Water,
		Medkits = medkits,
		Finds = {},
		Recruits = 0,
		Blueprints = 0,
		Gear = 0,
		Log = {},
		State = "Away",
		CallIn = nil,
		CallCycle = nil,
		Deadline = nil,
		Marker = nil,
		Where = nil,
		Delivered = false,
		FindsText = nil,
	}
	for _, id in memberIds do
		local resident = residents:Get(id)
		table.insert(e.Members, { Id = id, Name = Residents.Name(resident), Job = resident.Job, Status = "Away", Rescue = nil })
		residents:SetAway(id, true)
	end
	expeditions[e.Id] = e
	local names = Expeditions.Names(namesOf(e))
	note(e, line(e, "SetOut", { names = names, place = destinationText(e) }))
	publish(e)
	alertAll("Info", `{string.upper(names)} SET OUT FOR {string.upper(destinationText(e))}: BACK IN {e.Trip} CYCLE{if e.Trip == 1 then "" else "S"}`
		.. (if e.Trip < e.Cycles then " (A FAST TEAM)" else ""))
	log:Info("%s: %s to %s for %d cycle(s), %d Medkit(s)%s", e.Id, names, destination, cycles, medkits,
		if player then ` (sent by {player.Name})` else "")
	ExpeditionService.Sent:Fire(e.Id, destination, names)
	return e.Id, nil
end

-- Home ------------------------------------------------------------------------------------------------

local function backToWork(m: Member): boolean
	if m.Job and grid:Room(m.Job) then
		local ok = residents:Assign(m.Id, m.Job)
		return ok
	end
	return false
end

-- The finds, what's left of the supplies and any recruit go into the bunker (once a trip).
local function deliver(e: Expedition): string
	if e.Delivered then
		return ""
	end
	e.Delivered = true
	local got: { [string]: number } = {}
	for resource, amount in e.Finds do
		local added = if amount > 0 then economy:Add(resource, amount, `the {e.Destination} expedition`) else 0
		if added > 0 then
			got[resource] = added
		end
	end
	for resource, amount in { Food = e.Food, Water = e.Water, Medkits = e.Medkits } do
		if amount > 0 then
			economy:Add(resource, amount, "an expedition's supplies, back")
		end
	end
	e.Food, e.Water, e.Medkits = 0, 0, 0
	local recruits = 0
	for _ = 1, e.Recruits do
		local tier = Expeditions.RecruitTier(rng:NextNumber(), t().RecruitRareChance * bunkerValue("RareRecruitChance"))
		if ExpeditionService:Recruit(tier, `came home with the {if e.Destination == "Deep" then "Deep" else "surface"} expedition`) then
			recruits += 1
		end
	end
	local blueprints = e.Blueprints
	e.Blueprints = 0
	if blueprints > 0 then
		ExpeditionService.BlueprintsHome:Fire(blueprints, e.Destination)
	end
	local gear = e.Gear
	e.Gear = 0
	if gear > 0 then
		residents:FindGear(nil, gear) -- into the gear locker, with its own line on the HUD
	end
	e.FindsText = findsText(got, recruits, blueprints, gear)
	return e.FindsText :: string
end

local function finish(e: Expedition, how: string, finds: string?)
	e.State = how
	expeditions[e.Id] = nil
	collection:Remove(e.Id)
	local names = Expeditions.Names(namesOf(e))
	if how == "Home" then
		ExpeditionService.Returned:Fire(e.Id, e.Destination, Expeditions.Names(namesOf(e, { Home = true })), finds or "")
	else
		ExpeditionService.Lost:Fire(e.Id, e.Destination, names)
	end
	log:Info("%s finished: %s (%s)", e.Id, how, finds or "-")
end

-- Every member is home or lost: the trip is over.
local function settle(e: Expedition)
	for _, m in e.Members do
		if m.Status ~= "Home" and m.Status ~= "Lost" then
			return
		end
	end
	if #membersWith(e, "Home") > 0 then
		finish(e, "Home", e.FindsText)
	else
		alertAll("Danger", `THE {string.upper(e.Destination)} EXPEDITION IS LOST: {string.upper(Expeditions.Names(namesOf(e)))} DIDN'T COME BACK`)
		finish(e, "Lost")
	end
end

-- The end of the trip: everyone still away walks in through the Blast Door with the finds.
local function comeHome(e: Expedition)
	local back = membersWith(e, "Away")
	local idle = {}
	for i, m in back do
		residents:SetAway(m.Id, false)
		stepIn(m.Id, hallSpot(i))
		m.Status = "Home"
		if not backToWork(m) then
			table.insert(idle, m.Name)
		end
	end
	local home = Expeditions.Names(namesOf(e, { Home = true }))
	note(e, line(e, "Home", { names = home }), back)
	if e.Destination == "Deep" and back[1] then
		disasters:FromTheDeep(back[1].Id, "expedition") -- one roll a trip (Section 10; Prompt 24)
	end
	local finds = deliver(e)
	alertAll("Info", `THE {string.upper(e.Destination)} EXPEDITION IS HOME: {string.upper(home)} · {finds}`)
	if #idle > 0 then
		alertAll("Warning", `{string.upper(Expeditions.Names(idle))} {if #idle == 1 then "IS" else "ARE"} BACK AND WAITING FOR A JOB`)
	end
	publish(e)
	if #back > 0 then
		finish(e, "Home", finds)
	else
		settle(e)
	end
end

-- Losing members ------------------------------------------------------------------------------------

local function lose(e: Expedition, m: Member, how: string, quiet: boolean?)
	if m.Status == "Lost" or m.Status == "Home" then
		return
	end
	if m.Rescue then
		rescue:Remove(m.Rescue)
		m.Rescue = nil
	end
	m.Status = "Lost"
	residents:Lose(m.Id, how)
	if not quiet then
		alertAll("Danger", `{string.upper(m.Name)} IS GONE: {string.upper(how)}`)
	end
end

-- Distress calls ------------------------------------------------------------------------------------

local function call(e: Expedition)
	local spot, where = nil, nil
	if e.Destination == "Deep" then
		spot, where = deep:DistressSpot()
	else
		local at, name = surface:DistressSpot()
		spot, where = at, if name then Expeditions.Place(name) else "the ruins"
	end
	local pinned = membersWith(e, "Away")
	if not spot or not where or #pinned == 0 then
		-- nowhere to be found (no surface map, nothing dug): they make their own way on, shaken
		log:Warn("%s: no spot for a distress call; it passes", e.Id)
		e.State = "Away"
		e.CallIn = nil
		publish(e)
		return
	end
	if not radioWorks() then
		-- no Radio Room staffed and powered: nobody hears the call (Landon, Prompt 18)
		local names = Expeditions.Names(namesOf(e, { Away = true }))
		note(e, line(e, "Unheard", { names = names, place = where }), pinned)
		for _, m in pinned do
			lose(e, m, "lost: no Radio Room heard their call", true)
		end
		-- short: the alert box shows two lines (the names are in the logs)
		alertAll("Danger", `THE {string.upper(e.Destination)} EXPEDITION IS LOST: NO RADIO ROOM HEARD ITS CALL`)
		log:Info("%s radioed from %s, unheard: lost", e.Id, where)
		finish(e, "Lost")
		return
	end
	e.State = "Distress"
	e.CallIn = nil
	e.CallCycle = clock:Cycle()
	e.Deadline = Expeditions.Deadline(e.CallCycle :: number)
	e.Marker = spot.Position
	e.Where = where
	for i, m in pinned do
		local resident = residents:Get(m.Id)
		local offset = CFrame.new(((i - 1) % 3 - 1) * 2.2, 0, 0) -- side by side, close enough to stay indoors
		local id = rescue:Trap(spot * offset, {
			Kind = "Expedition",
			Tier = if resident then resident.Tier else "Common",
			Level = if resident then resident.Level else 1,
			Where = where,
			Tag = e.Id,
			Resident = m.Id,
			Health = if resident then resident.Health else nil,
			Label = m.Name,
			Action = "HELP",
		})
		if id then
			m.Status = "Pinned"
			m.Rescue = id
		end
	end
	local names = Expeditions.Names(namesOf(e, { Pinned = true }))
	note(e, line(e, "Distress", { names = names, place = where }), pinned)
	local caller = pinned[1]
	local message = line(e, "Call", { name = caller.Name, names = names, place = where }) or `{caller.Name} calling the bunker: we need help at {where}.`
	for _, player in session:ReadyPlayers() do
		Remotes.FireClient("RadioLog", player, "Distress call", `{caller.Name}, {destinationText(e)} expedition`, message, where)
	end
	alertAll("Danger", `DISTRESS CALL FROM {string.upper(where)}: REACH THEM BEFORE TOMORROW'S SURGE`)
	log:Info("%s radioed for help from %s (deadline: cycle %d's day)", e.Id, where, e.Deadline :: number)
	publish(e)
	ExpeditionService.Distress:Fire(e.Id, where)
end

local function findMember(rescueId: string): (Expedition?, Member?)
	for _, e in expeditions do
		for _, m in e.Members do
			if m.Rescue == rescueId then
				return e, m
			end
		end
	end
	return nil, nil
end

local function helped(rescueId: string, player: Player)
	local e, m = findMember(rescueId)
	if not e or not m then
		return
	end
	m.Status = "Following"
	residents:Note(m.Id, `reached by {player.DisplayName}`)
	if e.State == "Distress" then
		e.State = "Reached"
		alertAll("Info", `{string.upper(player.DisplayName)} REACHED THE {string.upper(e.Destination)} EXPEDITION: BRING THEM HOME`)
		ExpeditionService.Reached:Fire(e.Id, player)
	end
	publish(e)
end

-- A member helped home walks in (RescueService arrival, Kind Expedition).
local function arrived(r: any, leader: Player?, residentId: string)
	local e, m = findMember(r.Id)
	if not e or not m then
		return
	end
	m.Status = "Home"
	m.Rescue = nil
	residents:SetAway(m.Id, false, r.HealthLeft)
	stepIn(m.Id, r.HomeAt)
	residents:Note(m.Id, if leader then `came home, led by {leader.DisplayName}` else "came home")
	local working = backToWork(m)
	local finds = deliver(e)
	alertAll("Info", `{string.upper(m.Name)} IS HOME{if leader then `, LED BY {string.upper(leader.DisplayName)}` else ""}`
		.. (if finds ~= "" then ` · {finds}` else "") .. (if working then "" else " · WAITING FOR A JOB"))
	publish(e)
	settle(e)
end

local function strayLost(rescueId: string, kind: string)
	if kind ~= "Expedition" then
		return
	end
	local e, m = findMember(rescueId)
	if not e or not m then
		return
	end
	m.Rescue = nil -- RescueService already let them go
	lose(e, m, "killed on the way home")
	publish(e)
	settle(e)
end

-- The end of the day phase after a call: whoever is still pinned down is lost.
local function deadline(force: boolean?)
	local cycle = clock:Cycle()
	for _, e in sortedActive() do
		if (e.State == "Distress" or e.State == "Reached") and e.Deadline and (force or cycle >= e.Deadline) then
			local pinned = membersWith(e, "Pinned")
			for _, m in pinned do
				lose(e, m, "lost waiting for help")
			end
			if #pinned > 0 then
				log:Info("%s: %d pinned down member(s) lost at the deadline", e.Id, #pinned)
				publish(e)
				settle(e)
			end
		end
	end
end

-- Away: a cycle ------------------------------------------------------------------------------------

-- A cycle's finds for the members still out (the destination's loot table, scaled by the team).
local function find(e: Expedition, away: { Member })
	local team = Expeditions.Team(statsOf(away), effectsOf(away))
	local drops = Expeditions.Scale(Loot.Roll(Expeditions.LootTable(e.Destination), rng, { BandOre = e.Ore, Skip = SKIP }), team)
	for _, drop in drops do
		if drop.Resource then
			e.Finds[drop.Resource] = (e.Finds[drop.Resource] or 0) + drop.Count
		elseif drop.Special == "Recruit" and e.Recruits < t().RecruitsMax then
			e.Recruits += 1
		elseif drop.Special == "Blueprint" then
			e.Blueprints += 1
		elseif drop.Special == "Gear" then
			e.Gear += drop.Count
		end
	end
end

local function live(e: Expedition, forced: string?)
	local away = membersWith(e, "Away")
	if #away == 0 then
		return
	end
	local residentTuning = Config.Get("Tuning", "Residents")
	e.Done += 1
	e.Food = math.max(0, e.Food - #away * residentTuning.FoodPerCycle)
	e.Water = math.max(0, e.Water - #away * residentTuning.WaterPerCycle)
	for _, m in away do
		residents:GainXP(m.Id, residentTuning.XPPerExpeditionCycle)
	end
	find(e, away)
	-- what happened
	local odds = Expeditions.Odds(e.Destination, statsOf(away))
	local event = forced or Expeditions.Event(odds, rng:NextNumber())
	local place = placeFor(e)
	local m = away[rng:NextInteger(1, #away)]
	local resident = residents:Get(m.Id)
	local maxHealth = if resident then resident.MaxHealth else 100
	if event == "Hurt" then
		local medkit = e.Medkits > 0
		if medkit then
			e.Medkits -= 1
		end
		residents:Wound(m.Id, Expeditions.Harm(maxHealth, rng:NextNumber(), medkit))
		note(e, line(e, "Hurt", { name = m.Name, place = place }), away)
	elseif event == "Lost" then
		if e.Medkits > 0 then
			e.Medkits -= 1
			residents:Wound(m.Id, Expeditions.Harm(maxHealth, 1, false))
			note(e, line(e, "Patched", { name = m.Name, place = place }), away)
		else
			note(e, line(e, "Lost", { name = m.Name, place = place }), away)
			lose(e, m, `lost on the {if e.Destination == "Deep" then "Deep" else "surface"} expedition`)
		end
	elseif event == "Distress" then
		local delay = t().CallDelay
		e.State = "Calling"
		e.CallIn = math.max(0, rng:NextNumber(delay.Min, delay.Max) - bunkerValue("DistressCallLeadSeconds"))
	else
		note(e, line(e, "Quiet", { names = Expeditions.Names(namesOf(e, { Away = true })), place = place }), away)
	end
	log:Info("%s lived cycle %d of %d: %s (%s)", e.Id, e.Done, e.Trip, event, findsText(e.Finds, e.Recruits, e.Blueprints, e.Gear))
	if #membersWith(e, "Away") == 0 and e.State == "Away" then
		publish(e)
		settle(e)
		return
	end
	if e.State == "Away" and e.Done >= e.Trip then
		-- a fast team turns for home early, with the finds of the whole length picked (Landon, Prompt 18)
		local still = membersWith(e, "Away")
		for _ = e.Trip + 1, e.Cycles do
			find(e, still)
		end
		if e.Trip < e.Cycles then
			note(e, line(e, "Early", { names = Expeditions.Names(namesOf(e, { Away = true })), place = place }), still)
		end
		comeHome(e)
		return
	end
	publish(e)
end

local function dawn(cycle: number)
	for _, e in sortedActive() do
		if e.State == "Away" and cycle > e.LeftAt then
			local ok, err = pcall(live, e)
			if not ok then
				log:Warn("%s: %s", e.Id, tostring(err))
			end
		end
	end
	-- the Radio Room picks up a Lost Crew's call now and then
	if cycle - lastHintCycle >= t().RadioHintCycles and crewCall(false) then
		lastHintCycle = cycle
	end
end

local function tick(dt: number)
	local works = radioWorks()
	if works ~= radioHeard then
		radioHeard = works
		setState("RadioWorks", works)
	end
	if not clock:IsRunning() or director:Phase() ~= "Playing" then
		return
	end
	local running = dt * clock:TimeScale()
	for _, e in sortedActive() do
		if e.State == "Calling" and e.CallIn then
			e.CallIn -= running
			if e.CallIn <= 0 then
				local ok, err = pcall(call, e)
				if not ok then
					log:Warn("%s call: %s", e.Id, tostring(err))
				end
			end
		end
	end
	local rate = radioRate()
	if rate > 0 then
		local whole, rest = Economy.Accrue(radioProgress, rate, running, Economy.CycleSeconds())
		radioProgress = rest
		for _ = 1, whole do
			radioRecruit()
		end
	end
end

-- The consoles ------------------------------------------------------------------------------------------

local function consolePrompt(anchor: BasePart, label: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ExpeditionsPrompt"
	prompt.ActionText = "EXPEDITIONS"
	prompt.ObjectText = label
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Kind", "Expeditions") -- ExpeditionsController opens the screen
	prompt.Parent = anchor
end

-- A radio set (the A6 recorder) on a Radio Room's console, so the room shows where to send from.
local function radioSet(anchor: BasePart, at: Vector3)
	local assets = game:GetService("ServerStorage"):FindFirstChild("Assets")
	local props = assets and assets:FindFirstChild("Props")
	local source = props and props:FindFirstChild("Prop_RadioLog")
	if not source or not source:IsA("Model") then
		return
	end
	local radio = source:Clone()
	radio.Name = "Radio"
	radio:SetAttribute("Find", nil)
	for _, part in radio:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	radio:ScaleTo(RADIO_SCALE)
	radio:PivotTo(CFrame.new(at) * CFrame.Angles(0, math.pi, 0)) -- facing into the room
	radio.Parent = anchor
end

local function syncConsoles()
	local root = grid:Root()
	if not root then
		return
	end
	local holder = root:FindFirstChild("ExpeditionConsoles")
	if not holder then
		holder = Instance.new("Folder")
		holder.Name = "ExpeditionConsoles"
		holder.Parent = root
	end
	local wanted: { [string]: { At: Vector3, Label: string, Radio: Vector3? } } = {}
	-- the Blast Door guard's desk and its radio (Kit_BlastDoor), or beside the door in a graybox hall
	local door = grid:RoomsOfType("BlastDoor")[1]
	local doorModel = door and grid:RoomModel(door.Id)
	local desk = doorModel and doorModel:FindFirstChild("GuardDesk", true)
	local socket = doorSocket()
	if desk and desk:IsA("BasePart") then
		wanted.Hall = { At = desk.Position + Vector3.new(0, desk.Size.Y / 2 + 1.5, 0), Label = "Blast Door radio" }
	elseif socket then
		wanted.Hall = { At = socket.Position + BLAST_CONSOLE, Label = "Blast Door radio" }
	end
	local g = Grid.Tuning()
	for _, room in grid:RoomsOfType("RadioRoom") do
		local model = grid:RoomModel(room.Id)
		local socket = model and BunkerKit.Socket(model, "Console")
		local cell = Grid.CellPosition(room.Floor, room.Column + (room.Span - 1) / 2)
		local spot = if socket then socket.Position else cell + Vector3.new(0, 0, -g.CellDepth / 2 + RADIO_CONSOLE_BACK)
		-- the set stands on whatever is there: a desk, or the floor
		local top = spot.Y
		if model then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { model }
			local hit = workspace:Raycast(spot + Vector3.new(0, 8, 0), Vector3.new(0, -12, 0), params)
			if hit then
				top = hit.Position.Y
			end
		end
		local base = Vector3.new(spot.X, top, spot.Z)
		wanted[`Radio {room.Id}`] = { At = base + Vector3.new(0, 1.8, 0), Label = "Radio Room", Radio = base }
	end
	for _, child in (holder :: Folder):GetChildren() do
		if not wanted[child.Name] then
			child:Destroy()
		end
	end
	for name, spec in wanted do
		local anchor = (holder :: Folder):FindFirstChild(name) :: BasePart?
		if not anchor then
			local part = Instance.new("Part")
			part.Name = name
			part.Size = Vector3.new(1, 1, 1)
			part.Transparency = 1
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Parent = holder
			consolePrompt(part, spec.Label)
			anchor = part
		end
		(anchor :: BasePart).CFrame = CFrame.new(spec.At)
		local radio = (anchor :: BasePart):FindFirstChild("Radio")
		if spec.Radio and not radio then
			radioSet(anchor :: BasePart, spec.Radio)
		elseif radio and spec.Radio then
			(radio :: Model):PivotTo(CFrame.new(spec.Radio) * CFrame.Angles(0, math.pi, 0))
		end
	end
end

-- Modifiers ----------------------------------------------------------------------------------------------

function ExpeditionService:SetModifier(source: string, key: string, value: number?)
	assert(table.find(MODIFIER_KEYS, key), `ExpeditionService: {key} isn't a modifier it applies`)
	bunkerModifiers[key] = bunkerModifiers[key] or {}
	bunkerModifiers[key][source] = value
end

function ExpeditionService:Active(): number
	local n = 0
	for _ in expeditions do
		n += 1
	end
	return n
end

-- DevTools ---------------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	for _, e in sortedActive() do
		local members = {}
		for _, m in e.Members do
			table.insert(members, `{m.Id} {m.Name} ({m.Status}{if m.Rescue then ` {m.Rescue}` else ""})`)
		end
		table.insert(lines, string.format("%s %s%s: %s; cycle %d of %d%s (left at %d), %s%s; packs %d food %d water %d medkits; finds %s",
			e.Id, e.Destination, if e.Band then ` ({e.Band})` else "", table.concat(members, ", "), e.Done, e.Trip,
			if e.Trip < e.Cycles then ` (a fast team: {e.Cycles} picked)` else "", e.LeftAt, e.State,
			if e.CallIn then string.format(" in %.0fs", e.CallIn) elseif e.Deadline then ` deadline cycle {e.Deadline} at {e.Where}` else "",
			e.Food, e.Water, e.Medkits, findsText(e.Finds, e.Recruits, e.Blueprints, e.Gear)))
		for _, entry in e.Log do
			table.insert(lines, `    {entry}`)
		end
	end
	table.insert(lines, string.format("radio: %s; %.3f recruits a cycle (RecruitRate %.2f), progress %.2f; lead %ds; residents %d of %d",
		if radioWorks() then "a Radio Room hears calls" else "NO working Radio Room (a call goes unheard)",
		radioRate(), bunkerValue("RecruitRate"), radioProgress, bunkerValue("DistressCallLeadSeconds"), residents:Count(), Constants.CAPS.Residents))
	return table.concat(lines, "\n")
end

local function pickExpedition(id: any): Expedition?
	if type(id) == "string" and expeditions[id] then
		return expeditions[id]
	end
	return sortedActive()[1]
end

function ExpeditionService:Init(registry)
	setState = RunState.Writer("ExpeditionService")
	grid = registry.BunkerGrid
	clock = registry.CycleClock
	director = registry.RunDirector
	session = registry.SessionService
	economy = registry.EconomyService
	residents = registry.ResidentService
	brain = registry.ResidentBrain
	rescue = registry.RescueService
	surface = registry.SurfaceService
	deep = registry.DeepService
	disasters = registry.DisasterService
	collection = registry.ReplicationService:Collection("Expeditions")
	Remotes.OnServer("SendExpedition", function(player: Player, destination: string, members: { string }, cycles: number, medkits: number)
		local id, why = ExpeditionService:Send(destination, members, cycles, medkits, player)
		if not id and why then
			Remotes.FireClient("Alert", player, "Warning", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("exp", {
		Description = "Expeditions out, their logs, and the Radio Room (Prompt 18).",
		Usage = "exp",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("exp.send", {
		Description = "Send an expedition from anywhere: destination, cycles, Medkits, resident ids.",
		Usage = "exp.send <surface|deep> <cycles> <medkits> <id> [id] [id]",
		Run = function(_player: Player?, args): string?
			local destination = if string.lower(tostring(args[1] or "")) == "deep" then "Deep" else "Surface"
			local ids = {}
			for i = 4, 6 do
				if args[i] then
					table.insert(ids, tostring(args[i]))
				end
			end
			local id, why = ExpeditionService:Send(destination, ids, tonumber(args[2]) or 1, tonumber(args[3]) or 0, nil)
			return if id then `sent {id}\n{describe()}` else `refused: {why}`
		end,
	})
	dev:Register("exp.cycle", {
		Description = "Every expedition away lives a cycle now (as at dawn); an event forces what happens.",
		Usage = "exp.cycle [Quiet|Hurt|Lost|Distress]",
		Run = function(_player: Player?, args): string?
			local wanted = tostring(args[1] or "")
			local forced = if table.find({ "Quiet", "Hurt", "Lost", "Distress" }, wanted) then wanted else nil
			for _, e in sortedActive() do
				if e.State == "Away" then
					live(e, forced)
				end
			end
			return describe()
		end,
	})
	dev:Register("exp.call", {
		Description = "An expedition radios for help now.",
		Usage = "exp.call [id]",
		Run = function(_player: Player?, args): string?
			local e = pickExpedition(args[1])
			if not e or (e.State ~= "Away" and e.State ~= "Calling") then
				return "no expedition away to call"
			end
			call(e)
			return describe()
		end,
	})
	dev:Register("exp.home", {
		Description = "An expedition away comes home now.",
		Usage = "exp.home [id]",
		Run = function(_player: Player?, args): string?
			local e = pickExpedition(args[1])
			if not e or e.State ~= "Away" then
				return "no expedition away"
			end
			comeHome(e)
			return describe()
		end,
	})
	dev:Register("exp.deadline", {
		Description = "A distress call's time runs out now: whoever is still pinned down is lost.",
		Usage = "exp.deadline",
		Run = function(): string?
			deadline(true)
			return describe()
		end,
	})
	dev:Register("recruit", {
		Description = "A recruit answers the radio now (Common, or the tier given).",
		Usage = "recruit [tier]",
		Run = function(_player: Player?, args): string?
			local id = ExpeditionService:Recruit(if args[1] then tostring(args[1]) else nil, "answered the Radio Room's call")
			return if id then `recruited {id}` else "turned away (the bunker is full)"
		end,
	})
	dev:Register("radio", {
		Description = "The Radio Room's state; 'radio call' plays a Lost Crew's call now.",
		Usage = "radio [call]",
		Run = function(_player: Player?, args): string?
			if tostring(args[1] or "") == "call" then
				return if crewCall(true) then "played a crew's call" else "no Lost Crew is out"
			end
			return describe()
		end,
	})
end

function ExpeditionService:Start()
	rescue:SetArrival("Expedition", arrived)
	rescue.Freed:Connect(helped)
	rescue.Lost:Connect(strayLost)
	clock.CycleStarted:Connect(dawn)
	clock.SurgeStarted:Connect(function()
		deadline(false)
	end)
	syncConsoles()
	grid.Changed:Connect(syncConsoles)
	RunService.Heartbeat:Connect(tick)
	log:Info("expedition consoles: %d", if consoles() then #(consoles() :: Folder):GetChildren() else 0)
end

return ExpeditionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000104"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	InventoryService: what players carry besides their loadout (bible Sections 9, 12 and 13; Run
	place, Prompt 16).

	* Backpacks (Section 9: a 10-slot backpack for loot; Section 12: Scavenger +8, Big Backpack
	  +5 through the BackpackSlots modifier): each player's pack is a Rules.Surface pack, stacks of
	  resources (Tuning.Surface.Stacks to a slot). Give(player, drops) puts loot in: resources into
	  the pack (what doesn't fit comes back as left over), throwables onto the hotbar
	  (WeaponService:GiveThrowable), Clear-Rad pills into the player's pills. The Player attributes
	  PackUsed, PackSlots, Pack ("Scrap:50,Food:8") and ClearRad carry it to the HUD.
	* Hauling (Section 12): loot only counts once dropped at the Blast Door hall or a Storage room.
	  An Unload prompt stands in the hall, 15 studs from the elevator, and in every Storage room: the stockpile takes
	  what it has room for (EconomyService caps) and the rest stays in the pack.
	* A player downed on the surface drops their pack where they fell (Section 9) unless their class
	  keeps it (KeepBackpackWhenDowned): a bag anyone can pick up (what doesn't fit stays in it).
	* Big finds (Section 12: generator parts, cryo pods; carried with both hands, slowly; two
	  carrying together move faster): PlaceFind(kind, at) puts one in workspace.Finds with a Carry
	  prompt. The carrier's hands are busy (the Carrying attribute: WeaponService refuses guns,
	  swings, throws, tools, rolls and Medkits); a teammate within HelpRange can hold Help Carry, and
	  both then walk at TeamCarryWalkMultiplier (the Carriers attribute; each client slows its own
	  character). Put Down drops it, and so does being downed. Unloading delivers it: the handler for
	  its kind (SetDelivery) or else the LootTables entry of that name (Tuning.Surface.BigFindLoot
	  when there is none), straight into the stockpile.
	* Clear-Rad pills (Section 9): up to PillsMax carried; TakePill (SurfaceService takes one when
	  radiation reaches PillUseAt).
	* Monster drops (Section 13: Scrap from monster drops, ore from each band's monsters): a monster's
	  Drops table is rolled when it dies; a kill on the surface or in the Deep goes into the pack of
	  the last player who hit it (only hauled loot counts), a kill in the bunker straight into the
	  stockpile. A player downed in the Deep drops their pack too (Prompt 17).
	* Loot specials (Prompt 17): Give hands a Special to the handler its owner set (SetSpecial:
	  DeepService plays radio logs and pays Glowshard chests); the rest are left over.
	* Blueprints (Prompt 19): DraftService's Blueprint special draws a card and GiveCard puts it in
	  the pack as a stack of its own (the card's id, one a slot). Unloading hands the cards home
	  (CardsHome) for the next draft, like any loot that only counts once hauled.

	CollectBags(player, position, radius) (Prompt 20: Magnet Sweep, the drone) picks up dropped packs nearby.
	Signals: Unloaded(player, delivered: { [resource]: number }), Delivered(player, kind, given),
	CardsHome(player, card ids).
	Dev: pack, pack.add <resource> <n>, pack.clear, pills <n>, find [kind], finds.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Loot = require(Shared.Rules.Loot)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)
local Surface = require(Shared.Rules.Surface)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("InventoryService")

local InventoryService = {
	Name = "InventoryService",
	Dependencies = {
		"SessionService", "BunkerGrid", "EconomyService", "CombatService", "WeaponService", "MonsterService", "RunDirector",
		"ResidentService", "DevService",
	},
	Unloaded = Signal.new() :: Signal.Signal<Player, { [string]: number }>,
	Delivered = Signal.new() :: Signal.Signal<Player, string, { Loot.Drop }>,
	CardsHome = Signal.new() :: Signal.Signal<Player, { string }>,
}

-- Loot nothing hands out yet: recruits (18), the Lamp (placeables). Radio logs, Glowshards
-- (Prompt 17), blueprints (Prompt 19) and gear (Prompt 26: the gear locker) go to their handlers
-- (SetSpecial).
local SKIP: { [string]: boolean } = { Recruit = true, Lamp = true }
local HALL_UNLOAD = Vector3.new(15, 0, 1) -- from the Blast Door's Door socket, towards the shaft: far enough from
-- RIDE UP (at the socket) that one prompt never hides the other (playtest: at 9 studs the elevator won the E press)
local UNLOAD_RANGE = 8
local CARRY_OFFSET = CFrame.new(0, -0.9, -2.3) -- its foot at the carrier's waist, in front
local FULL_WARN_SECONDS = 8

type Find = {
	Id: string,
	Kind: string,
	Model: Model,
	Root: BasePart,
	Carrier: Player?,
	Helpers: { [Player]: boolean },
	Weld: WeldConstraint?,
	Carry: ProximityPrompt,
	Help: ProximityPrompt,
	Put: ProximityPrompt,
	Tag: string?,
}
type Bag = { Id: string, Model: Model, Pack: Surface.Pack, Prompt: ProximityPrompt, Owner: string }
type Hit = { Player: Player?, Zone: string, At: number }

local residentService: any = nil
local grid: any = nil
local economy: any = nil
local combat: any = nil
local weapons: any = nil
local monsterService: any = nil
local director: any = nil

local packs: { [Player]: Surface.Pack } = {}
local pills: { [Player]: number } = {}
local finds: { [string]: Find } = {}
local carrying: { [Player]: string } = {} -- player -> the find they carry or help with
local bags: { [string]: Bag } = {}
local deliveries: { [string]: (Player, string) -> { Loot.Drop } } = {}
local specials: { [string]: (Player, number) -> number } = {} -- a loot Special -> its handler (how many it took)
local lastHit: { [string]: Hit } = {}
local fullWarnedAt: { [Player]: number } = {}
local counter = 0
local rng = Random.new()

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function alertAll(kind: string, text: string)
	for _, player in Players:GetPlayers() do
		alert(player, kind, text)
	end
end

local function alive(player: Player): boolean
	return player:GetAttribute("Life") == "Alive"
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function slotsOf(player: Player): number
	return Surface.Slots(Modifiers.PlayerValue(player, "BackpackSlots") or 0) -- the Scout's level 2 too (Prompt 20)
end

local function publish(player: Player)
	local pack = packs[player] or {}
	player:SetAttribute("PackUsed", Surface.Used(pack))
	player:SetAttribute("PackSlots", slotsOf(player))
	player:SetAttribute("Pack", Surface.Encode(pack))
	player:SetAttribute("ClearRad", pills[player] or 0)
end

local function holder(name: string): Folder
	local folder = workspace:FindFirstChild(name)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = workspace
	end
	return folder :: Folder
end

local function makePrompt(parent: Instance, kind: string, action: string, object: string, hold: number): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = kind .. "Prompt"
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Kind", kind)
	prompt.Parent = parent
	return prompt
end

-- The ground under a point (a big find or a bag lands on it).
local function groundBelow(at: Vector3, ignore: { Instance }): Vector3
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local list = table.clone(ignore)
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	table.insert(list, holder("Finds"))
	local monsters = workspace:FindFirstChild("Monsters")
	if monsters then
		table.insert(list, monsters)
	end
	params.FilterDescendantsInstances = list
	local hit = workspace:Raycast(at + Vector3.new(0, 3, 0), Vector3.new(0, -40, 0), params)
	return if hit then hit.Position else at
end

-- Packs -----------------------------------------------------------------------------------------

function InventoryService:Pack(player: Player): Surface.Pack
	return table.clone(packs[player] or {})
end

function InventoryService:Slots(player: Player): number
	return slotsOf(player)
end

function InventoryService:Pills(player: Player): number
	return pills[player] or 0
end

function InventoryService:TakePill(player: Player): boolean
	if (pills[player] or 0) <= 0 then
		return false
	end
	pills[player] -= 1
	publish(player)
	return true
end

-- Puts loot on a player; returns what they took and what is left over (the pack was full, the
-- pills at PillsMax, the throwable slots full, or nothing carries it yet).
function InventoryService:Give(player: Player, drops: { Loot.Drop }): ({ Loot.Drop }, { Loot.Drop })
	local given: { Loot.Drop } = {}
	local left: { Loot.Drop } = {}
	local pack = packs[player] or {}
	local slots = slotsOf(player)
	for _, drop in drops do
		local took = 0
		if drop.Resource then
			pack, took = Surface.Fit(pack, slots, drop.Resource, drop.Count)
		elseif drop.Item == "ClearRadPills" then
			local have = pills[player] or 0
			took = math.min(drop.Count, math.max(Surface.Tuning().PillsMax - have, 0))
			pills[player] = have + took
		elseif drop.Item then
			local item = Config.Find("Items", drop.Item)
			if item and item.Kind == "Throwable" then
				took = weapons:GiveThrowable(player, drop.Item, drop.Count)
			end
		elseif drop.Special then
			-- a handler may put something in the pack itself (Prompt 19: a blueprint's card), so it
			-- sees the pack as it is now, and this loop carries on from what it left
			packs[player] = pack
			took = InventoryService:GiveSpecial(player, drop.Special, drop.Count)
			pack = packs[player] or pack
		end
		if took > 0 then
			table.insert(given, { Resource = drop.Resource, Item = drop.Item, Special = drop.Special, Count = took })
		end
		if took < drop.Count then
			table.insert(left, { Resource = drop.Resource, Item = drop.Item, Special = drop.Special, Count = drop.Count - took })
		end
	end
	packs[player] = pack
	publish(player)
	return given, left
end

-- A blueprint's card into the player's pack (Prompt 19): its own slot; false when the pack is full.
function InventoryService:GiveCard(player: Player, cardId: string): boolean
	if not Config.Find("DraftCards", cardId) then
		return false
	end
	local pack, took = Surface.Fit(packs[player] or {}, slotsOf(player), cardId, 1)
	if took < 1 then
		return false
	end
	packs[player] = pack
	publish(player)
	return true
end

-- Loot specials (Prompt 17): who handles a Special, and handing one over (how many were taken).
function InventoryService:SetSpecial(special: string, fn: ((Player, number) -> number)?)
	specials[special] = fn
end

function InventoryService:GiveSpecial(player: Player, special: string, count: number): number
	local handler = specials[special]
	if not handler or count <= 0 then
		return 0
	end
	local ok, took = pcall(handler, player, count)
	if not ok then
		log:Warn("special %s for %s: %s", special, player.Name, tostring(took))
		return 0
	end
	return math.clamp(math.floor(tonumber(took) or 0), 0, count)
end

local function packLine(player: Player): string
	return `PACK {Surface.Used(packs[player] or {})}/{slotsOf(player)}`
end

function InventoryService:PackLine(player: Player): string
	return packLine(player)
end

-- Big finds -------------------------------------------------------------------------------------

local function setCarriers(f: Find)
	local n = if f.Carrier then 1 else 0
	for _ in f.Helpers do
		n += 1
	end
	if f.Carrier then
		f.Carrier:SetAttribute("Carriers", n)
	end
	for helper in f.Helpers do
		helper:SetAttribute("Carriers", n)
	end
	f.Model:SetAttribute("Carriers", n)
end

local function freeHands(player: Player)
	carrying[player] = nil
	player:SetAttribute("Carrying", nil)
	player:SetAttribute("Carriers", nil)
	weapons:RefreshHeld(player)
end

local function releaseHelper(f: Find, player: Player, why: string?)
	if not f.Helpers[player] then
		return
	end
	f.Helpers[player] = nil
	freeHands(player)
	setCarriers(f)
	if why then
		alert(player, "Info", why)
	end
end

-- The prompts stay enabled on the server; each client shows the one that is for it (CarriedBy:
-- Carry when nobody carries it, Put Down for the carrier, Help Carry for everyone else).
local function setPrompts(f: Find)
	local by = if f.Carrier then f.Carrier.UserId else nil
	f.Model:SetAttribute("CarriedBy", by)
	for _, prompt in { f.Carry, f.Help, f.Put } do
		prompt:SetAttribute("CarriedBy", by)
	end
end

local function settle(f: Find, at: Vector3)
	local ground = groundBelow(at, { f.Model })
	local rotation = CFrame.Angles(0, select(2, f.Root.CFrame:ToEulerAnglesYXZ()), 0)
	f.Model:PivotTo(CFrame.new(ground) * rotation)
	f.Root.Anchored = true
	for _, part in f.Model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = part:GetAttribute("Collides") == true
			part.Massless = false
		end
	end
end

local function putDown(f: Find, why: string?)
	local carrier = f.Carrier
	if f.Weld then
		f.Weld:Destroy()
		f.Weld = nil
	end
	f.Carrier = nil
	for helper in table.clone(f.Helpers) do
		releaseHelper(f, helper, nil)
	end
	if carrier then
		freeHands(carrier)
		if why then
			alert(carrier, "Info", why)
		end
	end
	settle(f, f.Root.Position)
	setPrompts(f)
	setCarriers(f)
end

local function pickUp(f: Find, player: Player)
	if f.Carrier or carrying[player] or not alive(player) or player:GetAttribute("Riding") then
		return
	end
	local root = rootOf(player)
	if not root or (root.Position - f.Root.Position).Magnitude > 14 then
		return
	end
	f.Root.Anchored = false
	for _, part in f.Model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.Massless = true
		end
	end
	f.Model:PivotTo(root.CFrame * CARRY_OFFSET)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = f.Root
	weld.Parent = f.Root
	f.Weld = weld
	f.Carrier = player
	carrying[player] = f.Id
	player:SetAttribute("Carrying", f.Kind)
	weapons:RefreshHeld(player)
	setPrompts(f)
	setCarriers(f)
	log:Info("%s picked up %s (%s)", player.Name, f.Id, f.Kind)
end

local function help(f: Find, player: Player)
	if not f.Carrier or f.Carrier == player or carrying[player] or not alive(player) then
		return
	end
	local root = rootOf(player)
	if not root or (root.Position - f.Root.Position).Magnitude > Surface.Tuning().HelpRange + 2 then
		return
	end
	f.Helpers[player] = true
	carrying[player] = f.Id
	player:SetAttribute("Carrying", f.Kind)
	weapons:RefreshHeld(player)
	setCarriers(f)
	alert(f.Carrier :: Player, "Info", `{string.upper(player.DisplayName)} IS HELPING YOU CARRY IT`)
end

local function findName(kind: string): string
	local entry = Config.Find("LootTables", kind) or Config.Find("DigResults", kind) -- generator parts; a cryo pod
	return if entry then entry.Text or entry.Name else kind
end

local function makeFindModel(kind: string): Model
	local assets = ServerStorage:FindFirstChild("Assets")
	local props = assets and assets:FindFirstChild("Props")
	local source = props and props:FindFirstChild(`Prop_{kind}`)
	if source and source:IsA("Model") then
		return source:Clone()
	end
	-- graybox: a crate of parts with a hazard band
	local model = Instance.new("Model")
	model.Name = `Prop_{kind}`
	local box = Instance.new("Part")
	box.Name = "Root"
	box.Size = Vector3.new(3, 2.2, 2.2)
	box.Color = Color3.fromRGB(96, 102, 110)
	box.Material = Enum.Material.Metal
	box.PivotOffset = CFrame.new(0, -1.1, 0) -- the pivot at the foot, like the art's
	box.Parent = model
	local band = Instance.new("Part")
	band.Name = "Band"
	band.Size = Vector3.new(3.1, 0.5, 2.3)
	band.Color = Color3.fromHex("#F2C14E")
	band.CFrame = box.CFrame * CFrame.new(0, 0.5, 0)
	band.Parent = model
	model.PrimaryPart = box
	return model
end

-- Puts a big find in the world; returns its id.
function InventoryService:PlaceFind(kind: string, at: CFrame, tag: string?): string
	counter += 1
	local id = `F{counter}`
	local model = makeFindModel(kind)
	model.Name = `{kind}_{id}`
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	assert(root, "a big find needs a part")
	model.PrimaryPart = root
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part:SetAttribute("Collides", part.CanCollide)
			part.CanQuery = false
			part.CanTouch = false
			if part ~= root then
				part.Anchored = false
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = part
				weld.Parent = part
			end
		end
	end
	root.Anchored = true
	model:PivotTo(at)
	model:SetAttribute("FindId", id)
	model:SetAttribute("BigFind", kind)
	model.Parent = holder("Finds")
	local name = findName(kind)
	local t = Surface.Tuning()
	local f: Find = {
		Id = id,
		Kind = kind,
		Model = model,
		Root = root :: BasePart,
		Carrier = nil,
		Helpers = {},
		Weld = nil,
		Carry = makePrompt(root, "Carry", "CARRY", name, t.PickUpSeconds),
		Help = makePrompt(root, "HelpCarry", "HELP CARRY", name, 0.5),
		Put = makePrompt(root, "PutDown", "PUT DOWN", name, 0),
		Tag = tag,
	}
	f.Carry.Triggered:Connect(function(player: Player)
		pickUp(f, player)
	end)
	f.Help.Triggered:Connect(function(player: Player)
		help(f, player)
	end)
	f.Put.Triggered:Connect(function(player: Player)
		if f.Carrier == player then
			putDown(f, nil)
		end
	end)
	finds[id] = f
	settle(f, at.Position)
	setPrompts(f)
	log:Info("%s placed (%s)", id, kind)
	return id
end

function InventoryService:RemoveFind(id: string)
	local f = finds[id]
	if not f then
		return
	end
	if f.Carrier then
		putDown(f, nil)
	end
	finds[id] = nil
	f.Model:Destroy()
end

function InventoryService:Finds(tag: string?): { { Id: string, Kind: string, Position: Vector3, Carried: boolean } }
	local list = {}
	for id, f in finds do
		if tag == nil or f.Tag == tag then
			table.insert(list, { Id = id, Kind = f.Kind, Position = f.Root.Position, Carried = f.Carrier ~= nil })
		end
	end
	return list
end

-- What a player has in their hands: the find's id and kind, and whether they lead (carry) it.
function InventoryService:Carrying(player: Player): (string?, string?, boolean)
	local id = carrying[player]
	local f = id and finds[id]
	if not f then
		return nil, nil, false
	end
	return f.Id, f.Kind, f.Carrier == player
end

-- How a kind of find pays when hauled home (cryo pods thaw instead: Prompt 17).
function InventoryService:SetDelivery(kind: string, fn: (Player, string) -> { Loot.Drop })
	deliveries[kind] = fn
end

local function deliverFind(player: Player): (string?, { Loot.Drop })
	local id = carrying[player]
	local f = id and finds[id]
	if not f or f.Carrier ~= player then
		return nil, {}
	end
	local kind = f.Kind
	local given: { Loot.Drop } = {}
	local handler = deliveries[kind]
	finds[f.Id] = nil
	if f.Weld then
		f.Weld:Destroy()
	end
	for helper in table.clone(f.Helpers) do
		releaseHelper(f, helper, nil)
	end
	freeHands(player)
	f.Model:Destroy()
	if handler then
		given = handler(player, kind)
	else
		local tableId = if Config.Find("LootTables", kind) then kind else Surface.Tuning().BigFindLoot
		for _, drop in Loot.Roll(tableId, rng, { Skip = SKIP }) do
			if drop.Resource then
				local added = economy:Add(drop.Resource, drop.Count, `{kind} hauled by {player.Name}`)
				if added > 0 then
					table.insert(given, { Resource = drop.Resource, Count = added })
				end
			end
		end
	end
	InventoryService.Delivered:Fire(player, kind, given)
	return kind, given
end

-- Unloading -------------------------------------------------------------------------------------

function InventoryService:Unload(player: Player): { [string]: number }
	-- blueprints (Prompt 19) come out first: home, they join the next draft
	local cards: { string } = {}
	local kept = {}
	for _, stack in packs[player] or {} do
		if Config.Find("DraftCards", stack.Id) then
			for _ = 1, stack.Count do
				table.insert(cards, stack.Id)
			end
		else
			table.insert(kept, stack)
		end
	end
	if #cards > 0 then
		packs[player] = kept
		InventoryService.CardsHome:Fire(player, cards)
	end
	local pack = packs[player] or {}
	local room: { [string]: number } = {}
	for _, stack in pack do
		if room[stack.Id] == nil then
			local resource = Config.Find("Resources", stack.Id)
			room[stack.Id] = if resource and resource.Kind == "Stock"
				then math.max(economy:Cap(stack.Id) - economy:Get(stack.Id), 0)
				else 0
		end
	end
	local delivered, leftover = Surface.Unload(pack, room)
	local drops: { Loot.Drop } = {}
	for _, stack in Surface.Totals(pack) do
		local n = delivered[stack.Id]
		if n and n > 0 then
			economy:Add(stack.Id, n, `hauled by {player.Name}`)
			table.insert(drops, { Resource = stack.Id, Count = n })
		end
	end
	packs[player] = leftover
	publish(player)
	local kind, given = deliverFind(player)
	if #drops > 0 then
		local text = `UNLOADED {Loot.Text(drops)}`
		if #leftover > 0 then
			text ..= ` · NO ROOM FOR {Surface.Summary(leftover)}: IT STAYS IN YOUR PACK`
		end
		alert(player, "Info", text)
		InventoryService.Unloaded:Fire(player, delivered)
	elseif #leftover > 0 and not kind then
		alert(player, "Warning", `THE STOCKPILE IS FULL: {Surface.Summary(leftover)} STAYS IN YOUR PACK`)
	end
	if kind then
		alertAll("Info", `{string.upper(player.DisplayName)} HAULED HOME {string.upper(findName(kind))}{if #given > 0 then `: {Loot.Text(given)}` else ""}`)
	end
	return delivered
end

local function unloadAnchor(folder: Folder, name: string, at: Vector3, object: string)
	local anchor = folder:FindFirstChild(name) :: BasePart?
	if not anchor then
		local part = Instance.new("Part")
		part.Name = name
		part.Size = Vector3.new(1, 1, 1)
		part.Transparency = 1
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Parent = folder
		local prompt = makePrompt(part, "Unload", "UNLOAD", object, 0)
		prompt.MaxActivationDistance = UNLOAD_RANGE
		prompt.Triggered:Connect(function(player: Player)
			InventoryService:Unload(player)
		end)
		anchor = part
	end
	(anchor :: BasePart).CFrame = CFrame.new(at)
	anchor:SetAttribute("Seen", true)
end

local function syncUnloadPoints()
	local root = grid:Root()
	if not root then
		return
	end
	local folder = root:FindFirstChild("Hauling") :: Folder?
	if not folder then
		local made = Instance.new("Folder")
		made.Name = "Hauling"
		made.Parent = root
		folder = made
	end
	local hauling = folder :: Folder
	for _, child in hauling:GetChildren() do
		child:SetAttribute("Seen", nil)
	end
	for _, room in grid:RoomsOfType("BlastDoor") do
		local model = grid:RoomModel(room.Id)
		local door = model and BunkerKit.Socket(model, "Door")
		local at = if door then door.Position + HALL_UNLOAD
			else Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, 0, -8)
		unloadAnchor(hauling, "Hall", at + Vector3.new(0, 2.5, 0), "Blast Door hall")
	end
	for _, room in grid:RoomsOfType("Storage") do
		local cell = Grid.CellPosition(room.Floor, room.Column + (room.Span - 1) / 2)
		unloadAnchor(hauling, `Storage {room.Id}`, cell + Vector3.new(0, 2.5, 6), "Storage")
	end
	for _, child in hauling:GetChildren() do
		if not child:GetAttribute("Seen") then
			child:Destroy()
		end
	end
end

-- Bags ------------------------------------------------------------------------------------------

local function makeBagModel(): Model
	local assets = ServerStorage:FindFirstChild("Assets")
	local props = assets and assets:FindFirstChild("Props")
	local source = props and props:FindFirstChild("Prop_LootBag")
	if source and source:IsA("Model") then
		return source:Clone()
	end
	local model = Instance.new("Model")
	local sack = Instance.new("Part")
	sack.Name = "Root"
	sack.Shape = Enum.PartType.Ball
	sack.Size = Vector3.new(2, 2, 2)
	sack.Color = Color3.fromRGB(122, 92, 60)
	sack.Material = Enum.Material.Fabric
	sack.PivotOffset = CFrame.new(0, -1, 0)
	sack.Parent = model
	model.PrimaryPart = sack
	return model
end

local function updateBag(bag: Bag)
	bag.Prompt.ObjectText = `{bag.Owner}'s pack: {Surface.Summary(bag.Pack)}`
end

local function pickUpBag(bag: Bag, player: Player)
	if not bags[bag.Id] or not alive(player) then
		return
	end
	local merged, leftover = Surface.Merge(packs[player] or {}, bag.Pack, slotsOf(player))
	packs[player] = merged
	bag.Pack = leftover
	publish(player)
	if #leftover == 0 then
		bags[bag.Id] = nil
		bag.Model:Destroy()
		alert(player, "Info", `PICKED UP {string.upper(bag.Owner)}'S PACK · {packLine(player)}`)
	else
		updateBag(bag)
		alert(player, "Warning", `YOUR PACK IS FULL: {Surface.Summary(leftover)} STAYS IN THE BAG`)
	end
end

-- Magnet Sweep and the Tinkerer's drone (Prompt 20): dropped packs within `radius` of `position`
-- go into the player's pack (what doesn't fit stays in the bag). Returns how many were reached.
function InventoryService:CollectBags(player: Player, position: Vector3, radius: number): number
	local n = 0
	for _, bag in table.clone(bags) do
		if (bag.Model:GetPivot().Position - position).Magnitude <= radius then
			pickUpBag(bag, player)
			n += 1
		end
	end
	return n
end

local function dropBag(player: Player, at: Vector3)
	local pack = packs[player]
	if not pack or #pack == 0 then
		return
	end
	counter += 1
	local id = `B{counter}`
	local model = makeBagModel()
	model.Name = `LootBag_{id}`
	model:SetAttribute("Bag", id) -- the Scout's Flare Ping outlines it (Prompt 20)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
		end
	end
	model:PivotTo(CFrame.new(groundBelow(at, {})) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model.Parent = holder("Finds")
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true) :: BasePart
	local bag: Bag = {
		Id = id,
		Model = model,
		Pack = pack,
		Prompt = makePrompt(root, "PickUp", "PICK UP", "", 0.5),
		Owner = player.DisplayName,
	}
	bag.Prompt.Triggered:Connect(function(by: Player)
		pickUpBag(bag, by)
	end)
	updateBag(bag)
	bags[id] = bag
	packs[player] = {}
	publish(player)
	alert(player, "Warning", "YOU DROPPED YOUR PACK WHERE YOU FELL: GO BACK FOR IT")
	log:Info("%s dropped %s (%s)", player.Name, id, Surface.Summary(pack))
end

-- Monster drops ---------------------------------------------------------------------------------

local function onMonsterDied(id: string, monsterType: string)
	local hit = lastHit[id]
	lastHit[id] = nil
	local spec = Config.Find("Monsters", monsterType)
	if not spec or not spec.Drops then
		return
	end
	local drops = Loot.Roll(spec.Drops, rng, { Skip = SKIP })
	if hit and hit.Zone ~= "Bunker" then
		local player = hit.Player
		if player and player.Parent == Players and alive(player) then
			local _, left = InventoryService:Give(player, drops)
			if #left > 0 and os.clock() - (fullWarnedAt[player] or 0) > FULL_WARN_SECONDS then
				fullWarnedAt[player] = os.clock()
				alert(player, "Warning", `PACK FULL: {packLine(player)}`)
			end
		end
		return
	end
	for _, drop in drops do
		if drop.Resource then
			economy:Add(drop.Resource, drop.Count, `{monsterType} {id}`)
		end
	end
end

-- Life ------------------------------------------------------------------------------------------

local function letGo(player: Player, why: string?)
	local id = carrying[player]
	local f = id and finds[id]
	if not f then
		carrying[player] = nil
		return
	end
	if f.Carrier == player then
		putDown(f, why)
	else
		releaseHelper(f, player, why)
	end
end

local function onDowned(combatantId: string)
	local c = combat:Get(combatantId)
	local player = c and c.Player
	if not player then
		return
	end
	letGo(player, nil)
	local root = rootOf(player)
	if root and Surface.Zone(root.Position) ~= "Bunker" and not Modifiers.PlayerValue(player, "KeepBackpackWhenDowned") then
		dropBag(player, root.Position)
	end
end

local function helperLoop()
	while true do
		task.wait(0.5)
		local range = Surface.Tuning().HelpRange + 4
		for _, f in finds do
			for helper in table.clone(f.Helpers) do
				local root = rootOf(helper)
				if not root or not alive(helper) or (root.Position - f.Root.Position).Magnitude > range then
					releaseHelper(f, helper, "YOU LET GO")
				end
			end
		end
		local cutoff = os.clock() - 120
		for id, hit in lastHit do
			if hit.At < cutoff then
				lastHit[id] = nil
			end
		end
	end
end

local function clearAll()
	for id in table.clone(finds) do
		InventoryService:RemoveFind(id)
	end
	for id, bag in bags do
		bag.Model:Destroy()
		bags[id] = nil
	end
	for _, player in Players:GetPlayers() do
		packs[player] = {}
		publish(player)
	end
end

-- Dev -------------------------------------------------------------------------------------------

local function target(player: Player?): Player?
	return player or Players:GetPlayers()[1]
end

local function registerCommands(dev: any)
	dev:Register("pack", {
		Description = "Your backpack, Clear-Rad pills and what you carry (Prompt 16).",
		Usage = "pack",
		Run = function(player): string?
			local p = target(player)
			if not p then
				return "no player"
			end
			local id, kind, lead = InventoryService:Carrying(p)
			return `{packLine(p)}: {Surface.Summary(packs[p] or {})} · Clear-Rad {pills[p] or 0}`
				.. (if id then ` · carrying {kind} ({id}{if lead then "" else ", helping"})` else "")
				.. ` · {#InventoryService:Finds()} finds, bags: {(function()
					local n = 0
					for _ in bags do
						n += 1
					end
					return n
				end)()}`
		end,
	})
	dev:Register("pack.add", {
		Description = "Put resources in your backpack, or Blueprint (found as loot is: a card drawn for the draft, Prompt 19) or Gear (found as loot is: into the gear locker, Prompt 26).",
		Usage = "pack.add <resource|Blueprint|Gear> <n>",
		Run = function(player, args): string?
			local p = target(player)
			local id = tostring(args[1] or "")
			if p and (id == "Blueprint" or id == "Gear") then
				local _, left = InventoryService:Give(p, { { Special = id, Count = math.max(math.floor(tonumber(args[2]) or 1), 1) } })
				return `{packLine(p)}: {Surface.Summary(packs[p] or {})}{if #left > 0 then ` (left over {Loot.Text(left)})` else ""}`
			end
			if not p or not Config.Find("Resources", id) then
				return "pack.add <resource|Blueprint|Gear> <n>"
			end
			local _, left = InventoryService:Give(p, { { Resource = id, Count = math.max(math.floor(tonumber(args[2]) or 10), 1) } })
			return `{packLine(p)}: {Surface.Summary(packs[p] or {})}{if #left > 0 then ` (left over {Loot.Text(left)})` else ""}`
		end,
	})
	dev:Register("pack.clear", {
		Description = "Empty your backpack.",
		Usage = "pack.clear",
		Run = function(player): string?
			local p = target(player)
			if not p then
				return "no player"
			end
			packs[p] = {}
			publish(p)
			return packLine(p)
		end,
	})
	dev:Register("pills", {
		Description = "Set your Clear-Rad pills.",
		Usage = "pills <n>",
		Run = function(player, args): string?
			local p = target(player)
			if not p then
				return "no player"
			end
			pills[p] = math.clamp(math.floor(tonumber(args[1]) or 1), 0, Surface.Tuning().PillsMax)
			publish(p)
			return `Clear-Rad {pills[p]}`
		end,
	})
	dev:Register("find", {
		Description = "Put a big find (generator parts) in front of you.",
		Usage = "find [kind]",
		Run = function(player, args): string?
			local p = target(player)
			local root = p and rootOf(p)
			if not root then
				return "no player"
			end
			local kind = tostring(args[1] or Surface.Tuning().BigFindLoot)
			local id = InventoryService:PlaceFind(kind, root.CFrame * CFrame.new(0, 0, -7), "Dev")
			return `{id} ({kind})`
		end,
	})
end

function InventoryService:Init(registry)
	residentService = registry.ResidentService
	grid = registry.BunkerGrid
	economy = registry.EconomyService
	combat = registry.CombatService
	weapons = registry.WeaponService
	monsterService = registry.MonsterService
	director = registry.RunDirector
	registerCommands(registry.DevService)
end

function InventoryService:Start()
	-- Prompt 26: gear found in a container or on a raider goes to the bunker's gear locker
	InventoryService:SetSpecial("Gear", function(player: Player, count: number): number
		return residentService:FindGear(player, count)
	end)
	local function joined(player: Player)
		packs[player] = packs[player] or {}
		pills[player] = pills[player] or 0
		publish(player)
		player:GetAttributeChangedSignal("Class"):Connect(function()
			publish(player)
		end)
		-- a new character (a respawn) has free hands
		player.CharacterAdded:Connect(function()
			letGo(player, nil)
		end)
	end
	for _, player in Players:GetPlayers() do
		joined(player)
	end
	Players.PlayerAdded:Connect(joined)
	Players.PlayerRemoving:Connect(function(player: Player)
		letGo(player, nil)
		local root = rootOf(player)
		if root and Surface.Zone(root.Position) ~= "Bunker" then
			dropBag(player, root.Position)
		end
		packs[player] = nil
		pills[player] = nil
		fullWarnedAt[player] = nil
	end)
	combat.Downed:Connect(onDowned)
	combat.Died:Connect(function(id: string)
		local c = combat:Get(id)
		local player = c and c.Player
		if player then
			letGo(player, nil)
		end
	end)
	combat.Damaged:Connect(function(targetId: string, _amount: number, sourceId: string?)
		if string.sub(targetId, 1, 1) ~= "M" then
			return
		end
		local zone = monsterService:ZoneOf(targetId)
		if not zone then
			return
		end
		local previous = lastHit[targetId]
		local player: Player? = if previous then previous.Player else nil
		if sourceId and string.sub(sourceId, 1, 1) == "P" then
			player = Players:GetPlayerByUserId(tonumber(string.sub(sourceId, 2)) or 0) or player
		end
		lastHit[targetId] = { Player = player, Zone = zone, At = os.clock() }
	end)
	monsterService.Died:Connect(onMonsterDied)
	grid.Changed:Connect(syncUnloadPoints)
	syncUnloadPoints()
	director.RunEnded:Connect(clearAll)
	task.spawn(helperLoop)
	log:Info("backpacks ready: %d slots, unload points at the Blast Door hall and Storage", Config.Get("Tuning", "Player").BackpackSlots)
end

return InventoryService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000105"><Properties><string name="Name">MonsterService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MonsterService: monsters in the bunker and the monster cap (bible Sections 10 and 23, the
	Appendix's monster table). Run place only; Prompt 12.

	Spawning
	* Spawn(type, at, tag?) makes a monster from ServerStorage.Assets.Monsters.<Asset> (A4), or a
	  graybox rig until its model exists, in workspace.Monsters. It registers with CombatService
	  (team Monsters) and carries Rig, MonsterType, Activity and AttackAt attributes for
	  NPCAnimator (Section 23: clips play on clients from replicated state).
	* At most Tuning.Threat.MaxMonsters are on the map at once (Section 23's cap of 25); the rest
	  wait in a queue and come out where they were meant to as others die.
	* Tags group monsters (a Surge's wave: "Surge:7"); Count(tag) includes the queue.

	Behaviour, 5 times a second (Tuning.MonsterAI)
	* Targets (Section 10): residents first, then machines, then players who hit them; each type
	  has its own order (Config.Monsters.Targets). "Players" means players who hit it in the last
	  AggroSeconds, or who come within ProximityAggro (Runners only answer hits: Section 10's
	  Tunnel Hound sprints past defenders). Downed residents and players are left alone.
	* Walking: the room graph (Lib.PathGraph: doorways, Shaft stairs; Section 23), MoveTo at the
	  type's MoveSpeed; stuck for StuckSeconds, it steps to its next waypoint.
	* Attacks: in Range, a windup (the rig's HitTime attribute, else WindupFraction of
	  AttackSeconds), then the hit is checked again (Monster Lab's rule) and lands:
	  - on a player or resident through CombatService:Damage;
	  - on a machine (a room): its HP falls by RoomDamageMultiplier of the damage (SmashesMachines:
	    SmashMultiplier times that). A wrecked
	    room stops (Prompt 9) and isn't a target until it is repaired. The Reactor Core at 0 HP
	    starts the meltdown (DisasterService, Prompt 13).
	* The surface (Prompt 16): a monster and its targets must be in the same realm (Rules.Surface:
	  the town high above, or underground: the bunker and the Deep's caves behind it, Prompt 17). On
	  the surface there are no machines, rescued survivors count as residents, players are seen from
	  SurfaceAggro, and paths come from PathfindingService (Section 23), planned off the AI's thread
	  every PathSeconds. Ash Jackals (PackRunner) circle at CircleRadius between bites; Ash Raiders
	  (Shoots) keep their distance and fire a rifle (ShotAccuracy, line of sight checked when the
	  shot lands).
	* The Deep (Prompt 17): in a cave there are no machines either, players are seen from
	  Tuning.Deep.DeepAggro, and paths come from PathfindingService; a target in the bunker is
	  reached through the cave's mouth (SetCaveExit: DeepService says where a cave position's mouth
	  is), and a monster in the bunker goes after a target in a cave the same way round.
	* Guards (Spawn's options.Guard, Prompt 17: the caves' guards and the raider camp's): asleep at
	  their post until a player comes within Guard studs or hits them; awake, they only go after
	  what is within 1.6 times that of their post, and with nothing left they walk back and sleep.
	* Traits: Latches (Burrow Tick) hangs on a resident and bites until killed or swatted;
	  Slows (Spitter Grub) keeps its distance and spits goo that slows (players: the SlowedUntil
	  attribute; residents: their walk); stunned monsters (StunnedUntil: melee, Shock Mines)
	  stand still.
	* The Flooded Caverns (Prompt 23). Explodes (Bloat Toad): on contact it swells for
	  BurstSwellSeconds and bursts, and it bursts when killed: everyone within BurstRadius and the
	  room's machines are hurt, and the Burst signal says where (ThreatDirector floods the room).
	  Hides and Grabs (Lurker): it walks to the nearest room that is deep in water or dark and lies
	  in wait there (the Hidden attribute; clients draw it almost unseen), strikes whoever comes
	  within reach and takes hold of a resident (their Grabbed attribute: they can't move) until it
	  is hit for GrabBreakDamage, stunned or killed; after HideSeconds with nobody in reach it
	  hunts like the rest. ArmoredFront and WeakPointBack (Tide Crab): a damage filter, by where the
	  blow comes from (the ShellHitAt and WeakHitAt attributes tell clients which it was).
	  Murklings need nothing here: ThreatDirector sends them out of flooded rooms.
	* The Crystal Hollows (Prompt 24). Shatters (Shardling): killed, its shards sting everyone
	  within ShatterRadius (the Shattered attribute: the client's burst). Invisible (Prism Stalker):
	  Hidden unless a flare or a lamp lights it (parts tagged RevealLight with a Radius; Rules.Threat
	  .Lit) and for StalkerRevealSeconds after it strikes or is hit. ShrugsSmallGuns (Geode Golem):
	  a WeaponService hit modifier, SmallGunMultiplier of a small gun's shot (ShruggedAt: the
	  client's ricochet). Heals and Hastes (Resonator): it follows the pack, never strikes, and
	  every AttackSeconds its hum (HumAt) heals the monsters within its Range and quickens them for
	  HasteSeconds (their HummedAt and Hasted attributes). Bosses are not monsters here: no hum
	  reaches them.

	API:
		MonsterService.Spawned: Signal<string, string, string?> -- id, type, tag
		MonsterService.Died: Signal<string, string, string?>    -- id, type, tag
		MonsterService.Burst: Signal<string, string, Vector3, string?> -- a Bloat Toad burst: id, type, where, unit
		MonsterService:Spawn(type, at: CFrame, tag?, options?): string? -- nil when queued (or no such type); options.Guard
		MonsterService:SetCaveExit(fn)                          -- fn(position in a cave): its mouth, in the bunker
		MonsterService:Count(tag?): number                      -- alive plus queued
		MonsterService:All(): { { Id, Type, Tag, Position } }
		MonsterService:InUnit(unit): number                     -- monsters in a room or dug cell
		MonsterService:Clear()
		MonsterService:Despawn(id)                              -- fades one away (the surface's leftovers)
		MonsterService:ZoneOf(id): string?
		MonsterService:Taunt(sourceId, position, radius, seconds): number -- Hold the Line (Prompt 20)
	Dev: monster, monster.hit, monsters, monsters.clear.
]]

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local Surface = require(Shared.Rules.Surface)
local Threat = require(Shared.Rules.Threat)
local Hazards = require(ServerScriptService.Lib.Hazards)
local PathGraph = require(ServerScriptService.Lib.PathGraph)

local log = Log.new("MonsterService")

local MonsterService = {
	Name = "MonsterService",
	Dependencies = { "CombatService", "BunkerGrid", "ResidentService", "RunDirector", "PowerService", "WeaponService", "DevService" },
	Spawned = Signal.new() :: Signal.Signal<string, string, string?>,
	Burst = Signal.new() :: Signal.Signal<string, string, Vector3, string?>, -- id, type, where, its room or cell (Prompt 23)
	Died = Signal.new() :: Signal.Signal<string, string, string?>,
}

local MONSTER_GROUP = "Monsters"
local ARRIVE = 2.5
local REPLAN_SECONDS = 2.5
local FLOOR_PENALTY = 40 -- studs a floor's difference counts as, when picking the nearest target
local BLOCKED_SKIP_SECONDS = 6 -- rubble cuts a target off: look for others this long (Prompt 13)
local NO_MACHINE: { [string]: boolean } = { Shaft = true }

type Target = { Kind: string, Id: string, RoomId: string?, Position: Vector3 }
type Monster = {
	Id: string,
	Type: string,
	Tag: string?,
	Spec: any,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Target: Target?,
	TargetAt: number,
	Points: { Vector3 },
	Index: number,
	Best: number,
	Since: number,
	PlannedFor: string?, -- the target unit the points lead to
	PlannedAt: number,
	PlannedVersion: number, -- Lib.Hazards' version when planned: rubble falling or cleared plans again
	AttackReadyAt: number,
	Aggro: { [string]: number }, -- player combatant id -> until (os.clock)
	Skip: { [string]: number }, -- a target id rubble cuts it off from -> until (os.clock; Prompt 13)
	LatchedTo: string?, -- a resident id (Burrow Ticks)
	Latch: WeldConstraint?,
	Zone: string, -- "Surface", "Bunker" or "Deep" (Prompts 16 and 17)
	Mode: string, -- "Graph" (the room graph) or "Path" (PathfindingService: the surface, the caves)
	Post: Vector3?, -- a guard's post (Prompt 17)
	Guard: number?, -- a guard's wake range
	Asleep: boolean,
	Pathing: boolean, -- a PathfindingService plan is being worked out (the surface)
	Path: Path?,
	CircleUntil: number, -- a PackRunner circles its target until then (os.clock)
	CircleAngle: number,
	Taunt: { Id: string, Until: number }?, -- Hold the Line (Prompt 20): this player comes first until then
	-- Prompt 23: the Flooded Caverns' monsters
	Bursting: boolean?, -- a Bloat Toad swelling, or burst
	HideRoom: string?, -- a Lurker's room to lie in wait in
	HideUntil: number, -- it lies in wait until then (os.clock), then hunts like the rest
	Hunting: boolean?, -- it has given up lying in wait
	Hidden: boolean?,
	Grabbing: string?, -- the resident (a combatant id) a Lurker holds
	GrabDamage: number, -- what it has been hit for since it grabbed
	-- Prompt 24: the Crystal Hollows' monsters
	ShownUntil: number?, -- a Prism Stalker that struck or was hit is seen until then (os.clock)
	HasteUntil: number, -- a Resonator's hum quickens it until then (os.clock)
}

local combat: any = nil
local grid: any = nil
local residents: any = nil
local director: any = nil
local power: any = nil
local weapons: any = nil
local dev: any = nil

export type Options = { Guard: number? }

local monsters: { [string]: Monster } = {}
local queue: { { Type: string, At: CFrame, Tag: string?, Options: Options? } } = {}
local caveExit: ((Vector3) -> Vector3?)? = nil -- DeepService: a cave position's mouth (Prompt 17)
local LEASH = 1.6 -- an awake guard's reach from its post, times its wake range
local folder: Folder? = nil
local rng = Random.new()

local function now(): number
	return workspace:GetServerTimeNow()
end

local function ai(): { [string]: any }
	return Config.Get("Tuning", "MonsterAI")
end

local function cap(): number
	return Config.Get("Tuning", "Threat").MaxMonsters
end

local function holder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = workspace:FindFirstChild("Monsters")
	if not (f and f:IsA("Folder")) then
		f = Instance.new("Folder")
		f.Name = "Monsters"
		f.Parent = workspace
	end
	folder = f :: Folder
	return folder :: Folder
end

local function setActivity(m: Monster, activity: string)
	if m.Model:GetAttribute("Activity") ~= activity then
		m.Model:SetAttribute("Activity", activity)
	end
end

-- Models --------------------------------------------------------------------------------------

-- A graybox rig until A4's model exists: a root, a body, two glowing eyes. Sized by role.
local GRAYBOX: { [string]: { Size: Vector3, Colour: Color3 } } = {
	Swarmer = { Size = Vector3.new(2, 1.2, 2.4), Colour = Color3.fromRGB(64, 59, 55) },
	Runner = { Size = Vector3.new(2.2, 2.6, 4.4), Colour = Color3.fromRGB(94, 106, 68) },
	Brute = { Size = Vector3.new(4.5, 6, 3.5), Colour = Color3.fromRGB(64, 59, 55) },
	Ranged = { Size = Vector3.new(3, 2.4, 4.6), Colour = Color3.fromRGB(138, 154, 70) },
}

local function graybox(monsterType: string, spec: any): Model
	local look = GRAYBOX[spec.Role] or GRAYBOX.Runner
	local model = Instance.new("Model")
	model.Name = monsterType
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(look.Size.X, math.min(2, look.Size.Y), look.Size.Z)
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = look.Size
	body.Color = look.Colour
	body.Material = Enum.Material.Slate
	body.CFrame = root.CFrame
	body.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = body
	weld.Parent = body
	for _, x in { -0.25, 0.25 } do
		local eye = Instance.new("Part")
		eye.Name = "Eye"
		eye.Shape = Enum.PartType.Ball
		eye.Size = Vector3.new(0.4, 0.4, 0.4) * math.max(1, look.Size.X / 2.5)
		eye.Material = Enum.Material.Neon
		eye.Color = Color3.fromRGB(124, 255, 155)
		eye.CanCollide = false
		eye.CFrame = root.CFrame * CFrame.new(x * look.Size.X, look.Size.Y * 0.25, -look.Size.Z / 2)
		eye.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = eye
		w.Parent = eye
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = look.Size.Y / 2 - root.Size.Y / 2 + 0.1
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid
	model.PrimaryPart = root
	model:SetAttribute("Graybox", true)
	return model
end

local function makeModel(monsterType: string, spec: any): Model
	local assets = ServerStorage:FindFirstChild("Assets")
	local monstersFolder = assets and assets:FindFirstChild("Monsters")
	local template = monstersFolder and monstersFolder:FindFirstChild(spec.Asset)
	if template and template:IsA("Model") and template:FindFirstChildOfClass("Humanoid") then
		return template:Clone()
	end
	return graybox(monsterType, spec)
end

-- Spawning ------------------------------------------------------------------------------------

local function aliveCount(): number
	local n = 0
	for _ in monsters do
		n += 1
	end
	return n
end

local function standOn(model: Model, at: CFrame)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { holder(), model }
	local hit = workspace:Raycast(at.Position + Vector3.new(0, 4, 0), Vector3.new(0, -14, 0), params)
	local floorY = if hit then hit.Position.Y else at.Position.Y
	model:PivotTo(at)
	local cf, size = model:GetBoundingBox()
	model:PivotTo(at + Vector3.new(0, floorY - (cf.Position.Y - size.Y / 2) + 0.05, 0))
end

local function spawnNow(monsterType: string, at: CFrame, tag: string?, options: Options?): string?
	local spec = Config.Find("Monsters", monsterType)
	if not spec then
		return nil
	end
	local model = makeModel(monsterType, spec)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = (model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")) :: BasePart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CollisionGroup = MONSTER_GROUP
			part.CanTouch = false
		end
	end
	humanoid.WalkSpeed = spec.MoveSpeed
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.MaxHealth = math.huge -- CombatService keeps a monster's health; the Humanoid only walks
	humanoid.Health = math.huge
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	model:SetAttribute("Rig", monsterType)
	model:SetAttribute("MonsterType", monsterType)
	model:SetAttribute("Activity", "Idle")
	if tag then
		model:SetAttribute("Tag", tag)
	end
	standOn(model, at)
	model.Parent = holder()
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local id = combat:Register(model, { Kind = "Monster", Team = "Monsters", Health = spec.Health, MonsterType = monsterType })
	if not id then
		model:Destroy()
		return nil
	end
	model.Name = `{monsterType}_{id}`
	monsters[id] = {
		Id = id,
		Type = monsterType,
		Tag = tag,
		Spec = spec,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Target = nil,
		TargetAt = 0,
		Points = {},
		Index = 1,
		Best = math.huge,
		Since = os.clock(),
		PlannedFor = nil,
		PlannedAt = 0,
		PlannedVersion = 0,
		AttackReadyAt = os.clock() + 0.6,
		Aggro = {},
		Skip = {},
		LatchedTo = nil,
		Latch = nil,
		Zone = Surface.Zone(at.Position),
		Mode = "Graph",
		Post = if options and options.Guard then at.Position else nil,
		Guard = if options then options.Guard else nil,
		Asleep = options ~= nil and options.Guard ~= nil,
		Pathing = false,
		Path = nil,
		CircleUntil = 0,
		CircleAngle = rng:NextNumber() * math.pi * 2,
		HideUntil = 0,
		GrabDamage = 0,
		HasteUntil = 0,
	}
	MonsterService.Spawned:Fire(id, monsterType, tag)
	return id
end

function MonsterService:Spawn(monsterType: string, at: CFrame, tag: string?, options: Options?): string?
	if not Config.Find("Monsters", monsterType) then
		return nil
	end
	if aliveCount() >= cap() then
		table.insert(queue, { Type = monsterType, At = at, Tag = tag, Options = options })
		return nil
	end
	return spawnNow(monsterType, at, tag, options)
end

-- DeepService (Prompt 17): where a position in a cave comes out into the bunker.
function MonsterService:SetCaveExit(fn: ((Vector3) -> Vector3?)?)
	caveExit = fn
end

local function drainQueue()
	while #queue > 0 and aliveCount() < cap() do
		local next_ = table.remove(queue, 1)
		if next_ then
			spawnNow(next_.Type, next_.At, next_.Tag, next_.Options)
		end
	end
end

function MonsterService:Count(tag: string?): number
	local n = 0
	for _, m in monsters do
		if tag == nil or m.Tag == tag then
			n += 1
		end
	end
	for _, q in queue do
		if tag == nil or q.Tag == tag then
			n += 1
		end
	end
	return n
end

function MonsterService:Queued(): number
	return #queue
end

local function unitOf(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

function MonsterService:All(): { { Id: string, Type: string, Tag: string?, Position: Vector3, Unit: string? } }
	local list = {}
	for id, m in monsters do
		table.insert(list, { Id = id, Type = m.Type, Tag = m.Tag, Position = m.Root.Position, Unit = unitOf(m.Root.Position) })
	end
	return list
end

function MonsterService:InUnit(unit: string): number
	local n = 0
	for _, m in monsters do
		if unitOf(m.Root.Position) == unit then
			n += 1
		end
	end
	return n
end

local function unlatch(m: Monster)
	if m.Grabbing then
		local held = combat:Get(m.Grabbing)
		if held and held.Model then
			held.Model:SetAttribute("Grabbed", nil)
		end
		m.Grabbing = nil
		m.GrabDamage = 0
	end
	if m.Latch then
		m.Latch:Destroy()
		m.Latch = nil
	end
	if m.LatchedTo then
		m.LatchedTo = nil
		m.Humanoid.PlatformStand = false
	end
end

-- Fades one monster away without a kill (surface creatures left behind when everyone goes home,
-- wraiths when the storm passes).
function MonsterService:Despawn(id: string)
	local m = monsters[id]
	if not m then
		return
	end
	unlatch(m)
	monsters[id] = nil
	combat:Unregister(id)
	combat:Dissolve(m.Model)
	task.defer(drainQueue)
end

function MonsterService:ZoneOf(id: string): string?
	local m = monsters[id]
	return if m then m.Zone else nil
end

function MonsterService:Clear()
	table.clear(queue)
	for id, m in monsters do
		unlatch(m)
		combat:Unregister(id)
		m.Model:Destroy()
	end
	table.clear(monsters)
end

-- Targets -------------------------------------------------------------------------------------

local function floorOf(position: Vector3): number
	local floor = Grid.CellAt(position)
	return floor or 0
end

local function score(from: Vector3, to: Vector3): number
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z).Magnitude
	return flat + math.abs(floorOf(from) - floorOf(to)) * FLOOR_PENALTY
end

local function roomPoint(room: any): Vector3
	local column = room.Column + math.floor((room.Span - 1) / 2)
	local cell = Grid.CellPosition(room.Floor, column)
	return Vector3.new(cell.X + (if room.Span % 2 == 0 then Grid.Pitch().X / 2 else 0), cell.Y, cell.Z + 2)
end

local function skipped(m: Monster, id: string): boolean
	local untilAt = m.Skip[id]
	return untilAt ~= nil and untilAt > os.clock()
end

-- In reach of the monster at all: the same realm (the surface, or underground: the bunker and the
-- Deep), and for an awake guard within its leash of its post (Prompt 17).
local function reachable(m: Monster, position: Vector3): boolean
	if Surface.Realm(Surface.Zone(position)) ~= Surface.Realm(m.Zone) then
		return false
	end
	local post, guard = m.Post, m.Guard
	if post and guard and (position - post).Magnitude > guard * LEASH then
		return false
	end
	return true
end

local function residentTarget(m: Monster): Target?
	local best, bestScore = nil, math.huge
	for _, c in combat:All("Survivors") do
		if c.Kind == "Survivor" and c.State == "Alive" and not skipped(m, c.Id) and reachable(m, c.Root.Position) then
			-- a rescued survivor on the way home (Prompt 16) counts as a resident
			local s = score(m.Root.Position, c.Root.Position)
			if s < bestScore then
				best, bestScore = c, s
			end
		elseif c.Kind == "Resident" and c.State == "Alive" and c.ResidentId and not skipped(m, c.Id)
			and reachable(m, c.Root.Position) then
			local record = residents:Get(c.ResidentId)
			if record and record.State == "Alive" then
				local s = score(m.Root.Position, c.Root.Position)
				if s < bestScore then
					best, bestScore = c, s
				end
			end
		end
	end
	return if best then { Kind = "Residents", Id = best.Id, Position = best.Root.Position } else nil
end

local function machineTarget(m: Monster): Target?
	if m.Zone ~= "Bunker" or m.Post then
		return nil -- no machines up in the town or in the caves; guards keep to their post
	end
	local best, bestScore = nil, math.huge
	for _, room in grid:Rooms() do
		if not NO_MACHINE[room.Type] and not room.Wrecked and not skipped(m, room.Id) then
			local s = score(m.Root.Position, roomPoint(room))
			if s < bestScore then
				best, bestScore = room, s
			end
		end
	end
	return if best then { Kind = "Machines", Id = best.Id, RoomId = best.Id, Position = roomPoint(best) } else nil
end

local function playerTarget(m: Monster): Target?
	local t = ai()
	local best, bestScore = nil, math.huge
	local runner = m.Spec.Role == "Runner"
	local aggro = if m.Zone == "Surface" then t.SurfaceAggro
		elseif m.Zone == "Deep" then Config.Get("Tuning", "Deep").DeepAggro
		else t.ProximityAggro
	for _, c in combat:All("Survivors") do
		if c.Kind == "Player" and c.State == "Alive" and c.Player and c.Player:GetAttribute("Life") == "Alive"
			and not skipped(m, c.Id) and reachable(m, c.Root.Position) then
			local hit = (m.Aggro[c.Id] or 0) > os.clock()
			local s = score(m.Root.Position, c.Root.Position)
			local near = not runner and s <= aggro
			if (hit or near) and s < bestScore then
				best, bestScore = c, s
			end
		end
	end
	return if best then { Kind = "Players", Id = best.Id, Position = best.Root.Position } else nil
end

local function chooseTarget(m: Monster)
	-- Hold the Line (Prompt 20): a taunting Security comes before everything while they stand
	local taunt = m.Taunt
	if taunt then
		local c = combat:Get(taunt.Id)
		if os.clock() < taunt.Until and c and c.State == "Alive" and reachable(m, c.Root.Position) then
			m.Target = { Kind = "Players", Id = c.Id, Position = c.Root.Position }
			m.TargetAt = os.clock()
			return
		end
		m.Taunt = nil
	end
	local found: { [string]: Target } = {}
	local available: { [string]: boolean } = {}
	for _, kind in m.Spec.Targets do
		local target = if kind == "Residents" then residentTarget(m)
			elseif kind == "Machines" then machineTarget(m)
			elseif kind == "Players" then playerTarget(m)
			else nil
		if target then
			found[kind] = target
			available[kind] = true
		end
	end
	-- a player who is hitting it, or right in its face, comes before a far resident: anything
	-- in reach now beats walking away from a fight (the residents-first order picks among the rest)
	local player = found.Players
	if player and score(m.Root.Position, player.Position) <= m.Spec.Range + 4 and m.Spec.Role ~= "Runner" then
		m.Target = player
	else
		local kind = Threat.Choose(m.Spec.Targets, available)
		m.Target = if kind then found[kind] else nil
	end
	m.TargetAt = os.clock()
end

-- Hold the Line (Prompt 20): monsters within `radius` of `position` go after the combatant
-- `sourceId` for `seconds` (Runners too), whatever else is near. Returns how many.
function MonsterService:Taunt(sourceId: string, position: Vector3, radius: number, seconds: number): number
	local n = 0
	for _, m in monsters do
		if (m.Root.Position - position).Magnitude <= radius and reachable(m, position) then
			m.Taunt = { Id = sourceId, Until = os.clock() + seconds }
			m.Aggro[sourceId] = os.clock() + seconds
			m.Asleep = false
			m.TargetAt = 0
			n += 1
		end
	end
	return n
end

local function targetPosition(target: Target): Vector3?
	if target.Kind == "Machines" then
		local room = grid:Room(target.RoomId :: string)
		return if room and not room.Wrecked then roomPoint(room) else nil
	end
	local c = combat:Get(target.Id)
	if not c or c.State ~= "Alive" then
		return nil
	end
	if c.Kind == "Resident" then
		local record = residents:Get(c.ResidentId)
		if not record or record.State ~= "Alive" then
			return nil
		end
	elseif c.Kind == "Player" and c.Player and c.Player:GetAttribute("Life") ~= "Alive" then
		return nil
	end
	if Surface.Realm(Surface.Zone(c.Root.Position)) ~= Surface.Realm(Surface.Zone(target.Position)) then
		return nil -- it rode the elevator away (Prompt 16)
	end
	return c.Root.Position
end

-- Moving --------------------------------------------------------------------------------------

local function halt(m: Monster)
	m.Humanoid:MoveTo(m.Root.Position)
end

-- Turns it to look at a point; returns whether it now faces it. A shelled monster (ArmoredFront:
-- the Tide Crab) turns only ShellTurnDegreesPerSecond while it stands and fights, so someone
-- quick, or anyone it isn't looking at, can get round to its back; it strikes only at what is
-- within ShellFaceDegrees of its front.
local function face(m: Monster, at: Vector3): boolean
	local here = m.Root.Position
	local flat = Vector3.new(at.X, here.Y, at.Z)
	if (flat - here).Magnitude <= 0.2 then
		return true
	end
	if m.Spec.Traits == nil or table.find(m.Spec.Traits, "ArmoredFront") == nil then
		m.Root.CFrame = CFrame.lookAt(here, flat)
		return true
	end
	local t = ai()
	local look = m.Root.CFrame.LookVector
	local have = math.atan2(-look.X, -look.Z)
	local want = math.atan2(-(flat.X - here.X), -(flat.Z - here.Z))
	local delta = (want - have + math.pi) % (math.pi * 2) - math.pi
	local step = math.rad(t.ShellTurnDegreesPerSecond) * t.TickSeconds
	local turn = math.clamp(delta, -step, step)
	m.Root.CFrame = CFrame.new(here) * CFrame.Angles(0, have + turn, 0)
	return math.abs(delta - turn) <= math.rad(t.ShellFaceDegrees)
end

local function plan(m: Monster, goal: Vector3)
	local from = unitOf(m.Root.Position)
	local to = unitOf(goal + Vector3.new(0, 1, 0))
	m.Points = {}
	m.Index = 1
	m.Best = math.huge
	m.Since = os.clock()
	m.PlannedFor = to
	m.PlannedAt = os.clock()
	m.PlannedVersion = Hazards.Version()
	if from and to and from ~= to then
		local points, why = PathGraph.Waypoints(grid:Bunker(), function(unit: string): Model?
			return grid:RoomModel(unit)
		end, m.Root.Position, from, to, goal)
		if points then
			m.Points = points
			return
		end
		if why == "Blocked" then
			-- cave-in rubble stands between it and its target (Prompt 13): it looks for another
			-- one for a while instead of walking through the rubble
			if m.Target then
				m.Skip[m.Target.Id] = os.clock() + BLOCKED_SKIP_SECONDS
			end
			m.Target = nil
			m.Points = { m.Root.Position }
			return
		end
	end
	m.Points = { goal }
end

-- The surface (Prompt 16): PathfindingService plans off the AI's thread; until a plan arrives the
-- monster heads straight for its goal.
local function surfacePlan(m: Monster, goal: Vector3)
	if m.Pathing then
		return
	end
	m.Pathing = true
	m.PlannedAt = os.clock()
	task.spawn(function()
		local path = m.Path or PathfindingService:CreatePath({
			AgentRadius = 2.5, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 8,
		})
		m.Path = path
		local ok = pcall(function()
			(path :: Path):ComputeAsync(m.Root.Position, goal)
		end)
		m.Pathing = false
		if monsters[m.Id] ~= m then
			return
		end
		local points: { Vector3 } = {}
		if ok and (path :: Path).Status == Enum.PathStatus.Success then
			for _, waypoint in (path :: Path):GetWaypoints() do
				table.insert(points, waypoint.Position)
			end
			table.remove(points, 1) -- where it stands
		end
		if #points == 0 then
			points = { goal }
		end
		m.Points = points
		m.Index = 1
		m.Best = math.huge
		m.Since = os.clock()
	end)
end

local function walkSurface(m: Monster, goal: Vector3)
	local root = m.Root
	local flatGoal = Vector3.new(goal.X - root.Position.X, 0, goal.Z - root.Position.Z).Magnitude
	if os.clock() - m.PlannedAt > ai().PathSeconds or #m.Points == 0 then
		surfacePlan(m, goal)
	end
	local point = m.Points[m.Index]
	if flatGoal < 14 or not point then
		point = goal -- close: straight at it
	end
	local distance = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z).Magnitude
	if distance <= ARRIVE + 1 and m.Index < #m.Points then
		m.Index += 1
		m.Best = math.huge
		m.Since = os.clock()
		point = m.Points[m.Index]
	elseif distance < m.Best - 0.5 then
		m.Best = distance
		m.Since = os.clock()
	elseif os.clock() - m.Since > ai().StuckSeconds then
		-- stuck on wreckage: hop, and plan again
		m.Humanoid.Jump = true
		m.Best = math.huge
		m.Since = os.clock()
		m.PlannedAt = 0
	end
	m.Humanoid:MoveTo(point)
	setActivity(m, "Walk")
end

-- Switching between the room graph and PathfindingService starts the plan afresh.
local function setMode(m: Monster, mode: string)
	if m.Mode ~= mode then
		m.Mode = mode
		m.Points = {}
		m.Index = 1
		m.Best = math.huge
		m.Since = os.clock()
		m.PlannedAt = 0
		m.PlannedFor = nil
	end
end

local function walk(m: Monster, goal: Vector3)
	if m.Zone == "Surface" then
		setMode(m, "Path")
		walkSurface(m, goal)
		return
	end
	local goalZone = Surface.Zone(goal)
	local exit = caveExit
	if m.Zone == "Deep" then
		-- in a cave (Prompt 17): PathfindingService; a goal in the bunker through the cave's mouth
		local mouth = if goalZone ~= "Deep" and exit then exit(m.Root.Position) else nil
		setMode(m, "Path")
		walkSurface(m, mouth or goal)
		return
	end
	if goalZone == "Deep" and exit then
		-- in the bunker, after something in a cave: to the cave's mouth, then in
		local mouth = exit(goal)
		if mouth then
			if Vector3.new(mouth.X - m.Root.Position.X, 0, mouth.Z - m.Root.Position.Z).Magnitude < 6 then
				setMode(m, "Path")
				walkSurface(m, goal)
				return
			end
			goal = mouth
		end
	end
	setMode(m, "Graph")
	local goalUnit = unitOf(goal + Vector3.new(0, 1, 0))
	local feet = m.Root.Position.Y - m.Humanoid.HipHeight - m.Root.Size.Y / 2
	local heading = m.Points[m.Index]
	-- its next waypoint is on another floor: it is on a Shaft's stairs, and a fresh plan (which
	-- starts from the aisle of whatever floor it is level with) would walk it off them
	local climbing = heading ~= nil and math.abs(heading.Y - feet) > 3
	if m.PlannedFor ~= goalUnit or #m.Points == 0 or m.PlannedVersion ~= Hazards.Version()
		or (os.clock() - m.PlannedAt > REPLAN_SECONDS and not climbing) then
		local chasing = m.Target ~= nil -- a guard walking back to its post has none
		plan(m, goal)
		if chasing and not m.Target then
			-- rubble cut the target off (plan): wait here and choose again next tick
			halt(m)
			setActivity(m, "Idle")
			return
		end
		-- A plan starts from the aisle. Planned again part-way to its next point (the foot of the
		-- stairs, a doorway), it carries on from where it is instead of walking back to the aisle:
		-- it skips each waypoint whose successor, on its own floor, is no farther away. (Found in
		-- Prompt 23's playtest: a whole Surge stood at the foot of the Shaft's stairs, sent back to
		-- the aisle every REPLAN_SECONDS, and never climbed.)
		local at = m.Root.Position
		while m.Index < #m.Points do
			local here, after = m.Points[m.Index], m.Points[m.Index + 1]
			if math.abs(after.Y - feet) > 3 then
				break
			end
			local near = Vector3.new(here.X - at.X, 0, here.Z - at.Z).Magnitude
			local nearAfter = Vector3.new(after.X - at.X, 0, after.Z - at.Z).Magnitude
			if nearAfter > near then
				break
			end
			m.Index += 1
		end
	end
	-- the last point follows a moving target
	if #m.Points > 0 then
		m.Points[#m.Points] = goal
	end
	local point = m.Points[m.Index]
	if not point then
		m.Humanoid:MoveTo(goal)
		return
	end
	local root = m.Root
	local distance = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z).Magnitude
	if distance <= ARRIVE and m.Index < #m.Points then
		m.Index += 1
		m.Best = math.huge
		m.Since = os.clock()
		point = m.Points[m.Index]
	elseif distance < m.Best - 0.5 then
		m.Best = distance
		m.Since = os.clock()
	elseif os.clock() - m.Since > ai().StuckSeconds then
		-- stuck on a corner or the stairs: step to the waypoint (as residents do)
		root.CFrame = CFrame.new(point + Vector3.new(0, m.Humanoid.HipHeight + root.Size.Y / 2, 0)) * root.CFrame.Rotation
		m.Best = math.huge
		m.Since = os.clock()
	end
	m.Humanoid:MoveTo(point)
	setActivity(m, "Walk")
end

-- Attacks -------------------------------------------------------------------------------------

local function inReach(m: Monster, target: Target, at: Vector3): boolean
	local c = combat:Get(m.Id)
	local reach = if c then c.Reach else 2
	local flat = Vector3.new(at.X - m.Root.Position.X, 0, at.Z - m.Root.Position.Z).Magnitude
	local sameFloor = math.abs(floorOf(at) - floorOf(m.Root.Position)) == 0
	if m.Zone == "Deep" or Surface.Zone(at) == "Deep" then
		sameFloor = math.abs(at.Y - m.Root.Position.Y) < 7 -- caves are off the grid: a drop's ledge is another floor
	end
	local extra = if target.Kind == "Machines" then 4 else 1
	return sameFloor and flat - reach <= m.Spec.Range + extra
end

local function hurtRoom(m: Monster, roomId: string, amount: number)
	local room = grid:Room(roomId)
	if not room or room.Wrecked then
		return
	end
	local smash = if m.Spec.Traits and table.find(m.Spec.Traits, "SmashesMachines") then ai().SmashMultiplier else 1
	local hp = grid:SetHP(roomId, math.max(room.HP - amount * smash * ai().RoomDamageMultiplier, 0))
	if hp and hp <= 0 then
		-- a Reactor Core at 0 HP melts down (DisasterService listens to BunkerGrid.Wrecked;
		-- Landon, 2026-11-08: the 60-second meltdown instead of losing at once)
		log:Info("%s wrecked %s (%s)", m.Id, roomId, room.Type)
	end
end

local function slow(c: any, seconds: number)
	if c.Kind == "Player" and c.Player then
		c.Player:SetAttribute("SlowedUntil", now() + seconds)
	elseif c.Kind == "Resident" then
		c.Model:SetAttribute("SlowedUntil", now() + seconds)
	end
end

local function spit(m: Monster, target: Target)
	local t = ai()
	local goo = Instance.new("Part")
	goo.Name = "Goo"
	goo.Shape = Enum.PartType.Ball
	goo.Size = Vector3.new(0.9, 0.9, 0.9)
	goo.Material = Enum.Material.Neon
	goo.Color = Color3.fromRGB(124, 255, 155)
	goo.Anchored = true
	goo.CanCollide = false
	goo.CanQuery = false
	goo.CanTouch = false
	local from = m.Root.Position + Vector3.new(0, 1, 0) + m.Root.CFrame.LookVector * 1.5
	goo.Position = from
	goo.Parent = holder()
	local aim = (target.Position + Vector3.new(0, 0.5, 0)) - from
	local velocity = aim.Unit * t.GooSpeed + Vector3.new(0, aim.Magnitude * 0.12, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { holder() }
	local position = from
	local flown = 0
	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function(dt)
		local step = velocity * dt
		local hit = workspace:Raycast(position, step, params)
		velocity -= Vector3.new(0, 24 * dt, 0)
		flown += dt
		if hit or flown > 3 then
			if connection then
				connection:Disconnect()
			end
			goo:Destroy()
			local at = if hit then hit.Position else position
			for _, c in combat:All("Survivors") do
				if (c.Root.Position - at).Magnitude <= 3 + c.Reach then
					combat:Damage(c.Id, m.Spec.Damage, m.Id, "goo")
					slow(c, t.GooSlowSeconds)
				end
			end
			return
		end
		position += step
		goo.Position = position
	end)
end

-- An Ash Raider's rifle (Prompt 16): line of sight from its chest to the target when the shot
-- lands, then ShotAccuracy of the time a hit. A tracer shows every shot.
local function shoot(m: Monster, target: Target, at: Vector3)
	local from = m.Root.Position + Vector3.new(0, 1.5, 0) + m.Root.CFrame.LookVector * 1.5
	local to = at + Vector3.new(0, 1, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore: { Instance } = { holder(), m.Model }
	local c = combat:Get(target.Id)
	if c then
		table.insert(ignore, c.Model)
	end
	params.FilterDescendantsInstances = ignore
	local blocked = workspace:Raycast(from, to - from, params)
	local hit = not blocked and rng:NextNumber() < ai().ShotAccuracy
	local finish = if blocked then blocked.Position
		elseif hit then to
		else to + Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-1, 2), rng:NextNumber(-3, 3))
	local tracer = Instance.new("Part")
	tracer.Name = "Tracer"
	tracer.Anchored = true
	tracer.CanCollide = false
	tracer.CanQuery = false
	tracer.CanTouch = false
	tracer.Material = Enum.Material.Neon
	tracer.Color = Color3.fromRGB(255, 196, 120)
	local length = (finish - from).Magnitude
	tracer.Size = Vector3.new(0.12, 0.12, math.max(length, 0.1))
	tracer.CFrame = CFrame.lookAt(from, finish) * CFrame.new(0, 0, -length / 2)
	tracer.Parent = holder()
	task.delay(0.07, function()
		tracer:Destroy()
	end)
	if hit and c then
		combat:Damage(c.Id, m.Spec.Damage, m.Id, "shot")
	end
end

local function latch(m: Monster, c: any)
	if m.Latch or not c.Root then
		return
	end
	m.LatchedTo = c.ResidentId
	m.Humanoid.PlatformStand = true
	m.Root.CFrame = c.Root.CFrame * CFrame.new(0, 0.6, 0.9)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = c.Root
	weld.Part1 = m.Root
	weld.Parent = m.Root
	m.Latch = weld
	setActivity(m, "Latched")
end

-- The Flooded Caverns' monsters (Prompt 23) ----------------------------------------------------------

local function has(m: Monster, trait: string): boolean
	return m.Spec.Traits ~= nil and table.find(m.Spec.Traits, trait) ~= nil
end

local function setHidden(m: Monster, hidden: boolean)
	if m.Hidden ~= hidden then
		m.Hidden = hidden
		m.Model:SetAttribute("Hidden", if hidden then true else nil)
	end
end

local burst: (m: Monster) -> ()
local swell: (m: Monster) -> ()
local grab: (m: Monster, c: any) -> ()

local function attack(m: Monster, target: Target)
	if os.clock() < m.AttackReadyAt then
		return
	end
	local spec = m.Spec
	m.AttackReadyAt = os.clock() + spec.AttackSeconds
	local hitTime = m.Model:GetAttribute("HitTime")
	local windup = if type(hitTime) == "number" then hitTime else spec.AttackSeconds * ai().WindupFraction
	m.Model:SetAttribute("AttackAt", os.clock()) -- NPCAnimator replays the attack clip
	setActivity(m, "Attack")
	if has(m, "Invisible") then
		m.ShownUntil = os.clock() + windup + ai().StalkerRevealSeconds -- it shows itself as it strikes
		setHidden(m, false)
	end
	task.delay(windup, function()
		if not monsters[m.Id] then
			return
		end
		local at = targetPosition(target)
		if not at then
			return
		end
		if spec.Traits and table.find(spec.Traits, "Slows") then
			target.Position = at
			spit(m, target)
			return
		end
		if spec.Traits and table.find(spec.Traits, "Shoots") then
			if (at - m.Root.Position).Magnitude <= spec.Range + 4 then
				shoot(m, target, at)
			end
			return
		end
		if not inReach(m, target, at) then
			return -- the hit is checked again when it lands
		end
		if target.Kind == "Machines" then
			hurtRoom(m, target.RoomId :: string, spec.Damage)
			return
		end
		local c = combat:Get(target.Id)
		if not c then
			return
		end
		combat:Damage(c.Id, spec.Damage, m.Id, "attacked")
		if spec.Role == "PackRunner" then
			-- circle and dart in (Section 10's Ash Jackals): back off and circle before the next bite
			local range = ai().CircleSeconds
			m.CircleUntil = os.clock() + rng:NextNumber(range.Min, range.Max)
		end
		if c.Kind == "Resident" and spec.Traits and table.find(spec.Traits, "Latches") then
			latch(m, c)
		end
		if c.Kind == "Resident" and has(m, "Grabs") and c.State == "Alive" then
			grab(m, c)
		end
	end)
end

-- A Bloat Toad bursts (the Appendix: "Bursts on death or contact and floods the room"): everyone
-- within BurstRadius is hurt, the room's machines too, and the room floods (the Burst signal:
-- ThreatDirector passes it to DisasterService). It dies of it, if it isn't dead already.
function burst(m: Monster)
	if m.Bursting == true and m.Model:GetAttribute("Burst") then
		return
	end
	m.Bursting = true
	m.Model:SetAttribute("Burst", true)
	local t = ai()
	local at = m.Root.Position
	local unit = unitOf(at)
	for _, c in combat:All("Survivors") do
		if c.State == "Alive" and c.Root.Parent and (c.Root.Position - at).Magnitude <= t.BurstRadius then
			combat:Damage(c.Id, m.Spec.Damage, m.Id, "burst")
		end
	end
	if unit and grid:Room(unit) then
		hurtRoom(m, unit, m.Spec.Damage)
	end
	log:Info("%s burst in %s", m.Id, unit or "the open")
	MonsterService.Burst:Fire(m.Id, m.Type, at, unit)
	if monsters[m.Id] then
		combat:Damage(m.Id, 1e9, nil, "burst")
	end
end

-- It has reached what it came for: it swells for BurstSwellSeconds (the clip), then bursts.
function swell(m: Monster)
	if m.Bursting then
		return
	end
	m.Bursting = true
	halt(m)
	m.Model:SetAttribute("AttackAt", os.clock())
	setActivity(m, "Attack")
	task.delay(ai().BurstSwellSeconds, function()
		if monsters[m.Id] then
			m.Bursting = false
			burst(m)
		end
	end)
end

-- Where a Lurker lies in wait (the Appendix: "Hides in water or dark rooms"): the nearest room it
-- can walk to that is deep enough in water, or dark.
local function hidingRoom(m: Monster): string?
	local wade = Config.Get("Tuning", "Disasters").Flood.WadeLevel
	local best, bestScore = nil, math.huge
	for _, room in grid:Rooms() do
		if room.Type ~= "Shaft" and ((Hazards.Flood(room.Id) or 0) >= wade or (power and power:IsDark(room.Id))) then
			local d = score(m.Root.Position, roomPoint(room))
			if d < bestScore then
				best, bestScore = room.Id, d
			end
		end
	end
	return best
end

-- A Lurker's ambush. Returns true while it is busy with it (walking to its room, lying in wait,
-- striking from it); false once it hunts like any other monster.
local function ambush(m: Monster): boolean
	if m.Hunting or m.Zone ~= "Bunker" then
		setHidden(m, false)
		return false
	end
	local t = ai()
	local room = if m.HideRoom then grid:Room(m.HideRoom) else nil
	local wade = Config.Get("Tuning", "Disasters").Flood.WadeLevel
	if not room or not ((Hazards.Flood(room.Id) or 0) >= wade or (power and power:IsDark(room.Id))) then
		m.HideRoom = hidingRoom(m)
		room = if m.HideRoom then grid:Room(m.HideRoom) else nil
		if not room then
			m.Hunting = true -- nowhere wet or dark: it hunts in the open
			setHidden(m, false)
			return false
		end
		m.HideUntil = os.clock() + t.HideSeconds
	end
	if unitOf(m.Root.Position) ~= room.Id then
		setHidden(m, false)
		walk(m, roomPoint(room))
		return true
	end
	-- in its room: whoever comes within reach is struck
	local victim: Target? = nil
	local nearest = math.huge
	for _, c in combat:All("Survivors") do
		if c.State == "Alive" and c.Root.Parent and unitOf(c.Root.Position) == room.Id then
			local d = (c.Root.Position - m.Root.Position).Magnitude
			local kind = if c.Kind == "Player" then "Players" else "Residents"
			-- residents first (it "grabs residents"); a player only when no resident is nearer than it
			local weighted = if kind == "Residents" then d else d + 6
			if d <= m.Spec.Range + t.AmbushReach and weighted < nearest then
				nearest = weighted
				victim = { Kind = kind, Id = c.Id, Position = c.Root.Position }
			end
		end
	end
	if victim then
		setHidden(m, false)
		m.Target = victim
		m.TargetAt = os.clock()
		m.HideUntil = os.clock() + t.HideSeconds
		if inReach(m, victim, victim.Position) then
			halt(m)
			face(m, victim.Position)
			attack(m, victim)
		else
			m.Humanoid:MoveTo(victim.Position)
			setActivity(m, "Walk")
		end
		return true
	end
	if os.clock() > m.HideUntil then
		m.Hunting = true -- nobody came: it goes looking (a Surge can't wait on it for ever)
		setHidden(m, false)
		return false
	end
	halt(m)
	setHidden(m, os.clock() >= m.AttackReadyAt)
	setActivity(m, "Idle")
	return true
end

-- A Lurker takes hold of a resident: they can't move (ResidentBrain reads Grabbed) and it bites
-- until it is hit for GrabBreakDamage, stunned or killed.
function grab(m: Monster, c: any)
	if m.Grabbing or not c.Model then
		return
	end
	m.Grabbing = c.Id
	m.GrabDamage = 0
	c.Model:SetAttribute("Grabbed", true)
	setActivity(m, "Latched")
end

-- A Tide Crab's shell (the Appendix: "Armoured front, weak point on its back"): what hits it from
-- in front does ArmorFront of its damage, what hits it from behind WeakBack times it.
local function shell(target: any, amount: number, source: any?, _how: string?): number
	local m = monsters[target.Id]
	if not m or not source or not source.Root or amount <= 0 or not (has(m, "ArmoredFront") or has(m, "WeakPointBack")) then
		return amount
	end
	local to = source.Root.Position - m.Root.Position
	local flat = Vector3.new(to.X, 0, to.Z)
	if flat.Magnitude < 0.5 then
		return amount
	end
	local look = m.Root.CFrame.LookVector
	local dot = flat.Unit:Dot(Vector3.new(look.X, 0, look.Z).Unit)
	local multiplier, what = Threat.Shell(dot, has(m, "ArmoredFront"), has(m, "WeakPointBack"))
	if what == "Shell" then
		m.Model:SetAttribute("ShellHitAt", now()) -- the client's sparks
	elseif what == "Weak" then
		m.Model:SetAttribute("WeakHitAt", now())
	end
	return amount * multiplier
end

-- The Crystal Hollows' monsters (Prompt 24) -------------------------------------------------------------

-- What flares and lamps light now (parts tagged RevealLight with a Radius: WeaponService's flares,
-- DeepService's lanterns), gathered once a tick.
local lightsAt = -1
local lightList: { { Position: Vector3, Radius: number } } = {}
local function lights(): { { Position: Vector3, Radius: number } }
	if lightsAt == os.clock() then
		return lightList
	end
	lightsAt = os.clock()
	lightList = {}
	for _, instance in CollectionService:GetTagged("RevealLight") do
		local radius = instance:GetAttribute("Radius")
		if instance:IsA("BasePart") and instance:IsDescendantOf(workspace) and type(radius) == "number" then
			table.insert(lightList, { Position = instance.Position, Radius = radius })
		end
	end
	return lightList
end

function MonsterService:Lit(position: Vector3): boolean
	return Threat.Lit(position, lights())
end

-- A dead Shardling shatters ("Crystal bugs that shatter into stinging shards"): its shards sting
-- everyone near.
local function shatter(m: Monster)
	local at = m.Root.Position
	m.Model:SetAttribute("Shattered", true) -- the client's burst of shards
	local stung = 0
	for _, c in combat:All("Survivors") do
		if c.State == "Alive" and c.Root.Parent then
			local damage = Threat.ShatterDamage((c.Root.Position - at).Magnitude - c.Reach)
			if damage > 0 and combat:Damage(c.Id, damage, nil, "shards") > 0 then
				stung += 1
			end
		end
	end
	if stung > 0 then
		log:Debug("%s shattered: its shards stung %d", m.Id, stung)
	end
end

-- A Geode Golem "shrugs off small guns" (WeaponService's hit modifier knows the gun).
local function smallGuns(target: any, _point: Vector3?, _how: string, _player: Player, item: string?): number
	local m = monsters[target.Id]
	if not m or not has(m, "ShrugsSmallGuns") then
		return 1
	end
	local multiplier = Threat.SmallGunMultiplier(item)
	if multiplier < 1 then
		m.Model:SetAttribute("ShruggedAt", now()) -- the client's ricochet
	end
	return multiplier
end

-- A Resonator ("Hums to heal and speed up nearby monsters; kill it first"). It follows the pack
-- and never strikes: every AttackSeconds its hum heals and quickens the monsters within its Range.
local function resonate(m: Monster)
	local t = ai()
	local here = m.Root.Position
	local ally: Monster? = nil
	local nearest = math.huge
	local inRange: { Monster } = {}
	for _, other in monsters do
		if other ~= m and other.Model.Parent and other.Zone == m.Zone then
			local d = (other.Root.Position - here).Magnitude
			if d <= m.Spec.Range and math.abs(other.Root.Position.Y - here.Y) < 9 then
				table.insert(inRange, other)
			end
			if not has(other, "Heals") then
				local s = score(here, other.Root.Position)
				if s < nearest then
					nearest, ally = s, other
				end
			end
		end
	end
	if os.clock() >= m.AttackReadyAt and #inRange > 0 then
		m.AttackReadyAt = os.clock() + m.Spec.AttackSeconds
		m.Model:SetAttribute("AttackAt", os.clock())
		m.Model:SetAttribute("HumAt", now()) -- the client's ring
		setActivity(m, "Attack")
		local healed = 0
		for _, other in inRange do
			local health, max = combat:HealthOf(other.Id)
			local amount = Threat.HumHeal(health, max)
			if amount > 0 and combat:Heal(other.Id, amount) > 0 then
				healed += 1
			end
			other.HasteUntil = os.clock() + t.HasteSeconds
			other.Model:SetAttribute("HummedAt", now())
		end
		log:Debug("%s hummed: %d near, %d healed", m.Id, #inRange, healed)
		halt(m)
		return
	end
	if ally then
		local flat = Vector3.new(ally.Root.Position.X - here.X, 0, ally.Root.Position.Z - here.Z).Magnitude
		if flat > t.HumFollow or math.abs(ally.Root.Position.Y - here.Y) > 6 then
			walk(m, ally.Root.Position)
			return
		end
		halt(m)
		setActivity(m, "Idle")
		return
	end
	-- alone: it trails whoever its kind would hunt, at arm's length
	if not m.Target or os.clock() - m.TargetAt > 1 then
		chooseTarget(m)
	end
	local target = m.Target
	local at = if target then targetPosition(target) else nil
	if target and at and Vector3.new(at.X - here.X, 0, at.Z - here.Z).Magnitude > m.Spec.Range * t.KeepDistanceFraction then
		walk(m, at)
		return
	end
	halt(m)
	setActivity(m, "Idle")
end

-- The tick -----------------------------------------------------------------------------------------

local function step(m: Monster)
	m.Zone = Surface.Zone(m.Root.Position)
	-- a Resonator's hum quickens it (Prompt 24)
	local speed = m.Spec.MoveSpeed * (if os.clock() < m.HasteUntil then ai().HasteMultiplier else 1)
	if math.abs(m.Humanoid.WalkSpeed - speed) > 0.01 then
		m.Humanoid.WalkSpeed = speed
		m.Model:SetAttribute("Hasted", if speed > m.Spec.MoveSpeed then true else nil)
	end
	local stunned = m.Model:GetAttribute("StunnedUntil")
	if type(stunned) == "number" and stunned > now() then
		unlatch(m)
		halt(m)
		setActivity(m, "Stunned")
		return
	end
	if m.LatchedTo then
		local c = combat:Get(m.LatchedTo)
		local record = residents:Get(m.LatchedTo)
		if not c or c.State ~= "Alive" or not record or record.State ~= "Alive" then
			unlatch(m)
		else
			if os.clock() >= m.AttackReadyAt then
				local t = ai()
				m.AttackReadyAt = os.clock() + m.Spec.AttackSeconds * t.LatchIntervalMultiplier
				m.Model:SetAttribute("AttackAt", os.clock())
				combat:Damage(c.Id, m.Spec.Damage * t.LatchDamageMultiplier, m.Id, "bitten")
			end
			return
		end
	end
	if m.Grabbing then
		-- a Lurker holding a resident (Prompt 23)
		local c = combat:Get(m.Grabbing)
		if not c or c.State ~= "Alive" or m.GrabDamage >= ai().GrabBreakDamage then
			local broken = m.GrabDamage >= ai().GrabBreakDamage
			unlatch(m)
			if broken then
				m.Model:SetAttribute("StunnedUntil", now() + ai().GrabBreakStun)
				return
			end
		else
			halt(m)
			face(m, c.Root.Position)
			if os.clock() >= m.AttackReadyAt then
				m.AttackReadyAt = os.clock() + m.Spec.AttackSeconds
				m.Model:SetAttribute("AttackAt", os.clock())
				combat:Damage(c.Id, m.Spec.Damage * ai().GrabDamageMultiplier, m.Id, "grabbed")
			end
			return
		end
	end
	if m.Bursting then
		return -- a Bloat Toad swelling
	end
	if has(m, "Hides") and ambush(m) then
		return
	end
	if has(m, "Invisible") then
		-- a Prism Stalker: "Invisible until lit by a flare or lamp"
		setHidden(m, not Threat.StalkerSeen(Threat.Lit(m.Root.Position, lights()), os.clock(), m.ShownUntil))
	end
	if has(m, "Heals") then
		resonate(m)
		return
	end
	local post = m.Post
	if post and m.Asleep then
		-- a guard asleep at its post (Prompt 17): a player close by, or a hit, wakes it
		local woken = false
		for _, untilAt in m.Aggro do
			if untilAt > os.clock() then
				woken = true
			end
		end
		if not woken then
			for _, c in combat:All("Survivors") do
				if c.Kind == "Player" and c.State == "Alive" and c.Player and c.Player:GetAttribute("Life") == "Alive"
					and (c.Root.Position - m.Root.Position).Magnitude <= (m.Guard or 0) and reachable(m, c.Root.Position) then
					woken = true
					break
				end
			end
		end
		if not woken then
			halt(m)
			setActivity(m, "Idle")
			return
		end
		m.Asleep = false
		m.TargetAt = 0
	end
	if not m.Target or os.clock() - m.TargetAt > 1 then
		chooseTarget(m)
	end
	local target = m.Target
	local at = if target then targetPosition(target) else nil
	if target and at and not reachable(m, at) then
		target, at = nil, nil -- off its leash
	end
	if not target or not at then
		m.Target = nil
		if post then
			-- nothing near its post: back to it, and asleep there
			if Vector3.new(post.X - m.Root.Position.X, 0, post.Z - m.Root.Position.Z).Magnitude > 4 then
				walk(m, post)
				return
			end
			m.Asleep = true
		end
		halt(m)
		setActivity(m, "Idle")
		return
	end
	target.Position = at
	if m.Spec.Role == "PackRunner" and os.clock() < m.CircleUntil then
		-- circling its prey between bites
		m.CircleAngle += ai().TickSeconds * 1.6
		local r = ai().CircleRadius
		local spot = at + Vector3.new(math.cos(m.CircleAngle) * r, 0, math.sin(m.CircleAngle) * r)
		m.Humanoid:MoveTo(spot)
		setActivity(m, "Walk")
		return
	end
	local ranged = m.Spec.Role == "Ranged" or (m.Spec.Traits ~= nil and table.find(m.Spec.Traits, "Shoots") ~= nil)
	if inReach(m, target, at) then
		local flat = Vector3.new(at.X - m.Root.Position.X, 0, at.Z - m.Root.Position.Z).Magnitude
		if ranged and flat > m.Spec.Range * ai().KeepDistanceFraction then
			-- spitters keep their distance but close in a little while they spit
			m.Humanoid:MoveTo(m.Root.Position + (at - m.Root.Position).Unit * 2)
		else
			halt(m)
		end
		local facing = face(m, at)
		if has(m, "Explodes") then
			swell(m) -- contact: a Bloat Toad bursts
		elseif facing then
			attack(m, target)
		else
			setActivity(m, "Walk") -- a Tide Crab still turning to bring its claws round
		end
		return
	end
	walk(m, at)
end

local function loop()
	while true do
		task.wait(ai().TickSeconds)
		for id, m in monsters do
			if not m.Model.Parent then
				monsters[id] = nil
			else
				local ok, err = pcall(step, m)
				if not ok then
					log:Warn("%s: %s", id, tostring(err))
				end
			end
		end
	end
end

-- Lifecycle ----------------------------------------------------------------------------------------

local function nearPlayer(player: Player?): CFrame?
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	look = if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)
	local spot = root.Position + look * 14
	return CFrame.lookAt(spot, Vector3.new(root.Position.X, spot.Y, root.Position.Z))
end

function MonsterService:Init(registry)
	combat = registry.CombatService
	grid = registry.BunkerGrid
	residents = registry.ResidentService
	director = registry.RunDirector
	power = registry.PowerService
	weapons = registry.WeaponService
	dev = registry.DevService

	pcall(function()
		PhysicsService:RegisterCollisionGroup(MONSTER_GROUP)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(MONSTER_GROUP, MONSTER_GROUP, false)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Residents")
		PhysicsService:CollisionGroupSetCollidable(MONSTER_GROUP, "Residents", false)
	end)

	dev:Register("monster", {
		Description = "Spawn monsters in front of you (Prompt 12).",
		Usage = "monster <Type> [count]",
		Run = function(player, args): string?
			local monsterType = tostring(args[1] or "")
			if not Config.Find("Monsters", monsterType) then
				return `no monster {monsterType}`
			end
			player = player or Players:GetPlayers()[1]
			local at = nearPlayer(player)
			if not at then
				return "no player to spawn by"
			end
			local count = math.clamp(math.floor(tonumber(args[2]) or 1), 1, 30)
			local made = {}
			for i = 1, count do
				local offset = CFrame.new((i - 1) % 4 * 2.5 - 3.75, 0, -math.floor((i - 1) / 4) * 3)
				table.insert(made, MonsterService:Spawn(monsterType, at * offset, "Dev") or "queued")
			end
			return `{monsterType}: {table.concat(made, ", ")}`
		end,
	})
	dev:Register("monster.hit", {
		Description = "Hit a monster of a type as if from in front of it, beside it or behind it: it is turned, then hit (a Tide Crab's shell and back).",
		Usage = "monster.hit <Type> <amount> [front|back|side]",
		Run = function(player, args): string?
			local monsterType = tostring(args[1] or "")
			local amount = tonumber(args[2]) or 100
			local from = tostring(args[3] or "front")
			player = player or Players:GetPlayers()[1]
			local me = player and combat:PlayerCombatant(player)
			local target: Monster? = nil
			for _, m in monsters do
				if m.Type == monsterType then
					target = m
					break
				end
			end
			if not me or not target then
				return `no {monsterType} to hit (or no player)`
			end
			-- nobody is moved (a teleport by a wall drops them out of the bunker): the monster is turned
			-- so that the player stands in front of it, beside it or behind it, and is hit at once
			local here = target.Root.Position
			local to = Vector3.new(me.Root.Position.X, here.Y, me.Root.Position.Z)
			if (to - here).Magnitude > 0.5 then
				local turn = if from == "back" then math.pi elseif from == "side" then math.pi / 2 else 0
				target.Root.CFrame = CFrame.lookAt(here, to) * CFrame.Angles(0, turn, 0)
			end
			local before = combat:HealthOf(target.Id)
			local dealt = combat:Damage(target.Id, amount, me.Id, "dev")
			return `{target.Id} {monsterType} hit for {amount} from its {from}: {dealt} dealt ({math.ceil(before)} -> {math.ceil((combat:HealthOf(target.Id)))} hp)`
		end,
	})
	dev:Register("monsters", {
		Description = "The monsters on the map, the queue and what each is after.",
		Usage = "monsters",
		Run = function(): string?
			local lines = { `{aliveCount()} on the map (cap {cap()}), {#queue} queued` }
			for id, m in monsters do
				local health = combat:HealthOf(id)
				local target = if m.Target then `{m.Target.Kind} {m.Target.Id}` else "nothing"
				table.insert(lines, `  {id} {m.Type} {math.ceil(health)}hp in {unitOf(m.Root.Position) or "?"}, after {target}, {m.Model:GetAttribute("Activity")}{if m.LatchedTo then ` (latched to {m.LatchedTo})` else ""}{if m.Hidden then " (hidden)" else ""}{if m.Grabbing then ` (holding {m.Grabbing})` else ""}{if m.HideRoom then ` (lair {m.HideRoom})` else ""}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("monsters.clear", {
		Description = "Remove every monster and the queue.",
		Usage = "monsters.clear",
		Run = function(): string?
			local n = aliveCount() + #queue
			MonsterService:Clear()
			return `{n} removed`
		end,
	})
end

function MonsterService:Start()
	holder()
	combat:AddDamageFilter("Shell", shell)
	weapons:AddHitModifier("SmallGuns", smallGuns)
	combat.Died:Connect(function(id: string)
		local m = monsters[id]
		if not m then
			return
		end
		unlatch(m)
		monsters[id] = nil
		if has(m, "Explodes") and not m.Model:GetAttribute("Burst") and m.Root.Parent then
			burst(m) -- "Bursts on death or contact" (Prompt 23)
		end
		if has(m, "Shatters") and m.Root.Parent then
			shatter(m) -- Prompt 24
		end
		MonsterService.Died:Fire(id, m.Type, m.Tag)
		task.defer(drainQueue)
	end)
	combat.Damaged:Connect(function(targetId: string, _amount: number, sourceId: string?)
		local m = monsters[targetId]
		if m and m.Grabbing then
			m.GrabDamage += _amount -- hit it hard enough and it lets go
		end
		if m and has(m, "Invisible") then
			m.ShownUntil = os.clock() + ai().StalkerRevealSeconds -- a hit shows it for a moment (Prompt 24)
			setHidden(m, false)
		elseif m and m.Hidden then
			setHidden(m, false) -- a hit shows where it lies
			m.AttackReadyAt = math.max(m.AttackReadyAt, os.clock() + ai().RevealSeconds)
		end
		if m and sourceId and string.sub(sourceId, 1, 1) == "P" then
			m.Aggro[sourceId] = os.clock() + ai().AggroSeconds
			if m.Target == nil or m.Target.Kind ~= "Residents" then
				m.TargetAt = 0 -- rethink now
			end
		end
	end)
	task.spawn(loop)
	log:Info("monsters ready: cap %d", cap())
end

return MonsterService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000106"><Properties><string name="Name">ObjectiveService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ObjectiveService: the run's big objectives (bible Sections 5, 12 and 23): Lost Crews
	rescued and era bosses beaten. Each one done adds its YearsPerCycle (Config.Objectives:
	+2 a crew, +1 a boss) to Years per Cycle, which CycleClock reads. Run place only.

	Prompt 3 keeps the record. The systems that rescue crews (Prompts 16 and 17) and beat the
	bosses (Prompts 15, 23 and 24) call Complete or BossBeaten. A boss's death is also what
	ends its Surge: boss Surges have no timer (Landon, Nov 8, 2026), so CycleClock listens to
	BossDefeated. The Source has no objective; beating it ends the final Surge (a Century
	Victory) or, in its chamber, wins the Deep Victory.

	API:
		ObjectiveService:Complete(objectiveId): boolean       -- false if unknown or already done
		ObjectiveService:BossBeaten(bossId): boolean          -- a boss died: its objective (if any), BossDefeated
		ObjectiveService:IsComplete(objectiveId): boolean
		ObjectiveService:Completed(): { [string]: boolean }   -- frozen copy
		ObjectiveService:Counts(): (number, number)           -- Lost Crews rescued, era bosses beaten
		ObjectiveService.Changed: Signal<string>              -- the objective just completed
		ObjectiveService:IsBossBeaten(bossId): boolean
		ObjectiveService.BossDefeated: Signal<string>         -- the boss just beaten (once per boss)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("ObjectiveService")

local ObjectiveService = {
	Name = "ObjectiveService",
	Dependencies = { "DevService" },
	Changed = Signal.new() :: Signal.Signal<string>,
	BossDefeated = Signal.new() :: Signal.Signal<string>,
}

local completed: { [string]: boolean } = {}
local defeated: { [string]: boolean } = {} -- bosses beaten this run
local snapshot: { [string]: boolean } = table.freeze({})
local set: ((string, any) -> ())? = nil

local function counts(): (number, number)
	local crews, bosses = 0, 0
	for id in completed do
		local objective = Config.Get("Objectives", id)
		if objective.Kind == "LostCrew" then
			crews += 1
		elseif objective.Kind == "Boss" then
			bosses += 1
		end
	end
	return crews, bosses
end

local function publish()
	local crews, bosses = counts()
	if set then
		set("LostCrews", crews)
		set("BossesBeaten", bosses)
	end
end

local function complete(objective: { [string]: any }): boolean
	if completed[objective.Id] then
		return false
	end
	completed[objective.Id] = true
	snapshot = table.freeze(table.clone(completed))
	publish()
	log:Info("%s done (+%d Years per Cycle)", objective.Name, objective.YearsPerCycle)
	ObjectiveService.Changed:Fire(objective.Id)
	return true
end

-- A Lost Crew rescued, or an era boss beaten (which is BossBeaten for that boss).
function ObjectiveService:Complete(objectiveId: string): boolean
	local objective = Config.Find("Objectives", objectiveId)
	if not objective then
		log:Warn("no objective %s", tostring(objectiveId))
		return false
	end
	if objective.Kind == "Boss" and objective.Boss and not completed[objective.Id] then
		return ObjectiveService:BossBeaten(objective.Boss)
	end
	return complete(objective)
end

function ObjectiveService:BossBeaten(bossId: string): boolean
	if not Config.Find("Bosses", bossId) then
		log:Warn("no boss %s", tostring(bossId))
		return false
	end
	if defeated[bossId] then
		return false
	end
	defeated[bossId] = true
	for _, objective in Config.All("Objectives") do
		if objective.Kind == "Boss" and objective.Boss == bossId then
			complete(objective)
		end
	end
	log:Info("%s beaten", bossId)
	ObjectiveService.BossDefeated:Fire(bossId)
	return true
end

function ObjectiveService:IsBossBeaten(bossId: string): boolean
	return defeated[bossId] == true
end

function ObjectiveService:IsComplete(objectiveId: string): boolean
	return completed[objectiveId] == true
end

function ObjectiveService:Completed(): { [string]: boolean }
	return snapshot
end

function ObjectiveService:Counts(): (number, number)
	return counts()
end

function ObjectiveService:Init(registry)
	set = RunState.Writer("ObjectiveService")
	publish()

	registry.DevService:Register("objectives", {
		Description = "List the run's objectives and which are done.",
		Run = function(): string?
			local lines = {}
			for _, objective in Config.All("Objectives") do
				local mark = if completed[objective.Id] then "done" else "    "
				table.insert(lines, `{mark} {objective.Id}: {objective.Name} (+{objective.YearsPerCycle})`)
			end
			local crews, bosses = counts()
			table.insert(lines, `Lost Crews {crews}, era bosses {bosses}`)
			return table.concat(lines, "\n")
		end,
	})
	registry.DevService:Register("objective", {
		Description = "Complete an objective (a Lost Crew rescued or an era boss beaten).",
		Usage = "objective <id>",
		Run = function(_player, args): string?
			local id = tostring(args[1] or "")
			if not Config.Find("Objectives", id) then
				return `no objective {id}; ids: {table.concat(Config.Ids("Objectives"), ", ")}`
			end
			if not ObjectiveService:Complete(id) then
				return `{id} was already done`
			end
			return `{id} done`
		end,
	})
end

return ObjectiveService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000107"><Properties><string name="Name">PartyService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PartyService: who belongs to this run (bible Section 21). Run place only; Prompt 21.

	The lobby writes the run's record to MemoryStore before it teleports the party (Lib.RunLaunch,
	Lib.RunRecord: the party, the difficulty, the loadouts, the server's access code). This service
	reads it once and:

	* sets the run's difficulty (RunDirector:SetDifficulty) before the first player is ready;
	* lets in only the record's party ("New players can't join a run in progress"): a session
	  waits at the Party gate until the record is read; a stranger is sent back to the lobby, and so
	  is anyone who lands in a Run server that isn't a reserved one (runs start from the lobby);
	* keeps each party member's rejoin record alive (Lib.Rejoin) while the run is on, so one who
	  drops can come back from the lobby, and removes them when the run ends or the server closes.

	In Studio there is no reserved server: everyone is let in, and a record under the Studio key (a
	Lobby playtest's pad, or dev `record`) still sets the difficulty and classes.

	API: Party(): { number } (the record's user ids; empty without a record), Record().
	Dev: party.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Rejoin = require(ServerScriptService.Lib.Rejoin)
local RunRecord = require(ServerScriptService.Lib.RunRecord)

local log = Log.new("PartyService")

local GATE = "Party"
local IS_STUDIO = RunService:IsStudio()

local PartyService = {
	Name = "PartyService",
	Dependencies = { "SessionService", "RunDirector", "DevService" },
}

local session: any = nil
local director: any = nil

local record: RunRecord.Record? = nil
local why: string? = nil
local read = false
local cleared = false

local function toLobby(player: Player, message: string)
	log:Info("%s isn't in this run's party: back to the lobby (%s)", player.Name, message)
	local ok = pcall(function()
		TeleportService:Teleport(Constants.PLACE_IDS.Lobby, player)
	end)
	if not ok then
		session:Fail(player, message)
	end
end

local function admit(player: Player)
	if player.Parent ~= Players then
		return
	end
	if IS_STUDIO then
		session:Pass(player, GATE)
		return
	end
	if not record then
		toLobby(player, "Runs start from the lobby.")
		return
	end
	if not table.find(record.Party, player.UserId) then
		toLobby(player, "This run has already started. Start a new one from the lobby.")
		return
	end
	session:Pass(player, GATE)
end

local function refreshRejoin()
	local key = RunRecord.Key()
	if IS_STUDIO or not record or not record.Code or not key then
		return
	end
	local seconds = Config.Get("Tuning", "Lobby").RejoinSeconds
	for _, userId in record.Party do
		Rejoin.Write(userId, { Key = key, Code = record.Code, Difficulty = record.Difficulty, At = os.time() }, seconds)
	end
end

local function clearRejoin()
	if cleared or IS_STUDIO or not record then
		return
	end
	cleared = true
	for _, userId in record.Party do
		Rejoin.Remove(userId)
	end
	log:Info("the run is over: %d rejoin records removed", #record.Party)
end

function PartyService:Party(): { number }
	return if record then table.clone(record.Party) else {}
end

function PartyService:Record(): RunRecord.Record?
	return record
end

function PartyService:Init(registry)
	session = registry.SessionService
	director = registry.RunDirector
	session:AddGate(GATE)
	registry.DevService:Register("party", {
		Description = "This run's record: its key, party, difficulty and whether it was read.",
		Run = function(): string?
			if not read then
				return "the record hasn't been read yet"
			end
			if not record then
				return `no record under {tostring(RunRecord.Key())} ({tostring(why)}); difficulty {director:Difficulty()}`
			end
			local ids = {}
			for _, userId in record.Party do
				table.insert(ids, tostring(userId))
			end
			return `record {tostring(RunRecord.Key())}: party {table.concat(ids, ", ")}, {tostring(record.Difficulty)}, written {os.time() - record.CreatedAt} s ago, access code {if record.Code then "kept" else "none"}`
		end,
	})
end

function PartyService:Start()
	task.spawn(function()
		record, why = RunRecord.Mine()
		read = true
		if record then
			if record.Difficulty and director:SetDifficulty(record.Difficulty) then
				log:Info("the run's record: %d in the party, %s", #record.Party, record.Difficulty)
			else
				log:Info("the run's record: %d in the party", #record.Party)
			end
		else
			log:Info("no run record (%s)", tostring(why))
		end
		for _, player in Players:GetPlayers() do
			admit(player)
		end
		Players.PlayerAdded:Connect(admit)
		-- the rejoin records live as long as the run does
		local t = Config.Get("Tuning", "Lobby")
		local nextWrite = 0
		while not cleared do
			if director:Phase() == "Ended" then
				clearRejoin()
				break
			end
			if os.clock() >= nextWrite then
				nextWrite = os.clock() + t.RejoinRefreshSeconds
				refreshRejoin()
			end
			task.wait(5)
		end
	end)
	director.RunEnded:Connect(function()
		task.spawn(clearRejoin)
	end)
	game:BindToClose(function()
		clearRejoin()
	end)
end

return PartyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000108"><Properties><string name="Name">PingService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PingService: cell pings (bible Section 7: "Ping any cell; it shows on every player's
	mini-map"). Run place only.

	A player pings a cell from the Command View (the PingCell remote: floor, column). The
	server checks the cell is on the grid and the player's session is ready (the remote's rate
	limit stops spam), then tells every ready player (CellPinged: floor, column, the pinger's
	UserId and display name). Clients show the ping on the mini-map and in the Command View for
	Tuning.Ping.Seconds.

	The world ping (the Ping action in play, and the Rally ping of Section 11) comes with combat
	and residents and will go through here too.

	API:
		PingService:Ping(player, floor, column): (boolean, string?)
		PingService.Pinged: Signal<Player, number, number>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("PingService")

local PingService = {
	Name = "PingService",
	Dependencies = { "SessionService", "DevService" },
	Pinged = Signal.new() :: Signal.Signal<Player, number, number>,
}

local session: any = nil
local sent = 0

function PingService:Ping(player: Player, floor: number, column: number): (boolean, string?)
	if not session:IsReady(player) then
		return false, "not ready yet"
	elseif not Grid.OnGrid(floor, column) then
		return false, "off the grid"
	end
	sent += 1
	Remotes.FireClients("CellPinged", session:ReadyPlayers(), floor, column, player.UserId, player.DisplayName)
	log:Debug("%s pinged %s", player.Name, Grid.Key(floor, column))
	PingService.Pinged:Fire(player, floor, column)
	return true, nil
end

function PingService:Init(registry)
	session = registry.SessionService
	Remotes.OnServer("PingCell", function(player: Player, floor: number, column: number)
		PingService:Ping(player, floor, column)
	end)
	registry.DevService:Register("cell.ping", {
		Description = "Ping a cell as if from the Command View (every player sees it on the mini-map).",
		Usage = "cell.ping <floor> <column>",
		Run = function(player: Player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: cell.ping <floor> <column>"
			end
			local ok, why = PingService:Ping(player, floor, column)
			return if ok then `pinged {Grid.Key(floor, column)} ({sent} pings this run)` else `not pinged: {why}`
		end,
	})
end

return PingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000109"><Properties><string name="Name">PowerService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PowerService: the power balance and dark rooms (bible Sections 6 and 23). Run place only.

	Power is a live balance, not a stock. The Reactor Core and Generators make power from the
	residents working in them (Landon, Nov 8, 2026); every room draws Power[level] for each of
	its cells. When the draw passes what is made, rooms go dark farthest first: steps along the
	room graph from the nearest Reactor Core or Generator, dug cells counting (Rules.Economy
	.Balance has the rule). The balance is worked out again whenever the bunker, a crew or an
	output modifier changes, and every second in case.

	Dark rooms stop working (EconomyService.SetPowered), their lights drop to a dim red emergency
	glow and their Neon fittings (light strips, pendants) go dull; the room model carries a Dark
	attribute. Their morale loss (Prompt 10) and
	doubled monster spawns (Prompt 12) ask IsDark. The team gets an alert when rooms go dark
	and when the power comes back.

	Blackouts (Prompt 13, Section 10: a floor or the whole grid goes dark): DisasterService sets
	the units a blackout darkens (SetBlackout). They are dark on top of the balance, whatever
	power is made: lights, fittings, work and IsDark all follow, but the power alerts and
	DarkRooms count only rooms dark for want of power.

	Replication: RunState PowerMade, PowerUsed, PowerNeeded and DarkRooms; the Power collection,
	room id -> { Draw, Made, Dark, Steps, Blackout } for every room that draws or makes power.

	API:
		PowerService:IsDark(roomId): boolean            -- for want of power or in a blackout
		PowerService:IsBlackout(unit): boolean
		PowerService:SetBlackout(units?)                -- the units a blackout darkens; nil: none
		PowerService:Balance(): Economy.Balance
		PowerService:Refresh()
		PowerService.DarkChanged: Signal<{ string }, { string }>  -- went dark, lit again
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Rules.Economy)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("PowerService")
local set = RunState.Writer("PowerService")

local PowerService = {
	Name = "PowerService",
	Dependencies = { "BunkerGrid", "EconomyService", "SessionService", "ReplicationService", "DevService" },
	DarkChanged = Signal.new() :: Signal.Signal<{ string }, { string }>,
}

-- A dark room's lights: a dim red emergency glow (art direction, not a rule).
local EMERGENCY = Color3.fromRGB(255, 72, 48)
local DARK_BRIGHTNESS = 0.18 -- of the light's own brightness
local DARK_FITTING = Color3.fromRGB(64, 30, 26) -- a Neon fitting with the power off
local REFRESH_SECONDS = 1

local grid: any = nil
local economy: any = nil
local session: any = nil
local powerCollection: any = nil
local balance: Economy.Balance = { Made = 0, Needed = 0, Used = 0, Dark = {}, Draw = {}, MadeBy = {}, Steps = {} }
local published: { [string]: string } = {} -- room id -> what was last sent (to send only changes)
local pending = false
local blackout: { [string]: boolean } = {} -- units dark in a blackout (Prompt 13)
local darkNow: { [string]: boolean } = {} -- the balance's dark rooms plus the blackout

local function isDarkNow(unit: string): boolean
	return darkNow[unit] == true
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function roomName(roomType: string): string
	return Config.Get("Rooms", roomType).Name
end

local function round1(value: number): number
	return math.floor(value * 10 + 0.5) / 10
end

-- Lights ---------------------------------------------------------------------------------------

local function setLight(light: Instance, isDark: boolean)
	if not light:IsA("Light") then
		return
	end
	if (light:GetAttribute("PowerDark") == true) == isDark then
		return
	end
	if light:GetAttribute("LitBrightness") == nil then
		light:SetAttribute("LitBrightness", light.Brightness)
		light:SetAttribute("LitColor", light.Color)
	end
	local brightness = light:GetAttribute("LitBrightness")
	local color = light:GetAttribute("LitColor")
	if isDark then
		light.Brightness = (if type(brightness) == "number" then brightness else light.Brightness) * DARK_BRIGHTNESS
		light.Color = EMERGENCY
	else
		if type(brightness) == "number" then
			light.Brightness = brightness
		end
		if typeof(color) == "Color3" then
			light.Color = color
		end
	end
	light:SetAttribute("PowerDark", isDark)
end

-- A dark room's Neon fittings go dull (SmoothPlastic, dark red); lit again, they come back.
local function setFittings(model: Model, isDark: boolean)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and (item.Material == Enum.Material.Neon or item:GetAttribute("LitMaterial") ~= nil) then
			if isDark then
				if item:GetAttribute("LitMaterial") == nil then
					item:SetAttribute("LitMaterial", item.Material.Name)
					item:SetAttribute("LitColor", item.Color)
				end
				item.Material = Enum.Material.SmoothPlastic
				item.Color = DARK_FITTING
			else
				local material, color = item:GetAttribute("LitMaterial"), item:GetAttribute("LitColor")
				if type(material) == "string" then
					item.Material = (Enum.Material :: any)[material]
				end
				if typeof(color) == "Color3" then
					item.Color = color
				end
				item:SetAttribute("LitMaterial", nil)
				item:SetAttribute("LitColor", nil)
			end
		end
	end
end

local function applyLights()
	for _, light in CollectionService:GetTagged(BunkerKit.ROOM_LIGHT_TAG) do
		local unit = light:GetAttribute("Unit")
		if type(unit) == "string" then
			setLight(light, isDarkNow(unit))
		end
	end
	for _, room in grid:Rooms() do
		local model = grid:RoomModel(room.Id)
		if model then
			local isDark = isDarkNow(room.Id)
			if (model:GetAttribute("Dark") == true) ~= isDark then
				model:SetAttribute("Dark", isDark)
				setFittings(model, isDark)
			end
		end
	end
end

-- The balance ------------------------------------------------------------------------------------

local function publish()
	set("PowerMade", round1(balance.Made))
	set("PowerUsed", round1(balance.Used))
	set("PowerNeeded", round1(balance.Needed))
	local darkCount = 0
	for _ in balance.Dark do
		darkCount += 1
	end
	set("DarkRooms", darkCount)
	local seen: { [string]: boolean } = {}
	for _, room in grid:Rooms() do
		local draw, made = balance.Draw[room.Id], balance.MadeBy[room.Id]
		if draw or made then
			seen[room.Id] = true
			local entry = {
				Draw = draw or 0,
				Made = round1(made or 0),
				Dark = isDarkNow(room.Id),
				Steps = balance.Steps[room.Id] or -1, -- -1: nothing reaches it
				Blackout = blackout[room.Id] == true,
			}
			local key = `{entry.Draw}|{entry.Made}|{entry.Dark}|{entry.Steps}|{entry.Blackout}`
			if published[room.Id] ~= key then
				published[room.Id] = key
				powerCollection:Set(room.Id, entry)
			end
		end
	end
	for id in table.clone(published) do
		if not seen[id] then
			published[id] = nil
			powerCollection:Remove(id)
		end
	end
end

function PowerService:Refresh()
	pending = false
	local before = balance.Dark
	balance = Economy.Balance(grid:Bunker(), function(roomId: string): Economy.Crew?
		return economy:Crew(roomId)
	end, function(roomType: string): number
		return economy:OutputMultiplier(roomType)
	end)
	local wentDark, litAgain = {}, {}
	for id in balance.Dark do
		if not before[id] then
			table.insert(wentDark, id)
		end
	end
	for id in before do
		if not balance.Dark[id] and grid:Room(id) then
			table.insert(litAgain, id)
		end
	end
	local wasDark = darkNow
	darkNow = table.clone(balance.Dark)
	for unit in blackout do
		darkNow[unit] = true
	end
	economy:SetPowered(darkNow)
	publish()
	applyLights()
	local blackoutChanged = false
	for unit in darkNow do
		if not wasDark[unit] then
			blackoutChanged = true
		end
	end
	for unit in wasDark do
		if not darkNow[unit] then
			blackoutChanged = true
		end
	end
	if #wentDark > 0 or #litAgain > 0 then
		table.sort(wentDark)
		table.sort(litAgain)
		log:Info("power %.1f made, %.1f needed: dark %s", balance.Made, balance.Needed,
			if next(balance.Dark) then table.concat(wentDark, ", ") else "none")
		if #wentDark > 0 then
			local room = grid:Room(wentDark[1])
			local what = if #wentDark == 1 and room then `THE {string.upper(roomName(room.Type))} WENT DARK`
				else `{#wentDark} ROOMS WENT DARK`
			announce("Warning", `NOT ENOUGH POWER: {what}`)
		elseif not next(balance.Dark) then
			announce("Info", "POWER RESTORED: EVERY ROOM IS LIT")
		end
		PowerService.DarkChanged:Fire(wentDark, litAgain)
	elseif blackoutChanged then
		PowerService.DarkChanged:Fire({}, {})
	end
end

-- Many changes in one frame (a merge, a crew shuffle) make one refresh.
local function soon()
	if pending then
		return
	end
	pending = true
	task.defer(function()
		if pending then
			PowerService:Refresh()
		end
	end)
end

function PowerService:IsDark(roomId: string): boolean
	return darkNow[roomId] == true
end

function PowerService:IsBlackout(unit: string): boolean
	return blackout[unit] == true
end

-- The units (room ids, dug nodes) a blackout darkens; nil or {} ends it (DisasterService).
function PowerService:SetBlackout(units: { [string]: boolean }?)
	blackout = if units then table.clone(units) else {}
	PowerService:Refresh()
end

function PowerService:Balance(): Economy.Balance
	return balance
end

-- DevTools ---------------------------------------------------------------------------------------

local function describe(): string
	local lines = { string.format("power: %.1f made, %.1f used, %.1f needed", balance.Made, balance.Used, balance.Needed) }
	local rooms = grid:Rooms()
	table.sort(rooms, function(a, b)
		return Economy.Order(a.Id) < Economy.Order(b.Id)
	end)
	for _, room in rooms do
		local draw, made = balance.Draw[room.Id], balance.MadeBy[room.Id]
		if draw or made then
			table.insert(lines, string.format("%s %s L%d: %s, steps %s%s%s", room.Id, room.Type, room.Level,
				if made then string.format("makes %.1f", made) else `draws {draw}`,
				tostring(balance.Steps[room.Id] or "none"), if balance.Dark[room.Id] then ", DARK" else "",
				if blackout[room.Id] then ", BLACKOUT" else ""))
		end
	end
	return table.concat(lines, "\n")
end

function PowerService:Init(registry)
	grid = registry.BunkerGrid
	economy = registry.EconomyService
	session = registry.SessionService
	powerCollection = registry.ReplicationService:Collection("Power")
	registry.DevService:Register("power", {
		Description = "The power balance: what each room makes or draws, its steps and whether it is dark.",
		Usage = "power",
		Run = function(): string?
			PowerService:Refresh()
			return describe()
		end,
	})
end

function PowerService:Start()
	grid.RoomChanged:Connect(soon)
	grid.Changed:Connect(soon) -- digging changes the graph's steps
	economy.CrewChanged:Connect(soon)
	PowerService:Refresh()
	local since = 0
	RunService.Heartbeat:Connect(function(dt: number)
		since += dt
		if since >= REFRESH_SECONDS then
			since = 0
			PowerService:Refresh()
		end
	end)
end

return PowerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000010A"><Properties><string name="Name">ProfileService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileService: saved data (bible Section 23; Prompt 2). One profile per player, in both
	places.

	The stored value is a record { Data = profile, Lock = { Session, PlaceId, At }, Meta }.
	Every read-modify-write goes through UpdateAsync:
	* load claims the lock: a fresh lock held by another server means wait and retry (it may
	  be saving on the way out, as when a player teleports from the Lobby), and in the end
	  refuse; a stale lock (a crashed server) is taken over. Data newer than this server's
	  ProfileSchema.VERSION is never loaded or written.
	* the profile then goes through migrate, reconcile, validate (ProfileSchema.Load). A failed
	  or refused load kicks the player with a message and writes nothing.
	* saves happen every Constants.AUTOSAVE_SECONDS (staggered per player; each also refreshes
	  the lock), when the player leaves (and releases the lock) and on shutdown (BindToClose).
	  A save only writes if this server still holds the lock and the profile still validates.

	Gameplay never touches DataStores: it calls Update, AddGlowshards, SpendGlowshards and
	GrantPurchase. The player's own client sees their profile (minus receipts) in the
	"Profiles" collection of the delta channel. A session isn't ready until the profile loads
	(the "Profile" gate in SessionService).

	In Studio the store is PlayerProfiles_Studio, so tests never touch live saves; if Studio
	has no API access, an in-memory store stands in (and says so).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local TableUtil = require(Shared.Utilities.TableUtil)
local ProfileSchema = require(ServerScriptService:WaitForChild("Lib"):WaitForChild("ProfileSchema"))

local log = Log.new("ProfileService")

local IS_STUDIO = RunService:IsStudio()
local STORE_NAME = if IS_STUDIO then "PlayerProfiles_Studio" else "PlayerProfiles"
local SESSION_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local LOCK_STALE_SECONDS = if IS_STUDIO then 30 else Constants.AUTOSAVE_SECONDS * 3
local CLAIM_ATTEMPTS = 8
local CLAIM_WAIT_SECONDS = 2
local CALL_ATTEMPTS = 4
local SHUTDOWN_WAIT_SECONDS = if IS_STUDIO then 8 else 25
local GATE = "Profile"

local MESSAGES: { [string]: string } = {
	Locked = "Your save is still being written by another server. Please rejoin in a moment.",
	TooNew = "Your save is from a newer version of the game. Please rejoin to get an up-to-date server.",
	Corrupt = "We couldn't read your save, so nothing was changed. Please rejoin; if this keeps happening, let us know.",
	Invalid = "We couldn't read your save, so nothing was changed. Please rejoin; if this keeps happening, let us know.",
	Error = "Saved data is unavailable right now (Roblox DataStores). Please rejoin in a few minutes.",
	LockLost = "Your save was opened in another server, so this one stopped. Please rejoin.",
}

export type Profile = { [string]: any }

type Session = {
	Player: Player,
	Key: string,
	Data: Profile,
	Receipts: { [string]: boolean },
	Saving: boolean,
	Released: boolean,
	LockLost: boolean,
	NextSave: number,
	Saves: number,
}

local ProfileService = {
	Name = "ProfileService",
	Dependencies = { "SessionService", "ReplicationService", "DevService" },
	Loaded = Signal.new() :: Signal.Signal<Player, Profile>,
	Releasing = Signal.new() :: Signal.Signal<Player>,
}

local sessions: { [Player]: Session } = {}
local loading: { [Player]: boolean } = {}
local sessionService: any = nil
local profiles: any = nil
local store: any = nil
local storeKind = "none"
local usingDataStore = false
local shuttingDown = false
local releasesInFlight = 0

-- An in-memory store with DataStore semantics (values go through JSON, as they would).
local function memoryStore(): any
	local values: { [string]: string } = {}
	local memory = {}
	function memory.UpdateAsync(_self: any, key: string, transform: (any) -> any): any
		local current = values[key]
		local result = transform(if current then HttpService:JSONDecode(current) else nil)
		if result ~= nil then
			values[key] = HttpService:JSONEncode(result)
		end
		return result
	end
	function memory.GetAsync(_self: any, key: string): any
		local current = values[key]
		return if current then HttpService:JSONDecode(current) else nil
	end
	function memory.RemoveAsync(_self: any, key: string): any
		local current = values[key]
		values[key] = nil
		return if current then HttpService:JSONDecode(current) else nil
	end
	return memory
end

local function keyFor(userId: number): string
	return `Player_{userId}`
end

-- Calls a DataStore function with retries and backoff. Returns ok and its result or error.
local function attempt(what: string, call: () -> any): (boolean, any)
	local delay = 1
	local lastError: any = nil
	for try = 1, CALL_ATTEMPTS do
		local ok, result = pcall(call)
		if ok then
			return true, result
		end
		lastError = result
		log:Warn("%s failed (try %d of %d): %s", what, try, CALL_ATTEMPTS, tostring(result))
		if try < CALL_ATTEMPTS then
			task.wait(delay)
			delay = math.min(delay * 2, 8)
		end
	end
	return false, lastError
end

local function isForeignLock(lock: any): boolean
	return type(lock) == "table"
		and lock.Session ~= SESSION_ID
		and type(lock.At) == "number"
		and os.time() - lock.At < LOCK_STALE_SECONDS
end

local function isTooNew(data: any): boolean
	return type(data) == "table" and type(data.Version) == "number" and data.Version > ProfileSchema.VERSION
end

-- Claims a key's lock. Returns "Claimed" and the stored Data (nil for a new player), or
-- "Locked", "TooNew", "Corrupt" or "Error" (and the error).
local function claim(key: string): (string, any)
	local status, stored = "Error", nil
	local ok, err = attempt(`claim {key}`, function(): any
		status, stored = "Error", nil
		return store:UpdateAsync(key, function(old: any): any
			if old ~= nil and (type(old) ~= "table" or (old.Data ~= nil and type(old.Data) ~= "table")) then
				status = "Corrupt"
				return nil
			end
			local record = old or {}
			if isForeignLock(record.Lock) then
				status = "Locked"
				return nil
			end
			if isTooNew(record.Data) then
				status = "TooNew"
				return nil
			end
			record.Lock = { Session = SESSION_ID, PlaceId = game.PlaceId, At = os.time() }
			if type(record.Meta) ~= "table" then
				record.Meta = { Created = os.time(), Saves = 0 }
			end
			status, stored = "Claimed", record.Data
			return record
		end)
	end)
	if not ok then
		return "Error", tostring(err)
	end
	return status, stored
end

-- Gives a lock back without touching the data (after a load we can't use).
local function releaseLockOnly(key: string)
	attempt(`release {key}`, function(): any
		return store:UpdateAsync(key, function(old: any): any
			if type(old) ~= "table" or type(old.Lock) ~= "table" or old.Lock.Session ~= SESSION_ID then
				return nil
			end
			old.Lock = nil
			return old
		end)
	end)
end

-- Writes the session's profile (and releases the lock if asked). Only if we still hold it.
local function write(session: Session, release: boolean): boolean
	local valid, why = ProfileSchema.Validate(session.Data)
	if not valid then
		log:Error("%s: not saving an invalid profile (%s)", session.Key, tostring(why))
		return false
	end
	local data = session.Data
	local status = "Error"
	local ok, err = attempt(`save {session.Key}`, function(): any
		status = "Error"
		return store:UpdateAsync(session.Key, function(old: any): any
			local record = if type(old) == "table" then old else {}
			local lock = record.Lock
			if type(lock) ~= "table" or lock.Session ~= SESSION_ID then
				status = "LockLost"
				return nil
			end
			if isTooNew(record.Data) then
				status = "TooNew"
				return nil
			end
			record.Data = data
			record.Lock = if release then nil else { Session = SESSION_ID, PlaceId = game.PlaceId, At = os.time() }
			local meta = if type(record.Meta) == "table" then record.Meta else {}
			meta.Saves = (tonumber(meta.Saves) or 0) + 1
			meta.LastSave = os.time()
			meta.LastPlace = game.PlaceId
			record.Meta = meta
			status = "Saved"
			return record
		end)
	end)
	if not ok then
		log:Error("couldn't save %s: %s", session.Key, tostring(err))
		return false
	end
	if status == "LockLost" then
		session.LockLost = true
		log:Error("%s: the save lock is gone; not writing over another server", session.Key)
		if session.Player.Parent == Players and not release then
			session.Player:Kick(MESSAGES.LockLost)
		end
		return false
	end
	if status ~= "Saved" then
		log:Error("%s: save refused (%s)", session.Key, status)
		return false
	end
	session.Saves += 1
	return true
end

-- One write at a time per player; a release waits for a running save, then finishes.
local function save(session: Session, release: boolean): boolean
	while session.Saving do
		task.wait(0.1)
	end
	if session.Released or session.LockLost then
		return false
	end
	session.Saving = true
	local ok = write(session, release)
	session.Saving = false
	session.NextSave = os.clock() + Constants.AUTOSAVE_SECONDS
	if release then
		session.Released = true
	end
	return ok
end

local function publish(session: Session)
	local key = tostring(session.Player.UserId)
	if profiles:Get(key) == nil then
		profiles:Set(key, ProfileSchema.Public(session.Data))
	else
		profiles:Patch(key, ProfileSchema.Public(session.Data))
	end
end

local function load(player: Player)
	if loading[player] or sessions[player] then
		return
	end
	loading[player] = true
	local key = keyFor(player.UserId)
	local status, stored = "Locked", nil
	for try = 1, CLAIM_ATTEMPTS do
		status, stored = claim(key)
		if status ~= "Locked" or player.Parent ~= Players then
			break
		end
		log:Info("%s's save is open in another server; waiting (%d of %d)", player.Name, try, CLAIM_ATTEMPTS)
		task.wait(CLAIM_WAIT_SECONDS)
	end
	loading[player] = nil
	if status ~= "Claimed" then
		log:Error("%s: profile not loaded (%s %s)", player.Name, status, tostring(stored))
		if player.Parent == Players then
			sessionService:Fail(player, MESSAGES[status] or MESSAGES.Error)
		end
		return
	end
	local data, loadStatus, why = ProfileSchema.Load(stored)
	if not data then
		releaseLockOnly(key)
		log:Error("%s: profile %s (%s); nothing written", player.Name, loadStatus, tostring(why))
		if player.Parent == Players then
			sessionService:Fail(player, MESSAGES[loadStatus] or MESSAGES.Invalid)
		end
		return
	end
	local session: Session = {
		Player = player,
		Key = key,
		Data = data,
		Receipts = {},
		Saving = false,
		Released = false,
		LockLost = false,
		NextSave = os.clock() + (player.UserId % Constants.AUTOSAVE_SECONDS) + 5,
		Saves = 0,
	}
	for _, receiptId in data.Receipts do
		session.Receipts[receiptId] = true
	end
	if player.Parent ~= Players then
		release(session) -- left while loading: write what we migrated and let go
		return
	end
	sessions[player] = session
	publish(session)
	player:SetAttribute("ProfileLoaded", true)
	log:Info("%s: profile %s, %d Glowshards", player.Name, loadStatus, data.Glowshards)
	ProfileService.Loaded:Fire(player, data)
	sessionService:Pass(player, GATE)
end

-- Saves and lets go of a session; shutdown waits for every release in flight.
local function release(session: Session)
	releasesInFlight += 1
	local ok, err = pcall(save, session, true)
	releasesInFlight -= 1
	if not ok then
		log:Error("%s: release failed: %s", session.Key, tostring(err))
	end
end

local function leave(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	ProfileService.Releasing:Fire(player)
	profiles:Remove(tostring(player.UserId))
	release(session)
end

-- Public API --------------------------------------------------------------------------------

function ProfileService:IsLoaded(player: Player): boolean
	return sessions[player] ~= nil
end

-- The live profile (read it; change it only through Update).
function ProfileService:Get(player: Player): Profile?
	local session = sessions[player]
	return if session then session.Data else nil
end

--[[
	Changes a profile. `change` edits the table it is given and must not yield. If it errors or
	leaves the profile invalid, every change is undone and Update returns false. Changes are
	replicated to the player and saved with the next save.
]]
function ProfileService:Update(player: Player, change: (Profile) -> ()): boolean
	local session = sessions[player]
	if not session or session.Released then
		return false
	end
	local data = session.Data
	local backup = TableUtil.DeepCopy(data)
	local ok, err = pcall(change, data)
	local valid, why = true, nil
	if ok then
		valid, why = ProfileSchema.Validate(data)
	end
	if not ok or not valid then
		table.clear(data)
		for field, value in backup do
			data[field] = value
		end
		log:Error("%s: profile change undone (%s)", player.Name, tostring(if ok then why else err))
		return false
	end
	publish(session)
	return true
end

function ProfileService:AddGlowshards(player: Player, amount: number, reason: string): boolean
	assert(amount >= 0 and amount % 1 == 0, "AddGlowshards: a whole, positive amount")
	local ok = ProfileService:Update(player, function(data)
		data.Glowshards += amount
	end)
	if ok then
		log:Info("%s +%d Glowshards (%s)", player.Name, amount, reason)
	end
	return ok
end

-- Spends Glowshards if the player has enough. Returns false (and changes nothing) otherwise.
function ProfileService:SpendGlowshards(player: Player, amount: number, reason: string): boolean
	assert(amount >= 0 and amount % 1 == 0, "SpendGlowshards: a whole, positive amount")
	local data = ProfileService:Get(player)
	if not data or data.Glowshards < amount then
		return false
	end
	local ok = ProfileService:Update(player, function(profile)
		profile.Glowshards -= amount
	end)
	if ok then
		log:Info("%s -%d Glowshards (%s)", player.Name, amount, reason)
	end
	return ok
end

-- Saves now (yields). True when the profile is safely stored.
function ProfileService:SaveNow(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and save(session, false)
end

function ProfileService:HasReceipt(player: Player, receiptId: string): boolean
	local session = sessions[player]
	return session ~= nil and session.Receipts[receiptId] == true
end

--[[
	For ProcessReceipt (bible Section 17): grant first, record the receipt id in the profile,
	save, and only then tell Roblox it was granted. A repeated receipt is never granted twice:
	if the id is already recorded, the grant is skipped and only the save is redone.
]]
function ProfileService:GrantPurchase(player: Player, receiptId: string, grant: (Profile) -> ()): Enum.ProductPurchaseDecision
	local session = sessions[player]
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not session.Receipts[receiptId] then
		local ok = ProfileService:Update(player, function(data)
			grant(data)
			ProfileSchema.AddReceipt(data, receiptId)
		end)
		if not ok then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		session.Receipts[receiptId] = true
	end
	if save(session, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- DevTools ---------------------------------------------------------------------------------

local function targetOf(player: Player?, arg: any): Player?
	if type(arg) == "number" then
		return Players:GetPlayerByUserId(arg)
	end
	return player or Players:GetPlayers()[1]
end

local function summary(data: Profile): string
	local classes = TableUtil.SortedKeys(data.Classes)
	local legends = TableUtil.SortedKeys(data.Legends)
	return `v{data.Version}, {data.Glowshards} Glowshards, account level {data.AccountLevel}, `
		.. `classes {table.concat(classes :: { any }, "/")}, Legends {table.concat(legends :: { any }, "/")}, `
		.. `receipts {#data.Receipts}, first run done {tostring(data.FirstRunDone)}`
end

-- Runs the lock rules against a scratch key (Studio store only).
local function lockTest(): string
	local key = `Test_{SESSION_ID}`
	local lines = {}
	local function step(name: string, expected: string, got: string)
		table.insert(lines, `{if got == expected then "ok  " else "FAIL"} {name}: {got} (expected {expected})`)
	end
	store:RemoveAsync(key)
	step("new key", "Claimed", (claim(key)))
	store:UpdateAsync(key, function(old: any): any
		old.Lock = { Session = "another-server", PlaceId = 1, At = os.time() }
		return old
	end)
	step("fresh foreign lock", "Locked", (claim(key)))
	store:UpdateAsync(key, function(old: any): any
		old.Lock.At = os.time() - LOCK_STALE_SECONDS - 5
		return old
	end)
	step("stale foreign lock", "Claimed", (claim(key)))
	store:UpdateAsync(key, function(_old: any): any
		return { Data = { Version = ProfileSchema.VERSION + 1, Glowshards = 7 } }
	end)
	step("newer version", "TooNew", (claim(key)))
	local after = store:GetAsync(key)
	step("newer data untouched", "untouched", if after.Lock == nil and after.Data.Glowshards == 7 then "untouched" else "changed")
	store:UpdateAsync(key, function(_old: any): any
		return "garbage"
	end)
	step("corrupt record", "Corrupt", (claim(key)))
	store:RemoveAsync(key)
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("profile", {
		Description = "A player's profile (yours, or by user id).",
		Usage = "profile [userId]",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			local data = target and ProfileService:Get(target)
			if not target or not data then
				return "no loaded profile"
			end
			local session = sessions[target] :: Session
			return `{target.Name}: {summary(data)} | store {storeKind}, saves {session.Saves}`
		end,
	})
	dev:Register("profile.add", {
		Description = "Give Glowshards (testing).",
		Usage = "profile.add <amount> [userId]",
		Run = function(player: Player?, args: { any }): string?
			local amount = tonumber(args[1])
			local target = targetOf(player, args[2])
			if not amount or amount < 0 or amount % 1 ~= 0 or not target then
				return "usage: profile.add <whole amount> [userId]"
			end
			local ok = ProfileService:AddGlowshards(target, amount, "dev command")
			return if ok then `{target.Name} now has {(ProfileService:Get(target) :: Profile).Glowshards}` else "failed"
		end,
	})
	dev:Register("profile.save", {
		Description = "Save a profile now.",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			if not target then
				return "no player"
			end
			return if ProfileService:SaveNow(target) then `saved {target.Name}` else "save failed (see logs)"
		end,
	})
	dev:Register("profile.raw", {
		Description = "Read a stored record straight from the store (read-only).",
		Usage = "profile.raw [userId]",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			local userId = if type(args[1]) == "number" then args[1] else target and target.UserId
			if not userId then
				return "no player"
			end
			local ok, record = attempt("read", function(): any
				return store:GetAsync(keyFor(userId))
			end)
			if not ok then
				return `read failed: {tostring(record)}`
			end
			if record == nil then
				return "no record"
			end
			local lock = record.Lock
			local lockText = if type(lock) == "table"
				then `{if lock.Session == SESSION_ID then "this server" else tostring(lock.Session)}, {os.time() - (lock.At or 0)} s ago`
				else "none"
			local data = record.Data
			local dataText = if type(data) == "table" then summary(data) else "no data yet"
			local meta = record.Meta or {}
			return `lock: {lockText} | saves {tostring(meta.Saves)} | {dataText}`
		end,
	})
	dev:Register("profile.receipt", {
		Description = "Grant a test purchase through the receipt path (Studio only).",
		Usage = "profile.receipt <receiptId> <glowshards>",
		Run = function(player: Player?, args: { any }): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			local target = targetOf(player, nil)
			local receiptId, amount = tostring(args[1] or ""), tonumber(args[2])
			if not target or receiptId == "" or not amount or amount < 0 or amount % 1 ~= 0 then
				return "usage: profile.receipt <receiptId> <whole amount>"
			end
			local decision = ProfileService:GrantPurchase(target, receiptId, function(data)
				data.Glowshards += amount
			end)
			return `{decision.Name}; {target.Name} has {(ProfileService:Get(target) :: Profile).Glowshards} Glowshards`
		end,
	})
	dev:Register("profile.locktest", {
		Description = "Run the lock rules against a scratch key (Studio only).",
		Run = function(): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			return lockTest()
		end,
	})
end

-- Lifecycle --------------------------------------------------------------------------------

function ProfileService:Init(registry)
	sessionService = registry.SessionService
	sessionService:AddGate(GATE)
	profiles = registry.ReplicationService:Collection("Profiles", {
		Visible = function(player: Player, key: string): boolean
			return key == tostring(player.UserId)
		end,
	})
	registerCommands(registry.DevService)
end

function ProfileService:Start()
	local ok, result = pcall(function(): any
		local dataStore = DataStoreService:GetDataStore(STORE_NAME)
		dataStore:GetAsync("Probe")
		return dataStore
	end)
	if ok then
		store, storeKind, usingDataStore = result, `DataStore {STORE_NAME}`, true
	elseif IS_STUDIO then
		store, storeKind = memoryStore(), "memory (Studio has no DataStore access)"
		log:Warn("DataStores unavailable in this Studio session (%s): profiles live in memory only", tostring(result))
	else
		store, storeKind, usingDataStore = DataStoreService:GetDataStore(STORE_NAME), `DataStore {STORE_NAME}`, true
		log:Error("DataStore probe failed (%s); loads will retry", tostring(result))
	end
	log:Info("profiles in %s", storeKind)

	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(leave)

	game:BindToClose(function()
		shuttingDown = true
		for player, session in sessions do
			sessions[player] = nil
			task.spawn(release, session)
		end
		local waited = 0
		while (releasesInFlight > 0 or next(loading) ~= nil) and waited < SHUTDOWN_WAIT_SECONDS do
			waited += task.wait(0.2)
		end
		log:Info("shutdown: profiles released (%d still in flight after %.1f s)", releasesInFlight, waited)
	end)

	task.spawn(function()
		while not shuttingDown do
			task.wait(5)
			local now = os.clock()
			local budget = if usingDataStore
				then DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
				else math.huge
			for _, session in sessions do
				if budget > 10 and not session.Saving and now >= session.NextSave then
					budget -= 1
					task.spawn(save, session, false)
				end
			end
		end
	end)
end

return ProfileService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000010B"><Properties><string name="Name">PurchaseService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PurchaseService: developer product receipts (bible Section 17: "Purchases go through
	ProcessReceipt: grant first, record the receipt id in the player's profile, then confirm, so a
	repeated receipt is never granted twice"). Both places, since Roblox hands a receipt to whichever
	server the buyer is in next. Prompt 21 brings the first product, the Class Shop reroll; Prompt 28
	(the shop) adds Glowshard packs and team boosts as more rows.

	* A product is a row here: its id (from Config, nil until the product exists), and a grant that
	  edits the profile and must not yield (ProfileService:GrantPurchase runs it once per receipt).
	* The Class Shop reroll's grant is the shared rule (Rules.ClassShop.Reroll), so it works in the
	  Run place too if the receipt arrives there.
	* Prompt(player, name) opens Roblox's purchase prompt; Granted(player, name) fires after a grant
	  is saved (the lobby's Class Shop tells the buyer), once per receipt.

	Dev (Studio): purchase.test <Product> runs the grant with a made-up receipt, as a real purchase
	would; products lists them.
]]

local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local ClassShop = require(Shared.Rules.ClassShop)
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("PurchaseService")

local PurchaseService = {
	Name = "PurchaseService",
	Dependencies = { "ProfileService", "DevService" },
	Granted = Signal.new() :: Signal.Signal<Player, string>,
}

type Product = { Name: string, Id: () -> number?, Grant: (player: Player, data: any) -> () }

local profiles: any = nil
local rng = Random.new()

local PRODUCTS: { Product } = {
	{
		Name = "ClassShopReroll",
		Id = function(): number?
			return Config.Get("Tuning", "ClassShop").RerollProductId
		end,
		-- a paid reroll doesn't use up a free one
		Grant = function(_player: Player, data: any)
			local day = ClassShop.Day(os.time())
			ClassShop.Refresh(data.ClassShop, data.Classes, day, rng)
			local used = data.ClassShop.RerollsUsed
			ClassShop.Reroll(data.ClassShop, data.Classes, day, rng)
			data.ClassShop.RerollsUsed = used
			ClassShop.Settle(data, day) -- the trial moved with the new classes
		end,
	},
}

local function find(name: string): Product?
	for _, product in PRODUCTS do
		if product.Name == name then
			return product
		end
	end
	return nil
end

local function byId(productId: number): Product?
	for _, product in PRODUCTS do
		if product.Id() == productId then
			return product
		end
	end
	return nil
end

local function grant(player: Player, product: Product, receiptId: string): Enum.ProductPurchaseDecision
	local fresh = false
	local decision = profiles:GrantPurchase(player, receiptId, function(data: any)
		fresh = true -- runs once per receipt: a repeated receipt is confirmed, never granted again
		product.Grant(player, data)
	end)
	if decision == Enum.ProductPurchaseDecision.PurchaseGranted then
		log:Info("%s: %s %s (receipt %s)", player.Name, product.Name, if fresh then "granted" else "confirmed again, not granted twice", receiptId)
		if fresh then
			PurchaseService.Granted:Fire(player, product.Name)
		end
	else
		log:Warn("%s: %s not granted yet (receipt %s)", player.Name, product.Name, receiptId)
	end
	return decision
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox asks again when they are next in a server
	end
	local product = byId(info.ProductId)
	if not product then
		log:Warn("a receipt for product %s, which isn't in the list", tostring(info.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return grant(player, product, tostring(info.PurchaseId))
end

-- The product's id, or nil while it doesn't exist yet.
function PurchaseService:ProductId(name: string): number?
	local product = find(name)
	return if product then product.Id() else nil
end

-- Opens Roblox's purchase prompt for the product. (ok, why?)
function PurchaseService:Prompt(player: Player, name: string): (boolean, string?)
	local id = PurchaseService:ProductId(name)
	if not id then
		return false, "THAT ISN'T ON SALE YET"
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, id)
	end)
	return ok, if ok then nil else string.upper(tostring(err))
end

function PurchaseService:Init(registry)
	profiles = registry.ProfileService
	local dev = registry.DevService
	dev:Register("products", {
		Description = "The developer products the game knows and their ids.",
		Run = function(): string?
			local lines = {}
			for _, product in PRODUCTS do
				table.insert(lines, `{product.Name}: {tostring(product.Id() or "no id yet")}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("purchase.test", {
		Description = "Grant a product as a real purchase would, with a made-up receipt (Studio only).",
		Usage = "purchase.test <Product> [receiptId]",
		Run = function(player: Player?, args): string?
			if not RunService:IsStudio() then
				return "Studio only"
			end
			local buyer = player or Players:GetPlayers()[1]
			local product = find(tostring(args[1] or ""))
			if not buyer or not product then
				return "usage: purchase.test <Product> [receiptId] (see products)"
			end
			local receipt = if args[2] then tostring(args[2]) else `DEV-{HttpService:GenerateGUID(false)}`
			local decision = grant(buyer, product, receipt)
			return `{product.Name} for {buyer.Name}: {decision.Name} (receipt {receipt})`
		end,
	})
end

function PurchaseService:Start()
	MarketplaceService.ProcessReceipt = processReceipt
end

return PurchaseService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000010C"><Properties><string name="Name">ReplicationService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ReplicationService: the server end of the delta channel (bible Section 23: collections
	such as rooms, residents and votes go through one delta channel; small values replicate
	as attributes instead).

	A system keeps its replicated state in collections:

		local Rooms = ReplicationService:Collection("Rooms")
		Rooms:Set("R12", { Kind = "Kitchen", Level = 1, Cell = { 2, 3 } })
		Rooms:Patch("R12", { Level = 2 })          -- only Level travels
		Rooms:Remove("R12")

	Changes are batched and flushed Constants.DELTA_HZ times a second to every ready player
	(SessionService); a player who becomes ready first gets a snapshot. Values must be
	remote-safe (Utilities.Delta.IsRemoteSafe); they are copied and frozen when set, so later
	edits to the caller's table can't leak into replicated state.

	A collection can be per-player with `Visible = function(player, key) -> boolean`
	(an inventory only its owner sees). Clients read collections through ReplicaController.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Constants = require(Shared.Constants)
local Delta = require(Shared.Utilities.Delta)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local TableUtil = require(Shared.Utilities.TableUtil)

local log = Log.new("ReplicationService")
local IS_STUDIO = RunService:IsStudio()

export type CollectionOptions = {
	Visible: ((player: Player, key: string) -> boolean)?,
}

export type Collection = {
	Name: string,
	Set: (self: Collection, key: string, value: any) -> (),
	Patch: (self: Collection, key: string, fields: { [string]: any }) -> (),
	Remove: (self: Collection, key: string) -> (),
	Clear: (self: Collection) -> (),
	Get: (self: Collection, key: string) -> any,
	All: (self: Collection) -> { [string]: any },
	Count: (self: Collection) -> number,
}

type State = {
	Name: string,
	Values: { [string]: any },
	Visible: ((player: Player, key: string) -> boolean)?,
}

local ReplicationService = {
	Name = "ReplicationService",
	Dependencies = { "SessionService", "DevService" },
}

local states: { [string]: State } = {}
local collections: { [string]: Collection } = {}
local pending: { Delta.Op } = {}
local counters = { Flushes = 0, OpsQueued = 0, EventsSent = 0, Snapshots = 0 }
local sessions: any = nil

local function queue(op: Delta.Op)
	table.insert(pending, op)
	counters.OpsQueued += 1
end

local function assertKey(state: State, key: any)
	if type(key) ~= "string" or key == "" then
		error(`{state.Name}: keys must be non-empty strings, got {tostring(key)}`, 3)
	end
end

local function assertSafe(state: State, key: string, value: any)
	local ok, why = Delta.IsRemoteSafe(value)
	if not ok then
		local message = `{state.Name}.{key} can't replicate: {why}`
		if IS_STUDIO then
			error(message, 3)
		end
		log:Error("%s", message)
	end
end

local CollectionClass = {}
CollectionClass.__index = CollectionClass

function CollectionClass.Set(self: any, key: string, value: any)
	local state: State = self._state
	assertKey(state, key)
	if value == nil then
		CollectionClass.Remove(self, key)
		return
	end
	assertSafe(state, key, value)
	if TableUtil.DeepEqual(state.Values[key], value) then
		return
	end
	local frozen = TableUtil.DeepFreeze(TableUtil.DeepCopy(value))
	state.Values[key] = frozen
	queue({ Delta.SET, state.Name, key, frozen })
end

function CollectionClass.Patch(self: any, key: string, fields: { [string]: any })
	local state: State = self._state
	assertKey(state, key)
	local old = state.Values[key]
	if type(old) ~= "table" then
		error(`{state.Name}.{key}: Patch needs an existing table value (use Set first)`, 2)
	end
	assertSafe(state, key, fields)
	local merged = Delta.Merge(old, TableUtil.DeepCopy(fields))
	local diff = Delta.Diff(old, merged)
	if not diff then
		return
	end
	state.Values[key] = TableUtil.DeepFreeze(merged)
	queue({ Delta.PATCH, state.Name, key, TableUtil.DeepFreeze(diff) })
end

function CollectionClass.Remove(self: any, key: string)
	local state: State = self._state
	assertKey(state, key)
	if state.Values[key] == nil then
		return
	end
	state.Values[key] = nil
	queue({ Delta.REMOVE, state.Name, key })
end

function CollectionClass.Clear(self: any)
	local state: State = self._state
	if next(state.Values) == nil then
		return
	end
	table.clear(state.Values)
	queue({ Delta.CLEAR, state.Name })
end

function CollectionClass.Get(self: any, key: string): any
	return self._state.Values[key]
end

-- A shallow copy of the whole collection (the values themselves are frozen).
function CollectionClass.All(self: any): { [string]: any }
	return table.clone(self._state.Values)
end

function CollectionClass.Count(self: any): number
	return TableUtil.Count(self._state.Values)
end

-- The named collection, created on first use. Options only apply when it's created.
function ReplicationService:Collection(name: string, options: CollectionOptions?): Collection
	assert(type(name) == "string" and string.find(name, "^[%a_][%w_]*$"), "Collection names are identifiers")
	local existing = collections[name]
	if existing then
		if options and options.Visible ~= states[name].Visible then
			error(`Collection {name} already exists with other options`, 2)
		end
		return existing
	end
	local state: State = { Name = name, Values = {}, Visible = options and options.Visible }
	states[name] = state
	local collection: Collection = setmetatable({ Name = name, _state = state }, CollectionClass) :: any
	collections[name] = collection
	return collection
end

local function visibleOps(player: Player, ops: { Delta.Op }): { Delta.Op }
	local list = {}
	for _, op in ops do
		local state = states[op[2]]
		local visible = state and state.Visible
		if visible == nil or op[1] == Delta.CLEAR then
			table.insert(list, op)
		else
			local ok, result = pcall(visible, player, op[3])
			if ok and result then
				table.insert(list, op)
			elseif not ok then
				log:Error("%s.Visible failed: %s", op[2], tostring(result))
			end
		end
	end
	return list
end

local function snapshotFor(player: Player): { Delta.Op }
	local ops: { Delta.Op } = {}
	for _, name in TableUtil.SortedKeys(states) do
		local state = states[name]
		for key, value in state.Values do
			table.insert(ops, { Delta.SET, name, key, value })
		end
	end
	return visibleOps(player, ops)
end

local function flush()
	if #pending == 0 then
		return
	end
	local ops = pending
	pending = {}
	counters.Flushes += 1
	local players = sessions:ReadyPlayers()
	if #players == 0 then
		return
	end
	local anyPerPlayer = false
	for _, op in ops do
		local state = states[op[2]]
		if state and state.Visible then
			anyPerPlayer = true
			break
		end
	end
	if not anyPerPlayer then
		Remotes.FireClients("Delta", players, ops, false)
		counters.EventsSent += #players
		return
	end
	for _, player in players do
		local list = visibleOps(player, ops)
		if #list > 0 then
			Remotes.FireClient("Delta", player, list, false)
			counters.EventsSent += 1
		end
	end
end

function ReplicationService:Init(registry)
	sessions = registry.SessionService
	local dev = registry.DevService

	dev:Register("rep", {
		Description = "Delta channel: collections, sizes and traffic.",
		Run = function(_player: Player?, _args: { any }): string?
			local lines = {
				("flushes %d, ops queued %d, events sent %d, snapshots %d, pending %d"):format(
					counters.Flushes,
					counters.OpsQueued,
					counters.EventsSent,
					counters.Snapshots,
					#pending
				),
			}
			for _, name in TableUtil.SortedKeys(states) do
				local state = states[name]
				local scope = if state.Visible then " (per player)" else ""
				table.insert(lines, `  {name}: {TableUtil.Count(state.Values)} values{scope}`)
			end
			return table.concat(lines, "\n")
		end,
	})

	dev:Register("rep.selftest", {
		Description = "Runs set, patch and remove on the _SelfTest collection; compare with `/dev replica _SelfTest` on a client.",
		Run = function(_player: Player?, _args: { any }): string?
			local test = ReplicationService:Collection("_SelfTest")
			test:Clear()
			test:Set("Alpha", { Count = 1, Label = "first", Tags = { "a", "b" } })
			test:Patch("Alpha", { Count = 2, Label = Delta.NONE })
			test:Set("Beta", { Count = 10 })
			test:Remove("Beta")
			test:Set("Gamma", { Where = Vector3.new(1, 2, 3), Done = true })
			test:Set("Stamp", { At = workspace:GetServerTimeNow() })
			return "queued: Alpha {Count=2, Tags={a,b}}, Gamma {Where=1,2,3, Done=true}, Stamp; Beta removed"
		end,
	})
end

function ReplicationService:Start()
	sessions.PlayerReady:Connect(function(player: Player)
		local ops = snapshotFor(player)
		Remotes.FireClient("Delta", player, ops, true)
		counters.Snapshots += 1
		log:Debug("snapshot to %s: %d values", player.Name, #ops)
	end)
	local interval = 1 / Constants.DELTA_HZ
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt: number)
		elapsed += dt
		if elapsed >= interval then
			elapsed = 0
			flush()
		end
	end)
end

-- Server-side view of a collection's values (for DevTools and tests).
function ReplicationService:Peek(name: string): { [string]: any }?
	local state = states[name]
	return if state then table.clone(state.Values) else nil
end

return ReplicationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000010D"><Properties><string name="Name">RescueService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RescueService: trapped people and bringing them home (bible Sections 11 and 12; Run place,
	Prompt 16). Survivors are trapped in buildings on the surface; trapped miners in the Deep and
	the Lost Crews' members (Prompt 17) use the same rescue (Kind Survivor, Miner or Crew).

	* Trap(at, options) puts one in workspace.Rescues, pinned under a little rubble, with a Free
	  prompt (hold Tuning.Surface.FreeSeconds; Section 12: free them, hold interact).
	* Freed, they follow the player who freed them (their leader) FollowDistance behind, at
	  SurvivorWalkSpeed times the leader's RescuedFollowSpeed (Spelunker, Section 14). A leader who
	  is downed, gone, out of EscortRange or in another realm (the surface, or underground: the
	  bunker and the Deep are one) is replaced by the nearest standing player in range; with none
	  they wait where they are. A survivor left far behind on open ground is brought up to their
	  leader (no one is lost to a fence).
	* On the way they are CombatService combatants (Kind Survivor, team Survivors): monsters treat
	  them as residents (Section 12: protect them on the way). Their health is SurvivorHealth divided
	  by the leader's RescuedDamageTaken; killed, they are lost.
	* The elevator: SurfaceService moves a rider's followers with them (Followers).
	* Home (Section 12: each rescue becomes a resident, sometimes a Rare one): a follower in the bunker
	  joins it through ResidentService:Add(tier, level), their new body stepping out where they
	  stood. Joined(residentId, player?, kind, where) fires; SetArrival(kind, fn) adds what a kind
	  does after joining (Prompt 17: a Lost Crew home completes its objective).
	* Residents already in the run (Prompt 18: an expedition pinned down, Kind Expedition, Options
	  Resident): their prompt says what Options Action and Label give (HELP, their name), they follow
	  with their own health (Options Health), and home they don't join again: the kind's arrival
	  (SetArrival) brings that resident back, with the health the way home left them (HealthLeft)
	  where they stood (HomeAt). Joined doesn't fire for them.

	Dev: rescues, rescue.free <id>.
]]

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local Signal = require(Shared.Utilities.Signal)
local Surface = require(Shared.Rules.Surface)

local log = Log.new("RescueService")

local RescueService = {
	Name = "RescueService",
	Dependencies = { "SessionService", "CombatService", "ResidentService", "ResidentBrain", "RunDirector", "DisasterService", "DevService" },
	Freed = Signal.new() :: Signal.Signal<string, Player>,
	Joined = Signal.new() :: Signal.Signal<string, Player?, string, string>, -- resident id, leader, kind, where
	Lost = Signal.new() :: Signal.Signal<string, string>, -- rescue id, kind
}

local GROUP = "Residents" -- ResidentBrain's collision group: no bumping into players or monsters
local TICK = 0.25
local CATCH_UP = 40 -- studs behind on the same zone for a while: brought up to the leader
local REPLAN_SECONDS = 1.5

export type Options = {
	Kind: string?, -- "Survivor" (the surface), "Miner" (the Deep) or "Crew" (a Lost Crew's member; Prompt 17)
	Tier: string?, -- Common or Rare (rolled when nil)
	Level: number?,
	Where: string?, -- "the motel": for the alerts and the run's story
	Tag: string?,
	Resident: string?, -- a resident already in the run (Prompt 18: an expedition member), not a newcomer
	Health: number?, -- their health while following (default SurvivorHealth over the leader's RescuedDamageTaken)
	Label: string?, -- the prompt's object text (default the kind's)
	Action: string?, -- the prompt's action (default FREE)
}

type Rescue = {
	Id: string,
	Kind: string,
	Tier: string,
	Level: number,
	Where: string,
	Deep: boolean, -- freed in the Deep (Prompt 24: someone from the Deep may carry an outbreak's sickness)
	Tag: string?,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	State: "Trapped" | "Following" | "Waiting",
	Leader: Player?,
	CombatId: string?,
	Prompt: ProximityPrompt?,
	Rubble: BasePart?,
	BehindSince: number,
	Points: { PathWaypoint }, -- PathfindingService's way round walls and wrecks
	Index: number,
	PlannedAt: number,
	Pathing: boolean,
	Path: Path?,
	Resident: string?, -- Prompt 18
	Health: number?,
	HealthLeft: number?, -- home: what the way home left them
	HomeAt: CFrame?, -- home: where they stood
}

local combat: any = nil
local residents: any = nil
local brain: any = nil
local disasters: any = nil
local director: any = nil

local rescues: { [string]: Rescue } = {}
local arrivals: { [string]: (any, Player?, string) -> () } = {} -- kind -> after joining (rescue, leader, resident id)
-- what the prompt and the alerts call each kind
local KIND_TEXT: { [string]: { Trapped: string, Freed: string, Lost: string } } = {
	Survivor = { Trapped = "Trapped survivor", Freed = "YOU FREED A SURVIVOR: BRING THEM HOME TO THE BLAST DOOR", Lost = "A SURVIVOR DIDN'T MAKE IT" },
	Miner = { Trapped = "Trapped miner", Freed = "YOU FREED A TRAPPED MINER: BRING THEM BACK INTO THE BUNKER", Lost = "A RESCUED MINER DIDN'T MAKE IT" },
	Crew = { Trapped = "Steadfast work crew", Freed = "YOU FREED ONE OF THE LOST CREW: BRING THEM HOME", Lost = "WE LOST ONE OF THE LOST CREW" },
	Expedition = { Trapped = "Expedition", Freed = "YOU REACHED THEM: BRING THEM HOME TO THE BUNKER", Lost = "AN EXPEDITION MEMBER DIDN'T MAKE IT HOME" },
}

local function kindText(kind: string): { Trapped: string, Freed: string, Lost: string }
	return KIND_TEXT[kind] or KIND_TEXT.Survivor
end
local counter = 0
local rng = Random.new()

local function alertAll(kind: string, text: string)
	for _, player in Players:GetPlayers() do
		Remotes.FireClient("Alert", player, kind, text)
	end
end

local function folder(): Folder
	local f = workspace:FindFirstChild("Rescues")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Rescues"
		f.Parent = workspace
	end
	return f :: Folder
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function standing(player: Player): boolean
	return player.Parent == Players and player:GetAttribute("Life") == "Alive" and rootOf(player) ~= nil
end

local function classValue(player: Player?, key: string): number
	return Modifiers.PlayerValue(player, key) or 1 -- at the leader's class level (Prompt 20)
end

local function setActivity(r: Rescue, activity: string)
	if r.Model:GetAttribute("Activity") ~= activity then
		r.Model:SetAttribute("Activity", activity)
	end
end

local function makeBody(id: string): (Model?, Humanoid?, BasePart?)
	local assets = ServerStorage:FindFirstChild("Assets")
	local source = assets and assets:FindFirstChild("Residents") and assets.Residents:FindFirstChild("Resident_Common")
	if not source then
		log:Warn("no resident model (ServerStorage.Assets.Residents.Resident_Common)")
		return nil, nil, nil
	end
	local model = (source :: Model):Clone()
	model.Name = id
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or not root:IsA("BasePart") then
		model:Destroy()
		return nil, nil, nil
	end
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.MaxHealth = math.huge -- CombatService keeps their health
	humanoid.Health = math.huge
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	if not humanoid:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = humanoid
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = GROUP
			part.Anchored = false
			if part ~= root then
				part.CanCollide = false
			end
		end
	end
	return model, humanoid, root
end

local function makeRubble(at: CFrame, parent: Instance): BasePart
	local plank = Instance.new("Part")
	plank.Name = "Rubble"
	plank.Size = Vector3.new(5, 0.6, 1.2)
	plank.Color = Color3.fromRGB(110, 84, 60)
	plank.Material = Enum.Material.WoodPlanks
	plank.Anchored = true
	plank.CanCollide = false
	plank.CanQuery = false
	plank.CanTouch = false
	plank.CFrame = at * CFrame.new(0, 1.1, 0) * CFrame.Angles(0, math.rad(35), math.rad(12))
	plank.Parent = parent
	return plank
end

-- Trapping --------------------------------------------------------------------------------------

local function free(r: Rescue, player: Player)
	if r.State ~= "Trapped" or not standing(player) then
		return
	end
	if r.Prompt then
		r.Prompt:Destroy()
		r.Prompt = nil
	end
	if r.Rubble then
		r.Rubble:Destroy()
		r.Rubble = nil
	end
	r.Root.Anchored = false
	pcall(function()
		r.Root:SetNetworkOwner(nil)
	end)
	r.State = "Following"
	r.Leader = player
	r.BehindSince = 0
	local health = (r.Health or Surface.Tuning().SurvivorHealth) / math.max(classValue(player, "RescuedDamageTaken"), 0.1)
	r.CombatId = combat:Register(r.Model, { Kind = "Survivor", Team = "Survivors", Root = r.Root, Health = health, Id = r.Id })
	r.Model:SetAttribute("State", "Following")
	r.Model:SetAttribute("Leader", player.UserId)
	setActivity(r, "Walk")
	RescueService.Freed:Fire(r.Id, player)
	Remotes.FireClient("Alert", player, "Info", kindText(r.Kind).Freed)
	log:Info("%s freed %s (%s)", player.Name, r.Id, r.Where)
end

-- Puts a trapped person at a spot; returns their id.
function RescueService:Trap(at: CFrame, options: Options?): string?
	local o: Options = options or {}
	counter += 1
	local id = `S{counter}`
	local model, humanoid, root = makeBody(id)
	if not model or not humanoid or not root then
		return nil
	end
	local t = Surface.Tuning()
	local tier = o.Tier or Surface.SurvivorTier(rng:NextNumber())
	local level = o.Level or rng:NextInteger(t.SurvivorLevel.Min, t.SurvivorLevel.Max)
	model:PivotTo(at) -- the resident model's pivot is at its feet
	root.Anchored = true
	model:SetAttribute("RescueId", id)
	model:SetAttribute("RescueKind", o.Kind or "Survivor")
	model:SetAttribute("Tier", tier)
	model:SetAttribute("State", "Trapped")
	model:SetAttribute("Activity", "Downed")
	model.Parent = folder()
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "FreePrompt"
	prompt.ActionText = o.Action or "FREE"
	local label = o.Label or kindText(o.Kind or "Survivor").Trapped
	prompt.ObjectText = if tier == "Common" or o.Label then label else `{label} ({tier})`
	prompt.HoldDuration = t.FreeSeconds
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Kind", "Free")
	prompt.Parent = root
	local r: Rescue = {
		Id = id,
		Kind = o.Kind or "Survivor",
		Tier = tier,
		Level = level,
		Where = o.Where or "the ruins",
		Deep = Surface.Zone(root.Position) == "Deep",
		Tag = o.Tag,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		State = "Trapped",
		Leader = nil,
		CombatId = nil,
		Prompt = prompt,
		Rubble = makeRubble(at, model),
		BehindSince = 0,
		Points = {},
		Index = 1,
		PlannedAt = 0,
		Pathing = false,
		Path = nil,
		Resident = o.Resident,
		Health = o.Health,
		HealthLeft = nil,
		HomeAt = nil,
	}
	prompt.Triggered:Connect(function(player: Player)
		free(r, player)
	end)
	rescues[id] = r
	log:Info("%s trapped at %s (%s, %s level %d)", id, r.Where, r.Kind, tier, level)
	return id
end

function RescueService:Remove(id: string)
	local r = rescues[id]
	if not r then
		return
	end
	rescues[id] = nil
	if r.CombatId then
		combat:Unregister(r.CombatId)
	end
	if r.Rubble then
		r.Rubble:Destroy()
	end
	r.Model:Destroy()
end

function RescueService:Count(state: string?, kind: string?): number
	local n = 0
	for _, r in rescues do
		if (state == nil or r.State == state) and (kind == nil or r.Kind == kind) then
			n += 1
		end
	end
	return n
end

-- The spots taken by trapped people (SurfaceService doesn't put two on one spot).
function RescueService:Spots(): { Vector3 }
	local list = {}
	for _, r in rescues do
		if r.State == "Trapped" then
			table.insert(list, r.Root.Position)
		end
	end
	return list
end

-- The rescues following a player within range (they ride the elevator with them).
function RescueService:Followers(player: Player, range: number): { string }
	local root = rootOf(player)
	local list = {}
	if not root then
		return list
	end
	for id, r in rescues do
		if r.State ~= "Trapped" and r.Leader == player and (r.Root.Position - root.Position).Magnitude <= range then
			table.insert(list, id)
		end
	end
	return list
end

-- Moves a rescue (the elevator).
function RescueService:MoveTo(id: string, at: CFrame)
	local r = rescues[id]
	if r then
		r.Model:PivotTo(at)
		r.BehindSince = 0
	end
end

-- What a kind does after one of them joins the bunker: fn(rescue, leader, residentId).
function RescueService:SetArrival(kind: string, fn: ((any, Player?, string) -> ())?)
	arrivals[kind] = fn
end

-- The trapped and the rescued with a tag (a Lost Crew's members): { Id, State, Position }.
function RescueService:Tagged(tag: string): { { Id: string, State: string, Position: Vector3 } }
	local list = {}
	for id, r in rescues do
		if r.Tag == tag then
			table.insert(list, { Id = id, State = r.State, Position = r.Root.Position })
		end
	end
	return list
end

-- Home ------------------------------------------------------------------------------------------

local function arrive(r: Rescue)
	rescues[r.Id] = nil
	if r.CombatId then
		local c = combat:Get(r.CombatId)
		r.HealthLeft = if c then c.Health else nil
		combat:Unregister(r.CombatId)
	end
	local where = r.Root.CFrame
	local leader = r.Leader
	if r.Resident then
		-- someone already in the run (Prompt 18): their kind brings them back
		r.HomeAt = where
		r.Model:Destroy()
		log:Info("%s (%s) is home (%s)", r.Id, r.Resident, r.Where)
		local back = arrivals[r.Kind]
		if back then
			local ok, err = pcall(back, r, leader, r.Resident)
			if not ok then
				log:Warn("%s arrival: %s", r.Kind, tostring(err))
			end
		end
		return
	end
	local residentId = residents:Add(r.Tier, r.Level)
	local record = residents:Get(residentId)
	local name = if record then Residents.Name(record) else residentId
	local body = brain:Body(residentId)
	if body then
		body:PivotTo(where)
	end
	r.Model:Destroy()
	alertAll("Info", `{string.upper(name)}{if r.Tier ~= "Common" then ` ({string.upper(r.Tier)})` else ""} JOINS THE BUNKER`
		.. (if leader then `: RESCUED BY {string.upper(leader.DisplayName)}` else ""))
	RescueService.Joined:Fire(residentId, leader, r.Kind, r.Where)
	if r.Deep then
		disasters:FromTheDeep(residentId, r.Kind) -- Section 10: outbreaks come from the Deep (Prompt 24)
	end
	log:Info("%s joined as %s (%s, %s)", r.Id, residentId, r.Tier, r.Where)
	local after = arrivals[r.Kind]
	if after then
		local ok, err = pcall(after, r, leader, residentId)
		if not ok then
			log:Warn("%s arrival: %s", r.Kind, tostring(err))
		end
	end
end

local function lose(r: Rescue)
	if rescues[r.Id] ~= r then
		return
	end
	rescues[r.Id] = nil
	if r.Rubble then
		r.Rubble:Destroy()
	end
	alertAll("Danger", kindText(r.Kind).Lost)
	RescueService.Lost:Fire(r.Id, r.Kind)
	log:Info("%s was lost", r.Id)
end

-- Following -------------------------------------------------------------------------------------

local function nearestStanding(position: Vector3, range: number): Player?
	local best, bestDistance = nil, range
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root and standing(player) and Surface.SameRealm(root.Position, position) then
			local d = (root.Position - position).Magnitude
			if d <= bestDistance then
				best, bestDistance = player, d
			end
		end
	end
	return best
end

-- A path round the walls (Section 23: PathfindingService off the bunker's room graph), planned off
-- the loop's thread; until it arrives they head straight for their leader.
local function plan(r: Rescue, goal: Vector3)
	if r.Pathing then
		return
	end
	r.Pathing = true
	r.PlannedAt = os.clock()
	task.spawn(function()
		local path = r.Path or PathfindingService:CreatePath({ AgentRadius = 1.6, AgentHeight = 5.5, AgentCanJump = true, WaypointSpacing = 6 })
		r.Path = path
		local ok = pcall(function()
			(path :: Path):ComputeAsync(r.Root.Position, goal)
		end)
		r.Pathing = false
		if rescues[r.Id] ~= r then
			return
		end
		local points: { PathWaypoint } = {}
		if ok and (path :: Path).Status == Enum.PathStatus.Success then
			points = (path :: Path):GetWaypoints()
			table.remove(points, 1)
		end
		r.Points = points
		r.Index = 1
	end)
end

local function follow(r: Rescue)
	local t = Surface.Tuning()
	local position = r.Root.Position
	if Surface.Zone(position) == "Bunker" then
		arrive(r)
		return
	end
	local leader = r.Leader
	local leaderRoot = leader and rootOf(leader)
	if not leader or not leaderRoot or not standing(leader) or (leaderRoot.Position - position).Magnitude > t.EscortRange * 2
		or not Surface.SameRealm(leaderRoot.Position, position) then
		local other = nearestStanding(position, t.EscortRange)
		if other ~= leader then
			r.Leader = other
			r.Model:SetAttribute("Leader", if other then other.UserId else nil)
		end
		leader = other
		leaderRoot = if other then rootOf(other) else nil
	end
	if not leader or not leaderRoot then
		r.State = "Waiting"
		r.Model:SetAttribute("State", "Waiting")
		r.Humanoid:MoveTo(position)
		setActivity(r, "Idle")
		return
	end
	r.State = "Following"
	r.Model:SetAttribute("State", "Following")
	r.Humanoid.WalkSpeed = t.SurvivorWalkSpeed * classValue(leader, "RescuedFollowSpeed")
	local offset = position - leaderRoot.Position
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local distance = flat.Magnitude
	if distance > CATCH_UP then
		if r.BehindSince == 0 then
			r.BehindSince = os.clock()
		elseif os.clock() - r.BehindSince > 4 then
			-- left far behind: brought up to their leader
			local back = leaderRoot.CFrame * CFrame.new(rng:NextNumber(-2, 2), -3, t.FollowDistance) -- feet, not the root's height
			r.Model:PivotTo(back)
			r.BehindSince = 0
			return
		end
	else
		r.BehindSince = 0
	end
	if distance > t.FollowDistance then
		local spot = leaderRoot.Position + flat.Unit * t.FollowDistance
		if os.clock() - r.PlannedAt > REPLAN_SECONDS then
			plan(r, spot)
		end
		local waypoint = r.Points[r.Index]
		local point = if waypoint and distance > t.FollowDistance + 6 then waypoint.Position else spot
		if waypoint and (Vector3.new(point.X, 0, point.Z) - Vector3.new(position.X, 0, position.Z)).Magnitude < 2.5 then
			r.Index += 1
			local next_ = r.Points[r.Index]
			if next_ then
				point = next_.Position
				if next_.Action == Enum.PathWaypointAction.Jump then
					r.Humanoid.Jump = true
				end
			end
		end
		r.Humanoid:MoveTo(point)
		setActivity(r, "Walk")
	else
		r.Humanoid:MoveTo(position)
		setActivity(r, "Idle")
	end
end

local function loop()
	while true do
		task.wait(TICK)
		for _, r in rescues do
			if r.State ~= "Trapped" then
				local ok, err = pcall(follow, r)
				if not ok then
					log:Warn("%s: %s", r.Id, tostring(err))
				end
			end
		end
	end
end

local function clear()
	for id in table.clone(rescues) do
		RescueService:Remove(id)
	end
end

function RescueService:Init(registry)
	combat = registry.CombatService
	residents = registry.ResidentService
	brain = registry.ResidentBrain
	disasters = registry.DisasterService
	director = registry.RunDirector
	registry.DevService:Register("rescues", {
		Description = "Trapped and rescued people (Prompt 16).",
		Usage = "rescues",
		Run = function(): string?
			local lines = {}
			for id, r in rescues do
				table.insert(lines, `{id} {r.Kind} {r.Tier} L{r.Level} {r.State} at {r.Where}{if r.Leader then ` following {r.Leader.Name}` else ""}`)
			end
			table.sort(lines)
			return if #lines > 0 then table.concat(lines, "\n") else "nobody trapped or on the way"
		end,
	})
	registry.DevService:Register("rescue.free", {
		Description = "Free a trapped person as you (they follow you).",
		Usage = "rescue.free <id>",
		Run = function(player, args): string?
			local r = rescues[tostring(args[1] or "")]
			local p = player or Players:GetPlayers()[1]
			if not r or not p then
				return "rescue.free <id>"
			end
			free(r, p)
			return `{r.Id}: {r.State}`
		end,
	})
end

function RescueService:Start()
	folder()
	combat.Died:Connect(function(id: string)
		local r = rescues[id]
		if r and r.CombatId == id then
			lose(r)
		end
	end)
	director.RunEnded:Connect(clear)
	task.spawn(loop)
end

return RescueService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000010E"><Properties><string name="Name">ResidentBrain</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ResidentBrain: residents' routines and behaviour states in the world, phase 1 (bible Sections
	11 and 23). Run place only.

	Every resident in ResidentService has a body: a clone of ServerStorage.Assets.Residents
	.Resident_Common (the A0 resident; A3 brings the full kit) in workspace.Bunker.Residents,
	named by the resident's id, with ResidentId and Activity attributes. NPCAnimator (client)
	plays clips from Activity (Section 23).

	The routine, worked out 5 times a second (Section 11: work a shift, eat at the Kitchen, rest
	in Quarters; Tuning.Residents, provisional):
	* the first MealSeconds of each day: a seat at a Kitchen (standing room when the seats run out);
	* the rest of the day: a work spot in their job's room (WorkSpot1, 2... in the order they
	  joined it); with no job, their bed;
	* the Surge: their bed in the Quarters (Bed1, 2... by arrival; no bed: standing in the Quarters).
	* idle during the day: a seat in the Lounge when there is one (Section 11: socialise in the
	  Lounge; Landon, Nov 8, 2026), or by their bed.
	* sick with no job (Prompt 24): in their Quarters bed all day, which is quarantine;
	* Down: lying where they fell with a Revive prompt (a Medkit from the stockpile); dead: gone.
	* Away (Prompt 18; Section 12: expeditions leave the map): they walk to the Blast Door and are
	  gone (after Tuning.Expeditions.LeaveSeconds at the latest); no body while they are away.
	  Home again, a body steps in wherever ExpeditionService puts it.
	* Danger (Prompt 12; Section 11: in danger the unarmed flee to the nearest safe room, and
	  they handle a single Burrow Tick themselves): a monster in their room, or within
	  ResidentFleeRadius on their floor, sends them to the nearest room with no monster in or
	  next to it, until ResidentCalmSeconds pass with none near. A lone Burrow Tick they swat
	  (ResidentSwatDamage every ResidentSwatSeconds). Spitter goo slows them (SlowedUntil).
	* Disasters (Prompt 13; Section 11: residents caught in a disaster fight it if they can, and
	  handle a small fire in their own room): a resident in a burning room beats the fire down
	  (Activity Extinguish; DisasterService counts them) until their health falls below
	  Tuning.Disasters.Fire.ResidentFleeHealth, then flees to a room with no fire and no monster,
	  and keeps out of burning rooms while that hurt. Cave-in rubble (Lib.Hazards) blocks
	  passages: routes go around it, and a resident with no way round is Trapped (they wait
	  where they are; ResidentService takes them off their crew) until it is cleared. When
	  rubble falls or is cleared, everyone plans their way again.
	They walk the room graph (Lib.PathGraph: doorways, Shaft stairs) with Humanoid:MoveTo, at a
	speed from their Speed stat. A resident stuck for STUCK_SECONDS steps to their next waypoint.
	Residents pass through each other and through players (collision groups).

	* Rally (Prompt 20; Section 14's Rally Call, Section 11: armed residents answer rally calls):
	  Rally(ids, leader, seconds, bonus, instant?) sends residents to a player for `seconds`: they
	  walk to them (instant: they are there at once, the Security's level 3) and fight any monster
	  within Tuning.Classes.RallyReach beside them, with their weapon's melee damage (or a swat),
	  times `bonus` (RallyBonus, read by ClassService's damage filter). A rally ends early when the
	  leader falls or leaves the bunker. It comes before fleeing: rallied, they stand their ground.

	API:
		ResidentBrain:Body(id): Model?
		ResidentBrain:Activity(id): string?
		ResidentBrain:Rally(ids, leader, seconds, bonus, instant?): number
		ResidentBrain:RallyBonus(id): number
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Disasters = require(Shared.Rules.Disasters)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)
local Hazards = require(ServerScriptService.Lib.Hazards)
local PathGraph = require(ServerScriptService.Lib.PathGraph)

local log = Log.new("ResidentBrain")

local ResidentBrain = {
	Name = "ResidentBrain",
	Dependencies = { "ResidentService", "BunkerGrid", "CycleClock", "CombatService", "EconomyService", "DevService" },
}

local TICK = 0.2 -- 5 Hz (Section 23)
local ARRIVE = 2 -- studs
local STUCK_SECONDS = 2.5
local RESIDENT_GROUP, PLAYER_GROUP = "Residents", "Players"

type Body = {
	Id: string,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Goal: string?, -- what it is heading for: "Work:R4:WorkSpot2"
	GoalActivity: string,
	Points: { Vector3 },
	Index: number,
	Best: number, -- closest it has come to the current waypoint
	Since: number, -- when it last got closer
	Lying: boolean,
	Prompt: ProximityPrompt?,
	Trapped: boolean, -- rubble cuts them off from their goal (Prompt 13)
	HazardVersion: number, -- Lib.Hazards' version when the goal was planned
	LeaveSince: number?, -- when they set out through the Blast Door (Prompt 18)
}

local residents: any = nil
local grid: any = nil
local clock: any = nil
local combat: any = nil
local economy: any = nil
local DRY_ALERT_SECONDS = 30 -- how often the "guns are empty" alert may show
local dryAt = -math.huge
local fleeing: { [string]: { Until: number, Room: string? } } = {}
local rallies: { [string]: { Until: number, Leader: Player, Bonus: number } } = {} -- Prompt 20
local swattedAt: { [string]: number } = {}
local bodies: { [string]: Body } = {}
local folder: Folder? = nil
local dayStartedAt = os.clock()

local function bodiesFolder(): Folder?
	if folder and folder.Parent then
		return folder
	end
	local root = grid:Root()
	if not root then
		return nil
	end
	local found = root:FindFirstChild("Residents")
	if not found then
		found = Instance.new("Folder")
		found.Name = "Residents"
		found.Parent = root
	end
	folder = found :: Folder
	return folder
end

local function setActivity(body: Body, activity: string)
	if body.Model:GetAttribute("Activity") ~= activity then
		body.Model:SetAttribute("Activity", activity)
	end
end

local function lie(body: Body, at: CFrame?)
	if body.Lying then
		return
	end
	body.Lying = true
	body.Humanoid:MoveTo(body.Root.Position)
	local base = at or body.Root.CFrame
	body.Root.Anchored = true
	-- on the back, a little above what they lie on
	body.Root.CFrame = CFrame.new(base.Position + Vector3.new(0, 1.2, 0)) * CFrame.Angles(-math.pi / 2, 0, 0)
end

local function standUp(body: Body)
	if not body.Lying then
		return
	end
	body.Lying = false
	local position = body.Root.Position
	body.Root.CFrame = CFrame.new(position + Vector3.new(0, 2, 0))
	body.Root.Anchored = false
end

local function speedFor(id: string): number
	local resident = residents:Get(id)
	local t = Config.Get("Tuning", "Residents")
	return t.WalkSpeedBase + (if resident then resident.Stats.Speed or 0 else 5) * t.WalkSpeedPerSpeed
end

local function slowedSpeed(body: any): number
	local floor, column = Grid.CellAt(body.Root.Position)
	local unit = if floor and column and grid then grid:Bunker():UnitAt(floor, column) else nil
	local base = speedFor(body.Id) * Disasters.WadeSpeed(Hazards.Flood(unit)) -- wading (Prompt 23)
	local slowed = body.Model:GetAttribute("SlowedUntil")
	if type(slowed) == "number" and slowed > workspace:GetServerTimeNow() then
		return base * Config.Get("Tuning", "MonsterAI").GooSlowMultiplier
	end
	return base
end

local function spawnBody(id: string): Body?
	local holder = bodiesFolder()
	local assets = ServerStorage:FindFirstChild("Assets")
	local source = assets and assets:FindFirstChild("Residents") and assets.Residents:FindFirstChild("Resident_Common")
	if not holder or not source then
		log:Warn("no resident model (ServerStorage.Assets.Residents.Resident_Common) or no bunker yet")
		return nil
	end
	local model = (source :: Model):Clone()
	model.Name = id
	model:SetAttribute("ResidentId", id)
	model:SetAttribute("Activity", "Idle")
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	if not humanoid or not root then
		model:Destroy()
		log:Warn("the resident model has no Humanoid or HumanoidRootPart")
		return nil
	end
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.WalkSpeed = speedFor(id)
	if not humanoid:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = humanoid
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = RESIDENT_GROUP
			part.Anchored = false
			if part ~= root then
				part.CanCollide = false
			end
		end
	end
	-- start in their job room, or the Quarters, or the Medbay
	local resident = residents:Get(id)
	local room = (resident and resident.Job and grid:Room(resident.Job)) or grid:RoomsOfType("Quarters")[1]
		or grid:RoomsOfType("Medbay")[1]
	local start = if room then Grid.CellPosition(room.Floor, room.Column) else Vector3.zero
	model:PivotTo(CFrame.new(start + Vector3.new(0, 3, 8)))
	model.Parent = holder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local body: Body = {
		Id = id, Model = model, Humanoid = humanoid, Root = root, Goal = nil, GoalActivity = "Idle",
		Points = {}, Index = 1, Best = math.huge, Since = os.clock(), Lying = false, Prompt = nil,
		Trapped = false, HazardVersion = 0, LeaveSince = nil,
	}
	bodies[id] = body
	return body
end

-- Where a resident should be, and doing what -------------------------------------------------------

local function socketsOf(roomId: string, pattern: string): { CFrame }
	local model = grid:RoomModel(roomId)
	if not model then
		return {}
	end
	local found = BunkerKit.Sockets(model, pattern)
	local names = {}
	for name in found do
		table.insert(names, name)
	end
	table.sort(names, function(a: string, b: string): boolean
		return (tonumber(string.match(a, "%d+")) or 0) < (tonumber(string.match(b, "%d+")) or 0)
	end)
	local list = {}
	for _, name in names do
		table.insert(list, found[name])
	end
	return list
end

-- The n-th spot of a kind across every room of a type (seats in every Kitchen, beds in every
-- Quarters), or a place to stand in the first of those rooms when they run out.
local function spotAcross(roomType: string, pattern: string, n: number): (string?, CFrame?)
	local rooms = grid:RoomsOfType(roomType)
	table.sort(rooms, function(a, b)
		return a.Id < b.Id
	end)
	local i = n
	for _, room in rooms do
		local spots = socketsOf(room.Id, pattern)
		if i <= #spots then
			return room.Id, spots[i]
		end
		i -= #spots
	end
	local room = rooms[1]
	if room then
		local cell = Grid.CellPosition(room.Floor, room.Column + (n % room.Span))
		return room.Id, CFrame.new(cell + Vector3.new(((n * 3) % 12) - 6, 0, 4))
	end
	return nil, nil
end

-- Danger (Prompt 12) ---------------------------------------------------------------------------

local function unitAt(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

local function monstersNear(position: Vector3): { any }
	local t = Config.Get("Tuning", "MonsterAI")
	local near = {}
	local myUnit = unitAt(position)
	local myFloor = Grid.CellAt(position)
	for _, c in combat:All("Monsters") do
		local floor = Grid.CellAt(c.Root.Position)
		local sameUnit = myUnit ~= nil and unitAt(c.Root.Position) == myUnit
		if sameUnit or (floor == myFloor and (c.Root.Position - position).Magnitude <= t.ResidentFleeRadius) then
			table.insert(near, c)
		end
	end
	return near
end

-- The nearest room (by the room graph) with no monster in it or next to it; else any room with
-- none in it.
local function safeRoom(fromUnit: string?): string?
	if not fromUnit then
		return nil
	end
	local danger: { [string]: boolean } = {}
	for _, c in combat:All("Monsters") do
		local unit = unitAt(c.Root.Position)
		if unit then
			danger[unit] = true
		end
	end
	for unit in Hazards.Fires() do
		danger[unit] = true -- a burning room is no refuge (Prompt 13)
	end
	local d = Config.Get("Tuning", "Disasters")
	for unit, level in Hazards.Floods() do
		if level >= d.Flood.ResidentFleeLevel then
			danger[unit] = true -- nor one deep in water, or full of gas (Prompt 23)
		end
	end
	for unit, strength in Hazards.GasLeaks() do
		if strength >= d.Gas.ResidentFleeStrength then
			danger[unit] = true
		end
	end
	local bunker = grid:Bunker()
	local seen: { [string]: boolean } = { [fromUnit] = true }
	local queue = { fromUnit }
	local fallback: string? = nil
	local index = 1
	while index <= #queue do
		local unit = queue[index]
		index += 1
		local room = grid:Room(unit)
		if unit ~= fromUnit and room and room.Type ~= "Shaft" and not danger[unit] then
			local nextToDanger = false
			for _, other in bunker:Neighbors(unit) do
				if danger[other] then
					nextToDanger = true
				end
			end
			if not nextToDanger then
				return unit
			end
			fallback = fallback or unit
		end
		for _, other in Hazards.Neighbors(bunker, unit) do
			if not seen[other] then
				seen[other] = true
				table.insert(queue, other)
			end
		end
	end
	return fallback
end

local function danger(id: string): (string?, string?, CFrame?, string?)
	local body = bodies[id]
	if not body or not combat then
		return nil
	end
	local t = Config.Get("Tuning", "MonsterAI")
	local near = monstersNear(body.Root.Position)
	if #near == 1 and near[1].MonsterType == "BurrowTick" then
		fleeing[id] = nil
		return `Swat:{near[1].Id}`, nil, nil, "Fight"
	end
	-- Prompt 26 (Section 11: "armed and brave residents fight in their room and the rest flee"):
	-- whoever carries a weapon, or is Brave, takes on the nearest monster in the room they are in
	local person = residents:Get(id)
	if #near > 0 and person and (Residents.Armed(person) or Residents.Has(person, "DefendsUnarmed")) then
		local mine = unitAt(body.Root.Position)
		local best: any, bestDistance = nil, math.huge
		for _, c in near do
			local distance = (c.Root.Position - body.Root.Position).Magnitude
			if mine ~= nil and unitAt(c.Root.Position) == mine and distance < bestDistance then
				best, bestDistance = c, distance
			end
		end
		if best then
			fleeing[id] = nil
			return `RallyFight:{best.Id}`, nil, nil, "Fight"
		end
	end
	local flee = fleeing[id]
	if #near > 0 then
		local room = if flee then flee.Room else nil
		local current = if room then grid:Room(room) else nil
		if not current or #monstersNear(Grid.CellPosition(current.Floor, current.Column)) > 0 then
			room = safeRoom(unitAt(body.Root.Position))
		end
		flee = { Until = os.clock() + t.ResidentCalmSeconds, Room = room }
		fleeing[id] = flee
		-- they are Panicked while they run and for a while after (Config.Conditions.Panicked: no
		-- work); a Cool Head in their room calms them sooner, and the Brave and Cool Heads never are
		if person then
			local calmed = false
			if person.Job then
				for _, mate in residents:Workers(person.Job) do
					if mate.Id ~= id and Residents.Has(mate, "CalmsRoommates") then
						calmed = true
					end
				end
			end
			residents:Panic(id, t.ResidentCalmSeconds + Residents.PanicSeconds(person, calmed), "monsters")
		end
	end
	-- fire where they stand (Prompt 13): fight it while they can, else get out
	local here = unitAt(body.Root.Position)
	if #near == 0 and here and Hazards.Fire(here) then
		local resident = residents:Get(id)
		local f = Config.Get("Tuning", "Disasters").Fire
		local healthy = resident ~= nil and resident.Health >= resident.MaxHealth * f.ResidentFleeHealth
		if healthy and not (flee and os.clock() < flee.Until) then
			local room = grid:Room(here)
			if room then
				local n = tonumber(string.match(id, "%d+")) or 0
				local cell = Grid.CellPosition(room.Floor, room.Column + n % room.Span)
				local spot = CFrame.new(cell + Vector3.new(((n * 5) % 15) - 7, 0, 3))
				return `Extinguish:{here}`, here, spot, "Extinguish"
			end
		end
		if not flee or not flee.Room or Hazards.Fire(flee.Room) then
			flee = { Until = os.clock() + t.ResidentCalmSeconds, Room = safeRoom(here) }
			fleeing[id] = flee
		end
	end
	-- water rising or gas where they stand (Prompt 23): residents can't fix either, they get out
	if #near == 0 and here and not Hazards.Fire(here) then
		local d = Config.Get("Tuning", "Disasters")
		if Hazards.Unsafe(here, d.Flood.ResidentFleeLevel, d.Gas.ResidentFleeStrength, d.Radiation.ResidentFleeStrength) then
			if not flee or not flee.Room or Hazards.Unsafe(flee.Room, d.Flood.ResidentFleeLevel, d.Gas.ResidentFleeStrength, d.Radiation.ResidentFleeStrength) then
				flee = { Until = os.clock() + t.ResidentCalmSeconds, Room = safeRoom(here) }
				fleeing[id] = flee
			else
				flee.Until = math.max(flee.Until, os.clock() + 2)
			end
		end
	end
	if flee and os.clock() < flee.Until and flee.Room and grid:Room(flee.Room) then
		local room = grid:Room(flee.Room)
		local spot = CFrame.new(Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, 0, 4))
		return `Flee:{flee.Room}`, flee.Room, spot, "Flee"
	end
	fleeing[id] = nil
	return nil
end

local routine: (id: string, order: number, resident: any) -> (string, string?, CFrame?, string)

local function leaderRoot(player: Player): BasePart?
	if player.Parent ~= Players or player:GetAttribute("Life") ~= "Alive" then
		return nil
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

-- A rallied resident (Prompt 20): fight the nearest monster in reach beside the leader, else go to them.
local function rallyPlan(id: string, order: number): (string?, string?, CFrame?, string?)
	local rally = rallies[id]
	local body = bodies[id]
	if not rally or not body then
		return nil
	end
	local root = leaderRoot(rally.Leader)
	local unit = if root then unitAt(root.Position) else nil
	if os.clock() >= rally.Until or not root or not unit then
		rallies[id] = nil
		return nil
	end
	local reach = Config.Get("Tuning", "Classes").RallyReach
	local best, bestDistance = nil, reach * 2
	for _, c in combat:All("Monsters") do
		local d = (c.Root.Position - body.Root.Position).Magnitude - c.Reach
		if d <= bestDistance and (c.Root.Position - root.Position).Magnitude <= reach * 3 then
			best, bestDistance = c, d
		end
	end
	if best then
		return `RallyFight:{best.Id}`, nil, nil, "Fight"
	end
	local angle = order * 2.4
	local spot = CFrame.new(root.Position + Vector3.new(math.cos(angle) * 4, -2.5, math.sin(angle) * 2))
	return `Rally:{rally.Leader.UserId}:{unit}`, unit, spot, "Idle"
end

local function plan(id: string, order: number): (string, string?, CFrame?, string)
	local resident = residents:Get(id)
	if not resident then
		return "Gone", nil, nil, "Idle"
	end
	if resident.State == "Down" then
		return "Down", nil, nil, "Down"
	end
	if resident.State == "Away" then
		-- an expedition sets out (Prompt 18): to the Blast Door, then off the map
		local door = grid:RoomsOfType("BlastDoor")[1]
		local model = door and grid:RoomModel(door.Id)
		local socket = model and BunkerKit.Socket(model, "Door")
		if door and socket then
			return "Leave", door.Id, CFrame.new(socket.Position), "Walk"
		end
		return "Leave", nil, nil, "Walk"
	end
	-- held by a Lurker (Prompt 23; MonsterService sets Grabbed): they can't move until it lets go
	local held = bodies[id]
	if held and held.Model:GetAttribute("Grabbed") then
		return "Grabbed", nil, nil, "Flee"
	end
	local rallyGoal, rallyRoom, rallySpot, rallyActivity = rallyPlan(id, order)
	if rallyGoal then
		return rallyGoal, rallyRoom, rallySpot, rallyActivity :: string
	end
	local threatGoal, threatRoom, threatSpot, threatActivity = danger(id)
	if threatGoal then
		return threatGoal, threatRoom, threatSpot, threatActivity :: string
	end
	local goal, roomId, spot, activity = routine(id, order, resident)
	-- a room deep in water or full of gas (Prompt 23): they wait outside until it is safe
	if roomId and not Hazards.Fire(roomId) then
		local d = Config.Get("Tuning", "Disasters")
		if Hazards.Unsafe(roomId, d.Flood.ResidentFleeLevel, d.Gas.ResidentFleeStrength, d.Radiation.ResidentFleeStrength) then
			local body = bodies[id]
			local here = if body then unitAt(body.Root.Position) else nil
			if here ~= roomId then
				return "Wait:hazard", nil, nil, "Idle"
			end
		end
	end
	-- too hurt to fight a fire (Prompt 13): they keep out of burning rooms and wait where they are
	if roomId and Hazards.Fire(roomId) then
		local f = Config.Get("Tuning", "Disasters").Fire
		if resident.Health < resident.MaxHealth * f.ResidentFleeHealth then
			local body = bodies[id]
			local here = if body then unitAt(body.Root.Position) else nil
			if here ~= roomId then
				return "Wait:fire", nil, nil, "Idle"
			end
		end
	end
	return goal, roomId, spot, activity
end

routine = function(id: string, order: number, resident: any): (string, string?, CFrame?, string)
	local phase = clock:Phase()
	local mealSeconds = Config.Get("Tuning", "Residents").MealSeconds / math.max(clock:TimeScale(), 0.01)
	if phase == "Surge" or not clock:IsRunning() and phase == nil then
		local roomId, spot = spotAcross("Quarters", "^Bed%d+$", order)
		return `Sleep:{roomId}:{order}`, roomId, spot, "Sleep"
	end
	-- Quarantine (Prompt 24; Section 10: "quarantine in Quarters"): a sick resident with no job
	-- keeps to their bed, away from the Kitchen and the Lounge
	if resident.Sick and not resident.Job and #grid:RoomsOfType("Quarters") > 0 then
		local roomId, spot = spotAcross("Quarters", "^Bed%d+$", order)
		return `Quarantine:{roomId}:{order}`, roomId, spot, "Sleep"
	end
	if phase == "Day" and os.clock() - dayStartedAt < mealSeconds and #grid:RoomsOfType("Kitchen") > 0 then
		local roomId, spot = spotAcross("Kitchen", "^Seat%d+$", order)
		return `Eat:{roomId}:{order}`, roomId, spot, "Eat"
	end
	if resident.Job and grid:Room(resident.Job) then
		local workers = residents:Workers(resident.Job)
		local index = 1
		for i, worker in workers do
			if worker.Id == id then
				index = i
			end
		end
		local spots = socketsOf(resident.Job, "^WorkSpot%d+$")
		local room = grid:Room(resident.Job)
		local spot = spots[index] or spots[1]
			or CFrame.new(Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, 0, 4))
		return `Work:{resident.Job}:{index}`, resident.Job, spot, "Work"
	end
	if #grid:RoomsOfType("Lounge") > 0 then
		local roomId, spot = spotAcross("Lounge", "^Seat%d+$", order)
		return `Idle:{roomId}:{order}`, roomId, spot, "Idle"
	end
	local roomId, spot = spotAcross("Quarters", "^Bed%d+$", order)
	return `Idle:{roomId}:{order}`, roomId, spot, "Idle"
end

local function unitOf(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

local function setGoal(body: Body, goal: string, roomId: string?, spot: CFrame?, activity: string)
	body.HazardVersion = Hazards.Version()
	body.Goal = goal
	body.GoalActivity = activity
	body.Points = {}
	body.Index = 1
	body.Best = math.huge
	body.Since = os.clock()
	if not roomId or not spot then
		return
	end
	standUp(body)
	local from = unitOf(body.Root.Position)
	local to = unitOf(spot.Position + Vector3.new(0, 1, 0)) or roomId
	local points, why = nil, nil
	if from then
		points, why = PathGraph.Waypoints(grid:Bunker(), function(unit: string): Model?
			return grid:RoomModel(unit)
		end, body.Root.Position, from, to, spot.Position)
	end
	if why == "Blocked" then
		-- cave-in rubble cuts them off (Prompt 13): they wait where they are until it's cleared
		body.Points = {}
		body.GoalActivity = "Idle"
		body.Humanoid:MoveTo(body.Root.Position)
		setActivity(body, "Idle")
		if not body.Trapped then
			body.Trapped = true
			residents:SetTrapped(body.Id, true)
		end
		return
	end
	if body.Trapped then
		body.Trapped = false
		residents:SetTrapped(body.Id, false)
	end
	body.Points = points or { spot.Position }
	setActivity(body, "Walk")
end

local function revivePrompt(body: Body, on: boolean)
	if on and not body.Prompt then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Revive (1 Medkit)"
		local resident = residents:Get(body.Id)
		prompt.ObjectText = if resident then Residents.Name(resident) else "Resident"
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 8
		prompt.RequiresLineOfSight = false
		prompt.Style = Enum.ProximityPromptStyle.Custom -- drawn by PromptController (Prompt 11)
		prompt:SetAttribute("Kind", "ReviveResident")
		prompt.Triggered:Connect(function(player: Player)
			local ok, why = residents:Revive(body.Id, player)
			if not ok and why then
				Remotes.FireClient("Alert", player, "Warning", why)
			end
		end)
		prompt.Parent = body.Root
		body.Prompt = prompt
	elseif not on and body.Prompt then
		body.Prompt:Destroy()
		body.Prompt = nil
	end
end

local function step(body: Body, order: number)
	local goal, roomId, spot, activity = plan(body.Id, order)
	if goal == "Gone" then
		return
	end
	if goal == "Down" then
		if body.Goal ~= "Down" then
			body.Goal = "Down"
			body.Points = {}
			lie(body, nil)
			setActivity(body, "Down")
			revivePrompt(body, true)
		end
		return
	end
	if body.Goal == "Down" then
		revivePrompt(body, false)
		standUp(body)
	end
	if goal ~= body.Goal or body.HazardVersion ~= Hazards.Version() then
		if goal == "Leave" and body.Goal ~= "Leave" then
			body.LeaveSince = os.clock()
		end
		setGoal(body, goal, roomId, spot, activity)
	end
	if goal == "Leave" then
		-- off the map once they reach the door, or after LeaveSeconds whatever is in their way
		local arrived = body.Points[body.Index] == nil
		if arrived or os.clock() - (body.LeaveSince or os.clock()) > Config.Get("Tuning", "Expeditions").LeaveSeconds then
			bodies[body.Id] = nil
			local model = body.Model
			body.Humanoid:MoveTo(body.Root.Position)
			setActivity(body, "Idle")
			task.delay(0.4, function()
				model:Destroy()
			end)
			return
		end
	end
	local speed = slowedSpeed(body)
	if math.abs(body.Humanoid.WalkSpeed - speed) > 0.05 then
		body.Humanoid.WalkSpeed = speed
	end
	if string.sub(goal, 1, 11) == "RallyFight:" then
		-- rallied (Prompt 20): fight it beside the leader, with the weapon they carry
		local monster = combat:Get(string.sub(goal, 12))
		if monster and monster.State == "Alive" then
			local t = Config.Get("Tuning", "MonsterAI")
			local reach = Config.Get("Tuning", "Classes").RallyReach
			local flat = Vector3.new(monster.Root.Position.X, body.Root.Position.Y, monster.Root.Position.Z)
			if (flat - body.Root.Position).Magnitude > math.max(reach - 2, 3) + monster.Reach then
				body.Humanoid:MoveTo(flat)
			else
				body.Humanoid:MoveTo(body.Root.Position)
				if os.clock() - (swattedAt[body.Id] or 0) >= t.ResidentSwatSeconds then
					swattedAt[body.Id] = os.clock()
					local resident = residents:Get(body.Id)
					local held = resident and resident.Weapon and Config.Find("Items", (Residents.Piece(resident.Weapon)) or "")
					local damage = t.ResidentSwatDamage -- bare hands (the Brave)
					if held and held.Melee then
						damage = held.Melee.Damage
					elseif held and held.Gun and resident then
						-- Section 11: "using the shared Ammo pool". With none left they use their hands.
						if economy:Use("Ammo", held.Gun.AmmoPerShot or 1) then
							damage = held.Gun.Damage * (Residents.Trait(resident, "GunDamage") or 1) -- a Sharpshooter's
						elseif os.clock() - dryAt > DRY_ALERT_SECONDS then
							dryAt = os.clock()
							Remotes.FireAllClients("Alert", "Warning", "THE RESIDENTS' GUNS ARE EMPTY: THE STOCKPILE HAS NO AMMO")
						end
					end
					combat:Damage(monster.Id, damage, body.Id, "rallied")
				end
			end
			setActivity(body, "Fight")
		end
		return
	end
	if string.sub(goal, 1, 5) == "Swat:" then
		-- a lone Burrow Tick: stand and swat it (Section 11)
		local tickId = string.sub(goal, 6)
		local tick = combat:Get(tickId)
		if tick and tick.State == "Alive" then
			local t = Config.Get("Tuning", "MonsterAI")
			local flat = Vector3.new(tick.Root.Position.X, body.Root.Position.Y, tick.Root.Position.Z)
			if (flat - body.Root.Position).Magnitude > 4 then
				body.Humanoid:MoveTo(flat)
			else
				body.Humanoid:MoveTo(body.Root.Position)
				if os.clock() - (swattedAt[body.Id] or 0) >= t.ResidentSwatSeconds then
					swattedAt[body.Id] = os.clock()
					combat:Damage(tickId, t.ResidentSwatDamage, body.Id, "swatted")
				end
			end
			setActivity(body, "Fight")
		end
		return
	end
	local target = body.Points[body.Index]
	if not target then
		-- arrived: face the spot's way, and lie down in bed
		if body.Model:GetAttribute("Activity") ~= body.GoalActivity then
			setActivity(body, body.GoalActivity)
			if body.GoalActivity == "Sleep" and spot and string.match(goal, "^Sleep") then
				lie(body, spot)
			end
		end
		return
	end
	local root = body.Root
	local distance = (Vector3.new(target.X, 0, target.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
	if distance <= ARRIVE and math.abs(target.Y - (root.Position.Y - 3)) < 6 then
		body.Index += 1
		body.Best = math.huge
		body.Since = os.clock()
		local nextPoint = body.Points[body.Index]
		if nextPoint then
			body.Humanoid:MoveTo(nextPoint)
		else
			body.Humanoid:MoveTo(root.Position)
		end
		return
	end
	if distance < body.Best - 0.5 then
		body.Best = distance
		body.Since = os.clock()
	elseif os.clock() - body.Since > STUCK_SECONDS then
		-- stuck on furniture or a corner: step to the waypoint
		root.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
		body.Best = math.huge
		body.Since = os.clock()
	end
	body.Humanoid:MoveTo(target)
end

-- Lifecycle -----------------------------------------------------------------------------------------

-- The Warden's Rally Call (Prompt 20). Returns how many answer.
function ResidentBrain:Rally(ids: { string }, leader: Player, seconds: number, bonus: number, instant: boolean?): number
	local root = leaderRoot(leader)
	if not root or not unitAt(root.Position) then
		return 0
	end
	local n = 0
	for i, id in ids do
		local body = bodies[id]
		if body and not body.Lying then
			rallies[id] = { Until = os.clock() + seconds, Leader = leader, Bonus = bonus }
			fleeing[id] = nil
			if instant then
				local angle = i * 2.4
				body.Root.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(angle) * 4, 0, math.sin(angle) * 2))
				body.Goal = nil
			end
			n += 1
		end
	end
	return n
end

function ResidentBrain:RallyBonus(id: string): number
	local rally = rallies[id]
	return if rally and os.clock() < rally.Until then rally.Bonus else 1
end

function ResidentBrain:Body(id: string): Model?
	local body = bodies[id]
	return if body then body.Model else nil
end

function ResidentBrain:Activity(id: string): string?
	local body = bodies[id]
	return if body then body.Model:GetAttribute("Activity") :: string? else nil
end

local function sync()
	for _, resident in residents:All() do
		local body = bodies[resident.Id]
		if resident.State == "Dead" then
			if body then
				bodies[resident.Id] = nil
				local model = body.Model
				task.delay(2, function()
					model:Destroy()
				end)
			end
		elseif not body then
			if resident.State ~= "Away" then -- the away have no body (Prompt 18)
				spawnBody(resident.Id)
			end
		elseif body.Model.Parent == nil then
			bodies[resident.Id] = nil
		end
	end
end

local function groups()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(RESIDENT_GROUP)
		PhysicsService:RegisterCollisionGroup(PLAYER_GROUP)
	end)
	PhysicsService:CollisionGroupSetCollidable(RESIDENT_GROUP, RESIDENT_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(RESIDENT_GROUP, PLAYER_GROUP, false)
	local function character(model: Model)
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CollisionGroup = PLAYER_GROUP
			end
		end
		model.DescendantAdded:Connect(function(part: Instance)
			if part:IsA("BasePart") then
				part.CollisionGroup = PLAYER_GROUP
			end
		end)
	end
	local function player(p: Player)
		if p.Character then
			character(p.Character)
		end
		p.CharacterAdded:Connect(character)
	end
	for _, p in Players:GetPlayers() do
		player(p)
	end
	Players.PlayerAdded:Connect(player)
end

function ResidentBrain:Init(registry)
	residents = registry.ResidentService
	grid = registry.BunkerGrid
	clock = registry.CycleClock
	combat = registry.CombatService
	economy = registry.EconomyService
	registry.DevService:Register("brains", {
		Description = "Where every resident is going and what they are doing.",
		Usage = "brains",
		Run = function(): string?
			local lines = {}
			for id, body in bodies do
				table.insert(lines, string.format("%s %s -> %s (waypoint %d of %d), at %s", id,
					tostring(body.Model:GetAttribute("Activity")), tostring(body.Goal), body.Index, #body.Points,
					tostring(Vector3.new(math.floor(body.Root.Position.X), math.floor(body.Root.Position.Y), math.floor(body.Root.Position.Z)))))
			end
			table.sort(lines)
			return if #lines > 0 then table.concat(lines, "\n") else "no resident bodies"
		end,
	})
end

function ResidentBrain:Start()
	groups()
	clock.CycleStarted:Connect(function()
		dayStartedAt = os.clock()
	end)
	residents.Changed:Connect(function(id: string)
		local body = bodies[id]
		if body then
			body.Humanoid.WalkSpeed = speedFor(id)
		end
		sync()
	end)
	sync()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < TICK then
			return
		end
		acc = 0
		local order = 0
		for _, resident in residents:All() do
			local body = bodies[resident.Id]
			if body and resident.State ~= "Dead" then
				order += 1
				local ok, err = pcall(step, body, order)
				if not ok then
					log:Warn("%s: %s", resident.Id, tostring(err))
				end
			end
		end
	end)
	log:Info("%d resident bodies in the bunker", #residents:All())
end

return ResidentBrain
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000010F"><Properties><string name="Name">ResidentService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ResidentService: resident data, jobs, needs, morale, levels and death, phase 1 (bible Sections
	11 and 23). Run place only. The rules are Shared.Rules.Residents; walking and routines are
	ResidentBrain's.

	* The six founders (Tuning.StartingBunker: Common, levels 1 to 3) arrive idle when the run
	  starts (Landon, Nov 8, 2026): the players give them their jobs, and on a first run the
	  tutorial does (Prompt 31). Until someone works the Reactor Core the bunker is dark. When the
	  run starts, the team is told who is waiting for work.
	* Jobs: AssignResident (a room id, or "" for none) and AutoAssign come from players, with no
	  vote (Section 8). A room's crew goes to EconomyService (SetResidents), which works out
	  production and power. When a room goes, its workers move to the room standing in its cells
	  (a merge) if it has room, or go idle.
	* Every cycle, after the meal (EconomyService.Ate), each resident's needs move (Rules.Residents
	  .Cycle): rest with work and beds, the meal (the newest arrivals go hungry first when the
	  stockpile runs short; Landon, Nov 8, 2026), morale with job fit, dark job rooms and beds. Workers gain
	  XPPerWorkCycle; each level adds 1 to their job's stat. A staffed, lit Medbay heals the hurt.
	  Surviving a Surge gives everyone SurgeSurvivedMorale.
	* At 0 health a resident is down for DeathReviveSeconds: a player can revive them with a
	  Medkit from the stockpile (ReviveResident). Then they are gone for the run. When the last
	  one is gone, the run is lost (RunDirector, "ResidentsLost").
	* Trapped (Prompt 13): cave-in rubble cuts a resident off from where they need to be
	  (ResidentBrain says so). A trapped resident isn't in their room's crew until they are free.
	* Away (Prompt 18; Section 12: expeditions leave the map): ExpeditionService sends residents
	  out (SetAway). Away, they have no job, don't eat from the stockpile, don't work, rest or
	  lose morale in the bunker, and can't be hurt by anything in it; their expedition can wound
	  them (Wound: never below 1 health), teach them (GainXP), write in their log (Note) or lose
	  them (Lose: gone at once, no revive). Home again (SetAway off) they are Alive with no job.
	* Replication: the Residents collection, id -> { Name, First, Last, Age, Tier, Level, XP,
	  XPNext, Stats, Job, Health, MaxHealth, Rest, Morale, Mood, State, Hungry, Trapped, DownUntil,
	  Weapon, Sick, Irradiated, Quarantined }.
	* Conditions (Prompt 24): Sick (an Outbreak: contagious, works slowly, loses health each cycle
	  until the Medbay cures them; with no job they keep to a Quarters bed, which is quarantine) and
	  Irradiated (a radiation leak: loses health each cycle until a working Decon Room clears
	  them). DisasterService sets them (SetCondition); Section 11's other conditions are Prompt 26.
	* Classes (Prompt 20): experience is times the bunker's ResidentXP (the Warden); a level goes
	  into the stat a level 2 Warden picked (SetLevelStat), else their job's. Armed residents (a
	  Weapon; gear and how they get one are Prompt 26) answer the Warden's Rally Call.

	API:
		ResidentService:All(): { Resident }, :Get(id), :Workers(roomId)
		ResidentService:Assign(id, roomId?): (boolean, string?)
		ResidentService:AutoAssign(): number          -- residents given a job
		ResidentService:Hurt(id, amount, how), :Revive(id, player?): (boolean, string?)
		ResidentService:SetTrapped(id, on)              -- ResidentBrain (Prompt 13)
		ResidentService:Add(tier?, level?): string    -- a new resident (recruits, rescues; DevTools)
		ResidentService:Count(): number                -- residents in the run (not dead; the away too)
		ResidentService:SetAway(id, on, health?): (boolean, string?) -- an expedition sets out / comes home (Prompt 18)
		ResidentService:Wound(id, amount): number, :GainXP(id, xp), :Note(id, text), :Lose(id, how)
		ResidentService:AddLevels(n, why): number      -- every resident n levels up now (Prompt 19: Field Training)
		ResidentService:AddMorale(amount, why): number -- every resident's morale now (Prompt 19: Morale Broadcast)
		ResidentService:Heal(id, amount): number       -- Prompt 20: the Medic's touch, Triage Pulse, Hearty Meal
		ResidentService:SetModifier(source, "ResidentXP", value?) -- Prompt 20: the Warden's +20% experience
		ResidentService:SetLevelStat(stat?)            -- Prompt 20: a level 2 Warden picks the stat levels raise
		ResidentService:Arm(id, itemId?)               -- the weapon a resident carries (gear is Prompt 26; DevTools)
		ResidentService:SetCondition(id, "Sick" | "Irradiated", on, why?): boolean -- Prompt 24 (DisasterService)
		ResidentService:HasCondition(id, condition): boolean
		ResidentService.Changed: Signal<string>         -- a resident's data changed
		ResidentService.Assigned: Signal<string, string?> -- resident, room (first-run objective 1)
		ResidentService.Died: Signal<string, string>    -- resident, how
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("ResidentService")

type Resident = Residents.Resident

local ResidentService = {
	Name = "ResidentService",
	Dependencies = { "BunkerGrid", "EconomyService", "PowerService", "CycleClock", "RunDirector", "SessionService", "ReplicationService", "DevService" },
	Changed = Signal.new() :: Signal.Signal<string>,
	Assigned = Signal.new() :: Signal.Signal<string, string?>,
	Died = Signal.new() :: Signal.Signal<string, string>,
	Accident = Signal.new() :: Signal.Signal<string, string>, -- a Clumsy resident's: their id, their room's id (DisasterService)
}

local grid: any = nil
local economy: any = nil
local power: any = nil
local clock: any = nil
local director: any = nil
local session: any = nil
local collection: any = nil
local rng = Random.new()
local residents: { [string]: Resident } = {}
local count = 0
local usedNames: { [string]: boolean } = {}
local downUntil: { [string]: number } = {}
local downHow: { [string]: string } = {}
local jobCells: { [string]: { number } } = {} -- room id -> { floor, column } of the rooms people work in
local locker: { [string]: number } = {} -- the bunker's gear locker: piece key -> how many (Prompt 26)
local gearCollection: any = nil
local panicUntil: { [string]: number } = {} -- resident id -> os.clock() they calm down at

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function order(id: string): number
	return tonumber(string.match(id, "%d+")) or 0
end

local function sorted(): { Resident }
	local list = {}
	for _, resident in residents do
		table.insert(list, resident)
	end
	table.sort(list, function(a: Resident, b: Resident): boolean
		return order(a.Id) < order(b.Id)
	end)
	return list
end

local function logLine(resident: Resident, text: string)
	table.insert(resident.Log, `Year {RunState.Get("Year") or 1}: {text}`)
	if #resident.Log > 20 then
		table.remove(resident.Log, 1)
	end
end

local function publish(resident: Resident)
	local mood = Residents.MoraleState(resident.Morale)
	collection:Set(resident.Id, {
		Name = Residents.Name(resident),
		First = resident.First,
		Last = resident.Last,
		Age = resident.Age,
		Tier = resident.Tier,
		Level = resident.Level,
		XP = math.floor(resident.XP),
		XPNext = Residents.XPToLevel(resident.Level),
		Stats = table.clone(resident.Stats),
		Job = resident.Job,
		Health = math.floor(resident.Health + 0.5),
		MaxHealth = resident.MaxHealth,
		Rest = math.floor(resident.Rest + 0.5),
		Morale = math.floor(resident.Morale + 0.5),
		Mood = mood,
		State = resident.State,
		Hungry = resident.Hungry,
		Trapped = resident.Trapped == true,
		DownUntil = downUntil[resident.Id],
		Weapon = resident.Weapon,
		-- Phase 2 (Prompt 26)
		Traits = table.clone(resident.Traits or {}),
		Outfit = resident.Outfit,
		Tool = resident.Tool,
		Injured = resident.Injured == true or nil,
		Panicked = resident.Panicked == true or nil,
		Refusing = resident.Refusing == true or nil,
		Sick = resident.Sick == true or nil,
		Irradiated = resident.Irradiated == true or nil,
		Quarantined = Residents.Quarantined(resident) or nil,
		Log = table.clone(resident.Log),
	})
	ResidentService.Changed:Fire(resident.Id)
end

-- Classes (Prompt 20) -----------------------------------------------------------------------------

local xpModifiers: { [string]: number } = {} -- source -> ResidentXP multiplier
local levelStat: string? = nil -- a level 2 Warden's pick (Section 11)

local function xpMultiplier(): number
	local value = 1
	for _, v in xpModifiers do
		value *= v
	end
	return value
end

function ResidentService:SetModifier(source: string, key: string, value: number?)
	assert(key == "ResidentXP", `ResidentService:SetModifier: {key} isn't a resident modifier`)
	xpModifiers[source] = value
end

function ResidentService:SetLevelStat(stat: string?)
	assert(stat == nil or Config.Find("Stats", stat), `ResidentService:SetLevelStat: no stat {tostring(stat)}`)
	levelStat = stat
end

function ResidentService:LevelStat(): string?
	return levelStat
end

-- Health back (never past their max; nobody down or away). Returns what it gave.
function ResidentService:Heal(id: string, amount: number): number
	local resident = residents[id]
	if not resident or resident.State ~= "Alive" or amount <= 0 or resident.Health >= resident.MaxHealth then
		return 0
	end
	local before = resident.Health
	resident.Health = math.min(resident.MaxHealth, resident.Health + amount)
	if resident.Injured and Residents.Recovered(resident.Health, resident.MaxHealth) then
		resident.Injured = nil -- treated (Section 11: "works slowly until treated")
		logLine(resident, "was patched up")
		economy:RefreshCrew()
	end
	publish(resident)
	return resident.Health - before
end

-- Conditions (Prompt 24: Sick from an Outbreak, Irradiated from a radiation leak; the rest of
-- Section 11's conditions are Prompt 26). Returns true when it changed.
local CONDITIONS: { [string]: boolean } = { Sick = true, Irradiated = true, Injured = true, Panicked = true }
function ResidentService:SetCondition(id: string, condition: string, on: boolean, why: string?): boolean
	local resident = residents[id]
	if not resident or not CONDITIONS[condition] or resident.State == "Dead" then
		return false
	end
	local record = resident :: any
	if (record[condition] == true) == on then
		return false
	end
	record[condition] = if on then true else nil
	if condition == "Sick" then
		if on then
			resident.Morale = math.clamp(resident.Morale + Config.Get("Tuning", "Disasters").Outbreak.MoraleNow, 0, 100)
			logLine(resident, `fell sick{if why then ` ({why})` else ""}`)
		else
			logLine(resident, `got over the sickness{if why then ` ({why})` else ""}`)
		end
		economy:RefreshCrew() -- the sick work slowly
	elseif condition == "Injured" then
		logLine(resident, if on then `was injured{if why then ` ({why})` else ""}` else "was patched up")
		economy:RefreshCrew() -- the injured work slowly
	elseif condition == "Panicked" then
		if on then
			logLine(resident, `panicked{if why then ` ({why})` else ""}`)
		end
		economy:RefreshCrew() -- the panicked don't work
	elseif on then
		logLine(resident, `was caught in the radiation{if why then ` ({why})` else ""}`)
	end
	publish(resident)
	log:Info("%s %s %s (%s)", Residents.Name(resident), if on then "is" else "is no longer", condition, why or "-")
	return true
end

-- ResidentBrain: a resident is fleeing danger. They are Panicked (no work) until `seconds` after
-- the last call; the Brave and Cool Heads never are (seconds 0).
function ResidentService:Panic(id: string, seconds: number, why: string?)
	local resident = residents[id]
	if not resident or resident.State ~= "Alive" or seconds <= 0 then
		return
	end
	panicUntil[id] = os.clock() + seconds
	if not resident.Panicked then
		ResidentService:SetCondition(id, "Panicked", true, why)
	end
end

function ResidentService:HasCondition(id: string, condition: string): boolean
	local resident = residents[id]
	return resident ~= nil and (resident :: any)[condition] == true
end

-- The weapon a resident carries (nil: none), put there without the locker (DevTools, to try the
-- Warden's Rally Call). In play gear comes from the locker: Equip.
function ResidentService:Arm(id: string, itemId: string?): boolean
	local resident = residents[id]
	if not resident or (itemId ~= nil and not Config.Find("Items", itemId)) then
		return false
	end
	resident.Weapon = itemId
	publish(resident)
	return true
end

-- Gear (Prompt 26; Section 11: three slots, Weapon, Outfit and Tool) --------------------------------
-- Found gear goes in the bunker's gear locker (the Gear collection's "Locker": piece key -> count);
-- a player gives a resident a piece from it on the resident's card, and what they wore goes back.

local function publishLocker()
	gearCollection:Set("Locker", table.clone(locker))
end

function ResidentService:Locker(): { [string]: number }
	return table.clone(locker)
end

function ResidentService:AddGear(piece: string, count: number?): boolean
	local itemId = Residents.Piece(piece)
	if not itemId or not Residents.Slot(itemId) then
		return false
	end
	locker[piece] = (locker[piece] or 0) + math.max(1, math.floor(count or 1))
	publishLocker()
	return true
end

-- Gear found in the world (InventoryService's Gear special): `count` pieces into the locker.
function ResidentService:FindGear(finder: Player?, count: number): number
	local found = {}
	for _ = 1, count do
		local piece = Residents.RollGear(rng:NextNumber(), rng:NextNumber())
		ResidentService:AddGear(piece, 1)
		table.insert(found, string.upper(Residents.PieceName(piece)))
	end
	if #found > 0 then
		announce("Info", `{if finder then string.upper(finder.DisplayName) .. " FOUND GEAR" else "GEAR FOUND"}: {table.concat(found, ", ")} · IN THE GEAR LOCKER`)
		log:Info("gear found (%s): %s", if finder then finder.Name else "-", table.concat(found, ", "))
	end
	return #found
end

-- Puts a piece from the locker in a resident's slot (nil: takes the slot's piece off). What was in
-- the slot goes back in the locker.
function ResidentService:Equip(id: string, slot: string, piece: string?): (boolean, string?)
	local resident = residents[id]
	if not resident or resident.State == "Dead" then
		return false, "Nobody to give it to."
	end
	if slot ~= "Weapon" and slot ~= "Outfit" and slot ~= "Tool" then
		return false, "No such slot."
	end
	if piece == "" then
		piece = nil
	end
	if piece then
		local itemId = Residents.Piece(piece)
		if Residents.Slot(itemId) ~= slot then
			return false, "That doesn't go there."
		end
		if (locker[piece] or 0) <= 0 then
			return false, "None of those in the gear locker."
		end
	end
	local record = resident :: any
	local old = record[slot] :: string?
	if old == piece then
		return true, nil
	end
	if piece then
		locker[piece] -= 1
		if locker[piece] <= 0 then
			locker[piece] = nil
		end
	end
	if old then
		locker[old] = (locker[old] or 0) + 1
	end
	record[slot] = piece
	if slot == "Weapon" and piece then
		resident.Weapon = (Residents.Piece(piece)) -- a weapon is its item (WeaponService arms them by it)
	end
	local share = if resident.MaxHealth > 0 then resident.Health / resident.MaxHealth else 1
	resident.MaxHealth = Residents.MaxHealthOf(resident)
	resident.Health = math.min(resident.MaxHealth, math.max(if resident.Health > 0 then 1 else 0, math.floor(resident.MaxHealth * share + 0.5)))
	publishLocker()
	publish(resident)
	economy:RefreshCrew()
	log:Info("%s: %s %s", Residents.Name(resident), slot, if piece then Residents.PieceName(piece) else "off")
	return true, nil
end

-- Queries ------------------------------------------------------------------------------------------

function ResidentService:All(): { Resident }
	return sorted()
end

function ResidentService:Get(id: string): Resident?
	return residents[id]
end

function ResidentService:Workers(roomId: string): { Resident }
	local list = {}
	for _, resident in sorted() do
		if resident.Job == roomId and resident.State ~= "Dead" then
			table.insert(list, resident)
		end
	end
	return list
end

local function slotsFree(roomId: string, except: string?): number
	local room = grid:Room(roomId)
	if not room then
		return 0
	end
	local used = 0
	for _, resident in residents do
		if resident.Job == roomId and resident.State ~= "Dead" and resident.Id ~= except then
			used += 1
		end
	end
	return Residents.Slots(room.Type, room.Level, room.Span) - used
end

-- Jobs ---------------------------------------------------------------------------------------------

local function setJob(resident: Resident, roomId: string?)
	resident.Job = roomId
	if roomId then
		local room = grid:Room(roomId)
		if room then
			jobCells[roomId] = { room.Floor, room.Column }
		end
	end
	publish(resident)
	ResidentService.Assigned:Fire(resident.Id, roomId)
end

function ResidentService:Assign(id: string, roomId: string?): (boolean, string?)
	local resident = residents[id]
	if not resident or resident.State == "Dead" then
		return false, "That resident isn't in the bunker."
	end
	if resident.State == "Away" then
		return false, `{Residents.Name(resident)} is away on an expedition.`
	end
	if roomId == nil then
		if resident.Job then
			setJob(resident, nil)
			economy:RefreshCrew()
		end
		return true, nil
	end
	local room = grid:Room(roomId)
	if not room then
		return false, "That room isn't there any more."
	end
	if not Residents.JobStat(room.Type) then
		return false, `Nobody works in the {Config.Get("Rooms", room.Type).Name}.`
	end
	if resident.Job == roomId then
		return true, nil
	end
	if slotsFree(roomId, id) <= 0 then
		return false, `The {Config.Get("Rooms", room.Type).Name} is full.`
	end
	setJob(resident, roomId)
	log:Info("%s works in %s (%s) now", Residents.Name(resident), roomId, room.Type)
	economy:RefreshCrew()
	return true, nil
end

function ResidentService:AutoAssign(): number
	local free = {}
	local taken: { [string]: number } = {}
	for _, resident in sorted() do
		if resident.State == "Alive" then
			if resident.Job and grid:Room(resident.Job) then
				taken[resident.Job] = (taken[resident.Job] or 0) + 1
			else
				table.insert(free, resident)
			end
		end
	end
	local rooms = {}
	for _, room in grid:Rooms() do
		table.insert(rooms, { Id = room.Id, Type = room.Type, Level = room.Level, Span = room.Span })
	end
	local plan = Residents.AutoAssign(rooms, taken, free)
	local n = 0
	for residentId, roomId in plan do
		local resident = residents[residentId]
		if resident then
			setJob(resident, roomId)
			n += 1
		end
	end
	if n > 0 then
		economy:RefreshCrew()
		log:Info("Auto-Assign gave %d resident(s) a job", n)
	end
	return n
end

-- A room went: its workers move to the room now standing in its cells (a merge), or go idle.
local function roomChanged(roomId: string)
	if grid:Room(roomId) then
		return
	end
	local cell = jobCells[roomId]
	jobCells[roomId] = nil
	local successor = if cell then grid:RoomAt(cell[1], cell[2]) else nil
	local moved = false
	for _, resident in sorted() do
		if resident.Job == roomId then
			if successor and Residents.JobStat(successor.Type) and slotsFree(successor.Id) > 0 then
				setJob(resident, successor.Id)
			else
				setJob(resident, nil)
			end
			moved = true
		end
	end
	if moved then
		economy:RefreshCrew()
	end
end

-- Health and death ---------------------------------------------------------------------------------

local function goDown(resident: Resident, how: string)
	if resident.State ~= "Alive" then
		return
	end
	resident.State = "Down"
	resident.Health = 0
	resident.Panicked = nil -- nobody panics on the floor
	panicUntil[resident.Id] = nil
	downUntil[resident.Id] = workspace:GetServerTimeNow() + Config.Get("Tuning", "Residents").DeathReviveSeconds
	downHow[resident.Id] = how
	logLine(resident, `fell ({how})`)
	publish(resident)
	economy:RefreshCrew()
	announce("Danger", `{string.upper(Residents.Name(resident))} IS DOWN: REVIVE THEM WITH A MEDKIT`)
end

local function checkLost()
	for _, resident in residents do
		if resident.State ~= "Dead" then
			return
		end
	end
	if next(residents) and director:Phase() == "Playing" then
		log:Warn("the last resident is gone: the bunker falls")
		director:Lose("ResidentsLost")
	end
end

local function die(resident: Resident, quiet: boolean?)
	local how = downHow[resident.Id] or "unknown"
	resident.State = "Dead"
	downUntil[resident.Id] = nil
	downHow[resident.Id] = nil
	resident.Job = nil
	resident.Injured, resident.Panicked, resident.Refusing, resident.Lucky = nil, nil, nil, nil
	panicUntil[resident.Id] = nil
	if not quiet then
		-- they died in the bunker: what they carried goes back in the gear locker (someone lost on
		-- an expedition takes theirs with them)
		local record = resident :: any
		local back = false
		for _, slot in { "Weapon", "Outfit", "Tool" } do
			local piece = record[slot] :: string?
			if piece then
				locker[piece] = (locker[piece] or 0) + 1
				record[slot] = nil
				back = true
			end
		end
		if back then
			publishLocker()
		end
	end
	logLine(resident, `died ({how})`)
	publish(resident)
	economy:RefreshCrew()
	log:Warn("%s died (%s)", Residents.Name(resident), how)
	if not quiet then
		announce("Danger", `{string.upper(Residents.Name(resident))} DIED`)
	end
	ResidentService.Died:Fire(resident.Id, how)
	checkLost()
end

function ResidentService:Hurt(id: string, amount: number, how: string)
	local resident = residents[id]
	if not resident or resident.State ~= "Alive" then
		return
	end
	resident.Health = math.max(0, resident.Health - amount)
	if resident.Health <= 0 then
		goDown(resident, how)
	elseif not resident.Injured and Residents.InjuredAt(resident.Health, resident.MaxHealth) then
		ResidentService:SetCondition(id, "Injured", true, how) -- Section 11: works slowly until treated
	else
		publish(resident)
	end
end

-- Cave-in rubble cuts a resident off (ResidentBrain): out of their crew until they are free.
function ResidentService:SetTrapped(id: string, on: boolean)
	local resident = residents[id]
	if not resident or (resident.Trapped == true) == on then
		return
	end
	resident.Trapped = on
	if on then
		logLine(resident, "trapped by a cave-in")
	end
	publish(resident)
	economy:RefreshCrew()
end

function ResidentService:Revive(id: string, player: Player?): (boolean, string?)
	local resident = residents[id]
	if not resident or resident.State ~= "Down" then
		return false, "Nobody is down there."
	end
	local paid, why = economy:Spend({ Medkits = 1 }, `reviving {Residents.Name(resident)}`)
	if not paid then
		return false, `No Medkit: {why}.`
	end
	resident.State = "Alive"
	resident.Health = math.max(1, math.floor(resident.MaxHealth * 0.25))
	resident.Injured = true -- back on their feet, not well: the Medbay or a Medic treats them
	downUntil[id] = nil
	downHow[id] = nil
	logLine(resident, if player then `revived by {player.DisplayName}` else "revived")
	publish(resident)
	economy:RefreshCrew()
	announce("Info", `{string.upper(Residents.Name(resident))} IS BACK ON THEIR FEET`)
	return true, nil
end

-- New residents ------------------------------------------------------------------------------------

function ResidentService:Add(tier: string?, level: number?): string
	count += 1
	local resident = Residents.Roll(rng, `N{count}`, tier or "Common", level or 1, usedNames)
	residents[resident.Id] = resident
	logLine(resident, "came into the bunker")
	publish(resident)
	return resident.Id
end

-- Residents in the run: everyone not dead, the away included (the cap, Constants.CAPS.Residents).
function ResidentService:Count(): number
	local n = 0
	for _, resident in residents do
		if resident.State ~= "Dead" then
			n += 1
		end
	end
	return n
end

-- Expeditions (Prompt 18) ----------------------------------------------------------------------------

--[[
	Sets out (on): an Alive resident in the bunker leaves their job and goes Away (ResidentBrain walks
	them out through the Blast Door). Comes home (off): an Away resident is Alive again with no job,
	at `health` if given (what an escort home left them).
]]
function ResidentService:SetAway(id: string, on: boolean, health: number?): (boolean, string?)
	local resident = residents[id]
	if not resident then
		return false, "Nobody by that id."
	end
	if on then
		if resident.State ~= "Alive" then
			return false, `{Residents.Name(resident)} can't go: they're {string.lower(resident.State)}.`
		end
		if resident.Trapped then
			return false, `{Residents.Name(resident)} is cut off by rubble.`
		end
		local hadJob = resident.Job ~= nil
		resident.Job = nil
		resident.State = "Away"
		resident.Hungry = false
		publish(resident)
		if hadJob then
			ResidentService.Assigned:Fire(resident.Id, nil)
		end
	else
		if resident.State ~= "Away" then
			return false, `{Residents.Name(resident)} isn't away.`
		end
		resident.State = "Alive"
		if health then
			resident.Health = math.clamp(math.floor(health + 0.5), 1, resident.MaxHealth)
		end
		publish(resident)
	end
	economy:RefreshCrew()
	return true, nil
end

-- Harm on an expedition: never below 1 health (they come back hurt; Lose is for the lost). Returns the harm done.
function ResidentService:Wound(id: string, amount: number): number
	local resident = residents[id]
	if not resident or resident.State ~= "Away" or amount <= 0 then
		return 0
	end
	local before = resident.Health
	resident.Health = math.max(1, resident.Health - amount)
	publish(resident)
	return before - resident.Health
end

-- Experience away (Section 11: residents gain experience from expeditions). With no job, a level goes into their best stat.
function ResidentService:GainXP(id: string, xp: number)
	local resident = residents[id]
	if not resident or resident.State == "Dead" or xp <= 0 then
		return
	end
	local room = if resident.Job then grid:Room(resident.Job) else nil
	local levels = Residents.AddXP(resident, xp * xpMultiplier(), levelStat or (if room then Residents.JobStat(room.Type) else nil))
	if levels > 0 then
		logLine(resident, `reached level {resident.Level}`)
		announce("Info", `{string.upper(Residents.Name(resident))} REACHED LEVEL {resident.Level}`)
	end
	publish(resident)
end

-- Every resident (the away too, not the dead) goes up n levels now, each level adding to their
-- job's stat (or their best with no job), as levels always do (Prompt 19: Field Training).
function ResidentService:AddLevels(n: number, why: string): number
	local raised = 0
	local maxLevel = Config.Get("Tuning", "Residents").LevelMax
	for _, resident in residents do
		if resident.State ~= "Dead" and resident.Level < maxLevel then
			local room = if resident.Job then grid:Room(resident.Job) else nil
			local stat = levelStat or (if room then Residents.JobStat(room.Type) else nil)
			local gained = 0
			for _ = 1, n do
				if resident.Level >= maxLevel then
					break
				end
				gained += Residents.AddXP(resident, math.max(Residents.XPToLevel(resident.Level) - resident.XP, 0), stat)
			end
			if gained > 0 then
				raised += 1
				logLine(resident, `reached level {resident.Level} ({why})`)
				publish(resident)
			end
		end
	end
	if raised > 0 then
		announce("Info", `{string.upper(why)}: {raised} RESIDENTS LEVEL UP`)
	end
	economy:RefreshCrew()
	return raised
end

-- Every resident's morale goes up (or down) by `amount` now (Prompt 19: Morale Broadcast).
function ResidentService:AddMorale(amount: number, why: string): number
	local reached = 0
	for _, resident in residents do
		if resident.State ~= "Dead" then
			resident.Morale = math.clamp(resident.Morale + amount, 0, 100)
			reached += 1
			publish(resident)
		end
	end
	if reached > 0 then
		announce("Info", `{string.upper(why)}: {if amount >= 0 then "+" else ""}{math.floor(amount)} MORALE FOR EVERYONE`)
	end
	economy:RefreshCrew()
	return reached
end

-- A line in a resident's run log (Section 11).
function ResidentService:Note(id: string, text: string)
	local resident = residents[id]
	if not resident then
		return
	end
	logLine(resident, text)
	publish(resident)
end

-- Lost for good, at once (an expedition member who didn't come back): no revive. Quiet: the caller tells the team.
function ResidentService:Lose(id: string, how: string)
	local resident = residents[id]
	if not resident or resident.State == "Dead" then
		return
	end
	downHow[id] = how
	resident.Health = 0
	die(resident, true)
end

-- Once a cycle, after the meal ---------------------------------------------------------------------

local function beds(): number
	local n = 0
	for _, room in grid:RoomsOfType("Quarters") do
		local info = Config.Get("Rooms", "Quarters")
		n += (info.Beds and info.Beds[room.Level] or 0) * room.Span
	end
	return n
end

local function medbayHeals(): boolean
	for _, room in grid:RoomsOfType("Medbay") do
		if not room.Wrecked and not power:IsDark(room.Id) and economy:Crew(room.Id) then
			return true
		end
	end
	return false
end

local function afterMeal(cycle: number, _taken: { [string]: number }, missing: { [string]: number })
	local t = Config.Get("Tuning", "Residents")
	local alive = {}
	for _, resident in sorted() do
		if resident.State == "Alive" then
			table.insert(alive, resident)
		end
	end
	-- who goes hungry: one resident for each missing meal, the newest arrivals first
	local short = math.max(missing.Food or 0, missing.Water or 0)
	local hungry: { [string]: boolean } = {}
	for i = #alive, math.max(1, #alive - short + 1), -1 do
		if short > 0 then
			hungry[alive[i].Id] = true
		end
	end
	local bedsLeft = beds()
	local heals = medbayHeals()
	local decon = false
	for _, room in grid:RoomsOfType("DeconRoom") do
		if not room.Wrecked and not power:IsDark(room.Id) then
			decon = true
		end
	end
	local conditionDown: string? = nil
	local lounge = false
	for _, room in grid:RoomsOfType("Lounge") do
		if not room.Wrecked and not power:IsDark(room.Id) then
			lounge = true
		end
	end
	local byRoom: { [string]: { Resident } } = {}
	for _, resident in alive do
		if resident.Job then
			byRoom[resident.Job] = byRoom[resident.Job] or {}
			table.insert(byRoom[resident.Job], resident)
		end
	end
	local leaving: { Resident } = {}
	for _, resident in alive do
		local room = if resident.Job then grid:Room(resident.Job) else nil
		local jobStat = if room then Residents.JobStat(room.Type) else nil
		local bed = bedsLeft > 0
		if bed then
			bedsLeft -= 1
		end
		local dark = room ~= nil and power:IsDark(room.Id)
		local mates = if resident.Job then byRoom[resident.Job] else {}
		-- Homesick: time in the Lounge is a job there, or no job with a working Lounge to sit in
		local inLounge = lounge and (room == nil or room.Type == "Lounge")
		local worked = room ~= nil and not resident.Refusing
		local notes = Residents.Cycle(resident, worked, jobStat, bed, not hungry[resident.Id], dark,
			{ Workers = mates, Floor = if room then room.Floor else nil, Lounge = inLounge })
		for _, note in notes do
			logLine(resident, note)
		end
		-- Phase 2 (Prompt 26): what their traits do each cycle
		resident.Lucky = nil
		resident.Refusing = nil
		if room then
			local luck = Residents.Trait(resident, "DoubleOutputChance")
			if luck and rng:NextNumber() < luck then
				resident.Lucky = true
				logLine(resident, "had a lucky shift")
			end
			if dark and Residents.Has(resident, "AfraidOfDark") then
				resident.Refusing = true -- "refuses to work there"
			end
			if Residents.Repairs(resident) and room.HP < room.MaxHP and not room.Wrecked then
				grid:SetHP(room.Id, math.min(room.MaxHP, room.HP + t.RepairPerCycle))
			end
			local accident = Residents.Trait(resident, "AccidentChance")
			if accident and rng:NextNumber() < accident then
				logLine(resident, "had an accident at work")
				ResidentService.Accident:Fire(resident.Id, room.Id)
			end
		end
		local scrap = Residents.Trait(resident, "ScrapPerCycle")
		if scrap and scrap > 0 then
			economy:Add("Scrap", scrap, `{Residents.Name(resident)} scrounged`)
		end
		-- morale's bottom: refusing work, a fight, leaving for good
		if Residents.MoraleState(resident.Morale) == "Miserable" then
			resident.Low = (resident.Low or 0) + 1
		else
			resident.Low = nil
		end
		local what = Residents.Miserable(resident, #mates > 1, rng:NextNumber(), rng:NextNumber())
		if what == "Leave" then
			table.insert(leaving, resident)
		elseif what == "Fight" then
			local other = mates[1]
			for _, mate in mates do
				if mate ~= resident then
					other = mate
				end
			end
			local m = Config.Get("Tuning", "Morale").Miserable
			logLine(resident, `started a fight with {Residents.Name(other)}`)
			logLine(other, `was in a fight with {Residents.Name(resident)}`)
			resident.Health = math.max(1, resident.Health - m.FightDamage)
			other.Health = math.max(1, other.Health - m.FightDamage)
			other.Morale = math.clamp(other.Morale + m.FightMorale, 0, 100)
			announce("Warning", `{string.upper(Residents.Name(resident))} STARTED A FIGHT WITH {string.upper(Residents.Name(other))}: THEIR MORALE IS AT THE BOTTOM`)
		elseif what == "Refuse" then
			resident.Refusing = true
			logLine(resident, "refused to work")
			if room then
				announce("Warning", `{string.upper(Residents.Name(resident))} REFUSES TO WORK: THEIR MORALE IS AT THE BOTTOM`)
			end
		end
		if room and jobStat then
			local levels = Residents.AddXP(resident, t.XPPerWorkCycle * xpMultiplier(), levelStat or jobStat)
			if levels > 0 then
				logLine(resident, `reached level {resident.Level}`)
				announce("Info", `{string.upper(Residents.Name(resident))} REACHED LEVEL {resident.Level}`)
			end
		end
		if heals and resident.Health > 0 and resident.Health < resident.MaxHealth then
			resident.Health = math.min(resident.MaxHealth, resident.Health + t.MedbayHealPerCycle)
		end
		if heals and resident.Injured then
			resident.Injured = nil -- "works slowly until treated": a working Medbay treats them
			logLine(resident, "was treated in the Medbay")
		end
		-- Prompt 24: a working Decon Room clears the irradiated (Section 6: "Clears radiation from
		-- players and residents"); the sick and the irradiated lose health until they are treated
		if resident.Irradiated and decon then
			resident.Irradiated = nil
			logLine(resident, "was cleared of radiation in the Decon Room")
		end
		local cost = Residents.ConditionHealth(resident)
		if cost < 0 and resident.Health > 0 then
			resident.Health = math.max(0, resident.Health + cost)
			conditionDown = if resident.Health <= 0 then (if resident.Sick then "sickness" else "radiation") else nil
		else
			conditionDown = nil
		end
		if resident.Health <= 0 then
			goDown(resident, conditionDown or (if hungry[resident.Id] then "hunger" else "weakness"))
		else
			publish(resident)
		end
	end
	-- Section 11: a Miserable resident may "leave the bunker for good"
	for _, resident in leaving do
		if resident.State == "Alive" then
			announce("Danger", `{string.upper(Residents.Name(resident))} HAS LEFT THE BUNKER FOR GOOD: THEY WERE MISERABLE TOO LONG`)
			for _, slot in { "Weapon", "Outfit", "Tool" } do
				ResidentService:Equip(resident.Id, slot, nil) -- their gear stays
			end
			ResidentService:Lose(resident.Id, "left the bunker")
		end
	end
	log:Info("cycle %d: needs for %d residents (%d hungry, %d beds)", cycle, #alive, short, beds())
	economy:RefreshCrew()
end

local function afterSurge()
	local boost = Config.Get("Tuning", "Residents").SurgeSurvivedMorale
	for _, resident in residents do
		if resident.State == "Alive" then
			resident.Morale = math.min(100, resident.Morale + boost)
			publish(resident)
		end
	end
	economy:RefreshCrew()
end

-- DevTools ---------------------------------------------------------------------------------------

local function describe(resident: Resident): string
	local stats = {}
	for _, stat in Residents.StatIds() do
		table.insert(stats, `{string.sub(stat, 1, 3)} {resident.Stats[stat]}`)
	end
	local room = if resident.Job then grid:Room(resident.Job) else nil
	local flags = ""
	for _, flag in { "Injured", "Panicked", "Refusing", "Lucky" } do
		if (resident :: any)[flag] then
			flags ..= `, {string.upper(flag)}`
		end
	end
	local gear = ""
	if resident.Weapon or resident.Outfit or resident.Tool then
		gear = `; gear {resident.Weapon or "-"}/{resident.Outfit or "-"}/{resident.Tool or "-"}`
	end
	return string.format("%s %s, %d, L%d (%d/%d xp): %s; %s; job %s; HP %d/%d, rest %d, morale %d (%s)%s%s%s%s%s%s",
		resident.Id, Residents.Name(resident), resident.Age, resident.Level, resident.XP, Residents.XPToLevel(resident.Level),
		table.concat(stats, ", "), table.concat(resident.Traits or {}, "+"), if room then `{room.Id} {room.Type}` else "none",
		resident.Health, resident.MaxHealth,
		resident.Rest, resident.Morale, (Residents.MoraleState(resident.Morale)),
		if resident.Hungry then ", HUNGRY" else "", if resident.Sick then ", SICK" else "",
		if resident.Irradiated then ", IRRADIATED" else "", flags, if resident.State ~= "Alive" then `, {string.upper(resident.State)}` else "", gear)
end

local function describeAll(): string
	local lines = {}
	for _, resident in sorted() do
		table.insert(lines, describe(resident))
	end
	return if #lines > 0 then table.concat(lines, "\n") else "no residents"
end

function ResidentService:Init(registry)
	grid = registry.BunkerGrid
	economy = registry.EconomyService
	power = registry.PowerService
	clock = registry.CycleClock
	director = registry.RunDirector
	session = registry.SessionService
	collection = registry.ReplicationService:Collection("Residents")
	gearCollection = registry.ReplicationService:Collection("Gear")
	publishLocker()
	Remotes.OnServer("EquipResident", function(player: Player, id: string, slot: string, piece: string)
		if not session:IsReady(player) or director:Phase() ~= "Playing" then
			return
		end
		local ok, why = ResidentService:Equip(id, slot, if piece == "" then nil else piece)
		if not ok and why then
			Remotes.FireClient("Alert", player, "Warning", string.upper(why))
		end
	end)
	Remotes.OnServer("AssignResident", function(player: Player, id: string, roomId: string)
		local ok, why = ResidentService:Assign(id, if roomId == "" then nil else roomId)
		if not ok and why then
			Remotes.FireClient("Alert", player, "Warning", why)
		end
	end)
	Remotes.OnServer("AutoAssign", function(player: Player)
		local n = ResidentService:AutoAssign()
		Remotes.FireClient("Alert", player, "Info",
			if n > 0 then `AUTO-ASSIGN: {n} RESIDENT{if n == 1 then "" else "S"} PUT TO WORK` else "AUTO-ASSIGN: NO EMPTY JOB FITS ANYONE IDLE")
	end)
	Remotes.OnServer("ReviveResident", function(player: Player, id: string)
		local ok, why = ResidentService:Revive(id, player)
		if not ok and why then
			Remotes.FireClient("Alert", player, "Warning", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("residents", {
		Description = "Every resident: stats, job, needs and state.",
		Usage = "residents",
		Run = function(): string?
			return describeAll()
		end,
	})
	dev:Register("residents.auto", {
		Description = "Auto-Assign idle residents.",
		Usage = "residents.auto",
		Run = function(): string?
			return `assigned {ResidentService:AutoAssign()}\n{describeAll()}`
		end,
	})
	dev:Register("residents.add", {
		Description = "New residents (a recruit, for testing).",
		Usage = "residents.add [count] [tier] [level]",
		Run = function(_player: Player?, args): string?
			for _ = 1, math.clamp(tonumber(args[1]) or 1, 1, 20) do
				ResidentService:Add(if args[2] then tostring(args[2]) else nil, tonumber(args[3]))
			end
			return describeAll()
		end,
	})
	dev:Register("gear", {
		Description = "The gear locker, and what each resident wears.",
		Run = function(): string?
			local lines = {}
			for piece, count in locker do
				table.insert(lines, `{Residents.PieceName(piece)} x{count} [{piece}]`)
			end
			table.sort(lines)
			local out = { "locker: " .. (if #lines > 0 then table.concat(lines, ", ") else "empty") }
			for _, resident in sorted() do
				if resident.Weapon or resident.Outfit or resident.Tool then
					table.insert(out, `{resident.Id} {Residents.Name(resident)}: weapon {resident.Weapon or "-"}, outfit {resident.Outfit or "-"}, tool {resident.Tool or "-"}`)
				end
			end
			return table.concat(out, "\n")
		end,
	})
	dev:Register("gear.add", {
		Description = "Put a gear piece in the locker (Item or Item:Rarity), or find random gear as loot would.",
		Usage = "gear.add <piece|random> [count]",
		Run = function(player, args): string?
			local piece = tostring(args[1] or "random")
			local count = math.max(1, math.floor(tonumber(args[2]) or 1))
			if piece == "random" then
				return `{ResidentService:FindGear(player, count)} found`
			end
			return if ResidentService:AddGear(piece, count) then `{Residents.PieceName(piece)} x{count} in the locker` else "not a resident's gear"
		end,
	})
	dev:Register("resident.equip", {
		Description = "Give a resident a piece from the locker (none: take the slot's piece off).",
		Usage = "resident.equip <id> <Weapon|Outfit|Tool> <piece|none>",
		Run = function(_player, args): string?
			local piece = tostring(args[3] or "none")
			local ok, why = ResidentService:Equip(tostring(args[1]), tostring(args[2]), if piece == "none" then nil else piece)
			local resident = residents[tostring(args[1])]
			return if ok and resident then describe(resident) else `can't: {why}`
		end,
	})
	dev:Register("resident.trait", {
		Description = "Set a resident's two traits (Studio testing).",
		Usage = "resident.trait <id> <Trait> [Trait]",
		Run = function(_player, args): string?
			local resident = residents[tostring(args[1])]
			if not resident or not Config.Find("Traits", tostring(args[2])) then
				return "usage: resident.trait <id> <Trait> [Trait] (Config.Traits ids)"
			end
			local traits = { tostring(args[2]) }
			if args[3] and Config.Find("Traits", tostring(args[3])) then
				table.insert(traits, tostring(args[3]))
			end
			resident.Traits = traits
			local share = resident.Health / math.max(resident.MaxHealth, 1)
			resident.MaxHealth = Residents.MaxHealthOf(resident)
			resident.Health = math.floor(resident.MaxHealth * share + 0.5)
			publish(resident)
			economy:RefreshCrew()
			return describe(resident)
		end,
	})
	dev:Register("resident.morale", {
		Description = "Set a resident's morale (and how many cycles they have been Miserable).",
		Usage = "resident.morale <id|all> <0-100> [cycles low]",
		Run = function(_player, args): string?
			local value = tonumber(args[2])
			if not value then
				return "usage: resident.morale <id|all> <0-100> [cycles low]"
			end
			local n = 0
			for id, resident in residents do
				if (args[1] == "all" or id == tostring(args[1])) and resident.State == "Alive" then
					resident.Morale = math.clamp(value, 0, 100)
					resident.Low = tonumber(args[3])
					publish(resident)
					n += 1
				end
			end
			economy:RefreshCrew()
			return `{n} set to {value}`
		end,
	})
	dev:Register("resident.assign", {
		Description = "Give a resident a job (a room id) or none.",
		Usage = "resident.assign <id> <roomId|none>",
		Run = function(_player: Player?, args): string?
			local id, roomId = tostring(args[1] or ""), tostring(args[2] or "")
			local ok, why = ResidentService:Assign(id, if roomId == "none" then nil else roomId)
			return if ok then describeAll() else `refused: {why}`
		end,
	})
	dev:Register("resident.hurt", {
		Description = "Hurt a resident (0 health: down, then dead).",
		Usage = "resident.hurt <id> <amount>",
		Run = function(_player: Player?, args): string?
			ResidentService:Hurt(tostring(args[1] or ""), tonumber(args[2]) or 10, "DevTools")
			return describeAll()
		end,
	})
	dev:Register("resident.revive", {
		Description = "Revive a downed resident with a Medkit from the stockpile.",
		Usage = "resident.revive <id>",
		Run = function(_player: Player?, args): string?
			local ok, why = ResidentService:Revive(tostring(args[1] or ""), nil)
			return if ok then describeAll() else `refused: {why}`
		end,
	})
	dev:Register("resident.set", {
		Description = "Set a resident's need or stat: health, rest, morale, xp or a stat name.",
		Usage = "resident.set <id> <field> <value>",
		Run = function(_player: Player?, args): string?
			local resident = residents[tostring(args[1] or "")]
			local field, value = string.lower(tostring(args[2] or "")), tonumber(args[3])
			if not resident or not value then
				return "usage: resident.set <id> <health|rest|morale|xp|Strength...> <value>"
			end
			if field == "health" then
				resident.Health = math.clamp(value, 0, resident.MaxHealth)
			elseif field == "rest" then
				resident.Rest = math.clamp(value, 0, 100)
			elseif field == "morale" then
				resident.Morale = math.clamp(value, 0, 100)
			elseif field == "xp" then
				Residents.AddXP(resident, value, nil)
			else
				for _, stat in Residents.StatIds() do
					if string.lower(stat) == field then
						resident.Stats[stat] = math.clamp(value, 1, Config.Get("Tuning", "Residents").StatCap)
						resident.MaxHealth = Residents.MaxHealth(resident.Stats)
					end
				end
			end
			publish(resident)
			economy:RefreshCrew()
			return describe(resident)
		end,
	})
end

function ResidentService:Start()
	local start = Config.Get("Tuning", "StartingBunker")
	for _ = 1, start.Residents do
		ResidentService:Add(start.ResidentTier, rng:NextInteger(start.ResidentLevels.Min, start.ResidentLevels.Max))
	end
	-- the founders start idle (Landon): when play starts, tell the team they're waiting for work
	director.PhaseChanged:Connect(function(phase: string, old: string)
		if phase ~= "Playing" or old ~= "Intro" then -- only when the run starts (not after Keep Going)
			return
		end
		local idle = 0
		for _, resident in residents do
			if resident.State == "Alive" and not resident.Job then
				idle += 1
			end
		end
		if idle > 0 then
			task.delay(2, function()
				announce("Warning", if idle == 1
					then "1 RESIDENT IS WAITING FOR A JOB: OPEN THE COMMAND VIEW AND ASSIGN THEM"
					else `{idle} RESIDENTS ARE WAITING FOR JOBS: OPEN THE COMMAND VIEW AND ASSIGN THEM`)
			end)
		end
	end)
	economy:SetResidents({
		Crew = function(roomId: string): Residents.Crew?
			local room = grid:Room(roomId)
			if not room then
				return nil
			end
			local workers = {}
			for _, resident in residents do
				if resident.Job == roomId and not resident.Trapped then
					table.insert(workers, resident)
				end
			end
			return Residents.Crew(workers, room.Type)
		end,
		Eaters = function(): { { Id: string, FoodUse: number? } }
			local list = {}
			for _, resident in sorted() do
				if resident.State == "Alive" then
					table.insert(list, { Id = resident.Id, FoodUse = Residents.FoodUse(resident) })
				end
			end
			return list
		end,
	})
	economy.Ate:Connect(afterMeal)
	-- the Panicked calm down (ResidentBrain panics them while they flee)
	task.spawn(function()
		while true do
			task.wait(1)
			for id, at in panicUntil do
				if os.clock() >= at then
					panicUntil[id] = nil
					ResidentService:SetCondition(id, "Panicked", false)
				end
			end
		end
	end)
	clock.SurgeEnded:Connect(afterSurge)
	grid.RoomChanged:Connect(roomChanged)
	RunService.Heartbeat:Connect(function()
		if next(downUntil) == nil then
			return
		end
		local now = workspace:GetServerTimeNow()
		for id, untilTime in table.clone(downUntil) do
			local resident = residents[id]
			if resident and resident.State == "Down" and now >= untilTime then
				die(resident)
			end
		end
	end)
	log:Info("%d founders in the bunker:\n%s", start.Residents, describeAll())
end

return ResidentService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000110"><Properties><string name="Name">ResultsService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ResultsService: the run's results (bible Sections 5, 16, 18 and 21). Run place only; Prompt 15.
	The arithmetic is Shared.Rules.Results; payouts are Config.GlowshardRewards, the difficulty's
	PayoutMultiplier and Tuning.Account; the MVP weights are Tuning.Results.

	* While the run plays it counts each player's part (damage to monsters, kills, damage to
	  bosses, revives, cells dug, repairs) and the team's (monsters killed, cells dug, rooms built,
	  residents lost, disasters, bosses beaten), and keeps the run's story: the moments worth
	  telling, each with its year (a boss beaten, a resident's death, a Push Deeper, a Tremor, a
	  meltdown stopped, the end).
	* The Deep (Prompt 17): caves found, Lost Crews brought home and cryo pods thawed go in the
	  story; so do expeditions home, distress calls answered and recruits (Prompt 18); Glowshard chests pay when they are opened (DeepService), and the results show them as
	  a line of their own (already paid).
	* When the run ends (RunDirector.RunEnded) it pays everyone still in it: Glowshards
	  (Rules.Results.Payout: years, depth bands, a victory, bosses, the difficulty, the first win of
	  the day), account experience and levels, the profile's Stats (Runs, Wins, BestYear, Deepest,
	  BossesKilled, MonstersKilled, LastWinDay) and FirstRunDone, then saves. A run that ends again
	  after Keep Going pays only what is new (a ledger per player).
	* It publishes the Results collection ("Run" -> the results below) for the results screen.
	* The results screen's buttons (Section 21): Play Again opens a team vote (Config.Votes
	  PlayAgain; solo applies at once) that sends everyone to a fresh Run server, the same way a
	  pad does (Lib.RunLaunch: a reserved server, the party and its loadouts in MemoryStore first;
	  the same difficulty; each player's class if they own it, else the Survivor: a free trial is
	  one run); Keep Going, after a victory, opens the Keep Going vote (Endless,
	  RunDirector:KeepGoing); Return to Lobby sends the player to the lobby. Teleports don't work in
	  Studio: there it says so.
	* A win also counts in Stats.HardWins or NightmareWins (Prompt 21: Nightmare unlocks after a
	  Hard win, Rules.Lobby.Unlocked).

	Results: { Outcome, DefeatReason, Victory, Endless, Year, Cycle, Era, Difficulty, Seconds,
	DeepestFloor, Band, Team = { MonstersKilled, CellsDug, RoomsBuilt, ResidentsAlive, ResidentsLost,
	Disasters, Hauled, Rescued, Bosses }, Stories = { string }, MVP = user id (string) or nil, Players = { [user id]
	= { Name, Class, Damage, Kills, BossDamage, Revives, CellsDug, Repairs, Hauled, Rescues, Score, Glowshards,
	Lines = { { Text, Amount } }, XP, Level, LevelUp, ClassXP, ClassLevel, ClassLevelUp, Paid } }, At }.
	Class experience (Prompt 20): the run's new years pay the player's class (ClassService:RunXP; an owned
	class only), and a class level up is put in play at once (ClassService:Refresh).

	Dev: results, results.pay.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Classes = require(Shared.Rules.Classes)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local Results = require(Shared.Rules.Results)
local RunState = require(Shared.RunState)
local RunLaunch = require(ServerScriptService.Lib.RunLaunch)

local log = Log.new("ResultsService")

local ResultsService = {
	Name = "ResultsService",
	Dependencies = {
		"RunDirector", "CycleClock", "SessionService", "ProfileService", "CombatService", "MonsterService", "ResidentService",
		"BuildService", "DigService", "DisasterService", "ObjectiveService", "BossService", "BunkerGrid", "VoteService",
		"InventoryService", "RescueService", "DeepService", "ExpeditionService", "DraftService", "ClassService",
		"ReplicationService", "DevService",
	},
}

local STAT_KEYS = { "Damage", "Kills", "BossDamage", "Revives", "CellsDug", "Repairs", "Hauled", "Rescues" } -- Hauled, Rescues: Prompt 16

local director: any = nil
local clock: any = nil
local session: any = nil
local profiles: any = nil
local combat: any = nil
local residents: any = nil
local objectives: any = nil
local grid: any = nil
local votes: any = nil
local classes: any = nil
local collection: any = nil

local stats: { [number]: { [string]: number } } = {} -- user id -> stats
local names: { [number]: string } = {}
local team = { MonstersKilled = 0, CellsDug = 0, RoomsBuilt = 0, ResidentsLost = 0, Disasters = 0, Hauled = 0, Rescued = 0 }
local bosses: { string } = {}
local stories: { string } = {}
local lastHit: { [string]: string } = {} -- combatant id -> who hit it last ("P<user id>")
local ledgers: { [number]: Results.Ledger } = {}
local paidKills: { [number]: number } = {} -- kills already added to the profile's MonstersKilled
local counted: { [number]: boolean } = {} -- the run counted in the profile's Runs
local deepest = 0
local chestShards: { [number]: number } = {} -- user id -> Glowshards from chests (paid when opened, Prompt 17)
local bandsWithCaves: { [string]: boolean } = {}
local voteOpen: { [string]: string } = {} -- vote kind -> id
local published: { [string]: any }? = nil

-- Counting -------------------------------------------------------------------------------------------

local function userOf(source: string?): number?
	if source and string.sub(source, 1, 1) == "P" then
		return tonumber(string.sub(source, 2))
	end
	return nil
end

local function bump(userId: number?, key: string, amount: number)
	if not userId then
		return
	end
	local s = stats[userId]
	if not s then
		s = {}
		for _, k in STAT_KEYS do
			s[k] = 0
		end
		stats[userId] = s
	end
	s[key] = (s[key] or 0) + amount
end

local function story(text: string)
	local year = clock:Year()
	table.insert(stories, `Year {year} · {text}`)
	local max = Results.Tuning().StoriesMax * 3
	if #stories > max then
		table.remove(stories, 1)
	end
end

local function residentName(id: string): string
	local r = residents:Get(id)
	return if r then Residents.Name(r) else "A resident"
end

-- The results -------------------------------------------------------------------------------------------

local function playerClass(player: Player): string
	local class = player:GetAttribute("Class")
	local entry = if type(class) == "string" then Config.Find("Classes", class) else nil
	return if entry then entry.Name else "Survivor"
end

local function teamNumbers(): { [string]: any }
	local alive, lost = 0, 0
	for _, r in residents:All() do
		if r.State == "Dead" then
			lost += 1
		else
			alive += 1
		end
	end
	local names_ = {}
	for _, bossId in bosses do
		table.insert(names_, Config.Get("Bosses", bossId).Name)
	end
	return {
		MonstersKilled = team.MonstersKilled,
		CellsDug = team.CellsDug,
		RoomsBuilt = team.RoomsBuilt,
		ResidentsAlive = alive,
		ResidentsLost = lost,
		Disasters = team.Disasters,
		Hauled = team.Hauled,
		Rescued = team.Rescued,
		Bosses = names_,
	}
end

local function endingStory(summary: any): string
	if summary.Outcome == "CenturyVictory" then
		return "The blast door opens on a clearing sky: a Century Victory"
	elseif summary.Outcome == "DeepVictory" then
		return "The Source is destroyed in its chamber: a Deep Victory"
	elseif summary.DefeatReason == "ReactorDestroyed" then
		return "The Reactor Core melted down and the bunker fell"
	elseif summary.DefeatReason == "ResidentsLost" then
		return "The last resident died and the bunker fell"
	end
	return "The run ended"
end

-- Pays one player and returns their row of the results.
local function pay(player: Player, summary: any, run: Results.Run): { [string]: any }
	local userId = player.UserId
	names[userId] = player.DisplayName
	local s = stats[userId] or {}
	local paid = ledgers[userId] or Results.EmptyLedger()
	local profile = profiles:Get(player)
	local today = Results.Day(os.time())
	local stats_ = if profile then profile.Stats else {}
	local firstWinToday = run.Victory ~= nil and (stats_.LastWinDay or -1) ~= today
	local payout = Results.Payout(run, paid, { FirstWinToday = firstWinToday })
	local xp = Results.AccountXP(run.Year, paid.Years)
	local level, levelUp = if profile then profile.AccountLevel else 1, false
	-- class experience (Prompt 20): the run's new years, for an owned class
	local classId, classXP = classes:RunXP(player, run.Year, paid.Years)
	local classLevel, classLevelUp, classPaid = nil, false, 0
	local ok = true
	if profile then
		ok = profiles:Update(player, function(data)
			local entry = if classId then data.Classes[classId] else nil
			if entry and classXP > 0 then
				entry.XP += classXP
				local newLevel = math.max(entry.Level, Classes.LevelFor(entry.XP))
				classLevelUp = newLevel > entry.Level
				entry.Level = newLevel
				classPaid = classXP
			end
			classLevel = if entry then entry.Level else nil
			data.Glowshards += payout.Total
			local newLevel, newXP = Results.LevelUp(data.AccountLevel, data.AccountXP, xp)
			levelUp = newLevel > data.AccountLevel
			data.AccountLevel, data.AccountXP = newLevel, newXP
			level = newLevel
			local st = data.Stats
			if not counted[userId] then
				st.Runs = (st.Runs or 0) + 1
			end
			if run.Victory and not paid.Victory then
				st.Wins = (st.Wins or 0) + 1
				st.LastWinDay = today
				-- a win on Hard unlocks Nightmare (Section 5; Rules.Lobby.Unlocked)
				if run.Difficulty == "Hard" then
					st.HardWins = (st.HardWins or 0) + 1
				elseif run.Difficulty == "Nightmare" then
					st.NightmareWins = (st.NightmareWins or 0) + 1
				end
			end
			st.BestYear = math.max(st.BestYear or 0, run.Year)
			st.Deepest = math.max(st.Deepest or 0, run.DeepestFloor)
			local newBosses = 0
			for _, bossId in run.Bosses do
				if not paid.Bosses[bossId] then
					newBosses += 1
				end
			end
			st.BossesKilled = (st.BossesKilled or 0) + newBosses
			st.MonstersKilled = (st.MonstersKilled or 0) + math.max(0, (s.Kills or 0) - (paidKills[userId] or 0))
			data.FirstRunDone = true
		end)
	end
	if ok then
		ledgers[userId] = payout.Ledger
		paidKills[userId] = s.Kills or 0
		counted[userId] = true
		log:Info("%s paid %d Glowshards and %d experience (%s)", player.Name, payout.Total, xp, summary.Outcome or "?")
		if classPaid > 0 then
			log:Info("%s's %s: +%d class experience, level %s", player.Name, tostring(classId), classPaid, tostring(classLevel))
		end
		task.spawn(function()
			profiles:SaveNow(player)
		end)
		if classLevelUp then
			classes:Refresh(player)
		end
	else
		log:Warn("%s: the payout couldn't be written", player.Name)
	end
	local lines = table.clone(payout.Lines)
	local fromChests = chestShards[userId] or 0
	if fromChests > 0 then
		table.insert(lines, { Text = "Glowshard chests (paid when opened)", Amount = fromChests })
	end
	local row: { [string]: any } = {
		Name = player.DisplayName,
		Class = playerClass(player),
		Score = Results.Score(s),
		Glowshards = (if ok then payout.Total else 0) + fromChests,
		Lines = lines,
		XP = xp,
		Level = level,
		LevelUp = levelUp,
		ClassXP = if ok then classPaid else 0,
		ClassLevel = classLevel,
		ClassLevelUp = ok and classLevelUp,
		Paid = ok and profile ~= nil,
	}
	for _, key in STAT_KEYS do
		row[key] = math.floor((s[key] or 0) + 0.5)
	end
	return row
end

local function build(summary: any)
	deepest = math.max(deepest, grid:DeepestFloor())
	local run: Results.Run = {
		Year = summary.Year,
		DeepestFloor = deepest,
		Victory = summary.Victory,
		Bosses = table.clone(bosses),
		Difficulty = summary.Difficulty,
	}
	story(endingStory(summary))
	local rows = {}
	local scoring: { [number]: { [string]: number } } = {}
	for _, player in session:ReadyPlayers() do
		rows[tostring(player.UserId)] = pay(player, summary, run)
		scoring[player.UserId] = stats[player.UserId] or {}
	end
	local mvp = Results.MVP(scoring)
	local shown = {}
	local max = Results.Tuning().StoriesMax
	for i = math.max(1, #stories - max + 1), #stories do
		table.insert(shown, stories[i])
	end
	local band = if deepest >= 1 then Grid.BandOf(deepest).Name else "Mines"
	published = {
		Outcome = summary.Outcome,
		DefeatReason = summary.DefeatReason,
		Victory = summary.Victory,
		Endless = summary.Endless,
		Year = summary.Year,
		Cycle = summary.Cycle,
		Era = summary.Era,
		Difficulty = summary.Difficulty,
		Seconds = math.floor(summary.Seconds),
		DeepestFloor = deepest,
		Band = band,
		Team = teamNumbers(),
		Stories = shown,
		MVP = if mvp then tostring(mvp) else nil,
		Players = rows,
		At = workspace:GetServerTimeNow(),
	}
	collection:Set("Run", published)
	log:Info("results: %s in Year %d, %d players, MVP %s", tostring(summary.Outcome), summary.Year, #session:ReadyPlayers(),
		if mvp then tostring(mvp) else "-")
end

-- The results screen's buttons ------------------------------------------------------------------------------

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function teleport(placeId: number, list: { Player }, reserved: boolean): (boolean, string?)
	if RunService:IsStudio() then
		return false, "TELEPORTS DON'T WORK IN STUDIO"
	end
	local options = Instance.new("TeleportOptions")
	if reserved then
		local ok, code = pcall(function()
			return TeleportService:ReserveServer(placeId)
		end)
		if not ok then
			return false, `NO SERVER: {tostring(code)}`
		end
		options.ReservedServerAccessCode = code
	end
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(placeId, list, options)
	end)
	if not ok then
		return false, `THE TELEPORT FAILED: {tostring(err)}`
	end
	return true, nil
end

local function openVote(player: Player, kind: string, title: string, onPass: () -> ())
	if voteOpen[kind] then
		alert(player, "Info", "THAT VOTE IS ALREADY ON: VOTE ON THE BANNER")
		return
	end
	local id, why = votes:Open({
		Kind = kind,
		Proposer = nil, -- the run is over, so the game opens it; the asker's yes goes in at once
		Title = title,
		OnPass = function()
			voteOpen[kind] = nil
			onPass()
		end,
		OnFail = function(reason: string)
			voteOpen[kind] = nil
			log:Info("%s failed: %s", kind, reason)
		end,
	})
	if not id then
		alert(player, "Warning", string.upper(why or "THE VOTE COULDN'T START"))
		return
	end
	if id ~= "solo" then
		voteOpen[kind] = id
		votes:Cast(player, id, "Yes")
	end
end

local function onPlayAgain(player: Player)
	if director:Phase() ~= "Ended" then
		alert(player, "Info", "THE RUN ISN'T OVER YET")
		return
	end
	openVote(player, "PlayAgain", `PLAY AGAIN? ({string.upper(player.DisplayName)} ASKS)`, function()
		-- the same party to a fresh Run server, each with the class they own (a free trial was one run)
		local list = session:ReadyPlayers()
		local loadouts: { [number]: any } = {}
		for _, member in list do
			local class = member:GetAttribute("Class")
			local owned = type(class) == "string" and member:GetAttribute("ClassTrial") ~= true
			loadouts[member.UserId] = { Class = if owned then class else "Survivor" }
		end
		local ok, why = RunLaunch.Start(list, director:Difficulty(), loadouts)
		Remotes.FireClients("Alert", list, if ok then "Info" else "Warning",
			if ok then "PLAY AGAIN: OFF TO A FRESH BUNKER" else `PLAY AGAIN PASSED · {why}`)
		log:Info("Play Again passed (%s)", if ok then "teleporting" else tostring(why))
	end)
end

local function onKeepGoing(player: Player)
	local summary = director:Summary()
	if director:Phase() ~= "Ended" or not summary.Victory or summary.Endless then
		alert(player, "Info", "KEEP GOING COMES AFTER A VICTORY")
		return
	end
	openVote(player, "KeepGoing", `KEEP GOING: ENDLESS MODE? ({string.upper(player.DisplayName)} ASKS)`, function()
		if director:KeepGoing() then
			Remotes.FireClients("Alert", session:ReadyPlayers(), "Info", "KEEP GOING: ENDLESS MODE STARTS NOW")
		end
	end)
end

local function onReturnToLobby(player: Player)
	if director:Phase() ~= "Ended" then
		alert(player, "Info", "THE RUN ISN'T OVER YET")
		return
	end
	local ok, why = teleport(Constants.PLACE_IDS.Lobby, { player }, false)
	if not ok then
		alert(player, "Warning", `RETURN TO LOBBY · {why}`)
	end
	log:Info("%s returns to the lobby (%s)", player.Name, if ok then "teleporting" else tostring(why))
end

-- DevTools -----------------------------------------------------------------------------------------------------

local function describe(): string
	local lines = { string.format("team: %d monsters killed, %d cells dug, %d rooms built, %d residents lost, %d disasters, bosses %s",
		team.MonstersKilled, team.CellsDug, team.RoomsBuilt, team.ResidentsLost, team.Disasters,
		if #bosses > 0 then table.concat(bosses, ", ") else "none") }
	for userId, s in stats do
		local parts = {}
		for _, key in STAT_KEYS do
			table.insert(parts, `{key} {math.floor(s[key] or 0)}`)
		end
		table.insert(lines, `{names[userId] or tostring(userId)}: {table.concat(parts, ", ")} (score {Results.Score(s)})`)
	end
	for _, line in stories do
		table.insert(lines, line)
	end
	if published then
		table.insert(lines, `published: {tostring(published.Outcome)}, MVP {tostring(published.MVP)}`)
		for id, row in published.Players do
			table.insert(lines, `  {id} {row.Name}: {row.Glowshards} Glowshards, +{row.XP} xp, level {row.Level}{if row.LevelUp then " (up)" else ""}`)
		end
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("results", {
		Description = "The run's numbers so far, its story, and the published results.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("results.stat", {
		Description = "Add to a player's results stat (Studio testing of the MVP).",
		Usage = "results.stat <Damage|Kills|BossDamage|Revives|CellsDug|Repairs|Hauled|Rescues> <amount>",
		Run = function(player, args): string?
			local key, amount = tostring(args[1] or ""), tonumber(args[2])
			if not table.find(STAT_KEYS, key) or not amount or not player then
				return "usage: results.stat <stat> <amount> (as a player)"
			end
			names[player.UserId] = player.DisplayName
			bump(player.UserId, key, amount)
			return describe()
		end,
	})
end

-- Lifecycle ---------------------------------------------------------------------------------------------------

local services: { [string]: any } = {}

function ResultsService:Init(registry)
	director = registry.RunDirector
	clock = registry.CycleClock
	session = registry.SessionService
	profiles = registry.ProfileService
	combat = registry.CombatService
	residents = registry.ResidentService
	objectives = registry.ObjectiveService
	grid = registry.BunkerGrid
	votes = registry.VoteService
	classes = registry.ClassService
	services.Build = registry.BuildService
	services.Dig = registry.DigService
	services.Disaster = registry.DisasterService
	services.Boss = registry.BossService
	services.Inventory = registry.InventoryService
	services.Rescue = registry.RescueService
	services.Deep = registry.DeepService
	services.Expedition = registry.ExpeditionService
	services.Draft = registry.DraftService
	collection = registry.ReplicationService:Collection("Results")
	registerCommands(registry.DevService)
end

function ResultsService:Start()
	-- Monsters' ids are M<n> (CombatService). A killing blow is Damaged after the target is
	-- unregistered, so the id says what it was, not CombatService:Get.
	combat.Damaged:Connect(function(id: string, amount: number, source: string?, _how: string?)
		if source then
			lastHit[id] = source
		end
		local userId = userOf(source)
		if userId and string.sub(id, 1, 1) == "M" then
			bump(userId, "Damage", amount)
			if services.Boss:IsBoss(id) then
				bump(userId, "BossDamage", amount)
			end
		end
	end)
	combat.Died:Connect(function(id: string)
		local source = lastHit[id]
		lastHit[id] = nil
		if string.sub(id, 1, 1) == "M" and not services.Boss:IsEggSac(id) then
			team.MonstersKilled += 1
			bump(userOf(source), "Kills", 1)
		end
	end)
	combat.Revived:Connect(function(_id: string, byUserId: number?)
		if byUserId then
			bump(byUserId, "Revives", 1)
		end
	end)
	residents.Died:Connect(function(id: string, how: string)
		team.ResidentsLost += 1
		story(`{residentName(id)} died ({how})`)
	end)
	services.Dig.Dug:Connect(function(floor: number, _column: number, result: string, _cause: string, finisher: Player?)
		team.CellsDug += 1
		deepest = math.max(deepest, floor)
		if finisher then
			bump(finisher.UserId, "CellsDug", 1)
		end
		if result == "Nest" then
			story("digging broke into a monster nest")
		end
	end)
	services.Build.Built:Connect(function(_roomId: string, kind: string)
		if kind == "Build" then
			team.RoomsBuilt += 1
		end
	end)
	services.Build.Repaired:Connect(function(_roomId: string, amount: number, _how: string, player: Player?)
		if player then
			bump(player.UserId, "Repairs", amount)
		end
	end)
	services.Disaster.Started:Connect(function(_id: string, kind: string)
		team.Disasters += 1
		if kind == "Meltdown" then
			story("the Reactor Core began to melt down")
		end
	end)
	services.Disaster.Ended:Connect(function(_id: string, kind: string, how: string)
		if kind == "Meltdown" and how == "Fixed" then
			story("three valves turned together stopped the meltdown")
		end
	end)
	-- the surface (Prompt 16): what players hauled home and who they rescued
	services.Inventory.Unloaded:Connect(function(player: Player, delivered: { [string]: number })
		local n = 0
		for _, amount in delivered do
			n += amount
		end
		team.Hauled += n
		bump(player.UserId, "Hauled", n)
	end)
	services.Inventory.Delivered:Connect(function(player: Player, kind: string, given: { any })
		local n = 0
		for _, drop in given do
			n += drop.Count or 0
		end
		team.Hauled += n
		bump(player.UserId, "Hauled", n)
		local entry = Config.Find("LootTables", kind)
		local dug = Config.Find("DigResults", kind) -- a cryo pod (Prompt 17)
		local what = if entry then string.lower(entry.Text) elseif dug then `a {string.lower(dug.Name)}` else kind
		story(`{player.DisplayName} hauled {what} home`)
	end)
	services.Rescue.Joined:Connect(function(residentId: string, leader: Player?, _kind: string, where: string)
		team.Rescued += 1
		if leader then
			bump(leader.UserId, "Rescues", 1)
		end
		story(`{if leader then leader.DisplayName else "the team"} rescued {residentName(residentId)} from {where}`)
	end)
	-- the Deep (Prompt 17)
	services.Deep.CaveOpened:Connect(function(_key: string, band: string, _pieces: number)
		if not bandsWithCaves[band] then
			bandsWithCaves[band] = true
			local entry = Config.Find("DepthBands", band)
			story(`digging broke into a cave in the {if entry then entry.Name else band}`)
		end
	end)
	services.Deep.CrewHome:Connect(function(objectiveId: string, leader: Player?)
		local objective = Config.Find("Objectives", objectiveId)
		local crew = if objective then (string.gsub(objective.Name, "^Lost Crew: ", "")) else "a lost"
		story(`{if leader then leader.DisplayName else "the team"} brought {crew} crew home`)
	end)
	-- Prompt 18: expeditions home, distress calls answered, recruits
	services.Expedition.Returned:Connect(function(_id: string, destination: string, names: string, finds: string)
		story(`{names} came back from {if destination == "Deep" then "the Deep" else "the surface"}`
			.. (if finds ~= "" then ` ({string.lower(finds)})` else ""))
	end)
	services.Expedition.Reached:Connect(function(_id: string, player: Player)
		story(`{player.DisplayName} answered a distress call`)
	end)
	services.Expedition.Recruited:Connect(function(residentId: string, how: string)
		story(`{residentName(residentId)} {how}`)
	end)
	-- Prompt 19: cards drafted
	services.Draft.Drafted:Connect(function(cardId: string, how: string)
		if how == "Draft" then
			story(`the team drafted {Config.Get("DraftCards", cardId).Name}`)
		end
	end)
	services.Deep.Thawed:Connect(function(residentId: string, tier: string)
		story(`{residentName(residentId)} ({string.lower(tier)}) thawed out of a cryo pod`)
	end)
	services.Deep.ChestOpened:Connect(function(opener: Player, shards: number)
		for _, player in session:ReadyPlayers() do
			chestShards[player.UserId] = (chestShards[player.UserId] or 0) + shards
		end
		story(`{opener.DisplayName} opened a Glowshard chest`)
	end)
	services.Boss.Defeated:Connect(function(bossId: string, killer: Player?)
		if not table.find(bosses, bossId) then
			table.insert(bosses, bossId)
		end
		local name = Config.Get("Bosses", bossId).Name
		story(if killer then `{killer.DisplayName} struck the {name} down` else `the {name} fell`)
	end)
	objectives.BossDefeated:Connect(function(bossId: string)
		if not table.find(bosses, bossId) then
			table.insert(bosses, bossId) -- beaten another way (DevTools' boss.beat)
		end
	end)
	local lastLimit = RunState.Get("DigLimit")
	RunState.Changed("DigLimit"):Connect(function()
		local value = RunState.Get("DigLimit")
		if type(value) == "number" and type(lastLimit) == "number" and value > lastLimit then
			story(`the team pushed deeper, into the {Grid.BandOf(value).Name}`)
		end
		lastLimit = value
	end)
	RunState.Changed("TremorAt"):Connect(function()
		if type(RunState.Get("TremorAt")) == "number" then
			story("a Tremor shook the bunker and the Deep broke in")
		end
	end)
	director.RunEnded:Connect(function(summary: any)
		local ok, err = pcall(build, summary)
		if not ok then
			log:Error("results: %s", tostring(err))
		end
	end)
	Remotes.OnServer("PlayAgain", onPlayAgain)
	Remotes.OnServer("KeepGoing", onKeepGoing)
	Remotes.OnServer("ReturnToLobby", onReturnToLobby)
	log:Info("results ready")
end

return ResultsService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000111"><Properties><string name="Name">RunDirector</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RunDirector: the run's lifecycle, how it ends, and Endless (bible Sections 4, 5 and 23;
	named so it never clashes with Roblox's RunService). Run place only.

		Waiting -> Intro -> Playing -> Ended (-> Playing again in Endless after Keep Going)

	* Waiting until the first player's session is ready (Prompt 21 adds waiting for the
	  party list the lobby writes to MemoryStore).
	* Intro: 30 seconds. The run clock starts at the 30-second mark for everyone, so a player
	  who skips the cutscene (personal, from 2 seconds in, Prompt 22) gains nothing.
	* Playing: CycleClock runs the cycles.
	* Victory: Century (the final Surge survived; CycleClock reports it) or Deep (the Source
	  destroyed in its chamber at depth 10; Prompt 25 calls Win("Deep")). After a victory the
	  team can Keep Going (a vote, Prompt 8): the run carries on in Endless.
	* Defeat: the Reactor Core is destroyed or the last resident dies (the systems that own
	  them call Lose). Players dying never loses the run.
	* The results screen (Prompt 15) reads Summary(); Play Again and Return to Lobby are
	  Prompt 21.

	API:
		RunDirector:Phase(): RunPhase
		RunDirector:Difficulty(): string                       -- Normal, Hard or Nightmare
		RunDirector:SetDifficulty(id): boolean                 -- from the run's record (PartyService, Prompt 21)
		RunDirector:Win(kind: "Century" | "Deep"): boolean
		RunDirector:Lose(reason: "ReactorDestroyed" | "ResidentsLost"): boolean
		RunDirector:KeepGoing(): boolean
		RunDirector:Summary(): Summary
		RunDirector.PhaseChanged: Signal<RunPhase, RunPhase>   -- new, old
		RunDirector.RunEnded: Signal<Summary>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("RunDirector")
local IS_STUDIO = RunService:IsStudio()

export type RunPhase = RunState.RunPhase
export type VictoryKind = "Century" | "Deep"
export type DefeatReason = "ReactorDestroyed" | "ResidentsLost"
export type Summary = {
	Outcome: RunState.Outcome?,
	DefeatReason: DefeatReason?,
	Victory: VictoryKind?,
	Endless: boolean,
	Year: number,
	Cycle: number,
	Era: string,
	Difficulty: string,
	Seconds: number, -- played time, from the end of the intro
	Players: { number }, -- user ids of everyone who played in this run
}

local RunDirector = {
	Name = "RunDirector",
	Dependencies = { "SessionService", "CycleClock", "DevService" },
	PhaseChanged = Signal.new() :: Signal.Signal<RunPhase, RunPhase>,
	RunEnded = Signal.new() :: Signal.Signal<Summary>,
}

local session: any = nil
local clock: any = nil
local set: (string, any) -> () = function() end

local phase: RunPhase = "Waiting"
local difficulty = "Normal"
local outcome: RunState.Outcome? = nil
local defeatReason: DefeatReason? = nil
local victory: VictoryKind? = nil
local endless = false
local playingSince: number? = nil
local playedSeconds = 0
local played: { [number]: boolean } = {}

local function setPhase(new: RunPhase)
	local old = phase
	if old == new then
		return
	end
	phase = new
	set("RunPhase", new)
	log:Info("run: %s -> %s", old, new)
	RunDirector.PhaseChanged:Fire(new, old)
end

local function introSeconds(): number
	local devTools = ServerScriptService:FindFirstChild("DevTools")
	if IS_STUDIO and devTools and devTools:GetAttribute("SkipIntro") == true then
		return 0
	end
	return Config.Get("Tuning", "Clock").IntroSeconds
end

local function startPlaying()
	if phase ~= "Intro" then
		return
	end
	set("IntroEndsAt", nil)
	setPhase("Playing")
	playingSince = os.clock()
	clock:Begin()
end

local function startIntro()
	if phase ~= "Waiting" then
		return
	end
	local seconds = introSeconds()
	set("IntroEndsAt", workspace:GetServerTimeNow() + seconds)
	setPhase("Intro")
	task.delay(seconds, startPlaying)
end

local function finish(result: RunState.Outcome, reason: DefeatReason?)
	clock:Halt()
	outcome = result
	defeatReason = reason
	if playingSince then
		playedSeconds += os.clock() - playingSince
		playingSince = nil
	end
	set("Outcome", result)
	set("DefeatReason", reason)
	setPhase("Ended")
	local summary = RunDirector:Summary()
	log:Info("run over: %s %s in Year %d, cycle %d", result, reason or "", summary.Year, summary.Cycle)
	RunDirector.RunEnded:Fire(summary)
end

function RunDirector:Phase(): RunPhase
	return phase
end

-- Normal, Hard or Nightmare (Config.Difficulties): the pad's, from the run's record (PartyService).
function RunDirector:Difficulty(): string
	return difficulty
end

-- The run's record says what the pad was set to. Not once the run has ended.
function RunDirector:SetDifficulty(id: string): boolean
	if phase == "Ended" or not Config.Find("Difficulties", id) then
		return false
	end
	if id ~= difficulty then
		difficulty = id
		set("Difficulty", difficulty)
		log:Info("difficulty: %s", id)
	end
	return true
end

-- A victory (Century: the final Surge survived; Deep: the Source destroyed in its chamber).
function RunDirector:Win(kind: VictoryKind): boolean
	assert(kind == "Century" or kind == "Deep", "RunDirector:Win takes Century or Deep")
	if phase ~= "Playing" or endless then
		return false
	end
	victory = kind
	set("Victory", kind)
	finish(if kind == "Century" then "CenturyVictory" else "DeepVictory", nil)
	return true
end

-- The bunker falls (the Reactor Core destroyed, or the last resident dead).
function RunDirector:Lose(reason: DefeatReason): boolean
	assert(reason == "ReactorDestroyed" or reason == "ResidentsLost", "RunDirector:Lose takes ReactorDestroyed or ResidentsLost")
	if phase ~= "Playing" then
		return false
	end
	finish("Defeat", reason)
	return true
end

-- Keep Going passed after a victory: the run carries on in Endless.
function RunDirector:KeepGoing(): boolean
	if phase ~= "Ended" or victory == nil or outcome == "Defeat" or endless then
		return false
	end
	endless = true
	outcome = nil
	set("Endless", true)
	set("Outcome", nil)
	clock:SetEndless(true)
	setPhase("Playing")
	playingSince = os.clock()
	clock:Resume()
	return true
end

function RunDirector:Summary(): Summary
	local ids = {}
	for userId in played do
		table.insert(ids, userId)
	end
	table.sort(ids)
	return {
		Outcome = outcome,
		DefeatReason = defeatReason,
		Victory = victory,
		Endless = endless,
		Year = clock:Year(),
		Cycle = clock:Cycle(),
		Era = clock:Era(),
		Difficulty = difficulty,
		Seconds = playedSeconds + (if playingSince then os.clock() - playingSince else 0),
		Players = ids,
	}
end

local function describe(): string
	local summary = RunDirector:Summary()
	local lines = { `run {phase}, {difficulty}, Year {summary.Year}, cycle {summary.Cycle}, played {string.format("%.0f", summary.Seconds)} s` }
	if phase == "Intro" then
		table.insert(lines, `intro: {string.format("%.1f", RunState.TimeLeft() or 0)} s left`)
	end
	if outcome then
		local reason = if defeatReason then ` ({defeatReason})` else ""
		table.insert(lines, `outcome: {outcome}{reason}`)
	end
	if victory then
		local now = if endless then ", now Endless" else ""
		table.insert(lines, `victory: {victory}{now}`)
	end
	table.insert(lines, `players: {#summary.Players}`)
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("run", {
		Description = "The run's phase, outcome and summary.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("run.skipintro", {
		Description = "End the intro now and start the clock.",
		Run = function(): string?
			if phase ~= "Intro" then
				return `no intro running (run is {phase})`
			end
			startPlaying()
			return describe()
		end,
	})
	dev:Register("run.win", {
		Description = "Win the run (Century or Deep).",
		Usage = "run.win <century|deep>",
		Run = function(_player, args): string?
			local word = string.lower(tostring(args[1] or ""))
			local kind: VictoryKind? = if word == "century" then "Century" elseif word == "deep" then "Deep" else nil
			if not kind then
				return "usage: run.win <century|deep>"
			end
			if not RunDirector:Win(kind) then
				local mode = if endless then ", Endless" else ""
				return `can't win now (run is {phase}{mode})`
			end
			return describe()
		end,
	})
	dev:Register("run.lose", {
		Description = "Lose the run (the Reactor Core destroyed, or the last resident dead).",
		Usage = "run.lose <reactor|residents>",
		Run = function(_player, args): string?
			local word = string.lower(tostring(args[1] or ""))
			local reason: DefeatReason? = if word == "reactor" then "ReactorDestroyed" elseif word == "residents" then "ResidentsLost" else nil
			if not reason then
				return "usage: run.lose <reactor|residents>"
			end
			if not RunDirector:Lose(reason) then
				return `can't lose now (run is {phase})`
			end
			return describe()
		end,
	})
	dev:Register("run.difficulty", {
		Description = "Play this run at another difficulty (Studio testing; the lobby's pads choose it later).",
		Usage = "run.difficulty <Normal|Hard|Nightmare>",
		Run = function(_player: Player?, args): string?
			local wanted = tostring(args[1] or "")
			for _, id in Config.Ids("Difficulties") do
				if string.lower(id) == string.lower(wanted) then
					difficulty = id
					set("Difficulty", difficulty)
					return describe()
				end
			end
			return "usage: run.difficulty <Normal|Hard|Nightmare>"
		end,
	})
	dev:Register("run.keepgoing", {
		Description = "Keep Going after a victory: carry on in Endless.",
		Run = function(): string?
			if not RunDirector:KeepGoing() then
				return `can't keep going (run is {phase}, outcome {tostring(outcome)})`
			end
			return describe()
		end,
	})
end

function RunDirector:Init(registry)
	session = registry.SessionService
	clock = registry.CycleClock
	set = RunState.Writer("RunDirector")
	set("RunPhase", phase)
	set("Difficulty", difficulty)
	set("Endless", false)
	registerCommands(registry.DevService)
end

function RunDirector:Start()
	clock.CenturySurvived:Connect(function()
		RunDirector:Win("Century")
	end)
	local function onReady(player: Player)
		played[player.UserId] = true
		startIntro()
	end
	session.PlayerReady:Connect(onReady)
	for _, player in session:ReadyPlayers() do
		onReady(player)
	end
end

return RunDirector
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000112"><Properties><string name="Name">SessionService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SessionService: player sessions in this server (infrastructure, Prompt 0; gates Prompt 2).

	A player is "ready" once every gate has passed: the client has bootstrapped (the
	ClientReady remote) and each gate a service added (ProfileService adds "Profile": the save
	has loaded). Services that send a player state wait for PlayerReady instead of
	PlayerAdded, so nothing is sent before the client can receive it or before the player's
	data exists.

	API:
		SessionService:AddGate(name)           -- in Init: one more thing a session waits for
		SessionService:Pass(player, name)      -- that thing is done for this player
		SessionService:Fail(player, message)   -- it can't be done: the player is kicked
		SessionService.PlayerReady: Signal<Player>
		SessionService.PlayerLeaving: Signal<Player>
		SessionService:IsReady(player): boolean
		SessionService:ReadyPlayers(): { Player }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("SessionService")

local SessionService = {
	Name = "SessionService",
	Dependencies = {},
	PlayerReady = Signal.new() :: Signal.Signal<Player>,
	PlayerLeaving = Signal.new() :: Signal.Signal<Player>,
}

local CLIENT_GATE = "Client"
local gates: { string } = { CLIENT_GATE }
local passed: { [Player]: { [string]: boolean } } = {}
local ready: { [Player]: number } = {}

local function checkReady(player: Player)
	if ready[player] or player.Parent ~= Players then
		return
	end
	local done = passed[player]
	if not done then
		return
	end
	for _, gate in gates do
		if not done[gate] then
			return
		end
	end
	ready[player] = os.clock()
	player:SetAttribute("SessionReady", true)
	log:Debug("%s ready", player.Name)
	SessionService.PlayerReady:Fire(player)
end

function SessionService:AddGate(name: string)
	assert(not table.find(gates, name), `SessionService: gate {name} already exists`)
	table.insert(gates, name)
end

function SessionService:Pass(player: Player, gate: string)
	assert(table.find(gates, gate), `SessionService: no gate {gate}`)
	local done = passed[player]
	if not done then
		done = {}
		passed[player] = done
	end
	if done[gate] then
		return
	end
	done[gate] = true
	checkReady(player)
end

function SessionService:Fail(player: Player, message: string)
	log:Warn("%s can't start a session: %s", player.Name, message)
	player:Kick(message)
end

function SessionService:Init(_registry)
	Remotes.OnServer("ClientReady", function(player: Player)
		if player.Parent ~= Players then
			return
		end
		player:SetAttribute("ClientReady", true)
		SessionService:Pass(player, CLIENT_GATE)
	end)
end

function SessionService:Start()
	Players.PlayerRemoving:Connect(function(player: Player)
		SessionService.PlayerLeaving:Fire(player)
		ready[player] = nil
		passed[player] = nil
	end)
end

function SessionService:IsReady(player: Player): boolean
	return ready[player] ~= nil
end

function SessionService:ReadyPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if ready[player] then
			table.insert(list, player)
		end
	end
	return list
end

-- Which gates a player has passed (for DevTools).
function SessionService:Gates(player: Player): { [string]: boolean }
	local result: { [string]: boolean } = {}
	local done = passed[player] or {}
	for _, gate in gates do
		result[gate] = done[gate] == true
	end
	return result
end

return SessionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000113"><Properties><string name="Name">SurfaceService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SurfaceService: Brightwater Ruins, the surface above the bunker (bible Sections 9, 12 and 23;
	Run place, Prompt 16). Raids and wanderers (also the surface's, Section 23) come with Prompt 30.

	* The map is workspace.Surface, a static part of the Run place high above the bunker (Section 23:
	  the surface map high above, the bunker grid in the middle), built in Studio by
	  Lib.BrightwaterMap.Build() (Landon can dress it there). This service never rebuilds it: it reads
	  its markers (parts named ElevatorExit, ElevatorCall, SurvivorSpot, BigFindSpot, SpawnPoint),
	  its containers (models with Container and Location attributes) and its gates (models with a
	  MinEra attribute: the military checkpoint opens in Era III). Without a map the elevator says
	  so and nothing else changes.
	* Zones: every player carries a Zone attribute (Rules.Surface.Zone: Surface or Bunker);
	  ZoneChanged fires when it changes.
	* The elevator behind the Blast Door (Section 12): RIDE UP by the hall's door, RIDE DOWN at the
	  surface hut. The screen fades (the Elevator remote) and the server moves the character, the
	  survivors following them (RescueService) and anything in their hands.
	* Containers (Section 12; Config.SurfaceLocations): SEARCH rolls the location's loot table (the
	  Scavenger's ExtraLootRolls) into the searcher's backpack (InventoryService:Give); what doesn't
	  fit stays in the container (TAKE THE REST). Every era they refill; the checkpoint's are locked
	  until its MinEra.
	* Storms (Section 12): the storm is over the town for every Surge (RunState Storm, StormAt); the
	  siren's alert reaches players on the surface, and the Scout's StormWarningSeconds earlier.
	* Radiation (Section 9): the Player attribute Radiation, 0 to RadiationMax, builds on the surface
	  (RadiationPerSecond, StormRadiationPerSecond in a storm, times RadiationGain) and with each Ash
	  Wraith hit (Radiates); a working Decon Room clears it (Section 6). At PillUseAt a carried
	  Clear-Rad pill is taken by itself; at the max it drains health (RadiationHealthDrainPerSecond).
	  A new life (a respawn) keeps half of it (Landon, Prompt 16).
	* Creatures (Section 12; Config.Monsters, Where Surface): while players are on the surface, packs
	  of Ash Jackals by day, Ash Raiders from RaiderMinEra and Ash Wraiths only in storms, at
	  SpawnPoint markers SpawnDistance from the players, at most MaxMonsters at once (within the
	  map's cap of 25); wraiths fade when the storm passes and everything fades DespawnSeconds after
	  the last player leaves. A creature that falls FALL_GUARD studs below the exit is removed.
	* Survivors and big finds (Section 12): at the start of each day a survivor may be trapped at a
	  SurvivorSpot (RescueService:Trap) and generator parts may turn up at a BigFindSpot
	  (InventoryService:PlaceFind).
	* The surface's Lost Crew (Section 12; Prompt 17): a raider camp (A6's Bldg_RaiderCamp) stands
	  at one of the map's CampSpots, picked each run, with the crew trapped in its pen (Kind Crew, Tag
	  CrewSurface: DeepService completes the objective when they come home). Its Ash Raiders guard
	  it from Era I: they come out at the camp's Guard sockets when a player comes within
	  Tuning.Deep.CampWakeRange, asleep at their posts until one comes within GuardRange
	  (MonsterService guards), and go back in after CampSleepSeconds with nobody near; the ones
	  killed stay dead. CrewWhere() says where the camp is for the radio logs.

	API: Zone(player), Storm(), Radiation(player), AddRadiation(player, amount, why), Map(), CrewWhere(),
	DistressSpot() (Prompt 18: where an expedition radioing for help is pinned down, and the place's name),
	SearchNear(player, position, radius) (Prompt 20: the Scavenger's Magnet Sweep),
	SetLootBoost(multiplier) and SetStormEarly(seconds) (Prompt 19, Salvage Rights: containers give that many
	times the loot until the next storm, and the next storm hits that many seconds before its Surge;
	Tuning.Draft.StormEarlyWarnSeconds of warning for players up top).
	Signals: ZoneChanged(player, zone), Searched(player, location, given).
	Dev: surface, surface.up [player], surface.down [player], rad <n>, storm <on|off>, loot.refill,
	surface.spawn <type> [n], survivor, surface.find.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Loot = require(Shared.Rules.Loot)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local Surface = require(Shared.Rules.Surface)
local Disasters = require(Shared.Rules.Disasters)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("SurfaceService")

local SurfaceService = {
	Name = "SurfaceService",
	Dependencies = {
		"SessionService", "CycleClock", "RunDirector", "BunkerGrid", "PowerService", "CombatService", "MonsterService",
		"InventoryService", "RescueService", "DevService",
	},
	ZoneChanged = Signal.new() :: Signal.Signal<Player, string>,
	Searched = Signal.new() :: Signal.Signal<Player, string, { Loot.Drop }>,
}

-- loot nothing hands out yet (radio logs play through InventoryService's handler, Prompt 17)
local SKIP: { [string]: boolean } = { Recruit = true, Glowshards = true, Lamp = true } -- blueprints: Prompt 19; gear: Prompt 26
local CAMP_TAG = "Camp"
local CREW_TAG = "CrewSurface" -- the surface's Lost Crew (Config.Objectives)
local SURFACE_TAG = "Surface"
local FALL_GUARD = 30 -- studs under the elevator exit: below this a surface creature has fallen out of the town
local HALL_ARRIVAL = Vector3.new(0, 0, 6) -- from the Blast Door's Door socket, into the hall
local ELEVATOR_PROMPT = Vector3.new(0, 2.5, 0.5)

type Container = {
	Model: Model,
	Location: string,
	Prompt: ProximityPrompt,
	Left: { Loot.Drop }?,
	Looted: boolean,
	Locked: boolean,
}
type Spot = { CFrame: CFrame, Location: string? }
type Camp = {
	Model: Model,
	CFrame: CFrame,
	Hint: string,
	Posts: { CFrame }, -- the Guard sockets in the world
	Guards: { [string]: boolean }, -- monster ids out now
	Left: number, -- guards not yet killed
	NearAt: number, -- os.clock a player was last near
}

local clock: any = nil
local director: any = nil
local grid: any = nil
local power: any = nil
local combat: any = nil
local monsterService: any = nil
local inventory: any = nil
local rescue: any = nil
local set: (string, any) -> () = function() end

local map: Instance? = nil
local exitAt: CFrame? = nil
local containers: { Container } = {}
local survivorSpots: { Spot } = {}
local findSpots: { Spot } = {}
local spawnPoints: { Vector3 } = {}
local gates: { Model } = {}
local campSpots: { { CFrame: CFrame, Hint: string } } = {}
local camp: Camp? = nil
local radiation: { [Player]: number } = {}
local warned: { [Player]: number } = {} -- 0 none, 1 high, 2 sickness
local earlyWarned: { [Player]: number } = {} -- the cycle a Scout heard the storm coming
local riding: { [Player]: boolean } = {}
local creatures: { [string]: string } = {} -- surface monster id -> type
local storm = false
local lootBoost: number? = nil -- Prompt 19, Salvage Rights: loot times this until the next storm
local stormEarly = 0 -- Prompt 19, Salvage Rights: the next storm hits this many seconds before its Surge
local stormEarlyWarned = false
local raiderKind: (string) -> string -- below: AshRaider or, a third of the time, AshRaiderMelee
local emptySince = 0
local nextAt: { [string]: number } = { AshJackal = 0, AshRaider = 0, AshWraith = 0 }
local rng = Random.new()

local function now(): number
	return workspace:GetServerTimeNow()
end

local function t(): { [string]: any }
	return Surface.Tuning()
end

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function rootOf(player: Player): BasePart?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return if root and root:IsA("BasePart") then root else nil
end

local function alive(player: Player): boolean
	return player:GetAttribute("Life") == "Alive"
end

local function classValue(player: Player, key: string): number?
	return Modifiers.PlayerValue(player, key) -- at the player's class level (Prompt 20)
end

local function eraNumber(): number
	local era = Config.Find("Eras", clock:Era())
	return if era then era.Number else 1
end

local function locationName(id: string?): string
	local location = id and Config.Find("SurfaceLocations", id)
	return if location then location.Name else "the ruins"
end

local function locked(id: string?): boolean
	local location = id and Config.Find("SurfaceLocations", id)
	return location ~= nil and location.MinEra > eraNumber()
end

local function onSurface(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("Zone") == "Surface" and alive(player) then
			table.insert(list, player)
		end
	end
	return list
end

local function randomIn(range: { Min: number, Max: number }): number
	return rng:NextNumber(range.Min, math.max(range.Min, range.Max))
end

-- Zones -----------------------------------------------------------------------------------------

local function setZone(player: Player, zone: string)
	if player:GetAttribute("Zone") ~= zone then
		player:SetAttribute("Zone", zone)
		SurfaceService.ZoneChanged:Fire(player, zone)
	end
end

function SurfaceService:Zone(player: Player): string
	local zone = player:GetAttribute("Zone")
	return if type(zone) == "string" then zone else "Bunker"
end

function SurfaceService:Storm(): boolean
	return storm
end

function SurfaceService:Map(): Instance?
	return map
end

-- Radiation -------------------------------------------------------------------------------------

local function publishRadiation(player: Player, value: number)
	local shown = player:GetAttribute("Radiation")
	local rounded = math.floor(value * 10 + 0.5) / 10
	if type(shown) ~= "number" or math.abs(shown - rounded) >= 0.5 or (rounded == 0) ~= (shown == 0) then
		player:SetAttribute("Radiation", rounded)
	end
end

function SurfaceService:Radiation(player: Player): number
	return radiation[player] or 0
end

function SurfaceService:AddRadiation(player: Player, amount: number, why: string)
	local max = Config.Get("Tuning", "Player").RadiationMax
	radiation[player] = math.clamp((radiation[player] or 0) + amount, 0, max)
	publishRadiation(player, radiation[player])
	log:Debug("%s radiation %+.1f (%s) = %.1f", player.Name, amount, why, radiation[player])
end

local function inDecon(position: Vector3): boolean
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return false
	end
	local room = grid:RoomAt(floor, column)
	return room ~= nil and room.Type == "DeconRoom" and not room.Wrecked and not power:IsDark(room.Id)
end

local function radiationTick(player: Player, root: BasePart, dt: number)
	local tuning = t()
	local p = Config.Get("Tuning", "Player")
	local value = radiation[player] or 0
	if alive(player) then
		local zone = SurfaceService:Zone(player)
		value += Surface.RadiationRate(zone, storm, classValue(player, "RadiationGain")) * dt
		-- Prompt 24: a radiation leak in the bunker (DisasterService marks who stands in one)
		local leak = player:GetAttribute("InRadiation")
		if type(leak) == "number" and leak > 0 then
			value += Disasters.RadiationPlayerRate(leak, classValue(player, "RadiationGain")) * dt
		end
		-- Prompt 24: the Crystal Hollows' caves (DeepService marks who stands in one)
		local cave = player:GetAttribute("CaveRadiation")
		if type(cave) == "number" and cave > 0 then
			value += cave * math.max(classValue(player, "RadiationGain") or 1, 0) * dt
		end
		if zone == "Bunker" and value > 0 and inDecon(root.Position) then
			value -= tuning.DeconPerSecond * dt
		end
	end
	value = math.clamp(value, 0, p.RadiationMax)
	if value >= tuning.PillUseAt and inventory:TakePill(player) then
		value = 0
		alert(player, "Info", `YOU TOOK A CLEAR-RAD PILL: RADIATION CLEARED ({inventory:Pills(player)} LEFT)`)
	end
	radiation[player] = value
	publishRadiation(player, value)
	local level = if value >= p.RadiationMax then 2 elseif value >= p.RadiationMax * tuning.RadiationWarnAt then 1 else 0
	if level > (warned[player] or 0) then
		if level == 1 then
			alert(player, "Warning", if player:GetAttribute("InRadiation") then "RADIATION HIGH: GET OUT OF THE LEAK"
				elseif player:GetAttribute("CaveRadiation") then "RADIATION HIGH: GET OUT OF THE CRYSTAL CAVES"
				else "RADIATION HIGH: HEAD BACK TO THE ELEVATOR")
		else
			alert(player, "Danger", "RADIATION SICKNESS: YOU'RE LOSING HEALTH · CLEAR-RAD PILLS OR A DECON ROOM CLEAR IT")
		end
	end
	warned[player] = level
	if value >= p.RadiationMax and alive(player) then
		combat:Damage(`P{player.UserId}`, p.RadiationHealthDrainPerSecond * dt, nil, "radiation")
	end
end

-- The elevator ----------------------------------------------------------------------------------

local function hallArrival(): CFrame?
	local doors = grid:RoomsOfType("BlastDoor")
	local door = doors[1]
	local model = door and grid:RoomModel(door.Id)
	local socket = model and BunkerKit.Socket(model, "Door")
	if not socket then
		return nil
	end
	local at = socket.Position + HALL_ARRIVAL
	return CFrame.lookAt(at, at + Vector3.new(0, 0, 1)) -- facing into the hall, away from the door
end

local function ride(player: Player, way: string)
	if riding[player] or not alive(player) then
		return
	end
	local destination = if way == "Up" then exitAt else hallArrival()
	if not destination then
		alert(player, "Warning", if way == "Up" then "THE SURFACE ISN'T BUILT IN THIS PLACE YET" else "THE BLAST DOOR HALL IS GONE")
		return
	end
	local tuning = t()
	local followers = rescue:Followers(player, tuning.EscortRange)
	riding[player] = true
	player:SetAttribute("Riding", true)
	Remotes.FireClient("Elevator", player, way, tuning.FadeSeconds)
	task.delay(tuning.FadeSeconds, function()
		local character = player.Character
		if player.Parent == Players and character and alive(player) then
			local spot = (destination :: CFrame) * CFrame.new(rng:NextNumber(-1.5, 1.5), 0, 0)
			character:PivotTo(spot * CFrame.new(0, 3, 0))
			for i, id in followers do
				local column = (i - 1) % 3 - 1
				local row = math.floor((i - 1) / 3)
				rescue:MoveTo(id, spot * CFrame.new(column * 3, 0, -(3 + row * 3)))
			end
			setZone(player, Surface.Zone(spot.Position))
			log:Info("%s rode the elevator %s%s", player.Name, string.lower(way), if #followers > 0 then ` with {#followers} following` else "")
		end
		task.delay(tuning.FadeSeconds + 0.25, function()
			riding[player] = nil
			player:SetAttribute("Riding", nil)
		end)
	end)
end

local function elevatorPrompt(parent: BasePart, way: string): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ElevatorPrompt"
	prompt.ActionText = if way == "Up" then "RIDE UP" else "RIDE DOWN"
	prompt.ObjectText = if way == "Up" then "Elevator to the surface" else "Elevator to the bunker"
	prompt.HoldDuration = t().ElevatorHoldSeconds
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Kind", "Elevator")
	prompt.Triggered:Connect(function(player: Player)
		ride(player, way)
	end)
	prompt.Parent = parent
	return prompt
end

local function syncHallElevator()
	local root = grid:Root()
	if not root then
		return
	end
	local folder = root:FindFirstChild("Elevator")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Elevator"
		folder.Parent = root
	end
	local doors = grid:RoomsOfType("BlastDoor")
	local door = doors[1]
	local model = door and grid:RoomModel(door.Id)
	local socket = model and BunkerKit.Socket(model, "Door")
	local anchor = (folder :: Folder):FindFirstChild("Up") :: BasePart?
	if not socket then
		if anchor then
			anchor:Destroy()
		end
		return
	end
	if not anchor then
		local part = Instance.new("Part")
		part.Name = "Up"
		part.Size = Vector3.new(1, 1, 1)
		part.Transparency = 1
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Parent = folder
		elevatorPrompt(part, "Up")
		anchor = part
	end
	(anchor :: BasePart).CFrame = CFrame.new(socket.Position + ELEVATOR_PROMPT)
end

-- Containers ------------------------------------------------------------------------------------

local function setLocked(c: Container, on: boolean)
	c.Locked = on
	c.Model:SetAttribute("Locked", if on then true else nil)
	c.Prompt.Enabled = not on and not c.Looted
end

local function refill(why: string)
	for _, c in containers do
		c.Left = nil
		c.Looted = false
		c.Model:SetAttribute("Looted", nil)
		c.Prompt.ActionText = "SEARCH"
		setLocked(c, locked(c.Location))
	end
	for _, gate in gates do
		local minEra = gate:GetAttribute("MinEra")
		local open = type(minEra) ~= "number" or eraNumber() >= minEra
		gate:SetAttribute("Open", open)
		for _, part in gate:GetDescendants() do
			if part:IsA("BasePart") and part:GetAttribute("Barrier") then
				part.CanCollide = not open
				part.Transparency = if open then 1 else (part:GetAttribute("ShownTransparency") or 0) :: number
			end
		end
	end
	log:Info("containers refilled (%s): %d", why, #containers)
end

local function search(c: Container, player: Player)
	if c.Looted or c.Locked or not alive(player) then
		return
	end
	local location = Config.Find("SurfaceLocations", c.Location)
	if not location then
		return
	end
	local extraRolls = classValue(player, "ExtraLootRolls") or 0
	if lootBoost and lootBoost > 1 then
		local lootTable = Config.Find("LootTables", location.Loot)
		extraRolls += math.floor((if lootTable then lootTable.Rolls else 1) * (lootBoost - 1) + 0.5)
	end
	local drops = c.Left or Loot.Roll(location.Loot, rng, { Skip = SKIP, ExtraRolls = extraRolls })
	local given, left = inventory:Give(player, drops)
	if #left > 0 then
		c.Left = left
		c.Prompt.ActionText = "TAKE THE REST"
		alert(player, "Warning", `PACK FULL: {Loot.Text(left)} LEFT IN IT · {inventory:PackLine(player)}`)
	else
		c.Left = nil
		c.Looted = true
		c.Model:SetAttribute("Looted", true)
		c.Prompt.Enabled = false
	end
	if #given > 0 then
		alert(player, "Info", `{string.upper(location.Name)}: {Loot.Text(given)} · {inventory:PackLine(player)}`)
	elseif #left == 0 then
		alert(player, "Info", `{string.upper(location.Name)}: NOTHING USEFUL`)
	end
	SurfaceService.Searched:Fire(player, c.Location, given)
end

local function addContainer(model: Model)
	local location = model:GetAttribute("Location")
	if type(location) ~= "string" or not Config.Find("SurfaceLocations", location) then
		log:Warn("container %s has no known Location", model:GetFullName())
		return
	end
	local part = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not part then
		return
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "SearchPrompt"
	prompt.ActionText = "SEARCH"
	prompt.ObjectText = locationName(location)
	prompt.HoldDuration = t().SearchSeconds
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Kind", "Search")
	prompt.Parent = part
	local c: Container = { Model = model, Location = location, Prompt = prompt, Left = nil, Looted = false, Locked = false }
	prompt.Triggered:Connect(function(player: Player)
		search(c, player)
	end)
	table.insert(containers, c)
end

-- The map ---------------------------------------------------------------------------------------

local function readMap()
	local found = workspace:FindFirstChild("Surface")
	if not found then
		log:Warn("no workspace.Surface: build it with studio/map/Surface.lua (the elevator goes nowhere until then)")
		return
	end
	map = found
	for _, item in found:GetDescendants() do
		if item:IsA("BasePart") then
			local location = item:GetAttribute("Location")
			local spot: Spot = { CFrame = item.CFrame, Location = if type(location) == "string" then location else nil }
			if item.Name == "ElevatorExit" then
				exitAt = item.CFrame
			elseif item.Name == "ElevatorCall" then
				elevatorPrompt(item, "Down")
			elseif item.Name == "SurvivorSpot" then
				table.insert(survivorSpots, spot)
			elseif item.Name == "BigFindSpot" then
				table.insert(findSpots, spot)
			elseif item.Name == "SpawnPoint" then
				table.insert(spawnPoints, item.Position)
			elseif item.Name == "CampSpot" then
				local hint = item:GetAttribute("Hint")
				table.insert(campSpots, { CFrame = item.CFrame, Hint = if type(hint) == "string" then hint else "in the ruins" })
			end
		elseif item:IsA("Model") then
			if item:GetAttribute("Container") == true then
				addContainer(item)
			elseif item:GetAttribute("MinEra") ~= nil then
				table.insert(gates, item)
				for _, part in item:GetDescendants() do
					if part:IsA("BasePart") and part:GetAttribute("Barrier") then
						part:SetAttribute("ShownTransparency", part.Transparency)
					end
				end
			end
		end
	end
	log:Info("surface map: %d containers, %d survivor spots, %d find spots, %d spawn points, %d camp spots, %d gates, exit %s",
		#containers, #survivorSpots, #findSpots, #spawnPoints, #campSpots, #gates, if exitAt then "found" else "MISSING")
end

-- Survivors and big finds -----------------------------------------------------------------------

local function near(list: { Vector3 }, at: Vector3, within: number): boolean
	for _, p in list do
		if (p - at).Magnitude <= within then
			return true
		end
	end
	return false
end

local function trapSurvivor(): string?
	local taken = rescue:Spots()
	local free = {}
	for _, spot in survivorSpots do
		if not locked(spot.Location) and not near(taken, spot.CFrame.Position, 4) then
			table.insert(free, spot)
		end
	end
	if #free == 0 then
		return nil
	end
	local spot = free[rng:NextInteger(1, #free)]
	return rescue:Trap(spot.CFrame, { Kind = "Survivor", Where = string.lower(locationName(spot.Location)), Tag = SURFACE_TAG })
end

-- Where an expedition radioing for help is pinned down (Prompt 18): a free survivor spot, and its place.
function SurfaceService:DistressSpot(): (CFrame?, string?)
	local taken = rescue:Spots()
	local free = {}
	for _, spot in survivorSpots do
		if not locked(spot.Location) and not near(taken, spot.CFrame.Position, 8) then
			table.insert(free, spot)
		end
	end
	if #free == 0 then
		return nil, nil
	end
	local spot = free[rng:NextInteger(1, #free)]
	local location = spot.Location and Config.Find("SurfaceLocations", spot.Location)
	return spot.CFrame, if location then location.Name else nil
end

local function placeFind(): string?
	local taken = {}
	for _, f in inventory:Finds() do
		table.insert(taken, f.Position)
	end
	local free = {}
	for _, spot in findSpots do
		if not locked(spot.Location) and not near(taken, spot.CFrame.Position, 6) then
			table.insert(free, spot)
		end
	end
	if #free == 0 then
		return nil
	end
	local spot = free[rng:NextInteger(1, #free)]
	return inventory:PlaceFind(t().BigFindLoot, spot.CFrame, SURFACE_TAG)
end

local function newDay(cycle: number)
	local tuning = t()
	if map and rescue:Count("Trapped", "Survivor") < tuning.MaxTrapped and rng:NextNumber() < tuning.SurvivorChancePerDay then
		local id = trapSurvivor()
		if id then
			log:Info("cycle %d: a survivor is trapped on the surface (%s)", cycle, id)
		end
	end
	local finds = 0
	for _, f in inventory:Finds(SURFACE_TAG) do
		if not f.Carried then
			finds += 1
		end
	end
	if map and finds < tuning.MaxBigFinds and rng:NextNumber() < tuning.BigFindChancePerDay then
		placeFind()
	end
end

-- The raider camp and the surface's Lost Crew (Prompt 17) ---------------------------------------

local function campSockets(model: Model, pattern: string): { CFrame }
	local list: { { Name: string, At: CFrame } } = {}
	for key, value in model:GetAttributes() do
		local name = string.match(key, "^Socket_(.+)$")
		if name and string.match(name, pattern) and typeof(value) == "CFrame" then
			table.insert(list, { Name = name, At = value })
		end
	end
	table.sort(list, function(a, b)
		return a.Name < b.Name
	end)
	local out = {}
	for _, item in list do
		table.insert(out, item.At)
	end
	return out
end

local function setupCamp()
	if not map or #campSpots == 0 or camp then
		return
	end
	local assets = ServerStorage:FindFirstChild("Assets")
	local art = assets and assets:FindFirstChild("Surface") and assets.Surface:FindFirstChild("Bldg_RaiderCamp")
	local spot = campSpots[rng:NextInteger(1, #campSpots)]
	local model: Model
	if art and art:IsA("Model") then
		model = art:Clone()
	else
		-- graybox until the art is in: a ring of crates and a pen at the back
		model = Instance.new("Model")
		local base = Instance.new("Part")
		base.Name = "Pen"
		base.Size = Vector3.new(20, 4, 1)
		base.Color = Color3.fromRGB(116, 86, 62)
		base.Anchored = true
		base.CFrame = CFrame.new(0, 2, 15)
		base.Parent = model
		model.PrimaryPart = base
		model.WorldPivot = CFrame.new()
		for i, at in { CFrame.new(-8, 0, 11), CFrame.new(0, 0, 12.5), CFrame.new(8, 0, 11) } do
			model:SetAttribute(`Socket_Crew{i}`, at)
		end
		for i, at in { CFrame.new(-12, 0, -6), CFrame.new(12, 0, -6), CFrame.new(-6, 0, -14), CFrame.new(6, 0, -14) } do
			model:SetAttribute(`Socket_Guard{i}`, at)
		end
	end
	model.Name = "RaiderCamp"
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
		end
	end
	local folder = workspace:FindFirstChild("SurfaceCamp") or Instance.new("Folder")
	folder.Name = "SurfaceCamp"
	folder.Parent = workspace
	model:PivotTo(spot.CFrame)
	model.Parent = folder
	for _, at in campSockets(model, "^Light") do
		local holder_ = Instance.new("Part")
		holder_.Name = "CampLight"
		holder_.Anchored = true
		holder_.CanCollide = false
		holder_.CanQuery = false
		holder_.CanTouch = false
		holder_.Transparency = 1
		holder_.Size = Vector3.new(0.2, 0.2, 0.2)
		holder_.CFrame = spot.CFrame * at
		holder_.Parent = model
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 160, 90)
		light.Range = 18
		light.Brightness = 1.5
		light.Parent = holder_
	end
	local posts = {}
	for _, at in campSockets(model, "^Guard") do
		table.insert(posts, spot.CFrame * at)
	end
	camp = { Model = model, CFrame = spot.CFrame, Hint = spot.Hint, Posts = posts, Guards = {}, Left = #posts, NearAt = 0 }
	-- the crew in the pen: three, one of them Rare (Section 12)
	local deep = Config.Get("Tuning", "Deep")
	local crewSpots = campSockets(model, "^Crew")
	local rare = rng:NextInteger(1, math.max(#crewSpots, 1))
	for i, at in crewSpots do
		rescue:Trap(spot.CFrame * at, {
			Kind = "Crew",
			Tier = if i == rare then "Rare" else "Common",
			Level = rng:NextInteger(deep.CrewLevel.Min, deep.CrewLevel.Max),
			Where = "the raider camp",
			Tag = CREW_TAG,
		})
	end
	log:Info("the raider camp stands %s with %d crew and %d guards", spot.Hint, #crewSpots, #posts)
end

-- Where the surface's Lost Crew is held, while any of them is still trapped (the radio logs' hint).
function SurfaceService:CrewWhere(): string?
	local c = camp
	if not c then
		return nil
	end
	for _, r in rescue:Tagged(CREW_TAG) do
		if r.State == "Trapped" then
			return `Brightwater Ruins, a raider camp {c.Hint}`
		end
	end
	return nil
end

local function campTick()
	local c = camp
	if not c or director:Phase() ~= "Playing" then
		return
	end
	local deep = Config.Get("Tuning", "Deep")
	local near = false
	for _, player in onSurface() do
		local root = rootOf(player)
		if root and (root.Position - c.CFrame.Position).Magnitude <= deep.CampWakeRange then
			near = true
		end
	end
	local out = 0
	for id in c.Guards do
		if monsterService:ZoneOf(id) then
			out += 1
		else
			c.Guards[id] = nil
		end
	end
	if near then
		c.NearAt = os.clock()
		if out == 0 and c.Left > 0 then
			-- the guards come out at their posts (the ones still standing)
			for i = 1, math.min(c.Left, #c.Posts) do
				local post = c.Posts[i]
				local id = monsterService:Spawn(raiderKind("AshRaider"), post + Vector3.new(0, 3, 0), CAMP_TAG, { Guard = deep.GuardRange })
				if id then
					c.Guards[id] = true
				end
			end
		end
	elseif out > 0 and os.clock() - c.NearAt > deep.CampSleepSeconds then
		for id in c.Guards do
			monsterService:Despawn(id)
		end
		table.clear(c.Guards)
	end
end

-- Storms ----------------------------------------------------------------------------------------

local function setStorm(on: boolean)
	if on and lootBoost then
		lootBoost = nil
		log:Info("the salvage boost ends with the storm")
	end
	if on then
		stormEarly = 0
		stormEarlyWarned = false
	end
	if on == storm then
		return
	end
	storm = on
	set("Storm", on)
	if on then
		set("StormAt", now())
		nextAt.AshWraith = os.clock() + randomIn(t().WraithEverySeconds) / 2
		for _, player in onSurface() do
			alert(player, "Danger", "THE STORM HITS: RADIATION IS RISING FAST AND ASH WRAITHS ARE OUT")
		end
	else
		for id, monsterType in creatures do
			local spec = Config.Find("Monsters", monsterType)
			if spec and spec.Traits and table.find(spec.Traits, "StormOnly") then
				monsterService:Despawn(id)
				creatures[id] = nil
			end
		end
	end
end

local function earlyWarnings()
	if RunState.Get("CyclePhase") ~= "Day" or storm then
		return
	end
	local endsAt = RunState.Get("PhaseEndsAt")
	if type(endsAt) ~= "number" then
		return
	end
	-- clock seconds left in the day (DevTools can run the clock faster: TimeScale)
	local scale = RunState.Get("TimeScale")
	local left = (endsAt - now()) * (if type(scale) == "number" and scale > 0 then scale else 1)
	-- Salvage Rights (Prompt 19): this storm hits stormEarly seconds before its Surge
	if stormEarly > 0 then
		local warn = Config.Get("Tuning", "Draft").StormEarlyWarnSeconds
		if not stormEarlyWarned and left <= stormEarly + warn then
			stormEarlyWarned = true
			for _, player in onSurface() do
				alert(player, "Warning", `THE STORM IS COMING EARLY: {math.ceil(math.max(left - stormEarly, 0))} S`)
			end
		end
		if left <= stormEarly then
			log:Info("the storm hits %d s early", stormEarly)
			setStorm(true)
			return
		end
	end
	local cycle = RunState.Get("Cycle") or 0
	for _, player in onSurface() do
		local extra = classValue(player, "StormWarningSeconds") or 0
		if extra > 0 and left <= t().StormSirenSeconds + extra and left > t().StormSirenSeconds and earlyWarned[player] ~= cycle then
			earlyWarned[player] = cycle
			alert(player, "Warning", `YOU HEAR THE STORM COMING: {math.ceil(left)} S`)
		end
	end
end

-- Creatures -------------------------------------------------------------------------------------

-- Landon (Prompt 16): about a third of Ash Raiders fight hand to hand (RaiderMeleeShare).
raiderKind = function(monsterType: string): string
	if monsterType == "AshRaider" and rng:NextNumber() < (t().RaiderMeleeShare or 0) then
		return "AshRaiderMelee"
	end
	return monsterType
end

local function spawnGroup(monsterType: string, range: { Min: number, Max: number }, room: number): number
	local spec = Config.Find("Monsters", monsterType)
	if not spec or room <= 0 then
		return 0
	end
	local positions = {}
	for _, player in onSurface() do
		local root = rootOf(player)
		if root then
			table.insert(positions, root.Position)
		end
	end
	local spot = Surface.SpawnSpot(spawnPoints, positions, range, rng)
	if not spot then
		return 0
	end
	local count = math.min(rng:NextInteger(spec.Group.Min, math.max(spec.Group.Min, spec.Group.Max)), room)
	for i = 1, count do
		local angle = i / count * math.pi * 2
		local at = (spot :: Vector3) + Vector3.new(math.cos(angle) * 3, 0, math.sin(angle) * 3)
		monsterService:Spawn(raiderKind(monsterType), CFrame.new(at + Vector3.new(0, 3, 0)), SURFACE_TAG)
	end
	log:Info("%d %s on the surface", count, monsterType)
	return count
end

local function creaturesTick()
	local players = onSurface()
	local tuning = t()
	if #players == 0 then
		if next(creatures) == nil then
			return
		end
		if emptySince == 0 then
			emptySince = os.clock()
		elseif os.clock() - emptySince > tuning.DespawnSeconds then
			for id in creatures do
				monsterService:Despawn(id)
			end
			table.clear(creatures)
			emptySince = 0
		end
		return
	end
	if emptySince ~= 0 or next(creatures) == nil then
		-- someone just came up: the first pack doesn't wait on the doorstep
		local soon = os.clock() + tuning.JackalEverySeconds.Min / 2
		nextAt.AshJackal = math.max(nextAt.AshJackal, soon)
		nextAt.AshRaider = math.max(nextAt.AshRaider, os.clock() + tuning.RaiderEverySeconds.Min / 2)
	end
	emptySince = 0
	-- a creature that fell out of the town (through a wall or a seam) is gone, not walking under it
	local floorY = if exitAt then (exitAt :: CFrame).Position.Y - FALL_GUARD else nil
	if floorY then
		for _, m in monsterService:All() do
			if creatures[m.Id] and m.Position.Y < floorY then
				log:Warn("%s fell out of the town at %s: removed", m.Id, tostring(m.Position))
				creatures[m.Id] = nil
				monsterService:Despawn(m.Id)
			end
		end
	end
	local count = 0
	for id in creatures do
		if monsterService:ZoneOf(id) then
			count += 1
		else
			creatures[id] = nil
		end
	end
	local room = tuning.MaxMonsters - count
	if room <= 0 or director:Phase() ~= "Playing" then
		return
	end
	if storm then
		if os.clock() >= nextAt.AshWraith then
			spawnGroup("AshWraith", tuning.WraithDistance, room)
			nextAt.AshWraith = os.clock() + randomIn(tuning.WraithEverySeconds)
		end
		return
	end
	if os.clock() >= nextAt.AshJackal then
		room -= spawnGroup("AshJackal", tuning.SpawnDistance, room)
		nextAt.AshJackal = os.clock() + randomIn(tuning.JackalEverySeconds)
	end
	if eraNumber() >= tuning.RaiderMinEra and os.clock() >= nextAt.AshRaider then
		spawnGroup("AshRaider", tuning.SpawnDistance, room)
		nextAt.AshRaider = os.clock() + randomIn(tuning.RaiderEverySeconds)
	end
end

-- Loops -----------------------------------------------------------------------------------------

local function tick(dt: number)
	for _, player in Players:GetPlayers() do
		local root = rootOf(player)
		if root then
			if not riding[player] then
				setZone(player, Surface.Zone(root.Position))
			end
			radiationTick(player, root, dt)
		end
	end
	earlyWarnings()
end

local function loop()
	local last = os.clock()
	local creatureAt = 0
	while true do
		task.wait(t().TickSeconds)
		local clockNow = os.clock()
		local dt = math.min(clockNow - last, 2)
		last = clockNow
		local ok, err = pcall(tick, dt)
		if not ok then
			log:Warn("tick: %s", tostring(err))
		end
		if clockNow >= creatureAt then
			creatureAt = clockNow + 1
			local okC, errC = pcall(creaturesTick)
			if not okC then
				log:Warn("creatures: %s", tostring(errC))
			end
			local okK, errK = pcall(campTick)
			if not okK then
				log:Warn("camp: %s", tostring(errK))
			end
		end
	end
end

local function clear()
	for id in creatures do
		monsterService:Despawn(id)
	end
	table.clear(creatures)
	local c = camp
	if c then
		for id in c.Guards do
			monsterService:Despawn(id)
		end
		table.clear(c.Guards)
	end
	if storm then
		setStorm(false)
	end
end

-- Dev -------------------------------------------------------------------------------------------

local function targetPlayer(player: Player?, name: any): Player?
	if type(name) == "string" and name ~= "" then
		for _, p in Players:GetPlayers() do
			if string.lower(p.Name) == string.lower(name) or string.lower(p.DisplayName) == string.lower(name) then
				return p
			end
		end
	end
	return player or Players:GetPlayers()[1]
end

local function describe(): string
	local looted, lockedCount = 0, 0
	for _, c in containers do
		if c.Looted then
			looted += 1
		end
		if c.Locked then
			lockedCount += 1
		end
	end
	local creatureCount = 0
	for _ in creatures do
		creatureCount += 1
	end
	local lines = {
		`map {if map then "found" else "MISSING"} · storm {storm} · {#containers} containers ({looted} searched, {lockedCount} locked) · {creatureCount} creatures up`,
		`survivor spots {#survivorSpots}, find spots {#findSpots}, spawn points {#spawnPoints}, trapped {rescue:Count("Trapped")}`,
	}
	for _, player in Players:GetPlayers() do
		table.insert(lines, `  {player.Name}: {SurfaceService:Zone(player)}, radiation {string.format("%.1f", radiation[player] or 0)}, {inventory:PackLine(player)}, pills {inventory:Pills(player)}`)
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("surface", {
		Description = "The surface: map, storm, containers, creatures, players' zones and radiation (Prompt 16).",
		Usage = "surface",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("surface.up", {
		Description = "Ride the elevator up (as if holding RIDE UP).",
		Usage = "surface.up [player]",
		Run = function(player, args): string?
			local p = targetPlayer(player, args[1])
			if not p then
				return "no player"
			end
			ride(p, "Up")
			return `{p.Name} going up`
		end,
	})
	dev:Register("surface.down", {
		Description = "Ride the elevator down.",
		Usage = "surface.down [player]",
		Run = function(player, args): string?
			local p = targetPlayer(player, args[1])
			if not p then
				return "no player"
			end
			ride(p, "Down")
			return `{p.Name} going down`
		end,
	})
	dev:Register("rad", {
		Description = "Set your radiation (0 to 100).",
		Usage = "rad <n> [player]",
		Run = function(player, args): string?
			local p = targetPlayer(player, args[2])
			if not p then
				return "no player"
			end
			radiation[p] = math.clamp(tonumber(args[1]) or 0, 0, Config.Get("Tuning", "Player").RadiationMax)
			publishRadiation(p, radiation[p])
			return `{p.Name}: radiation {radiation[p]}`
		end,
	})
	dev:Register("storm", {
		Description = "Start or stop the storm over the surface (the next Surge sets it again).",
		Usage = "storm <on|off>",
		Run = function(_, args): string?
			setStorm(tostring(args[1] or "on") ~= "off")
			return `storm {storm}`
		end,
	})
	dev:Register("loot.refill", {
		Description = "Refill every surface container now (as at a new era).",
		Usage = "loot.refill",
		Run = function(): string?
			refill("dev")
			return `{#containers} containers refilled`
		end,
	})
	dev:Register("surface.spawn", {
		Description = "Spawn a surface creature group by the players on the surface.",
		Usage = "surface.spawn <AshJackal|AshRaider|AshWraith> [room]",
		Run = function(_, args): string?
			local monsterType = tostring(args[1] or "AshJackal")
			local n = spawnGroup(monsterType, if monsterType == "AshWraith" then t().WraithDistance else t().SpawnDistance,
				math.floor(tonumber(args[2]) or 6))
			return `{n} {monsterType}`
		end,
	})
	dev:Register("survivor", {
		Description = "Trap a survivor at a free spot on the surface.",
		Usage = "survivor",
		Run = function(): string?
			return trapSurvivor() or "no free survivor spot"
		end,
	})
	dev:Register("surface.find", {
		Description = "Put generator parts at a free find spot on the surface.",
		Usage = "surface.find",
		Run = function(): string?
			return placeFind() or "no free find spot"
		end,
	})
end

-- Magnet Sweep (Prompt 20): every unsearched, unlocked container within `radius` of `position` is
-- searched into the player's backpack, as if they held SEARCH at each. Returns how many.
function SurfaceService:SearchNear(player: Player, position: Vector3, radius: number): number
	local n = 0
	for _, c in containers do
		if not c.Looted and not c.Locked then
			local at = c.Model:GetPivot().Position
			if (at - position).Magnitude <= radius then
				search(c, player)
				n += 1
			end
		end
	end
	return n
end

-- Salvage Rights (Prompt 19): containers give `multiplier` times the loot until the next storm.
function SurfaceService:SetLootBoost(multiplier: number)
	lootBoost = if multiplier > 1 then multiplier else nil
	log:Info("loot x%.1f until the next storm", multiplier)
end

-- Salvage Rights (Prompt 19): the next storm hits `seconds` before its Surge.
function SurfaceService:SetStormEarly(seconds: number)
	stormEarly = math.max(stormEarly, seconds)
	stormEarlyWarned = false
end

function SurfaceService:Init(registry)
	clock = registry.CycleClock
	director = registry.RunDirector
	grid = registry.BunkerGrid
	power = registry.PowerService
	combat = registry.CombatService
	monsterService = registry.MonsterService
	inventory = registry.InventoryService
	rescue = registry.RescueService
	set = RunState.Writer("SurfaceService")
	registerCommands(registry.DevService)
end

function SurfaceService:Start()
	set("Storm", false)
	readMap()
	refill("start")
	local okCamp, errCamp = pcall(setupCamp)
	if not okCamp then
		log:Warn("the raider camp: %s", tostring(errCamp))
	end
	syncHallElevator()
	grid.Changed:Connect(syncHallElevator)
	clock.EraChanged:Connect(function()
		refill("new era")
	end)
	clock.CycleStarted:Connect(newDay)
	clock.SirenStarted:Connect(function()
		if storm then
			return -- it hit early (Salvage Rights)
		end
		local endsAt = RunState.Get("PhaseEndsAt")
		if type(endsAt) == "number" then
			set("StormAt", endsAt)
		end
		for _, player in onSurface() do
			alert(player, "Warning", `THE STORM HITS IN {t().StormSirenSeconds} S: GET BACK TO THE ELEVATOR`)
		end
	end)
	clock.SurgeStarted:Connect(function()
		setStorm(true)
	end)
	clock.SurgeEnded:Connect(function()
		setStorm(false)
	end)
	monsterService.Spawned:Connect(function(id: string, monsterType: string, tag: string?)
		if tag == SURFACE_TAG then
			creatures[id] = monsterType
		end
	end)
	monsterService.Died:Connect(function(id: string)
		creatures[id] = nil
		local c = camp
		if c and c.Guards[id] then
			c.Guards[id] = nil
			c.Left = math.max(c.Left - 1, 0)
			if c.Left == 0 then
				for _, player in onSurface() do
					alert(player, "Info", "THE RAIDER CAMP IS CLEARED: FREE THE CREW IN THE PEN")
				end
			end
		end
	end)
	combat.Damaged:Connect(function(targetId: string, amount: number, sourceId: string?)
		if amount <= 0 or not sourceId or string.sub(sourceId, 1, 1) ~= "M" or string.sub(targetId, 1, 1) ~= "P" then
			return
		end
		local source = combat:Get(sourceId)
		local spec = source and source.MonsterType and Config.Find("Monsters", source.MonsterType)
		if spec and spec.Traits and table.find(spec.Traits, "Radiates") then
			local target = combat:Get(targetId)
			local player = target and target.Player
			if player then
				SurfaceService:AddRadiation(player, t().WraithRadiationPerHit * (classValue(player, "RadiationGain") or 1), "wraith")
			end
		end
	end)
	local function joined(player: Player)
		radiation[player] = 0
		player:SetAttribute("Radiation", 0)
		player:SetAttribute("Zone", "Bunker")
		player.CharacterAdded:Connect(function()
			-- Landon (Prompt 16): a new life keeps half the radiation the last one had
			local kept = math.floor((radiation[player] or 0) / 2 + 0.5)
			radiation[player] = kept
			warned[player] = 0
			player:SetAttribute("Radiation", kept)
		end)
	end
	for _, player in Players:GetPlayers() do
		joined(player)
	end
	Players.PlayerAdded:Connect(joined)
	Players.PlayerRemoving:Connect(function(player: Player)
		radiation[player] = nil
		warned[player] = nil
		earlyWarned[player] = nil
		riding[player] = nil
	end)
	director.RunEnded:Connect(clear)
	task.spawn(loop)
end

return SurfaceService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000114"><Properties><string name="Name">ThreatDirector</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ThreatDirector: the danger budget (bible Section 10). Run place only; Prompt 12.

	* The threat level rises with the year, the deepest floor, Disturbance, bunker size and
	  player count (Rules.Threat.Level, Tuning.Threat). It is published as RunState.Threat.
	* Each Surge gets a budget from the threat level (the first cycle's is the small tutorial
	  wave, Section 5; a first run's Era I is 30% easier, Section 22) and spends it on monster
	  groups from the era's roster (Rules.Threat.Groups), opened at weighted breach points
	  (BreachService), up to MaxBreachPointsPerSurge places, in waves WaveSpacingSeconds apart.
	  Boss Surges bring their boss instead (Prompt 15). A Normal or Endless Surge first pays for
	  its one disaster from the budget (Section 5; DisasterService:SurgeDisaster, Prompt 13); the
	  Tutorial Surge is a small wave with no disaster.
	* A Surge ends as soon as its last monster dies and its disaster is fixed (Section 5):
	  CycleClock:EndSurge. Monsters left when a Surge times out stay and keep fighting.
	* Between Surges it spends TrickleBudget a cycle on single monsters at weighted points (not in
	  the first cycle, so the tutorial day stays calm), and minor incidents (Section 10): each day
	  from the second may bring one electrical surge (Rules.Disasters.ElectricalChance by era, at a
	  random moment of the day, in a random room).
	* Disturbance (DigService, Prompt 14) calls ExtraBreach at 50 and Tremor at 100; a nest dug open
	  calls Burst.
	* At most 25 monsters are on the map at once: MonsterService queues the rest.

	API:
		ThreatDirector:Level(): number
		ThreatDirector:SpendSurge(kind?): number      -- the wave now (DevTools; Tremor)
		ThreatDirector:ExtraBreach(): boolean        -- Disturbance 50 (Section 10)
		ThreatDirector:Tremor(): number              -- Disturbance 100: a full wave at once
		ThreatDirector:Burst(fraction, at, tag): number -- Prompt 14: a nest's monsters, at once
		ThreatDirector:IsFirstRun(): boolean         -- Prompt 15: someone's first run (a weaker Brood Mother)
		ThreatDirector:SetDisasterCheck(fn)          -- replaces DisasterService:HoldsSurge (tests)
	Dev: threat, surge.wave.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Disasters = require(Shared.Rules.Disasters)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Threat = require(Shared.Rules.Threat)

local log = Log.new("ThreatDirector")

local ThreatDirector = {
	Name = "ThreatDirector",
	Dependencies = {
		"CycleClock", "RunDirector", "BunkerGrid", "SessionService", "ProfileService", "BreachService", "MonsterService",
		"DisasterService", "DevService",
	},
}

local clock: any = nil
local director: any = nil
local grid: any = nil
local session: any = nil
local profiles: any = nil
local breaches: any = nil
local monsters: any = nil
local disasters: any = nil
local dev: any = nil
local set: (string, any) -> () = function() end

local rng = Random.new()
local surge: { Tag: string, Expected: number, Spawned: number, WavesLeft: number, LastWaveAt: number }? = nil
local trickle = 0
local disasterActive: () -> boolean = function()
	return false
end

local function tuning(): { [string]: any }
	return Config.Get("Tuning", "Threat")
end

local function disturbance(): number
	local ok, value = pcall(RunState.Get, "Disturbance")
	return if ok and type(value) == "number" then value else 0
end

local function firstRunEraI(): boolean
	if Threat.EraNumber(clock:Era()) ~= 1 then
		return false
	end
	for _, player in session:ReadyPlayers() do
		local data = profiles:Get(player)
		if data and data.FirstRunDone == false then
			return true
		end
	end
	return false
end

-- Is this an account's first run for anyone in it (Section 22: Era I is 30% easier and the Brood
-- Mother weaker)? Unlike the Era I easing, true in any era (the Brood Mother can come in Year 27).
function ThreatDirector:IsFirstRun(): boolean
	for _, player in session:ReadyPlayers() do
		local data = profiles:Get(player)
		if data and data.FirstRunDone == false then
			return true
		end
	end
	return false
end

function ThreatDirector:Level(): number
	return Threat.Level({
		Year = clock:Year(),
		DeepestFloor = grid:DeepestFloor(),
		Disturbance = disturbance(),
		Rooms = #grid:Rooms(),
		Players = math.max(#session:ReadyPlayers(), 1),
	})
end

-- Water (Prompt 23; the Appendix: Murklings "pour out of water"). A room flooded to
-- Tuning.Disasters.Flood.MurklingLevel is a breach point of its own, "W:<room>", that only
-- monsters with the FromWater trait use; when no room is that wet they come the usual ways.
local waterPoints: { [string]: boolean } = {}

local function syncWater()
	local level = Config.Get("Tuning", "Disasters").Flood.MurklingLevel
	local want: { [string]: boolean } = {}
	for _, room in grid:Rooms() do
		if room.Type ~= "Shaft" and (disasters:Flooded(room.Id) or 0) >= level then
			want[`W:{room.Id}`] = true
			if not waterPoints[`W:{room.Id}`] then
				local cell = Grid.CellPosition(room.Floor, room.Column + (room.Span - 1) // 2)
				local out = cell + Vector3.new(0, 0.5, 2)
				breaches:SetExtraPoint(`W:{room.Id}`, {
					Id = `W:{room.Id}`, Kind = "Water", RoomId = room.Id, Floor = room.Floor, Column = room.Column,
					Weight = 1, Dark = false, At = CFrame.lookAt(out, out + Vector3.new(0, 0, 1)), Source = cell + Vector3.new(0, 1, 0),
				})
			end
		end
	end
	for id in waterPoints do
		if not want[id] then
			breaches:SetExtraPoint(id, nil)
		end
	end
	waterPoints = want
end

local function fromWater(monsterType: string): boolean
	local spec = Config.Find("Monsters", monsterType)
	return spec ~= nil and spec.Traits ~= nil and table.find(spec.Traits, "FromWater") ~= nil
end

local spendAt: (groups: { Threat.Group }, tag: string, places: number, spacing: number, water: boolean) -> number

-- Opens groups at up to `places` weighted points, in waves `spacing` seconds apart. Groups that
-- come out of water go to the flooded rooms when there are any.
local function spend(groups: { Threat.Group }, tag: string, places: number, spacing: number): number
	pcall(syncWater)
	if next(waterPoints) == nil then
		return spendAt(groups, tag, places, spacing, false)
	end
	local wet, dry = {}, {}
	for _, group in groups do
		table.insert(if fromWater(group.Type) then wet else dry, group)
	end
	return spendAt(dry, tag, places, spacing, false) + spendAt(wet, tag, places, spacing, true)
end

function spendAt(groups: { Threat.Group }, tag: string, places: number, spacing: number, water: boolean): number
	if #groups == 0 then
		return 0
	end
	local points: { any } = {}
	local taken: { [string]: boolean } = {}
	if water then
		for id in waterPoints do
			table.insert(points, { Id = id })
		end
		table.sort(points, function(a, b)
			return a.Id < b.Id
		end)
		while #points > math.max(1, places) do
			table.remove(points, rng:NextInteger(1, #points))
		end
	else
		for id in waterPoints do
			taken[id] = true -- nothing but water's own creatures comes out of the water
		end
	end
	for _ = 1, if water then 0 else math.max(1, places) do
		local point = breaches:Pick(rng, taken)
		if point then
			taken[point.Id] = true
			table.insert(points, point)
		end
	end
	if #points == 0 then
		log:Warn("no breach points: %d groups not spent", #groups)
		return 0
	end
	local waves = math.min(#groups, 4)
	local byWave: { { Threat.Group } } = {}
	for i, group in groups do
		local w = (i - 1) % waves + 1
		byWave[w] = byWave[w] or {}
		table.insert(byWave[w], group)
	end
	local total = 0
	for w, list in byWave do
		for _, group in list do
			total += group.Count
		end
		local point = points[(w - 1) % #points + 1]
		task.delay((w - 1) * spacing, function()
			if not breaches:Open(point.Id, list, tag) and water then
				-- the room dried out first: the usual way in instead
				local other = breaches:Pick(rng, table.clone(waterPoints))
				if other then
					breaches:Open(other.Id, list, tag)
				end
			end
			if surge and surge.Tag == tag then
				surge.WavesLeft -= 1
				surge.LastWaveAt = os.clock()
			end
		end)
	end
	return total
end

function ThreatDirector:SpendSurge(kind: string?): number
	local level = ThreatDirector:Level()
	local surgeKind = kind or clock:Surge() or "Normal"
	local budget = Threat.SurgeBudget(level, surgeKind, firstRunEraI())
	if budget <= 0 then
		return 0
	end
	-- Section 5: a Surge brings a breach wave and one disaster; the disaster is paid for first
	local disasterCost = 0
	if surgeKind == "Normal" or surgeKind == "Endless" then
		disasterCost = disasters:SurgeDisaster(budget, rng)
		budget -= disasterCost
	end
	local groups = Threat.Groups(budget, Threat.Roster(clock:Era()), rng)
	local tag = `Surge:{clock:Cycle()}`
	local waves = math.min(#groups, 4)
	surge = { Tag = tag, Expected = 0, Spawned = 0, WavesLeft = waves, LastWaveAt = os.clock() }
	local t = tuning()
	local total = spend(groups, tag, math.min(t.MaxBreachPointsPerSurge, waves), t.WaveSpacingSeconds)
	if surge and surge.Tag == tag then
		surge.Expected = total
	end
	log:Info("%s Surge (threat %.1f, budget %.1f after %d for its disaster): %d monsters in %d groups", surgeKind, level,
		budget, disasterCost, total, #groups)
	return total
end

-- Disturbance's breaches (Prompt 14) are priced like a normal Surge now, so the first run's Era I
-- is easier for them too: a quarter of one for the extra breach, a whole one for a Tremor.
function ThreatDirector:ExtraBreach(): boolean
	local budget = Threat.SurgeBudget(ThreatDirector:Level(), "Normal", firstRunEraI()) * 0.25
	local groups = Threat.Groups(budget, Threat.Roster(clock:Era()), rng)
	return spend(groups, "Extra", 1, 0) > 0
end

function ThreatDirector:Tremor(): number
	local budget = Threat.SurgeBudget(ThreatDirector:Level(), "Normal", firstRunEraI())
	local groups = Threat.Groups(budget, Threat.Roster(clock:Era()), rng)
	return spend(groups, "Tremor", tuning().MaxBreachPointsPerSurge, 0)
end

-- Monsters all at once at one spot, no warning (Prompt 14: a nest pours its monsters out when it is
-- dug open): `fraction` of what a normal Surge would spend now (so the first run's Era I is
-- easier here too), bought like any group.
function ThreatDirector:Burst(fraction: number, at: CFrame, tag: string): number
	local budget = Threat.SurgeBudget(ThreatDirector:Level(), "Normal", firstRunEraI()) * fraction
	local groups = Threat.Groups(budget, Threat.Roster(clock:Era()), rng)
	local n = 0
	for _, group in groups do
		for _ = 1, group.Count do
			local offset = CFrame.new(((n % 3) - 1) * 2.2, 0, -math.floor(n / 3) * 1.6)
			monsters:Spawn(group.Type, at * offset, tag)
			n += 1
		end
	end
	log:Info("burst of %d monsters (%s)", n, tag)
	return n
end

function ThreatDirector:SetDisasterCheck(fn: () -> boolean)
	disasterActive = fn
end

-- A Surge ends as soon as its last monster dies and its disaster is fixed (Section 5).
local function checkCleared()
	if not surge or clock:Phase() ~= "Surge" then
		return
	end
	local current = surge
	if current.WavesLeft > 0 then
		return
	end
	local spawnedAll = current.Spawned >= current.Expected or os.clock() - current.LastWaveAt > 25
	if spawnedAll and monsters:Count(current.Tag) == 0 and not disasterActive() then
		surge = nil
		if clock:EndSurge() then
			log:Info("%s cleared: the Surge ends", current.Tag)
		end
	end
end

local function cheapest(roster: { string }): (string?, number)
	local best, cost = nil, math.huge
	for _, id in roster do
		local monster = Config.Get("Monsters", id)
		if monster.ThreatCost < cost then
			best, cost = id, monster.ThreatCost
		end
	end
	return best, cost
end

-- Between Surges: small spends on single monsters (Section 10).
local function trickleTick(dt: number)
	if clock:Phase() ~= "Day" or clock:Cycle() <= 1 or director:Phase() ~= "Playing" then
		return
	end
	local cycleSeconds = 270 / math.max(clock:TimeScale(), 0.01)
	trickle += Threat.TrickleBudget(ThreatDirector:Level(), firstRunEraI()) * dt / cycleSeconds
	local roster = Threat.Roster(clock:Era())
	local _, cost = cheapest(roster)
	if trickle < cost then
		return
	end
	local affordable = {}
	for _, id in roster do
		if Config.Get("Monsters", id).ThreatCost <= trickle then
			table.insert(affordable, id)
		end
	end
	local id = affordable[rng:NextInteger(1, #affordable)]
	trickle -= Config.Get("Monsters", id).ThreatCost
	spend({ { Type = id, Count = 1 } }, "Trickle", 1, 0)
end

function ThreatDirector:Init(registry)
	clock = registry.CycleClock
	director = registry.RunDirector
	grid = registry.BunkerGrid
	session = registry.SessionService
	profiles = registry.ProfileService
	breaches = registry.BreachService
	monsters = registry.MonsterService
	disasters = registry.DisasterService
	disasterActive = function(): boolean
		return disasters:HoldsSurge()
	end
	dev = registry.DevService
	set = RunState.Writer("ThreatDirector")

	dev:Register("threat", {
		Description = "The threat level, its inputs, the Surge's wave and the monsters (Prompt 12).",
		Usage = "threat",
		Run = function(): string?
			local level = ThreatDirector:Level()
			local lines = {
				string.format("threat %.1f: year %d, deepest floor %d, Disturbance %d, %d rooms, %d players",
					level, clock:Year(), grid:DeepestFloor(), disturbance(), #grid:Rooms(), math.max(#session:ReadyPlayers(), 1)),
				string.format("Surge budget %.1f (%s), between Surges %.1f a cycle (saved %.2f); first-run Era I: %s",
					Threat.SurgeBudget(level, clock:Surge() or "Normal", firstRunEraI()), tostring(clock:Surge()),
					Threat.TrickleBudget(level, firstRunEraI()), trickle, tostring(firstRunEraI())),
				`roster: {table.concat(Threat.Roster(clock:Era()), ", ")}`,
				if surge then `this Surge ({surge.Tag}): {surge.Spawned}/{surge.Expected} out, {surge.WavesLeft} waves to come, {monsters:Count(surge.Tag)} alive or queued` else "no Surge wave running",
				`monsters: {monsters:Count()} ({monsters:Queued()} queued)`,
			}
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("surge.wave", {
		Description = "Spend a Surge's budget now (Normal unless a kind is given).",
		Usage = "surge.wave [Tutorial|Normal]",
		Run = function(_player, args): string?
			local total = ThreatDirector:SpendSurge(if args[1] then tostring(args[1]) else "Normal")
			return `{total} monsters coming`
		end,
	})
end

function ThreatDirector:Start()
	clock.SurgeStarted:Connect(function(kind: string)
		if director:Phase() ~= "Playing" then
			return
		end
		task.spawn(function()
			ThreatDirector:SpendSurge(kind)
		end)
	end)
	clock.SurgeEnded:Connect(function()
		surge = nil
	end)
	-- minor incidents (Section 10): an electrical surge on some days, in a random room
	clock.CycleStarted:Connect(function(cycle: number)
		if cycle <= 1 or director:Phase() ~= "Playing" then
			return
		end
		local era = Threat.EraNumber(clock:Era())
		if rng:NextNumber() >= Disasters.ElectricalChance(era) then
			return
		end
		local dayScale = math.max(clock:TimeScale(), 0.01)
		task.delay(rng:NextNumber(25, 150) / dayScale, function()
			if clock:Phase() ~= "Day" or director:Phase() ~= "Playing" then
				return
			end
			local options = {}
			for _, room in grid:Rooms() do
				if room.Type ~= "Shaft" and not room.Wrecked then
					table.insert(options, room.Id)
				end
			end
			if #options > 0 then
				disasters:StartElectricalSurge(options[rng:NextInteger(1, #options)], "Incident")
			end
		end)
	end)
	-- a Bloat Toad's burst floods its room (Prompt 23): water and no pipe, so it drains by itself
	monsters.Burst:Connect(function(_id: string, _type: string, _at: Vector3, unit: string?)
		if unit and grid:Room(unit) then
			disasters:StartFlood(unit, "BloatToad", Config.Get("Tuning", "Disasters").Flood.BurstLevel, false)
		end
	end)
	monsters.Spawned:Connect(function(_id: string, _type: string, tag: string?)
		if surge and tag == surge.Tag then
			surge.Spawned += 1
		end
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local dt = os.clock() - last
			last = os.clock()
			pcall(checkCleared)
			pcall(syncWater)
			pcall(trickleTick, dt)
			pcall(function()
				set("Threat", math.floor(ThreatDirector:Level() + 0.5))
				set("Monsters", monsters:Count())
			end)
		end
	end)
	log:Info("threat director ready")
end

return ThreatDirector
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000115"><Properties><string name="Name">VoteService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VoteService: team votes (bible Section 8). Run place only.

	Anything that spends the shared stockpile or changes the run for everyone goes to a quick
	vote. Prompt 8 runs construction votes (BuildService opens them). Push Deeper (Prompt 14),
	the blueprint draft (19), Keep Going (15), Let them in? (30) and kicks (30) will open theirs
	here too.

	How a vote runs:
	* One vote is live on the banner at a time. Later proposals wait in a queue, and each gets
	  its full time once it goes live, so nothing runs out of time unseen.
	* The proposer counts as a yes. Not voting is abstaining, and a player can change their
	  vote until it closes.
	* Rules (Rules.Votes):
	  * a build passes with more yes than no after 15 s;
	  * spending more than 40% of a stock needs a majority of the whole team;
	  * everyone yes passes at once;
	  * ties fail. A tie-breaker (the Warden, Prompt 20: SetTieBreaker) decides one: it gets the
	    vote's ballots and answers with a ballot ("Yes", "No", a draft card's id) or nil.
	* Each player has at most one open proposal (queued or live). A failed one gives that
	  player a 20 s cooldown.
	* Solo runs have no votes: a proposal is checked again and applies at once.
	* When a vote passes, its Check runs again (costs, the cells still free). If that fails
	  now, the vote fails with the reason.
	* The Votes collection (id -> what the banner shows) replicates to every player. A closed
	  vote stays ResultSeconds with PASSED or FAILED, then goes.
	* Studio: `vote.bots <n> [yes|no|abstain]` adds pretend voters to the team, so the team
	  rules can be tried in a one-player playtest.
	* Draft votes (Prompt 19, the blueprint draft): a spec with Options is a MostVotes vote. Each
	  player picks one option (CastPick) and can change it until the vote closes; when time is up
	  the option with the most picks wins, ties picked at random (Rules.Votes.Winner), and OnPass
	  gets the winner. Everyone having picked closes it at once. Solo runs vote too: the player's
	  pick is the team's (Section 8, rule 6), and it closes the vote at once. SetOptions swaps the
	  options of an open draft (a reroll): the picks are cleared and, with
	  Tuning.Draft.RerollRestartsTimer, the time starts over.

	API:
		VoteService:Open(spec): (string?, string?)     -- the vote id ("solo" when it applied at once), or why not
		VoteService:Cast(player, id, "Yes" | "No" | option id): (boolean, string?)
		VoteService:SetOptions(id, options): boolean           -- a draft's new cards (a reroll)
		VoteService:Live(): (string?, Spec?)                    -- the vote on the banner
		VoteService:CanPropose(player): (boolean, string?)
		VoteService:Reserved(exceptId?): { [string]: boolean }  -- cell keys held by open votes
		VoteService:TeamSize(): number
		VoteService:SetTieBreaker(fn: (voteId, ballots) -> string?)
		VoteService.Opened: Signal<string>, VoteService.Closed: Signal<string, boolean, string?>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local Votes = require(Shared.Rules.Votes)

local log = Log.new("VoteService")

export type Option = {
	Id: string, -- what OnPass gets when it wins (a draft card's id)
	Title: string, -- "REINFORCED WALLS"
	Kind: string?, -- a draft card's kind (Room, BunkerPerk...)
	Label: string?, -- its kind tag: "BUNKER PERK"
	Text: string?, -- its short text
	Found: string?, -- a found blueprint: who found it ("FOUND BY LANDON")
}

export type Spec = {
	Kind: string, -- a Config.Votes id
	Proposer: Player?, -- nil for votes the game opens
	Title: string, -- what is proposed: "KITCHEN", "QUARTERS TO LEVEL 2"
	Costs: { [string]: number }?, -- shown on the banner; a big spend needs a team majority
	Refund: { [string]: number }?, -- shown on the banner: what comes back (a tear-down)
	Subject: { Floor: number, Column: number, Span: number, Label: string }?, -- the ghost outline
	Cells: { string }?, -- cell keys it holds while open
	Check: (() -> (boolean, string?))?, -- run again when it passes
	Options: { Option }?, -- a MostVotes vote (Prompt 19's draft): one of these wins
	OnPass: (pick: string?) -> (), -- a draft's winner (nil for a yes or no vote)
	OnFail: ((reason: string) -> ())?,
}

type Ballot = string -- "Yes" or "No", or a draft option's Id
type Status = "Queued" | "Live" | "Passed" | "Failed"
type Vote = {
	Id: string,
	Spec: Spec,
	Rule: Votes.Rule,
	Status: Status,
	Ballots: { [number]: Ballot }, -- by UserId; pretend voters are negative
	EndsAt: number?,
	Result: string?,
	Winner: string?, -- a draft's winning option
}

local VoteService = {
	Name = "VoteService",
	Dependencies = { "SessionService", "ReplicationService", "DevService" },
	Opened = Signal.new() :: Signal.Signal<string>,
	Closed = Signal.new() :: Signal.Signal<string, boolean, string?>,
}

local session: any = nil
local collection: any = nil
local votes: { [string]: Vote } = {}
local queue: { string } = {} -- open votes in order; the first is live
local cooldowns: { [number]: number } = {} -- UserId -> os.clock() it ends
local nextId = 0
local tieBreaker: ((string, { [number]: string }) -> string?)? = nil
local pickRandom = Random.new() -- draft ties
local bots: { [number]: Ballot | false } = {} -- Studio: pretend voters (-1, -2, ...); false abstains

local function now(): number
	return workspace:GetServerTimeNow()
end

local function tuning(): { [string]: any }
	return Votes.Tuning()
end

-- Everyone who can vote: ready players, plus pretend voters in Studio.
local function team(): { number }
	local ids = {}
	for _, player in session:ReadyPlayers() do
		table.insert(ids, player.UserId)
	end
	for id in bots do
		table.insert(ids, id)
	end
	return ids
end

function VoteService:TeamSize(): number
	return #team()
end

local function count(vote: Vote): (number, number, number)
	local members = team()
	local yes, no = 0, 0
	for _, id in members do
		local ballot = vote.Ballots[id]
		if ballot == "Yes" then
			yes += 1
		elseif ballot == "No" then
			no += 1
		end
	end
	return yes, no, #members
end

local function optionIds(vote: Vote): { string }
	local ids = {}
	for _, option in vote.Spec.Options or {} do
		table.insert(ids, option.Id)
	end
	return ids
end

-- A draft's picks: votes per option, and how many of the team have picked.
local function tallyOptions(vote: Vote): ({ [string]: number }, number)
	local counts: { [string]: number } = {}
	for _, option in vote.Spec.Options or {} do
		counts[option.Id] = 0
	end
	local picked = 0
	for _, id in team() do
		local choice = vote.Ballots[id]
		if choice and counts[choice] ~= nil then
			counts[choice] += 1
			picked += 1
		end
	end
	return counts, picked
end

local function nameOf(player: Player?): string
	return if player then string.upper(player.DisplayName) else "THE BUNKER"
end

local function publish(vote: Vote)
	local yes, no, size = count(vote)
	local ballots = {}
	for id, ballot in vote.Ballots do
		ballots[tostring(id)] = ballot
	end
	local position = table.find(queue, vote.Id)
	local spec = vote.Spec
	local options: { any }? = nil
	local picked = 0
	if spec.Options then
		local counts
		counts, picked = tallyOptions(vote)
		local list = {}
		for _, option in spec.Options do
			table.insert(list, {
				Id = option.Id,
				Title = option.Title,
				Kind = option.Kind,
				Label = option.Label,
				Text = option.Text,
				Found = option.Found,
				Votes = counts[option.Id] or 0,
			})
		end
		options = list
	end
	collection:Set(vote.Id, {
		Kind = spec.Kind,
		Title = spec.Title,
		Proposer = if spec.Proposer then spec.Proposer.UserId else 0,
		ProposerName = nameOf(spec.Proposer),
		Cost = if spec.Costs then Construction.CostText(spec.Costs) else "",
		Refund = if spec.Refund and next(spec.Refund) then Construction.CostText(spec.Refund) else nil,
		Rule = vote.Rule,
		Need = Votes.NeedText(vote.Rule, size),
		Status = vote.Status,
		EndsAt = vote.EndsAt,
		Seconds = Config.Get("Votes", spec.Kind).Seconds,
		Yes = yes,
		No = no,
		Team = size,
		Waiting = if position and position > 1 then position - 1 else 0,
		Ballots = ballots,
		Subject = spec.Subject,
		Result = vote.Result,
		Options = options, -- a draft's cards with their picks (Prompt 19)
		Picked = if options then picked else nil,
		Winner = vote.Winner,
	})
end

local function publishQueue()
	for _, id in queue do
		local vote = votes[id]
		if vote then
			publish(vote)
		end
	end
end

local function stockNow(): { [string]: number }
	local stockpile = {}
	for _, resource in Config.Ids("Resources") do
		local value = RunState.Fields[resource] and RunState.Get(resource)
		if type(value) == "number" then
			stockpile[resource] = value
		end
	end
	return stockpile
end

local function goLive()
	local id = queue[1]
	local vote = if id then votes[id] else nil
	if not vote or vote.Status ~= "Queued" then
		return
	end
	vote.Status = "Live"
	-- the 40% rule against the stockpile as it is when the team votes
	vote.Rule = Votes.RuleFor(vote.Spec.Kind, Votes.BigSpend(vote.Spec.Costs, stockNow()))
	vote.EndsAt = now() + Config.Get("Votes", vote.Spec.Kind).Seconds
	if not vote.Spec.Options then -- pretend voters pick draft cards only when told to (vote.pick)
		for botId, stance in bots do
			if stance then
				vote.Ballots[botId] = stance
			end
		end
	end
	log:Info("%s live: %s (%s)", vote.Id, vote.Spec.Title, vote.Rule)
	VoteService.Opened:Fire(vote.Id)
	publishQueue()
end

local function titleOf(vote: Vote, optionId: string?): string
	for _, option in vote.Spec.Options or {} do
		if option.Id == optionId then
			return option.Title
		end
	end
	return tostring(optionId)
end

local function close(vote: Vote, passed: boolean, reason: string?, pick: string?)
	if vote.Status ~= "Live" and vote.Status ~= "Queued" then
		return
	end
	if passed and vote.Spec.Check then
		local ok, why = vote.Spec.Check()
		if not ok then
			passed, reason = false, why or "it can't be done any more"
		end
	end
	vote.Status = if passed then "Passed" else "Failed"
	vote.Winner = if passed then pick else nil
	vote.Result = if passed and pick then `PICKED: {titleOf(vote, pick)}`
		elseif passed then "PASSED"
		else `FAILED: {string.upper(reason or "not enough yes")}`
	local index = table.find(queue, vote.Id)
	if index then
		table.remove(queue, index)
	end
	local spec = vote.Spec
	if passed then
		local ok, err = pcall(spec.OnPass, pick)
		if not ok then
			log:Error("%s passed but OnPass failed: %s", vote.Id, tostring(err))
		end
	else
		if spec.Proposer then
			cooldowns[spec.Proposer.UserId] = os.clock() + tuning().FailedCooldownSeconds
		end
		if spec.OnFail then
			local ok, err = pcall(spec.OnFail :: any, reason or "not enough yes")
			if not ok then
				log:Error("%s OnFail failed: %s", vote.Id, tostring(err))
			end
		end
	end
	log:Info("%s %s: %s", vote.Id, string.lower(vote.Status), reason or "")
	publish(vote)
	VoteService.Closed:Fire(vote.Id, passed, reason)
	task.delay(tuning().ResultSeconds, function()
		votes[vote.Id] = nil
		collection:Remove(vote.Id)
	end)
	goLive()
	publishQueue()
end

local function decide(vote: Vote)
	local function broken(): string?
		local fn = tieBreaker
		if not fn then
			return nil
		end
		local ok, pick = pcall(fn, vote.Id, vote.Ballots)
		if not ok then
			log:Warn("tie-breaker: %s", tostring(pick))
		end
		return if ok and type(pick) == "string" then pick else nil
	end
	if vote.Spec.Options then
		-- a draft: the most picks wins, ties (none picked included) at random, or a Warden's pick
		local counts = tallyOptions(vote)
		local order = optionIds(vote)
		local breaker = if #Votes.Tied(counts, order) > 1 then broken() else nil
		local winner = Votes.Winner(counts, order, pickRandom, breaker)
		close(vote, winner ~= nil, if winner then nil else "nothing to pick", winner)
		return
	end
	local yes, no, size = count(vote)
	local result = Votes.Outcome(vote.Rule, yes, no, size)
	if result == "Tie" then
		local pick = broken()
		if pick == "Yes" then
			close(vote, true, nil)
			return
		elseif pick == "No" then
			close(vote, false, "the Warden broke the tie")
			return
		end
	end
	if result == "Pass" then
		close(vote, true, nil)
	elseif result == "Tie" then
		close(vote, false, "a tie")
	else
		close(vote, false, if vote.Rule == "MoreYes" then "more no than yes" else "not enough of the team said yes")
	end
end

-- API ---------------------------------------------------------------------------------------------

function VoteService:CanPropose(player: Player): (boolean, string?)
	if RunState.Get("RunPhase") ~= "Playing" then
		return false, "The run isn't under way."
	end
	if not session:IsReady(player) then
		return false, "You're not in the run yet."
	end
	for _, id in queue do
		local vote = votes[id]
		if vote and vote.Spec.Proposer == player then
			return false, "You already have a proposal open."
		end
	end
	local ends = cooldowns[player.UserId]
	if ends and os.clock() < ends then
		return false, `You can propose again in {math.ceil(ends - os.clock())} s.`
	end
	return true, nil
end

function VoteService:Reserved(exceptId: string?): { [string]: boolean }
	local cells = {}
	for _, id in queue do
		local vote = votes[id]
		if vote and id ~= exceptId and vote.Spec.Cells then
			for _, key in vote.Spec.Cells do
				cells[key] = true
			end
		end
	end
	return cells
end

function VoteService:Open(spec: Spec): (string?, string?)
	assert(Config.Find("Votes", spec.Kind), `VoteService: no vote kind {spec.Kind}`)
	if spec.Proposer then
		local ok, why = VoteService:CanPropose(spec.Proposer)
		if not ok then
			return nil, why
		end
	end
	-- Solo: no vote; check it and apply it at once (Section 8, rule 6).
	if tuning().SoloSkipsVotes and VoteService:TeamSize() <= 1 and not spec.Options then
		if spec.Check then
			local ok, why = spec.Check()
			if not ok then
				return nil, why
			end
		end
		local ok, err = pcall(spec.OnPass, nil)
		if not ok then
			log:Error("solo: %s failed to apply: %s", spec.Title, tostring(err))
			return nil, "That couldn't be done (see the server log)."
		end
		log:Info("solo: %s applied at once", spec.Title)
		return "solo", nil
	end
	nextId += 1
	local id = `V{nextId}`
	local vote: Vote = {
		Id = id,
		Spec = spec,
		Rule = Votes.RuleFor(spec.Kind, Votes.BigSpend(spec.Costs, stockNow())),
		Status = "Queued",
		Ballots = {},
	}
	if spec.Proposer then
		vote.Ballots[spec.Proposer.UserId] = "Yes"
	end
	votes[id] = vote
	table.insert(queue, id)
	log:Info("%s opened by %s: %s, %s", id, nameOf(spec.Proposer), spec.Title, vote.Rule)
	if #queue == 1 then
		goLive()
	else
		publish(vote)
	end
	return id, nil
end

-- A ballot from voter `voterId` (a player's UserId, or a pretend voter's negative id).
local function ballot(vote: Vote, voterId: number, choice: Ballot): (boolean, string?)
	if vote.Spec.Options then
		if not table.find(optionIds(vote), choice) then
			return false, "That isn't one of the cards."
		end
		vote.Ballots[voterId] = choice
		local _, picked = tallyOptions(vote)
		if picked >= #team() then
			decide(vote) -- everyone has picked
		else
			publish(vote)
		end
		return true, nil
	end
	if choice ~= "Yes" and choice ~= "No" then
		return false, "That vote is yes or no."
	end
	vote.Ballots[voterId] = choice
	local yes, _, size = count(vote)
	if Votes.AllYes(yes, size) then
		close(vote, true, nil)
	else
		publish(vote)
	end
	return true, nil
end

function VoteService:Cast(player: Player, id: string, choice: Ballot): (boolean, string?)
	local vote = votes[id]
	if not vote or vote.Status ~= "Live" then
		return false, "That vote isn't open."
	end
	if not session:IsReady(player) then
		return false, "You're not in the run yet."
	end
	return ballot(vote, player.UserId, choice)
end

-- A draft's new cards (a reroll): its picks are cleared and, with RerollRestartsTimer, the time
-- starts over. False when the vote isn't an open draft.
function VoteService:SetOptions(id: string, options: { Option }): boolean
	local vote = votes[id]
	if not vote or not vote.Spec.Options or (vote.Status ~= "Live" and vote.Status ~= "Queued") or #options == 0 then
		return false
	end
	vote.Spec.Options = options
	table.clear(vote.Ballots)
	if vote.Status == "Live" and Config.Get("Tuning", "Draft").RerollRestartsTimer then
		vote.EndsAt = now() + Config.Get("Votes", vote.Spec.Kind).Seconds
	end
	publish(vote)
	return true
end

-- The vote on the banner now, and its spec.
function VoteService:Live(): (string?, Spec?)
	local id = queue[1]
	local vote = if id then votes[id] else nil
	if vote and vote.Status == "Live" then
		return vote.Id, vote.Spec
	end
	return nil, nil
end

function VoteService:SetTieBreaker(fn: ((string, { [number]: string }) -> string?)?)
	tieBreaker = fn
end

-- Lifecycle --------------------------------------------------------------------------------------

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function describe(): string
	if #queue == 0 then
		return `no open votes; team {VoteService:TeamSize()}`
	end
	local lines = {}
	for _, id in queue do
		local vote = votes[id]
		if vote then
			local left = if vote.EndsAt then string.format(", %.0f s left", math.max(0, vote.EndsAt - now())) else ""
			if vote.Spec.Options then
				local counts, picked = tallyOptions(vote)
				local parts = {}
				for i, option in vote.Spec.Options do
					table.insert(parts, `{i} {option.Id} {counts[option.Id] or 0}`)
				end
				table.insert(lines, `{id} {vote.Status} {vote.Spec.Title}: {table.concat(parts, ", ")}; {picked} of {#team()} picked ({vote.Rule}{left})`)
			else
				local yes, no, size = count(vote)
				table.insert(lines, `{id} {vote.Status} {vote.Spec.Title}: {yes} yes, {no} no of {size} ({vote.Rule}{left})`)
			end
		end
	end
	return table.concat(lines, "\n")
end

function VoteService:Init(registry)
	session = registry.SessionService
	collection = registry.ReplicationService:Collection("Votes")
	Remotes.OnServer("CastVote", function(player: Player, id: string, choice: string)
		local ok, why = VoteService:Cast(player, id, choice)
		if not ok and why then
			alert(player, "Info", why)
		end
	end)
	Remotes.OnServer("CastPick", function(player: Player, id: string, option: string)
		local vote = votes[id]
		if vote and not vote.Spec.Options then
			alert(player, "Info", "That vote is yes or no.")
			return
		end
		local ok, why = VoteService:Cast(player, id, option)
		if not ok and why then
			alert(player, "Info", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("votes", {
		Description = "Open votes, their tallies and time left.",
		Usage = "votes",
		Run = function(): string?
			return describe()
		end,
	})
	for _, choice in { "Yes", "No" } do
		dev:Register(`vote.{string.lower(choice)}`, {
			Description = `Vote {string.lower(choice)} on the live vote, as you or as pretend voter n.`,
			Usage = `vote.{string.lower(choice)} [n]`,
			Run = function(player: Player?, args): string?
				local id = queue[1]
				local vote = if id then votes[id] else nil
				if not vote or vote.Status ~= "Live" then
					return "no live vote"
				end
				local bot = tonumber(args[1])
				if bot then
					if bots[-bot] == nil then
						return `no pretend voter {bot}`
					end
					local ok, why = ballot(vote, -bot, choice)
					if not ok then
						return why
					end
				else
					-- from Studio's server tools there's no caller: vote as the first player in the run
					local who = player or session:ReadyPlayers()[1]
					if not who then
						return "nobody is in the run to vote as"
					end
					local ok, why = VoteService:Cast(who, id :: string, choice)
					if not ok then
						return why
					end
				end
				return describe()
			end,
		})
	end
	dev:Register("vote.pick", {
		Description = "Pick a card on the live draft (its number or id), as you or as pretend voter n (Prompt 19).",
		Usage = "vote.pick <card number|card id> [n]",
		Run = function(player: Player?, args): string?
			local id = queue[1]
			local vote = if id then votes[id] else nil
			if not vote or vote.Status ~= "Live" or not vote.Spec.Options then
				return "no live draft"
			end
			local options = vote.Spec.Options :: { Option }
			local which = tostring(args[1] or "")
			local option = options[tonumber(which) or 0]
			local choice = if option then option.Id else which
			local bot = tonumber(args[2])
			if bot then
				if bots[-bot] == nil then
					return `no pretend voter {bot}`
				end
				local ok, why = ballot(vote, -bot, choice)
				if not ok then
					return why
				end
			else
				local who = player or session:ReadyPlayers()[1]
				if not who then
					return "nobody is in the run to pick as"
				end
				local ok, why = VoteService:Cast(who, id :: string, choice)
				if not ok then
					return why
				end
			end
			return describe()
		end,
	})
	dev:Register("vote.test", {
		Description = "Open a vote the game proposes (no proposer, no effect), to try the queue and the telegram.",
		Usage = "vote.test [title]",
		Run = function(_player: Player, args): string?
			local title = string.upper(tostring(args[1] or "TEST VOTE"))
			local id, why = VoteService:Open({
				Kind = "Build",
				Title = title,
				OnPass = function()
					log:Info("test vote %s passed", title)
				end,
			})
			return if id then `opened {id}\n{describe()}` else `not opened: {why}`
		end,
	})
	dev:Register("vote.end", {
		Description = "Time is up on the live vote now.",
		Usage = "vote.end",
		Run = function(): string?
			local id = queue[1]
			local vote = if id then votes[id] else nil
			if not vote or vote.Status ~= "Live" then
				return "no live vote"
			end
			decide(vote)
			return describe()
		end,
	})
	dev:Register("vote.bots", {
		Description = "Studio: n pretend voters join the team, voting yes, no or abstaining on each vote as it goes live.",
		Usage = "vote.bots <n> [yes|no|abstain]",
		Run = function(_player: Player, args): string?
			if not RunService:IsStudio() then
				return "pretend voters are for Studio"
			end
			local n = math.clamp(math.floor(tonumber(args[1]) or 0), 0, 5)
			local stance = string.lower(tostring(args[2] or "abstain"))
			local ballot: Ballot? = if stance == "yes" then "Yes" elseif stance == "no" then "No" else nil
			table.clear(bots)
			for i = 1, n do
				bots[-i] = ballot or false
			end
			publishQueue()
			return `{n} pretend voter(s), {stance}; team {VoteService:TeamSize()}`
		end,
	})
end

function VoteService:Start()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local id = queue[1]
			local vote = if id then votes[id] else nil
			if vote and vote.Status == "Live" and vote.EndsAt and now() >= vote.EndsAt then
				decide(vote)
			end
		end
	end)
	session.PlayerLeaving:Connect(function(_player: Player)
		task.defer(publishQueue) -- the team is smaller: tallies and needs change
	end)
	session.PlayerReady:Connect(function(_player: Player)
		publishQueue()
	end)
end

return VoteService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000116"><Properties><string name="Name">WeaponService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	WeaponService: what players carry and how they use it (bible Section 9; Section 23: firing,
	reloads, ammo and the server's hit checks). Run place only; Prompt 11.

	Loadouts
	* Each player carries their class kit (Config.Classes): ClassService gives it (SetClass, Prompt
	  20: the run record's class, or /dev class), the Survivor's until then. Kit items are Standard
	  rarity; the Demolitionist's level 2 adds ExtraFragGrenades Frag Grenades.
	* Section 9's loadout is two guns, one melee weapon, one tool and two throwables. The hotbar
	  holds the guns (slots 1 and 2), the tool (3) and the throwables (4 and 5); the melee weapon
	  has its own button. A kit with no melee weapon punches (Tuning.Combat.Unarmed).
	* The selected slot's item is held: a clone of its model (ServerStorage.Assets.Weapons)
	  welded to the right hand at its Grip socket. Slot 0 holds the melee weapon. A swing holds
	  the melee weapon until it ends.
	* Ammo: each gun's magazine, and the player's carried ammo (Tuning.Combat.CarriedAmmo.Start
	  the first time they spawn in a run, up to .Max). A reload moves whole shots from carried
	  ammo into the magazine over the gun's ReloadSeconds; changing slots cancels it. At a
	  Workshop or an Armory, holding Interact for RestockSeconds fills carried ammo from the
	  team's Ammo stockpile (Section 9: players restock at the Armory or Workshop).

	Guns (Section 23: the client fires for instant feedback; the server checks)
	* FireWeapon(slot, shot, origin, aim, time, claims). The shot's number must be the next one,
	  the gun held, loaded, not reloading and past its fire interval (RateTolerance early at
	  most), and the origin near the player. Every pellet's direction comes from the shot's
	  seed (Rules.Combat.Spread), so the client can't choose its spread. Each claimed hit must
	  lie on its pellet's ray, within range, in the line of sight (the server's own raycast)
	  and near where the target was over the last LagSeconds. Only monsters can be hit.
	* A flame gun (Cone) burns every monster in its cone each tick; a Projectile gun's round
	  flies under gravity, run by the server, and bursts on what it touches (BlastRadius;
	  players' explosives never damage the bunker). Explosions take the thrower's ExplosiveDamage
	  and ExplosiveRadius (the Demolitionist, Prompt 20). An arc gun's hit jumps to ChainTargets
	  more monsters within Tuning.Classes.ArcChainRange, each jump ArcChainFalloff as strong (the
	  Mad Scientist's level 2: ArcChainTargets). Reloading a flame gun costs FuelUse of its ammo
	  (the Exterminator's level 2).
	* Steady Shot (Prompt 20): ClassService's shot hook (SetShotHook) may make a shot pierce (every
	  monster on the pellet's line, checked by the server) and crit (times CritMultiplier; how
	  "crit").
	* HitConfirmed tells the shooter what each hit did (hit markers, damage numbers).

	Melee, dodge, sprint, stamina (Section 9)
	* MeleeSwing(heavy, facing): light swings chain into ComboSteps hits; a heavy swing costs
	  HeavySwingStamina and takes HeavySwingMultiplier as long. The hit lands at the windup's
	  end and is checked then (reach and arc in front, Monster Lab's rule), with the weapon's
	  knockback and stun (StunnedUntil on the monster, for Prompt 12's AI).
	* Dodge(direction): DodgeStamina, then DodgeInvulnerableSeconds of invulnerability
	  (CombatService); the client moves the character.
	* Sprint(on): drains SprintStaminaPerSecond while moving; stamina grows back after
	  StaminaRegenDelay.

	Medkits and throwables (Landon, 2026-11-08)
	* Players carry up to Tuning.Player.Loadout.Medkits Medkits (the Medic's kit starts with 5
	  and may carry 5). UseMedkit heals MedkitHeal over MedkitSeconds; going down cancels it and
	  keeps the Medkit. A Medbay's restock point fills carried Medkits from the team's stockpile
	  (Section 13: Medkits come from the Medbay).
	* A throwable slot (4 or 5) holds a stack (Count). With it selected, Fire throws one
	  (ThrowItem): it flies under ThrowGravity and acts where it lands: a Frag Grenade bursts
	  (Radius, Damage, monsters only), a Flare lights the spot for LightSeconds, a Foam Grenade
	  sprays foam (Foamed fires for Prompt 13's fires) and a Shock Mine arms and stuns the
	  monsters that come near it.

	Tools (Prompt 13): with the tool slot (3) held, holding Fire uses the tool (UseTool on and
	off; the client faces where the camera looks). While a tool is in use, ToolTick fires
	ToolTickSeconds apart with the player's root CFrame: DisasterService sprays fires with the
	Extinguisher, BuildService repairs with the Welder. Changing slots, swinging or going down
	stops it. ToolInUse (the item id) shows the use to every client (spray, sparks).
	Swung fires when a melee swing lands (after its windup), for what else a swing can hit
	(DisasterService: cave-in rubble).

	Attributes on the Player (all replicate): Class, Slot, Item1 to Item5, Mag1 and Mag2,
	Count4 and Count5, MeleeItem, CarriedAmmo, Medkits, HealEndsAt, Stamina, ReloadEndsAt,
	ShotSalt, ShotNext, SwingEndsAt, ToolInUse.
	API: Loadout(player), Items(player): { string }, Carries(player, itemId): boolean,
	GiveThrowable(player, itemId, count): number (Prompt 14: caches); signals Foamed, ToolTick,
	Swung (Prompt 13) and Exploded (Prompt 14: explosives raise Disturbance);
	SetHitModifier(fn) (Prompt 15: a boss's armour and weak points scale hits and may rename them,
	"weakpoint"); Prompt 20: SetClass(player, classId, level), AddHitModifier(name, fn) (class
	damage: the Exterminator's CreatureDamage), SetShotHook(fn), Explode(player, at, radius, damage),
	and the Hit signal (player, target id, damage done, how, point) for what a hit sets off
	(burning, a boss stagger, a kill's Disturbance).
	Dev: give, ammo, medkits, loadout, stamina (class moved to ClassService).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Rules.Combat)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("WeaponService")

local SLOTS = 5
local GUN_SLOTS = 2
local MOVING_SPEED = 2 -- studs/s: below this a sprinting player isn't moving
local STAMINA_HZ = 10

type Held = { Item: string, Rarity: string, Magazine: number?, Count: number? }
type Loadout = {
	Class: string,
	Slots: { [number]: Held? },
	Melee: Held,
	Selected: number,
	Carried: number,
	Stamina: number,
	SpentAt: number, -- os.clock() of the last stamina spend
	Sprinting: boolean,
	Salt: number,
	NextShot: number,
	LastShotAt: number,
	ReloadEndsAt: number,
	ReloadToken: number,
	SwingEndsAt: number,
	ComboStep: number,
	LastSwingAt: number,
	DodgeReadyAt: number,
	Medkits: number,
	MedkitCap: number,
	Level: number, -- the class level (Prompt 20)
	HealEndsAt: number,
	HealToken: number,
	LastThrowAt: number,
	ToolOn: string?, -- the tool in use (Prompt 13)
}

local WeaponService = {
	Name = "WeaponService",
	Dependencies = { "CombatService", "EconomyService", "BunkerGrid", "SessionService", "DevService" },
	-- A Foam Grenade burst: position, radius, the thrower (Prompt 13's fires listen).
	Foamed = Signal.new() :: Signal.Signal<Vector3, number, Player>,
	-- A tool in use (Prompt 13): the player, the tool, their root CFrame, the seconds since the last tick.
	ToolTick = Signal.new() :: Signal.Signal<Player, string, CFrame, number>,
	-- A melee swing landing: the player, where they stood facing, its reach, its arc in degrees,
	-- its damage, the weapon, heavy or not (Prompt 13: rubble).
	Swung = Signal.new() :: Signal.Signal<Player, CFrame, number, number, number, string, boolean>,
	-- A player's explosive went off: where, its radius, whose (Prompt 14: explosives raise Disturbance).
	Exploded = Signal.new() :: Signal.Signal<Vector3, number, Player>,
	-- A player's hit landed (Prompt 20): who, the target's combatant id, the damage done, how, where,
	-- and the hit's own kind before a boss renamed it (a crit or a blast on the belly is "weakpoint").
	Hit = Signal.new() :: Signal.Signal<Player, string, number, string, Vector3?, string>,
}

local combat: any = nil
local economy: any = nil
local grid: any = nil
local dev: any = nil

local loadouts: { [Player]: Loadout } = {}
local restockFolder: Folder? = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Loadouts --------------------------------------------------------------------------------

-- Team modifiers from draft cards (Prompt 19): WeaponRarityUp (every player's weapons, now and in
-- every loadout made later) and StaminaMult (max stamina). Key -> source -> value.
local teamMods: { [string]: { [string]: number } } = {}

local function teamSum(key: string): number
	local total = 0
	for _, v in teamMods[key] or {} do
		total += v
	end
	return total
end

local function staminaMax(): number
	local value = Config.Get("Tuning", "Player").Stamina
	for _, v in teamMods.StaminaMult or {} do
		value *= v
	end
	return value
end

-- A rarity `steps` ranks up (or down), within Config.ItemRarities' order.
local function raised(rarity: string, steps: number): string
	local order = Config.Ids("ItemRarities")
	local at = table.find(order, rarity) or table.find(order, "Standard") or 1
	return order[math.clamp(at + math.floor(steps), 1, #order)]
end

local function kitOf(classId: string): (
	{ [number]: Held? },
	Held,
	number
)
	local class = Config.Find("Classes", classId) or Config.Get("Classes", "Survivor")
	local guns, throwables, counts = {}, {}, {}
	local tool: string? = nil
	local melee: string? = nil
	local medkits = 0
	for _, stack in class.Kit do
		local item = Config.Find("Items", stack.Item)
		if item then
			if item.Kind == "Gun" then
				table.insert(guns, stack.Item)
			elseif item.Kind == "Melee" then
				melee = melee or stack.Item
			elseif item.Kind == "Tool" then
				tool = tool or stack.Item
			elseif item.Kind == "Throwable" then
				table.insert(throwables, stack.Item)
				table.insert(counts, stack.Count or 1)
			elseif stack.Item == "Medkit" then
				medkits += stack.Count or 1
			end
		end
	end
	local slots: { [number]: Held? } = {}
	for i = 1, GUN_SLOTS do
		local id = guns[i]
		if id then
			local gun = Combat.Gun(id)
			slots[i] = { Item = id, Rarity = "Standard", Magazine = if gun then gun.Magazine else 0 }
		end
	end
	if tool then
		slots[3] = { Item = tool, Rarity = "Standard" }
	end
	for i = 1, 2 do
		if throwables[i] then
			slots[3 + i] = { Item = throwables[i], Rarity = "Standard", Count = counts[i] }
		end
	end
	-- Armory Shipment and the like (Prompt 19): kit weapons start that many rarities up
	local bonus = teamSum("WeaponRarityUp")
	if bonus ~= 0 then
		for i = 1, GUN_SLOTS do
			local held = slots[i]
			if held then
				held.Rarity = raised(held.Rarity, bonus)
			end
		end
	end
	local meleeRarity = if melee and bonus ~= 0 then raised("Standard", bonus) else "Standard"
	return slots, { Item = melee or Combat.UNARMED, Rarity = meleeRarity }, medkits
end

local function publish(player: Player, state: Loadout)
	player:SetAttribute("Class", state.Class)
	player:SetAttribute("Slot", state.Selected)
	for i = 1, SLOTS do
		local held = state.Slots[i]
		player:SetAttribute(`Item{i}`, if held then held.Item else nil)
		if i <= GUN_SLOTS then
			player:SetAttribute(`Mag{i}`, if held then held.Magazine else nil)
		end
	end
	for i = 4, SLOTS do
		local held = state.Slots[i]
		player:SetAttribute(`Count{i}`, if held then held.Count else nil)
	end
	player:SetAttribute("MeleeItem", state.Melee.Item)
	player:SetAttribute("CarriedAmmo", state.Carried)
	player:SetAttribute("Medkits", state.Medkits)
	player:SetAttribute("HealEndsAt", if state.HealEndsAt > now() then state.HealEndsAt else nil)
	player:SetAttribute("ShotSalt", state.Salt)
	player:SetAttribute("ShotNext", state.NextShot)
	player:SetAttribute("ReloadEndsAt", if state.ReloadEndsAt > now() then state.ReloadEndsAt else nil)
end

local function firstSlot(state: Loadout): number
	for i = 1, SLOTS do
		if state.Slots[i] then
			return i
		end
	end
	return 0
end

local function newLoadout(player: Player, classId: string, carried: number?, level: number?): Loadout
	local slots, melee, medkits = kitOf(classId)
	local p = Config.Get("Tuning", "Player")
	local state: Loadout = {
		Class = classId,
		Slots = slots,
		Melee = melee,
		Selected = 0,
		Carried = carried or Combat.Tuning().CarriedAmmo.Start,
		Stamina = staminaMax(),
		SpentAt = 0,
		Sprinting = false,
		Salt = Random.new():NextInteger(1, 2 ^ 30),
		NextShot = 1,
		LastShotAt = -math.huge,
		ReloadEndsAt = 0,
		ReloadToken = 0,
		SwingEndsAt = 0,
		ComboStep = 0,
		LastSwingAt = -math.huge,
		DodgeReadyAt = 0,
		Medkits = medkits,
		MedkitCap = math.max(p.Loadout.Medkits, medkits),
		HealEndsAt = 0,
		HealToken = 0,
		LastThrowAt = -math.huge,
		ToolOn = nil,
		Level = level or 1,
	}
	player:SetAttribute("ToolInUse", nil)
	state.Selected = firstSlot(state)
	loadouts[player] = state
	player:SetAttribute("Stamina", state.Stamina)
	player:SetAttribute("StaminaMax", if math.abs(staminaMax() - p.Stamina) > 1e-6 then staminaMax() else nil)
	publish(player, state)
	return state
end

-- Held models ------------------------------------------------------------------------------

local function modelOf(itemId: string): Model?
	local item = Config.Find("Items", itemId)
	if not item or not item.Asset then
		return nil
	end
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Weapons")
	local template = folder and folder:FindFirstChild(item.Asset)
	return if template and template:IsA("Model") then template else nil
end

local function holdItem(player: Player, itemId: string?)
	local character = player.Character
	if not character then
		return
	end
	local old = character:FindFirstChild("HeldItem")
	if old and old:GetAttribute("Item") == itemId then
		return
	end
	if old then
		old:Destroy()
	end
	if not itemId then
		return
	end
	local hand = character:FindFirstChild("RightHand")
	local template = modelOf(itemId)
	if not (hand and hand:IsA("BasePart") and template) then
		return
	end
	local model = template:Clone()
	model.Name = "HeldItem"
	model:SetAttribute("Item", itemId)
	local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not primary then
		model:Destroy()
		return
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
		end
	end
	-- Sockets are the model's Socket_<Name> attributes, relative to its pivot (the art
	-- pipeline's AssetSetup). The Grip socket sits in the hand's grip with the item's front
	-- (-Z) along the fingers: forward when the forearm points forward. The Muzzle and Tip
	-- sockets become attachments, for the client's flashes and tracers.
	local pivot = model:GetPivot()
	local function socket(name: string): CFrame?
		local value = model:GetAttribute(`Socket_{name}`)
		return if typeof(value) == "CFrame" then pivot * value else nil
	end
	local gripWorld = socket("Grip") or pivot
	local gripInPrimary = primary.CFrame:ToObjectSpace(gripWorld)
	for _, name in { "Muzzle", "Tip" } do
		local at = socket(name)
		if at then
			local attachment = Instance.new("Attachment")
			attachment.Name = name
			attachment.CFrame = primary.CFrame:ToObjectSpace(at)
			attachment.Parent = primary
		end
	end
	local handGrip = hand:FindFirstChild("RightGripAttachment")
	local handCFrame = if handGrip and handGrip:IsA("Attachment") then handGrip.CFrame else CFrame.new(0, -0.15, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= primary then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = part
			weld.Parent = part
		end
	end
	local weld = Instance.new("Weld")
	weld.Name = "GripWeld"
	weld.Part0 = hand
	weld.Part1 = primary
	weld.C0 = handCFrame
	weld.C1 = gripInPrimary
	weld.Parent = primary
	model.Parent = character
end

-- What the player should be holding now.
local function refreshHeld(player: Player, state: Loadout)
	if player:GetAttribute("Carrying") ~= nil then
		holdItem(player, nil) -- both hands on a big find
		return
	end
	if now() < state.SwingEndsAt then
		holdItem(player, if state.Melee.Item ~= Combat.UNARMED then state.Melee.Item else nil)
		return
	end
	local held = state.Slots[state.Selected]
	if held then
		holdItem(player, held.Item)
	elseif state.Selected == 0 and state.Melee.Item ~= Combat.UNARMED then
		holdItem(player, state.Melee.Item)
	else
		holdItem(player, nil)
	end
end

local function alive(player: Player): boolean
	return player:GetAttribute("Life") == "Alive"
end

-- Both hands on a big find (Prompt 16, Section 12): no firing, swinging, throwing, tools, rolls or
-- Medkits until it is put down.
local function handsFree(player: Player): boolean
	-- Prompt 24: stunned (the Crystal Colossus's shards), a player can't act either
	local stunned = player:GetAttribute("StunnedUntil")
	if type(stunned) == "number" and stunned > workspace:GetServerTimeNow() then
		return false
	end
	return alive(player) and player:GetAttribute("Carrying") == nil
end

local function spend(state: Loadout, player: Player, amount: number): boolean
	if state.Stamina < amount then
		return false
	end
	state.Stamina -= amount
	state.SpentAt = os.clock()
	player:SetAttribute("Stamina", state.Stamina)
	return true
end

-- Line of sight: does the world block the way from `from` to `to`?
local function blocked(from: Vector3, to: Vector3, ignore: { Instance }): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	local offset = to - from
	local distance = offset.Magnitude
	if distance < 0.5 then
		return false
	end
	local hit = workspace:Raycast(from, offset.Unit * (distance - 0.5), params)
	return hit ~= nil
end

-- Everything a shot passes through when judging the line of sight: people and monsters.
local function bodies(): { Instance }
	local list: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, c in combat:All() do
		if c.Kind ~= "Player" then
			table.insert(list, c.Model)
		end
	end
	return list
end

local function confirm(player: Player, targetId: string, done: number, point: Vector3?, how: string?, kind: string?)
	local target = combat:Get(targetId)
	local killed = target == nil or target.State == "Dead"
	Remotes.FireClient("HitConfirmed", player, targetId, done, killed, point)
	WeaponService.Hit:Fire(player, targetId, done, how or "hit", point, kind or how or "hit")
end

-- Guns ---------------------------------------------------------------------------------------

-- A boss's armour and weak points (Prompt 15): BossService's hook scales a hit and may rename it.
local hitModifier: ((target: any, point: Vector3?, how: string, player: Player) -> (number, string?))? = nil

-- Steady Shot (Prompt 20): fn(player, itemId) -> { Pierce, Crit }? for each shot fired.
local shotHook: ((Player, string) -> any)? = nil

-- Class damage (Prompt 20): fn(target, point, how, player) -> multiplier, by name.
local hitModifiers: { { Name: string, Fn: (any, Vector3?, string, Player, string?) -> number } } = {}

-- `item` is what the hit came from (a gun's shot; Prompt 24: a Geode Golem shrugs off small guns).
local function modified(target: any, amount: number, point: Vector3?, how: string, player: Player, item: string?): (number, string)
	for _, entry in hitModifiers do
		local ok, multiplier = pcall(entry.Fn, target, point, how, player, item)
		if ok and type(multiplier) == "number" and multiplier == multiplier then
			amount *= multiplier
		elseif not ok then
			log:Warn("hit modifier %s: %s", entry.Name, tostring(multiplier))
		end
	end
	local fn = hitModifier
	if fn then
		local ok, multiplier, newHow = pcall(fn, target, point, how, player)
		if ok and type(multiplier) == "number" then
			return amount * multiplier, if type(newHow) == "string" then newHow else how
		elseif not ok then
			log:Warn("hit modifier: %s", tostring(multiplier))
		end
	end
	return amount, how
end

local function explode(player: Player, at: Vector3, radius: number, damage: number, shooterId: string)
	-- the Demolitionist's explosives (Prompt 20)
	radius *= Modifiers.PlayerValue(player, "ExplosiveRadius") or 1
	damage *= Modifiers.PlayerValue(player, "ExplosiveDamage") or 1
	WeaponService.Exploded:Fire(at, radius, player)
	local blast = Instance.new("Explosion")
	blast.BlastPressure = 0 -- visual only: players' explosives never damage the bunker (Section 9)
	blast.DestroyJointRadiusPercent = 0
	blast.BlastRadius = radius
	blast.Position = at
	blast.Parent = workspace
	local ignore = bodies()
	for _, c in combat:All("Monsters") do
		local distance = (c.Root.Position - at).Magnitude - c.Reach
		if distance <= radius and not blocked(at, c.Root.Position, ignore) then
			local scale = 1 - math.clamp(distance / radius, 0, 1) * 0.5
			local amount, how = modified(c, damage * scale, at, "blast", player)
			local done = combat:Damage(c.Id, amount, shooterId, how)
			if done > 0 then
				confirm(player, c.Id, done, c.Root.Position, how, "blast")
			end
		end
	end
end

local function launch(player: Player, origin: Vector3, direction: Vector3, gun: { [string]: any }, damage: number, shooterId: string)
	local t = Combat.Tuning()
	local round = Instance.new("Part")
	round.Name = "Round"
	round.Shape = Enum.PartType.Ball
	round.Size = Vector3.new(0.6, 0.6, 0.6)
	round.Material = Enum.Material.Neon
	round.Color = Color3.fromRGB(232, 116, 59)
	round.Anchored = true
	round.CanCollide = false
	round.CanQuery = false
	round.CanTouch = false
	round.CFrame = CFrame.new(origin)
	round.Parent = workspace
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { round, player.Character :: Instance }
	local velocity = direction.Unit * t.ProjectileSpeed
	local position = origin
	local travelled = 0
	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function(dt)
		local step = velocity * dt
		local hit = workspace:Raycast(position, step, params)
		velocity -= Vector3.new(0, t.ProjectileGravity * dt, 0)
		travelled += step.Magnitude
		if hit or travelled > gun.Range then
			if connection then
				connection:Disconnect()
			end
			round:Destroy()
			explode(player, if hit then hit.Position else position + step, gun.BlastRadius or 8, damage, shooterId)
			return
		end
		position += step
		round.CFrame = CFrame.new(position)
	end)
end

-- Throwables (Landon, 2026-11-08: Fire throws the held one) ------------------------------------

local THROWN_COLOURS: { [string]: Color3 } = {
	FragGrenade = Color3.fromRGB(96, 104, 66),
	Flare = Color3.fromRGB(232, 92, 59),
	FoamGrenade = Color3.fromRGB(236, 232, 218),
	ShockMine = Color3.fromRGB(230, 182, 46),
}

local function thrownPart(itemId: string): BasePart
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Weapons")
	local item = Config.Find("Items", itemId)
	local template = folder and item and item.Asset and folder:FindFirstChild(item.Asset)
	local primary = template and template:IsA("Model") and template:FindFirstChildWhichIsA("BasePart", true)
	local part: BasePart
	if primary then
		part = (primary :: BasePart):Clone()
		for _, child in part:GetChildren() do
			if not child:IsA("SurfaceAppearance") then
				child:Destroy()
			end
		end
	else -- graybox until A2 brings the model
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.new(0.7, 0.7, 0.7)
		ball.Color = THROWN_COLOURS[itemId] or Color3.fromRGB(200, 200, 200)
		ball.Material = if itemId == "Flare" then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part = ball
	end
	part.Name = `Thrown_{itemId}`
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	return part
end

local function burst(at: Vector3, colour: Color3, count: number, speed: number)
	local holder = Instance.new("Part")
	holder.Name = "Burst"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Position = at
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(colour)
	emitter.LightEmission = 0.4
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1.6) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.5, 1.1)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 4
	emitter.Rate = 0
	emitter.Parent = holder
	holder.Parent = workspace
	emitter:Emit(count)
	Debris:AddItem(holder, 2)
end

local function placeMine(player: Player, at: Vector3, throwable: { [string]: any })
	local t = Combat.Tuning()
	local mine = thrownPart("ShockMine")
	mine.Name = "ShockMine"
	mine.Position = at + Vector3.new(0, mine.Size.Y / 2, 0) -- sitting on the ground, whatever its size
	mine:SetAttribute("Owner", player.UserId)
	mine.Parent = workspace
	local armedAt = os.clock() + t.MineArmSeconds
	local endsAt = os.clock() + t.MineLifetimeSeconds
	task.spawn(function()
		while mine.Parent and os.clock() < endsAt do
			task.wait(0.2)
			if os.clock() >= armedAt then
				local hit = {}
				for _, c in combat:All("Monsters") do
					if (c.Root.Position - mine.Position).Magnitude - c.Reach <= throwable.Radius then
						table.insert(hit, c)
					end
				end
				if #hit > 0 then
					for _, c in hit do
						c.Model:SetAttribute("StunnedUntil", now() + (throwable.StunSeconds or 2))
					end
					burst(mine.Position, Color3.fromRGB(120, 200, 255), 40, 18)
					break
				end
			end
		end
		mine:Destroy()
	end)
end

local function landed(player: Player, itemId: string, throwable: { [string]: any }, at: Vector3)
	local attacker = combat:PlayerCombatant(player)
	local shooterId = if attacker then attacker.Id else `P{player.UserId}`
	if itemId == "ShockMine" or throwable.Trap then
		placeMine(player, at, throwable)
	elseif throwable.Damage and throwable.Damage > 0 then
		explode(player, at, throwable.Radius, throwable.Damage, shooterId)
	elseif throwable.LightSeconds then
		local flare = thrownPart("Flare")
		flare.Name = "Flare"
		flare.Position = at + Vector3.new(0, flare.Size.Y / 2, 0)
		flare:SetAttribute("Radius", throwable.Radius)
		flare:SetAttribute("RevealsHidden", throwable.RevealsHidden == true)
		if throwable.RevealsHidden then
			-- Prompt 24: what a flare lights, MonsterService shows (Prism Stalkers) and BossService
			-- (the Crystal Colossus's cores)
			game:GetService("CollectionService"):AddTag(flare, "RevealLight")
		end
		local light = Instance.new("PointLight")
		light.Range = math.min(throwable.Radius, 60)
		light.Brightness = 4
		light.Color = Color3.fromRGB(255, 128, 84)
		light.Shadows = true
		light.Parent = flare
		local sparks = Instance.new("ParticleEmitter")
		sparks.Color = ColorSequence.new(Color3.fromRGB(255, 150, 90))
		sparks.LightEmission = 1
		sparks.Size = NumberSequence.new(0.25, 0)
		sparks.Lifetime = NumberRange.new(0.3, 0.7)
		sparks.Speed = NumberRange.new(4, 9)
		sparks.SpreadAngle = Vector2.new(30, 30)
		sparks.Rate = 40
		sparks.Parent = flare
		flare.Parent = workspace
		Debris:AddItem(flare, throwable.LightSeconds)
	elseif throwable.Extinguishes then
		burst(at, Color3.fromRGB(240, 240, 232), 90, 22)
		WeaponService.Foamed:Fire(at, throwable.Radius, player)
	end
end

local function throwObject(player: Player, origin: Vector3, direction: Vector3, itemId: string, throwable: { [string]: any })
	local t = Combat.Tuning()
	local thrown = thrownPart(itemId)
	thrown.CFrame = CFrame.new(origin)
	thrown.Parent = workspace
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = bodies()
	local velocity = direction.Unit * t.ThrowSpeed
	local position = origin
	local flown = 0
	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function(dt)
		local step = velocity * dt
		local hit = workspace:Raycast(position, step, params)
		velocity -= Vector3.new(0, t.ThrowGravity * dt, 0)
		flown += dt
		if hit or flown > 6 then
			if connection then
				connection:Disconnect()
			end
			thrown:Destroy()
			local at = if hit then hit.Position + hit.Normal * 0.2 else position
			local ok, err = pcall(landed, player, itemId, throwable, at)
			if not ok then
				log:Warn("%s landed badly: %s", itemId, tostring(err))
			end
			return
		end
		position += step
		thrown.CFrame = CFrame.new(position) * CFrame.Angles(flown * 9, flown * 5, 0)
	end)
end

local function onThrow(player: Player, slot: number, origin: Vector3, aim: Vector3)
	local state = loadouts[player]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not state or not root or not handsFree(player) or state.Selected ~= slot or now() < state.SwingEndsAt then
		return
	end
	local held = state.Slots[slot]
	local item = held and Config.Find("Items", held.Item)
	if not held or not item or item.Kind ~= "Throwable" or not item.Throwable or (held.Count or 0) <= 0 then
		return
	end
	local t = Combat.Tuning()
	if os.clock() - state.LastThrowAt < t.ThrowCooldownSeconds * (1 - t.RateTolerance) then
		return
	end
	if (origin - root.Position).Magnitude > t.OriginTolerance or aim.Magnitude < 0.5 then
		return
	end
	state.LastThrowAt = os.clock()
	held.Count = (held.Count or 1) - 1
	local itemId = held.Item
	if held.Count <= 0 then
		state.Slots[slot] = nil
	end
	publish(player, state)
	if not state.Slots[slot] then
		refreshHeld(player, state)
	end
	throwObject(player, origin, aim, itemId, item.Throwable)
end

local function onFire(player: Player, slot: number, shot: number, origin: Vector3, aim: Vector3, time: number, claims: { any })
	local state = loadouts[player]
	local shooter = combat:PlayerCombatant(player)
	if not state or not shooter or not handsFree(player) then
		return
	end
	local held = state.Slots[slot]
	local gun = if held then Combat.Gun(held.Item) else nil
	if not held or not gun or state.Selected ~= slot then
		return
	end
	local t = Combat.Tuning()
	if shot ~= state.NextShot then
		player:SetAttribute("ShotNext", state.NextShot) -- the client resyncs from this
		return
	end
	local clock = os.clock()
	if now() < state.ReloadEndsAt or (held.Magazine or 0) < 1 then
		return
	end
	if clock - state.LastShotAt < Combat.Interval(held.Item) * (1 - t.RateTolerance) then
		return
	end
	if (origin - shooter.Root.Position).Magnitude > t.OriginTolerance or aim.Magnitude < 0.9 then
		return
	end
	held.Magazine = (held.Magazine or 0) - 1
	state.NextShot += 1
	state.LastShotAt = clock
	player:SetAttribute(`Mag{slot}`, held.Magazine)
	player:SetAttribute("ShotNext", state.NextShot)

	local damage = Combat.Damage(held.Item, held.Rarity)
	local serverNow = now()
	local from = math.clamp(time, serverNow - t.LagSeconds, serverNow) - 0.05
	local ignore = bodies()

	if gun.Projectile then
		launch(player, origin, aim, gun, damage, shooter.Id)
		return
	end
	if gun.Cone then
		for _, c in combat:All("Monsters") do
			if Combat.InCone(origin, aim, c.Root.Position, gun.Range, gun.SpreadDegrees, c.Reach)
				and not blocked(origin, c.Root.Position, ignore) then
				local amount, how = modified(c, damage, nil, "burned", player)
				local done = combat:Damage(c.Id, amount, shooter.Id, how)
				if done > 0 then
					confirm(player, c.Id, done, c.Root.Position, how)
				end
			end
		end
		return
	end
	-- Steady Shot (Prompt 20): this shot may pierce and crit
	local bonus: { Pierce: boolean?, Crit: number? }? = nil
	local hook = shotHook
	if hook then
		local ok, got = pcall(hook, player, held.Item)
		if ok and type(got) == "table" then
			bonus = got
		elseif not ok then
			log:Warn("shot hook: %s", tostring(got))
		end
	end
	local crit = if bonus and type(bonus.Crit) == "number" and bonus.Crit > 1 then bonus.Crit else nil
	local hitOnce: { [string]: boolean } = {}
	local function land(target: any, point: Vector3, scale: number)
		local kind = if crit then "crit" else "shot"
		local amount, how = modified(target, damage * scale * (crit or 1), point, kind, player, held.Item)
		local done = combat:Damage(target.Id, amount, shooter.Id, how)
		if done > 0 then
			confirm(player, target.Id, done, point, how, kind)
		end
		hitOnce[target.Id] = true
	end
	local pellets = Combat.Spread(Combat.ShotSeed(state.Salt, shot), aim, held.Item)
	local used: { [number]: boolean } = {}
	for _, claim in claims do
		local direction = pellets[claim.Pellet]
		local target = combat:Get(claim.Id)
		if direction and not used[claim.Pellet] and target and target.Team == "Monsters" and target.State == "Alive" then
			used[claim.Pellet] = true
			local ok, why = Combat.CheckHit(origin, direction, claim.Point, gun.Range, target.History, from, serverNow, target.Reach)
			if ok and blocked(origin, claim.Point, ignore) then
				ok, why = false, "the line of sight is blocked"
			end
			if ok then
				land(target, claim.Point, 1)
				-- an arc jumps on to the nearest monsters (the Arc Rifle; the Mad Scientist's level 2)
				local chains = math.max(gun.ChainTargets or 0, if (gun.ChainTargets or 0) > 0
					then Modifiers.PlayerValue(player, "ArcChainTargets") or 0 else 0)
				if chains > 0 then
					local ct = Config.Get("Tuning", "Classes")
					local from_ = target.Root.Position
					local scale = 1
					for _ = 1, chains do
						local best, bestDistance = nil, ct.ArcChainRange
						for _, c in combat:All("Monsters") do
							if not hitOnce[c.Id] and c.State == "Alive" then
								local d = (c.Root.Position - from_).Magnitude - c.Reach
								if d <= bestDistance and not blocked(from_, c.Root.Position, ignore) then
									best, bestDistance = c, d
								end
							end
						end
						if not best then
							break
						end
						scale *= ct.ArcChainFalloff
						local zapFrom = from_
						from_ = best.Root.Position
						land(best, from_, scale)
						Remotes.FireAllClients("ArcZap", zapFrom, from_)
					end
				end
			else
				log:Debug("%s: a hit on %s refused: %s", player.Name, claim.Id, tostring(why))
			end
		end
	end
	-- a piercing shot hits everything on each pellet's line, past the first (the server's own check)
	if bonus and bonus.Pierce then
		for _, direction in pellets do
			local unit = direction.Unit
			for _, c in combat:All("Monsters") do
				if not hitOnce[c.Id] and c.State == "Alive" then
					local off, along = Combat.RayDistance(origin, unit, c.Root.Position)
					if along > 0 and along <= gun.Range and off <= c.Reach + 1 and not blocked(origin, c.Root.Position, ignore) then
						land(c, origin + unit * along, 1)
					end
				end
			end
		end
	end
end

local function onReload(player: Player)
	local state = loadouts[player]
	if not state or not alive(player) then
		return
	end
	local held = state.Slots[state.Selected]
	local gun = if held then Combat.Gun(held.Item) else nil
	if not held or not gun or now() < state.ReloadEndsAt then
		return
	end
	local perShot = gun.AmmoPerShot * (if gun.Cone then Modifiers.PlayerValue(player, "FuelUse") or 1 else 1)
	if (held.Magazine or 0) >= gun.Magazine or state.Carried < perShot then
		return
	end
	state.ReloadToken += 1
	local token = state.ReloadToken
	state.ReloadEndsAt = now() + gun.ReloadSeconds
	player:SetAttribute("ReloadEndsAt", state.ReloadEndsAt)
	task.delay(gun.ReloadSeconds, function()
		if loadouts[player] ~= state or state.ReloadToken ~= token then
			return
		end
		state.ReloadEndsAt = 0
		player:SetAttribute("ReloadEndsAt", nil)
		if state.Slots[state.Selected] == held then
			-- the Exterminator's level 2: a flame gun's tank costs FuelUse of its ammo (Prompt 20)
			local use = if gun.Cone then Modifiers.PlayerValue(player, "FuelUse") or 1 else 1
			held.Magazine, state.Carried = Combat.Reload(held.Magazine or 0, state.Carried, held.Item, use)
			player:SetAttribute(`Mag{state.Selected}`, held.Magazine)
			player:SetAttribute("CarriedAmmo", state.Carried)
		end
	end)
end

local function cancelReload(player: Player, state: Loadout)
	if state.ReloadEndsAt > 0 then
		state.ReloadToken += 1
		state.ReloadEndsAt = 0
		player:SetAttribute("ReloadEndsAt", nil)
	end
end

-- Tools (Prompt 13) -------------------------------------------------------------------------------

local function stopTool(player: Player, state: Loadout)
	if state.ToolOn then
		state.ToolOn = nil
		player:SetAttribute("ToolInUse", nil)
	end
end

local function onUseTool(player: Player, on: boolean)
	local state = loadouts[player]
	if not state then
		return
	end
	if not on then
		stopTool(player, state)
		return
	end
	local held = state.Slots[state.Selected]
	local item = held and Config.Find("Items", held.Item)
	if not held or not item or item.Kind ~= "Tool" or not handsFree(player) or now() < state.SwingEndsAt then
		return
	end
	state.ToolOn = held.Item
	player:SetAttribute("ToolInUse", held.Item)
end

local function toolLoop()
	local last = os.clock()
	while true do
		task.wait(Config.Get("Tuning", "Repairs").ToolTickSeconds)
		local dt = math.min(os.clock() - last, 0.5)
		last = os.clock()
		for player, state in loadouts do
			local tool = state.ToolOn
			if tool then
				local c = combat:PlayerCombatant(player)
				local held = state.Slots[state.Selected]
				if not c or not alive(player) or not held or held.Item ~= tool then
					stopTool(player, state)
				else
					WeaponService.ToolTick:Fire(player, tool, c.Root.CFrame, dt)
				end
			end
		end
	end
end

-- Bosses (Prompt 15): fn(target, point?, how, player) -> (multiplier, how?) for every hit on a
-- monster: its armour, its weak points, what burns.
function WeaponService:SetHitModifier(fn: ((target: any, point: Vector3?, how: string, player: Player) -> (number, string?))?)
	hitModifier = fn
end

-- Everything a player carries: hotbar items and the melee weapon.
function WeaponService:Items(player: Player): { string }
	local state = loadouts[player]
	local list = {}
	if state then
		for i = 1, SLOTS do
			local held = state.Slots[i]
			if held then
				table.insert(list, held.Item)
			end
		end
		table.insert(list, state.Melee.Item)
	end
	return list
end

function WeaponService:Carries(player: Player, itemId: string): boolean
	return table.find(WeaponService:Items(player), itemId) ~= nil
end

-- Throwables found (Prompt 14: a dug cell's cache): onto the slot that holds the same item, up to
-- ThrowableStack, then into an empty throwable slot. Returns how many the player took.
function WeaponService:GiveThrowable(player: Player, itemId: string, count: number): number
	local state = loadouts[player]
	local item = Config.Find("Items", itemId)
	if not state or not item or item.Kind ~= "Throwable" or count <= 0 then
		return 0
	end
	local cap = Combat.Tuning().ThrowableStack
	local left = count
	for _, pass in { "Same", "Empty" } do
		for slot = 4, SLOTS do
			local held = state.Slots[slot]
			if left > 0 and pass == "Same" and held and held.Item == itemId then
				local room = math.max(cap - (held.Count or 0), 0)
				local add = math.min(room, left)
				held.Count = (held.Count or 0) + add
				left -= add
			elseif left > 0 and pass == "Empty" and not held then
				local add = math.min(cap, left)
				state.Slots[slot] = { Item = itemId, Rarity = "Standard", Count = add }
				left -= add
			end
		end
	end
	if left < count then
		publish(player, state)
		refreshHeld(player, state)
	end
	return count - left
end

local function onSelect(player: Player, slot: number)
	local state = loadouts[player]
	if not state or state.Selected == slot then
		return
	end
	stopTool(player, state)
	cancelReload(player, state)
	state.Selected = slot
	player:SetAttribute("Slot", slot)
	refreshHeld(player, state)
end

-- Melee --------------------------------------------------------------------------------------

local function onSwing(player: Player, heavy: boolean, facing: Vector3)
	local state = loadouts[player]
	local attacker = combat:PlayerCombatant(player)
	if not state or not attacker or not handsFree(player) then
		return
	end
	local clock = now()
	if clock < state.SwingEndsAt - 0.08 then
		return -- still swinging (a little early is network jitter)
	end
	local item = state.Melee.Item
	local p = Config.Get("Tuning", "Player")
	if heavy and not spend(state, player, p.HeavySwingStamina) then
		return
	end
	local step = if heavy then 0 else Combat.NextCombo(state.ComboStep, clock - state.LastSwingAt)
	local windup, length = Combat.Swing(item, heavy)
	state.ComboStep = step
	state.LastSwingAt = clock + length
	state.SwingEndsAt = clock + length
	player:SetAttribute("SwingEndsAt", state.SwingEndsAt)
	cancelReload(player, state)
	stopTool(player, state)
	refreshHeld(player, state)

	local t = Combat.Tuning()
	local melee = Combat.Melee(item) or t.Unarmed
	local damage = Combat.Damage(item, state.Melee.Rarity, heavy)
	task.delay(windup, function()
		if not alive(player) or combat:PlayerCombatant(player) ~= attacker then
			return
		end
		local root = attacker.Root
		local look = Vector3.new(facing.X, 0, facing.Z)
		if look.Magnitude < 0.1 then
			look = root.CFrame.LookVector
		end
		local at = CFrame.lookAt(root.Position, root.Position + look)
		local ignore = bodies()
		for _, c in combat:All("Monsters") do
			if Combat.InArc(at, c.Root.Position, t.MeleeReach + t.MeleeReachTolerance, t.MeleeArcDegrees, c.Reach)
				and not blocked(root.Position, c.Root.Position, ignore) then
				local swingPoint = root.Position + look.Unit * t.MeleeReach * 0.6
				local amount, how = modified(c, damage, swingPoint, if heavy then "smashed" else "struck", player)
				local done = combat:Damage(c.Id, amount, attacker.Id, how)
				if done > 0 then
					confirm(player, c.Id, done, c.Root.Position, how)
					if melee.Knockback and not c.Root.Anchored then
						local push = (c.Root.Position - root.Position) * Vector3.new(1, 0, 1)
						if push.Magnitude > 0.1 then
							c.Root.AssemblyLinearVelocity += push.Unit * melee.Knockback + Vector3.new(0, melee.Knockback * 0.3, 0)
						end
					end
					if melee.StunSeconds then
						c.Model:SetAttribute("StunnedUntil", now() + melee.StunSeconds)
					end
				end
			end
		end
		WeaponService.Swung:Fire(player, at, t.MeleeReach + t.MeleeReachTolerance, t.MeleeArcDegrees, damage, item, heavy)
	end)
	task.delay(length, function()
		if loadouts[player] == state and now() >= state.SwingEndsAt - 0.01 then
			player:SetAttribute("SwingEndsAt", nil)
			refreshHeld(player, state)
		end
	end)
end

-- Dodge, sprint, stamina ------------------------------------------------------------------------

local function onDodge(player: Player, _direction: Vector3)
	local state = loadouts[player]
	local me = combat:PlayerCombatant(player)
	if not state or not me or not handsFree(player) then
		return
	end
	local clock = now()
	if clock < state.DodgeReadyAt then
		return
	end
	local t = Combat.Tuning()
	if not spend(state, player, Config.Get("Tuning", "Player").DodgeStamina) then
		return
	end
	state.DodgeReadyAt = clock + t.DodgeSeconds + t.DodgeCooldownSeconds
	combat:SetInvulnerable(me.Id, clock + t.DodgeInvulnerableSeconds)
end

local function onSprint(player: Player, on: boolean)
	local state = loadouts[player]
	if state then
		state.Sprinting = on and alive(player)
	end
end

local function staminaLoop()
	local dt = 1 / STAMINA_HZ
	while true do
		task.wait(dt)
		local max = staminaMax() -- Field Rations (Prompt 19) raises it
		for player, state in loadouts do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local moving = false
			if root then
				local v = root.AssemblyLinearVelocity
				moving = Vector3.new(v.X, 0, v.Z).Magnitude > MOVING_SPEED
			end
			local sprinting = state.Sprinting and moving and state.Stamina > 0
			local before = state.Stamina
			state.Stamina = Combat.Stamina(state.Stamina, max, dt, sprinting, os.clock() - state.SpentAt)
			if sprinting then
				state.SpentAt = os.clock()
			end
			if state.Stamina <= 0 then
				state.Sprinting = false
			end
			if math.abs(state.Stamina - before) > 1e-6 then
				local shown = player:GetAttribute("Stamina")
				if type(shown) ~= "number" or math.abs(shown - state.Stamina) >= 1 or state.Stamina == 0 or state.Stamina == max then
					player:SetAttribute("Stamina", math.floor(state.Stamina * 10 + 0.5) / 10)
				end
			end
		end
	end
end

-- Restocking at a Workshop or Armory -----------------------------------------------------------

local function restock(player: Player): (number, string?)
	local state = loadouts[player]
	if not state or not alive(player) then
		return 0, "not now"
	end
	local max = Combat.Tuning().CarriedAmmo.Max
	local want = max - state.Carried
	if want <= 0 then
		return 0, "you're full"
	end
	local have = economy:Get("Ammo")
	local take = math.min(want, have)
	if take <= 0 then
		return 0, "the stockpile has no Ammo"
	end
	local ok, why = economy:Spend({ Ammo = take }, `restock for {player.Name}`)
	if not ok then
		return 0, why
	end
	state.Carried += take
	player:SetAttribute("CarriedAmmo", state.Carried)
	return take, nil
end

-- Medkits (Landon, 2026-11-08: the Heal button uses one over MedkitSeconds) -------------------

local function cancelHeal(player: Player, state: Loadout)
	if state.HealEndsAt > 0 then
		state.HealEndsAt = 0
		state.HealToken += 1
		player:SetAttribute("HealEndsAt", nil)
	end
end

local function onMedkit(player: Player)
	local state = loadouts[player]
	local c = combat:PlayerCombatant(player)
	if not state or not c or not handsFree(player) or now() < state.HealEndsAt then
		return
	end
	if state.Medkits <= 0 then
		Remotes.FireClient("Alert", player, "Warning", "NO MEDKITS: TAKE SOME AT THE MEDBAY")
		return
	end
	local health, max = combat:HealthOf(c.Id)
	if health >= max then
		Remotes.FireClient("Alert", player, "Info", "ALREADY AT FULL HEALTH")
		return
	end
	local p = Config.Get("Tuning", "Player")
	state.HealToken += 1
	local token = state.HealToken
	state.HealEndsAt = now() + p.MedkitSeconds
	player:SetAttribute("HealEndsAt", state.HealEndsAt)
	task.delay(p.MedkitSeconds, function()
		if loadouts[player] ~= state or state.HealToken ~= token then
			return
		end
		state.HealEndsAt = 0
		player:SetAttribute("HealEndsAt", nil)
		local me = combat:PlayerCombatant(player)
		if not me or not alive(player) or state.Medkits <= 0 then
			return
		end
		state.Medkits -= 1
		player:SetAttribute("Medkits", state.Medkits)
		combat:Heal(me.Id, p.MedkitHeal)
	end)
end

local function restockMedkits(player: Player): (number, string?)
	local state = loadouts[player]
	if not state or not alive(player) then
		return 0, "not now"
	end
	local want = state.MedkitCap - state.Medkits
	if want <= 0 then
		return 0, "you're full"
	end
	local take = math.min(want, economy:Get("Medkits"))
	if take <= 0 then
		return 0, "the stockpile has no Medkits"
	end
	local ok, why = economy:Spend({ Medkits = take }, `Medkits for {player.Name}`)
	if not ok then
		return 0, why
	end
	state.Medkits += take
	player:SetAttribute("Medkits", state.Medkits)
	return take, nil
end

local function syncRestockPoints()
	local root = grid:Root()
	if not root then
		return
	end
	local folder = restockFolder
	if not folder or folder.Parent == nil then
		folder = Instance.new("Folder")
		folder.Name = "Restock"
		folder.Parent = root
		restockFolder = folder
	end
	local wanted: { [string]: Vector3 } = {}
	local kinds: { [string]: string } = {}
	for _, roomType in { "Workshop", "Armory", "Medbay" } do
		for _, room in grid:RoomsOfType(roomType) do
			local model = grid:RoomModel(room.Id)
			local medbay = roomType == "Medbay"
			local socket = model and model:FindFirstChild(if medbay then "MedkitCabinet" else "Restock", true)
			wanted[room.Id] = if socket and socket:IsA("Attachment")
				then socket.WorldPosition
				else Grid.CellPosition(room.Floor, room.Column) + (if medbay then Vector3.new(-5, 3, 2) else Vector3.new(0, 3, 2))
			kinds[room.Id] = if medbay then "RestockMedkits" else "Restock"
		end
	end
	for _, point in (folder :: Folder):GetChildren() do
		local roomId = point:GetAttribute("RoomId")
		if type(roomId) ~= "string" or not wanted[roomId] or point:GetAttribute("Kind") ~= kinds[roomId] then
			point:Destroy()
		end
	end
	for roomId, position in wanted do
		local point = (folder :: Folder):FindFirstChild(roomId)
		if not point then
			local part = Instance.new("Part")
			part.Name = roomId
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Transparency = 1
			part.Size = Vector3.new(1, 1, 1)
			part:SetAttribute("RoomId", roomId)
			local kind = kinds[roomId]
			part:SetAttribute("Kind", kind)
			local medkits = kind == "RestockMedkits"
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "RestockPrompt"
			prompt.ActionText = if medkits then "Take Medkits" else "Restock ammo"
			local room = grid:Room(roomId)
			prompt.ObjectText = if room then Config.Get("Rooms", room.Type).Name else "Ammo"
			prompt.HoldDuration = Combat.Tuning().RestockSeconds
			prompt.MaxActivationDistance = 10
			prompt.RequiresLineOfSight = false
			prompt.Style = Enum.ProximityPromptStyle.Custom
			prompt:SetAttribute("Kind", kind)
			prompt.Triggered:Connect(function(player: Player)
				local took, why = (if medkits then restockMedkits else restock)(player)
				local what = if medkits then (if took == 1 then "MEDKIT" else "MEDKITS") else "AMMO"
				Remotes.FireClient("Alert", player, if took > 0 then "Info" else "Warning",
					if took > 0 then `TOOK {took} {what} FROM THE STOCKPILE` else `CAN'T RESTOCK: {string.upper(why or "")}`)
			end)
			prompt.Parent = part
			part.Parent = folder
			point = part
		end
		(point :: BasePart).Position = position
	end
end

-- Lifecycle --------------------------------------------------------------------------------------

local function describe(player: Player): string
	local state = loadouts[player]
	if not state then
		return "no loadout"
	end
	local lines = { `{player.Name}: {state.Class}, slot {state.Selected}, carried {state.Carried}, Medkits {state.Medkits}/{state.MedkitCap}, stamina {math.floor(state.Stamina)}` }
	for i = 1, SLOTS do
		local held = state.Slots[i]
		if held then
			table.insert(lines, `  {i}: {held.Item} ({held.Rarity}){if held.Magazine then ` {held.Magazine} loaded` else ""}{if held.Count then ` x{held.Count}` else ""}`)
		end
	end
	table.insert(lines, `  melee: {state.Melee.Item}`)
	return table.concat(lines, "\n")
end

-- Shows the right thing in the player's hands again (after Carrying changes: Prompt 16).
function WeaponService:RefreshHeld(player: Player)
	local state = loadouts[player]
	if state then
		stopTool(player, state)
		cancelReload(player, state)
		refreshHeld(player, state)
	end
end

function WeaponService:Loadout(player: Player): Loadout?
	return loadouts[player]
end

-- Draft cards' team modifiers (Prompt 19): WeaponRarityUp raises every player's guns and melee
-- weapon now (and kits made later); StaminaMult raises max stamina. A nil value clears a source's.
function WeaponService:SetModifier(source: string, key: string, value: number?)
	assert(key == "WeaponRarityUp" or key == "StaminaMult", `WeaponService:SetModifier: {key} isn't a weapon modifier`)
	local before = teamSum("WeaponRarityUp")
	teamMods[key] = teamMods[key] or {}
	teamMods[key][source] = value
	if key == "WeaponRarityUp" then
		local delta = teamSum("WeaponRarityUp") - before
		if delta ~= 0 then
			for player, state in loadouts do
				for i = 1, GUN_SLOTS do
					local held = state.Slots[i]
					if held then
						held.Rarity = raised(held.Rarity, delta)
					end
				end
				if state.Melee.Item ~= Combat.UNARMED then
					state.Melee.Rarity = raised(state.Melee.Rarity, delta)
				end
				publish(player, state)
			end
		end
	else
		local max = staminaMax()
		local base = Config.Get("Tuning", "Player").Stamina
		for player in loadouts do
			player:SetAttribute("StaminaMax", if math.abs(max - base) > 1e-6 then max else nil)
		end
	end
end

-- Medkits handed to a player now (Prompt 19: Med Cache), on top of what they carry.
function WeaponService:AddMedkits(player: Player, count: number): number
	local state = loadouts[player]
	if not state or count <= 0 then
		return 0
	end
	state.Medkits += count
	publish(player, state)
	return count
end

-- The class kit (Prompt 20: ClassService, from the run record or /dev class): a fresh loadout of
-- the class at its level, keeping the carried ammo; the Demolitionist's level 2 adds Frag Grenades.
function WeaponService:SetClass(player: Player, classId: string, level: number?)
	local old = loadouts[player]
	local state = newLoadout(player, classId, if old then old.Carried else nil, level)
	if old then
		-- the shot count carries on: the client only ever catches up to a higher one (playtest,
		-- Prompt 20: a class change set it back to 1 and every later shot was refused)
		state.Salt, state.NextShot = old.Salt, old.NextShot
		player:SetAttribute("ShotSalt", state.Salt)
		player:SetAttribute("ShotNext", state.NextShot)
	end
	local extra = math.floor(Modifiers.ClassValue(classId, "ExtraFragGrenades", level) or 0)
	if extra > 0 then
		WeaponService:GiveThrowable(player, "FragGrenade", extra)
	end
	refreshHeld(player, state)
end

function WeaponService:AddHitModifier(name: string, fn: (any, Vector3?, string, Player, string?) -> number)
	for i, entry in hitModifiers do
		if entry.Name == name then
			table.remove(hitModifiers, i)
			break
		end
	end
	table.insert(hitModifiers, { Name = name, Fn = fn })
end

function WeaponService:SetShotHook(fn: ((Player, string) -> any)?)
	shotHook = fn
end

-- A player's explosion (Prompt 20: the Breaching Charge): their explosive modifiers apply.
function WeaponService:Explode(player: Player, at: Vector3, radius: number, damage: number)
	local attacker = combat:PlayerCombatant(player)
	explode(player, at, radius, damage, if attacker then attacker.Id else `P{player.UserId}`)
end

-- The rarity of each weapon a player holds (guns by slot, then melee): dev and tests.
function WeaponService:Rarities(player: Player): { string }
	local state = loadouts[player]
	if not state then
		return {}
	end
	local out = {}
	for i = 1, GUN_SLOTS do
		local held = state.Slots[i]
		if held then
			table.insert(out, `{held.Item}:{held.Rarity}`)
		end
	end
	table.insert(out, `{state.Melee.Item}:{state.Melee.Rarity}`)
	return out
end

function WeaponService:Init(registry)
	combat = registry.CombatService
	economy = registry.EconomyService
	grid = registry.BunkerGrid
	dev = registry.DevService

	dev:Register("loadout", {
		Description = "Your loadout: class, hotbar, magazines, carried ammo and stamina.",
		Usage = "loadout",
		Run = function(player): string?
			return if player then describe(player) else "players only"
		end,
	})
	dev:Register("flare", {
		Description = "Light a flare at your feet (Prompt 24: it shows Prism Stalkers and the Colossus's cores).",
		Run = function(player): string?
			player = player or Players:GetPlayers()[1]
			local character = player and player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local throwable = Config.Get("Items", "Flare").Throwable
			if not player or not root or not root:IsA("BasePart") or not throwable then
				return "no character"
			end
			local floorY = root.Position.Y - 3
			landed(player, "Flare", throwable, Vector3.new(root.Position.X, floorY, root.Position.Z))
			return `a flare burns for {throwable.LightSeconds} s, lighting {throwable.Radius} studs`
		end,
	})
	dev:Register("give", {
		Description = "Put an item in a hotbar slot (guns 1-2, tool 3, throwables 4-5) or as the melee weapon.",
		Usage = "give <ItemId> [slot|melee] [rarity] [count]",
		Run = function(player, args): string?
			local state = player and loadouts[player]
			if not player or not state then
				return "players only"
			end
			local itemId = tostring(args[1] or "")
			local item = Config.Find("Items", itemId)
			if not item then
				return `no item {itemId}`
			end
			local rarity = if Config.Find("ItemRarities", args[3]) then tostring(args[3]) else "Standard"
			if item.Kind == "Melee" or args[2] == "melee" then
				state.Melee = { Item = itemId, Rarity = rarity }
			else
				local slot = tonumber(args[2]) or (if item.Kind == "Gun" then 1 elseif item.Kind == "Tool" then 3 else 4)
				local gun = Combat.Gun(itemId)
				local count = if item.Kind == "Throwable"
					then math.clamp(math.floor(tonumber(args[4]) or Combat.Tuning().ThrowableStack), 1, 99)
					else nil
				state.Slots[slot] = { Item = itemId, Rarity = rarity, Magazine = if gun then gun.Magazine else nil, Count = count }
			end
			publish(player, state)
			refreshHeld(player, state)
			return describe(player)
		end,
	})
	dev:Register("ammo", {
		Description = "Set your carried ammo.",
		Usage = "ammo [amount]",
		Run = function(player, args): string?
			local state = player and loadouts[player]
			if not player or not state then
				return "players only"
			end
			state.Carried = math.max(0, math.floor(tonumber(args[1]) or Combat.Tuning().CarriedAmmo.Max))
			player:SetAttribute("CarriedAmmo", state.Carried)
			return describe(player)
		end,
	})
	dev:Register("medkits", {
		Description = "Set your carried Medkits.",
		Usage = "medkits [count]",
		Run = function(player, args): string?
			local state = player and loadouts[player]
			if not player or not state then
				return "players only"
			end
			state.Medkits = math.clamp(math.floor(tonumber(args[1]) or state.MedkitCap), 0, 99)
			player:SetAttribute("Medkits", state.Medkits)
			return describe(player)
		end,
	})
	dev:Register("stamina", {
		Description = "Set your stamina.",
		Usage = "stamina [amount]",
		Run = function(player, args): string?
			local state = player and loadouts[player]
			if not player or not state then
				return "players only"
			end
			state.Stamina = math.clamp(tonumber(args[1]) or 100, 0, staminaMax())
			player:SetAttribute("Stamina", state.Stamina)
			return describe(player)
		end,
	})
end

function WeaponService:Start()
	local function joined(player: Player)
		player.CharacterAdded:Connect(function()
			local state = loadouts[player] or newLoadout(player, "Survivor")
			state.SwingEndsAt = 0
			state.Sprinting = false
			cancelReload(player, state)
			cancelHeal(player, state)
			stopTool(player, state)
			task.defer(function()
				if player.Character then
					player.Character:WaitForChild("RightHand", 10)
					refreshHeld(player, state)
				end
			end)
		end)
		if player.Character then
			local state = loadouts[player] or newLoadout(player, "Survivor")
			task.defer(refreshHeld, player, state)
		end
	end
	Players.PlayerAdded:Connect(joined)
	for _, player in Players:GetPlayers() do
		joined(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		loadouts[player] = nil
	end)

	Remotes.OnServer("SelectSlot", onSelect)
	Remotes.OnServer("FireWeapon", onFire)
	Remotes.OnServer("ReloadWeapon", onReload)
	Remotes.OnServer("MeleeSwing", onSwing)
	Remotes.OnServer("Dodge", onDodge)
	Remotes.OnServer("Sprint", onSprint)
	Remotes.OnServer("ThrowItem", onThrow)
	Remotes.OnServer("UseMedkit", onMedkit)
	Remotes.OnServer("UseTool", onUseTool)

	combat.Downed:Connect(function(id: string)
		local c = combat:Get(id)
		local player = c and c.Player
		local state = player and loadouts[player]
		if player and state then
			state.Sprinting = false
			cancelReload(player, state)
			cancelHeal(player, state)
			stopTool(player, state)
		end
	end)

	grid.RoomChanged:Connect(function()
		task.defer(syncRestockPoints)
	end)
	syncRestockPoints()
	task.spawn(staminaLoop)
	task.spawn(toolLoop)
	log:Info("weapons ready: the Survivor's kit by default, carried ammo %d", Combat.Tuning().CarriedAmmo.Start)
end

return WeaponService
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX00000119"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX00000119"><Properties><string name="Name">Documentation</string></Properties><Item class="ModuleScript" referent="RBX00000119"><Properties><string name="Name">ARCHITECTURE</string><ProtectedString name="Source"><![CDATA[--!strict
return [=[
# 100 Years Below: ARCHITECTURE

The living map of the code (bible Section 23). Every prompt updates it. The bible wins: if
this document, the code and the bible disagree, the bible is right and the difference is a
bug or a Bible Question.

## Places

| Place | Id | Players | Role |
|---|---|---|---|
| Lobby (start place) | 135073046693952 | 30 | hub, shops, Legends Hall, quests, leaderboards, elevator pads |
| Run (reserved servers) | 72892455946761 | 6 | the bunker, the surface and the Deep |

Both places run the same shared code, bootstraps and infrastructure services. Each adds its
own services and controllers on top (Run: RunDirector, BunkerGrid...; Lobby: PadService,
ClassShopService...). `Constants.PlaceKind()` says which place is running.

## Where code lives (both places)

```
ReplicatedStorage
  Shared                         (Folder) code both sides run
    BuildInfo                    which build is installed; written by the installer
    Constants                    identity and engine limits (never gameplay numbers)
    Types                        types that cross module or network boundaries
    Remotes                      the one list of RemoteEvents + the only API to use them
    RunState                     the run's small values, replicated as attributes on it (Run)
    UIContract                   the parts of the UI layout the code uses (StructureCheck checks them)
    Config                       content aggregator; one child ModuleScript per content type
    Rules                        pure game rules both sides share (Clock, Grid, Bunker, CameraRig, Hud,
                                 CommandView, Votes, Construction, Economy, Residents, Combat)
    Utilities                    Check, Delta, Loader, Log, RateLimit, Signal, TableUtil, Trove
ServerScriptService
  Bootstrap                      (Script) the only server script
  Services                       one ModuleScript per service
  Lib                            server-only modules that aren't services (ProfileSchema; Run: BunkerKit)
  DevTools                       StructureCheck, DataTests (+ Invoke in Studio playtests)
StarterPlayer.StarterPlayerScripts
  ClientBootstrap                (LocalScript) the only client script
  Controllers                    one ModuleScript per controller
  Lib                            client-only modules that aren't controllers (Fade, KitRuntime, Movement, UIKit, UISamples)
StarterGui
  Reticle                        the aim sight (built in Studio, studio/ui/Reticle.lua)
  Frame                          The Frame, the one menu layout (both places; studio/ui/Frame.lua)
  HUD                            the run HUD (Run; studio/ui/HUD.lua)
ServerStorage
  Documentation.ARCHITECTURE     this document
  Assets                         models from the art pipeline (Run)
  ArtPipeline.AssetSetup         art pipeline helper (Run; not game code)
```

Rules: only the two bootstraps are scripts; everything else is a ModuleScript. No `_G`, no
`shared`: modules `require` each other. Server-only code never goes in ReplicatedStorage.
Objects named `A0_...` (showroom, sample screens) are art-pipeline samples, allowed until
gameplay replaces them; the A0 sample screens now sit in `ServerStorage.UIArchive` (Run).

## Where code comes from

The source of truth is the repo `landonhjones2020-bit/100years-assets`, folder `game/`
(Rojo naming: `init.luau` makes the folder a module, `.server.luau` is a Script,
`.client.luau` a LocalScript). `game/shared`, `game/server`, `game/client` and `game/docs`
go to both places; `game/places/<Place>/...` only to that place.

`tools/game_sync.py build` turns the tree into one Model asset (`exports/Code/GameCode.rbxmx`,
holding a Lobby and a Run variant), which is uploaded through Open Cloud like the art and
installed into each place by the Luau that `tools/game_sync.py install <assetId> <Place>`
prints. The install replaces the managed folders wholesale and refuses to run if a script was
edited in Studio since the last install (StructureCheck's Sources check), so nothing written
in Studio is lost: bring such edits back into the repo first.

## Lifecycle

Server: `Bootstrap` → `Remotes.Setup()` → `Loader.Collect(Services)` → every `Init` in
dependency order → every `Start` on its own thread → `ReplicatedStorage` attributes
`PlaceKind`, `Build`, `ServerReady` (and `ServerBroken` if a service failed).

Client: `ClientBootstrap` → every controller's `Init`, then `Start` → waits for `ServerReady`
→ fires `ClientReady` → the server marks the session ready and sends the snapshot.

## Writing a service or controller

```lua
--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)

local log = Log.new("CycleClock")

local CycleClock = {
	Name = "CycleClock",                 -- must equal the ModuleScript name
	Dependencies = { "DevService" },    -- only these can be read from the registry
}

function CycleClock:Init(registry)     -- wire up: remotes, signals, dev commands. No loops.
	registry.DevService:Register("year", { Description = "...", Run = function(player, args) ... end })
end

function CycleClock:Start()            -- runs after every Init: loops, timers, world state
end

return CycleClock
```

* Top-level code in a module has no side effects (StructureCheck requires modules at edit
  time to validate them). Do the work in `Init` and `Start`.
* `Init` must not yield or loop; it is timed and anything over 0.5 s is reported.
* A module whose `Init` errors is reported; modules depending on it are skipped, and the
  server sets `ServerBroken`.
* Talk across modules through methods and Signals the other module exposes, never by
  reaching into its internals.

## Networking

* Every RemoteEvent is an entry in `Shared.Remotes` (`To`, `Args`, `Rate`, `Doc`, and `Place`
  for remotes only one place has). Nothing else creates remotes; StructureCheck flags any that
  appear elsewhere.
* Clients send intentions (propose this room, fire at this point), never results. Each
  client → server remote checks every argument (`Utilities.Check`: finite numbers, valid
  UTF-8, lists without holes, shapes without unknown fields) and rate-limits each player
  before its handler runs. Handlers still check ownership, ranges and game state.
* Small values (year, resources, cycle phase) replicate as attributes.
* Collections (rooms, residents, votes...) go through the delta channel:
  `ReplicationService:Collection("Rooms")` with `Set`, `Patch`, `Remove`, `Clear` on the
  server, `ReplicaController:Get/All/Changed` on the client. Changes are batched and sent
  `Constants.DELTA_HZ` times a second; a player gets a snapshot when their session becomes
  ready. Values must be remote-safe (`Delta.IsRemoteSafe`): lists or string-keyed tables,
  finite numbers, no Instances, no functions. Per-player collections pass `Visible`.

## The run (Run place)

`RunDirector` owns the lifecycle and how a run ends; `CycleClock` owns cycles, phases, the year
counter, Years per Cycle and skips; `ObjectiveService` keeps the Lost Crews rescued and era
bosses beaten (bible Sections 4, 5 and 23). The century's arithmetic is `Shared.Rules.Clock`,
pure functions the data tests hold to the bible.

```
Waiting --first player ready--> Intro (30 s) --> Playing --> Ended --Keep Going--> Playing (Endless)
                                                    |  Day 3:00 (siren at 2:40) -> Surge 1:30 -> year jump -> next Day
```

* The run clock starts at the 30-second mark for everyone; skipping the cutscene is personal.
* Years per Cycle = 1 + the `YearsPerCycle` of every objective done (`Config.Objectives`: +2 a
  Lost Crew, +1 an era boss), at most 12. The year jumps at the end of each cycle.
* A jump that reaches or passes 25, 50 or 75 makes that era's boss the next Surge (once, unless
  already beaten). At 100 the year stops and the next Surge is the final one (the Source); when
  it ends the clock halts and RunDirector declares a Century Victory.
* Surges end when their time is up, or earlier through `CycleClock:EndSurge()` (ThreatDirector,
  when the last monster is dead and the disaster fixed). A boss Surge (an era boss or the final
  Surge) has no timer (`PhaseOpen`) and ignores EndSurge: it ends when its boss is beaten,
  `ObjectiveService:BossBeaten(bossId)` -> `BossDefeated` (Landon, 2026-11-08).
* Skips: when every player in the run has pressed Ready (`SetReady` remote) or rests in a
  Quarters bed (`CycleClock:SetResting`), the day jumps to the siren. Both count only during a
  day before the siren and both reset at the siren (Landon, 2026-11-08).
* Keep Going after any victory, even an early Deep Victory, starts Endless at once (Landon).
* Defeat: `RunDirector:Lose("ReactorDestroyed" | "ResidentsLost")`; Deep Victory:
  `RunDirector:Win("Deep")`; Keep Going: `RunDirector:KeepGoing()` (no more era bosses or year
  cap, Endless Surges). The results (`ResultsService`, Prompt 15) read `RunDirector:Summary()`
  and `RunEnded`.
* Signals for other systems: `CycleClock.CycleStarted` (residents eat and drink), `YearChanged`
  (aging), `EraChanged`, `SirenStarted`, `SurgeStarted`, `SurgeEnded` (the blueprint draft),
  `Skipped`; `RunDirector.PhaseChanged`, `RunEnded`; `ObjectiveService.Changed`.

**RunState** (`Shared.RunState`): the run's small values, replicated as attributes on that
ModuleScript. Each has one writer, which gets a setter from `RunState.Writer(name)`; anyone
reads `RunState.Get`, `RunState.Changed`, `RunState.TimeLeft()` (times are server time, so
every client counts down to the same moment).

| Writer | Values |
|---|---|
| RunDirector | RunPhase, IntroEndsAt, Difficulty, Outcome, DefeatReason, Victory, Endless |
| CycleClock | Cycle, Year, Era, YearsPerCycle, CyclePhase, PhaseLength, PhaseEndsAt, PhaseLeft, PhaseOpen, Siren, SurgeKind, SurgeBoss, ReadyCount, ReadyNeeded, Paused, TimeScale |
| ObjectiveService | LostCrews, BossesBeaten |

Players carry `Ready` and `Resting` attributes (CycleClock). In Studio, set the attribute
`SkipIntro` on `ServerScriptService.DevTools` to true to start runs without the 30 s intro.

## The bunker (Run place)

`BunkerGrid` holds the run's bunker (bible Section 6): the data and rules are
`Shared.Rules.Bunker`, the geometry `Shared.Rules.Grid`, and `Lib.BunkerKit` builds the world.

* Cells: columns -6 to 6, floors 1 to 10 (the depth; floor 10 is the Source Chamber). Every cell
  is Rock, Dug or part of a room. Rooms are 1 to 3 cells side by side on one floor.
* Rules (Rules.Bunker): dig a Rock cell left of, right of or below a dug cell or room; place a room
  on Dug cells (MaxCells, Unique, a room's own Floor, never in the Source Chamber); merge two
  matching rooms of one level side by side (never different levels); Fixed rooms (Blast Door,
  Reactor Core) never merge or go; levels 1 to 3. HP is per cell: `Tuning.Rooms.HP[level]`
  times the cells (Landon, 2026-11-08); a merged room keeps both rooms' HP. Votes, costs,
  build and dig times come from BuildService and DigService.
* The room graph: a node per room (`R3`) and per Dug cell (`D:2,3`); edges through doorways
  (side-by-side open cells of different units) and between stacked Shafts. A dug cell is a step
  when power counts steps from a Reactor Core or a Generator (Landon, 2026-11-08).
* The run starts with `Tuning.StartingBunker`: floor 1 Blast Door (2 cells), Shaft, Quarters
  (2 cells), a dug cell; floor 2 Kitchen, Water Purifier, Shaft, Reactor Core, Medbay, a dug
  cell; the Shafts in column 0, rock at column -3 (the bible's diagram).
* World (Rules.Grid): `Tuning.Grid.Origin` is the interior floor centre of floor 1, column 0
  (0, -120, 0). Cells repeat every 34 studs along +X and 18 down; the front, where the Command
  View camera sits, faces +Z. Art models face -Z: place them with `Grid.CellCFrame`.
* `workspace.Bunker` (built at server start, rebuilt around each change) from the A1 art in
  `ServerStorage.Assets.Kit` and `.Rooms`, each piece falling back to the Prompt 4 graybox when
  missing: `Frame` (a ring of rock cells), `Rock` (models named by cell key), `Dug` (models
  `D:<key>`), `Rooms` (models named by room id, with RoomId, RoomType, Floor, Column, Span,
  Level and Art attributes). Every unit is Persistent. Players spawn in the Medbay; the place's
  other spawns are disabled when the server starts.
* Tags: `FrontWall` (front wall parts: hidden in the Command View), `CameraFade` (furniture,
  the Blast Door set, the stair, vents, lamps, cave props: the camera passes through and fades
  them), `RoomLight` (PointLights, with a `Unit` attribute, for the power system). Floors,
  walls, ceilings and rock stop the camera.
* Gameplay points: each room's `Sockets` part holds an Attachment per socket of its art
  (WorkSpot1.., Bed1.., Seat1.., Core, Valve1.., FuseBox, Breaker, Tap, Bench, Respawn, Door,
  SurfaceExit, Vent, Lift, Chute, Top, Bottom, Light1..), numbered across the room's cells.
  Read them with `BunkerKit.Socket(model, name)` and `BunkerKit.Sockets(model, pattern)`.
* Replication: the `Cells` collection (`"floor,column"` -> `{ Room = id }`, `{}` when Dug) and
  the `Rooms` collection (id -> Type, Floor, Column, Span, Level, HP, MaxHP).

## The camera and input (both places)

`InputController` turns PC, touch and gamepad input into actions; `CameraController` is the
over-the-shoulder camera (bible Section 9); `Lib.Fade` makes world parts see-through on this
client only. The camera's geometry is `Shared.Rules.CameraRig`, its numbers `Tuning.Camera`.

* Actions follow the bible's controls table (`BINDINGS` in InputController). Listen with
  `InputController:On(action, began, ended)`; HUD touch buttons join with
  `BindButton(action, button)`. Moving and jumping stay Roblox's. `Block(reason)` stops gameplay
  actions while a screen is open (CommandView is never blocked).
* Roblox marks Tab as processed before ContextActionService sees it begin, so Tab (and the
  gamepad's View button) are also read from UserInputService when processed (no text box
  focused, Roblox's menu closed). `GuiService.AutoSelectGuiEnabled` is off: Roblox would take
  the View button for its own UI selection, and our screens select for the gamepad themselves.
* Right shoulder by default; `SwapShoulder` (V, right stick click) swaps. `Aim` (right mouse,
  left trigger; Run place only) narrows the view 70 to 50, brings the camera in, slows walking
  and turns the character with the camera.
* Zoom caps: the wheel or a pinch zooms between `Distance.Min` and `Distance.Max`, at most
  `IndoorMax` in a bunker cell. A spherecast from the shoulder stops the camera at floors, walls,
  ceilings and rock (in at once, out gently); in a cell it also stays between the floor and the
  ceiling panels (not in a Shaft, which is open overhead).
* Wall fade: `FrontWall` and `CameraFade` parts never stop the camera and fade while they hide
  the character or touch the camera; characters and `CameraIgnore` are passed through. The
  local character fades when the camera reaches its head.
* PC: the mouse is locked to the centre and `StarterGui.Reticle` shows the sight.
  `CameraController:FreeCursor(reason, true)` frees it for menus; `Suspend(reason)` and
  `Resume(reason)` hand the camera to another view (Command View, cutscenes).
* Fallback: repeated errors stop the controller and give the camera to Roblox's, set to
  Invisicam in both places (`StarterPlayer.DevCameraOcclusionMode`); `EnableMouseLockOption` is
  off. StructureCheck checks both settings and the Reticle.

## The UI (both places)

Bible Section 18. The layout is real instances in StarterGui, built through the Studio
connector by `studio/ui/*.lua` (`python3 tools/ui_luau.py studio/ui/<Screen>.lua` prints the
Luau; send it with `execute_luau`, Edit) and then given Landon's AutoScale Lite pass. Code
never builds layout: it clones templates and sets text and images.

* `Shared.UIContract` lists every part of `StarterGui.Frame` and `StarterGui.HUD` the code
  uses. StructureCheck fails if one is missing, and also checks ScreenInsets
  CoreUISafeInsets, ResetOnSpawn off, ZIndexBehavior Sibling, Scale-only sizes, TextScaled
  text with a UITextSizeConstraint of at least 12, and no scripts inside a GUI.
* `Lib.UIKit` is generated from `ui/kit.json` by `tools/pack_ui.py` (the sprite table).
  `Lib.KitRuntime.Watch(gui)` keeps 9-slice corners, strokes and scroll bars in step with the
  screen height and runs the push-buttons (RectUp/RectDown/RectHover/RectDisabled attributes).
* `UIController` is The Frame: `Register(name, screen)`, `Open(name, args)`, `Close()`,
  `SetChips`, `SetMainAction`, `SetHint`, `SetFooterActions`, `Clone(template)`,
  `SetSprite`, `SetRarity`, `Clear`. A screen is a page (a clone of `Templates.Page`, or a page
  built for it under `Cabinet.Pages`) filling zones B, C and D; `Docked = true` is the Command
  View's mode (zone C shows the world). While a screen is open the cursor is free, gameplay
  input is blocked (`InputController:Block`) and the HUD hides (its alerts then show in the
  Frame's footer for a few seconds: `UIController:Notice`). Backspace or B closes; Enter or Y
  presses the main action; L1 and R1 switch tabs.
* `HUDController` fills the run HUD: the year flip counter, era, cycle dial, phase and time
  left, Ready (the SetReady remote), siren and Surge banners, health, the class and ability,
  stockpile chips, the hotbar's selection, the Command View button and the touch buttons
  (through `InputController:BindButton`; Roblox's jump button hides while ours shows).
  Landon's answers (2026-11-08): Ready has its own key, Z on PC and D-pad down on console (a
  key chip on the button); on PC a click of the mouse wheel frees the cursor for HUD buttons and
  the vote telegram, and another click locks it again; the stockpile chips show the
  EconomyService amounts (RunState), and the Copper and Crystal chips appear only once the team
  has dug into their bands. Server alerts (the `Alert` remote) go to the alert feed. For later
  systems: `Alert`, `Banner`, `SetVital`, `SetClass`, `SetResource`, `SetSlot`,
  `HotbarSelected`.
* `MiniMapController` draws the side-view mini-map around the player from the Cells and Rooms
  collections; `Blink(key, on)` for alerts.
* Changing a screen after Landon's AutoScale Lite pass: edit the instances in place (and the
  builder file to match), or rebuild and ask for the pass again. `studio/ui/patches/` holds
  such in-place patches.

## The Command View (Run place)

Bible Section 7. `CommandViewController` registers the screen `CommandView`: the Frame in
docked mode (`Cabinet.Pages.CommandView`, zone C open on the live bunker), opened and closed
by Tab, the View button, the HUD's Command View button, Backspace or B. The character stays
where it was, held by a ContextActionService sink (its movement keys and jump) with Roblox's
touch thumbstick and jump button hidden (`GuiService.TouchControlsEnabled`), and can be hit:
`DamageEdge` flashes when its health drops. Its arithmetic and build-menu rules are
`Shared.Rules.CommandView` (pure, data-tested); numbers in `Tuning.CommandView`.

* Camera: straight at the bunker from +Z, at most `MaxDistance` (440 studs) away. At the
  lowest graphics level Roblox stops drawing parts about 500 studs from the camera (measured in
  Studio, 2026-11-08: 500 drew, 525 didn't; level 2 draws about 800), so the camera never backs
  off past the cap: `Rules.CommandView.Lens(height)` keeps the narrow 8 degree field of view
  while it fits, then widens it (14 degrees at the opening 6 floors, 25 at the 11-floor limit).
  The view's centre sits in zone C's centre; it opens centred on the character with a 0.3 s
  move, and the close moves back and resumes CameraController. `FrontWall` parts hide while it
  is open; the lighting lifts (`Ambient`, `OutdoorAmbient`, `ExposureCompensation`).
* Input: drag or WASD/arrows to pan, the wheel or a pinch to zoom (1.5 to 11 floors), click or
  tap a cell; gamepad: left stick pans, right stick zooms, A picks the centre (`Cursor`).
  Picking casts from the camera through the point onto the cells' plane (`Grid.CellAt`).
* Detail panel (zone D): a room (condition, power, what it does; Upgrade, Merge with a
  matching neighbour, Tear Down), an open cell (the build menu: available rooms with costs,
  then locked ones and why, from `RoomChoice`; Fixed rooms are never listed), rock (whether it
  can be dug, the band's ore, the next band's Push Deeper). Choosing an option arms the main
  action ("Propose ..."), greyed until a system calls `SetHandler(action, fn)` for Build,
  Upgrade, Merge or TearDown (Prompt 8: votes).
* For later systems: `SetOverlay(name, provider)` (Power, Morale, Threat, Production: the
  provider returns a lamp sprite and a short reading per room, shown on the room label and the
  reading chip under it; the legend sits at the top of the panel; Power and Production are
  registered from the `Power` and `Production` collections, Prompt 9),
  `ShowGhost(id, floor, column, span, label)` / `HideGhost(id)` (votes), `Blink(roomId, on)`
  (breaches, disasters), `Select(floor, column)`, `IsOpen`, `Toggle`, `State`, and the
  `Selected` signal. Labels, marks and pings cover cell interiors (`Rules.CommandView.CellBox`).
* Pings: the footer's Ping button or G / D-pad up sends `PingCell(floor, column)`;
  `PingService` checks the session and the cell and fires `CellPinged(floor, column, userId,
  name)` to every ready player. The pin shows in the Command View and on the HUD mini-map for
  `Tuning.Ping.Seconds` (6).
* Landon (2026-11-08): no team list replaces Roblox's player list (it stays off in the run),
  and the widest view stays as built: about 5 columns by 8 floors, panning for the rest.
* With votes (Prompt 8): an open cell under construction shows UNDER CONSTRUCTION and its
  progress, a cell or room with an open vote shows the proposal and offers nothing else, rows
  the stockpile can't pay show what's short, the main action says Build (not Propose) in a solo
  run, and ghosts mark open proposals ("KITCHEN?") and sites ("KITCHEN 45%").

## Votes, construction, the economy and power (Run place)

Bible Sections 5, 6, 8, 13 and 23. Rules are pure modules the data tests hold to the bible:
`Shared.Rules.Votes` (outcomes, the 40% rule, what a vote needs),
`Shared.Rules.Construction` (costs, refunds, unlocks, reserved cells, construction time, a plan
for each proposal) and `Shared.Rules.Economy` (Section 13's output formula, power made and
drawn, steps along the room graph, the dark order, eating with carry).

* `EconomyService` keeps the team's stockpile:
  * every stocked resource in `Config.Resources` from its Start amount;
  * caps: Cap plus CapPerStorageCell for each Storage cell, times StockpileCaps modifiers;
  * Lab research, from 0.
  * Amounts replicate as RunState values (one per resource, plus Research).
  * API: `Spend(costs, reason)`, `Add(id, amount, reason)` (capped), `CanAfford`, `Get`, `Stock`,
    `Cap`, `AddResearch`.
* Production (Prompt 9): rooms make things all the time while the clock runs. A room's output
  per cycle comes from its crew, level, span, light and modifiers, spread over a 270 s cycle;
  whole units go into the stockpile and the fractions carry. Production is published per room
  in the `Production` collection: { Rate, Makes, Idle, Workers }.
* Consumption (Prompt 9): at each `CycleStarted` every eater takes 1 Food (times FoodUse) and 1
  Water; a shortfall alerts the team and fires `Shortfall`.
* Crews and eaters come from `SetResidents({ Crew, Eaters })` (ResidentService, Prompt 10);
  call `RefreshCrew()` on changes.
* Other API: `SetModifier(source, key, value?, room?)` for RoomOutput, AllOutput,
  StockpileCaps and FoodUse; `Rate(roomId)`.
* `PowerService` keeps the live power balance:
  * the Reactor Core and Generators make power from their crews (Landon: they need residents);
  * every room draws Power[level] per cell, except a wrecked one (0 HP), which draws nothing
    until it is repaired;
  * when the draw passes what is made, rooms go dark farthest first by steps from the nearest
    power room (dug cells count; unreachable rooms first; at the same distance the biggest
    draw, then the newest);
  * rooms that draw nothing never go dark.
  * It pushes the dark rooms to EconomyService (`SetPowered`), dims their lights to emergency
    red and dulls their Neon fittings (the room model's `Dark` attribute), alerts the team, and
    publishes RunState PowerMade, PowerUsed, PowerNeeded, DarkRooms and the `Power` collection:
    { Draw, Made, Dark, Steps }.
  * API: `IsDark(roomId)`, `Balance()`, `Refresh()`, `DarkChanged`.
* `VoteService` runs votes (`Open(spec)`: kind, proposer, title, costs, the ghost's subject, the
  cells it holds, a re-check, OnPass, OnFail). One vote is live at a time; later ones queue and
  each gets its full time. The proposer counts as a yes; abstaining is not voting; a vote can be
  changed until it closes; everyone yes passes at once; ties fail unless a tie-breaker (the
  Warden, Prompt 20: `SetTieBreaker`) passes them; spending more than 40% of a stock needs a
  majority of the whole team. One open proposal per player; a failed one means a 20 s cooldown.
  Solo runs skip the vote (checked again, applied at once). The `Votes` collection carries what
  the telegram shows; a closed vote stays `Tuning.Votes.ResultSeconds` (3) with its result.
* `BuildService` takes the `Propose` remote (action, floor, column, room type or the other
  room), plans it (`Rules.Construction.Plan`: the bunker's rules, unlocks, the stockpile, Lab
  research for level 3, cells held by open votes and sites) and opens a vote. On a pass it plans
  again, pays, and: Build starts a construction site (20 s a cell, 25% faster per player standing
  in it, `Sites` collection, `workspace.Bunker.Sites` drawn by `BunkerKit.Site`), then places the
  room; Upgrade (costs per cell, so a merged room pays for each cell), Merge and TearDown apply at
  once. Tearing down gives back half of what the room cost (`Construction.Refund`, Landon). On a
  difficulty with `UpgradesTakeTime` (Nightmare) an upgrade is a site over the room instead
  (Kind "Upgrade"; the room works at its old level until it's done). `Unlock(roomType)` for drafts
  and cryo pods (`Unlocked` collection). Signals: `Proposed`, `Built`, `TornDown`.
* `VoteController` (client) fills the vote telegram, `StarterGui.Votes` (its own ScreenGui at
  DisplayOrder 6, above The Frame, so a vote can be answered from any screen): what and its cost,
  then who, the tally and the time, the timer strip, YES and NO (your vote stays pressed in:
  `KitRuntime.SetLatched`). On a controller Y votes: a tap for yes, a hold for no (Landon). While
  your ballot is open, Y is bound above The Frame's main action (Y), so it votes from any screen;
  key chips on YES and NO show on a gamepad. It draws the Command View's ghosts, sends `Propose`
  from the Command View's main action, and plays `SoundService.VoteOpen` / `VotePassed` when they
  exist (Prompt 32).
* Remotes: `Propose`, `CastVote` (client to server, Run), `Alert` (server to client: a message
  for the HUD's alert feed).

## Residents (Run place)

Bible Sections 11 and 23, phase 1. `Shared.Rules.Residents` is pure: rolls, max health (Grit),
levels, morale states, a room's crew, the Auto-Assign matching, one cycle of needs.

* `ResidentService` owns the records:
  * the six founders at the start, idle (Landon: the team, or the first-run tutorial, gives
    them jobs); when the run starts the alert feed says how many are waiting for jobs;
  * jobs: `Assign(id, roomId?)`, `AutoAssign()`, and the `AssignResident` and `AutoAssign`
    remotes, with no vote;
  * the crew and eater source for EconomyService (`SetResidents`);
  * needs, XP and Medbay healing after each meal (`EconomyService.Ate`; the newest arrivals go
    hungry first); Surge morale;
  * death: down for 20 s, `Revive` with a stockpile Medkit (the `ReviveResident` remote and a
    prompt), then gone; the last one gone loses the run.
  * away on an expedition (Prompt 18): `SetAway(id, on, health?)` (no job, no meals, no body),
    `Wound`, `GainXP`, `Note`, `Lose` (gone at once, no revive), `Count()` (the cap).
  * The `Residents` collection carries the records for the UI.
* `ResidentBrain` gives each resident a body (the A0 resident) in `workspace.Bunker.Residents`
  and runs the routine at 5 Hz:
  * the first 20 s of a day at a Kitchen seat, the rest at a work spot, the Surge in bed;
  * idle residents at a Lounge seat when there is a Lounge, otherwise by their bed;
  * down: lying with a revive prompt.
  * Bodies walk `Lib.PathGraph` routes (front aisles, doorways, Shaft stairs) with
    Humanoid:MoveTo and carry an `Activity` attribute. Residents don't collide with each other
    or players.
* `NPCAnimator` (client) plays `Config.Animations` clips for each body's Activity.
* `ResidentsController` (client): the Residents screen (Section 18), opened from the Command
  View's footer: tabs All, Working, Idle, Hurt, Away (Prompt 18); a resident card; Assign (the free job on their
  best stat) or Take off the job; the footer's Auto-Assign.
* The Command View lists a room's workers and the idle residents best at its job (Assign, Take
  off the job, Auto-Assign), and its Morale overlay reads the workers' average morale.
* Conditions (Prompt 24 has the first two; the rest are Prompt 26): `Sick` and `Irradiated` are
  fields on the resident, set through `ResidentService:SetCondition(id, condition, on, why?)`
  and read with `HasCondition`. Each costs `Config.Conditions`' `HealthPerCycle` after the meal
  (`Rules.Residents.ConditionHealth`); a Sick worker's stat counts `OutputMultiplier`; a working
  Decon Room clears Irradiated at the cycle; a Sick resident with no job quarantines in a
  Quarters bed (`Rules.Residents.Quarantined`, ResidentBrain's `Quarantine:` goal).

## Combat (Run place)

Bible Sections 9 and 23 (Prompt 11). `Shared.Rules.Combat` is pure: guns and melee weapons by
rarity, damage, fire intervals, pellets, the seeded spread, reloads, hit checks against position
history, cones and arcs, aim assist, combos, swing timing, stamina, the nearest respawn point.
The client predicts with it and the server checks with it.

* `CombatService` owns everyone who can be hurt:
  * `Register(model, spec)` for players (on spawn), residents' bodies (ResidentBrain) and
    monsters (Prompt 12; a dev dummy until then). Ids: `P<UserId>`, `N#`, `M#`.
  * Each combatant has a team, health, a reach and 1 s of positions at 20 Hz for the shot checks
    (Section 23: where the target was over the last 250 ms).
  * `Damage(id, amount, sourceId?, how?)`: no friendly fire, nothing during a dodge's
    invulnerable moment. A player's Humanoid never reaches 0 health: the lethal hit leaves it at
    1 and downs the player. All damage goes through here.
  * Players: Downed (20 s, crawling, a revive prompt for teammates), then Dead, then a respawn at
    the nearest working Medbay (not wrecked, not dark) or the Blast Door hall. The `Life`,
    `LifeEndsAt` and `InvulnerableUntil` attributes on the Player carry it. No natural
    regeneration.
  * Signals: `Damaged`, `Downed`, `Revived`, `Died`. Dead monsters dissolve.
* `WeaponService` owns what players carry and do:
  * the loadout (the class kit until Prompt 21): guns on hotbar slots 1 and 2, the tool on 3,
    throwables on 4 and 5, the melee weapon on its own button; the held item is a clone of its
    model welded to the hand at its Grip socket;
  * the remotes `SelectSlot`, `FireWeapon` (checked hits, then `HitConfirmed`), `ReloadWeapon`,
    `MeleeSwing`, `Dodge`, `Sprint`;
  * magazines, carried ammo and restocking at Workshop and Armory restock points (from the
    team's Ammo); Medkits restocked at the Medbay from the team's Medkits;
  * Landon's Prompt 11 answers: `UseMedkit` heals over `MedkitSeconds` (1.5 s, walking at
    `HealWalkMultiplier`; H, hold D-pad up, the Heal touch button), cancelled by being hit or
    swapping; `ThrowItem` throws the slot's throwable along an arc (Frag Grenade explodes, Flare
    lights, Foam Grenade puts out fire through `WeaponService.Foamed`, Shock Mine arms and stuns
    monsters through `StunnedUntil`); every class kit has a melee weapon;
  * stamina (sprint, dodge, heavy swings);
  * the Player attributes `Class`, `Slot`, `Item1` to `Item5`, `Mag1`, `Mag2`, `MeleeItem`,
    `CarriedAmmo`, `Stamina`, `ReloadEndsAt`, `ShotSalt`, `ShotNext`, `SwingEndsAt`.
* `CombatController` (client): input (fire, aim, reload, melee, dodge, sprint, the hotbar), the
  shot's feedback, recoil, aim assist on gamepad and touch, the roll, the HUD's hotbar and stamina
  gauge, hit and kill markers, damage numbers, health bars, the downed and out telegrams, the
  players' clips (`Config.Animations`).
* `PromptController` (client) draws every Custom-style ProximityPrompt from
  `HUD.Templates.Prompt` (the key's chip, the action, a hold gauge; on touch the plate is the
  button). Holding a revive prompt plays the kneel clip.
* `Lib.Movement` (client) works out one walk speed from several reasons (aiming, sprinting,
  crawling) on top of `StarterPlayer.CharacterWalkSpeed`.

## Threats and monsters (Run place)

Bible Section 10 (Prompt 12). `Shared.Rules.Threat` is pure: the threat level (year, deepest
floor, Disturbance, rooms and players, `Tuning.Threat`), Surge and trickle budgets (the
Tutorial Surge has its own; Boss and Final Surges spend nothing here; an account's first run in
Era I spends 70%), the era's roster (each era's new monsters up to now, never Surface-only),
groups bought from a budget (variety, group sizes), weighted breach picks and target order.

* `ThreatDirector` spends the budgets:
  * at each Surge: groups split into up to 4 waves `WaveSpacingSeconds` apart, at up to
    `MaxBreachPointsPerSurge` breach points, tagged `Surge:<cycle>`;
  * between Surges (the day, from cycle 2): single monsters when the trickle budget allows;
  * ends the Surge early (`CycleClock:EndSurge()`) once every wave is out, none of its monsters
    is left and no disaster holds it (`DisasterService:HoldsSurge`; `SetDisasterCheck` for tests);
  * pays for a Normal or Endless Surge's one disaster first (`DisasterService:SurgeDisaster`),
    and from the second day rolls a daily electrical surge (Prompt 13);
  * `ExtraBreach` and `Tremor` for Disturbance (Prompt 14); `RunState.Threat` and
    `RunState.Monsters` every second.
* `BreachService` owns breach points: room vents `V:<roomId>` (not the Shaft or the Blast Door;
  dark rooms weigh `DarkRoomWeight`, barricaded ones `BarricadeWeight`) and every dug cell at the
  rock edge, on any floor, `D:f,c` (Landon's Prompt 12 answer). `Open(point, groups, tag)` shows 10 s of dust and a pulsing
  red light, adds to the `Breaches` collection, sends `BreachWarning` to ready players, then
  spawns `SpawnSpacingSeconds` apart. Signal `Opened`.
* `MonsterService` owns monsters:
  * `Spawn(type, cframe, tag)` clones `ServerStorage.Assets.Monsters.<Asset>` (a graybox when
    missing), registers it with CombatService (team Monsters) and sets `Rig`, `MonsterType`,
    `Activity` and `AttackAt`; the server owns its physics; collision group Monsters. At most
    `MaxMonsters` (25) on the map, the rest queue; `Count(tag)` includes the queue.
  * The AI ticks every `MonsterAI.TickSeconds`: targets in the type's order (residents,
    machines, players who hit it, any player within `ProximityAggro` except Runners), walks the
    PathGraph (a stuck monster is moved on), attacks after a windup (the model's `HitTime`
    attribute, written from the generator's meta), damages rooms through `BunkerGrid:SetHP`
    (`RoomDamageMultiplier`, Brutes `SmashMultiplier`; a Reactor Core at 0 HP starts
    DisasterService's meltdown, Prompt 13), skips a target that rubble cuts off for a while
    (`Skip`) and plans again when `Lib.Hazards` changes,
    spits goo (`SlowedUntil`), latches ticks (a weld, bites every `AttackSeconds` ×
    `LatchIntervalMultiplier`), and obeys `StunnedUntil`.
  * The Flooded Caverns' four (Prompt 23), by trait: `FromWater` (the Murkling: ThreatDirector
    keeps a breach point `W:<room>` for every room flooded to `Flood.MurklingLevel`, and a
    Surge's FromWater groups open there); `Explodes` and `Floods` (the Bloat Toad swells for
    `BurstSwellSeconds` on reaching something, then bursts: its Damage within `BurstRadius`, the
    `Burst` signal, and ThreatDirector floods the room to `Flood.BurstLevel`; it bursts when
    killed too); `Hides` and `Grabs` (the Lurker walks to the nearest flooded or dark room, sets
    the model's `Hidden` attribute, strikes whoever comes within Range + `AmbushReach`, holds a
    resident it hits (their `Grabbed` attribute) until `GrabBreakDamage`, a stun or its death,
    and hunts in the open after `HideSeconds`); `ArmoredFront` and `WeakPointBack` (the Tide
    Crab: the `Shell` damage filter, `Rules.Threat.Shell`, by where the attacker stands;
    attributes `ShellHitAt` and `WeakHitAt`; standing to fight it turns only
    `ShellTurnDegreesPerSecond` and strikes only within `ShellFaceDegrees`).
  * Stairs: a monster about to climb or on the Shaft's stairs keeps its plan, and a plan made
    again part-way to its next point skips the waypoints behind it (Prompt 23: before this, the
    2.5 s replan sent every monster at the foot of the stairs back to the aisle, for good).
  * Signals `Spawned`, `Died` and `Burst`; dev commands `monster`, `monster.hit`, `monsters`,
    `monsters.clear`.
* `ResidentBrain` (Prompt 12): residents near a monster flee to a safe room (no monster in or
  next to it) until `ResidentCalmSeconds` pass, swat a lone Burrow Tick, and walk slower while
  `SlowedUntil` lasts.
* `ThreatController` (client): the breach alert and mini-map blink, the Command View's Threat
  overlay (monsters, breach countdowns, likely dark rooms, vents) and the Slowed movement reason.
  From Prompt 23 it also draws what the new monsters' attributes say: a `Hidden` Lurker fades to
  almost nothing (`LocalTransparencyModifier`; its lure less) and isn't counted in the overlay,
  sparks on `ShellHitAt` and `WeakHitAt`, a burst of water on `Burst`.
* `NPCAnimator` plays monsters' clips by `Rig:Activity` too (Attack replays on each
  `AttackAt`; Flee and Run fall back to Walk, Fight to Attack).
* Bosses: `Boss_BroodMother` in `ServerStorage.Assets.Bosses` has a `Belly` part with Role
  `WeakPoint`, sockets `Ovipositor`, `Maw` and `Slam`, `HitTime` 0.8 and `LayTime` 1.4, and seven
  clips in `Config.Animations` (Rig `BroodMother`); `Boss_BroodMother_EggSac` is what she lays.
  Her fight is `BossService` (see "Bosses and results").
* `Boss_Deluge` (A8): `Crown` and `Maw` parts with Role `WeakPoint` (on its Head bone), sockets
  `Bite` and `Maw`, `HitTime` 0.7, six clips (Rig `Deluge`: Idle, Swim, Attack, Roar, Stagger,
  Death). Its pivot is the floor under its neck, not the bottom of its bounds.
* The A8 monsters: `Monster_Murkling`, `Monster_BloatToad` (three see-through bladder lobes on
  their own bones: the swell is the lobes sliding apart), `Monster_Lurker` (a `Latched` clip too),
  `Monster_TideCrab`, each with Idle, Walk and Attack (Rig = the monster's type).
* The Crystal Hollows' four (Prompt 24) are traits on `Config.Monsters` rows, as the others are:
  * `Shatters` (Shardling): at its death `Rules.Threat.ShatterDamage` to every survivor within
    `ShatterRadius` (the `Shattered` attribute is the client's burst);
  * `Invisible` (Prism Stalker): hidden unless `Rules.Threat.StalkerSeen`: lit, or within
    `StalkerRevealSeconds` of striking or being hit. **A light that shows it is any part tagged
    `RevealLight` with a `Radius` attribute** (a flare: WeaponService; a cave lantern:
    DeepService; a Flare Ping: ClassAbilities). `MonsterService:Lit(position)` is the same test
    for anyone else (BossService uses it for the Colossus's cores). On the client its parts fade
    to nothing except the ones named `Glint*`;
  * `ShrugsSmallGuns` (Geode Golem): a hit modifier that knows the gun (`WeaponService` passes
    the held item as a fifth argument): `Rules.Threat.SmallGunMultiplier` for items flagged
    `Small` in `Config.Items` (`ShruggedAt` is the client's ricochet);
  * `Heals` and `Hastes` (Resonator): it follows the nearest monster that isn't one, never
    strikes, and every `AttackSeconds` its hum heals `Rules.Threat.HumHeal` and sets `HasteUntil`
    on every monster within its `Range` (`HumAt`, `HummedAt` and `Hasted` are the client's).
* The A10 monsters: `Monster_Shardling`, `Monster_PrismStalker` (Glass plates; Neon `Glint*`
  parts), `Monster_GeodeGolem`, `Monster_Resonator` (its Attack clip is the hum), each with Idle,
  Walk and Attack. `Boss_CrystalColossus`: four `Core*` parts with Role `WeakPoint`, socket
  `Slam`, `HitTime` 1.0 and `VolleyTime` 0.9, seven clips (Rig `CrystalColossus`: Idle, Walk,
  Attack, Volley, Roar, Stagger, Death), its pivot at the floor.
* `Lib.PathGraph` walks a doorway 0.5 studs in front of its middle (the opening is 7 studs
  clear), so a root up to 4 studs wide gets through (Prompt 24; it was 2).

## Disasters and repairs (Run place)

Bible Section 10, with Sections 5, 6 and 11 (Prompt 13). `Shared.Rules.Disasters` is pure: fire
growth, damage and spread targets (doorways on one floor; `Fireproof` rooms such as the Shaft
never burn), the Surge's pick (`SurgeWeight` disasters of the era and before that the budget
pays for), blackout floors and units, the valves (`ValveTurned`, `ValveReleased`, `ValvesOn`,
`MeltdownStopped`; solo players' turns last `SoloValveSeconds`, a team's while held), rubble HP,
dig times, damage and the passages it blocks, electrical surge odds and aftermath, repair rates.
The numbers are `Config.Disasters` and `Tuning.Disasters` / `Tuning.Repairs` (provisional).
`Shared.Rules.Modifiers.ClassValue(class, key, level?)` folds a class's passive modifiers
(ExtinguishSpeed, FireFloodDamageTaken, RepairSpeed; level 2 and 3 effects with Prompt 20).

* `DisasterService` owns every disaster and the `Disasters` collection (ids `F:<room>` fire,
  `B:<n>` blackout, `C:<n>` rubble, `M:<n>` meltdown, `S:<room>` electrical surge), RunState
  `Fires`, `BlackoutRooms`, `Rubble`, `Meltdown`, `MeltdownEndsAt`, `ValvesTurned`, and
  `workspace.Bunker.Disasters` (the fuse box, the valves, the rubble). It ticks every
  `TickSeconds` while the run is playing (also with the dev clock paused):
  * fires grow, burn rooms (`BunkerGrid:SetHP`), players (CombatService, the Firefighter a
    quarter) and residents, spread every `SpreadSeconds` (`SetModifier(source, "FireSpread",
    x)`), and go out under residents (ResidentBrain's Extinguish activity), the Extinguisher
    (`WeaponService.ToolTick`, the Firefighter 3x) and Foam Grenades (`WeaponService.Foamed`);
  * blackouts darken units through `PowerService:SetBlackout` until the fuse box in the Reactor
    Core is held for `FuseSeconds` or `DurationSeconds` pass (`BlackoutDuration` modifiers);
  * `CaveIn(floor, column, side?, cause)` drops rubble in a doorway or fills a dug cell: it
    blocks graph edges in `Lib.Hazards` (PathGraph routes round them or answers Blocked), hurts
    whoever is under it, shows `Kit_Rubble_Doorway` or `Kit_Rubble_Tunnel` (by the face's
    width; a filled tunnel's piles sit inside the tunnel) over an invisible block, and goes when
    a Drill or Pickaxe holder digs through (one hold) or melee smashes it (`WeaponService.Swung`;
    BreaksRubble weapons 3x); the pile sinks as it is hit;
  * a Reactor Core wrecked (`BunkerGrid.Wrecked`) starts the meltdown (`StartMeltdown`): a fire
    in the Reactor, the valves' prompts, `TimerSeconds` to turn all three; it ends Fixed, or
    Lost (`RunDirector:Lose("ReactorDestroyed")`);
  * electrical surges damage a room's machines until it is welded (`BuildService.Repaired`) or
    they expire into a fire or a floor blackout;
  * `SurgeDisaster(budget, rng)` buys the Surge's one disaster (started `SurgeDelaySeconds` in);
    `HoldsSurge()` keeps the Surge open while it, any fire or a meltdown is on.
  * floods (Prompt 23; ids `W:<room>`, RunState `Floods`): `StartFlood(room, cause, level?,
    pipe?)` puts water in a room and, unless `pipe` is false, hangs `Kit_BurstPipe` on its back
    wall (`Pipe:<room>` in `workspace.Bunker.Disasters`, prompt PatchPipe). The level rises
    `RisePerSecond` while the pipe runs, follows a deeper neighbour on its floor or above
    (`FloodFed`), and drains `DrainPerSecond` (times `FloodDrainSpeed`) otherwise; from
    `SpreadMinLevel` it pours on every `SpreadSeconds` (`FloodSpreadTargets`: the Shaft below
    first, else rooms beside it; never up, never into dug cells). Depth past `WadeLevel` hurts
    players (the Firefighter a quarter), residents and the room. `PatchPipe`, `Drain` (Foam
    Burst), `Flooded`;
  * gas leaks (ids `G:<room>`, RunState `GasLeaks`): `StartGasLeak(room, cause, strength?)`
    hangs `Kit_GasVent` at the room's Vent socket (prompt SealVent); strength fills
    `FillPerSecond` while it leaks, clears `ClearPerSecond` once sealed or after
    `Config.Disasters.GasLeak.DurationSeconds`; it hurts everyone in the room (times
    `GasStrength`; `GasImmune` players none). `SealVent`, `ClearGas` (Decon Field), `Gassed`;
  * `HazardPocket(floor, column, player?)` (DigService's roll): the band's `Hazards` decide gas
    or water (`Rules.Disasters.HazardKind`), into the room the digger stands in or the nearest
    on that floor;
  * players carry `Wading` and `InGas` attributes; `Lib.Hazards` has `SetFlood`, `SetGas` and
    `Unsafe(unit, floodAt, gasAt)`, which ResidentBrain reads (residents leave at
    `ResidentFleeLevel` and `ResidentFleeStrength`, and wade at `Rules.Disasters.WadeSpeed`);
  * Signals `Started` and `Ended`; dev commands `disasters`, `fire`, `fire.out`, `blackout`,
    `blackout.end`, `cavein`, `rubble.clear`, `meltdown`, `meltdown.stop`, `valve`, `esurge`,
    `disaster.surge`, `flood`, `flood.patch`, `flood.drain`, `gas`, `gas.seal`, `gas.clear`,
    `pocket`.
* Wrecked rooms (`Rules.Bunker`): a room at 0 HP is `Wrecked` (no output, power made or drawn,
  crew or machine target) until it is back to `RepairedAt` (25%) of its HP. `BunkerGrid` fires
  `Wrecked` and `Repaired` and applies HP modifiers (`SetHPModifier`, Reinforced Walls).
* Repairs (`BuildService`): the Welder held (`UseTool`) repairs the first damaged room ahead
  within `WelderReach` (`RepairSpeed`: the Engineer 2x); residents at work repair their own room
  by Smarts; `Repair(roomId, amount, how, player?)` and the `Repaired` signal; wreck and works
  again alerts; dev `repairs`, `repair`.
* `ResidentService:SetTrapped` and ResidentBrain: a resident whose route is Blocked waits,
  trapped (out of the crew), until the rubble goes; residents fight a fire where they stand
  until hurt below `ResidentFleeHealth`, then keep out of burning rooms.
* `WeaponService`: tools (`Kind = "Tool"`) are used by holding Fire (`UseTool` true/false); it
  fires `ToolTick` every `ToolTickSeconds` and sets the `ToolInUse` attribute; `Swung` for melee
  landings, `Foamed` for Foam Grenade bursts, `Items(player)`.
* `DisasterController` (client): flames, smoke, embers and light per burning cell, steam, surge
  sparks, the meltdown's alarm light, rubble dust, the tools' foam and sparks from the held
  model's Muzzle, the Welder's room HP bar, the HUD's Meltdown telegram and valve plates, the dig
  prompt shown only to Drill and Pickaxe holders, statuses and blinking in the Command View and
  on the mini-map (`CommandViewController:SetStatus`, `SetConditionNote`), and the named sounds
  once Prompt 32 adds them.
* From Prompt 23 `DisasterController` also draws water (a see-through block and a rippling
  surface per flooded cell, an underwater tint when the camera is in it; never Glass, which hides
  what is behind it), gas clouds and their light, the spray and the hiss at a fitting's
  `Socket_Spray` or `Socket_Leak`, the Wading movement reason and the gas tint.
* Radiation leaks (Prompt 24; `Tuning.Disasters.Radiation`): a strength 0 to 100 on a set of
  graph units (`Lib.Hazards.SetRadiation`): every open cell of the Blast Door's floor for a door
  leak (id `R:Door`), one room for a seam (`R:<room>`). `clock.SurgeStarted` rolls
  `Rules.Disasters.DoorLeakChance` from `FromEra`; a Crystal Hollows hazard pocket starts a
  seam's. It fills `FillPerSecond` (times `DeconSlow` with a working Decon Room) until
  `SealLeak` (the fitting's prompt, `SealSeconds`), a door upgrade or
  `Config.Disasters.RadiationLeak.DurationSeconds`, then fades. Players in it carry
  `InRadiation` (SurfaceService's radiation tick adds `Rules.Disasters.RadiationPlayerRate`);
  residents leave at `ResidentFleeStrength`, lose health, and are Irradiated from `IrradiateAt`.
  The fittings: `Kit_DoorSeal` on the door's jamb (`DOOR_SEAL_SIDE` studs from its middle, clear
  of the lift's prompt) and `Kit_CrystalSeam` where `seamSpot` finds back wall with nothing in
  front of it. `ClearRadiation` is Decon Field's.
* Outbreaks (Prompt 24; `Tuning.Disasters.Outbreak`): one event (id `O:<n>`) while anyone is
  Sick. `FromTheDeep(residentId, why)` rolls `CarriesSickness` for someone rescued in the Deep
  (RescueService) or home from a Deep expedition (ExpeditionService). Every `SpreadSeconds` each
  sick resident may infect one in their room (`OutbreakTargets`); a working Medbay cures one
  patient per `CureSeconds` (`Cure`); curing the last ends it.
* The published entries: `{ Kind = "Radiation", Floor, Room?, Door?, Units, Strength, Leaking,
  EndsAt, Cause }` and `{ Kind = "Outbreak", Sick, Quarantined, Patient?, Cure, Treating, Cause }`.
  The client draws motes, haze and a light per irradiated cell, a glow at the fitting's
  `Socket_Leak`, a tint for whoever stands in it (`InRadiation`, or `CaveRadiation` in a Crystal
  Hollows cave), a cough on the sick, and the Command View's RADIATION status and note.
  Dev: `leak [room|door] [strength]`, `leak.storm`, `leak.seal`, `leak.clear`, `outbreak [id]`,
  `outbreak.cure [id|all]`, `outbreak.deep <id> [force]`.
* Art: `Tool_Extinguisher` and `Tool_Welder` in `ServerStorage.Assets.Weapons` (Grip and Muzzle
  sockets), `Kit_Rubble_Doorway` and `Kit_Rubble_Tunnel` in `ServerStorage.Assets.Kit`, their
  icons in the items atlas; `Kit_BurstPipe` and `Kit_GasVent` in `ServerStorage.Assets.Kit`
  (Prompt 23; each is one MeshPart with its pivot where DisasterService places it).

## Digging, Disturbance and Push Deeper (Run place)

Bible Sections 6, 7, 10 and 14 (Prompt 14). `Shared.Rules.Dig` is pure: the faces a rock cell
is dug from (`Faces`: left, right or from the cell above) and where their prompts stand
(`FacePoint`), dig seconds by band (`Config.DepthBands`), stacking (`Rate`: the Driller's
`DigSpeed` 2), the Drill Bay's speed (`DrillBaySpeed`: `ResidentDigMultiplier` of a player per
unit of crew output), Push Deeper (`StartLimit` 3, `LimitAfter` the band's last floor,
`NeedsVote`), the roll (`Roll(seed, floor, column, era, available)`: the same for a cell all run,
results whose systems don't exist yet count as Empty; `Hint` for the Driller's eye; `Depth` into
rock), and Disturbance (`AddDisturbance`, `Crossed`: the extra breach and the Tremor,
`AfterTremor`, `Level` CALM, RISING, UNSETTLED, DANGER). `Shared.Rules.Loot` rolls
`Config.LootTables` (`BandOre` lines, skipped specials, `OreMultiplier`; `Text` for alerts). The
numbers are `Tuning.Digging` and `Tuning.Disturbance` (provisional).

* `DigService` owns digging and the `Digs` collection (`S:<floor>,<column>` a cell being dug or
  queued: Progress, Diggers, Queue, Bay, Vote; `F:<floor>,<column>` what a dug cell holds:
  CaveOpening, Cache or Nest), RunState `Disturbance`, `DigLimit`, `DigSeed`, `TremorAt`,
  `Nests`, and `workspace.Bunker.Digging` (the dig prompts, the Command View's markers, the
  features' models). It ticks every `TickSeconds` while the run is playing:
  * a dig prompt (Kind `DigCell`, attributes `Cell` and `Progress`) at every face of every
    diggable rock cell; `PromptButtonHoldBegan` adds the player as a digger if they carry a Drill
    or a Pickaxe (`WeaponService:Items`), `HoldEnded` takes them off; diggers must stay alive,
    armed and near; progress stays when they let go;
  * the Drill Bay digs the first diggable queued cell (`Mark(floor, column, on, player)`, the
    `MarkDig` remote, up to 12) at the summed speed of every working Drill Bay
    (`EconomyService:Rate`);
  * past `DigLimit` a hold opens a Push Deeper vote (`VoteService:Open`, Kind `PushDeeper`; solo
    applies at once); a pass moves `DigLimit` to the band's last floor, a failure waits
    `VoteRetrySeconds`;
  * a cell that opens (`BunkerGrid:Dig`) adds `DisturbancePerCell` (the Driller's level 3
    `DigDisturbance`, `SetModifier(source, "DigDisturbance", x)`), applies its roll, announces it,
    fires `Dug(floor, column, result, cause)`, and caves in the passage it was dug through
    `CaveInChance` of the time (`DisasterService:CaveIn`, sideways digs only);
  * results: an ore pocket pays band ore into the stockpile (`DugOre`); a cave opening shows
    `Kit_CaveMouth` 2 studs off the back wall and adds a breach point
    (`BreachService:SetExtraPoint`, Kind `Cave`); a cache shows `Prop_SupplyCrate` with an
    `OpenCache` prompt (resources to the stockpile, throwables to the opener's hotbar through
    `WeaponService:GiveThrowable`; gear and radio logs skipped until their prompts); a nest shows
    `Prop_Nest`, registers it with CombatService as a monster (an ordinary `M<n>` id, so
    FireWeapon accepts hits), adds a breach point (Kind `Nest`) and pours out
    `ThreatDirector:Burst(NestBudget)`; destroyed (`CombatService.Died`), it pays Loot `Nest` and
    drops Disturbance by `NestDestroyed`;
  * nothing is built on a feature's cell (`BuildService:SetCellCheck`);
  * Disturbance: explosions (`WeaponService.Exploded`) add `Explosive`; each new cycle living
    nests add `NestPerCycle` each and it falls `DecayPerCycle`; crossing `ExtraBreachAt` calls
    `ThreatDirector:ExtraBreach()`, reaching `TremorAt` calls `ThreatDirector:Tremor()`, caves in
    a doorway near the deepest floor, sets `TremorAt` and drops to `AfterTremor`;
  * API `Disturbance()`, `AddDisturbance(amount, source)`, `DigNow(floor, column, cause,
    player?)`, `Mark`, `SetModifier`, `Feature(floor, column)`; dev commands `digs`, `dig`,
    `dig.roll`, `dig.mark`, `disturbance`, `disturbance.add`, `tremor`, `pushdeeper`, `nest`,
    `cache`, `cave`.
* `ThreatDirector`: `Burst(fraction, at, tag)` spawns monsters at once at a spot; `ExtraBreach`
  and `Tremor` are priced as a quarter and a whole of a normal Surge's budget (the first run's
  Era I easing applies). `BreachService:SetExtraPoint(id, point?)` adds points other services
  own. `WeaponService`: `Exploded(position, radius, player)`, `GiveThrowable(player, item,
  count)`. `BuildService:SetCellCheck(fn)`.
* `DigController` (client): shows the dig prompts only to Drill and Pickaxe carriers; dust and
  chips at the faces of cells being dug and a burst when a cell opens; the camera shake at a
  Tremor (`CameraController:Shake`); the Command View's rock notes (dig time, progress, queue
  place, Push Deeper, the Driller's eye from `DigSeed` and `OreSightCells`), dug cells' notes
  (cave opening, cache, nest) and the queue options (`CommandViewController:SetCellNotes`,
  `SetRockOptions`, choices `MarkDig` and `UnmarkDig`, never voted).
* `HUDController`: the Disturbance seismograph (the level word and colour, a trace that swings
  harder as it rises, blinking at DANGER, a jump at a Tremor). `PromptController`: a prompt's
  `Progress` attribute drives its gauge (shared progress).
* Art: `Tool_Drill` and `Weapon_Pickaxe` in `ServerStorage.Assets.Weapons`, `Prop_Nest` in
  `Props`, `Kit_CaveMouth` in `Kit`, their icons in the items atlas.

## Bosses and results (Run place)

Bible Sections 5, 10, 16, 18, 21 and 22 (Prompt 15). `Shared.Rules.Boss` is pure: `Health(bossId,
players, firstRun)` (`Config.Bosses` Health times `Threat.PlayerScale`, times `FirstRunHealth` for
an Era I boss on an account's first run), `Phase(bossId, fraction)`, `ByPhase(list, phase)`,
`Arena(bunker)` (the longest dug run on the deepest floor, else its widest room that isn't the
Reactor Core or a Shaft, else any open cell), `ArenaMiddle`, `ArenaSpan(arena, margin)`,
`HitMultiplier(weak, classWeakPoint?)`, `OnPart(point, cframe, size, tolerance)`,
`Staggers(hits, now, window, threshold)`. `Shared.Rules.Results` is pure: `Payout(run, paid,
facts)` (lines, total and the new ledger, so a run that ends twice pays only what is new),
`BandsReached`, `AccountXP`, `XPToNext`, `LevelUp`, `Score`, `MVP` (ties to the lower user id),
`Day` (UTC). The numbers are `Tuning.Bosses`, `Tuning.<BossId>` (`Tuning.BroodMother`),
`Tuning.Results`, `Config.GlowshardRewards`, `Config.Difficulties` and `Tuning.Account`
(provisional).

* `BossService` runs a boss fight. `CycleClock.SurgeStarted("Boss", bossId)` (or `boss.start`)
  calls `BeginFight(bossId)`:
  * the warning (`ArrivalWarningSeconds`: dust and a blinking red light at the arena's middle, an
    alert), then the rise (`RiseSeconds`, a rock burst): a clone of `Config.Bosses` Asset from
    `ServerStorage.Assets.Bosses` in `workspace.Monsters` (graybox if missing), its root
    anchored and moved by the server (`PivotTo`), its root neither colliding nor queryable, a
    green light above it, attributes `Rig`, `MonsterType`, `Boss`, `Activity`, `AttackAt`,
    `ServerAnimated`; registered with CombatService as a monster with `KeepModel`;
  * its clips play on the server (`Config.Animations` with its id as Rig) and replicate:
    `NPCAnimator` skips `ServerAnimated` models, because the server judges weak-point hits
    against the parts' pose;
  * the tick (`TickSeconds`): phase changes (roar, alert), sacs hatching
    (`MonsterService:Spawn` of `Config.Bosses` Minions, tag `Boss:<id>`), turning
    (`TurnDegreesPerSecond`) and walking along the arena (`ArenaSpan`) towards the nearest
    standing player, slams (`SlamReach`, damage `SlamDamage` within `SlamRadius` of the `Slam`
    socket at the clip's `HitTime`), laying sacs at the `Ovipositor` socket (`LayTime`; each a
    CombatService monster, `MonsterType` EggSac);
  * hits: `WeaponService:SetHitModifier` scales hits on the boss (`ArmourMultiplier`, or
    `WeakPointMultiplier`/the class's own on a part with `Role` WeakPoint, within
    `WeakPointTolerance`, +2 for melee, +3 for blasts; renamed `weakpoint`) and fire on sacs
    (`BurnMultiplier`); weak-point damage in `StaggerWindowSeconds` reaching `StaggerFraction`
    of its health staggers it;
  * death (`CombatService.Died`): the Death clip held, sacs wither, `Defeated(bossId, killer?)`,
    then `ObjectiveService:BossBeaten` (which ends the boss Surge); `DeathSeconds` later it
    dissolves (`CombatService:Dissolve`). The run ending clears a fight.
  * the `Boss` collection, key `Fight`: Id, Name, Health, Max, Phase, Phases, State (Warning,
    Rising, Fighting, Dying), At, ArriveAt, Sacs. API `BeginFight`, `Active`, `IsBoss(combatId)`,
    `IsEggSac(combatId)`; dev `boss`, `boss.start [id]`, `boss.hurt <n> [weak]`, `boss.lay`,
    `boss.freeze [s]`, `boss.end`.
  * **The Deluge** (Prompt 23; `Tuning.Deluge`) is the second fight in the same service: the
    tick is chosen by boss id, and a table (`LOOK`) holds each boss's light, burst colours, clips
    and alert words. It arrives the same way, then the fight's `Mode` (published with the Fight)
    cycles: `Up` (turns to the nearest survivor on its floor, bites at the `Bite` socket on the
    Attack clip's `HitTime`: `BiteDamage` within `BiteRadius`; `SurfaceSeconds`, or
    `AloneSeconds` with nobody within twice `BiteReach`), `Diving` (`DiveSeconds`), `Swim` (sunk
    `SwimDepth`; `Rules.Bunker.CellPath` to the nearest standing player it can reach, re-aimed
    at each cell, at `SwimSpeed` for at most `SwimSeconds`; each room passed gets
    `DisasterService:StartFlood(room, "Deluge", FloodLevel, pipe)`, no pipe in a Shaft; hits do
    `SubmergedMultiplier`), `Surfacing` (`SurfaceRiseSeconds`; never in a Shaft; `Murklings` by
    phase come with it). It moves every frame on Heartbeat (the 0.1 s tick only decides). A
    phase that begins under water roars as it comes up. Its staggers extend its time up. Dev
    `boss.start Deluge`, `boss.dive`, `boss.surface`. `Rules.Boss.Title(name)` writes a boss's
    name with one THE.
* `BossController` (client): the HUD's `BossBar` (name, BREAKING THROUGH, PHASE n OF m, DEAD, the
  fill; for The Deluge also UNDER THE FLOOR or UP: HIT ITS HEAD from the fight's `Mode`) and
  camera shakes when the boss rises, when its slam or bite lands near the player and when The
  Deluge surfaces near them (`SurfacedAt`).
* `ResultsService` counts each player's Damage, Kills, BossDamage (`BossService:IsBoss`; a broken
  sac isn't a kill), Revives, CellsDug (`DigService.Dug`'s finisher) and Repairs
  (`BuildService.Repaired`), the team's totals, and the story (`story(text)`: resident deaths,
  nests, meltdowns, bosses, Push Deeper from `DigLimit`, Tremors from `TremorAt`, the ending).
  On `RunDirector.RunEnded` it pays every ready player through `ProfileService:Update`
  (Glowshards, `AccountLevel`/`AccountXP`, `Stats` Runs, Wins, LastWinDay, BestYear, Deepest,
  BossesKilled, MonstersKilled, `FirstRunDone`), saves (`SaveNow`) and publishes the `Results`
  collection, key `Run` (Outcome, DefeatReason, Victory, Endless, Year, Cycle, Era, Difficulty,
  Seconds, DeepestFloor, Band, Team, Stories, MVP, Players[userId] = Name, Class, the stats,
  Score, Glowshards, Lines, XP, Level, LevelUp, Paid). Remotes `PlayAgain` (a `PlayAgain` vote
  opened by the game with the asker's yes; a pass reserves a Run server and teleports
  everyone), `KeepGoing` (after a victory, the `KeepGoing` vote, `RunDirector:KeepGoing`) and
  `ReturnToLobby` (that player); Studio says teleports don't work. Dev `results`,
  `results.stat <stat> <n>`.
* `ResultsController` (client): the `Results` screen (RUN REPORT; tabs Summary, Residents,
  Rewards; the MVP card on the detail panel; Play Again as the main action; Keep Going and Return
  to Lobby in the footer), opened `OpenDelaySeconds` after the run ends.
* `CombatService`: `KeepModel` (a combatant whose model its own service removes), `Dissolve`,
  dev `god [seconds] [player]`. `ThreatDirector:IsFirstRun()`. `WeaponService:SetHitModifier`.
* Art: `Boss_BroodMother` and `Boss_BroodMother_EggSac` in `ServerStorage.Assets.Bosses`. Boss
  body parts use the `queryhull` collision kind (Hull raycast shapes), so shots reach the weak
  point.
* The Crystal Colossus (Prompt 24; `Tuning.CrystalColossus`, `BossService`'s `tickColossus` and
  `frameColossus`): it strides out of the back of its arena (`EMERGE`), walks it and slams like
  the Brood Mother, and every `VolleySeconds` throws shards (`ShardMark` parts in
  `workspace.Monsters` with `Radius` and `LandsAt`: damage, `StunnedUntil` on players,
  `SlowedUntil` on residents, a Shardling hatching from its second phase, never more than
  `MaxShardlings`). Its hit modifier returns `ArmourMultiplier` unless the fight is `Lit` (a
  reveal light near it, `boss.light`, or its own charge for `FlashSeconds` as it throws) and the
  hit is on a core. The model's `Lit` attribute and the published `Lit` drive the cores' colour
  and the bar's text. Dev: `boss.start CrystalColossus`, `boss.volley`, `boss.light [seconds]`.
* A player's `StunnedUntil` (server time): the client stops their walking (`Movement.Set(
  "Stunned", 0)`), and WeaponService refuses their hands.
* The Source (Prompt 25; `Tuning.Source`, `Rules.Boss`'s `Source*` functions). BossService owns
  the fight as it does every boss's (the model, its clips on the server, the Boss collection, the
  hit modifier, its turning and slams: `tickSource`); `Lib.SourceFight` owns what is the Source's
  own, through a `ctx` of BossService's services and helpers: the stages (`Tuning.Source.Stages`,
  the fight's `Phase`), the tendrils (combatants with `MonsterType` SourceTendril and the
  `Tendril` attribute, in rooms chosen by `Rules.Boss.SourceRooms`, animated by NPCAnimator;
  each one that falls wounds the Source by `SourceWound`), the roots (`RootMark` parts in
  `workspace.Monsters` with `Radius` and `LandsAt`) and the regrowth. Its eye is shut in a
  Tendrils stage (`ClosedMultiplier` on every hit) and the weak point in a Core stage.
  - In the bunker: `CycleClock.SurgeStarted("Final", "Source")` begins it like an era boss's.
    Its death calls `ObjectiveService:BossBeaten`, which ends the final Surge: CycleClock fires
    `CenturySurvived` and RunDirector wins the Century Victory.
  - In its chamber: `DeepService` makes every floor 10 cell roll a cave opening until the Source
    Chamber stands (`Cave_Source_Entry`, the band's one piece) and exposes it
    (`DeepService:SourceChamber()`: the piece, its `Core` socket, its `Tendril` sockets). On
    `CaveOpened` for the band, BossService puts the Source there asleep (`sleeper`: a model with
    the `Asleep` attribute, registered with combat only to notice being hurt; no fight, so an
    era boss can still come). `wake` turns the sleeper into the fight (`Chamber = true`) when a
    player is within `WakeRange` or hurts it. Its death there calls `RunDirector:Win("Deep")`
    first and `BossBeaten` after, so a kill during the final Surge is still the Deep Victory.
  - Left asleep until the final Surge, the sleeper sinks out (`leaveChamber`) and the bunker
    fight begins. A boss whose Surge starts while a fight is on is kept (`waiting`) and begins
    when that fight is over.
  - `CycleClock:SetEndless` closes an open-ended Surge (Keep Going after a Deep Victory won
    during a boss's Surge or the final one).
  - The client: `BossController` (the bar's words from the published `Stage` and `Tendrils`, the
    mini-map's blink from `Rooms`, a Highlight on each tendril, the root marks) and
    `VictoryController` (each victory's moment on `StarterGui.Victory`; ResultsController waits
    `Tuning.Results.VictoryDelaySeconds` for it).
  Dev: `boss.start Source`, `boss.wake`, `boss.tendrils`, `boss.cut`, `boss.roots`,
  `boss.regrow`; client `victory.play [century|deep]`.

## The surface (Run place)

Bible Sections 9, 12 and 13 (Prompt 16). `Shared.Rules.Surface` is pure: `Zone(position)` (Surface
above `Tuning.Surface.ZoneY`; Prompt 17: Deep behind `Tuning.Deep.GridBack`, else Bunker),
`Realm(zone)` and `SameRealm(a, b)` (the bunker and the Deep are one realm, Underground),
`RadiationRate(zone, storm, gain)`, backpacks as lists of stacks
(`Stack`, `Slots(extra)`, `Used`, `Fit(pack, slots, id, count)`, `Merge`, `Unload(pack, room)`,
`Totals`, `Summary`, `Encode`/`Decode` for the `Pack` attribute), `CarrySpeed(carriers)`,
`SpawnSpot(points, players, range, rng)`, `SurvivorTier(roll)`. The numbers are `Tuning.Surface`
and `Tuning.MonsterAI`'s surface values (provisional).

* The map is `workspace.Surface`, static in the place at Y = `BrightwaterMap.GROUND` (200), built in
  Studio by `ServerScriptService.Lib.BrightwaterMap.Build()` from `ServerStorage.Assets.Surface`
  (A5; graybox stand-ins otherwise). Each place is a model with `PlaceId` (and `Location`) holding
  its containers (models with `Container`, `Location`) and a `Markers` folder (`SurvivorSpot`,
  `BigFindSpot`, `ElevatorExit`, `ElevatorCall`); `Spawns` holds `SpawnPoint`s; gates carry
  `MinEra` and parts with `Barrier`. Signs (art parts with Role `Sign`) get a `Lettering`
  SurfaceGui. A rebuild keeps moved places and `workspace.Surface.Decor` (Landon's dressing).
* `SurfaceService` reads the map (never builds it): zones (`Zone` attribute, `ZoneChanged`), the
  elevator (`workspace.Bunker.Elevator` RIDE UP at the Blast Door's `Door` socket, RIDE DOWN at
  `ElevatorCall`; the `Elevator` remote fades the client, the server moves the rider and their
  followers), containers (SEARCH, `Loot.Roll` with `ExtraLootRolls`, leftovers, refills on
  `EraChanged`, locks below `MinEra`), storms (`SurgeStarted`/`SurgeEnded`, RunState `Storm` and
  `StormAt`, the siren alert and the Scout's `StormWarningSeconds`), radiation (the `Radiation`
  attribute, Decon Rooms, Clear-Rad pills at `PillUseAt`, health drain at the max, Wraith hits),
  and the creatures (jackals by day, raiders from `RaiderMinEra`, wraiths in storms, at
  `SpawnPoint`s, `MaxMonsters`, despawned when the surface empties, a fall guard). Each day may
  trap a survivor and place generator parts. Prompt 17: the raider camp holding the surface's
  Lost Crew (`workspace.SurfaceCamp`, at one of the map's `CampSpot`s, guards tagged `Camp`).
  API `Zone`, `Storm`, `Radiation`, `AddRadiation`, `Map`, `CrewWhere`; signals `ZoneChanged`,
  `Searched`.
* `InventoryService`: backpacks (`Give`, the `Pack`, `PackUsed`, `PackSlots`, `ClearRad`
  attributes), unloading (`workspace.Bunker.Hauling`: the hall's point 15 studs from the
  elevator and one per Storage room; `Unload(player)` within the stockpile's caps), big finds
  (`PlaceFind(kind, at, tag)` in `workspace.Finds`, CARRY, HELP CARRY, PUT DOWN, the `Carrying`
  and `Carriers` attributes, `SetDelivery(kind, fn)`, else the loot table of that name), dropped
  bags (`Prop_LootBag`, PICK UP), Clear-Rad pills (`TakePill`) and monster drops (a kill on the
  surface or in the Deep into the last hitter's pack, a bunker kill into the stockpile). Loot
  specials go to their owner's handler (`SetSpecial`, `GiveSpecial`; Prompt 17: radio logs,
  Glowshards). Signals `Unloaded`, `Delivered`.
* `RescueService`: `Trap(at, options)` (a `Resident_Common` clone in `workspace.Rescues`, rubble, a
  FREE prompt), freed people as CombatService combatants (Kind `Survivor`, team `Survivors`)
  following a leader with PathfindingService, a catch-up teleport, leader hand-overs within a
  realm, the elevator (`Followers`), and joining (`ResidentService:Add`; `SetArrival(kind, fn)`
  runs after joining). Kinds Survivor, Miner and Crew (Prompt 17); `Tagged(tag)`. Signals
  `Freed`, `Joined`, `Lost`.
* `MonsterService` knows realms: monsters only target things in their own realm (survivors count
  as residents, machines are bunker-only), surface and cave monsters path with
  PathfindingService, jackals circle, raiders shoot (trait `Shoots`), `Despawn(id)`, `ZoneOf(id)`.
  Prompt 17: a monster in a cave reaches the bunker through the cave's mouth and the other way
  round (`SetCaveExit`); guards (`Spawn(type, at, tag, { Guard = range })`) sleep at their post,
  wake to a player within range or a hit, keep within 1.6 times that of their post, and go back.
* `WeaponService` and `CombatController` refuse gun, melee, throws, tools, rolls and Medkits while
  a player's hands are busy (`Carrying`).
* `SurfaceController` (client): the surface's Lighting (Surface and Storm presets, the bunker's
  captured at start), the `SurfaceGrade` colour correction, ash and gusts round the camera,
  lightning, the elevator fade and the camera turn, the HUD's radiation gauge and `Backpack` chip,
  prompt gating (carry, help, put down and unload by attributes; PUT DOWN hides near a station),
  the carry and Scout speeds, the Scout's `LootOutline` highlights.

## The Deep (Run place)

Bible Sections 6, 11, 12 and 14 (Prompt 17). `Shared.Rules.Deep` is pure: `MouthCFrame(floor,
column)` (the dug cell's back wall, facing -Z into the rock) and `MouthPoint` (in front, in the
cell), `ExitCFrame`, `WorldBox`, `Overlaps`, `Inside`, `Pieces(band, kind?)`, `Plan(band, mouth,
rng, occupied, { Crew, Pieces })` (the cave planner: the Entry, then pieces grown from exits, each
clear of `occupied` but for the 4 studs of wall it shares with the piece it hangs off; plugs; the
crew's pocket; no plan when another cave fills the rock), `RollFind(roll, era, findChance)`,
`CryoTier`, `CrewCell(seed, band, isOpen)`, `Hint(floor, column)`, `FallDamage(drop, immune)`,
`LightRange(multiplier)`, `Roster(band, usable)`. The numbers are `Tuning.Deep`, the pieces
`Config.CavePieces` (generated from the A6 sidecars by `tools/cave_config.py`: don't edit by hand),
the logs `Config.RadioLogs`.

* `DeepService` builds a cave on `DigService.FeatureAdded("CaveOpening", floor, column)` in
  `workspace.Deep` ("Cave <key>", one model per piece from `ServerStorage.Assets.Caves`, a graybox
  floor otherwise): the dug cell's `BackRock` hidden and anything solid in the opening made
  non-colliding (again on `BunkerGrid.Changed`), `DigService:OpenCave` (the stand-in mouth goes),
  rubble plugs (`Kit_Rubble_Doorway` x1.45 and an invisible block), lantern lights at `Light`
  sockets, finds at `Find` sockets (models with a `Find` attribute and a Custom prompt: MINE, OPEN,
  LISTEN; trapped miners through RescueService; cryo pods through InventoryService), cave nests at
  `Nest` sockets (combatants with breach points `CN:<id>` at the mouth), guards at `Spawn` sockets
  (spawned when a player comes within `WakeRange`, tag `Cave:<key>`).
* The Lost Crews: `DigService:SetRoll` makes each band's crew cell a cave opening (RunState
  `DigOverrides`); its cave's crew pocket holds the three (Kind Crew, Tag the objective) and a
  nest. `RescueService:SetArrival("Crew")` completes the objective (any Lost Crew, the surface's
  too) when the first is home; `Lost` with none left loses the crew.
* Radio logs: `InventoryService:SetSpecial("RadioLog")` and the recorders play the next unheard
  story log, or (HintChance, while a crew is lost) that crew's own log with its hint; the
  `RadioLog` remote. Glowshard chests: `SetSpecial("Glowshards")` pays every ready player through
  `ProfileService:Update`; `ChestOpened` tells ResultsService.
* Cryo pods: `DigService:SetResultHandler("CryoPod")` and cave finds place them
  (`PlacePod`; the first unlocks the Cryo Bay); `InventoryService:SetDelivery("CryoPod")` adds
  one to RunState `CryoPods`; Cryo Bays' `EconomyService:Rate` thaws them (`ThawPoints` each, while
  the clock runs) into Rare or Legendary residents.
* Players in the Deep: a `DeepLight` PointLight on the root (`LightRange` x `LightRadius`); falls
  read from the root's vertical speed on Heartbeat (`FallDamage`, `NoFallDamage`).
* `MonsterService:SetCaveExit` is DeepService's: a cave position's mouth point.
* `DeepController` (client): the `RadioLog` sheet (UIKit `Paper`, Special Elite, typed out) and the
  Spelunker's eye (`SpelunkerEye` Highlights on finds, nests, cryo pods and the trapped within
  `RevealRange`). `SurfaceController` has the Deep's lighting preset; `DigController` reads the
  overrides for the Driller's eye.
* API `Caves()`, `CaveAt(position)`, `Pods()`, `PlacePod(at, tag)`. Signals `CaveOpened`,
  `CrewHome`, `Thawed`, `ChestOpened`. Dev: `deep`, `deep.cave`, `deep.find`, `deep.tp`,
  `cryo.add`, `radiolog`, `crews`.
* The Crystal Hollows (Prompt 24): eight pieces (`Cave_Crystal_*`, `Config.CavePieces`), its
  crew on `Tuning.Deep.CrewFloors.CrystalHollows`, and radiation: a player in a cave of a band
  with `Tuning.Deep.CaveRadiationPerSecond` carries `CaveRadiation` (a rate; SurfaceService's
  radiation tick adds it). Cave lanterns are reveal lights.

## Expeditions and the radio (Run place)

Bible Sections 6, 8, 11, 12 and 14 (Prompt 18). `Shared.Rules.Expeditions` is pure: `Check(destination,
members, cycles, medkits)` (1 to 3 residents, alive, in the bunker, not cut off; 1 to 3 cycles; up to
`MedkitsMax` Medkits), `Supplies(members, cycles)` (Food and Water for every member for every cycle),
`Risk(team)` (the team's average of Grit and Speed against `StatPivot`), `Fast(team)` and
`Trip(cycles, team)` (a team averaging `FastSpeed` is away a cycle less, never under 1; Landon,
Prompt 18), `Odds(destination, team)`
(hurt, distress, lost: the bible's odds times the destination's `Danger` and the Risk), `Event(odds,
x)`, `RiskLabel`, `Carry(stats, effects)` and `Team(team, effects)` (Strength carries; a member's own
`ExpeditionCarry`, `ExpeditionLoot`, `ExpeditionScrap`), `Scale(drops, team)`, `Expected(...)` (a
cycle's average finds, for the screen), `Harm(maxHealth, x, medkit)`, `Deadline(cycle)`,
`RecruitTier`, `Names`, `Place`, `Fill`, `Lines(destination, event)`. The numbers are
`Tuning.Expeditions`, the log lines `Config.ExpeditionLogs`, the finds `LootTables` ExpeditionSurface
and ExpeditionDeep.

* `ExpeditionService` puts an EXPEDITIONS console prompt (Kind `Expeditions`) on the radio of the
  Blast Door guard's desk (`Kit_BlastDoor`'s `GuardDesk`; beside the door in a graybox hall) and in
  every Radio Room (`<bunker>.ExpeditionConsoles`, again on `BunkerGrid.Changed`). The
  `SendExpedition` remote (destination, resident ids, cycles, Medkits; no vote, Section 8) is
  checked: the sender within `UseRange` of a console, `Rules.Expeditions.Check`, the stockpile
  (`EconomyService:Spend` takes the Food, Water and Medkits). Each member leaves their job and goes
  Away (`ResidentService:SetAway`); `ResidentBrain` walks them out through the Blast Door and their
  body goes (no body while away). A Deep expedition goes to the band of the deepest floor (its ore).
* At each dawn (`CycleClock.CycleStarted`) an expedition out since an earlier cycle lives a cycle:
  packed Food and Water eaten, `XPPerExpeditionCycle` (`ResidentService:GainXP`), the loot table
  rolled and scaled by the team (`Scale`; gear and blueprints skipped until Prompts 26 and 19; one
  recruit at most a trip), and one event: nothing, someone hurt (`ResidentService:Wound`, never
  below 1; a packed Medkit halves it), someone lost (`ResidentService:Lose`; a packed Medkit makes
  it a bad hurt instead) or a distress call. Lines go in the expedition's log and the members' run
  logs (`ResidentService:Note`). After the last cycle they step into the hall with the finds and
  the supplies left (`EconomyService:Add`) and go back to their old jobs if there's room. A fast
  team (`Trip` < `Cycles`) turns for home after `Trip` cycles with the finds of every cycle picked
  (the missing cycles' loot is rolled as they leave; an `Early` line in the log), and the unused
  Food and Water come back with them.
* Distress calls: the call comes `CallDelay` running seconds into that day, less the team's best
  `DistressCallLeadSeconds` (the Radio Operator), on everyone's radio card (the `RadioLog` remote)
  and in the alerts. Only a working Radio Room (staffed and powered: `RunState.RadioWorks`, which
  the screen reads to warn before SEND) hears it (Landon, Prompt 18): unheard, every member still
  out is lost at once with the finds (an `Unheard` log line, one alert, no radio card). The team is pinned down at `SurfaceService:DistressSpot()` (a free survivor
  spot) or `DeepService:DistressSpot()` (a piece of an open cave; with none, the rock face of the
  deepest floor): each member is a RescueService rescue of Kind `Expedition` (`Resident` = their id,
  a HELP prompt with their name, their own health). Helped, they follow home; the arrival
  (`RescueService:SetArrival("Expedition")`) brings that resident back (`SetAway` off, the health
  the way left them, where they stood) and the first one home brings the finds. At the next cycle's
  Surge (`SurgeStarted`: the end of the next day phase) whoever is still pinned down is lost; with
  nobody left to bring them, the finds are lost too.
* The Radio Room: its `Recruits` output (`EconomyService:Rate`) times the team's best `RecruitRate`
  accrues while the clock runs (`Rules.Economy.Accrue`); each whole point is a recruit at the Blast
  Door (`Recruit(tier, how)`: Rare at `RadioRareChance` times `RareRecruitChance`; refused at
  `Constants.CAPS.Residents`). While a Lost Crew is out and a Radio Room works, every
  `RadioHintCycles` cycles it plays that crew's call (`DeepService:CrewCall`, `PlayLog`).
* `ExpeditionService:SetModifier(source, key, value?)` takes RecruitRate, RareRecruitChance and
  DistressCallLeadSeconds from draft cards and Legends; players' classes are read directly.
* The `Expeditions` collection (id -> Destination, Band, Members { Id, Name, Status }, Cycles, Done,
  LeftAt, Back, State, Log, Finds, Recruits, Food, Water, Medkits, CallCycle, Deadline, Marker, Where)
  feeds `ExpeditionsController` (client): the Expeditions screen (SURFACE and DEEP: pick the team
  from resident cards, the footer sets the length and the Medkits, zone D the supplies, risk and
  finds, SEND; ACTIVE: each expedition's team, deadline or return, finds, supplies and log) opened
  from the console prompts, and the distress markers (a red flare column, the `HUD.Templates.Distress`
  plate through walls with the time left, and a `HUD.Templates.EdgeArrow` while it's off screen).
* API `Send(destination, ids, cycles, medkits, player?)`, `Recruit(tier?, how)`, `SetModifier`,
  `Active()`. Signals `Sent`, `Returned`, `Lost`, `Distress`, `Reached`, `Recruited` (ResultsService
  tells their stories). Dev: `exp`, `exp.send`, `exp.cycle`, `exp.call`, `exp.home`,
  `exp.deadline`, `recruit`, `radio [call]`.

## The blueprint draft (Run place)

Bible Section 8 and the Appendix's card pool; Prompt 19. `Shared.Rules.Draft` (pure: the pool,
weighted draws with EarlyWeight in Era I, a card's face, tallies, a controller's next pick),
`Config.DraftCards` (each card's kind, modifiers, weights, `Short` face text), `Tuning.Draft`.

* `VoteService` runs draft votes: a spec with `Options` is a MostVotes vote. Players pick with the
  `CastPick` remote (changeable until it closes); time up, the most picks wins, ties at random;
  everyone having picked closes it. Solo runs vote too (the player's pick closes it). `SetOptions`
  swaps an open draft's cards (a reroll: picks cleared, the time restarted). `Live()` gives the vote
  on the banner. The Votes collection carries `Options` (with each one's `Votes`), `Picked` and
  `Winner`.
* `DraftService` opens a draft at every `CycleClock.SurgeEnded` (not after the final Surge), draws 3
  cards from the usable pool (every modifier has a handler in its HANDLERS; a room card's room not
  yet unlocked; the Steel Blast Door below level 3) plus the first found blueprint waiting, and
  applies the winner through each owning service's hook:
  `BuildService:Unlock`, `BunkerGrid:SetHPModifier`, `DisasterService:SetModifier`,
  `BreachService:SetModifier` (DarkSpawnBonus), `BunkerGrid:SetLevel` (the Blast Door),
  `ResidentService:AddLevels`/`AddMorale`, `ExpeditionService:Recruit`,
  `WeaponService:SetModifier` (WeaponRarityUp, StaminaMult) and `AddMedkits`,
  `DigService:SetModifier`, `EconomyService:SetModifier` (RoomOutput), and its own Overclock
  overload rolls (`DisasterService:StartMeltdown`), Bounty Contract kills (`MonsterService.Died`)
  and Salvage Rights (`SurfaceService:SetLootBoost`, `SetStormEarly`).
* Found blueprints: InventoryService's `Blueprint` special draws a card; on the surface or in the
  Deep it goes into the pack (`InventoryService:GiveCard`, its own slot) and comes home when
  unloaded (`InventoryService.CardsHome`); in the bunker it is home at once; expeditions bring
  theirs home (`ExpeditionService.BlueprintsHome`). `AddFound` queues a card that's home; the next
  draft shows it as a fourth card (FoundPerDraft), stamped FOUND with the finder's name.
* Rerolls: the `RerollDraft` remote uses a free reroll (FreeDraftRerollsPerEra: the level 3 Mad
  Scientist, one per era; players carry `DraftRerolls`). `Reroll(player, "Paid")` is for Prompt 28.
* `VoteController` shows a draft as the telegram ("BLUEPRINT DRAFT · PICK A CARD", picks, timer)
  with the cards below it (`StarterGui.Votes.Draft`, sprites `Draft_<Kind>` and `Stamp_Found` from
  the draft atlases): click or tap a card, or Y (tap: the next card; hold: the one before); REROLL
  where YES and NO sit for a player with a free reroll. It preloads the draft atlases.
* Signals: `DraftService.Drafted(card, how)` (ResultsService tells it in the story),
  `FoundHome(card, by)`. Dev: draft, draft.open, draft.take, draft.found, draft.reroll [paid],
  draft.cards, bounty [kills], vote.pick <n|id> [voter], pack.add Blueprint.

## Classes (Run place)

Bible Section 14 (classes, class levels) and Section 9 (Q is the class ability); Prompt 20.
`Shared.Rules.Classes` (pure: an ability's cooldown, uses, options and duration; levels from
experience), `Config.Classes` (kits, passives, abilities, level 2 and 3 as modifiers),
`Tuning.Classes` (everything the bible doesn't give; provisional).

* **Which class.** `Lib.RunRecord` is the record the Lobby writes to MemoryStore before the teleport
  (hash map `RunRecords`, key = the reserved server's id; `{ Version, Party, Difficulty, Loadouts =
  { [userId] = { Class, Trial } }, CreatedAt }`; Studio's key is "Studio"). When a session is ready
  `ClassService` gives the player the record's class if their profile owns it or it is their free
  trial (level 1, no experience), else the Survivor, and puts `Class`, `ClassLevel` and `ClassTrial`
  on the Player; `WeaponService:SetClass` hands out the kit.
* **Effects.** Every system reads a class effect with `Modifiers.PlayerValue` (a level's value
  replaces the passive's). Bunker-wide effects go to their systems as the strongest holder's value
  (`EconomyService:SetModifier`, `BuildService:SetModifier`, `ResidentService:SetModifier`,
  `DisasterService:SetModifier`, `BunkerGrid:SetHPModifier`, RunState `BuildCost`).
  `CombatService:AddDamageFilter` carries Hold the Line, the drone's Guard and residents' damage
  near a Security, armed, or rallied; `WeaponService:AddHitModifier` and its `Hit` signal (player,
  target, damage, how, point, the hit's own kind) carry creature damage, burning, boss staggers and
  the Exterminator's Disturbance. `VoteService:SetTieBreaker` is the Warden.
* **The ability.** `UseAbility(option, origin, look)` from `ClassController` (a tap of Q, LB or the
  touch button; a hold picks the next option, `PickAbilityOption`). `ClassService` checks the run,
  the player and readiness (seconds, cycles, or uses that return each Surge, cycle or era), then
  `Lib.ClassAbilities.Use(state, option, origin, look)` does it through the owning services and
  returns `(ok, text, effect, seconds)`: not ok costs nothing and the text says why. Devices that
  stay in the world (turret, barricades, crate, napalm, traps, the beacon, the gravity well, the
  drone) live in ClassAbilities and read their art's sockets (`Socket_<Name>` attributes).
* **What the client reads**, on the Player: `AbilityReadyAt`, `AbilityReadyCycle`, `AbilityUses`,
  `AbilityMax`, `AbilityOption`, `AbilityOptionReadyAt`, `AbilityEffect`, `AbilityActiveUntil`,
  `SteadyShots`. RunState: `LevelStat` (the level 2 Warden's choice, `ChooseLevelStat`),
  `BeaconUntil`, `BeaconBy`. Remotes: UseAbility, PickAbilityOption, TeleportToBeacon,
  ChooseLevelStat, Grapple, AbilityFx, ArcZap.
* **Class experience.** `ResultsService` pays it with the run's payout: `ClassService:RunXP(player,
  years, paidYears)` is `Rules.Classes.RunXP` (XPPerYear a year; none for a trial); the level
  follows the experience (`LevelFor`: 150 and 500) and `Refresh(player)` puts it in play.
* **Held weapons.** `Config.Items.Hold` (TwoHanded, Hip, Heavy) picks the player's clips in
  `CombatController` (RifleHold, RifleAim, RifleReload, HeavySwing1 and 2, Throw). Every long gun's
  `Support` socket is 1 stud ahead of its `Grip`, so one pair of clips fits them all.
* Dev: classes, class <Id> [level] [player], class.level, class.own, ability [option],
  ability.ready, classxp <years>, resident.arm <id|all> [item|none], record <Class> [trial].

## The intro cutscene (Run place)

Bible Section 4; Prompt 22. `Shared.Rules.Cutscene` (pure), `Config.CutscenePaths` (generated from
the Blender scene: `generators/Cutscene/Intro_Scene.py --data`, then `tools/cutscene_config.py`;
never edited by hand), `Config.Cutscenes` (words and lighting), `Tuning.Cutscene`.

* **One number.** Everything on screen is set each frame from the seconds since the cutscene
  began: `Cutscene.Elapsed(30, RunState.TimeLeft())` in the Intro phase. No tweens, no timers.
  That is why it ends with the run's clock, why a late joiner enters at the right moment, and how
  `cutscene.at <seconds>` holds a moment.
* **The data.** `Shots` (name, From, To, Space "Set" or "Bunker", Rate, Handover, Keys of
  `{ x, y, z, qx, qy, qz, qw, field of view }`), `Set` (Asset, Category, P, Yaw, Scale, Kind,
  Paint), `Ground`, `RunPath`, `Runners` (Delay, Side), `RunSpeed`, `Anchors`, `Beats`, `WaveReach`,
  `Cloud`. A piece's Kind says what the blast does to it: Still, Block (sinks and leans), Car
  (thrown), Tree and Tower (go over), Bunting (gone).
* **The set.** `CutsceneService` builds `ReplicatedStorage.CutsceneSet` at the start (`Pieces`,
  `Ground`, `Effects`) from `ServerStorage.Assets` and destroys it `KeepSetSeconds` into the run.
  `CutsceneController` clones it to `Tuning.Cutscene.SetOrigin` for its own client and destroys the
  clone when it finishes. "Set" shots are in that space; "Bunker" shots are at
  `Grid.CellPosition(1, 0)`, in front of the real bunker shown by `CommandViewController:Present`.
* **Taking and giving back.** It takes the camera (`CameraController:Suspend`), hides the HUD
  (`HUDController:Hide`), locks the screens (`UIController:Lock`), blocks input, holds the
  character and hides Roblox's own menus, all under the reason "Cutscene", and gives each back in
  `finish`. The last shot (`Handover`) ends in code: `CommandViewController:Pose` over the
  player's character, then `CameraController:Resume` and a push-in to the live camera.
* **Skip.** `Cutscene.CanSkip(firstRun, elapsed, skipAfter)`: the player's `IntroFirstRun`
  attribute (the profile's `FirstRunDone`, set by `CutsceneService`) and
  `Tuning.Clock.IntroSkipAfterSeconds`. A skipper gets the `Cutscene.Wait` telegram until the run
  starts.
* **Runners.** Avatars from `Players:CreateHumanoidModelFromDescription` on the client (a copy of
  the character until it arrives), then copies of `workspace.Bunker.Residents`. A runner's clip is
  loaded only once its model is in `workspace` (a clip loaded before that never plays).

## The lobby (Lobby place)

Bible Section 21 (the hub, elevator pads, teleport, rejoin), Section 14 (the Daily Class Shop, the
wishlist, the free trial), Section 17 (the 99 Robux reroll); Prompt 21. `Shared.Rules.ClassShop`
and `Shared.Rules.Lobby` (pure), `Config.Pads`, `Tuning.ClassShop` and `Tuning.Lobby`.

* **The shop** is the profile's `ClassShop` record (`{ Day, Slots, RerollsUsed, Wishlist?, WishDay?,
  Trial?, TrialUsed? }`) and the loadout its `Loadout` record (`{ Class }`). `ClassShopService`
  refreshes the shop when a session is ready and whenever the UTC day turns, and answers ShopBuy,
  ShopReroll, ShopWish and SetLoadoutClass. `Rules.ClassShop.Settle` puts the loadout back on a
  class that can be played after anything that may have taken the trial away. The client reads the
  Player's `ShopDay` and `VIP` and ReplicatedStorage's `ShopResetAt`.
* **Purchases.** `PurchaseService` (both places) is ProcessReceipt: a product is a row with an id
  from Config and a grant that edits the profile without yielding; `ProfileService:GrantPurchase`
  runs it once per receipt. `Prompt(player, name)` opens Roblox's prompt; `Granted` fires once per
  receipt. The first row is ClassShopReroll (`Tuning.ClassShop.RerollProductId`).
* **Pads.** A pad in the world is a Model with a `PadId` attribute (a `Config.Pads` id) and a
  `Floor` part; a player whose root is over the floor rides it. `PadService` runs each pad's phase
  (Idle, Waiting, Counting, Launching), `Rules.Lobby.MayBoard` says who may ride, and the `Pads`
  collection and the Player's `Pad` attribute tell clients. Remotes: PadDifficulty, PadStart,
  PadInvite, PadHold. A pad model's `Sign` part carries the sign (`PadController` puts
  `Lobby.Templates.PadSign`, a SurfaceGui, on the side its `SignFace` attribute names).
* **Launching.** `Lib.RunLaunch.Start(players, difficulty, loadouts)`: reserve a Run server, write
  the run's record under its id (`Lib.RunRecord`), write each player's rejoin record
  (`Lib.Rejoin`: hash map `RunRejoin`, key = the user id, `{ Key, Code, Difficulty, At }`),
  teleport. The pads and Play Again both use it. In Studio the record goes under the Studio key
  and nothing teleports.
* **In the Run place** `PartyService` reads the record once: it sets the difficulty
  (`RunDirector:SetDifficulty`), holds each session at its `Party` gate until then, sends strangers
  (and anyone in a server that isn't reserved) back to the lobby, and renews the party's rejoin
  records while the run is on.
* **Rejoin.** `RejoinService` reads a player's rejoin record when their session is ready and sets
  the Player's `RejoinOffer`; RejoinRun sends them back with the record's code (never sent to a
  client), RejoinDismiss puts the card away.
* **The screens.** `ClassShopController` owns the Class Shop and Loadout pages of The Frame;
  `LobbyController` the class plate, the two buttons, the wallet, alerts, the booths' prompts
  (a ProximityPrompt with a `LobbyAction` attribute: "ClassShop" or "Loadout") and the rejoin card;
  `PadController` the signs, the pad panel and the invite list. `Lib.ClassArt` says how a class is
  shown (its portrait when the UI kit has one, else its signature item's icon). The mouse is locked
  as in a run, so buttons carry key chips (`LobbyController:SetKey`); a wheel click frees the cursor.
* **The world** is `workspace.Lobby`, built in Studio by the Luau `tools/lobby_world.py` prints
  (asset 104368016773499): the showroom (`Lobby_Showroom`, `Hall`, `Fit`, `Frontage`), six
  `Lobby_ElevatorPad` at its `Socket_Bay1..6`, the booths at `Socket_ClassBooth` and
  `Socket_LoadoutBooth`, ten `Lobby_Block*` along Main Street (`generators/Lobby/street_plan.py`),
  the ground, cars, bunting, the town beyond the barricades, tall invisible walls (`Bounds`) and
  four spawns. Town and lobby models are merged decoration with no collision: `AssetSetup` builds
  each model's `Colliders` (invisible boxes; small ones tagged CameraIgnore) and `Lights` from its
  sidecar.
* Dev: shop, shop.new, shop.day <n>, shop.rerolls <n>, shop.trial <used|unused>, pads, pad.go <id>,
  pad.fill <id> <n>, pad.unlock <Hard|Nightmare|none>, products, purchase.test <Product>
  [receiptId], rejoin, rejoin.fake [Difficulty], rejoin.clear; in Run: party.

## Saved data

One profile per player (bible Section 23), shape and migrations in `Lib.ProfileSchema`, I/O in
`ProfileService`. The stored record is `{ Data, Lock, Meta }` in the `PlayerProfiles` DataStore
(`PlayerProfiles_Studio` in Studio, so tests never touch live saves), key `Player_<userId>`.

* Load claims the lock through UpdateAsync. A fresh lock from another server: wait and retry
  (8 tries, 2 s apart), then kick with a message. A stale lock (3 autosaves old; 30 s in
  Studio): taken over. A newer version: refused, nothing written. Then migrate, reconcile,
  validate; a failure kicks the player and writes nothing.
* Saves: every 120 s (staggered; refreshes the lock), on leaving (releases it) and on
  shutdown (BindToClose waits for every release). A save writes only if this server still
  holds the lock and the profile validates; losing the lock kicks the player.
* Gameplay calls `ProfileService:Update(player, fn)` (undone if it errors or leaves the profile
  invalid), `AddGlowshards`, `SpendGlowshards`, and `GrantPurchase(player, receiptId, grant)`
  for ProcessReceipt: grant, record the receipt, save, then report granted; a repeated
  receipt is never granted twice.
* The player's client reads its own profile (minus receipts) from the `Profiles` collection.
* A session isn't ready until its profile loads (SessionService gate `Profile`).
* Changing the shape: raise `ProfileSchema.VERSION`, add a migration, update `Default` and the
  shape. Old servers refuse newer saves, so a rolling update can't corrupt them.

## Content

All content is data in `Shared.Config` (bible Section 23). Each content type is a child
ModuleScript returning `{ Schema = Check.shape(...), Entries = { Id = entry }, Order = {...}? }`
(or `Schemas`, one checker per entry, for Tuning). Config validates every entry at load
(fields, ids, `Check.ref` cross-references), freezes it and adds `Id`. Read with
`Config.Get(type, id)` (errors if missing), `Config.Find` (for ids from players or saves),
`Config.All(type)`, `Config.Ids(type)`. Problems are listed by `Config.Errors()`, logged, and
fail StructureCheck and the data tests. `Config._Fields` holds checkers the content modules
share (modules starting with `_` are helpers, not types).

Content types (Prompt 1): Badges, Bosses, Classes, Conditions, DepthBands, DigResults,
Difficulties, Disasters, DraftCards, Eras, GamePasses, GlowshardPacks, GlowshardRewards,
ItemRarities, Items, Leaderboards, Legends, LootTables, Modifiers, MoraleStates, Monsters,
Objectives, Quests, Recipes, ResidentNames, Resources, Rooms, Stats, SurfaceLocations,
TalentSlots, TeamBoosts, Tiers, Traits, Tuning, Votes, WandererOutcomes; Prompt 17: CavePieces
(generated by `tools/cave_config.py`) and RadioLogs; Prompt 18: ExpeditionLogs.

**Effects are data.** Classes, traits, Legends, draft cards and passes describe what they do
as modifiers: `{ Key = "RoomOutput", Value = 1.25, Room = "Medbay", Scope = "Bunker" }`.
`Config.Modifiers` is the vocabulary: each key's unit (Multiplier, Add, Set, Flag, Chance),
default scope, and the prompt whose system applies it. A system reads the keys it owns; a new
effect is a new key plus the code that honours it.

**Rule numbers** live in `Config.Tuning`, one entry per system (Clock, Grid, StartingBunker,
Rooms, Votes, Player, Digging, Disturbance, Bosses and one per boss fight (BroodMother),
Results, Threat, Residents, Aging, Morale, Trader, Wanderers, Expeditions, Surface, Deep, Legends,
ClassShop, Account, Lobby).

## DevTools

* `/dev <command>` in chat for allowed players (everyone in Studio; outside Studio only the
  admins in `Constants.ADMIN_USER_IDS`); `/dev help` lists commands. Services add their own
  in `Init` with `DevService:Register`.
* In a Studio playtest: `ServerScriptService.DevTools.Invoke:Invoke("test")` on the server,
  `PlayerScripts.DevInvoke:Invoke("replica Rooms")` on a client.
* `structure`: StructureCheck. `test [filter]`: DataTests. Both run once whenever a Studio
  playtest starts (set the `RunChecksOnStart` attribute on DevTools to false to stop that).
* Other built-ins: `version`, `ping`, `players`, `remotes`, `log [level]`, `logs [count]`,
  `rep`, `rep.selftest`; on the client `replica <collection>`, `client`, `clock`,
  `ready [true|false]` (fires SetReady like the HUD button), `camera`, `camera.shoulder`,
  `camera.aim [bool]`, `camera.look <yaw> <pitch>`, `camera.zoom <studs>`, `camera.cursor`,
  `ui`, `ui.sample`, `ui.list`, `ui.dock`, `ui.open <screen>`, `ui.close`, `ui.tab <id>`,
  `ui.main`, `hud`, `hud.alert <Danger|Warning|Info> <text>`, `hud.banner <text>`,
  `hud.slot <n>`, `hud.touch [bool]`, `cv` (the Command View's state and options), `cv.open`,
  `cv.close`, `cv.select <floor> <column>`, `cv.ping`, `cv.ghost <floor> <column> <span>
  [label]`, `cv.unghost`, `cv.blink <roomId> [false]`, `cv.overlay <name> [false]` (a sample
  reading for screenshots).
* The bunker (Run place): `grid` (map), `grid.rooms`, `grid.graph`, `grid.dig <floor> <column>`,
  `grid.build <Type> <floor> <column> [span] [level]`, `grid.remove <id>`, `grid.merge <id> <id>`,
  `grid.level <id> <level>`, `grid.rebuild`, `grid.sockets <id>`, `grid.art`.
* The run (Run place): `run`, `run.skipintro`, `run.win <century|deep>`,
  `run.lose <reactor|residents>`, `run.keepgoing`; `clock`, `clock.speed <x>`, `clock.pause`,
  `clock.resume`, `clock.next`, `clock.clear`, `boss.beat [bossId]`, `year <n>`,
  `ready.all [bool]`, `rest.all [bool]`; `objectives`, `objective <id>`; `cell.ping <floor>
  <column>` (pings as the first player).
* Votes and construction (Run place): `stock`, `stock.set <resource> <n>`, `stock.add
  <resource> <n>`, `research [n]`; `votes`, `vote.yes [n]`, `vote.no [n]` (as you, or as pretend
  voter n), `vote.end` (time is up now), `vote.test [title]` (a vote with no proposer and no
  effect), `vote.bots <n> [yes|no|abstain]` (Studio: pretend voters join the team); `build
  <Build|Upgrade|Merge|TearDown> <floor> <column> [roomType|otherRoomId]`, `sites`,
  `site.finish [id]`, `unlock <roomType>`. From Studio's server tools, `build` and `vote.yes|no`
  act as the first player in the run. On the client, `vote` prints the telegram and the ghosts.
* Residents (Run place): `residents`, `residents.auto`, `residents.add [count] [tier] [level]`,
  `resident.assign <id> <roomId|none>`, `resident.hurt <id> <amount>`, `resident.revive <id>`,
  `resident.set <id> <health|rest|morale|xp|stat> <value>`, `brains` (where each body is going).
* A command's name must be its own across a place: DevService refuses a second registration and
  that service's Init fails. `tools/game_sync.py build` checks before it builds.
* `flare` (a flare at your feet, as the first player from Studio's server tools).
* The economy and power (Run place): `production` (every room's rate and why idle rooms are
  idle), `staff <roomId|roomType> <statSum> [workers] [morale]` and `staff.clear` (Studio: pretend
  crews until residents arrive), `eaters <n>` (pretend eaters), `eat` (the start-of-cycle meal
  now), `power` (the balance, steps and dark rooms), `run.difficulty <Normal|Hard|Nightmare>`.
* `ServerStorage.NS_Pipeline` (an outside Night Shift importer plugin's empty working folder,
  which Landon can't remove) is only a StructureCheck warning; scripts inside it would be an
  error.

## Conventions

* `--!strict` in every file. Tabs. PascalCase for modules, types, methods and content ids;
  camelCase for locals. Content ids: letters, digits and `_`, starting with a letter.
* Logging through `Utilities.Log` (`Log.new("Tag")`), never bare `print`.
* Tunables are content (Config); identity and engine limits are `Constants`.
* Every prompt ends with Design Notes and a Delivery Report in `game/reports/`.

