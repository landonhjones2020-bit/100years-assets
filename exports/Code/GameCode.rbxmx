--[[
	Config: every piece of content is data (bible Section 23). Rooms, resident name pools,
	traits, classes, talents, Legends, monsters, weapons, loot tables, draft cards,
	disasters, objectives and prices each get a ModuleScript under this one, and systems
	read them through this aggregator. Adding content never needs new system code.

	A content module returns:

		return {
			Schema = Check.shape({ ... }),   -- the checker for one entry
			Entries = {                      -- keyed by id (letters, digits, _; starts with a letter)
				Kitchen = { ... },
			},
			Order = { "Kitchen", ... },      -- optional display order (default: ids sorted)
		}

	A type whose entries differ in shape (Tuning: one entry per system) gives `Schemas`
	(id -> checker) instead of `Schema`. Child modules whose names start with `_` are helpers
	shared by content modules (Config._Fields), not content types.

	Every entry is checked against its Schema when Config loads; Check.ref("Weapons") fields
	must name an entry that exists. Entries come back frozen, with an `Id` field added.
	Problems don't stop the game from loading: they are listed by Config.Errors(), logged,
	and fail DevTools' StructureCheck and data tests.

	Content types arrive with Prompt 1; Prompt 0 ships the aggregator.
]]

local Check = require(script.Parent.Utilities.Check)
local Log = require(script.Parent.Utilities.Log)
local TableUtil = require(script.Parent.Utilities.TableUtil)

export type Entry = { [string]: any }

export type ContentType = {
	Name: string,
	Entries: { [string]: Entry },
	Order: { string },
}

export type Registry = {
	Types: { [string]: ContentType },
	Errors: { string },
}

local ID_PATTERN = "^[%a][%w_]*$"

local Config = {}

--[[
	Builds a registry from definitions ({ [typeName] = module table }). Pure: the data tests
	call it with fixtures.
]]
function Config.Build(definitions: { [string]: any }): Registry
	local registry: Registry = { Types = {}, Errors = {} }
	local errors = registry.Errors
	local refs: { { from: string, typeName: string, id: string } } = {}

	local typeNames = TableUtil.SortedKeys(definitions)
	for _, typeName in typeNames do
		local definition = definitions[typeName]
		if type(definition) ~= "table" then
			local reason = if type(definition) == "string" then definition else "the module must return a table"
			table.insert(errors, `{typeName}: {reason}`)
			continue
		end
		local schema = definition.Schema
		local schemas = definition.Schemas
		local entries = definition.Entries
		if type(schema) ~= "function" and type(schemas) ~= "table" then
			table.insert(errors, `{typeName}: give a Schema (a Check checker) or Schemas (id -> checker)`)
			continue
		end
		if type(entries) ~= "table" then
			table.insert(errors, `{typeName}: Entries must be a table of id = entry`)
			continue
		end
		if type(schemas) == "table" then
			for id in schemas do
				if entries[id] == nil then
					table.insert(errors, `{typeName}: Schemas has {tostring(id)}, which has no entry`)
				end
			end
		end

		local built: { [string]: Entry } = {}
		for _, id in TableUtil.SortedKeys(entries) do
			local entry = entries[id]
			if type(id) ~= "string" or not string.find(id, ID_PATTERN) then
				table.insert(errors, `{typeName}: bad id {tostring(id)} (letters, digits and _, starting with a letter)`)
				continue
			end
			if type(entry) ~= "table" then
				table.insert(errors, `{typeName}.{id}: entry must be a table`)
				continue
			end
			if entry.Id ~= nil and entry.Id ~= id then
				table.insert(errors, `{typeName}.{id}: Id field doesn't match its key`)
				continue
			end
			local check = if type(schemas) == "table" then schemas[id] else schema
			if type(check) ~= "function" then
				table.insert(errors, `{typeName}.{id}: no schema for this entry`)
				continue
			end
			local copy = TableUtil.DeepCopy(entry)
			copy.Id = nil
			Check._setRefSink(function(refType: string, refId: string)
				table.insert(refs, { from = `{typeName}.{id}`, typeName = refType, id = refId })
			end)
			local called, ok, why = pcall(check, copy)
			Check._setRefSink(nil)
			if not called then
				table.insert(errors, `{typeName}.{id}: the schema check failed: {tostring(ok)}`)
				continue
			elseif not ok then
				table.insert(errors, `{typeName}.{id}: {why}`)
				continue
			end
			copy.Id = id
			built[id] = TableUtil.DeepFreeze(copy)
		end

		local order: { string } = {}
		if definition.Order ~= nil then
			if type(definition.Order) ~= "table" then
				table.insert(errors, `{typeName}: Order must be a list of ids`)
			else
				local listed: { [string]: boolean } = {}
				for _, id in definition.Order do
					if built[id] == nil then
						table.insert(errors, `{typeName}: Order lists {tostring(id)}, which isn't an entry`)
					elseif listed[id] then
						table.insert(errors, `{typeName}: Order lists {id} twice`)
					else
						listed[id] = true
						table.insert(order, id)
					end
				end
				for _, id in TableUtil.SortedKeys(built) do
					if not listed[id] then
						table.insert(errors, `{typeName}: Order is missing {id}`)
						table.insert(order, id)
					end
				end
			end
		else
			order = TableUtil.SortedKeys(built) :: { string }
		end

		registry.Types[typeName] = table.freeze({
			Name = typeName,
			Entries = table.freeze(built),
			Order = table.freeze(order),
		})
	end

	for _, ref in refs do
		local target = registry.Types[ref.typeName]
		if target == nil then
			table.insert(errors, `{ref.from}: refers to {ref.typeName}, which isn't a content type`)
		elseif target.Entries[ref.id] == nil then
			table.insert(errors, `{ref.from}: {ref.typeName}.{ref.id} doesn't exist`)
		end
	end

	table.freeze(registry.Types)
	return registry
end

local function loadChildren(): { [string]: any }
	local definitions: { [string]: any } = {}
	for _, child in script:GetChildren() do
		if child:IsA("ModuleScript") and string.sub(child.Name, 1, 1) ~= "_" then
			local ok, result = pcall(require, child)
			definitions[child.Name] = if ok then result else `failed to load: {result}`
		end
	end
	return definitions
end

local registry = Config.Build(loadChildren())

if #registry.Errors > 0 then
	local log = Log.new("Config")
	for _, problem in registry.Errors do
		log:Error("%s", problem)
	end
end

local function contentType(typeName: string): ContentType
	local found = registry.Types[typeName]
	if not found then
		error(`Config has no content type {tostring(typeName)}`, 3)
	end
	return found
end

-- The entry, or an error if it doesn't exist (a bug in the caller or the data).
function Config.Get(typeName: string, id: string): Entry
	local entry = contentType(typeName).Entries[id]
	if entry == nil then
		error(`Config: {typeName}.{tostring(id)} doesn't exist`, 2)
	end
	return entry
end

-- The entry or nil (for ids that arrive from players or saved data).
function Config.Find(typeName: string, id: any): Entry?
	local found = registry.Types[typeName]
	if not found or type(id) ~= "string" then
		return nil
	end
	return found.Entries[id]
end

-- Every entry of a type, in its Order.
function Config.All(typeName: string): { Entry }
	local found = contentType(typeName)
	local list = {}
	for _, id in found.Order do
		table.insert(list, found.Entries[id])
	end
	return list
end

function Config.Ids(typeName: string): { string }
	return contentType(typeName).Order
end

function Config.Types(): { string }
	return TableUtil.SortedKeys(registry.Types) :: { string }
end

function Config.Errors(): { string }
	return table.clone(registry.Errors)
end

return table.freeze(Config)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX00000006"><Properties><string name="Name">Badges</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Badges (bible Section 16): survival, depth, victories, residents and combat. 5 to 50
	Glowshards each, once; some unlock Legends (Legends.Get). Hidden lore badges arrive with
	the Codex (Prompt 29). BadgeId is set when the Roblox badges are created.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function b(name: string, group: string, text: string, glowshards: number): { [string]: any }
	return { Name = name, Group = group, Text = text, Glowshards = glowshards }
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Group = Check.enum({ "Survival", "Depth", "Victory", "Residents", "Combat", "Lore" }),
		Text = F.Short,
		Glowshards = Check.integer(5, 50),
		BadgeId = Check.optional(F.PositiveInt),
	}),
	Order = {
		"Year25", "Year50", "Year75", "Year100", "DepthFlooded", "DepthCrystal", "Depth10",
		"CenturyVictory", "DeepVictory", "HardVictory", "NightmareVictory",
		"Year100With30", "NoDeaths", "Rescue50", "LetIn10Wanderers",
		"BeatBroodMother", "BeatDeluge", "BeatCrystalColossus", "BeatSource", "Monsters1000",
	},
	Entries = {
		Year25 = b("Settled In", "Survival", "Reach Year 25.", 5),
		Year50 = b("Halfway There", "Survival", "Reach Year 50.", 10),
		Year75 = b("Three Quarters", "Survival", "Reach Year 75.", 15),
		Year100 = b("Built to Last", "Survival", "Reach Year 100.", 25),
		DepthFlooded = b("Wet Feet", "Depth", "Reach the Flooded Caverns.", 5),
		DepthCrystal = b("Into the Glow", "Depth", "Reach the Crystal Hollows.", 10),
		Depth10 = b("Rock Bottom", "Depth", "Reach depth 10, the Source Chamber.", 20),
		CenturyVictory = b("A Clearing Sky", "Victory", "Win a Century Victory.", 25),
		DeepVictory = b("Dug Too Deep", "Victory", "Win a Deep Victory.", 40),
		HardVictory = b("Hard Times", "Victory", "Win on Hard.", 40),
		NightmareVictory = b("Nightmare's End", "Victory", "Win on Nightmare.", 50),
		Year100With30 = b("Full House", "Residents", "Reach Year 100 with 30 residents alive.", 30),
		NoDeaths = b("Nobody Left Behind", "Residents", "Finish a run with no resident deaths.", 25),
		Rescue50 = b("Search and Rescue", "Residents", "Rescue 50 survivors in total.", 20),
		LetIn10Wanderers = b("Open Door", "Residents", "Let in 10 genuine wanderers.", 15),
		BeatBroodMother = b("Egg Breaker", "Combat", "Beat the Brood Mother.", 10),
		BeatDeluge = b("High and Dry", "Combat", "Beat The Deluge.", 15),
		BeatCrystalColossus = b("Shatterproof", "Combat", "Beat the Crystal Colossus.", 20),
		BeatSource = b("Lights Out", "Combat", "Beat the Source.", 30),
		Monsters1000 = b("Exterminator", "Combat", "Defeat 1,000 monsters.", 20),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000007"><Properties><string name="Name">Bosses</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Bosses: each era ends with one (bible Section 10). Beating one adds 1 to Years per Cycle
	(Tuning.Clock). Health and phases are provisional, for Prompts 15, 23, 24 and 25.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Year = Check.integer(1, 100),
		Arrives = F.Text,
		Fight = F.Text,
		Health = F.PositiveInt,
		Phases = Check.integer(1, 5),
		Minions = Check.optional(Check.array(Check.ref("Monsters"), 4)),
		Badge = Check.optional(Check.ref("Badges")),
		Asset = F.Asset,
	}),
	Order = { "BroodMother", "Deluge", "CrystalColossus", "Source" },
	Entries = {
		BroodMother = {
			Name = "Brood Mother",
			Year = 25,
			Arrives = "Bursts up through the deepest tunnel.",
			Fight = "Lays egg sacs that hatch Burrow Ticks; break or burn the sacs and hit her glowing belly.",
			Health = 6000,
			Phases = 2,
			Minions = { "BurrowTick" },
			Badge = "BeatBroodMother",
			Asset = "Boss_BroodMother",
		},
		Deluge = {
			Name = "The Deluge",
			Year = 50,
			Arrives = "A giant eel surging up the flooded tunnels.",
			Fight = "Floods every room it passes; strike its head when it surfaces and drain the rooms behind it.",
			Health = 12000,
			Phases = 3,
			Minions = { "Murkling" },
			Badge = "BeatDeluge",
			Asset = "Boss_Deluge",
		},
		CrystalColossus = {
			Name = "Crystal Colossus",
			Year = 75,
			Arrives = "Tears out of the crystal rock.",
			Fight = "Huge, slow and armoured; flares show its weak points; its shards stun.",
			Health = 20000,
			Phases = 3,
			Minions = { "Shardling" },
			Badge = "BeatCrystalColossus",
			Asset = "Boss_CrystalColossus",
		},
		Source = {
			Name = "The Source",
			Year = 100,
			Arrives = "Rises into the bunker, or is fought earlier in its chamber at depth 10.",
			Fight = "Several phases: tendrils in many rooms at once, then the core, so the team has to split up and regroup.",
			Health = 40000,
			Phases = 4,
			Badge = "BeatSource",
			Asset = "Boss_Source",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">Classes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Classes: 18 buyable classes plus the free Survivor (bible Section 14). Each is a row of data
	so new ones ship without code. Kit is the starting gear; Passive, Ability, Level2 and
	Level3 carry the text players read and the modifiers systems apply (Config.Modifiers).
	Talents reuse another class's Passive; TalentExclude lists the keys that can't be
	borrowed (the Warden's tie-break), and Talentable = false shuts a passive out entirely
	(the Tinkerer's drone). Numbers the bible leaves open are marked "provisional" in Notes.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Ability = Check.shape({
	Name = F.Name,
	Text = F.Text,
	CooldownSeconds = Check.optional(F.Seconds),
	CooldownCycles = Check.optional(F.PositiveInt),
	DurationSeconds = Check.optional(F.Seconds),
	Uses = Check.optional(Check.shape({ Per = Check.enum({ "Surge", "Cycle", "Era" }), Count = F.PositiveInt })),
	Options = Check.optional(Check.array(F.Name, 4)),
	Modifiers = Check.optional(F.Modifiers),
})

local function mod(key: string, value: number, extra: { [string]: any }?): { [string]: any }
	local t: { [string]: any } = { Key = key, Value = value }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Tier = Check.ref("Tiers"),
		Price = F.Count, -- Glowshards
		Kit = F.ItemStacks,
		Companion = Check.optional(F.Name),
		Passive = F.Effect,
		Ability = Ability,
		Level2 = Check.optional(F.Effect),
		Level3 = Check.optional(F.Effect),
		Talentable = Check.boolean(),
		TalentExclude = Check.optional(Check.array(Check.ref("Modifiers"), 4)),
		Notes = Check.optional(F.Short),
	}),
	Order = {
		"Survivor", "Engineer", "Medic", "Firefighter", "Cook", "Security", "Scout",
		"Quartermaster", "RadioOperator", "HazmatTech", "Exterminator", "Marksman", "Driller", "Scavenger",
		"Warden", "Demolitionist", "Spelunker", "MadScientist", "Tinkerer",
	},
	Entries = {
		Survivor = {
			Name = "Survivor", Tier = "Free", Price = 0,
			Kit = { { Item = "Wrench" }, { Item = "PocketPistol" } },
			Passive = { Text = "None." },
			Ability = { Name = "Second Wind", Text = "Heal 25%, once per Surge.", Uses = { Per = "Surge", Count = 1 } },
