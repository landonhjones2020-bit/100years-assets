test("Remotes: every definition is complete", function()
	for name, definition in Remotes.Definitions do
		expect(string.find(name, "^%u%w*$"), `{name} to be PascalCase`)
		expect(definition.To == "Server" or definition.To == "Client", `{name}.To`)
		expect(type(definition.Doc) == "string" and #definition.Doc > 10, `{name}.Doc`)
		expect(definition.Place == nil or definition.Place == "Lobby" or definition.Place == "Run", `{name}.Place`)
		if definition.To == "Server" then
			expect(definition.Args ~= nil and definition.Rate ~= nil, `{name} to have Args and Rate`)
		end
	end
	expectEqual(Remotes.InPlace("SetReady"), Constants.PlaceKind() == "Run", "SetReady only in the Run place")
end)

test("Constants: this place knows what it is", function()
	local kind = Constants.PlaceKind()
	expect(kind == "Lobby" or kind == "Run", "Lobby or Run")
end)

test("Draft: three cards after every Surge, most picks wins, a card taken leaves the pool (Section 8)", function()
	expectEqual(Draft.Tuning().Cards, 3, "three cards a draft")
	local votes = Config.Get("Votes", "Draft")
	expectEqual(votes.Seconds, 20, "20 seconds to pick")
	expectEqual(votes.Rule, "MostVotes", "most picks wins")
	expectEqual(#Config.Ids("DraftCards"), 29, "the Appendix's 29 cards")
	for _, card in all("DraftCards") do
		expect(Draft.KIND_LABEL[card.Kind] ~= nil, `{card.Id}: a kind tag`)
		expect(#card.Short > 0 and #card.Short <= 48, `{card.Id}: a short face text that fits a card`)
		if card.Kind == "Room" then
			expect(card.Room ~= nil and Config.Get("Rooms", card.Room).Unlock.Kind ~= "Start", `{card.Id}: unlocks a room that isn't there from the start`)
			expect((card.EarlyWeight or 0) > card.Weight, `{card.Id}: weighs more in Era I`)
		end
	end
	-- the pool: taken and held-back cards are out; usable narrows it
	local taken = { ArmoryCard = true }
	local held = { LabCard = true }
	local pool = Draft.Pool(taken, held, function(card)
		return card.Kind ~= "RiskDeal"
	end)
	expect(not table.find(pool, "ArmoryCard") and not table.find(pool, "LabCard"), "taken and held cards stay out")
	expect(not table.find(pool, "Overclock"), "unusable cards stay out")
	expect(table.find(pool, "Sprinklers") ~= nil, "the rest are in")
	-- draws: no repeats, n at most, and room cards come up more in Era I
	local rng = Random.new(19)
	local all19 = Draft.Pool({}, nil, nil)
	for _ = 1, 50 do
		local drawn = Draft.Draw(all19, 3, 1, rng)
		expectEqual(#drawn, 3, "three drawn")
		expect(drawn[1] ~= drawn[2] and drawn[2] ~= drawn[3] and drawn[1] ~= drawn[3], "no repeats in a draw")
	end
	expectEqual(#Draft.Draw({ "Sprinklers" }, 3, 1, rng), 1, "a small pool gives what it has")
	local function roomShare(era: number): number
		local rooms = 0
		for _ = 1, 600 do
			local id = Draft.Draw(all19, 1, era, rng)[1]
			if Config.Get("DraftCards", id).Kind == "Room" then
				rooms += 1
			end
		end
		return rooms / 600
	end
	expect(roomShare(1) > roomShare(2) + 0.08, "room cards come up more in Era I")
	-- tallies and a controller's Y
	local counts = Draft.Tally({ [1] = "A", [2] = "B", [3] = "A", [4] = "Nope" }, { "A", "B", "C" })
	expectEqual(counts.A, 2, "two picked A")
	expectEqual(counts.B, 1, "one picked B")
	expectEqual(counts.C, 0, "none picked C")
	expectEqual(counts.Nope, nil, "a pick that isn't a card doesn't count")
	expectEqual(Draft.NextPick({ "A", "B", "C" }, nil), "A", "Y with no pick takes the first card")
	expectEqual(Draft.NextPick({ "A", "B", "C" }, "C"), "A", "Y wraps round")
	expectEqual(Draft.NextPick({}, nil), nil, "no cards, no pick")
	local winner = Votes.Winner({ A = 1, B = 1, C = 0 }, { "A", "B", "C" }, Random.new(1))
	expect(winner == "A" or winner == "B", "a tie is picked at random between the tied")
	expect(Votes.Winner({ A = 0, B = 0 }, { "A", "B" }, Random.new(2)) ~= nil, "a draft nobody picked in still gives a card")
end)

test("Draft: what found blueprints and the cards need (Landon, Prompt 19)", function()
	expectEqual(Draft.Tuning().FoundPerDraft, 1, "a found blueprint joins a draft as one extra card")
	for _, id in { "ExpeditionSurface", "HardwareStore", "RadioTower", "Showroom" } do
		local lines = Loot.Lines(id, {})
		local has = false
		for _, line in lines do
			if line.Special == "Blueprint" then
				has = true
			end
		end
		expect(has, `{id} can hold a blueprint`)
	end
	local text = Loot.Text({ { Special = "Blueprint", Count = 1 } })
	expectEqual(text, "1 BLUEPRINT", "a blueprint's name in alerts")
	expect(string.find(Surface.Summary({ { Id = "LoungeCard", Count = 1 } }), "BLUEPRINT: LOUNGE") ~= nil, "a carried card's name in the pack")
	-- modifiers of every card have a key in the vocabulary, and one-shot keys are Add or Multiplier
	for _, card in all("DraftCards") do
		for _, m in card.Modifiers or {} do
			expect(Config.Find("Modifiers", m.Key) ~= nil, `{card.Id}: {m.Key} is a modifier`)
		end
	end
	expectEqual(Config.Get("Monsters", "AshRaiderMelee").Name, "Ash Raider", "melee raiders are Ash Raiders too (Landon, Prompt 16)")
	expect(table.find(Config.Get("Monsters", "AshRaiderMelee").Traits or {}, "Shoots") == nil, "melee raiders don't shoot")
	local share = Config.Get("Tuning", "Surface").RaiderMeleeShare
	expect(share > 0.3 and share < 0.36, "about a third of raiders fight hand to hand")
end)

-- Runner ---------------------------------------------------------------------------------

test("Classes: abilities, uses, durations and options (Section 14; Prompt 20)", function()
	-- every class has an ability that waits on something
	for _, class in all("Classes") do
		local a = class.Ability
		expect(a.CooldownSeconds or a.CooldownCycles or a.Uses, `{class.Id}'s ability waits on a cooldown or uses`)
	end
	expectEqual(Classes.UsesFor("Survivor", 1), 1, "Second Wind: once per Surge")
	expectEqual(Classes.UsesPer("Survivor"), "Surge")
	expectEqual(Classes.UsesFor("RadioOperator", 1), 1, "Supply Call: once an era")
	expectEqual(Classes.UsesFor("RadioOperator", 2), 2, "the Radio Operator's level 2: twice")
	expectEqual(Classes.UsesFor("Quartermaster", 3), 1, "Emergency Requisition: once a cycle")
	expectEqual(Classes.UsesFor("Engineer", 1), nil, "a cooldown, not uses")
	expectEqual(Classes.Duration("Engineer", 1), 45, "a turret for 45 s")
	expectEqual(Classes.Duration("Engineer", 3), 90, "level 3: twice as long")
	expectEqual(Classes.Duration("Security", 2), 8, "Hold the Line: 8 s")
	expectEqual(Classes.Duration("Survivor", 1), 0, "instant")
	expectEqual(Classes.OptionName("MadScientist", 2), "Teleport Beacon")
	expectEqual(Classes.OptionIndex("MadScientist", 4), 1, "options wrap")
	expectEqual(Classes.OptionName("Medic", 1), nil, "no options")
	expect(Classes.OwnCooldowns("MadScientist"), "the gadgets keep a cooldown each")
	expect(not Classes.OwnCooldowns("Tinkerer"), "drone modes share one")
	expectEqual(Classes.WaitText(12.2, nil), "13 S")
	expectEqual(Classes.WaitText(nil, 2), "2 CYCLES")
	expectEqual(Classes.WaitText(0, nil), "READY")
end)

test("Classes: levels from experience, about 3 runs and 10 runs (Section 14; Prompt 20)", function()
	local t = Classes.Tuning()
	local runs = Config.Get("Tuning", "ClassShop").ClassLevelRuns
	expectEqual(Classes.LevelXP(1), 0)
	expectEqual(Classes.LevelXP(2), runs[1] * t.TypicalRunYears * t.XPPerYear)
	expectEqual(Classes.LevelXP(3), runs[2] * t.TypicalRunYears * t.XPPerYear)
	expectEqual(Classes.LevelFor(Classes.LevelXP(2) - 1), 1)
	expectEqual(Classes.LevelFor(Classes.LevelXP(2)), 2)
	expectEqual(Classes.LevelFor(Classes.LevelXP(3) + 999), 3, "never past 3")
	expectEqual(Classes.RunXP(37, 12), 25 * t.XPPerYear, "only the years not paid yet (Keep Going)")
	expectEqual(Classes.RunXP(10, 20), 0)
	expectEqual(t.LevelMax, 3, "levels 1 to 3, as the profile keeps them")
	local data = ProfileSchema.Default()
	data.Classes.Medic = { Level = 3, XP = Classes.LevelXP(3) }
	expect(ProfileSchema.Validate(data), "a level 3 class saves")
end)

test("Classes: a level's modifier replaces the passive's, and players carry theirs (Prompt 20)", function()
	expectEqual(Modifiers.ClassValue("Quartermaster", "BuildCost", 1), 0.9, "the passive's -10%")
	expectEqual(Modifiers.ClassValue("Quartermaster", "BuildCost", 3), 0.8, "level 3's -20% replaces it")
	expectEqual(Modifiers.ClassValue("Scout", "BackpackSlots", 1), 0)
	expectEqual(Modifiers.ClassValue("Scout", "BackpackSlots", 2), 5, "the Scout's level 2: +5")
	expectEqual(Modifiers.ClassValue("Exterminator", "FuelUse", 2), 0.7)
	expectEqual(Modifiers.ClassValue("Tinkerer", "DroneGuns", 2), 2)
	expectEqual(Modifiers.ClassValue("Security", "MaxHealth", 1), 30)
	local medbay = 0
	for _, m in Modifiers.ClassModifiers("Medic", 2) do
		if m.Key == "RoomOutput" and m.Room == "Medbay" then
			medbay = m.Value
		end
	end
	expectEqual(medbay, 1.25, "the Medic's level 2 Medbay +25%")
	local holder = Instance.new("Folder")
	holder:SetAttribute("Class", "Scout")
	holder:SetAttribute("ClassLevel", 3)
	expectEqual(Modifiers.PlayerValue(holder, "RadiationGain"), 0.5, "a level 3 Scout's radiation")
	holder:SetAttribute("ClassLevel", 1)
	expectEqual(Modifiers.PlayerValue(holder, "RadiationGain"), 1, "not at level 1")
	expectEqual(Modifiers.PlayerValue(nil, "RadiationGain"), 1, "nobody: neutral")
	holder:Destroy()
end)

test("Classes: what the abilities rest on (Prompt 20)", function()
	-- the Quartermaster's costs round up, the flame gun's tank costs less fuel, the Warden's tie-break
	local costs = Construction.CostsAt("Kitchen", 1, 1, 0.9)
	for id, amount in Config.Get("Rooms", "Kitchen").Costs[1] do
		expectEqual(costs[id], math.max(1, math.ceil(amount * 0.9 - 1e-6)), `{id} at -10%`)
	end
	local magazine, carried = Combat.Reload(0, 200, "Flamethrower", 0.7)
	expectEqual(magazine, 100, "a full tank")
	expectEqual(carried, 130, "for 70 ammo, not 100")
	expectEqual(select(2, Combat.Reload(0, 200, "Flamethrower")), 100, "everyone else: 100")
	local pick = Votes.Winner({ A = 1, B = 1, C = 0 }, { "A", "B", "C" }, Random.new(1), "B")
	expectEqual(pick, "B", "a tie goes to the Warden's pick")
	expectEqual(Votes.Winner({ A = 2, B = 1 }, { "A", "B" }, Random.new(1), "B"), "A", "no tie: the Warden's pick doesn't matter")
	expectEqual(#Votes.Tied({ A = 1, B = 1, C = 0 }, { "A", "B", "C" }), 2)
	-- every class's ability has a handler (Run place only)
	local lib = game:GetService("ServerScriptService"):FindFirstChild("Lib")
	local module = lib and lib:FindFirstChild("ClassAbilities")
	if module and module:IsA("ModuleScript") then
		local Abilities = require(module) :: any
		for _, id in Config.Ids("Classes") do
			expect(Abilities.Has(id), `{id} has an ability handler`)
		end
	end
	-- the tuning names a real loot table and every class level effect's key exists
	expect(Config.Find("LootTables", Classes.Tuning().CrateLoot), "Supply Call's crate loot")
	for _, class in all("Classes") do
		for _, part in { class.Passive, class.Level2, class.Level3 } do
			for _, m in (part and part.Modifiers) or {} do
				expect(Config.Find("Modifiers", m.Key), `{class.Id}: {m.Key} is a modifier`)
			end
		end
	end
end)

-- The lobby (Prompt 21) ---------------------------------------------------------------------

test("ClassShop: the day turns at 00:00 UTC; four classes not owned, new each day (Section 14)", function()
	expectEqual(ClassShop.Day(0), 0)
	expectEqual(ClassShop.Day(86399), 0, "the last second of a day")
	expectEqual(ClassShop.Day(86400), 1, "midnight UTC")
	expectEqual(ClassShop.SecondsToReset(86400 * 5 + 100), 86300)
	local t = Config.Get("Tuning", "ClassShop")
	expectEqual(t.Slots, 4, "4 classes")
	local priced = 0
	for _, class in all("Classes") do
		priced += if class.Price > 0 then 1 else 0
	end
	local owned: { [string]: any } = { Survivor = { Level = 1, XP = 0 }, Medic = { Level = 1, XP = 0 } }
	expectEqual(#ClassShop.Unowned(owned), priced - 1, "everything for sale but the Medic")
	local shop: any = { Day = 0, Slots = {}, RerollsUsed = 3 }
	expect(ClassShop.Refresh(shop, owned, 7, Random.new(1)), "a new day refreshes")
	expectEqual(#shop.Slots, 4)
	expectEqual(shop.Day, 7)
	expectEqual(shop.RerollsUsed, 0, "the day's rerolls start over")
	local order = Config.Ids("Classes")
	for i, id in shop.Slots do
		expect(not owned[id] and Config.Get("Classes", id).Price > 0, `{id}: not owned, for sale`)
		expect(i == 1 or (table.find(order, shop.Slots[i - 1]) :: number) < (table.find(order, id) :: number), "in catalogue order, no repeats")
	end
	expect(table.find(shop.Slots, shop.Trial), "the trial class is one of the slots")
	local before = table.concat(shop.Slots, ",")
	expect(not ClassShop.Refresh(shop, owned, 7, Random.new(2)), "the same day: no change")
	expectEqual(table.concat(shop.Slots, ","), before)
	-- a player who owns nearly everything gets fewer slots
	local most: { [string]: any } = {}
	for _, id in order do
		most[id] = { Level = 1, XP = 0 }
	end
	most.Tinkerer, most.Warden = nil, nil
	local few: any = { Day = 0, Slots = {}, RerollsUsed = 0 }
	ClassShop.Refresh(few, most, 7, Random.new(3))
	expectEqual(few.Slots, { "Warden", "Tinkerer" }, "only what is left")
	ClassShop.Reroll(few, most, 7, Random.new(4))
	expectEqual(few.Slots, { "Warden", "Tinkerer" }, "a reroll with nothing else to show")
end)

test("ClassShop: rerolls, the wishlist within 3 days, buying and the free trial (Section 14)", function()
	local owned: { [string]: any } = { Survivor = { Level = 1, XP = 0 } }
	local shop: any = { Day = 0, Slots = {}, RerollsUsed = 0 }
	ClassShop.Refresh(shop, owned, 10, Random.new(5))
	expectEqual(ClassShop.FreeLeft(shop, false), 1, "one free reroll a day")
	expectEqual(ClassShop.FreeLeft(shop, true), 2, "two with VIP")
	local old = table.clone(shop.Slots)
	ClassShop.Reroll(shop, owned, 10, Random.new(6))
	expectEqual(#shop.Slots, 4)
	for _, id in shop.Slots do
		expect(not table.find(old, id), `{id} is new: a reroll replaces all four while there are others`)
	end
	expectEqual(ClassShop.FreeLeft(shop, false), 0)
	expectEqual(ClassShop.FreeLeft(shop, true), 1)
	-- the wishlist: forced in once it hasn't been seen for WishlistDays shop days
	local days = Config.Get("Tuning", "ClassShop").WishlistDays
	expectEqual(days, 3)
	for seed = 1, 20 do
		local wishing: any = { Day = 10, Slots = { "Engineer", "Medic", "Cook", "Scout" }, RerollsUsed = 0 }
		expect((ClassShop.Wish(wishing, owned, "Tinkerer", 10)), "a wish for a class not owned")
		expect(not ClassShop.WishDue(wishing, owned, 10 + days - 1), "not due before day 3")
		expect(ClassShop.WishDue(wishing, owned, 10 + days), "due on day 3")
		ClassShop.Refresh(wishing, owned, 10 + days, Random.new(seed))
		expect(table.find(wishing.Slots, "Tinkerer"), "the wish is in the shop")
		expectEqual(wishing.WishDay, 10 + days, "seen: the count starts over")
		ClassShop.Reroll(wishing, owned, 10 + days, Random.new(seed + 100))
		expect(table.find(wishing.Slots, "Tinkerer"), "and it stays through that day's rerolls")
	end
	expect(not ClassShop.Wish(shop, owned, "Survivor", 10), "the free class can't be wished for")
	expect(not ClassShop.Wish(shop, { Medic = { Level = 1, XP = 0 } }, "Medic", 10), "nor one already owned")
	expect((ClassShop.Wish(shop, owned, nil, 10)) and shop.Wishlist == nil, "a wish can be cleared")
	-- buying: only today's slots, only with the Glowshards
	local profile: any = ProfileSchema.Default()
	profile.ClassShop = { Day = 10, Slots = { "Engineer", "Warden" }, RerollsUsed = 0, Trial = "Warden" }
	profile.Glowshards = 100
	expect((ClassShop.CanBuy(profile, "Engineer", 10)), "40 Glowshards for a Common class")
	expectEqual(select(2, ClassShop.CanBuy(profile, "Warden", 10)), "200 MORE GLOWSHARDS NEEDED")
	expect(not ClassShop.CanBuy(profile, "Medic", 10), "not in today's shop")
	expect(not ClassShop.CanBuy(profile, "Engineer", 11), "yesterday's shop is closed")
	expect(not ClassShop.CanBuy(profile, "Survivor", 10), "the free class isn't for sale")
	-- the free trial: one run a day with a class from the shop
	expectEqual(ClassShop.Trial(profile.ClassShop, profile.Classes, 10), "Warden")
	profile.Loadout = { Class = "Warden" }
	local class, trial = ClassShop.Loadout(profile, 10)
	expect(class == "Warden" and trial, "the trial class can be brought")
	expectEqual((ClassShop.Loadout(profile, 11)), "Survivor", "not on another day")
	profile.ClassShop.TrialUsed = true
	expectEqual((ClassShop.Loadout(profile, 10)), "Survivor", "nor after the trial run has left")
	expect(ClassShop.Settle(profile, 10) and profile.Loadout.Class == "Survivor", "the loadout settles on a class that can be played")
	expect(not ClassShop.Settle(profile, 10), "and stays there")
	profile.Loadout = { Class = "Warden" }
	profile.Classes.Warden = { Level = 2, XP = 0 }
	class, trial = ClassShop.Loadout(profile, 10)
	expect(class == "Warden" and not trial, "an owned class is no trial")
	profile.Loadout = { Class = "Nobody" }
	expectEqual((ClassShop.Loadout(profile, 10)), "Survivor", "an unknown class falls back")
	expect(ProfileSchema.Validate(ProfileSchema.Default()), "the default profile, with its loadout, validates")
	expectEqual(ProfileSchema.Default().Loadout.Class, "Survivor", "a new profile brings the Survivor")
	local saved = ProfileSchema.Default()
	saved.Loadout = nil
	expectEqual(ProfileSchema.Load(saved).Loadout.Class, "Survivor", "an older save gets a loadout")
end)

test("Lobby: difficulty unlocks, pads and who may board (Sections 5 and 21)", function()
	expect(Lobby.Unlocked(nil, "Normal"), "Normal from the start")
	expect(not Lobby.Unlocked({ Wins = 0 }, "Hard"), "Hard is locked at first")
	expect(Lobby.Unlocked({ Wins = 1 }, "Hard"), "Hard after a victory")
	expect(not Lobby.Unlocked({ Wins = 5 }, "Nightmare"), "Nightmare needs a Hard win")
	expect(Lobby.Unlocked({ Wins = 5, HardWins = 1 }, "Nightmare"), "Nightmare after a Hard win")
	expectEqual(Lobby.Difficulties({ Wins = 1 }), { "Normal", "Hard" })
	expectEqual(Lobby.NextDifficulty("Normal", { { Wins = 1, HardWins = 1 } }), "Hard")
	expectEqual(Lobby.NextDifficulty("Nightmare", { { Wins = 1, HardWins = 1 } }), "Normal", "wraps round")
	expectEqual(Lobby.NextDifficulty("Normal", { { Wins = 1 }, { Wins = 0 } }), "Normal", "only what every rider has unlocked")
	local t = Config.Get("Tuning", "Lobby")
	expectEqual(t.PadCountdownSeconds, 20, "a 20 s countdown")
	expectEqual(t.PartyMax, 6, "up to 6")
	expectEqual(t.PartyMax, Constants.MAX_PLAYERS.Run, "a full pad is a full Run server")
	expectEqual(Lobby.Capacity("Public"), 6)
	expectEqual(Lobby.Capacity("Solo"), 1)
	expectEqual(Lobby.CountdownSeconds("Public"), 20)
	expect(Lobby.CountdownSeconds("Solo") <= 5, "a solo pad starts at once")
	local kinds: { [string]: number } = {}
	for _, pad in all("Pads") do
		kinds[pad.Kind] = (kinds[pad.Kind] or 0) + 1
		expect((pad.Kind == "Public") == (pad.Difficulty ~= nil), `{pad.Id}: a public pad's difficulty is fixed, the others are picked`)
	end
	expect(kinds.Public >= 1 and kinds.Private >= 1 and kinds.Solo == 1, "public pads, private pads and a solo pad")
	local pad: Lobby.Pad = { Id = "PrivateA", Kind = "Private", Difficulty = "Normal", Riders = {}, Invited = {}, Phase = "Idle" }
	expect((Lobby.MayBoard(pad, 1, nil)), "anyone may take an empty private pad")
	pad.Riders = { 1 }
	expect(not Lobby.MayBoard(pad, 2, nil), "then only its leader's guests")
	pad.Invited = { [2] = true }
	expect((Lobby.MayBoard(pad, 2, nil)), "an invited player")
	pad.Difficulty = "Hard"
	expectEqual(select(2, Lobby.MayBoard(pad, 2, { Wins = 0 })), "HARD UNLOCKS AFTER A CENTURY VICTORY")
	expect((Lobby.MayBoard(pad, 1, { Wins = 0 })), "a rider already aboard stays")
	local public: Lobby.Pad = { Id = "PublicNormal", Kind = "Public", Difficulty = "Normal", Riders = { 1, 2, 3, 4, 5, 6 }, Phase = "Counting" }
	expectEqual(select(2, Lobby.MayBoard(public, 7, nil)), "THIS PAD IS FULL")
	public.Riders = { 1 }
	expect((Lobby.MayBoard(public, 7, nil)), "room on a public pad")
	public.Phase = "Launching"
	expectEqual(select(2, Lobby.MayBoard(public, 7, nil)), "THIS PAD IS LEAVING")
	expectEqual(Lobby.Title(public), "PUBLIC · NORMAL")
	-- the paid reroll: the bible's price, and its developer product
	expectEqual(Config.Get("Tuning", "ClassShop").RerollRobux, 99, "99 Robux per reroll")
	expectEqual(Config.Get("Tuning", "ClassShop").RerollProductId, 3730189637, "the Class Shop Reroll product")
end)

test("Cutscene: the intro's shots cover its 30 seconds, key by key (Section 4, Prompt 22)", function()
	local path = Config.Get("CutscenePaths", "Intro")
	expectEqual(path.Seconds, Config.Get("Tuning", "Clock").IntroSeconds, "as long as the Intro phase")
	expect(#path.Shots >= 6, "Section 4's six shots (some are two set-ups)")
	local at = 0
	local spaces: { [string]: boolean } = {}
	for _, shot in path.Shots do
		expectEqual(shot.From, at, `{shot.Name} starts where the last one ended`)
		expect(shot.To > shot.From, `{shot.Name} lasts`)
		-- a whole number of keys from the shot's first instant to its last
		expect(shot.Rate >= 15 and shot.Rate < 17, `{shot.Name}: about 15 keys a second`)
		expect(math.abs((shot.To - shot.From) * shot.Rate - (#shot.Keys - 1)) < 0.001, `{shot.Name}: its keys fill it exactly ({#shot.Keys} at {shot.Rate} a second)`)
		for i, key in shot.Keys do
			expectEqual(#key, 8, `{shot.Name} key {i}: position, rotation, field of view`)
			local length = math.sqrt(key[4] ^ 2 + key[5] ^ 2 + key[6] ^ 2 + key[7] ^ 2)
			expect(math.abs(length - 1) < 0.01, `{shot.Name} key {i}: a unit rotation`)
			expect(key[8] > 1 and key[8] < 100, `{shot.Name} key {i}: a field of view`)
		end
		spaces[shot.Space] = true
		at = shot.To
	end
	expectEqual(at, path.Seconds, "the last shot ends with the cutscene")
	expect(spaces.Set and spaces.Bunker, "it is shot on the set and in front of the bunker")
	local last = path.Shots[#path.Shots]
	expect(last.Handover and last.Space == "Bunker", "the last shot hands over to the player at the bunker")
	local shot, index = Cutscene.ShotAt(path, 0)
	expectEqual(index, 1, "the first shot at 0")
	expectEqual((select(2, Cutscene.ShotAt(path, path.Seconds + 5))), #path.Shots, "the last shot after the end")
	expectEqual(Cutscene.ShotAt(path, shot.To).Name, path.Shots[2].Name, "a shot's last instant belongs to the next: a cut")
end)

test("Cutscene: the camera passes through its keys, smoothly, and stays in reach of what it shows", function()
	local path = Config.Get("CutscenePaths", "Intro")
	for _, shot in path.Shots do
		for _, i in { 1, math.ceil(#shot.Keys / 2), #shot.Keys } do
			local key = shot.Keys[i]
			local cframe, fieldOfView = Cutscene.ShotCamera(shot, shot.From + (i - 1) / shot.Rate)
			expect((cframe.Position - Vector3.new(key[1], key[2], key[3])).Magnitude < 0.01, `{shot.Name}: on key {i}`)
			expect(math.abs(fieldOfView - key[8]) < 0.01, `{shot.Name}: key {i}'s field of view`)
		end
		-- between two keys the camera is between them, and never jumps within a shot
		local before = Cutscene.ShotCamera(shot, shot.From)
		local step = 1 / 60
		local t = shot.From + step
		local fastest = 0
		while t < shot.To do
			local now = Cutscene.ShotCamera(shot, t)
			fastest = math.max(fastest, (now.Position - before.Position).Magnitude / step)
			before = now
			t += step
		end
		-- the hand-over shot drops from the Command View's distance to the player in a second and a half
		expect(fastest < (if shot.Handover then 650 else 400), `{shot.Name}: no jump inside a shot (fastest {math.round(fastest)} studs a second)`)
	end
	-- the lowest graphics level draws about 500 studs: the set's cameras stay that close to the
	-- street, the hill and the blast
	local blast = path.Anchors.Blast
	for _, shot in path.Shots do
		if shot.Space == "Set" then
			for _, key in shot.Keys do
				local far = (Vector3.new(key[1], key[2], key[3]) - Vector3.new(blast[1], blast[2], blast[3])).Magnitude
				expect(far < 520, `{shot.Name}: within reach of the blast ({math.round(far)} studs)`)
			end
		else
			for _, key in shot.Keys do
				expect(key[3] <= Config.Get("Tuning", "CommandView").MaxDistance + 1, `{shot.Name}: no farther from the bunker than the Command View`)
			end
		end
	end
end)

test("Cutscene: the party and the founders run in their files and are inside before the door shuts", function()
	local path = Config.Get("CutscenePaths", "Intro")
	expectEqual(#path.Runners, 12, "six players and six founders at most")
	expectEqual(Config.Get("Tuning", "StartingBunker").Residents, 6, "six founders (Section 4)")
	local length = Cutscene.PathLength(path.RunPath)
	expect(length > 150, "a real run")
	local first, direction = Cutscene.PathAt(path.RunPath, 0)
	expectEqual(first, Vector3.new(path.RunPath[1][1], path.RunPath[1][2], path.RunPath[1][3]), "it starts at the path's first point")
	expect(math.abs(direction.Magnitude - 1) < 0.001, "a unit heading")
	local last = Cutscene.PathAt(path.RunPath, length + 50)
	expect((last - Vector3.new(path.RunPath[#path.RunPath][1], path.RunPath[#path.RunPath][2], path.RunPath[#path.RunPath][3])).Magnitude < 0.01, "and stops at its last")
	local start = Cutscene.Beat(path, "RunStart")
	for index, runner in path.Runners do
		local _, _, run, inside = Cutscene.Runner(path, index, start + runner.Delay - 0.01)
		expect(run == 0 and not inside, `runner {index} waits for its turn`)
		local _, _, _, home = Cutscene.Runner(path, index, Cutscene.Beat(path, "DoorFrom"))
		expect(home, `runner {index} is inside before the door starts to shut`)
		expect(math.abs(runner.Side) >= 2, `runner {index} keeps clear of the path's handrail`)
	end
	-- nobody runs through anybody: once the pack has closed up, two runners are never on the same spot
	for _, t in { 5, 6, 7, 8 } do
		for a = 1, #path.Runners do
			for b = a + 1, #path.Runners do
				local pa, _, _, ina = Cutscene.Runner(path, a, t)
				local pb, _, _, inb = Cutscene.Runner(path, b, t)
				if not ina and not inb then
					expect((pa - pb).Magnitude > 1.8, `runners {a} and {b} at {t} s`)
				end
			end
		end
	end
	local lead = Cutscene.Runner(path, 1, 6)
	local behind = Cutscene.Runner(path, #path.Runners, 6)
	expect(lead.X < behind.X, "the first runner leads (the set's east is -X)")
end)

test("Cutscene: skipping, the clock and the blast's arithmetic (Section 4)", function()
	local path = Config.Get("CutscenePaths", "Intro")
	local skipAfter = Config.Get("Tuning", "Clock").IntroSkipAfterSeconds
	expectEqual(skipAfter, 2, "skip after 2 seconds")
	expect(not Cutscene.CanSkip(true, 20, skipAfter), "an account's first run plays in full")
	expect(not Cutscene.CanSkip(false, 1.9, skipAfter), "not before 2 seconds")
	expect(Cutscene.CanSkip(false, 2, skipAfter), "then anyone who has seen it")
	expectEqual(Cutscene.Elapsed(30, 30), 0)
	expectEqual(Cutscene.Elapsed(30, 12.5), 17.5)
	expectEqual(Cutscene.Elapsed(30, -1), 30, "never past the end")
	expectEqual(Cutscene.Smooth(0), 0)
	expectEqual(Cutscene.Smooth(1), 1)
	expectError(function()
		Cutscene.Beat(path, "NoSuchBeat")
	end, "no beat")
	-- Section 4's order: the bomb is seen, the door shuts, then the flash
	local b = path.Beats
	expect(b.RunStart < 5 and b.BombFrom >= 10 and b.BombFrom < 15, "the bomb in shot 3")
	expect(b.DoorFrom > b.BombFrom and b.DoorTo < b.Flash, "the door shuts before the flash")
	expectEqual(b.BombTo, b.Flash, "the flash is the bomb landing")
	expectEqual(b.Flash, 15, "white at 15 seconds")
	expect(b.CloudFrom > b.Flash and b.WaveFrom > b.Flash and b.WaveTo < 21, "the shockwave and the cloud in shot 4")
	expect(b.DiveFrom >= 21 and b.PlungeTo <= 27 and b.EyesFrom > b.PlungeFrom and b.EyesTo < 27, "the plunge and the eyes in shot 5")
	expectEqual(b.Title, 27, "the title at 27 seconds")
	expectEqual(b.ZoomTo, path.Seconds, "the zoom to the player ends with the cutscene")
	expectEqual(Cutscene.DoorShut(path, b.DoorFrom), 0)
	expectEqual(Cutscene.DoorShut(path, b.DoorTo), 1)
	expect(Cutscene.DoorShut(path, (b.DoorFrom + b.DoorTo) / 2) > 0.4, "half shut half way")
	expectEqual((Cutscene.Bomb(path, b.BombFrom - 0.1)), nil, "no bomb before its flight")
	expectEqual((Cutscene.Bomb(path, b.BombTo)), nil, "nor after it lands")
	local from = Cutscene.Bomb(path, b.BombFrom) :: Vector3
	expect((from - Vector3.new(path.Anchors.BombFrom[1], path.Anchors.BombFrom[2], path.Anchors.BombFrom[3])).Magnitude < 0.01, "it starts at BombFrom")
	expectEqual(Cutscene.WaveRadius(path, b.WaveFrom - 0.1), nil, "no ring before the wave")
	expectEqual(Cutscene.WaveRadius(path, b.WaveFrom), 0)
	expect(math.abs((Cutscene.WaveRadius(path, b.WaveTo) :: number) - path.WaveReach) < 0.01, "the ring's reach at WaveTo")
	expectEqual(Cutscene.WaveArrival(path, 0), b.WaveFrom)
	expect(math.abs(Cutscene.WaveArrival(path, path.WaveReach) - b.WaveTo) < 0.001, "the ring's edge arrives at WaveTo")
	local low, high = Cutscene.CloudAt(path, b.CloudFrom), Cutscene.CloudAt(path, b.CloudTo)
	expect(low.Top < high.Top and low.CapRadius < high.CapRadius, "the cloud climbs and spreads")
	expectEqual(high.Top, path.Cloud.Top)
	expectEqual(Cutscene.EyesOpen(path, b.EyesFrom), 0)
	expectEqual(Cutscene.EyesOpen(path, b.EyesTo), 1)
end)

test("Cutscene: the set, the words and the looks (Config.CutscenePaths and Config.Cutscenes)", function()
	local words = Config.Get("Cutscenes", "Intro")
	local path = Config.Get("CutscenePaths", words.Path)
	-- the set: every piece has somewhere to come from; the street's blocks and the hill's door are there
	local names: { [string]: number } = {}
	for _, spot in path.Set do
		names[spot.Name] = (names[spot.Name] or 0) + 1
		expect(string.find(spot.Asset, "^" .. spot.Category .. "_") ~= nil, `{spot.Asset} is a {spot.Category} asset`)
	end
	expectEqual(names.Door, 1, "one blast door")
	expectEqual(names.MineHill, 1, "one Mine Hill")
	expect((names.CarSedan or 0) + (names.CarPickup or 0) >= 12, "cars on Main Street")
	expect(#path.Ground >= 20, "roads, pavements and grass")
	for _, name in { "Door", "StairFoot", "StairHead", "Blast", "BombFrom", "BombTo", "StrataFoot", "Source" } do
		expect(path.Anchors[name] ~= nil, `the {name} anchor`)
	end
	-- Section 4: "a radio bulletin scrolls across the screen" in shot 1; the title card and its line
	expect(words.Bulletin.From < 5 and words.Bulletin.To <= path.Beats.DoorFrom, "the bulletin runs through the first shots")
	expect(string.find(words.Bulletin.Text, "THIS IS NOT A TEST", 1, true) ~= nil, "the bulletin")
	expectEqual(words.Title, "100 YEARS BELOW")
	local line = {}
	local at = words.TitleFrom
	for _, part in words.Tagline do
		expect(part.At >= at, "the line's words in order")
		at = part.At
		table.insert(line, part.Text)
	end
	expectEqual(table.concat(line, " "), "Survive. Dig. Don't wake it.")
	expectEqual(words.TitleFrom, path.Beats.Title, "the card lands on the Title beat")
	expect(words.TitleTo < path.Seconds, "and is gone before the player has the camera")
	local last = -1
	for _, key in words.LookKeys do
		expect(words.Looks[key.Look] ~= nil, `the look {key.Look}`)
		expect(key.At >= last, "look keys in order")
		last = key.At
	end
	expect(last < path.Beats.DiveTo, "from the dive on the light is the run's own")
	local t = Config.Get("Tuning", "Cutscene")
	expect(t.SetOrigin.Y >= 1000, "the set stands high above the run's world")
	expect(t.BarFraction > 0.05 and t.BarFraction < 0.2, "letterbox bars")
end)

local DataTests = {}

function DataTests.Run(filter: string?): Report
	local began = os.clock()
	local report: Report = { Passed = 0, Failed = {}, Skipped = 0, Ms = 0 }
	for _, item in tests do
		if filter and not string.find(string.lower(item.Name), string.lower(filter), 1, true) then
			report.Skipped += 1
			continue
		end
		local done, ok, message = false, false, nil :: string?
		local thread = task.spawn(function()
			local success, err = xpcall(item.Run, debug.traceback)
			ok, message, done = success, if success then nil else tostring(err), true
		end)
		local waited = 0
		while not done and waited < TIMEOUT_SECONDS do
			waited += task.wait()
		end
		if not done then
			pcall(task.cancel, thread)
			table.insert(report.Failed, { Name = item.Name, Error = `timed out after {TIMEOUT_SECONDS} s` })
		elseif ok then
			report.Passed += 1
		else
			table.insert(report.Failed, { Name = item.Name, Error = message or "?" })
		end
	end
	report.Ms = (os.clock() - began) * 1000
	return report
end

function DataTests.Format(report: Report): string
	local filtered = if report.Skipped > 0 then `, {report.Skipped} filtered out` else ""
	local lines = {
		`DataTests: {report.Passed} passed, {#report.Failed} failed{filtered} ({string.format("%.0f", report.Ms)} ms)`,
	}
	for _, failure in report.Failed do
		local firstLine = string.split(failure.Error, "\n")[1]
		table.insert(lines, `  FAIL {failure.Name}: {firstLine}`)
	end
	return table.concat(lines, "\n")
end

function DataTests.Count(): number
	return #tests
end

return DataTests
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000005F"><Properties><string name="Name">StructureCheck</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	StructureCheck: is the place built the way Documentation.ARCHITECTURE says?

	Checks the code skeleton, every installed file in BuildInfo, the service dependency
	graph, stray scripts and remotes, Config data, place identity and leftovers
	(ServerStorage.NS_Pipeline, an outside plugin's working folder: a warning, an error only
	if scripts appear in it).

	Run({ Runtime = true }) inside a running server (DevService `structure`) also checks
	the remotes and the boot result. Run({ Sources = true }) from a Studio plugin or the
	command bar also compares every script's Source with the hash BuildInfo recorded, to
	catch edits made in Studio that the repo doesn't have.
]]

