			"YearClock.EraName",
			"CycleDial.Pointer",
			"Phase.Text",
			"TimeLeft.Text",
			"Ready.Content.Lamp",
			"Ready.Content.Label",
			"Ready.Content.Count",
			"Ready.Key",
			"Ready.Key.Text",
