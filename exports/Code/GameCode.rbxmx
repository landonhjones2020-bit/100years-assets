	"SoundService",
}

local function find(path: string): Instance?
	local node: Instance? = game
	for segment in string.gmatch(path, "[^%.]+") do
		if node == game then
			local ok, service = pcall(game.GetService, game, segment)
			node = if ok then service else nil
		else
			node = (node :: Instance):FindFirstChild(segment)
		end
		if not node then
			return nil
		end
	end
	return node
end

local function pathOf(instance: Instance): string
	return instance:GetFullName()
end

-- An art-pipeline sample (A0_Showroom, A0_HUD...): allowed until gameplay replaces it.
local function isSample(instance: Instance): boolean
	local node: Instance? = instance
	while node and node ~= game do
		if string.sub(node.Name, 1, 3) == "A0_" then
			return true
		end
		node = node.Parent
	end
	return false
end

local function fnv1a(text: string): string
	local hash = 2166136261
	for index = 1, #text do
		hash = bit32.bxor(hash, string.byte(text, index))
		hash = (bit32.lshift(hash, 24) + hash * 403) % 4294967296
	end
	return string.format("%08x", hash)
end

local StructureCheck = {}

StructureCheck.Hash = fnv1a

function StructureCheck.Run(options: Options?): Result
	local runtime = options ~= nil and options.Runtime == true
	local sources = options ~= nil and options.Sources == true
	local result: Result = { Errors = {}, Warnings = {}, Passed = 0, Notes = {} }
	local function pass()
		result.Passed += 1
	end
	local function fail(message: string)
		table.insert(result.Errors, message)
	end
	local function warnOf(message: string)
		table.insert(result.Warnings, message)
	end

	-- 1. The skeleton (shared, then this place's own)
	local placeKind: string? = nil
	do
		local constantsModule = find("ReplicatedStorage.Shared.Constants")
		if constantsModule and constantsModule:IsA("ModuleScript") then
			local ok, kind = pcall((require(constantsModule) :: any).PlaceKind)
			placeKind = if ok then kind else nil
		end
	end
	local skeleton = table.clone(SKELETON)
	for _, item in (if placeKind then PLACE_SKELETON[placeKind] else nil) or {} do
		table.insert(skeleton, item)
	end
	for _, item in skeleton do
		local path, className = item[1], item[2]
		local found = find(path)
		if not found then
			fail(`missing {path} ({className})`)
		elseif found.ClassName ~= className then
			fail(`{path} is a {found.ClassName}, should be a {className}`)
		else
			pass()
		end
	end
	for kind, items in PLACE_SKELETON do
		if kind ~= placeKind then
			for _, item in items do
				if find(item[1]) then
					fail(`{item[1]} belongs to the {kind} place only`)
				end
			end
		end
	end

	-- 2. Every installed file, and (from a plugin) whether it was edited after install
	local buildInfo: any = nil
	local buildModule = find("ReplicatedStorage.Shared.BuildInfo")
	if buildModule and buildModule:IsA("ModuleScript") then
		local ok, info = pcall(require, buildModule)
		if ok and type(info) == "table" and type(info.Files) == "table" then
			buildInfo = info
			pass()
		else
			fail("BuildInfo doesn't load or has no Files")
		end
	end
	if buildInfo then
		table.insert(result.Notes, `build {buildInfo.Label}`)
		for path, file in buildInfo.Files do
			local found = find(path)
			if not found then
				fail(`installed file missing: {path} ({file.Class})`)
			elseif found.ClassName ~= file.Class then
				fail(`{path} is a {found.ClassName}, installed as a {file.Class}`)
			else
				pass()
				if sources and found:IsA("LuaSourceContainer") then
					local ok, source = pcall(function()
						return (found :: any).Source
					end)
					if ok and fnv1a(source) ~= file.Hash then
						warnOf(`{path} was edited in Studio after install (the repo copy differs)`)
					end
				end
			end
		end
	end

	-- 3. Services: names, shape and a dependency order with no cycle
	local servicesFolder = find("ServerScriptService.Services")
	if servicesFolder then
		local Loader = require(ReplicatedStorage.Shared.Utilities.Loader) :: any
		local ok, modules = pcall(Loader.Collect, servicesFolder, "Service")
		if not ok then
			fail(tostring(modules))
		else
			local order, problem = Loader.Order(modules)
			if order then
				pass()
				table.insert(result.Notes, `services: {table.concat(order, ", ")}`)
			else
				fail(`services: {problem}`)
			end
		end
		for _, child in servicesFolder:GetChildren() do
			if not child:IsA("ModuleScript") then
				warnOf(`{pathOf(child)}: only ModuleScripts belong in Services`)
			end
		end
	end
	local controllers = find("StarterPlayer.StarterPlayerScripts.Controllers")
	if controllers then
		for _, child in controllers:GetChildren() do
			if not child:IsA("ModuleScript") then
				warnOf(`{pathOf(child)}: only ModuleScripts belong in Controllers`)
			else
				pass()
			end
		end
	end

	-- 4. Stray scripts: only the two bootstraps run code
	local samples = 0
	for _, rootName in SCRIPT_ROOTS do
		local ok, root = pcall(game.GetService, game, rootName)
		if not ok then
			continue
		end
		for _, descendant in (root :: Instance):GetDescendants() do
			if not descendant:IsA("BaseScript") then
				continue
			end
			local path = pathOf(descendant)
			if ENTRY_SCRIPTS[path] == descendant.ClassName then
				pass()
			elseif isSample(descendant) then
				samples += 1
			elseif isRobloxDefault(descendant) or inCharacter(descendant) then
				continue
			else
				warnOf(`stray {descendant.ClassName} {path}: only Bootstrap and ClientBootstrap are scripts; make it a module`)
			end
		end
	end
	if samples > 0 then
		table.insert(result.Notes, `{samples} script(s) in A0_ art samples (allowed until gameplay replaces them)`)
	end

	-- 5. Remotes: only the ones Shared.Remotes defines
	local remotesModule = find("ReplicatedStorage.Shared.Remotes")
	for _, rootName in { "ReplicatedStorage", "Workspace", "ReplicatedFirst" } do
		local root = game:GetService(rootName :: any) :: Instance
		for _, descendant in root:GetDescendants() do
			if
				(descendant:IsA("RemoteEvent") or descendant:IsA("RemoteFunction") or descendant:IsA("UnreliableRemoteEvent"))
				and descendant.Parent ~= remotesModule
			then
				warnOf(`stray remote {pathOf(descendant)}: add it to Shared.Remotes instead`)
			end
		end
	end
	if runtime and remotesModule then
		local Remotes = require(remotesModule :: ModuleScript) :: any
		for name, definition in Remotes.Definitions do
			local found = remotesModule:FindFirstChild(name)
			local className = if definition.Unreliable then "UnreliableRemoteEvent" else "RemoteEvent"
			if not Remotes.InPlace(name) then
				if found then
					fail(`remote {name} exists, but it belongs to the {definition.Place} place only`)
				else
					pass()
				end
			elseif not found then
				fail(`remote {name} wasn't created`)
			elseif found.ClassName ~= className then
				fail(`remote {name} is a {found.ClassName}, should be a {className}`)
			else
				pass()
			end
		end
		for _, child in remotesModule:GetChildren() do
			if Remotes.Definitions[child.Name] == nil then
				warnOf(`unknown remote {child.Name} under Shared.Remotes`)
			end
		end
	end

	-- 6. Config data
	local configModule = find("ReplicatedStorage.Shared.Config")
	if configModule and configModule:IsA("ModuleScript") then
		local ok, Config = pcall(require, configModule)
		if not ok then
			fail(`Config doesn't load: {Config}`)
		else
			local errors = (Config :: any).Errors()
			if #errors == 0 then
				pass()
				table.insert(result.Notes, `config types: {#(Config :: any).Types()}`)
			end
			for _, problem in errors do
				fail(`config: {problem}`)
			end
		end
	end

	-- 7. Place identity
	local constantsModule = find("ReplicatedStorage.Shared.Constants")
	if constantsModule and constantsModule:IsA("ModuleScript") then
		local Constants = require(constantsModule) :: any
		local ok, kind = pcall(Constants.PlaceKind)
		if not ok then
			fail(tostring(kind))
		else
			pass()
			table.insert(result.Notes, `place {kind} ({game.PlaceId})`)
			local attribute = workspace:GetAttribute("PlaceKind")
			if attribute ~= nil and attribute ~= kind then
				fail(`Workspace PlaceKind says {attribute} but this is {kind}`)
			end
			if buildInfo and buildInfo.Place ~= kind then
				fail(`installed build is for {buildInfo.Place}, but this place is {kind}`)
			end
		end
	end

	-- 8. Leftovers. ServerStorage.NS_Pipeline is the working folder of an outside Studio plugin
	-- (the Night Shift importer) that Landon can't remove (2026-11-08: not in Manage Plugins, its
	-- file deleted). It holds an empty Jobs folder and MeshCache, so it is only a warning; scripts
	-- inside it would be an error.
	local leftover = ServerStorage:FindFirstChild("NS_Pipeline")
	if leftover then
		local scripts = 0
		for _, item in leftover:GetDescendants() do
			if item:IsA("LuaSourceContainer") then
				scripts += 1
			end
		end
		if scripts > 0 then
			fail(`ServerStorage.NS_Pipeline (an outside plugin's folder) holds {scripts} script(s): delete it`)
		else
			warnOf("ServerStorage.NS_Pipeline is back (an outside Studio plugin's empty working folder; harmless)")
		end
	else
		pass()
	end

	-- 8b. Place settings the camera relies on (Prompt 5): Roblox's shift lock off (the camera
	-- locks the mouse itself) and Invisicam for Roblox's camera, the fallback
	local StarterPlayer = game:GetService("StarterPlayer")
	if StarterPlayer.EnableMouseLockOption then
		fail("StarterPlayer.EnableMouseLockOption must be off: the over-the-shoulder camera locks the mouse itself")
	else
		pass()
	end
	if StarterPlayer.DevCameraOcclusionMode ~= Enum.DevCameraOcclusionMode.Invisicam then
		fail("StarterPlayer.DevCameraOcclusionMode must be Invisicam (the camera's fallback, bible Section 9)")
	else
		pass()
	end

	-- 8c. The UI layout (bible Section 18, Prompt 6): the Frame (both places) and the HUD (Run)
	-- exist with every part the code uses (Shared.UIContract), ScreenGui settings per rule 7,
	-- Scale-only sizes, text that scales and never drops below 12, and no scripts inside
	local contractModule = find("ReplicatedStorage.Shared.UIContract")
	if contractModule and contractModule:IsA("ModuleScript") then
		local UIContract = require(contractModule) :: any
		local StarterGui = game:GetService("StarterGui")
		for screenName, screen in UIContract.Screens do
			local wanted = placeKind ~= nil and table.find(screen.Places, placeKind) ~= nil
			local gui = StarterGui:FindFirstChild(screenName)
			if not wanted then
				if gui then
					fail(`StarterGui.{screenName} belongs to the {table.concat(screen.Places, " and ")} place only`)
				end
				continue
			end
			if not gui or not gui:IsA("ScreenGui") then
				fail(`missing StarterGui.{screenName} (ScreenGui): build it with tools/ui_luau.py studio/ui/{screenName}.lua`)
				continue
			end
			pass()
			if
				gui.ResetOnSpawn
				or gui.ZIndexBehavior ~= Enum.ZIndexBehavior.Sibling
				or gui.ScreenInsets ~= Enum.ScreenInsets.CoreUISafeInsets
			then
				fail(`StarterGui.{screenName} needs ScreenInsets CoreUISafeInsets, ResetOnSpawn off and ZIndexBehavior Sibling (bible Section 18)`)
			else
				pass()
			end
			if gui.DisplayOrder ~= screen.DisplayOrder then
				warnOf(`StarterGui.{screenName} DisplayOrder is {gui.DisplayOrder}, expected {screen.DisplayOrder}`)
			end
			local missing = {}
			for _, path in screen.Paths do
				if UIContract.Find(gui, path) then
					pass()
				else
					table.insert(missing, path)
				end
			end
			if #missing > 0 then
				fail(`StarterGui.{screenName} lacks {#missing} part(s) the code uses: {table.concat(missing, ", ", 1, math.min(#missing, 6))}`)
			end
			local offsets, unreadable, scripts = 0, 0, 0
			for _, item in gui:GetDescendants() do
				if item:IsA("GuiObject") then
					local size, position = item.Size, item.Position
					if size.X.Offset ~= 0 or size.Y.Offset ~= 0 or position.X.Offset ~= 0 or position.Y.Offset ~= 0 then
						offsets += 1
					end
				end
				if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
					local limit = item:FindFirstChildOfClass("UITextSizeConstraint")
					if not (item :: any).TextScaled or not limit or limit.MinTextSize < 12 then
						unreadable += 1
					end
				end
				if item:IsA("BaseScript") then
					scripts += 1
				end
			end
			if offsets > 0 then
				fail(`StarterGui.{screenName}: {offsets} element(s) use pixel offsets; all UI is Scale (bible Section 18)`)
			else
				pass()
			end
			if unreadable > 0 then
				fail(`StarterGui.{screenName}: {unreadable} text element(s) without TextScaled and a UITextSizeConstraint of at least 12`)
			else
				pass()
			end
			if scripts > 0 then
				fail(`StarterGui.{screenName} holds {scripts} script(s); the game code drives the UI`)
			else
				pass()
			end
		end
	end

	-- 9. The architecture document
	local doc = find("ServerStorage.Documentation.ARCHITECTURE")
	if doc and doc:IsA("ModuleScript") then
		local ok, text = pcall(require, doc)
		if ok and type(text) == "string" and #text > 200 then
			pass()
		else
			fail("Documentation.ARCHITECTURE must return the document text")
		end
	end

	-- 10. The boot result
	if runtime then
		if ReplicatedStorage:GetAttribute("ServerReady") == true then
			pass()
		else
			fail("ServerReady isn't set: Bootstrap didn't finish")
		end
		local broken = ReplicatedStorage:GetAttribute("ServerBroken")
		if broken then
			fail(`services that failed to start: {broken}`)
		end
		local DevTools = ServerScriptService:FindFirstChild("DevTools")
		if DevTools and not DevTools:FindFirstChild("Invoke") and game:GetService("RunService"):IsStudio() then
			warnOf("DevTools.Invoke wasn't created (DevService didn't start?)")
		end
		-- The run's replicated values (Run place): set, and each one allowed
		local runStateModule = find("ReplicatedStorage.Shared.RunState")
		if placeKind == "Run" and runStateModule and runStateModule:IsA("ModuleScript") then
			local RunState = require(runStateModule) :: any
			if RunState.Get("RunPhase") == nil then
				fail("RunState.RunPhase isn't set: RunDirector didn't start")
			else
				pass()
			end
			for name, value in runStateModule:GetAttributes() do
				local ok, why = RunState.Check(name, value)
				if ok then
					pass()
				else
					fail(`RunState: {why}`)
				end
			end
		end
		-- The bunker's world (Run place): BunkerGrid built it
		if placeKind == "Run" then
			local bunker = workspace:FindFirstChild("Bunker")
			if not bunker then
				fail("workspace.Bunker is missing: BunkerGrid didn't build the bunker")
			else
				for _, name in { "Frame", "Rock", "Dug", "Rooms" } do
					if bunker:FindFirstChild(name) then
						pass()
					else
						fail(`workspace.Bunker.{name} is missing`)
					end
				end
				local rooms = bunker:FindFirstChild("Rooms")
				if rooms and #rooms:GetChildren() == 0 then
					fail("workspace.Bunker.Rooms is empty")
				end
				-- Every room carries its gameplay points; the art kit, when the place has it,
				-- built every room; the Medbay has the spawn and the Blast Door its exit.
				local ServerStorage = game:GetService("ServerStorage")
				local assets = ServerStorage:FindFirstChild("Assets")
				local kit = assets and assets:FindFirstChild("Kit")
				local hasArt = kit ~= nil and kit:FindFirstChild("Kit_Floor") ~= nil
				for _, room in if rooms then rooms:GetChildren() else {} do
					local kind = room:GetAttribute("RoomType")
					local sockets = room:FindFirstChild("Sockets")
					if sockets and sockets:IsA("BasePart") then
						pass()
					else
						fail(`room {room.Name} ({kind}) has no Sockets part`)
					end
					if hasArt and room:GetAttribute("Art") ~= true then
						fail(`room {room.Name} ({kind}) was built from the graybox although the art kit is in ServerStorage.Assets`)
					elseif hasArt then
						pass()
					end
					if kind == "Medbay" then
						if room:FindFirstChild("MedbaySpawn") then
							pass()
						else
							fail(`Medbay {room.Name} has no MedbaySpawn`)
						end
					elseif kind == "BlastDoor" then
						if sockets and sockets:FindFirstChild("SurfaceExit") then
							pass()
						else
							fail(`Blast Door {room.Name} has no SurfaceExit socket`)
						end
					end
				end
			end
		end
	end

	return result
end

function StructureCheck.Format(result: Result): string
	local lines = {
		`StructureCheck: {#result.Errors} errors, {#result.Warnings} warnings, {result.Passed} checks passed`,
	}
	for _, message in result.Errors do
		table.insert(lines, `  ERROR {message}`)
	end
	for _, message in result.Warnings do
		table.insert(lines, `  warn  {message}`)
	end
	for _, message in result.Notes do
		table.insert(lines, `  note  {message}`)
	end
	return table.concat(lines, "\n")
end

return StructureCheck
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000000C5"><Properties><string name="Name">Lib</string></Properties><Item class="ModuleScript" referent="RBX000000C2"><Properties><string name="Name">BunkerKit</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BunkerKit: builds the bunker's world from Rules.Bunker data (bible Section 6).

	It builds from the A1 art kit in ServerStorage.Assets (bible Section 19): the Kit_* shell
	pieces, Kit_Rock_<Band> and Kit_Dug_<Band>, Kit_Shaft_L<level>, Kit_BlastDoor_L<level>,
	Kit_Vent and Room_<Type>_L<level>, each copied to its cell with Grid.CellCFrame. A piece
	the place doesn't have falls back to the Prompt 4 graybox (plain parts with the same
	sizes), so the bunker always builds, even in a place without the art.

	workspace.Bunker
	  Frame     rock around the grid: a column each side, a row above floor 1, a row below 10
	  Rock      one model per Rock cell, named by its key ("3,-2"); alternate cells turned
	  Dug       one model per Dug cell, named by its graph node ("D:2,3")
	  Rooms     one model per room, named by its id ("R4")

	* Every unit streams as Persistent, so the Command View always has the whole bunker
	  (bible Section 23).
	* Every room has walls. A side wall gets a doorway when the cell beyond it is open
	  (rooms connect sideways through doorways in shared walls). Cells of one room have no
	  wall between them.
	* Front walls carry the FrontWall tag (every part of a front wall piece, and the front
	  face of a dug cell): solid while playing, hidden in the Command View (Prompt 7).
	* Furniture, the Blast Door set, the stair, vents, lamps and cave props carry the
	  CameraFade tag: the over-the-shoulder camera passes through them and fades them when
	  they hide the character (Prompt 5). Floors, walls, ceilings and rock stop the camera.
	* Stacked Shafts get a hole in the upper one's floor, a hole in the lower one's ceiling
	  and the stair in the lower one.
	* Each room has a Sockets part (invisible) with an Attachment per gameplay point its art
	  carries: WorkSpot1.., Bed1.., Seat1.., Core, Valve1.., FuseBox, Breaker, Tap, Bench,
	  Respawn, Door, SurfaceExit, Vent, Lift, Chute, Top, Bottom, Light1.. Numbered points
	  count up across the room's cells from left to right; an unnumbered point that repeats
	  gets its cell's number (Breaker, Breaker2). BunkerKit.Socket and .Sockets read them.
	* The Medbay holds the players' spawn on its respawn pad (Section 6).
	* Lights: two per room cell at the ceiling strip, a lantern per dug cell, the Reactor's
	  core glow and the Kitchen's pendants. Each carries the RoomLight tag and a Unit
	  attribute (room id or dug node) for the power system (dark rooms, blackouts).
	* Each room gets one vent (a breach point, Section 10) in its first cell, except the
	  Shaft and the Blast Door (the door is the surface breach point).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Bunker = require(Shared.Rules.Bunker)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)

local BunkerKit = {}

BunkerKit.FRONT_WALL_TAG = "FrontWall"
BunkerKit.ROOM_LIGHT_TAG = "RoomLight"
BunkerKit.CAMERA_FADE_TAG = "CameraFade"

local ASSET_TAG = "Asset" -- marks the source models in ServerStorage.Assets; copies drop it
local HALF_TURN = CFrame.Angles(0, math.pi, 0)

-- Graybox (Prompt 4) ---------------------------------------------------------------------

local DOOR_WIDTH, DOOR_HEIGHT = 8, 10 -- the kit's doorway
local CRUST, BEDROCK, EDGE = 6, 6, 6 -- rock around the grid
local SHAFT_HOLE = { FromX = 2, Depth = 8 } -- the opening between stacked Shafts, at the back right

local ROOM_COLORS: { [string]: Color3 } = {
	BlastDoor = Color3.fromRGB(96, 102, 110),
	Shaft = Color3.fromRGB(214, 168, 46),
	ReactorCore = Color3.fromRGB(58, 148, 160),
	Generator = Color3.fromRGB(210, 120, 40),
	Kitchen = Color3.fromRGB(200, 96, 64),
	WaterPurifier = Color3.fromRGB(70, 130, 190),
	Quarters = Color3.fromRGB(140, 120, 180),
	Medbay = Color3.fromRGB(226, 226, 220),
	Storage = Color3.fromRGB(150, 116, 80),
	Workshop = Color3.fromRGB(170, 150, 90),
}
local DEFAULT_ROOM_COLOR = Color3.fromRGB(170, 170, 160)
local WALL_COLOR = Color3.fromRGB(226, 216, 190) -- Steadfast cream
local FRONT_COLOR = Color3.fromRGB(200, 190, 166)
local CEILING_COLOR = Color3.fromRGB(236, 230, 214)
local LAMP_COLOR = Color3.fromRGB(255, 236, 196)
local BAND_COLORS: { [string]: Color3 } = {
	Mines = Color3.fromRGB(118, 94, 72),
	FloodedCaverns = Color3.fromRGB(74, 94, 108),
	CrystalHollows = Color3.fromRGB(100, 82, 128),
	SourceChamber = Color3.fromRGB(116, 52, 52),
}

-- Art lights ---------------------------------------------------------------------------------

type LightSpec = { Range: number, Brightness: number, Color: Color3 }

local CEILING_LIGHT: LightSpec = { Range = 18, Brightness = 1, Color = Color3.fromRGB(255, 228, 188) }
local DUG_LIGHTS: { [string]: LightSpec } = {
	Mines = { Range = 20, Brightness = 0.9, Color = Color3.fromRGB(255, 196, 120) },
	FloodedCaverns = { Range = 22, Brightness = 0.8, Color = Color3.fromRGB(140, 200, 210) },
	CrystalHollows = { Range = 22, Brightness = 1, Color = Color3.fromHex("8FE3E0") },
	SourceChamber = { Range = 22, Brightness = 1, Color = Color3.fromHex("7CFF9B") },
}
-- Rooms whose own Light sockets are real fixtures (the rest light from the ceiling kit).
local ACCENT_LIGHTS: { [string]: LightSpec } = {
	ReactorCore = { Range = 16, Brightness = 2, Color = Color3.fromHex("8FE3E0") },
	Kitchen = { Range = 12, Brightness = 0.8, Color = Color3.fromRGB(255, 214, 160) },
}
local NO_VENT: { [string]: boolean } = { Shaft = true, BlastDoor = true }

type Folders = { Root: Instance, Frame: Model, Rock: Model, Dug: Folder, Rooms: Folder }
type Socket = { Name: string, CFrame: CFrame }
type Holder = { Part: BasePart, Counters: { [string]: number }, Taken: { [string]: boolean } }

-- Parts --------------------------------------------------------------------------------------

-- An anchored block between two corners.
local function block(parent: Instance, name: string, low: Vector3, high: Vector3, color: Color3, material: Enum.Material): Part?
	local size = high - low
	if size.X <= 0.01 or size.Y <= 0.01 or size.Z <= 0.01 then
		return nil
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = CFrame.new((low + high) / 2)
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- A horizontal slab, with an optional rectangular hole (x and z ranges) cut out of it.
local function slab(
	parent: Instance,
	name: string,
	low: Vector3,
	high: Vector3,
	hole: { MinX: number, MaxX: number, MinZ: number, MaxZ: number }?,
	color: Color3,
	material: Enum.Material
)
	if not hole then
		block(parent, name, low, high, color, material)
		return
	end
	block(parent, name, low, Vector3.new(hole.MinX, high.Y, high.Z), color, material)
	block(parent, name, Vector3.new(hole.MaxX, low.Y, low.Z), high, color, material)
	block(parent, name, Vector3.new(hole.MinX, low.Y, low.Z), Vector3.new(hole.MaxX, high.Y, hole.MinZ), color, material)
	block(parent, name, Vector3.new(hole.MinX, low.Y, hole.MaxZ), Vector3.new(hole.MaxX, high.Y, high.Z), color, material)
end

-- The camera passes through this (and fades it when it hides the character).
local function fadeable(item: Instance)
	CollectionService:AddTag(item, BunkerKit.CAMERA_FADE_TAG)
end

local function newModel(name: string, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent
	return model
end

local function addLight(parent: Instance, spec: LightSpec, unit: string)
	local light = Instance.new("PointLight")
	light.Range = spec.Range
	light.Brightness = spec.Brightness
	light.Color = spec.Color
	light.Shadows = false
	light:SetAttribute("Unit", unit)
	CollectionService:AddTag(light, BunkerKit.ROOM_LIGHT_TAG)
	light.Parent = parent
end

local function lamp(parent: Instance, cell: Vector3, bright: boolean, unit: string)
	local t = Grid.Tuning()
	local y = cell.Y + t.CellHeight - 0.6
	local part = block(
		parent,
		"Lamp",
		Vector3.new(cell.X - 2, y - 0.2, cell.Z + 3),
		Vector3.new(cell.X + 2, y, cell.Z + 5),
		LAMP_COLOR,
		if bright then Enum.Material.Neon else Enum.Material.SmoothPlastic
	)
	if part then
		part.CanCollide = false
		part.CastShadow = false
		fadeable(part)
		addLight(part, {
			Range = if bright then 30 else 18,
			Brightness = if bright then 1.4 else 0.6,
			Color = LAMP_COLOR,
		}, unit)
	end
end

local function label(wall: BasePart, text: string)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label"
	gui.Face = Enum.NormalId.Back -- +Z: into the room
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.2
	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Size = UDim2.new(1, 0, 0, 56)
	textLabel.Position = UDim2.new(0, 0, 0, 16)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextScaled = true
	textLabel.TextColor3 = Color3.fromRGB(40, 44, 48)
	textLabel.Text = text
	textLabel.Parent = gui
	gui.Parent = wall
end

-- Art ----------------------------------------------------------------------------------------

local function art(category: string, name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = if assets then assets:FindFirstChild(category) else nil
	local found = if folder then folder:FindFirstChild(name) else nil
	if found and found:IsA("Model") then
		return found
	end
	return nil
end

-- Has this place got the art kit? Without it the bunker is all graybox.
function BunkerKit.HasArt(): boolean
	return art("Kit", "Kit_Floor") ~= nil
end

-- A copy of an art model with its pivot at `at`.
local function place(source: Model, name: string, parent: Instance, at: CFrame, persistent: boolean?): Model
	local copy = source:Clone()
	copy.Name = name
	CollectionService:RemoveTag(copy, ASSET_TAG)
	if persistent then
		copy.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end
	copy:PivotTo(at)
	copy.Parent = parent
	return copy
end

local function piece(name: string, label_: string, parent: Instance, at: CFrame): Model?
	local source = art("Kit", name)
	return if source then place(source, label_, parent, at) else nil
end

-- "WorkSpot12" -> "WorkSpot", 12; "Core" -> "Core", nil.
local function splitName(name: string): (string, number?)
	local base, digits = string.match(name, "^(.-)(%d+)$")
	if base and base ~= "" then
		return base, tonumber(digits)
	end
	return name, nil
end

-- A placed copy's sockets (its Socket_<name> attributes, in the model's own space) in the
-- world, sorted by name and then number.
local function socketsOf(copy: Model): { Socket }
	local list: { Socket } = {}
	local pivot = copy:GetPivot()
	for key, value in copy:GetAttributes() do
		local name = string.match(key, "^Socket_(.+)$")
		if name and typeof(value) == "CFrame" then
			table.insert(list, { Name = name, CFrame = pivot * value })
		end
	end
	table.sort(list, function(a: Socket, b: Socket): boolean
		local baseA, numberA = splitName(a.Name)
		local baseB, numberB = splitName(b.Name)
		if baseA ~= baseB then
			return baseA < baseB
		end
		return (numberA or 0) < (numberB or 0)
	end)
	return list
end

local function attach(part: BasePart, name: string, at: CFrame): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.CFrame = part.CFrame:ToObjectSpace(at)
	attachment.Parent = part
	return attachment
end

local function newHolder(model: Model, at: Vector3): Holder
	local part = Instance.new("Part")
	part.Name = "Sockets"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.CFrame = CFrame.new(at)
	part.Parent = model
	return { Part = part, Counters = {}, Taken = {} }
end

-- Adds a gameplay point to a room, numbered within the room (see the header).
local function addSocket(holder: Holder, name: string, at: CFrame, cellIndex: number): Attachment
	local base, number = splitName(name)
	local final = name
	if number then
		holder.Counters[base] = (holder.Counters[base] or 0) + 1
		final = base .. holder.Counters[base]
	elseif holder.Taken[name] then
		final = name .. cellIndex
	end
	holder.Taken[final] = true
	return attach(holder.Part, final, at)
end

-- Every socket of a placed copy into the room's holder; returns the new attachments.
local function collect(holder: Holder, copy: Model, cellIndex: number): { Attachment }
	local made = {}
	for _, socket in socketsOf(copy) do
		table.insert(made, addSocket(holder, socket.Name, socket.CFrame, cellIndex))
	end
	return made
end

local function tagFront(model: Model, whole: boolean)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and (whole or item:GetAttribute("Role") == "FrontWall") then
			CollectionService:AddTag(item, BunkerKit.FRONT_WALL_TAG)
		end
	end
end

-- The ceiling piece's two lamps, on its light strip.
local function ceilingLights(copy: Model, unit: string)
	local strip = copy:FindFirstChild("CeilingLight")
	if not (strip and strip:IsA("BasePart")) then
		return
	end
	for _, socket in socketsOf(copy) do
		if string.match(socket.Name, "^Light%d*$") then
			addLight(attach(strip, socket.Name, socket.CFrame), CEILING_LIGHT, unit)
		end
	end
end

-- Rooms: shells ------------------------------------------------------------------------------

type Shape = { ShaftBelow: boolean, ShaftAbove: boolean, LeftOpen: boolean, RightOpen: boolean }

-- A side wall on the plane between two cells: solid, or with a centred doorway.
local function sideWall(parent: Instance, name: string, x0: number, x1: number, floorY: number, z: number, doorway: boolean)
	local t = Grid.Tuning()
	local top = floorY + t.CellHeight
	local back, front = z - t.CellDepth / 2, z + t.CellDepth / 2
	if not doorway then
		block(parent, name, Vector3.new(x0, floorY, back), Vector3.new(x1, top, front), WALL_COLOR, Enum.Material.SmoothPlastic)
		return
	end
	local half = DOOR_WIDTH / 2
	block(parent, name, Vector3.new(x0, floorY, back), Vector3.new(x1, top, z - half), WALL_COLOR, Enum.Material.SmoothPlastic)
	block(parent, name, Vector3.new(x0, floorY, z + half), Vector3.new(x1, top, front), WALL_COLOR, Enum.Material.SmoothPlastic)
	block(parent, name, Vector3.new(x0, floorY + DOOR_HEIGHT, z - half), Vector3.new(x1, top, z + half), WALL_COLOR, Enum.Material.SmoothPlastic)
end

-- Inside a room of several cells the ceiling, back wall and front wall pieces leave the
-- 2-stud strip over the wall line between two cells bare: a steel beam closes the ceiling
-- and steel posts close the walls (the front post belongs to that front wall piece, so it
-- fades and hides with it).
local SEAM_COLOR = Color3.fromHex("8D969D") -- palette: steel
local SEAM_WIDTH = 2.4 -- over the 2-stud strip, a little each side
local SEAM_DEPTH = 0.6

local function seamPart(parent: Instance, name: string, low: Vector3, high: Vector3): Part?
	local part = block(parent, name, low, high, SEAM_COLOR, Enum.Material.SmoothPlastic)
	if part then
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end
	return part
end

local function seams(model: Model, floor: number, column: number, front: Model?)
	local t = Grid.Tuning()
	local cell = Grid.CellPosition(floor, column)
	local x = cell.X - t.CellWidth / 2 - t.WallThickness -- the line between this cell and the one on its left
	local y0, top = cell.Y, cell.Y + t.CellHeight
	local back, frontZ = cell.Z - t.CellDepth / 2, cell.Z + t.CellDepth / 2
	local half = SEAM_WIDTH / 2
	seamPart(model, "CeilingSeam", Vector3.new(x - t.WallThickness, top - 1.5, back), Vector3.new(x + t.WallThickness, top, frontZ))
	seamPart(model, "BackSeam", Vector3.new(x - half, y0, back), Vector3.new(x + half, top, back + SEAM_DEPTH))
	local post = seamPart(front or model, "FrontSeam", Vector3.new(x - half, y0, frontZ - SEAM_DEPTH), Vector3.new(x + half, top, frontZ))
	if post then
		CollectionService:AddTag(post, BunkerKit.FRONT_WALL_TAG)
	end
end

-- The art shell: per cell a floor, a ceiling with its lamps, a back and a front wall, and
-- side walls at the room's two ends (the left one is the right-hand piece turned around).
local function shellArt(model: Model, room: Bunker.Room, shape: Shape)
	for offset = 0, room.Span - 1 do
		local column = room.Column + offset
		local key = Grid.Key(room.Floor, column)
		local at = Grid.CellCFrame(room.Floor, column)
		local floor = piece(if shape.ShaftBelow then "Kit_FloorHole" else "Kit_Floor", `Floor {key}`, model, at)
		local rail = if floor then floor:FindFirstChild("HoleRail") else nil
		if rail then
			fadeable(rail)
		end
		local ceiling = piece(if shape.ShaftAbove then "Kit_CeilingHole" else "Kit_Ceiling", `Ceiling {key}`, model, at)
		if ceiling then
			ceilingLights(ceiling, room.Id)
		end
		piece("Kit_WallBack", `WallBack {key}`, model, at)
		local front = piece("Kit_WallFront", `WallFront {key}`, model, at)
		if offset == 0 then
			piece(if shape.LeftOpen then "Kit_WallSideDoor" else "Kit_WallSide", `WallLeft {key}`, model, at * HALF_TURN)
		else
			seams(model, room.Floor, column, front)
		end
		if front then
			tagFront(front, true)
		end
		if offset == room.Span - 1 then
			piece(if shape.RightOpen then "Kit_WallSideDoor" else "Kit_WallSide", `WallRight {key}`, model, at)
		end
	end
end

-- The graybox shell (Prompt 4): slabs, walls with doorways, a lamp per cell and a label.
local function shellGraybox(model: Model, room: Bunker.Room, info: { [string]: any }, shape: Shape)
	local t = Grid.Tuning()
	local W, H, D, T, S = t.CellWidth, t.CellHeight, t.CellDepth, t.WallThickness, t.SlabThickness
	local first = Grid.CellPosition(room.Floor, room.Column)
	local last = Grid.CellPosition(room.Floor, room.Column + room.Span - 1)
	local y0, z0 = first.Y, first.Z
	local xL, xR = first.X - W / 2 - T, last.X + W / 2 + T
	local color = ROOM_COLORS[room.Type] or DEFAULT_ROOM_COLOR
	local hole = {
		MinX = first.X + SHAFT_HOLE.FromX,
		MaxX = first.X + W / 2,
		MinZ = z0 - D / 2,
		MaxZ = z0 - D / 2 + SHAFT_HOLE.Depth,
	}

	slab(model, "Floor", Vector3.new(xL, y0 - S, z0 - D / 2 - T), Vector3.new(xR, y0, z0 + D / 2 + T), if shape.ShaftBelow then hole else nil, color, Enum.Material.SmoothPlastic)
	slab(model, "Ceiling", Vector3.new(xL + T, y0 + H - 0.5, z0 - D / 2), Vector3.new(xR - T, y0 + H, z0 + D / 2), if shape.ShaftAbove then hole else nil, CEILING_COLOR, Enum.Material.SmoothPlastic)
	local back = block(model, "BackWall", Vector3.new(xL, y0, z0 - D / 2 - T), Vector3.new(xR, y0 + H, z0 - D / 2), WALL_COLOR, Enum.Material.SmoothPlastic)
	local front = block(model, "FrontWall", Vector3.new(xL, y0, z0 + D / 2), Vector3.new(xR, y0 + H, z0 + D / 2 + T), FRONT_COLOR, Enum.Material.SmoothPlastic)
	if front then
		CollectionService:AddTag(front, BunkerKit.FRONT_WALL_TAG)
	end
	sideWall(model, "SideWallLeft", xL, xL + T, y0, z0, shape.LeftOpen)
	sideWall(model, "SideWallRight", xR - T, xR, y0, z0, shape.RightOpen)
	for offset = 0, room.Span - 1 do
		lamp(model, Grid.CellPosition(room.Floor, room.Column + offset), true, room.Id)
	end
	if back then
		label(back, `{info.Name}  L{room.Level}  ({room.Id})`)
	end
end

-- Rooms: insides -----------------------------------------------------------------------------

-- The graybox stair up from a Shaft to the Shaft above: a plank along the back, rising to
-- the right.
local function grayboxStair(parent: Instance, cell: Vector3)
	local t = Grid.Tuning()
	local rise = t.CellHeight + t.SlabThickness
	local run = t.CellWidth - 4
	local zMid = cell.Z - t.CellDepth / 2 + SHAFT_HOLE.Depth / 2
	local angle = math.atan2(rise, run)
	local length = math.sqrt(rise * rise + run * run)
	local normal = Vector3.new(-math.sin(angle), math.cos(angle), 0)
	local mid = Vector3.new(cell.X, cell.Y + rise / 2, zMid) - normal * 0.5
	local plank = Instance.new("Part")
	plank.Name = "Stair"
	plank.Anchored = true
	plank.Size = Vector3.new(length, 1, SHAFT_HOLE.Depth)
	plank.CFrame = CFrame.new(mid) * CFrame.Angles(0, 0, angle)
	plank.Color = ROOM_COLORS.Shaft
	plank.Material = Enum.Material.DiamondPlate
	fadeable(plank)
	plank.Parent = parent
end

-- Graybox stand-ins for a room's furniture when its art is missing, with the same sockets.
local function grayboxInterior(model: Model, room: Bunker.Room, info: { [string]: any }, centre: Vector3, holder: Holder)
	local t = Grid.Tuning()
	local y0, z0 = centre.Y, centre.Z
	local backZ = z0 - t.CellDepth / 2
	if room.Type == "ReactorCore" then
		local base = block(model, "CoreBase", Vector3.new(centre.X - 4, y0, z0 - 8), Vector3.new(centre.X + 4, y0 + 1, z0), Color3.fromRGB(60, 64, 70), Enum.Material.DiamondPlate)
		if base then
			fadeable(base)
		end
		local core = Instance.new("Part")
		core.Name = "Core"
		core.Anchored = true
		core.Shape = Enum.PartType.Cylinder
		core.Size = Vector3.new(10, 5, 5)
		core.CFrame = CFrame.new(centre.X, y0 + 6, z0 - 4) * CFrame.Angles(0, 0, math.rad(90))
		core.Material = Enum.Material.Neon
		core.Color = Color3.fromRGB(90, 200, 230)
		fadeable(core)
		core.Parent = model
		addSocket(holder, "Core", CFrame.new(centre.X, y0, z0 - 4), 1)
	elseif room.Type == "BlastDoor" then
		local door = Instance.new("Part")
		door.Name = "Door"
		door.Anchored = true
		door.Shape = Enum.PartType.Cylinder
		door.Size = Vector3.new(1, 13, 13)
		door.CFrame = CFrame.new(centre.X, y0 + 7, backZ + 0.5) * CFrame.Angles(0, math.rad(90), 0)
		door.Material = Enum.Material.DiamondPlate
		door.Color = Color3.fromRGB(70, 74, 80)
		fadeable(door)
		door.Parent = model
		addSocket(holder, "Door", CFrame.new(centre.X, y0, backZ + 3), 1)
		addSocket(holder, "SurfaceExit", CFrame.new(centre.X, y0 + t.CellHeight, backZ + 3), 1)
	elseif room.Type == "Medbay" then
		addSocket(holder, "Respawn", CFrame.new(centre.X, y0, z0 + 6), 1)
	elseif room.Type == "Quarters" and info.Beds then
		local beds = info.Beds[room.Level]
		for offset = 0, room.Span - 1 do
			local cell = Grid.CellPosition(room.Floor, room.Column + offset)
			local pitch = (t.CellWidth - 2) / beds
			for index = 1, beds do
				local x = cell.X - t.CellWidth / 2 + 1 + pitch * (index - 0.5)
				local bed = block(model, "Bed", Vector3.new(x - 1.4, y0, backZ + 0.5), Vector3.new(x + 1.4, y0 + 1.6, backZ + 7), Color3.fromRGB(120, 104, 160), Enum.Material.Fabric)
				if bed then
					bed:SetAttribute("Bed", offset * beds + index)
					fadeable(bed)
				end
				addSocket(holder, `Bed{index}`, CFrame.new(x, y0 + 1.6, backZ + 3.75), offset + 1)
			end
		end
	end
end

-- A room's insides: the Blast Door set, the Shaft stair, or its furniture per cell, then
-- its vent. Missing art falls back to the graybox. Returns whether the furniture is art.
local function interior(model: Model, room: Bunker.Room, info: { [string]: any }, shape: Shape, centre: Vector3, holder: Holder): boolean
	local first = Grid.CellPosition(room.Floor, room.Column)
	local isArt = false
	if room.Type == "BlastDoor" then
		local source = art("Kit", `Kit_BlastDoor_L{room.Level}`)
		if source then
			local set = place(source, "BlastDoor", model, CFrame.new(centre) * HALF_TURN)
			fadeable(set)
			collect(holder, set, 1)
			isArt = true
		else
			grayboxInterior(model, room, info, centre, holder)
		end
	elseif room.Type == "Shaft" then
		isArt = BunkerKit.HasArt()
		if shape.ShaftAbove then
			local source = art("Kit", `Kit_Shaft_L{room.Level}`)
			if source then
				local stair = place(source, "Stair", model, Grid.CellCFrame(room.Floor, room.Column))
				fadeable(stair)
				collect(holder, stair, 1)
			else
				grayboxStair(model, first)
				isArt = false
			end
		end
	else
		local source = art("Rooms", `Room_{room.Type}_L{room.Level}`)
		if source then
			local accent = ACCENT_LIGHTS[room.Type]
			for offset = 0, room.Span - 1 do
				local column = room.Column + offset
				local copy = place(source, `Interior {Grid.Key(room.Floor, column)}`, model, Grid.CellCFrame(room.Floor, column))
				fadeable(copy)
				for _, attachment in collect(holder, copy, offset + 1) do
					if accent and string.match(attachment.Name, "^Light%d*$") then
						addLight(attachment, accent, room.Id)
					end
				end
			end
			isArt = true
		else
			grayboxInterior(model, room, info, centre, holder)
		end
	end
	if not NO_VENT[room.Type] then
		local vent = piece("Kit_Vent", "Vent", model, Grid.CellCFrame(room.Floor, room.Column))
		if vent then
			fadeable(vent)
			collect(holder, vent, 1)
		end
	end
	return isArt
end

-- The players' spawn on the Medbay's Respawn point: invisible on the art pad, a red pad in
-- the graybox.
local function medbaySpawn(model: Model, holder: Holder, visible: boolean)
	local respawn = holder.Part:FindFirstChild("Respawn")
	if not (respawn and respawn:IsA("Attachment")) then
		return
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "MedbaySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(6, if visible then 1 else 0.2, 6)
	spawn.CFrame = CFrame.new(respawn.WorldPosition + Vector3.new(0, spawn.Size.Y / 2, 0))
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Color = Color3.fromRGB(196, 60, 60)
	if not visible then
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.CanQuery = false
		spawn.CastShadow = false
	end
	for _, child in spawn:GetChildren() do
		if child:IsA("Decal") then
			child:Destroy()
		end
	end
	spawn.Parent = model
end

-- Units --------------------------------------------------------------------------------------

local function buildRoom(bunker: Bunker.Bunker, room: Bunker.Room, parent: Instance): Model
	local info = Config.Get("Rooms", room.Type)
	local first = Grid.CellPosition(room.Floor, room.Column)
	local last = Grid.CellPosition(room.Floor, room.Column + room.Span - 1)
	local centre = (first + last) / 2

	local model = newModel(room.Id, parent)
	model:SetAttribute("RoomId", room.Id)
	model:SetAttribute("RoomType", room.Type)
	model:SetAttribute("Floor", room.Floor)
	model:SetAttribute("Column", room.Column)
	model:SetAttribute("Span", room.Span)
	model:SetAttribute("Level", room.Level)

	local shape: Shape = {
		ShaftBelow = room.Type == "Shaft" and bunker:IsShaft(room.Floor + 1, room.Column),
		ShaftAbove = room.Type == "Shaft" and bunker:IsShaft(room.Floor - 1, room.Column),
		LeftOpen = bunker:IsOpen(room.Floor, room.Column - 1),
		RightOpen = bunker:IsOpen(room.Floor, room.Column + room.Span),
	}
	local holder = newHolder(model, centre)
	local artShell = BunkerKit.HasArt()
	if artShell then
		shellArt(model, room, shape)
	else
		shellGraybox(model, room, info, shape)
	end
	local artInside = interior(model, room, info, shape, centre, holder)
	medbaySpawn(model, holder, not artInside)
	model:SetAttribute("Art", artShell and artInside)
	return model
end

local function buildDug(floor: number, column: number, parent: Instance): Model
	local t = Grid.Tuning()
	local band = Grid.BandOf(floor)
	local name = "D:" .. Grid.Key(floor, column)
	local source = art("Kit", `Kit_Dug_{band.Id}`)
	if source then
		local model = place(source, name, parent, Grid.CellCFrame(floor, column), true)
		model:SetAttribute("Floor", floor)
		model:SetAttribute("Column", column)
		model:SetAttribute("Band", band.Id)
		model:SetAttribute("Art", true)
		tagFront(model, false)
		for _, item in model:GetChildren() do
			if item:IsA("BasePart") and item.Name ~= "Floor" and item.Name ~= "BackRock" and item.Name ~= "FrontWall" then
				fadeable(item) -- timber, carts, pipes and other cave props
			end
		end
		local host = model:FindFirstChild("Floor")
		if host and host:IsA("BasePart") then
			for _, socket in socketsOf(model) do
				if socket.Name == "Light" then
					addLight(attach(host, "Light", socket.CFrame), DUG_LIGHTS[band.Id] or DUG_LIGHTS.Mines, name)
				end
			end
		end
		return model
	end

	local W, H, D, T, S = t.CellWidth, t.CellHeight, t.CellDepth, t.WallThickness, t.SlabThickness
	local cell = Grid.CellPosition(floor, column)
	local rock = BAND_COLORS[band.Id] or BAND_COLORS.Mines
	local model = newModel(name, parent)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	local x0, x1 = cell.X - W / 2 - T, cell.X + W / 2 + T
	block(model, "Floor", Vector3.new(x0, cell.Y - S, cell.Z - D / 2 - T), Vector3.new(x1, cell.Y, cell.Z + D / 2 + T), rock:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Ground)
	block(model, "BackRock", Vector3.new(x0, cell.Y, cell.Z - D / 2 - T), Vector3.new(x1, cell.Y + H, cell.Z - D / 2), rock, Enum.Material.Slate)
	local front = block(model, "FrontWall", Vector3.new(x0, cell.Y, cell.Z + D / 2), Vector3.new(x1, cell.Y + H, cell.Z + D / 2 + T), rock, Enum.Material.Slate)
	if front then
		CollectionService:AddTag(front, BunkerKit.FRONT_WALL_TAG)
	end
	lamp(model, cell, false, name)
	return model
end

-- Construction sites (Prompt 8) ----------------------------------------------------------------

local TIMBER = Color3.fromRGB(118, 94, 72)
local HAZARD = Color3.fromRGB(214, 168, 46)
local SITE_GHOST = { From = 0.8, To = 0.3 } -- the coming room's transparency, from the start to the end

--[[
	A construction site in open cells (BuildService): the coming room's interior art, see-through
	and firming up as the build goes on (SetSiteProgress), behind a timber scaffold with a
	hazard-striped plank. Graybox scaffolding until the art kit has a scaffold piece. Nothing on
	it collides; the camera passes through it. An upgrade site (`upgrade`, Nightmare's upgrades)
	is the scaffold alone: the room is already there and keeps working until it is done.
]]
function BunkerKit.Site(parent: Instance, name: string, roomType: string, floor: number, column: number, span: number, upgrade: boolean?): Model
	local t = Grid.Tuning()
	local model = newModel(name, parent)
	model:SetAttribute("RoomType", roomType)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	model:SetAttribute("Span", span)
	local ghost = Instance.new("Model")
	ghost.Name = "Ghost"
	ghost.Parent = if upgrade then nil else model
	local source = art("Rooms", `Room_{roomType}_L1`)
	for offset = 0, span - 1 do
		local cell = Grid.CellPosition(floor, column + offset)
		if upgrade then
			-- no ghost: the room stands there already
		elseif source then
			place(source, `Interior {Grid.Key(floor, column + offset)}`, ghost, Grid.CellCFrame(floor, column + offset))
		else
			local color = ROOM_COLORS[roomType] or DEFAULT_ROOM_COLOR
			block(ghost, "Block", cell + Vector3.new(-t.CellWidth / 4, 0, -t.CellDepth / 4), cell + Vector3.new(t.CellWidth / 4, t.CellHeight / 3, t.CellDepth / 4), color, Enum.Material.SmoothPlastic)
		end
		-- the scaffold: two posts, a top beam and a striped plank across the back of the cell
		local x0, x1 = cell.X - t.CellWidth / 2 + 2, cell.X + t.CellWidth / 2 - 2
		local z = cell.Z - t.CellDepth / 2 + 3
		for _, x in { x0, x1 } do
			block(model, "Post", Vector3.new(x - 0.5, cell.Y, z - 0.5), Vector3.new(x + 0.5, cell.Y + t.CellHeight - 0.5, z + 0.5), TIMBER, Enum.Material.Wood)
		end
		block(model, "Beam", Vector3.new(x0 - 0.5, cell.Y + t.CellHeight - 2, z - 0.5), Vector3.new(x1 + 0.5, cell.Y + t.CellHeight - 1, z + 0.5), TIMBER, Enum.Material.Wood)
		block(model, "Plank", Vector3.new(x0 - 0.5, cell.Y + t.CellHeight * 0.45, z - 0.3), Vector3.new(x1 + 0.5, cell.Y + t.CellHeight * 0.45 + 1.2, z + 0.3), HAZARD, Enum.Material.SmoothPlastic)
	end
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanTouch = false
			item.CanQuery = false
			item.CastShadow = false
			if item:IsDescendantOf(ghost) then
				item:SetAttribute("SiteSolid", item.Transparency)
			end
		elseif item:IsA("Light") or item:IsA("ProximityPrompt") or item:IsA("Script") then
			item:Destroy()
		end
	end
	fadeable(model)
	BunkerKit.SetSiteProgress(model, 0)
	return model
end

-- Firms the coming room up as its site builds (0 to 1), in steps of 5% so it isn't sent every frame.
function BunkerKit.SetSiteProgress(model: Model, progress: number)
	local ghost = model:FindFirstChild("Ghost")
	if not ghost then
		return
	end
	local alpha = SITE_GHOST.From + (SITE_GHOST.To - SITE_GHOST.From) * math.clamp(progress, 0, 1)
	alpha = math.floor(alpha * 20 + 0.5) / 20
	if model:GetAttribute("SiteAlpha") == alpha then
		return
	end
	model:SetAttribute("SiteAlpha", alpha)
	for _, item in ghost:GetDescendants() do
		if item:IsA("BasePart") then
			local solid = item:GetAttribute("SiteSolid")
			if type(solid) == "number" and solid < 1 then
				item.Transparency = math.max(solid, alpha)
			end
		end
	end
end

-- A rock cell's art, turned half a turn on alternate cells so the face doesn't repeat.
local function rockArt(bandId: string, name: string, parent: Instance, floor: number, column: number): Model?
	local source = art("Kit", `Kit_Rock_{bandId}`)
	if not source then
		return nil
	end
	local at = Grid.CellCFrame(floor, column)
	if (floor + column) % 2 == 1 then
		at *= HALF_TURN
	end
	local model = place(source, name, parent, at)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	model:SetAttribute("Band", bandId)
	return model
end

local function buildRock(floor: number, column: number, parent: Instance)
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local band = Grid.BandOf(floor)
	local key = Grid.Key(floor, column)
	if rockArt(band.Id, key, parent, floor, column) then
		return
	end
	local cell = Grid.CellPosition(floor, column)
	local part = block(
		parent,
		key,
		Vector3.new(cell.X - pitch.X / 2, cell.Y - t.SlabThickness, cell.Z - pitch.Z / 2),
		Vector3.new(cell.X + pitch.X / 2, cell.Y + t.CellHeight, cell.Z + pitch.Z / 2),
		BAND_COLORS[band.Id] or BAND_COLORS.Mines,
		Enum.Material.Slate
	)
	if part then
		part:SetAttribute("Floor", floor)
		part:SetAttribute("Column", column)
		part:SetAttribute("Band", band.Id)
	end
end

local function buildFrame(parent: Model)
	local t = Grid.Tuning()
	if art("Kit", "Kit_Rock_Mines") then
		-- A ring of rock cells: the Mines above floor 1, the Source's rock under floor 10, and
		-- each floor's band at the grid's two sides.
		for floor = t.FloorMin - 1, t.FloorMax + 1 do
			local outside = floor < t.FloorMin or floor > t.FloorMax
			local bandId = if floor < t.FloorMin then "Mines" elseif floor > t.FloorMax then "SourceChamber" else Grid.BandOf(floor).Id
			for column = t.ColumnMin - 1, t.ColumnMax + 1 do
				if outside or column < t.ColumnMin or column > t.ColumnMax then
					rockArt(bandId, `Frame {Grid.Key(floor, column)}`, parent, floor, column)
				end
			end
		end
		return
	end

	local pitch = Grid.Pitch()
	local topCell = Grid.CellPosition(t.FloorMin, t.ColumnMin)
	local bottomCell = Grid.CellPosition(t.FloorMax, t.ColumnMax)
	local left = topCell.X - pitch.X / 2
	local right = bottomCell.X + pitch.X / 2
	local top = topCell.Y + t.CellHeight
	local bottom = bottomCell.Y - t.SlabThickness
	local back, front = topCell.Z - pitch.Z / 2, topCell.Z + pitch.Z / 2
	local crust = BAND_COLORS.Mines:Lerp(Color3.fromRGB(90, 80, 60), 0.5)
	for column = t.ColumnMin, t.ColumnMax do
		local x = Grid.CellPosition(t.FloorMin, column).X
		block(parent, `Crust {column}`, Vector3.new(x - pitch.X / 2, top, back), Vector3.new(x + pitch.X / 2, top + CRUST, front), crust, Enum.Material.Ground)
	end
	block(parent, "Bedrock", Vector3.new(left - EDGE, bottom - BEDROCK, back), Vector3.new(right + EDGE, bottom, front), Color3.fromRGB(40, 34, 34), Enum.Material.Basalt)
	block(parent, "EdgeLeft", Vector3.new(left - EDGE, bottom, back), Vector3.new(left, top + CRUST, front), crust, Enum.Material.Slate)
	block(parent, "EdgeRight", Vector3.new(right, bottom, back), Vector3.new(right + EDGE, top + CRUST, front), crust, Enum.Material.Slate)
end

-- Sync ---------------------------------------------------------------------------------------

local function folders(root: Instance): Folders
	local function child(name: string, className: string): Instance
		local found = root:FindFirstChild(name)
		if not found then
			found = Instance.new(className)
			found.Name = name
			if found:IsA("Model") then
				found.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
			end
			found.Parent = root
		end
		return found :: Instance
	end
	return {
		Root = root,
		Frame = child("Frame", "Model") :: Model,
		Rock = child("Rock", "Model") :: Model,
		Dug = child("Dug", "Folder") :: Folder,
		Rooms = child("Rooms", "Folder") :: Folder,
	}
end

--[[
	Makes the world under `root` match `bunker`. With `dirty` (cell keys), only those cells
	and the units holding them are rebuilt (BunkerGrid passes the changed cells and their
	neighbours); without it, everything is.
]]
function BunkerKit.Sync(bunker: Bunker.Bunker, root: Instance, dirty: { [string]: boolean }?)
	local t = Grid.Tuning()
	local f = folders(root)
	if #f.Frame:GetChildren() == 0 then
		buildFrame(f.Frame)
	end

	local keys: { string } = {}
	if dirty then
		for key in dirty do
			table.insert(keys, key)
		end
	else
		for floor = t.FloorMin, t.FloorMax do
			for column = t.ColumnMin, t.ColumnMax do
				table.insert(keys, Grid.Key(floor, column))
			end
		end
	end

	local units: { [string]: boolean } = {}
	for _, key in keys do
		local floor, column = Grid.Parse(key)
		if not floor or not column or not Grid.OnGrid(floor, column) then
			continue
		end
		local rock = f.Rock:FindFirstChild(key)
		if bunker:State(floor, column) == "Rock" then
			if not rock then
				buildRock(floor, column, f.Rock)
			end
		else
			if rock then
				rock:Destroy()
			end
			local unit = bunker:UnitAt(floor, column)
			if unit then
				units[unit] = true
			end
		end
	end

	-- Models whose unit is gone or is being rebuilt
	for _, model in f.Rooms:GetChildren() do
		if units[model.Name] or bunker:Room(model.Name) == nil then
			model:Destroy()
		end
	end
	for _, model in f.Dug:GetChildren() do
		local floor, column = Grid.Parse(string.sub(model.Name, 3))
		local current = if floor and column then bunker:UnitAt(floor, column) else nil
		if units[model.Name] or current ~= model.Name then
			model:Destroy()
		end
	end

	for unit in units do
		local room = bunker:Room(unit)
		if room then
			buildRoom(bunker, room, f.Rooms)
		else
			local floor, column = Grid.Parse(string.sub(unit, 3))
			if floor and column then
				buildDug(floor, column, f.Dug)
			end
		end
	end
end

-- Queries ------------------------------------------------------------------------------------

-- A room's gameplay point (an Attachment on its Sockets part), in the world.
function BunkerKit.Socket(model: Instance, name: string): CFrame?
	local holder = model:FindFirstChild("Sockets")
	local attachment = if holder then holder:FindFirstChild(name) else nil
	if attachment and attachment:IsA("Attachment") then
		return attachment.WorldCFrame
	end
	return nil
end

-- A room's gameplay points whose names match a Lua pattern ("^WorkSpot%d+$"), or all.
function BunkerKit.Sockets(model: Instance, pattern: string?): { [string]: CFrame }
	local found: { [string]: CFrame } = {}
	local holder = model:FindFirstChild("Sockets")
	if holder then
		for _, item in holder:GetChildren() do
			if item:IsA("Attachment") and (pattern == nil or string.match(item.Name, pattern)) then
				found[item.Name] = item.WorldCFrame
			end
		end
	end
	return found
end

-- Counts parts under the bunker (DevTools).
function BunkerKit.PartCount(root: Instance): number
	local count = 0
	for _, item in root:GetDescendants() do
		if item:IsA("BasePart") then
			count += 1
		end
	end
	return count
end

return BunkerKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C3"><Properties><string name="Name">Hazards</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Hazards: what disasters do to the bunker that other systems must see at once (bible Section 10;
	Prompt 13). Run place, server. DisasterService writes it; Lib.PathGraph, ResidentBrain and
	MonsterService read it. It is a module rather than a service so readers need not depend on
	DisasterService (which itself needs the residents and the combatants).

	* Fires: a room id -> the fire's strength (0 to 100).
	* Blocked passages: cave-in rubble between two graph units (a doorway, or every passage into
	  a tunnel cell). Routes go around them; when there is no way round, residents are trapped.
	* Version() grows with every change to the blocked passages, so walkers know to plan again.
]]

local Hazards = {}

local fires: { [string]: number } = {}
local blocked: { [string]: string } = {} -- "a|b" (sorted) -> the rubble's id
local version = 0

local function edgeKey(a: string, b: string): string
	return if a < b then `{a}|{b}` else `{b}|{a}`
end

Hazards.EdgeKey = edgeKey

-- Fires --------------------------------------------------------------------------------------------

function Hazards.SetFire(unit: string, strength: number?)
	fires[unit] = if strength and strength > 0 then strength else nil
end

function Hazards.Fire(unit: string?): number?
	return if unit then fires[unit] else nil
end

function Hazards.Fires(): { [string]: number }
	return fires
end

-- Blocked passages ---------------------------------------------------------------------------------

function Hazards.Block(a: string, b: string, by: string)
	local key = edgeKey(a, b)
	if blocked[key] ~= by then
		blocked[key] = by
		version += 1
	end
end

-- Opens every passage the rubble `by` blocked.
function Hazards.Unblock(by: string)
	for key, owner in table.clone(blocked) do
		if owner == by then
			blocked[key] = nil
			version += 1
		end
	end
end

function Hazards.Blocked(a: string, b: string): boolean
	return blocked[edgeKey(a, b)] ~= nil
end

-- The rubble blocking a passage, if any.
function Hazards.BlockedBy(a: string, b: string): string?
	return blocked[edgeKey(a, b)]
end

function Hazards.AnyBlocked(): boolean
	return next(blocked) ~= nil
end

-- The units next to `unit` that can be walked to (Bunker:Neighbors without blocked passages).
function Hazards.Neighbors(bunker: any, unit: string): { string }
	local list = bunker:Neighbors(unit)
	if next(blocked) == nil then
		return list
	end
	local open = {}
	for _, other in list do
		if not blocked[edgeKey(unit, other)] then
			table.insert(open, other)
		end
	end
	return open
end

function Hazards.Version(): number
	return version
end

-- Forgets everything (a new run in the same server; DevTools).
function Hazards.Clear()
	table.clear(fires)
	if next(blocked) then
		table.clear(blocked)
		version += 1
	end
end

return Hazards
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C4"><Properties><string name="Name">PathGraph</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PathGraph: walking routes inside the bunker (bible Section 23: residents move along the room
	graph; every room has nodes for doors, work spots, beds and tables). Run place, server.

	A route is the room graph's shortest path (Bunker:Neighbors: doorways sideways, Shafts up and
	down; dug cells count). Its waypoints:
	* inside a room or dug cell, along the front aisle (AISLE studs in front of the cell's centre
	  line, clear of the furniture against the back wall);
	* through a doorway at its middle (DOOR studs in front of centre; doorways are 8 wide);
	* up or down a Shaft by its stairs: the lower Shaft cell's Bottom and Top sockets (the stairs
	  climb from its floor to the floor above);
	* the target last (a work spot, a seat, a bed).
	Graybox rooms without sockets fall back to the cell's middle.

	Cave-in rubble (Prompt 13, Lib.Hazards) blocks passages: routes go around it. When rubble is
	the only reason there is no route, Waypoints says "Blocked" (residents are then trapped and
	monsters look for another target).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Grid = require(ReplicatedStorage.Shared.Rules.Grid)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)
local Hazards = require(ServerScriptService.Lib.Hazards)

local PathGraph = {}

local AISLE = 8 -- studs in front of the cell's centre line
local DOOR = 2 -- the doorway's walking line, in front of centre
local DOOR_REACH = 6 -- how far either side of a wall the doorway approach starts

-- The shortest route from one graph node to another (both included), or nil. Rubble blocks
-- passages unless `ignoreRubble`.
function PathGraph.Route(bunker: any, from: string, to: string, ignoreRubble: boolean?): { string }?
	if from == to then
		return { from }
	end
	local previous: { [string]: string } = {}
	local seen: { [string]: boolean } = { [from] = true }
	local queue = { from }
	local index = 1
	while index <= #queue do
		local unit = queue[index]
		index += 1
		for _, other in if ignoreRubble then bunker:Neighbors(unit) else Hazards.Neighbors(bunker, unit) do
			if not seen[other] then
				seen[other] = true
				previous[other] = unit
				if other == to then
					local route = { to }
					local at = to
					while previous[at] do
						at = previous[at]
						table.insert(route, 1, at)
					end
					return route
				end
				table.insert(queue, other)
			end
		end
	end
	return nil
end

local function floorY(floor: number, column: number): number
	return Grid.CellPosition(floor, column).Y
end

local function aisle(x: number, floor: number, column: number): Vector3
	local cell = Grid.CellPosition(floor, column)
	return Vector3.new(x, cell.Y, cell.Z + AISLE)
end

-- The cells of `a` and `b` that touch: a horizontal pair on one floor, or a vertical pair.
local function touching(bunker: any, a: string, b: string): ({ number }?, { number }?)
	for _, ca in bunker:CellsOf(a) do
		for _, cb in bunker:CellsOf(b) do
			local same = ca[1] == cb[1] and math.abs(ca[2] - cb[2]) == 1
			local stacked = ca[2] == cb[2] and math.abs(ca[1] - cb[1]) == 1
			if same or stacked then
				return ca, cb
			end
		end
	end
	return nil, nil
end

-- Is rubble the only thing between two nodes? (A route exists without it, none with it.)
function PathGraph.Blocked(bunker: any, from: string, to: string): boolean
	if not Hazards.AnyBlocked() then
		return false
	end
	return PathGraph.Route(bunker, from, to) == nil and PathGraph.Route(bunker, from, to, true) ~= nil
end

--[[
	Waypoints from `fromPosition` (in node `fromUnit`) to `target` (in node `toUnit`). `modelOf`
	gives a room's model (for the Shafts' stair sockets). nil when no route exists, with
	"Blocked" when rubble is what stands in the way.
]]
function PathGraph.Waypoints(bunker: any, modelOf: (string) -> Model?, fromPosition: Vector3, fromUnit: string,
	toUnit: string, target: Vector3): ({ Vector3 }?, string?)
	local route = PathGraph.Route(bunker, fromUnit, toUnit)
	if not route then
		return nil, if PathGraph.Route(bunker, fromUnit, toUnit, true) then "Blocked" else nil
	end
	local points: { Vector3 } = {}
	local startCell = bunker:CellsOf(fromUnit)[1]
	if startCell then
		local floor, column = Grid.CellAt(fromPosition)
		table.insert(points, aisle(fromPosition.X, floor or startCell[1], column or startCell[2]))
	end
	for i = 1, #route - 1 do
		local u, v = route[i], route[i + 1]
		local cu, cv = touching(bunker, u, v)
		if cu and cv then
			if cu[1] == cv[1] then
				-- sideways, through the doorway in the shared wall
				local pu, pv = Grid.CellPosition(cu[1], cu[2]), Grid.CellPosition(cv[1], cv[2])
				local wall = (pu.X + pv.X) / 2
				local dir = if cv[2] > cu[2] then 1 else -1
				local y = pu.Y
				table.insert(points, Vector3.new(wall - dir * DOOR_REACH, y, pu.Z + AISLE))
				table.insert(points, Vector3.new(wall - dir * DOOR_REACH, y, pu.Z + DOOR))
				table.insert(points, Vector3.new(wall + dir * DOOR_REACH, y, pu.Z + DOOR))
				table.insert(points, Vector3.new(wall + dir * DOOR_REACH, y, pu.Z + AISLE))
			else
				-- up or down a Shaft: the lower cell's stairs, Bottom (its floor) to Top (the floor above)
				local lower = if cu[1] > cv[1] then cu else cv
				local lowerUnit = if lower == cu then u else v
				local model = modelOf(lowerUnit)
				local bottom = if model then BunkerKit.Socket(model, "Bottom") else nil
				local top = if model then BunkerKit.Socket(model, "Top") else nil
				local up = cv[1] < cu[1]
				if bottom and top then
					local first, last = if up then bottom.Position else top.Position, if up then top.Position else bottom.Position
					table.insert(points, aisle(first.X, cu[1], cu[2]))
					table.insert(points, first)
					table.insert(points, last)
					table.insert(points, aisle(last.X, cv[1], cv[2]))
				else
					local pv = Grid.CellPosition(cv[1], cv[2])
					table.insert(points, Vector3.new(pv.X, pv.Y, pv.Z + AISLE))
				end
			end
		end
	end
	local floor, column = Grid.CellAt(target + Vector3.new(0, 1, 0))
	if floor and column then
		table.insert(points, Vector3.new(target.X, floorY(floor, column), Grid.CellPosition(floor, column).Z + AISLE))
	end
	table.insert(points, target)
	return points
end

return PathGraph
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C5"><Properties><string name="Name">ProfileSchema</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileSchema: the shape of a player's saved data (bible Section 23), its defaults, its
	migrations, and the load pipeline: migrate, then reconcile, then validate. Pure (no
	DataStores), so the data tests can run it on fixtures. ProfileService does the I/O.

	Version history:
	  1  2026-11-08  first version (Prompt 2)

	To change the shape: raise VERSION, add MIGRATIONS[old] that turns version old into old+1,
	and update Default() and SHAPE. Never rename or drop a field without a migration: during
	a rolling update old and new servers run side by side, and an old server refuses (never
	overwrites) data newer than it knows.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Check = require(Shared.Utilities.Check)
local Config = require(Shared.Config)
local TableUtil = require(Shared.Utilities.TableUtil)

local ProfileSchema = {}

ProfileSchema.VERSION = 1
ProfileSchema.RECEIPTS_KEPT = 200

-- version -> function turning a profile of that version into the next version
local MIGRATIONS: { [number]: (data: { [string]: any }) -> { [string]: any } } = {}

-- Fields whose value is a fixed-shape record (reconciled field by field); every other table
-- field is a map whose keys belong to the player (classes owned, badges earned...).
local RECORDS: { [string]: boolean } = {
	Talents = true,
	Cosmetics = true,
	Stats = true,
	Quests = true,
	ClassShop = true,
}

local Id = Check.string(64, { pattern = "^[%a][%w_]*$" })

local SHAPE = Check.shape({
	Version = Check.integer(1),
	Glowshards = Check.integer(0, 1e9),
	Classes = Check.map(Id, Check.shape({ Level = Check.integer(1, 3), XP = Check.number({ min = 0 }) }), 100),
	Talents = Check.shape({ Slots = Check.integer(0, 3), Equipped = Check.array(Id, 3) }),
	Legends = Check.map(Id, Check.shape({ Renown = Check.integer(1, 5) }), 200),
	Cosmetics = Check.shape({
		Owned = Check.map(Id, Check.boolean(), 2000),
		Equipped = Check.map(Id, Id, 32),
	}),
	Stats = Check.map(Id, Check.number({ min = 0 }), 64),
	Badges = Check.map(Id, Check.number({ min = 0 }), 500),
	Quests = Check.shape({
		Daily = Check.array(Check.any(), 10),
		Weekly = Check.array(Check.any(), 10),
		LastReset = Check.number({ min = 0 }),
	}),
	ClassShop = Check.shape({
		Day = Check.integer(0),
		Slots = Check.array(Id, 4),
		RerollsUsed = Check.integer(0),
		Wishlist = Check.optional(Id),
	}),
	AccountLevel = Check.integer(1, 100),
	AccountXP = Check.number({ min = 0 }),
	Settings = Check.map(Id, Check.primitive(64), 64),
	Receipts = Check.array(Check.string(64, { min = 1 }), 200),
	FirstRunDone = Check.boolean(),
})

-- A new player's profile: the free class and the starter Legend are theirs (bible Sections
-- 14 and 15).
function ProfileSchema.Default(): { [string]: any }
	local classes: { [string]: any } = {}
	for _, class in Config.All("Classes") do
		if class.Tier == "Free" then
			classes[class.Id] = { Level = 1, XP = 0 }
		end
	end
	local legends: { [string]: any } = {}
	local starter = Config.Get("Tuning", "Legends").StarterLegend
	legends[starter] = { Renown = 1 }
	return {
		Version = ProfileSchema.VERSION,
		Glowshards = 0,
		Classes = classes,
		Talents = { Slots = 0, Equipped = {} },
		Legends = legends,
		Cosmetics = { Owned = {}, Equipped = {} },
		Stats = { Runs = 0, Wins = 0, BestYear = 0, Deepest = 0 },
		Badges = {},
		Quests = { Daily = {}, Weekly = {}, LastReset = 0 },
		ClassShop = { Day = 0, Slots = {}, RerollsUsed = 0 },
		AccountLevel = 1,
		AccountXP = 0,
		Settings = {},
		Receipts = {},
		FirstRunDone = false,
	}
end

-- Runs every migration from data.Version up to VERSION. Errors if a step is missing.
function ProfileSchema.Migrate(data: { [string]: any }): { [string]: any }
	local version = data.Version
	if type(version) ~= "number" then
		version = 1
		data.Version = 1
	end
	while version < ProfileSchema.VERSION do
		local step = MIGRATIONS[version]
		if not step then
			error(`no migration from profile version {version}`)
		end
		data = step(data)
		version += 1
		data.Version = version
	end
	return data
end

-- Fills in fields the profile is missing (new fields, new record fields) from the defaults.
-- Never touches the player's own keys in maps.
function ProfileSchema.Reconcile(data: { [string]: any }): { [string]: any }
	local defaults = ProfileSchema.Default()
	for field, value in defaults do
		local current = data[field]
		if current == nil then
			data[field] = value
		elseif RECORDS[field] and type(current) == "table" and type(value) == "table" then
			for subField, subValue in value do
				if current[subField] == nil then
					current[subField] = subValue
				end
			end
		end
	end
	return data
end

function ProfileSchema.Validate(data: any): (boolean, string?)
	return SHAPE(data)
end

export type LoadStatus = "New" | "Loaded" | "TooNew" | "Invalid"

--[[
	The whole load pipeline for stored Data (nil for a new player): returns the profile to use
	and a status. TooNew and Invalid return no profile: the player must not play on it (and
	nothing may be written).
]]
function ProfileSchema.Load(stored: any): ({ [string]: any }?, LoadStatus, string?)
	if stored == nil then
		return ProfileSchema.Default(), "New", nil
	end
	if type(stored) ~= "table" then
		return nil, "Invalid", `stored data is a {type(stored)}`
	end
	if type(stored.Version) == "number" and stored.Version > ProfileSchema.VERSION then
		return nil, "TooNew", `version {stored.Version} is newer than {ProfileSchema.VERSION}`
	end
	local data = TableUtil.DeepCopy(stored)
	local ok, result = pcall(ProfileSchema.Migrate, data)
	if not ok then
		return nil, "Invalid", tostring(result)
	end
	data = ProfileSchema.Reconcile(result)
	local valid, why = ProfileSchema.Validate(data)
	if not valid then
		return nil, "Invalid", why
	end
	return data, "Loaded", nil
end

-- What the player's own client sees: everything except the receipt log.
function ProfileSchema.Public(data: { [string]: any }): { [string]: any }
	local copy = TableUtil.DeepCopy(data)
	copy.Receipts = nil
	return copy
end

-- Adds a receipt id, keeping the newest RECEIPTS_KEPT.
function ProfileSchema.AddReceipt(data: { [string]: any }, receiptId: string)
	local receipts = data.Receipts
	table.insert(receipts, receiptId)
	while #receipts > ProfileSchema.RECEIPTS_KEPT do
		table.remove(receipts, 1)
	end
end

ProfileSchema._MIGRATIONS = MIGRATIONS -- for the data tests

return ProfileSchema
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000000DE"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000000C7"><Properties><string name="Name">BossService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BossService: boss fights (bible Sections 5, 10 and 22). Run place only; Prompt 15 brings the
	Era I boss, the Brood Mother. The arithmetic is Shared.Rules.Boss; the numbers are
	Config.Bosses, Tuning.Bosses and Tuning.BroodMother (provisional).

	* A boss Surge (CycleClock.SurgeStarted with kind Boss) starts its boss's fight. Section 5: the
	  Surge has no timer and ends when the boss dies (ObjectiveService:BossBeaten, which also adds
	  1 to Years per Cycle).
	* Arrival (Section 10: the Brood Mother bursts up through the deepest tunnel): the arena is
	  Rules.Boss.Arena. Cracks, dust, a red light and an alert give ArrivalWarningSeconds of
	  warning; then she rises out of the floor in a burst of rock and roars.
	* Health: Rules.Boss.Health (the team's size; weaker on an account's first run, Section 22).
	  Hits on her armour do ArmourMultiplier; hits on her glowing belly (the model's WeakPoint part)
	  WeakPointMultiplier, the Sharpshooter's own if they have it (WeaponService:SetHitModifier;
	  such hits are Damaged with how "weakpoint").
	* The fight, ticked every TickSeconds while she lives:
	  - she turns to the nearest standing player and walks along her arena towards them (she is
	    too big for a doorway, so she never leaves it);
	  - within SlamReach she rears and slams (the Attack clip's HitTime): SlamDamage to players and
	    residents within SlamRadius of the blow;
	  - every LaySeconds she lays SacsPerLay egg sacs behind her (her Ovipositor socket), up to
	    MaxSacs; a sac (SacHealth; fire does BurnMultiplier) hatches HatchCount Burrow Ticks after
	    HatchSeconds unless it is broken or burned first;
	  - StaggerFraction of her health dealt to her belly within StaggerWindowSeconds staggers her
	    for StaggerSeconds;
	  - each new phase (Config.Bosses' Phases) she roars, lays more often and moves faster.
	* Death: the Death clip, her sacs wither, BossBeaten ends the Surge, Defeated fires; after
	  DeathSeconds she dissolves.

	Replication: the Boss collection, "Fight" -> { Id, Name, Health, Max, Phase, Phases, State,
	At = { X, Y, Z } (where she breaks in), ArriveAt (server time), Sacs } while a fight is on.
	The model is in workspace.Monsters with Rig, Activity and AttackAt attributes for NPCAnimator.

	API:
		BossService:BeginFight(bossId): (boolean, string?) -- a fight now (CycleClock's boss Surge; DevTools)
		BossService:Active(): string?
		BossService:IsBoss(combatId): boolean           -- the boss itself, not an egg sac
		BossService:IsEggSac(combatId): boolean         -- one of its egg sacs (a broken sac isn't a kill)
		BossService.Started: Signal<string>             -- bossId
		BossService.Defeated: Signal<string, Player?>   -- bossId, who struck the last blow
	Dev: boss, boss.start, boss.hurt, boss.lay, boss.end.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Boss = require(Shared.Rules.Boss)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("BossService")

local BossService = {
	Name = "BossService",
	Dependencies = {
		"CycleClock", "RunDirector", "BunkerGrid", "SessionService", "CombatService", "MonsterService", "WeaponService",
		"ObjectiveService", "ThreatDirector", "ReplicationService", "DevService",
	},
	Started = Signal.new() :: Signal.Signal<string>,
	Defeated = Signal.new() :: Signal.Signal<string, Player?>,
}

local RISE_DEPTH = 13 -- how far under the floor she starts
local HATCH_TAG_PREFIX = "Boss:"

type Sac = { CombatId: string, Model: Model, HatchAt: number }
type Fight = {
	BossId: string,
	Name: string,
	T: { [string]: any },
	Arena: Boss.Arena,
	Left: number,
	Right: number,
	X: number,
	Y: number,
	Z: number,
	Yaw: number,
	Model: Model?,
	Root: BasePart?,
	CombatId: string?,
	Max: number,
	Phase: number,
	State: string, -- "Warning" | "Rising" | "Fighting" | "Dying"
	ArriveAt: number,
	Busy: number,
	NextAttack: number,
	NextLay: number,
	Sacs: { [string]: Sac },
	Hits: { { At: number, Amount: number } },
	LastHitBy: string?,
	PublishedAt: number,
	Sent: string,
	Effects: { Instance },
}

local clock: any = nil
local director: any = nil
local grid: any = nil
local session: any = nil
local combat: any = nil
local monsters: any = nil
local weapons: any = nil
local objectives: any = nil
local threat: any = nil
local collection: any = nil

local fight: Fight? = nil
local sacIds: { [string]: boolean } = {} -- every egg sac's combatant id this run (ids aren't reused)

-- Helpers --------------------------------------------------------------------------------------------

local function now(): number
	return workspace:GetServerTimeNow()
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function holder(): Instance
	local f = workspace:FindFirstChild("Monsters")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Monsters"
		f.Parent = workspace
	end
	return f :: Instance
end

local function art(asset: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local bosses = assets and assets:FindFirstChild("Bosses")
	local found = bosses and bosses:FindFirstChild(asset)
	return if found and found:IsA("Model") then found else nil
end

local function socket(model: Model, name: string): CFrame
	local value = model:GetAttribute(`Socket_{name}`)
	return model:GetPivot() * (if typeof(value) == "CFrame" then value else CFrame.identity)
end

local function setActivity(activity: string)
	local f = fight
	if f and f.Model and f.Model:GetAttribute("Activity") ~= activity then
		f.Model:SetAttribute("Activity", activity)
	end
end

local function pivot(f: Fight): CFrame
	return CFrame.new(f.X, f.Y, f.Z) * CFrame.Angles(0, f.Yaw, 0)
end

local function where(arena: Boss.Arena): string
	return `FLOOR {arena.Floor} · COLUMN {Boss.ArenaMiddle(arena)}`
end

local function publish(force: boolean?)
	local f = fight
	if not f then
		collection:Remove("Fight")
		return
	end
	local health = 0
	if f.CombatId then
		health = (combat:HealthOf(f.CombatId))
	elseif f.State == "Warning" or f.State == "Rising" then
		health = f.Max
	end
	local count = 0
	for _ in f.Sacs do
		count += 1
	end
	local sent = `{math.ceil(health)}|{f.Phase}|{f.State}|{count}`
	if not force and (sent == f.Sent or os.clock() - f.PublishedAt < Boss.Tuning().PublishSeconds) then
		return
	end
	f.Sent = sent
	f.PublishedAt = os.clock()
	local at = Grid.CellPosition(f.Arena.Floor, Boss.ArenaMiddle(f.Arena))
	collection:Set("Fight", {
		Id = f.BossId,
		Name = f.Name,
		Health = math.ceil(health),
		Max = f.Max,
		Phase = f.Phase,
		Phases = Config.Get("Bosses", f.BossId).Phases,
		State = f.State,
		At = { X = f.X, Y = at.Y, Z = f.Z },
		ArriveAt = f.ArriveAt,
		Sacs = count,
	})
end

-- Effects ---------------------------------------------------------------------------------------------

local function effectPart(at: Vector3, name: string): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(14, 1, 14)
	part.CFrame = CFrame.new(at)
	part.Parent = holder()
	return part
end

local function rockBurst(at: Vector3, chips: number)
	local part = effectPart(at + Vector3.new(0, 0.5, 0), "BossBurst")
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(140, 128, 112))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 12) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(1.5, 3)
	dust.Speed = NumberRange.new(8, 18)
	dust.SpreadAngle = Vector2.new(70, 70)
	dust.Acceleration = Vector3.new(0, -4, 0)
	dust.Rate = 0
	dust.Parent = part
	local rocks = Instance.new("ParticleEmitter")
	rocks.Color = ColorSequence.new(Color3.fromRGB(70, 64, 58))
	rocks.Size = NumberSequence.new(0.6)
	rocks.Lifetime = NumberRange.new(1, 1.6)
	rocks.Speed = NumberRange.new(20, 34)
	rocks.SpreadAngle = Vector2.new(45, 45)
	rocks.Acceleration = Vector3.new(0, -60, 0)
	rocks.Rate = 0
	rocks.Parent = part
	dust:Emit(60)
	rocks:Emit(chips)
	task.delay(4, function()
		part:Destroy()
	end)
end

-- Cracks, dust and a blinking red light where she will break in (like a breach's warning).
local function warning(f: Fight, seconds: number)
	local at = Vector3.new(f.X, f.Y + 0.2, f.Z)
	local part = effectPart(at, "BossWarning")
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(140, 128, 112))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5), NumberSequenceKeypoint.new(1, 5) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(1.2, 2.4)
	dust.Speed = NumberRange.new(1, 4)
	dust.SpreadAngle = Vector2.new(90, 90)
	dust.Rate = 18
	dust.Parent = part
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(232, 80, 59)
	light.Range = 26
	light.Brightness = 2
	light.Parent = part
	table.insert(f.Effects, part)
	task.spawn(function()
		local endsAt = os.clock() + seconds
		while os.clock() < endsAt and part.Parent do
			dust.Rate = 18 + 40 * (1 - (endsAt - os.clock()) / seconds)
			light.Brightness = if light.Brightness > 1 then 0.4 else 3
			task.wait(0.4)
		end
		part:Destroy()
	end)
end

-- The fight's model ---------------------------------------------------------------------------------

local function graybox(bossId: string): Model
	local model = Instance.new("Model")
	model.Name = bossId
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(5, 4, 7)
	root.Transparency = 1
	root.Anchored = true
	root.Parent = model
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = Vector3.new(16, 8, 18)
	body.Color = Color3.fromHex("#403B37")
	body.CFrame = CFrame.new(0, 5, 0)
	body.CanCollide = false
	body.Parent = model
	local belly = Instance.new("Part")
	belly.Name = "Belly"
	belly.Size = Vector3.new(6, 3, 8)
	belly.Color = Color3.fromHex("#7CFF9B")
	belly.Material = Enum.Material.Neon
	belly.CFrame = CFrame.new(0, 2.5, 5)
	belly.CanCollide = false
	belly:SetAttribute("Role", "WeakPoint")
	belly.Parent = model
	root.CFrame = CFrame.new(0, 4.95, 0)
	for _, part in { body, belly } do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid
	model.PrimaryPart = root
	root.PivotOffset = CFrame.new(0, -4.95, 0)
	model:SetAttribute("Graybox", true)
	return model
end

local function makeModel(f: Fight): (Model, BasePart)
	local entry = Config.Get("Bosses", f.BossId)
	local template = art(entry.Asset)
	local model = if template then template:Clone() else graybox(f.BossId)
	model.Name = f.BossId
	local root = (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart) :: BasePart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanTouch = false
			part.Anchored = part == root
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false
		humanoid.MaxHealth = math.huge -- CombatService keeps her health; the Humanoid only animates
		humanoid.Health = math.huge
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		humanoid.PlatformStand = true
	end
	-- Her glow lights the tunnel around her, so her body reads in the dark (the art has no lights).
	local glowAt = Instance.new("Attachment")
	glowAt.Name = "BossGlow"
	glowAt.Position = root.CFrame:PointToObjectSpace(model:GetPivot() * Vector3.new(0, 10, 2))
	glowAt.Parent = root
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(124, 255, 155)
	glow.Range = 24
	glow.Brightness = 1.2
	glow.Shadows = false
	glow.Parent = glowAt
	model:SetAttribute("Rig", f.BossId)
	model:SetAttribute("MonsterType", f.BossId)
	model:SetAttribute("Boss", f.BossId)
	model:SetAttribute("Activity", "Roar")
	return model, root
end

local function weakParts(model: Model): { BasePart }
	local list = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("Role") == "WeakPoint" then
			table.insert(list, part)
		end
	end
	return list
end

-- Egg sacs ---------------------------------------------------------------------------------------------

local function removeSac(f: Fight, id: string, how: string)
	local sac = f.Sacs[id]
	if not sac then
		return
	end
	f.Sacs[id] = nil
	if how ~= "Broken" then -- a broken sac is dissolved by CombatService
		combat:Unregister(sac.CombatId)
		if sac.Model.Parent then
			combat:Dissolve(sac.Model)
		end
	end
	publish(true)
end

local function sacModel(): Model
	local template = art("Boss_BroodMother_EggSac")
	if template then
		return template:Clone()
	end
	local model = Instance.new("Model")
	model.Name = "EggSac"
	local mound = Instance.new("Part")
	mound.Name = "Mound"
	mound.Size = Vector3.new(3.6, 1, 3.2)
	mound.Color = Color3.fromHex("#6E4766")
	mound.Parent = model
	local eggs = Instance.new("Part")
	eggs.Name = "Eggs"
	eggs.Shape = Enum.PartType.Ball
	eggs.Size = Vector3.new(2.4, 2.4, 2.4)
	eggs.Material = Enum.Material.Neon
	eggs.Color = Color3.fromHex("#7CFF9B")
	eggs.CFrame = CFrame.new(0, 1.2, 0)
	eggs.Parent = model
	model.PrimaryPart = mound
	mound.CFrame = CFrame.new(0, 0.5, 0)
	model.WorldPivot = CFrame.identity
	return model
end

local function laySac(f: Fight, at: Vector3)
	local model = sacModel()
	local x = math.clamp(at.X, f.Left - f.T.ArenaMargin + 3, f.Right + f.T.ArenaMargin - 3)
	local z = math.clamp(at.Z, f.Z - 11, f.Z + 11)
	model:PivotTo(CFrame.new(x, f.Y, z) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	local root: BasePart? = nil
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanTouch = false
			if part.Name == "Mound" or (not root and part.CanQuery) then
				root = part
			end
		end
	end
	model.Name = "EggSac"
	model:SetAttribute("Boss", f.BossId)
	model.Parent = holder()
	local id = combat:Register(model, {
		Kind = "Monster", Team = "Monsters", Health = f.T.SacHealth, MonsterType = "EggSac", Root = root,
	})
	if not id then
		model:Destroy()
		return
	end
	model.Name = `EggSac_{id}`
	sacIds[id] = true
	f.Sacs[id] = { CombatId = id, Model = model, HatchAt = os.clock() + f.T.HatchSeconds }
	rockBurst(Vector3.new(x, f.Y, z), 6)
end

local function hatch(f: Fight, id: string)
	local sac = f.Sacs[id]
	if not sac then
		return
	end
	local entry = Config.Get("Bosses", f.BossId)
	local kind = if entry.Minions then entry.Minions[1] else "BurrowTick"
	local hatches = sac.Model:GetAttribute("Hatches")
	if type(hatches) == "string" and Config.Find("Monsters", hatches) then
		kind = hatches
	end
	local base = sac.Model:GetPivot()
	for i = 1, f.T.HatchCount do
		local angle = (i / f.T.HatchCount) * math.pi * 2
		local spot = base * CFrame.new(math.cos(angle) * 2, 0.5, math.sin(angle) * 2)
		monsters:Spawn(kind, CFrame.new(spot.Position), HATCH_TAG_PREFIX .. f.BossId)
	end
	removeSac(f, id, "Hatched")
	log:Info("an egg sac hatched %d %s", f.T.HatchCount, kind)
end

-- The fight -----------------------------------------------------------------------------------------------

local function nearestPlayer(f: Fight): (Player?, Vector3?)
	local best, bestPosition, bestScore = nil, nil, math.huge
	for _, player in session:ReadyPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root and root:IsA("BasePart") and player:GetAttribute("Life") == "Alive" then
			local position = root.Position
			local floor = Grid.CellAt(position)
			-- players on her floor first (she can reach them), then anyone
			local score = (position - Vector3.new(f.X, f.Y, f.Z)).Magnitude + (if floor == f.Arena.Floor then 0 else 1000)
			if score < bestScore then
				best, bestPosition, bestScore = player, position, score
			end
		end
	end
	return best, bestPosition
end

local function turnTowards(f: Fight, target: Vector3, dt: number)
	local flat = Vector3.new(target.X - f.X, 0, target.Z - f.Z)
	if flat.Magnitude < 0.5 then
		return
	end
	-- her front is -Z: the yaw that looks along flat
	local want = math.atan2(-flat.X, -flat.Z)
	local delta = (want - f.Yaw + math.pi) % (math.pi * 2) - math.pi
	local step = math.rad(f.T.TurnDegreesPerSecond) * dt
	f.Yaw += math.clamp(delta, -step, step)
end

local function slamPoint(f: Fight): Vector3
	local model = f.Model
	return if model then socket(model, "Slam").Position else Vector3.new(f.X, f.Y, f.Z)
end

local function attack(f: Fight)
	local model = f.Model :: Model
	local hitTime = (model:GetAttribute("HitTime") :: number?) or 0.8
	setActivity("Idle")
	model:SetAttribute("AttackAt", now())
	f.Busy = os.clock() + hitTime + 0.5
	f.NextAttack = os.clock() + Boss.ByPhase(f.T.AttackSeconds, f.Phase)
	task.delay(hitTime, function()
		if fight ~= f or f.State ~= "Fighting" or not f.CombatId then
			return
		end
		local at = slamPoint(f)
		local hit = 0
		for _, c in combat:All("Survivors") do
			local offset = c.Root.Position - at
			if c.State == "Alive" and Vector3.new(offset.X, 0, offset.Z).Magnitude <= f.T.SlamRadius and math.abs(offset.Y) < 9 then
				if combat:Damage(c.Id, f.T.SlamDamage, f.CombatId, "slammed") > 0 then
					hit += 1
				end
			end
		end
		rockBurst(at, 10)
		if hit > 0 then
			log:Debug("slam hit %d", hit)
		end
	end)
end

local function lay(f: Fight)
	local model = f.Model :: Model
	local layTime = (model:GetAttribute("LayTime") :: number?) or 1.4
	setActivity("LayEggs")
	f.Busy = os.clock() + layTime + 0.8
	f.NextLay = os.clock() + Boss.ByPhase(f.T.LaySeconds, f.Phase)
	task.delay(layTime, function()
		if fight ~= f or f.State ~= "Fighting" or not f.Model then
			return
		end
		local at = socket(f.Model, "Ovipositor").Position
		local count = 0
		for _ in f.Sacs do
			count += 1
		end
		for i = 1, Boss.ByPhase(f.T.SacsPerLay, f.Phase) do
			if count >= f.T.MaxSacs then
				break
			end
			local spread = if i == 1 then Vector3.zero else Vector3.new((i % 2 == 0 and 1 or -1) * 4, 0, 2)
			laySac(f, at + spread)
			count += 1
		end
		log:Info("%s laid eggs (%d sacs now)", f.Name, count)
	end)
end

local function stagger(f: Fight)
	setActivity("Stagger")
	f.Busy = os.clock() + f.T.StaggerSeconds
	f.NextAttack = math.max(f.NextAttack, f.Busy + 0.5)
	table.clear(f.Hits)
	if f.Model then
		f.Model:SetAttribute("StaggeredAt", now())
	end
	log:Info("%s staggered", f.Name)
end

local function tick(dt: number)
	local f = fight
	if not f or f.State ~= "Fighting" or not f.Model or not f.CombatId then
		return
	end
	local health, max = combat:HealthOf(f.CombatId)
	local phase = Boss.Phase(f.BossId, if max > 0 then health / max else 0)
	if phase > f.Phase then
		f.Phase = phase
		setActivity("Roar")
		f.Busy = os.clock() + f.T.RoarSeconds
		f.NextLay = math.min(f.NextLay, os.clock() + f.T.RoarSeconds + 1)
		announce("Danger", `THE {string.upper(f.Name)} SHRIEKS: SHE LAYS FASTER AND HITS HARDER`)
		log:Info("%s phase %d", f.Name, phase)
	end
	for id, sac in table.clone(f.Sacs) do
		if os.clock() >= sac.HatchAt then
			hatch(f, id)
		end
	end
	publish()
	if os.clock() < f.Busy then
		return
	end
	local target, position = nearestPlayer(f)
	if not target or not position then
		setActivity("Idle")
		return
	end
	turnTowards(f, position, dt)
	local count = 0
	for _ in f.Sacs do
		count += 1
	end
	if os.clock() >= f.NextLay and count < f.T.MaxSacs then
		f.Model:PivotTo(pivot(f))
		lay(f)
		return
	end
	local flat = Vector3.new(position.X - f.X, 0, position.Z - f.Z)
	if flat.Magnitude <= f.T.SlamReach and os.clock() >= f.NextAttack then
		local facing = (pivot(f)).LookVector
		if flat.Unit:Dot(Vector3.new(facing.X, 0, facing.Z).Unit) > 0.7 then
			f.Model:PivotTo(pivot(f))
			attack(f)
			return
		end
	end
	local wantX = math.clamp(position.X, f.Left, f.Right)
	local gap = wantX - f.X
	if math.abs(gap) > 1 and flat.Magnitude > f.T.SlamReach * 0.6 then
		local speed = Boss.ByPhase(f.T.MoveSpeed, f.Phase)
		f.X += math.clamp(gap, -speed * dt, speed * dt)
		setActivity("Walk")
	else
		setActivity("Idle")
	end
	f.Model:PivotTo(pivot(f))
end

local function cleanup(f: Fight)
	for id in table.clone(f.Sacs) do
		removeSac(f, id, "Gone")
	end
	for _, effect in f.Effects do
		effect:Destroy()
	end
	if f.CombatId then
		combat:Unregister(f.CombatId)
		f.CombatId = nil
	end
	if f.Model and f.Model.Parent then
		combat:Dissolve(f.Model)
	end
end

local function rise(f: Fight)
	if fight ~= f then
		return
	end
	local model, root = makeModel(f)
	f.Model = model
	f.Root = root
	f.State = "Rising"
	local finalPivot = pivot(f)
	model:PivotTo(finalPivot - Vector3.new(0, RISE_DEPTH, 0))
	model.Parent = holder()
	local id = combat:Register(model, {
		Kind = "Monster", Team = "Monsters", Health = f.Max, MonsterType = f.BossId, Root = root, KeepModel = true,
	})
	if not id then
		log:Warn("%s couldn't register", f.Name)
		model:Destroy()
		fight = nil
		publish(true)
		return
	end
	f.CombatId = id
	model.Name = `{f.BossId}_{id}`
	rockBurst(Vector3.new(f.X, f.Y, f.Z), 40)
	publish(true)
	announce("Danger", `THE {string.upper(f.Name)} BREAKS THROUGH! HIT HER GLOWING BELLY, BREAK HER EGG SACS`)
	local seconds = Boss.Tuning().RiseSeconds
	local started = os.clock()
	while fight == f and os.clock() - started < seconds do
		local k = math.clamp((os.clock() - started) / seconds, 0, 1)
		local eased = 1 - (1 - k) * (1 - k)
		model:PivotTo(finalPivot - Vector3.new(0, RISE_DEPTH * (1 - eased), 0))
		task.wait()
	end
	if fight ~= f then
		return
	end
	model:PivotTo(finalPivot)
	f.State = "Fighting"
	f.Busy = os.clock() + f.T.RoarSeconds
	f.NextAttack = f.Busy + 1
	f.NextLay = os.clock() + Boss.ByPhase(f.T.LaySeconds, 1) * 0.5
	publish(true)
	log:Info("%s is up (%d health, arena floor %d, columns %d to %d)", f.Name, f.Max, f.Arena.Floor, f.Arena.From, f.Arena.To)
end

function BossService:BeginFight(bossId: string): (boolean, string?)
	if fight then
		return false, `{fight.Name} is already here`
	end
	local entry = Config.Find("Bosses", bossId)
	local t = Boss.Fight(bossId)
	if not entry or not t then
		return false, `no fight for {bossId} yet`
	end
	local arena = Boss.Arena(grid:Bunker())
	if not arena then
		return false, "no open cell for her to break into"
	end
	local left, right = Boss.ArenaSpan(arena, t.ArenaMargin)
	local cell = Grid.CellPosition(arena.Floor, Boss.ArenaMiddle(arena))
	local players = math.max(#session:ReadyPlayers(), 1)
	local warningSeconds = Boss.Tuning().ArrivalWarningSeconds
	local f: Fight = {
		BossId = bossId,
		Name = entry.Name,
		T = t,
		Arena = arena,
		Left = left,
		Right = right,
		X = math.clamp(cell.X, left, right),
		Y = cell.Y,
		Z = cell.Z - 2, -- a little towards the back of the cell, so her front has room
		Yaw = math.pi, -- facing the front of the bunker
		Model = nil,
		Root = nil,
		CombatId = nil,
		Max = Boss.Health(bossId, players, threat:IsFirstRun()),
		Phase = 1,
		State = "Warning",
		ArriveAt = now() + warningSeconds,
		Busy = 0,
		NextAttack = 0,
		NextLay = 0,
		Sacs = {},
		Hits = {},
		LastHitBy = nil,
		PublishedAt = 0,
		Sent = "",
		Effects = {},
	}
	fight = f
	warning(f, warningSeconds)
	publish(true)
	announce("Danger", `THE {string.upper(entry.Name)} IS BREAKING THROUGH: {where(arena)} · {warningSeconds} S`)
	log:Info("%s breaks in at %s in %d s (%d health, %d players)", entry.Name, where(arena), warningSeconds, f.Max, players)
	BossService.Started:Fire(bossId)
	task.delay(warningSeconds, rise, f)
	return true, nil
end

function BossService:Active(): string?
	return if fight then fight.BossId else nil
end

-- Is this combatant the boss (not one of its egg sacs)? True for the killing blow too: Damaged
-- fires before Died.
function BossService:IsBoss(combatId: string): boolean
	return fight ~= nil and fight.CombatId == combatId
end

-- Was this combatant one of a boss's egg sacs (alive or not)?
function BossService:IsEggSac(combatId: string): boolean
	return sacIds[combatId] == true
end

local function onDied(id: string)
	local f = fight
	if not f then
		return
	end
	if f.Sacs[id] then
		removeSac(f, id, "Broken")
		log:Info("an egg sac was broken")
		return
	end
	if id ~= f.CombatId or f.State == "Dying" then
		return
	end
	f.State = "Dying"
	f.CombatId = nil -- CombatService unregistered her
	setActivity("Death")
	for sacId in table.clone(f.Sacs) do
		removeSac(f, sacId, "Withered")
	end
	publish(true)
	local killer: Player? = nil
	for _, player in Players:GetPlayers() do
		if `P{player.UserId}` == f.LastHitBy then
			killer = player
		end
	end
	announce("Info", `THE {string.upper(f.Name)} IS DEAD{if killer then ` · {string.upper(killer.DisplayName)} STRUCK THE LAST BLOW` else ""}`)
	log:Info("%s is dead (last blow: %s)", f.Name, if killer then killer.Name else "-")
	objectives:BossBeaten(f.BossId)
	BossService.Defeated:Fire(f.BossId, killer)
	task.delay(Boss.Tuning().DeathSeconds, function()
		if fight == f then
			cleanup(f)
			fight = nil
			publish(true)
		end
	end)
end

local function onDamaged(id: string, amount: number, source: string?, how: string?)
	local f = fight
	if not f or id ~= f.CombatId then
		return
	end
	if source then
		f.LastHitBy = source
	end
	if how == "weakpoint" and f.State == "Fighting" then
		table.insert(f.Hits, { At = os.clock(), Amount = amount })
		while #f.Hits > 0 and os.clock() - f.Hits[1].At > f.T.StaggerWindowSeconds do
			table.remove(f.Hits, 1)
		end
		if os.clock() >= f.Busy and Boss.Staggers(f.Hits, os.clock(), f.T.StaggerWindowSeconds, f.T.StaggerFraction * f.Max) then
			stagger(f)
		end
	end
	publish()
end

-- Armour, weak points and burning sacs (WeaponService's hit modifier).
local function hitModifier(target: any, point: Vector3?, how: string, player: Player): (number, string?)
	local f = fight
	if not f then
		return 1, nil
	end
	if target.Id == f.CombatId and f.Model then
		local weak = false
		if point then
			local tolerance = Boss.Tuning().WeakPointTolerance + (if how == "struck" or how == "smashed" then 2 else 0)
				+ (if how == "blast" then 3 else 0)
			for _, part in weakParts(f.Model) do
				if Boss.OnPart(point, part.CFrame, part.Size, tolerance) then
					weak = true
					break
				end
			end
		end
		local classValue = Modifiers.ClassValue(player:GetAttribute("Class") :: string?, "WeakPointMultiplier")
		return Boss.HitMultiplier(weak, classValue), if weak then "weakpoint" else nil
	end
	if f.Sacs[target.Id] and how == "burned" then
		return f.T.BurnMultiplier, nil
	end
	return 1, nil
end

-- DevTools ---------------------------------------------------------------------------------------------------

local function describe(): string
	local f = fight
	if not f then
		return "no boss fight"
	end
	local health, max = 0, f.Max
	if f.CombatId then
		health, max = combat:HealthOf(f.CombatId)
	end
	local count = 0
	for _ in f.Sacs do
		count += 1
	end
	return string.format("%s: %s, %d/%d health, phase %d, arena floor %d columns %d to %d (x %.0f to %.0f), at x %.1f, %d egg sacs, %s",
		f.Name, f.State, math.ceil(health), max, f.Phase, f.Arena.Floor, f.Arena.From, f.Arena.To, f.Left, f.Right, f.X, count,
		tostring(f.Model and f.Model:GetAttribute("Activity")))
end

local function registerCommands(dev: any)
	dev:Register("boss", {
		Description = "The boss fight now: state, health, phase, arena, egg sacs.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("boss.start", {
		Description = "Start a boss's fight now, outside its Surge (Studio testing).",
		Usage = "boss.start [BroodMother]",
		Run = function(_player, args): string?
			local ok, why = BossService:BeginFight(tostring(args[1] or "BroodMother"))
			return if ok then describe() else `can't: {why}`
		end,
	})
	dev:Register("boss.hurt", {
		Description = "Take health off the boss (weak: as belly hits, which can stagger her).",
		Usage = "boss.hurt <amount> [weak]",
		Run = function(player, args): string?
			local f = fight
			local amount = tonumber(args[1])
			if not f or not f.CombatId or not amount then
				return "usage: boss.hurt <amount> [weak] (during a fight)"
			end
			local source = if player then `P{player.UserId}` else nil
			combat:Damage(f.CombatId, amount, source, if args[2] == "weak" then "weakpoint" else "dev")
			return describe()
		end,
	})
	dev:Register("boss.lay", {
		Description = "The boss lays eggs now.",
		Run = function(): string?
			local f = fight
			if not f or f.State ~= "Fighting" then
				return "no boss fighting"
			end
			f.Busy = 0
			f.NextLay = 0
			return describe()
		end,
	})
	dev:Register("boss.end", {
		Description = "Take the boss away without beating her (cleanup).",
		Run = function(): string?
			local f = fight
			if not f then
				return "no boss fight"
			end
			cleanup(f)
			fight = nil
			publish(true)
			return "the boss is gone"
		end,
	})
end

-- Lifecycle ----------------------------------------------------------------------------------------------------

function BossService:Init(registry)
	clock = registry.CycleClock
	director = registry.RunDirector
	grid = registry.BunkerGrid
	session = registry.SessionService
	combat = registry.CombatService
	monsters = registry.MonsterService
	weapons = registry.WeaponService
	objectives = registry.ObjectiveService
	threat = registry.ThreatDirector
	collection = registry.ReplicationService:Collection("Boss")
	registerCommands(registry.DevService)
end

function BossService:Start()
	clock.SurgeStarted:Connect(function(kind: string, bossId: string?)
		if kind == "Boss" and bossId then
			local ok, why = BossService:BeginFight(bossId)
			if not ok then
				log:Warn("the %s Surge has no fight: %s", bossId, tostring(why))
			end
		end
	end)
	director.PhaseChanged:Connect(function(new: string)
		if new == "Ended" and fight then
			cleanup(fight)
			fight = nil
			publish(true)
		end
	end)
	combat.Died:Connect(onDied)
	combat.Damaged:Connect(onDamaged)
	weapons:SetHitModifier(hitModifier)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		local step = Boss.Tuning().TickSeconds
		if acc >= step then
			local elapsed = math.min(acc, 0.5)
			acc = 0
			local ok, err = pcall(tick, elapsed)
			if not ok then
				log:Warn("tick: %s", tostring(err))
			end
		end
	end)
	log:Info("boss fights ready")
end

return BossService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C8"><Properties><string name="Name">BreachService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BreachService: where monsters break in, the warning, and the spawns (bible Section 10).
	Run place only; Prompt 12.

	Breach points (Section 10; Section 6: every dug cell next to rock is a way in)
	* every room's vent (BunkerKit's Kit_Vent; the Shaft and the Blast Door have none);
	* every dug cell next to rock, on any floor (Landon, 2026-11-08: every tunnel touching rock
	  counts, not only the deepest band's);
	* cave openings and living nests in dug cells (DigService adds them, Prompt 14; the caves
	  behind the openings come with Prompt 17), and the Blast Door's surface threats with raids
	  (Prompt 16).
	Each point has a weight: DarkRoomWeight in a dark room (Section 6: dark rooms spawn monsters
	twice as often), BarricadeWeight when barricaded (its Barricaded attribute; the Engineer's
	barricades come with Prompt 20).

	Open(pointId, groups, tag)
	* BreachWarningSeconds of warning (Section 10: cracks, dust and a rumble give 10 seconds):
	  dust pours from the point and a red lamp pulses there; every player gets the BreachWarning
	  remote (the HUD's alert, the mini-map's marker) and the Breaches collection carries it for
	  the Command View's Threat overlay.
	* Then the monsters come out one by one (SpawnSpacingSeconds) through MonsterService.

	API:
		BreachService:Points(): { { Id, Kind, RoomId?, Floor, Column, Weight, Dark } }
		BreachService:Pick(rng): point?                    -- weighted
		BreachService:Open(pointId, groups, tag?): boolean
		BreachService:SetExtraPoint(id, point?)            -- Prompt 14: cave openings and nests
		BreachService.Opened: Signal<string, string?>      -- point id, tag (after the warning)
	Dev: breaches, breach.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)
local Threat = require(Shared.Rules.Threat)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("BreachService")

local BreachService = {
	Name = "BreachService",
	Dependencies = { "BunkerGrid", "PowerService", "MonsterService", "SessionService", "ReplicationService", "DevService" },
	Opened = Signal.new() :: Signal.Signal<string, string?>,
}

export type Point = {
	Id: string, -- "V:<roomId>" (a vent), "D:<floor>,<column>" (a dug cell at the rock), or one another service adds
	Kind: string, -- "Vent", "Rock", or another service's ("Cave", "Nest": DigService, Prompt 14)
	RoomId: string?,
	Floor: number,
	Column: number,
	Weight: number,
	Dark: boolean,
	At: CFrame, -- where monsters come out, on the floor, facing into the bunker
	Source: Vector3, -- the vent or the rock face, for the dust
}

local NO_VENT: { [string]: boolean } = { Shaft = true, BlastDoor = true }

local grid: any = nil
local power: any = nil
local monsters: any = nil
local session: any = nil
local dev: any = nil
local collection: any = nil

local warnings: { [string]: { EndsAt: number, Tag: string? } } = {}
local extra: { [string]: Point } = {} -- points other services add (Prompt 14: cave openings, nests)

local function threatTuning(): { [string]: any }
	return Config.Get("Tuning", "Threat")
end

local function ventOf(room: any): (Vector3?, CFrame?)
	local model = grid:RoomModel(room.Id)
	if not model then
		return nil, nil
	end
	local vent = model:FindFirstChild("Vent", true)
	local socket = BunkerKit.Socket(model, "Vent")
	local position = if socket then socket.Position elseif vent and vent:IsA("BasePart") then vent.Position
		elseif vent and vent:IsA("Model") then (vent:GetBoundingBox()).Position else nil
	return position, socket
end

local function roomPoint(room: any, dark: boolean): Point
	local cell = Grid.CellPosition(room.Floor, room.Column)
	local vent = ventOf(room)
	local source = vent or (cell + Vector3.new(0, 6, -6))
	-- monsters drop from the vent to the floor in front of it, a little into the room
	local out = Vector3.new(source.X, cell.Y + 0.5, math.min(source.Z + 4, cell.Z + 4))
	local t = threatTuning()
	local weight = if dark then t.DarkRoomWeight else 1
	return {
		Id = `V:{room.Id}`,
		Kind = "Vent",
		RoomId = room.Id,
		Floor = room.Floor,
		Column = room.Column,
		Weight = weight,
		Dark = dark,
		At = CFrame.lookAt(out, out + Vector3.new(0, 0, 1)),
		Source = source,
	}
end

-- Every dug cell next to rock, on any floor (Landon's answer to the Prompt 12 question: every
-- tunnel touching rock is a way in, not only the deepest band's).
local function rockPoints(): { Point }
	local list: { Point } = {}
	local t = Grid.Tuning()
	for floor = t.FloorMin, t.FloorMax do
		for column = t.ColumnMin, t.ColumnMax do
			local state = grid:State(floor, column)
			if state == "Dug" then
				local rockSide: number? = nil
				for _, dc in { -1, 1 } do
					if Grid.OnGrid(floor, column + dc) and grid:State(floor, column + dc) == "Rock" then
						rockSide = dc
					end
				end
				local below = Grid.OnGrid(floor + 1, column) and grid:State(floor + 1, column) == "Rock"
				if rockSide or below then
					local cell = Grid.CellPosition(floor, column)
					local side = rockSide or 0
					local source = cell + Vector3.new(side * (Grid.Pitch().X / 2 - 1), 3, 0)
					local out = cell + Vector3.new(side * (Grid.Pitch().X / 2 - 5), 0.5, 4)
					table.insert(list, {
						Id = `D:{floor},{column}`,
						Kind = "Rock",
						RoomId = nil,
						Floor = floor,
						Column = column,
						Weight = 1,
						Dark = false,
						At = CFrame.lookAt(out, out + Vector3.new(-side, 0, 1)),
						Source = source,
					})
				end
			end
		end
	end
	return list
end

function BreachService:Points(): { Point }
	local list: { Point } = {}
	for _, room in grid:Rooms() do
		if not NO_VENT[room.Type] then
			local point = roomPoint(room, power:IsDark(room.Id))
			local model = grid:RoomModel(room.Id)
			if model and model:GetAttribute("Barricaded") then
				point.Weight *= threatTuning().BarricadeWeight
			end
			table.insert(list, point)
		end
	end
	for _, point in rockPoints() do
		table.insert(list, point)
	end
	for _, point in extra do
		table.insert(list, point)
	end
	return list
end

-- A breach point another service owns (Prompt 14: a cave opening, a living nest); nil removes it.
function BreachService:SetExtraPoint(id: string, point: Point?)
	extra[id] = point
end

function BreachService:Pick(rng: Random, exclude: { [string]: boolean }?): Point?
	local candidates = {}
	for _, point in BreachService:Points() do
		if not (exclude and exclude[point.Id]) then
			table.insert(candidates, point)
		end
	end
	local picked = Threat.Pick(candidates :: any, rng)
	return picked :: any
end

local function pointById(id: string): Point?
	for _, point in BreachService:Points() do
		if point.Id == id then
			return point
		end
	end
	return nil
end

local function placeName(point: Point): string
	if point.RoomId then
		local room = grid:Room(point.RoomId)
		if room then
			return string.upper(Config.Get("Rooms", room.Type).Name)
		end
	end
	if point.Kind == "Cave" then
		return `THE CAVE OPENING, FLOOR {point.Floor}`
	elseif point.Kind == "Nest" then
		return `THE NEST, FLOOR {point.Floor}`
	end
	return `THE ROCK, FLOOR {point.Floor}`
end

-- the warning in the world: dust from the vent or the rock, and a pulsing red lamp
local function warningEffect(point: Point, seconds: number)
	local part = Instance.new("Part")
	part.Name = `Breach_{point.Id}`
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(4, 1, 1)
	part.Position = point.Source
	local dust = Instance.new("ParticleEmitter")
	dust.Color = ColorSequence.new(Color3.fromRGB(150, 140, 128))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 2.6) })
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(1.2, 2.2)
	dust.Speed = NumberRange.new(2, 5)
	dust.SpreadAngle = Vector2.new(35, 35)
	dust.Acceleration = Vector3.new(0, -4, 0)
	dust.Rate = 26
	dust.Parent = part
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(232, 80, 59)
	light.Range = 16
	light.Brightness = 2
	light.Parent = part
	part.Parent = workspace:FindFirstChild("Monsters") or workspace
	task.spawn(function()
		local endsAt = os.clock() + seconds
		while os.clock() < endsAt and part.Parent do
			light.Brightness = if light.Brightness > 1 then 0.4 else 2.6
			task.wait(0.45)
		end
		dust.Rate = 60 -- the burst as they come out
		task.wait(1.2)
		part:Destroy()
	end)
end

local function publish(point: Point)
	local warning = warnings[point.Id]
	if warning then
		collection:Set(point.Id, {
			Floor = point.Floor,
			Column = point.Column,
			RoomId = point.RoomId,
			EndsAt = warning.EndsAt,
		})
	else
		collection:Remove(point.Id)
	end
end

function BreachService:Open(pointId: string, groups: { Threat.Group }, tag: string?): boolean
	local point = pointById(pointId)
	if not point or #groups == 0 then
		return false
	end
	local seconds = threatTuning().BreachWarningSeconds
	local endsAt = workspace:GetServerTimeNow() + seconds
	warnings[point.Id] = { EndsAt = endsAt, Tag = tag }
	publish(point)
	warningEffect(point, seconds)
	local total = 0
	for _, group in groups do
		total += group.Count
	end
	for _, player in session:ReadyPlayers() do
		Remotes.FireClient("BreachWarning", player, point.Floor, point.Column, seconds, placeName(point), total, point.RoomId)
	end
	log:Info("breach at %s in %d s: %d monsters (%s)", point.Id, seconds, total, tag or "-")
	task.delay(seconds, function()
		warnings[point.Id] = nil
		publish(point)
		BreachService.Opened:Fire(point.Id, tag)
		local spacing = threatTuning().SpawnSpacingSeconds
		local n = 0
		for _, group in groups do
			for _ = 1, group.Count do
				local offset = CFrame.new(((n % 3) - 1) * 2.2, 0, -math.floor(n / 3) * 0.6)
				monsters:Spawn(group.Type, point.At * offset, tag)
				n += 1
				task.wait(spacing)
			end
		end
	end)
	return true
end

function BreachService:Warnings(): number
	local n = 0
	for _ in warnings do
		n += 1
	end
	return n
end

function BreachService:Init(registry)
	grid = registry.BunkerGrid
	power = registry.PowerService
	monsters = registry.MonsterService
	session = registry.SessionService
	dev = registry.DevService
	collection = registry.ReplicationService:Collection("Breaches")

	dev:Register("breaches", {
		Description = "The breach points and their weights (Prompt 12).",
		Usage = "breaches",
		Run = function(): string?
			local lines = {}
			for _, point in BreachService:Points() do
				table.insert(lines, `{point.Id} {point.Kind} floor {point.Floor} weight {point.Weight}{if point.Dark then " (dark)" else ""}`)
			end
			return if #lines > 0 then table.concat(lines, "\n") else "no breach points"
		end,
	})
	dev:Register("breach", {
		Description = "Open a breach now: a point (or a weighted pick), a monster type and how many.",
		Usage = "breach [pointId|any] [Type] [count]",
		Run = function(_player, args): string?
			local rng = Random.new()
			local pointId = tostring(args[1] or "any")
			if pointId == "any" then
				local point = BreachService:Pick(rng)
				if not point then
					return "no breach points"
				end
				pointId = point.Id
			end
			local monsterType = tostring(args[2] or "BurrowTick")
			if not Config.Find("Monsters", monsterType) then
				return `no monster {monsterType}`
			end
			local count = math.clamp(math.floor(tonumber(args[3]) or 3), 1, 25)
			local ok = BreachService:Open(pointId, { { Type = monsterType, Count = count } }, "Dev")
			return if ok then `breach at {pointId}: {count} {monsterType} in {threatTuning().BreachWarningSeconds} s` else `no point {pointId}`
		end,
	})
end

function BreachService:Start()
	log:Info("breach points ready")
end

return BreachService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C9"><Properties><string name="Name">BuildService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BuildService: construction, upgrades, merges and teardown (bible Sections 6 and 8). Run
	place only.

	* Proposing: a player proposes from the Command View (the Propose remote).
	  Rules.Construction.Plan checks it against the bunker, the unlocks, the stockpile, Lab
	  research, and the cells already held by open votes and construction sites. Then
	  VoteService puts it to the team (in a solo run it applies at once).
	* When the vote passes, it is planned again (anything may have changed meanwhile) and paid
	  for (EconomyService), and then:
	  * Build: a construction site goes on the cell. It takes 20 s a cell
	    (Tuning.Rooms.BuildSecondsPerCell), 25% faster for every player standing in it
	    (HelperBuildSpeed; residents join with Prompt 10). When it's done the room is placed
	    (BunkerGrid).
	  * Upgrade: the room's level goes up at once (Landon, Nov 8, 2026). On a difficulty with
	    UpgradesTakeTime (Nightmare) it becomes a construction site over the room instead, as
	    long as building would take; the room keeps working at its old level until it is done.
	  * Merge: the two rooms become one at once.
	  * TearDown: the room goes at once and its cells are open cells again. Part of what it cost
	    comes back (Landon, Nov 8, 2026): the plan's Refund, Tuning.Rooms.TearDownRefund of every
	    level's cost so far (Rules.Construction.Refund), up to the stockpile's caps.
	* Sites replicate in the Sites collection: id -> { Kind ("Build" or "Upgrade"), Type, Floor,
	  Column, Span, Level (an upgrade's new level), RoomId (an upgrade's room), Progress (0 to
	  1), Helpers, Seconds }. In the world they stand in workspace.Bunker.Sites (BunkerKit.Site).
	* Rooms won from blueprint drafts and cryo pods: Unlock(roomType) (Prompts 17 and 19). They
	  replicate in the Unlocked collection (room type -> true) for the Command View's menu.
	* Repairs (Prompt 13; Section 6: at 0 HP a room is wrecked and stops until repaired with the
	  Welder; residents slowly repair the room they work in; Section 11: Smarts is repair speed):
	  * the Welder: a player using it (WeaponService.ToolTick) repairs the first damaged room in
	    front of them within WelderReach, WelderPerSecond (RepairSpeed: the Engineer twice as
	    fast). Their Welding attribute names the room (or "" when nothing there needs it);
	  * residents at work in their own room (body there, Activity Work) repair it
	    ResidentRepairPerSecond times Smarts over ResidentSmartsBase, every second;
	  * a wrecked room works again at Tuning.Repairs.RepairedAt of its HP (Rules.Bunker).
	  The team hears when a room is wrecked (not the Reactor Core: its meltdown says enough) and
	  when it works again.

	API:
		BuildService:Propose(player, proposal): (boolean, string?)
		BuildService:Unlock(roomType), :Unlocked(): { [string]: boolean }
		BuildService:SetCellCheck(fn(floor, column) -> (ok, why?))  -- Prompt 14: what a dug cell holds
		BuildService:Reserved(exceptVoteId?): { [string]: boolean }  -- votes' and sites' cells
		BuildService:FinishSite(id): boolean                           -- DevTools
		BuildService:Repair(roomId, amount, how, player?): number      -- HP it added (fractions carry)
		BuildService.Proposed: Signal<Player, string>   -- proposer, action (first-run objective 2)
		BuildService.Built: Signal<string, string>      -- room id, action (Build, Upgrade, Merge)
		BuildService.TornDown: Signal<string, string>   -- room id, room type
		BuildService.Repaired: Signal<string, number, string, Player?> -- room id, HP, "Welder" or "Residents", who
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Bunker = require(Shared.Rules.Bunker)
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Disasters = require(Shared.Rules.Disasters)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("BuildService")

local BuildService = {
	Name = "BuildService",
	Dependencies = {
		"BunkerGrid", "EconomyService", "VoteService", "SessionService", "RunDirector", "ReplicationService",
		"WeaponService", "CombatService", "ResidentService", "DevService",
	},
	Proposed = Signal.new() :: Signal.Signal<Player, string>,
	Built = Signal.new() :: Signal.Signal<string, string>,
	TornDown = Signal.new() :: Signal.Signal<string, string>,
	Repaired = Signal.new() :: Signal.Signal<string, number, string, Player?>,
}

type Site = {
	Id: string,
	Kind: "Build" | "Upgrade",
	RoomId: string?, -- Upgrade: the room
	Level: number?, -- Upgrade: its new level
	Type: string,
	Floor: number,
	Column: number,
	Span: number,
	Cells: { string },
	Seconds: number,
	Done: number, -- seconds of work done (helpers make it grow faster)
	Helpers: number,
	Sent: number, -- the progress last replicated
	Model: Model?,
}

local grid: any = nil
local economy: any = nil
local votes: any = nil
local session: any = nil
local director: any = nil
local sitesCollection: any = nil
local unlockedCollection: any = nil
local sites: { [string]: Site } = {}
local siteCount = 0
local unlocked: { [string]: boolean } = {}
local weapons: any = nil
local combat: any = nil
local residents: any = nil
local repairCarry: { [string]: number } = {} -- room id -> HP of repair not yet whole
local repairing: { [string]: { Welders: number, Residents: number } } = {} -- this second's repairs (DevTools)

local function roomName(roomType: string): string
	return Config.Get("Rooms", roomType).Name
end

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function announce(text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), "Info", text)
end

-- "The stockpile is 70 Scrap short." -> "the stockpile is 70 Scrap short" (the banner adds FAILED:)
local function clause(text: string): string
	local trimmed = string.gsub(text, "%.$", "")
	return (string.gsub(trimmed, "^%u", string.lower))
end

function BuildService:Reserved(exceptVoteId: string?): { [string]: boolean }
	local cells = votes:Reserved(exceptVoteId)
	for _, site in sites do
		for _, key in site.Cells do
			cells[key] = true
		end
	end
	return cells
end

local function context(exceptVoteId: string?): Construction.Context
	return {
		Era = table.find(Config.Ids("Eras"), RunState.Get("Era") or "") or 1,
		Deepest = grid:DeepestFloor(),
		Unlocked = unlocked,
		Stock = economy:Stock(),
		Research = economy:Research(),
		Reserved = BuildService:Reserved(exceptVoteId),
	}
end

-- Sites ---------------------------------------------------------------------------------------------

local function publishSite(site: Site)
	local progress = math.floor(math.min(1, site.Done / site.Seconds) * 100) / 100
	site.Sent = progress
	sitesCollection:Set(site.Id, {
		Kind = site.Kind,
		RoomId = site.RoomId,
		Level = site.Level,
		Type = site.Type,
		Floor = site.Floor,
		Column = site.Column,
		Span = site.Span,
		Progress = progress,
		Helpers = site.Helpers,
		Seconds = site.Seconds,
	})
end

local function sitesFolder(): Instance?
	local root = grid:Root()
	if not root then
		return nil
	end
	local folder = root:FindFirstChild("Sites")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Sites"
		folder.Parent = root
	end
	return folder
end

local function startSite(plan: Construction.Plan)
	siteCount += 1
	local upgrade = plan.Action == "Upgrade"
	local site: Site = {
		Id = `S{siteCount}`,
		Kind = if upgrade then "Upgrade" else "Build",
		RoomId = if upgrade then plan.RoomId else nil,
		Level = if upgrade then plan.Level else nil,
		Type = plan.RoomType,
		Floor = plan.Floor,
		Column = plan.Column,
		Span = plan.Span,
		Cells = Construction.Cells(plan),
		Seconds = Construction.Seconds(plan.Span),
		Done = 0,
		Helpers = 0,
		Sent = -1,
	}
	local folder = sitesFolder()
	if folder then
		site.Model = BunkerKit.Site(folder, site.Id, site.Type, site.Floor, site.Column, site.Span, upgrade)
	end
	sites[site.Id] = site
	publishSite(site)
	if upgrade then
		log:Info("%s: upgrading %s to level %d (%d s)", site.Id, tostring(site.RoomId), site.Level or 0, site.Seconds)
		announce(`UPGRADING THE {string.upper(roomName(site.Type))}: STAND IN IT TO HELP`)
	else
		log:Info("%s: building a %s at %s (%d s)", site.Id, site.Type, Grid.Key(site.Floor, site.Column), site.Seconds)
		announce(`BUILDING A {string.upper(roomName(site.Type))}: STAND IN IT TO HELP`)
	end
end

local function upgradeNow(roomId: string, roomType: string, level: number)
	local ok, err = grid:SetLevel(roomId, level)
	if ok then
		announce(`{string.upper(roomName(roomType))} UPGRADED TO LEVEL {level}`)
		BuildService.Built:Fire(roomId, "Upgrade")
	else
		log:Warn("upgrade of %s failed: %s", roomId, tostring(err))
	end
end

local function finishSite(site: Site)
	sites[site.Id] = nil
	sitesCollection:Remove(site.Id)
	if site.Model then
		site.Model:Destroy()
	end
	if site.Kind == "Upgrade" then
		log:Info("%s done: %s is level %d", site.Id, tostring(site.RoomId), site.Level or 0)
		upgradeNow(site.RoomId :: string, site.Type, site.Level :: number)
		return
	end
	local roomId, why = grid:PlaceRoom(site.Type, site.Floor, site.Column, site.Span)
	if roomId then
		log:Info("%s done: %s is %s", site.Id, site.Type, roomId)
		announce(`{string.upper(roomName(site.Type))} BUILT`)
		BuildService.Built:Fire(roomId, "Build")
	else
		log:Warn("%s couldn't place its %s: %s", site.Id, site.Type, tostring(why))
	end
end

function BuildService:FinishSite(id: string): boolean
	local site = sites[id]
	if not site then
		return false
	end
	finishSite(site)
	return true
end

-- Players standing in a site's cells (alive).
local function helpersAt(site: Site): number
	local n = 0
	for _, player in session:ReadyPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			local floor, column = Grid.CellAt(root.Position)
			if floor == site.Floor and column and column >= site.Column and column < site.Column + site.Span then
				n += 1
			end
		end
	end
	return n
end

local function tick(dt: number)
	for _, site in sites do
		site.Helpers = helpersAt(site)
		site.Done += dt * Construction.Rate(site.Helpers)
		if site.Done >= site.Seconds then
			finishSite(site)
		else
			local progress = site.Done / site.Seconds
			if site.Model then
				BunkerKit.SetSiteProgress(site.Model, progress)
			end
			local current = sitesCollection:Get(site.Id)
			if progress - site.Sent >= 0.01 or (current and current.Helpers ~= site.Helpers) then
				publishSite(site)
			end
		end
	end
end

-- Applying a passed proposal ------------------------------------------------------------------------

local function apply(plan: Construction.Plan)
	local paid, why = economy:Spend(plan.Costs, plan.Label)
	if not paid then
		log:Warn("%s passed but couldn't be paid: %s", plan.Label, tostring(why))
		announce(`{plan.Label}: {string.upper(why or "can't pay")}`)
		return
	end
	if plan.Action == "Build" then
		startSite(plan)
	elseif plan.Action == "Upgrade" then
		local difficulty = Config.Find("Difficulties", director:Difficulty())
		if difficulty and difficulty.UpgradesTakeTime then
			startSite(plan)
		else
			upgradeNow(plan.RoomId :: string, plan.RoomType, plan.Level :: number)
		end
	elseif plan.Action == "Merge" then
		local merged, err = grid:MergeRooms(plan.RoomId :: string, plan.Other :: string)
		if merged then
			announce(`{string.upper(roomName(plan.RoomType))} MERGED`)
			BuildService.Built:Fire(merged, "Merge")
		else
			log:Warn("merge of %s and %s failed: %s", tostring(plan.RoomId), tostring(plan.Other), tostring(err))
		end
	elseif plan.Action == "TearDown" then
		local roomId = plan.RoomId :: string
		local ok, err = grid:RemoveRoom(roomId)
		if ok then
			local back = {}
			for _, id in Config.Ids("Resources") do
				local amount = plan.Refund and plan.Refund[id]
				if amount and amount > 0 then
					local added = economy:Add(id, amount, `refund for {plan.Label}`)
					if added > 0 then
						back[id] = added
					end
				end
			end
			announce(if next(back) then `{string.upper(roomName(plan.RoomType))} TORN DOWN: {Construction.CostText(back)} BACK`
				else `{string.upper(roomName(plan.RoomType))} TORN DOWN`)
			BuildService.TornDown:Fire(roomId, plan.RoomType)
		else
			log:Warn("teardown of %s failed: %s", roomId, tostring(err))
		end
	end
end

-- Proposals ------------------------------------------------------------------------------------------

-- The ghost outline's label in the Command View: "KITCHEN?", "LEVEL 2?", "MERGE?", "TEAR DOWN?".
local function ghostLabel(plan: Construction.Plan): string
	if plan.Action == "Build" then
		return `{string.upper(roomName(plan.RoomType))}?`
	elseif plan.Action == "Upgrade" then
		return `LEVEL {plan.Level}?`
	elseif plan.Action == "Merge" then
		return "MERGE?"
	end
	return "TEAR DOWN?"
end

-- Something in a dug cell that has to be dealt with before a room goes on it (Prompt 14: a nest, a
-- cache, a cave opening; DigService sets the check).
local cellCheck: ((floor: number, column: number) -> (boolean, string?))? = nil

function BuildService:SetCellCheck(fn: ((floor: number, column: number) -> (boolean, string?))?)
	cellCheck = fn
end

local function cellsClear(plan: Construction.Plan): (boolean, string?)
	local check = cellCheck
	if not check or plan.Action ~= "Build" then
		return true, nil
	end
	for _, key in Construction.Cells(plan) do
		local floor, column = Grid.Parse(key)
		if floor and column then
			local ok, why = check(floor, column)
			if not ok then
				return false, why
			end
		end
	end
	return true, nil
end

function BuildService:Propose(player: Player, proposal: Construction.Proposal): (boolean, string?)
	local ok, why = votes:CanPropose(player)
	if not ok then
		return false, why
	end
	local plan, reason = Construction.Plan(grid:Bunker(), proposal, context(nil))
	if not plan then
		return false, reason
	end
	local clear, blocked = cellsClear(plan)
	if not clear then
		return false, blocked
	end
	local voteId: string? = nil
	local latest: Construction.Plan = plan
	local id, err = votes:Open({
		Kind = "Build",
		Proposer = player,
		Title = plan.Label,
		Costs = plan.Costs,
		Refund = plan.Refund,
		Subject = { Floor = plan.Floor, Column = plan.Column, Span = plan.Span, Label = ghostLabel(plan) },
		Cells = Construction.Cells(plan),
		Check = function(): (boolean, string?)
			local again, why2 = Construction.Plan(grid:Bunker(), proposal, context(voteId))
			if again then
				local clear2, blocked2 = cellsClear(again)
				if not clear2 then
					return false, blocked2
				end
				latest = again
				return true, nil
			end
			return false, clause(why2 or "it can't be done any more")
		end,
		OnPass = function()
			apply(latest)
		end,
	})
	if not id then
		return false, err
	end
	voteId = id
	log:Info("%s proposed %s (%s)", player.Name, plan.Label, id)
	BuildService.Proposed:Fire(player, plan.Action)
	return true, nil
end

function BuildService:Unlock(roomType: string)
	assert(Config.Find("Rooms", roomType), `BuildService: no room type {roomType}`)
	unlocked[roomType] = true
	unlockedCollection:Set(roomType, true)
end

function BuildService:Unlocked(): { [string]: boolean }
	return table.clone(unlocked)
end

-- Lifecycle ------------------------------------------------------------------------------------------

local function describeSites(): string
	local lines = {}
	for id, site in sites do
		table.insert(lines, string.format("%s %s %s at %s: %.0f%% (%d helping, %.1f of %d s)", id, site.Kind, site.Type,
			Grid.Key(site.Floor, site.Column), math.min(1, site.Done / site.Seconds) * 100, site.Helpers, site.Done, site.Seconds))
	end
	table.sort(lines)
	return if #lines > 0 then table.concat(lines, "\n") else "no construction sites"
end

-- Repairs (Prompt 13) -----------------------------------------------------------------------------

function BuildService:Repair(roomId: string, amount: number, how: string, player: Player?): number
	local room = grid:Room(roomId)
	if not room or room.HP >= room.MaxHP or amount <= 0 then
		repairCarry[roomId] = nil
		return 0
	end
	local carry = (repairCarry[roomId] or 0) + amount
	local whole = math.floor(carry)
	repairCarry[roomId] = carry - whole
	if whole < 1 then
		return 0
	end
	local before = room.HP
	local hp = grid:SetHP(roomId, before + whole) or before
	local done = hp - before
	if done > 0 then
		BuildService.Repaired:Fire(roomId, done, how, player)
	end
	return done
end

local function unitAt(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

-- The room a Welder points at: the first damaged room along the player's facing within
-- WelderReach (their own room first), else the first room there (to say it needs nothing).
local function weldTarget(at: CFrame): (string?, boolean)
	local reach = Disasters.Repairs().WelderReach
	local first: string? = nil
	for _, d in { 0, 3, 6, reach } do
		local unit = unitAt(at.Position + at.LookVector * d)
		local room = if unit then grid:Room(unit) else nil
		if room then
			first = first or room.Id
			if room.HP < room.MaxHP then
				return room.Id, true
			end
		end
	end
	return first, false
end

local function onToolTick(player: Player, tool: string, at: CFrame, dt: number)
	if tool ~= "Welder" then
		return
	end
	local roomId, needs = weldTarget(at)
	player:SetAttribute("Welding", if roomId and needs then roomId else "")
	if roomId and needs then
		local speed = Modifiers.ClassValue(player:GetAttribute("Class") :: string?, "RepairSpeed") or 1
		BuildService:Repair(roomId, Disasters.WelderPerSecond(speed) * dt, "Welder", player)
		local entry = repairing[roomId] or { Welders = 0, Residents = 0 }
		entry.Welders += 1
		repairing[roomId] = entry
	end
end

-- Residents repair the room they work in while they are at work in it (Section 6).
local function residentRepairs(dt: number)
	local rates: { [string]: number } = {}
	local counts: { [string]: number } = {}
	for _, c in combat:All("Survivors") do
		if c.Kind == "Resident" and c.State == "Alive" and c.ResidentId and c.Model:GetAttribute("Activity") == "Work" then
			local resident = residents:Get(c.ResidentId)
			if resident and resident.State == "Alive" and resident.Job and unitAt(c.Root.Position) == resident.Job then
				rates[resident.Job] = (rates[resident.Job] or 0) + Disasters.ResidentRepairPerSecond(resident.Stats.Smarts or 0)
				counts[resident.Job] = (counts[resident.Job] or 0) + 1
			end
		end
	end
	for roomId, rate in rates do
		local room = grid:Room(roomId)
		if room and room.HP < room.MaxHP then
			BuildService:Repair(roomId, rate * dt, "Residents")
			local entry = repairing[roomId] or { Welders = 0, Residents = 0 }
			entry.Residents = counts[roomId]
			repairing[roomId] = entry
		end
	end
end

local function describeRepairs(): string
	local lines = {}
	for _, room in grid:Rooms() do
		if room.HP < room.MaxHP or room.Wrecked then
			local entry = repairing[room.Id]
			table.insert(lines, string.format("%s %s: %d/%d HP%s; works again at %d%s", room.Id, room.Type, room.HP, room.MaxHP,
				if room.Wrecked then " WRECKED" else "", Bunker.RepairedAt(room.MaxHP),
				if entry then `; last second {entry.Welders} welder ticks, {entry.Residents} residents` else ""))
		end
	end
	return if #lines > 0 then table.concat(lines, "\n") else "every room is at full HP"
end

function BuildService:Init(registry)
	grid = registry.BunkerGrid
	weapons = registry.WeaponService
	combat = registry.CombatService
	residents = registry.ResidentService
	economy = registry.EconomyService
	votes = registry.VoteService
	session = registry.SessionService
	director = registry.RunDirector
	sitesCollection = registry.ReplicationService:Collection("Sites")
	unlockedCollection = registry.ReplicationService:Collection("Unlocked")
	Remotes.OnServer("Propose", function(player: Player, action: string, floor: number, column: number, detail: string)
		local proposal: Construction.Proposal = {
			Action = action :: Construction.Action,
			Floor = floor,
			Column = column,
			RoomType = if action == "Build" then detail else nil,
			Other = if action == "Merge" then detail else nil,
		}
		local ok, why = BuildService:Propose(player, proposal)
		if not ok and why then
			alert(player, "Warning", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("build", {
		Description = "Propose construction as you would from the Command View.",
		Usage = "build <Build|Upgrade|Merge|TearDown> <floor> <column> [roomType|otherRoomId]",
		Run = function(caller: Player?, args): string?
			-- from Studio's server tools there's no caller: act as the first player in the run
			local player = caller or session:ReadyPlayers()[1]
			if not player then
				return "nobody is in the run to propose as"
			end
			local action, floor, column = tostring(args[1] or ""), tonumber(args[2]), tonumber(args[3])
			if not table.find({ "Build", "Upgrade", "Merge", "TearDown" }, action) or not floor or not column then
				return "usage: build <Build|Upgrade|Merge|TearDown> <floor> <column> [roomType|otherRoomId]"
			end
			local detail = if args[4] ~= nil then tostring(args[4]) else nil
			local ok, why = BuildService:Propose(player, {
				Action = action :: Construction.Action,
				Floor = floor,
				Column = column,
				RoomType = if action == "Build" then detail else nil,
				Other = if action == "Merge" then detail else nil,
			})
			return if ok then `proposed\n{describeSites()}` else `refused: {why}`
		end,
	})
	dev:Register("sites", {
		Description = "Construction sites and their progress.",
		Usage = "sites",
		Run = function(): string?
			return describeSites()
		end,
	})
	dev:Register("site.finish", {
		Description = "Finish a construction site now (or every site).",
		Usage = "site.finish [id]",
		Run = function(_player: Player, args): string?
			local id = if args[1] ~= nil then tostring(args[1]) else nil
			local done = 0
			for siteId in table.clone(sites) do
				if id == nil or siteId == id then
					if BuildService:FinishSite(siteId) then
						done += 1
					end
				end
			end
			return `finished {done} site(s)\n{describeSites()}`
		end,
	})
	dev:Register("repairs", {
		Description = "Damaged and wrecked rooms, and who is repairing them (Prompt 13).",
		Usage = "repairs",
		Run = function(): string?
			return describeRepairs()
		end,
	})
	dev:Register("repair", {
		Description = "Repair a room by an amount of HP (or fully), as a Welder would.",
		Usage = "repair <roomId> [hp]",
		Run = function(_player: Player, args): string?
			local id = tostring(args[1] or "")
			local room = grid:Room(id)
			if not room then
				return "usage: repair <roomId> [hp] (see grid.rooms)"
			end
			BuildService:Repair(id, tonumber(args[2]) or (room.MaxHP - room.HP), "Welder", nil)
			return describeRepairs()
		end,
	})
	dev:Register("unlock", {
		Description = "Unlock a room type as if a blueprint draft had won it.",
		Usage = "unlock <roomType>",
		Run = function(_player: Player, args): string?
			local roomType = tostring(args[1] or "")
			if not Config.Find("Rooms", roomType) then
				return "usage: unlock <roomType>"
			end
			BuildService:Unlock(roomType)
			return `unlocked {roomType}`
		end,
	})
end

function BuildService:Start()
	local acc, repairAcc = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc >= 0.25 then
			tick(acc)
			acc = 0
		end
		repairAcc += dt
		if repairAcc >= 1 then
			table.clear(repairing)
			if director:Phase() == "Playing" then
				local ok, err = pcall(residentRepairs, repairAcc)
				if not ok then
					log:Warn("resident repairs: %s", tostring(err))
				end
			end
			repairAcc = 0
		end
	end)
	weapons.ToolTick:Connect(onToolTick)
	-- the team hears when a room is wrecked and when it works again (Prompt 13)
	grid.Wrecked:Connect(function(roomId: string)
		local room = grid:Room(roomId)
		if room and room.Type ~= "ReactorCore" then
			Remotes.FireClients("Alert", session:ReadyPlayers(), "Danger",
				`THE {string.upper(roomName(room.Type))} IS WRECKED: REPAIR IT WITH A WELDER`)
		end
	end)
	grid.Repaired:Connect(function(roomId: string)
		local room = grid:Room(roomId)
		if room then
			announce(`THE {string.upper(roomName(room.Type))} IS REPAIRED AND WORKING AGAIN`)
		end
	end)
end

return BuildService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CA"><Properties><string name="Name">BunkerGrid</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BunkerGrid: the bunker's cells, rooms, levels, merges and the room graph (bible Sections 6
	and 23). Run place only.

	The data and its rules are Shared.Rules.Bunker (Rock, Dug and room cells; dig left, right
	or down; rooms on Dug cells, MaxCells, Unique, Fixed, floor rules; matching rooms merge;
	levels 1 to 3; the graph of doorways and Shafts). This service holds the run's one bunker,
	starts it from Tuning.StartingBunker, builds the world from it (Lib.BunkerKit, graybox
	until the A1 art) and replicates it:
	* Cells collection: "floor,column" -> { Room = id } for every open cell ({} when Dug);
	* Rooms collection: id -> { Type, Floor, Column, Span, Level, HP, MaxHP, Wrecked }.

	HP (Prompt 13): SetHP is how damage and repairs land. A room at 0 HP is Wrecked until it is
	repaired to Tuning.Repairs.RepairedAt of its maximum (Rules.Bunker); Wrecked and Repaired
	fire when that changes. SetHPModifier applies the RoomHP (every room) and BlastDoorHealth
	(the Blast Door) multipliers from draft cards and classes.

	Votes, costs and build time are BuildService's (Prompt 8); dig time, cell rolls and Push
	Deeper are DigService's (Prompt 14). They call the methods below.

	API:
		BunkerGrid:Bunker(): Bunker               -- the live data: read only
		BunkerGrid:State(floor, column), :Room(id), :RoomAt(floor, column), :Rooms(), :RoomsOfType(type)
		BunkerGrid:Dig(floor, column): (boolean, string?)
		BunkerGrid:PlaceRoom(type, floor, column, span, level?): (string?, string?)
		BunkerGrid:RemoveRoom(id): (boolean, string?)
		BunkerGrid:MergeRooms(a, b): (string?, string?)
		BunkerGrid:SetLevel(id, level): (boolean, string?)
		BunkerGrid:SetHP(id, hp): number?
		BunkerGrid:SetHPModifier(source, key, value?)  -- RoomHP or BlastDoorHealth; nil clears
		BunkerGrid:Neighbors(unit), :Graph(), :DeepestFloor()
		BunkerGrid:RoomModel(id): Model?, :Root(): Folder
		BunkerGrid.Changed: Signal<{ string }>    -- the cell keys whose state changed
		BunkerGrid.RoomChanged: Signal<string>    -- a room was added, changed or removed
	BunkerGrid.Wrecked: Signal<string>        -- a room's HP reached 0 (Prompt 13: the Reactor Core melts down)
	BunkerGrid.Repaired: Signal<string>       -- a wrecked room works again
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Bunker = require(Shared.Rules.Bunker)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("BunkerGrid")

local BunkerGrid = {
	Name = "BunkerGrid",
	Dependencies = { "ReplicationService", "DevService" },
	Changed = Signal.new() :: Signal.Signal<{ string }>,
	RoomChanged = Signal.new() :: Signal.Signal<string>,
	Wrecked = Signal.new() :: Signal.Signal<string>,
	Repaired = Signal.new() :: Signal.Signal<string>,
}

-- Which room types an HP modifier key scales (Config.Modifiers, Prompt 13).
local HP_KEYS: { [string]: string } = { RoomHP = "All", BlastDoorHealth = "BlastDoor" }

local CODES: { [string]: string } = {
	BlastDoor = "BLD", Shaft = "SHF", ReactorCore = "RCT", Generator = "GEN", Kitchen = "KIT",
	WaterPurifier = "WTR", Quarters = "QTR", Medbay = "MED", Storage = "STO", Workshop = "WRK",
	Armory = "ARM", RadioRoom = "RAD", Lounge = "LNG", Lab = "LAB", DrillBay = "DRL",
	Greenhouse = "GRN", TrainingRoom = "TRN", DeconRoom = "DCN", CryoBay = "CRY",
	TradingPost = "TRD", Memorial = "MEM",
}

local bunker: Bunker.Bunker = Bunker.new()
local root: Folder? = nil
local cellsCollection: any = nil
local roomsCollection: any = nil
local hpModifiers: { [string]: { [string]: number } } = {} -- key -> source -> multiplier

-- Replication and the world ---------------------------------------------------------------

local function publishRoom(id: string)
	local room = bunker:Room(id)
	if room then
		roomsCollection:Set(id, {
			Type = room.Type,
			Floor = room.Floor,
			Column = room.Column,
			Span = room.Span,
			Level = room.Level,
			HP = room.HP,
			MaxHP = room.MaxHP,
			Wrecked = room.Wrecked,
		})
	elseif roomsCollection:Get(id) ~= nil then
		roomsCollection:Remove(id)
	end
end

local function publishCell(key: string)
	local floor, column = Grid.Parse(key)
	if not floor or not column then
		return
	end
	local state, id = bunker:State(floor, column)
	if state == "Dug" then
		cellsCollection:Set(key, {})
	elseif state == "Room" then
		cellsCollection:Set(key, { Room = id })
	elseif cellsCollection:Get(key) ~= nil then
		cellsCollection:Remove(key)
	end
end

-- The cells of these rooms and cells, and their neighbours left, right, above and below.
local function around(cells: { { number } }): { [string]: boolean }
	local dirty: { [string]: boolean } = {}
	for _, cell in cells do
		local floor, column = cell[1], cell[2]
		for _, offset in { { 0, 0 }, { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
			local f, c = floor + offset[1], column + offset[2]
			if Grid.OnGrid(f, c) then
				dirty[Grid.Key(f, c)] = true
			end
		end
	end
	return dirty
end

local function roomCells(room: Bunker.Room): { { number } }
	local cells = {}
	for offset = 0, room.Span - 1 do
		table.insert(cells, { room.Floor, room.Column + offset })
	end
	return cells
end

-- After a change: replicate the changed cells and rooms, rebuild the world around them.
local function changed(cells: { { number } }, roomIds: { string })
	local keys = {}
	for _, cell in cells do
		local key = Grid.Key(cell[1], cell[2])
		table.insert(keys, key)
		publishCell(key)
	end
	for _, id in roomIds do
		publishRoom(id)
	end
	if root then
		BunkerKit.Sync(bunker, root, around(cells))
	end
	BunkerGrid.Changed:Fire(keys)
	for _, id in roomIds do
		BunkerGrid.RoomChanged:Fire(id)
	end
end

-- API ----------------------------------------------------------------------------------------

function BunkerGrid:Bunker(): Bunker.Bunker
	return bunker
end

function BunkerGrid:Root(): Folder?
	return root
end

function BunkerGrid:State(floor: number, column: number): (Bunker.CellState?, string?)
	return bunker:State(floor, column)
end

function BunkerGrid:Room(id: string): Bunker.Room?
	return bunker:Room(id)
end

function BunkerGrid:RoomAt(floor: number, column: number): Bunker.Room?
	return bunker:RoomAt(floor, column)
end

function BunkerGrid:Rooms(): { Bunker.Room }
	return bunker:AllRooms()
end

function BunkerGrid:RoomsOfType(roomType: string): { Bunker.Room }
	return bunker:RoomsOfType(roomType)
end

function BunkerGrid:Neighbors(unit: string): { string }
	return bunker:Neighbors(unit)
end

function BunkerGrid:Graph(): { [string]: { string } }
	return bunker:Graph()
end

function BunkerGrid:DeepestFloor(): number
	return bunker:DeepestFloor()
end

function BunkerGrid:RoomModel(id: string): Model?
	local folder = root and root:FindFirstChild("Rooms")
	local model = folder and folder:FindFirstChild(id)
	return if model and model:IsA("Model") then model else nil
end

function BunkerGrid:Dig(floor: number, column: number): (boolean, string?)
	local ok, why = bunker:Dig(floor, column)
	if ok then
		log:Info("dug %s", Grid.Key(floor, column))
		changed({ { floor, column } }, {})
	end
	return ok, why
end

function BunkerGrid:PlaceRoom(roomType: string, floor: number, column: number, span: number, level: number?): (string?, string?)
	local id, why = bunker:Place(roomType, floor, column, span, level)
	if id then
		local room = bunker:Room(id) :: Bunker.Room
		log:Info("%s %s on floor %d, columns %d to %d", id, roomType, floor, column, column + span - 1)
		changed(roomCells(room), { id })
	end
	return id, why
end

function BunkerGrid:RemoveRoom(id: string): (boolean, string?)
	local room = bunker:Room(id)
	local cells = if room then roomCells(room) else {}
	local ok, why = bunker:Remove(id)
	if ok then
		log:Info("%s torn down", id)
		changed(cells, { id })
	end
	return ok, why
end

function BunkerGrid:MergeRooms(a: string, b: string): (string?, string?)
	local first, second = bunker:Room(a), bunker:Room(b)
	local cells = {}
	for _, room in { first, second } do
		if room then
			for _, cell in roomCells(room) do
				table.insert(cells, cell)
			end
		end
	end
	local id, why = bunker:Merge(a, b)
	if id then
		log:Info("%s and %s merged into %s", a, b, id)
		changed(cells, { a, b })
	end
	return id, why
end

function BunkerGrid:SetLevel(id: string, level: number): (boolean, string?)
	local ok, why = bunker:SetLevel(id, level)
	if ok then
		changed(roomCells(bunker:Room(id) :: Bunker.Room), { id })
	end
	return ok, why
end

function BunkerGrid:SetHP(id: string, hp: number): number?
	local room = bunker:Room(id)
	if not room then
		return nil
	end
	local before, wasWrecked = room.HP, room.Wrecked
	local result = bunker:SetHP(id, hp)
	if result and (result ~= before or room.Wrecked ~= wasWrecked) then
		roomsCollection:Patch(id, { HP = result, Wrecked = room.Wrecked })
		BunkerGrid.RoomChanged:Fire(id)
		if room.Wrecked and not wasWrecked then
			log:Info("%s (%s) is wrecked", id, room.Type)
			BunkerGrid.Wrecked:Fire(id)
		elseif wasWrecked and not room.Wrecked then
			log:Info("%s (%s) is repaired", id, room.Type)
			BunkerGrid.Repaired:Fire(id)
		end
	end
	return result
end

-- RoomHP (every room) and BlastDoorHealth (the Blast Door) multipliers, by source (a draft card,
-- a class); nil clears that source's. Every room keeps its share of its HP.
function BunkerGrid:SetHPModifier(source: string, key: string, value: number?)
	local target = HP_KEYS[key]
	assert(target, `BunkerGrid:SetHPModifier: {key} isn't an HP modifier`)
	hpModifiers[key] = hpModifiers[key] or {}
	hpModifiers[key][source] = value
	local product = 1
	for _, v in hpModifiers[key] do
		product *= v
	end
	bunker:SetHPScale(target, product)
	for _, room in bunker:AllRooms() do
		publishRoom(room.Id)
	end
end

-- DevTools ----------------------------------------------------------------------------------

local function map(): string
	local t = Grid.Tuning()
	local lines = {}
	local header = { "floor  " }
	for column = t.ColumnMin, t.ColumnMax do
		table.insert(header, string.format("%5d", column))
	end
	table.insert(lines, table.concat(header))
	local last = math.min(t.FloorMax, math.max(bunker:DeepestFloor() + 1, 3))
	for floor = t.FloorMin, last do
		local row = { string.format("%5d  ", floor) }
		for column = t.ColumnMin, t.ColumnMax do
			local state, id = bunker:State(floor, column)
			local token = "  ###"
			if state == "Dug" then
				token = "  ..."
			elseif state == "Room" and id then
				local room = bunker:Room(id) :: Bunker.Room
				token = `  {CODES[room.Type] or string.sub(room.Type, 1, 3)}`
			end
			table.insert(row, token)
		end
		table.insert(lines, table.concat(row))
	end
	return table.concat(lines, "\n")
end

local function roomList(): string
	local lines = {}
	for _, room in bunker:AllRooms() do
		table.insert(lines, `{room.Id} {room.Type} L{room.Level} floor {room.Floor} columns {room.Column}..{room.Column + room.Span - 1} HP {room.HP}/{room.MaxHP}{if room.Wrecked then " WRECKED" else ""}`)
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("grid", {
		Description = "The bunker map (### rock, ... dug, room codes) and its size.",
		Run = function(): string?
			local parts = if root then BunkerKit.PartCount(root) else 0
			return `{map()}\n{#bunker:AllRooms()} rooms, deepest floor {bunker:DeepestFloor()}, {parts} parts`
		end,
	})
	dev:Register("grid.rooms", {
		Description = "Every room: id, type, level, cells and HP.",
		Run = function(): string?
			return roomList()
		end,
	})
	dev:Register("grid.graph", {
		Description = "The room graph: each room or dug cell and what it connects to.",
		Run = function(): string?
			local lines = {}
			local graph = bunker:Graph()
			for _, unit in bunker:Units() do
				table.insert(lines, `{unit}: {table.concat(graph[unit], ", ")}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("grid.dig", {
		Description = "Dig a rock cell (no time, no vote: DigService adds those).",
		Usage = "grid.dig <floor> <column>",
		Run = function(_player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: grid.dig <floor> <column>"
			end
			local ok, why = BunkerGrid:Dig(floor, column)
			return if ok then map() else `can't dig: {why}`
		end,
	})
	dev:Register("grid.build", {
		Description = "Place a room on dug cells (no vote or cost: BuildService adds those).",
		Usage = "grid.build <RoomType> <floor> <column> [span] [level]",
		Run = function(_player, args): string?
			local roomType = tostring(args[1] or "")
			local floor, column = tonumber(args[2]), tonumber(args[3])
			local span, level = tonumber(args[4]) or 1, tonumber(args[5])
			if not floor or not column then
				return "usage: grid.build <RoomType> <floor> <column> [span] [level]"
			end
			local id, why = BunkerGrid:PlaceRoom(roomType, floor, column, span, level)
			return if id then `{id} placed\n{map()}` else `can't build: {why}`
		end,
	})
	dev:Register("grid.remove", {
		Description = "Tear a room down (its cells become dug).",
		Usage = "grid.remove <roomId>",
		Run = function(_player, args): string?
			local ok, why = BunkerGrid:RemoveRoom(tostring(args[1] or ""))
			return if ok then map() else `can't remove: {why}`
		end,
	})
	dev:Register("grid.merge", {
		Description = "Merge two matching rooms side by side.",
		Usage = "grid.merge <roomId> <roomId>",
		Run = function(_player, args): string?
			local id, why = BunkerGrid:MergeRooms(tostring(args[1] or ""), tostring(args[2] or ""))
			return if id then `merged into {id}\n{roomList()}` else `can't merge: {why}`
		end,
	})
	dev:Register("grid.level", {
		Description = "Set a room's level (1 to 3).",
		Usage = "grid.level <roomId> <level>",
		Run = function(_player, args): string?
			local ok, why = BunkerGrid:SetLevel(tostring(args[1] or ""), tonumber(args[2]) or 0)
			return if ok then roomList() else `can't set the level: {why}`
		end,
	})
	dev:Register("grid.hp", {
		Description = "Set a room's HP (0 wrecks it; a wrecked room works again at Tuning.Repairs.RepairedAt).",
		Usage = "grid.hp <roomId> <hp>",
		Run = function(_player, args): string?
			local id, hp = tostring(args[1] or ""), tonumber(args[2])
			if not hp or not bunker:Room(id) then
				return "usage: grid.hp <roomId> <hp> (see grid.rooms)"
			end
			BunkerGrid:SetHP(id, hp)
			local room = bunker:Room(id) :: Bunker.Room
			return `{id} {room.Type}: {room.HP}/{room.MaxHP}{if room.Wrecked then ", WRECKED" else ""}`
		end,
	})
	dev:Register("grid.sockets", {
		Description = "A room's gameplay points (work spots, beds, valves...) and where they are.",
		Usage = "grid.sockets <roomId>",
		Run = function(_player, args): string?
			local model = BunkerGrid:RoomModel(tostring(args[1] or ""))
			if not model then
				return "usage: grid.sockets <roomId> (see grid.rooms)"
			end
			local lines = {}
			for name, at in BunkerKit.Sockets(model) do
				local p = at.Position
				table.insert(lines, string.format("%s (%.1f, %.1f, %.1f)", name, p.X, p.Y, p.Z))
			end
			table.sort(lines)
			return `{model.Name}: {#lines} sockets\n{table.concat(lines, "\n")}`
		end,
	})
	dev:Register("grid.art", {
		Description = "Which units are built from the art kit and which from the graybox.",
		Run = function(): string?
			if not root then
				return "no bunker world yet"
			end
			local art, gray = {}, {}
			for _, folderName in { "Rooms", "Dug" } do
				local folder = root:FindFirstChild(folderName)
				for _, model in if folder then folder:GetChildren() else {} do
					table.insert(if model:GetAttribute("Art") then art else gray, model.Name)
				end
			end
			local lights = 0
			for _, item in root:GetDescendants() do
				if item:IsA("PointLight") then
					lights += 1
				end
			end
			return `art kit: {if BunkerKit.HasArt() then "yes" else "missing"}\nart: {table.concat(art, ", ")}\ngraybox: {table.concat(gray, ", ")}\n{lights} lights, {BunkerKit.PartCount(root)} parts`
		end,
	})
	dev:Register("grid.rebuild", {
		Description = "Rebuild the whole bunker world from the data.",
		Run = function(): string?
			if not root then
				return "no bunker world yet"
			end
			local began = os.clock()
			root:ClearAllChildren()
			BunkerKit.Sync(bunker, root, nil)
			return `rebuilt {BunkerKit.PartCount(root)} parts in {string.format("%.1f", (os.clock() - began) * 1000)} ms`
		end,
	})
end

-- Lifecycle -----------------------------------------------------------------------------------

function BunkerGrid:Init(registry)
	bunker = Bunker.FromStart()
	cellsCollection = registry.ReplicationService:Collection("Cells")
	roomsCollection = registry.ReplicationService:Collection("Rooms")
	for key in bunker.Cells do
		publishCell(key)
	end
	for _, room in bunker:AllRooms() do
		publishRoom(room.Id)
	end
	registerCommands(registry.DevService)
end

function BunkerGrid:Start()
	local began = os.clock()
	local old = workspace:FindFirstChild("Bunker")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Bunker"
	BunkerKit.Sync(bunker, folder, nil)
	folder.Parent = workspace
	root = folder

	-- Players spawn in the Medbay (their respawn point); other spawns in the place sleep.
	for _, item in workspace:GetDescendants() do
		if item:IsA("SpawnLocation") and not item:IsDescendantOf(folder) then
			item.Enabled = false
		end
	end
	local open = 0
	for _ in bunker.Cells do
		open += 1
	end
	log:Info(
		"bunker built from the %s: %d rooms, %d open cells, %d parts in %.1f ms",
		if BunkerKit.HasArt() then "art kit" else "graybox",
		#bunker:AllRooms(),
		open,
		BunkerKit.PartCount(folder),
		(os.clock() - began) * 1000
	)
end

return BunkerGrid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CB"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CombatService: everyone who can be hurt, in one place (bible Section 23: one loop for every
	combatant: players, armed residents, monsters, turrets, bosses). Run place only; Prompt 11.

	Combatants
	* Register(model, spec) -> id. A combatant has a team ("Survivors" or "Monsters"), health,
	  a reach (how far its body goes from its root) and a second of position history at
	  Tuning.Combat.HistoryHz, for Section 23's checks against where a target was over the last
	  250 ms. Get(id), OfInstance(part), All(team?), History(id).
	* Players register when they spawn and residents' bodies when ResidentBrain makes them
	  (their health stays with ResidentService). Monsters come with Prompt 12; until then a dev
	  dummy stands in.
	* Damage(targetId, amount, sourceId?, how?): no friendly fire (Section 9), and a dodge's
	  invulnerable moment takes nothing. Heal(id, amount).
	* Signals: Damaged(id, amount, sourceId?, how?), Downed(id), Revived(id, byUserId?),
	  Died(id). Dead monsters dissolve into glowing dust (Section 3); a combatant registered with
	  KeepModel (a boss, Prompt 15) is left for its own service, which calls Dissolve(model).

	Players (Section 9)
	* Health: Tuning.Player.Health (classes add theirs with Prompt 20). Roblox's own
	  regeneration is removed: health comes back only by healing.
	* At 0 health a player is Downed for DownedSeconds and crawls (CrawlSpeed). Teammates see a
	  revive prompt: hold Interact for ReviveSeconds (the Medic's 1 s comes with Prompt 20). A
	  revived player gets up with ReviveHealthFraction of their health.
	* Not revived in time: dead. RespawnSeconds later they come back at the nearest working
	  Medbay (not wrecked, not dark), or in the Blast Door hall when no Medbay works.
	* Each player's life shows as attributes on the Player: Life ("Alive", "Downed", "Dead"),
	  LifeEndsAt (when the downed or respawn wait ends, server time) and InvulnerableUntil.
	* A player's Humanoid never reaches 0 health: the hit that would take it there leaves it at
	  1 and downs the player (at 0 the server kills a Humanoid whatever the client does). The
	  client also turns the Dead state off for its own character, and Died is still handled as a
	  fallback.

	Dev: combat, hurt, heal, down, revive, kill, dummy, dummy.attack, dummy.clear.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Rules.Combat)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local Hazards = require(game:GetService("ServerScriptService").Lib.Hazards)

local log = Log.new("CombatService")

export type Team = "Survivors" | "Monsters"
export type Kind = "Player" | "Resident" | "Monster"
export type Combatant = {
	Id: string,
	Kind: Kind,
	Team: Team,
	Model: Model,
	Root: BasePart,
	Reach: number,
	Health: number, -- monsters' own; players and residents keep theirs where they live
	MaxHealth: number,
	State: "Alive" | "Downed" | "Dead",
	History: { Combat.Sample },
	InvulnerableUntil: number,
	Player: Player?,
	ResidentId: string?,
	MonsterType: string?,
	KeepModel: boolean?, -- a boss: its own service plays its death before it dissolves (Prompt 15)
}
export type Spec = {
	Kind: Kind,
	Team: Team,
	Root: BasePart?,
	Health: number?,
	Player: Player?,
	ResidentId: string?,
	MonsterType: string?,
	Id: string?,
	KeepModel: boolean?, -- don't dissolve the model at death (a boss plays its death clip first)
}

local CombatService = {
	Name = "CombatService",
	Dependencies = { "SessionService", "BunkerGrid", "PowerService", "ResidentService", "DevService" },
	Damaged = Signal.new() :: Signal.Signal<string, number, string?, string?>,
	Downed = Signal.new() :: Signal.Signal<string>,
	Revived = Signal.new() :: Signal.Signal<string, number?>,
	Died = Signal.new() :: Signal.Signal<string>,
}

local grid: any = nil
local power: any = nil
local residents: any = nil
local dev: any = nil

local combatants: { [string]: Combatant } = {}
local byModel: { [Model]: string } = {}
local monsterCount = 0
local fellAt: { [Player]: Vector3 } = {} -- where a player went down, for the respawn choice
local respawnAt: { [Player]: CFrame } = {}
local lifeTask: { [Player]: thread } = {}
local dummyAttack = false

local function now(): number
	return workspace:GetServerTimeNow()
end

local function playerId(player: Player): string
	return `P{player.UserId}`
end

-- The model's reach: half its widest side, so a hit anywhere on its body is near its root.
local function reachOf(model: Model): number
	local _, size = model:GetBoundingBox()
	return math.max(size.X, size.Y, size.Z) / 2
end

local function setLife(player: Player, life: string, endsAt: number?)
	player:SetAttribute("Life", life)
	player:SetAttribute("LifeEndsAt", endsAt)
end

local function humanoidOf(c: Combatant): Humanoid?
	return c.Model:FindFirstChildOfClass("Humanoid")
end

-- Combatants -----------------------------------------------------------------------------

function CombatService:Register(model: Model, spec: Spec): string?
	local root = spec.Root or model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		log:Warn("%s has no root part to register", model:GetFullName())
		return nil
	end
	local id = spec.Id
	if not id then
		monsterCount += 1
		id = `M{monsterCount}`
	end
	local health = spec.Health or 100
	local record: Combatant = {
		Id = id :: string,
		Kind = spec.Kind,
		Team = spec.Team,
		Model = model,
		Root = root,
		Reach = reachOf(model),
		Health = health,
		MaxHealth = health,
		State = "Alive",
		History = {},
		InvulnerableUntil = 0,
		Player = spec.Player,
		ResidentId = spec.ResidentId,
		MonsterType = spec.MonsterType,
		KeepModel = spec.KeepModel,
	}
	combatants[record.Id] = record
	byModel[model] = record.Id
	model:SetAttribute("CombatantId", record.Id)
	model:SetAttribute("Team", record.Team)
	if record.Kind == "Monster" then
		model:SetAttribute("Health", health)
		model:SetAttribute("MaxHealth", health)
	end
	return record.Id
end

function CombatService:Unregister(id: string)
	local record = combatants[id]
	if not record then
		return
	end
	combatants[id] = nil
	if byModel[record.Model] == id then
		byModel[record.Model] = nil
	end
end

function CombatService:Get(id: string): Combatant?
	return combatants[id]
end

-- The combatant a part belongs to (its model, or a model above it).
function CombatService:OfInstance(instance: Instance?): Combatant?
	local node = instance
	while node and node ~= workspace do
		if node:IsA("Model") then
			local id = byModel[node]
			if id then
				return combatants[id]
			end
		end
		node = node.Parent
	end
	return nil
end

function CombatService:All(team: Team?): { Combatant }
	local list = {}
	for _, c in combatants do
		if team == nil or c.Team == team then
			table.insert(list, c)
		end
	end
	table.sort(list, function(a, b)
		return a.Id < b.Id
	end)
	return list
end

function CombatService:History(id: string): { Combat.Sample }
	local record = combatants[id]
	return if record then record.History else {}
end

function CombatService:PlayerCombatant(player: Player): Combatant?
	return combatants[playerId(player)]
end

function CombatService:SetInvulnerable(id: string, untilTime: number)
	local record = combatants[id]
	if record then
		record.InvulnerableUntil = math.max(record.InvulnerableUntil, untilTime)
		if record.Player then
			record.Player:SetAttribute("InvulnerableUntil", record.InvulnerableUntil)
		end
	end
end

function CombatService:HealthOf(id: string): (number, number)
	local record = combatants[id]
	if not record then
		return 0, 0
	end
	if record.Kind == "Player" then
		local h = humanoidOf(record)
		return if h then h.Health else 0, if h then h.MaxHealth else 0
	elseif record.Kind == "Resident" and record.ResidentId then
		local resident = residents:Get(record.ResidentId)
		return if resident then resident.Health else 0, if resident then resident.MaxHealth else 0
	end
	return record.Health, record.MaxHealth
end

-- Monsters' death: glowing dust, then gone (Section 3) --------------------------------------

local function dissolve(model: Model)
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if root then
		local dust = Instance.new("ParticleEmitter")
		dust.Name = "Dust"
		dust.Color = ColorSequence.new(Color3.fromRGB(124, 255, 155), Color3.fromRGB(46, 120, 70))
		dust.LightEmission = 0.9
		dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		dust.Lifetime = NumberRange.new(0.6, 1.2)
		dust.Speed = NumberRange.new(2, 6)
		dust.SpreadAngle = Vector2.new(180, 180)
		dust.Acceleration = Vector3.new(0, 4, 0)
		dust.Rate = 0
		dust.Parent = root
		dust:Emit(60)
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.Anchored = true
			TweenService:Create(part, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
		elseif part:IsA("Decal") or part:IsA("Texture") then
			TweenService:Create(part, TweenInfo.new(0.8), { Transparency = 1 }):Play()
		end
	end
	task.delay(1.4, function()
		model:Destroy()
	end)
end

-- Fades a model out with a puff of Source dust and destroys it (what a dead monster does).
function CombatService:Dissolve(model: Model)
	dissolve(model)
end

-- Players: down, revive, die, respawn ---------------------------------------------------------

local function clearLifeTask(player: Player)
	local running = lifeTask[player]
	lifeTask[player] = nil
	if running and coroutine.status(running) == "suspended" then
		task.cancel(running)
	end
end

local function removePrompt(record: Combatant)
	local prompt = record.Root:FindFirstChild("RevivePrompt")
	if prompt then
		prompt:Destroy()
	end
end

-- The working Medbays' respawn points (Section 9), nearest first is Combat.Nearest's job. A
-- burning Medbay isn't one (Prompt 13): nobody comes back into a fire.
local function respawnPlaces(): { Combat.Place }
	local places = {}
	for _, room in grid:RoomsOfType("Medbay") do
		if not room.Wrecked and not power:IsDark(room.Id) and not Hazards.Fire(room.Id) then
			local model = grid:RoomModel(room.Id)
			local respawn = model and model:FindFirstChild("Respawn", true)
			local position = if respawn and respawn:IsA("Attachment")
				then respawn.WorldPosition
				else Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, 0, 4)
			table.insert(places, { Id = room.Id, Position = position })
		end
	end
	return places
end

-- The Blast Door hall, where players come back when no Medbay works.
local function blastDoorHall(): Vector3
	local doors = grid:RoomsOfType("BlastDoor")
	local door = doors[1]
	if door then
		local column = door.Column + (door.Span - 1) / 2
		return Grid.CellPosition(door.Floor, column) + Vector3.new(0, 0, 8)
	end
	return Grid.CellPosition(1, 0) + Vector3.new(0, 0, 8)
end

local function respawnPoint(from: Vector3?): (CFrame, string)
	local place = Combat.Nearest(from or Vector3.zero, respawnPlaces())
	local position = if place then place.Position else blastDoorHall()
	return CFrame.new(position + Vector3.new(0, 3, 0)), if place then `Medbay {place.Id}` else "the Blast Door hall"
end

local function die(player: Player, why: string)
	local record = CombatService:PlayerCombatant(player)
	clearLifeTask(player)
	if record then
		fellAt[player] = record.Root.Position
		removePrompt(record)
		record.State = "Dead"
		CombatService:Unregister(record.Id)
		CombatService.Died:Fire(record.Id)
	end
	local seconds = Config.Get("Tuning", "Player").RespawnSeconds
	setLife(player, "Dead", now() + seconds)
	log:Info("%s died (%s); back in %d s", player.Name, why, seconds)
	local character = player.Character
	if character then
		character:Destroy()
	end
	lifeTask[player] = task.delay(seconds, function()
		lifeTask[player] = nil
		if player.Parent ~= Players then
			return
		end
		local cframe, where = respawnPoint(fellAt[player])
		respawnAt[player] = cframe
		fellAt[player] = nil
		log:Info("%s respawns at %s", player.Name, where)
		player:LoadCharacter()
	end)
end

function CombatService:Revive(player: Player, by: Player?): (boolean, string?)
	local record = CombatService:PlayerCombatant(player)
	if not record or record.State ~= "Downed" then
		return false, "not downed"
	end
	local h = humanoidOf(record)
	if not h then
		return false, "no character"
	end
	clearLifeTask(player)
	removePrompt(record)
	record.State = "Alive"
	local fraction = Combat.Tuning().ReviveHealthFraction
	h.Health = math.max(1, math.floor(h.MaxHealth * fraction + 0.5))
	setLife(player, "Alive", nil)
	CombatService.Revived:Fire(record.Id, if by then by.UserId else nil)
	log:Info("%s was revived%s", player.Name, if by then ` by {by.Name}` else "")
	return true, nil
end

local function down(player: Player, record: Combatant)
	if record.State ~= "Alive" then
		return
	end
	local p = Config.Get("Tuning", "Player")
	record.State = "Downed"
	setLife(player, "Downed", now() + p.DownedSeconds)
	CombatService.Downed:Fire(record.Id)
	log:Info("%s is down", player.Name)

	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "RevivePrompt"
	prompt.ActionText = "Revive"
	prompt.ObjectText = player.DisplayName
	prompt.HoldDuration = p.ReviveSeconds
	prompt.MaxActivationDistance = 9
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.GamepadKeyCode = Enum.KeyCode.ButtonX
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Owner", player.UserId)
	prompt:SetAttribute("Kind", "Revive")
	prompt.Triggered:Connect(function(by: Player)
		if by == player then
			return
		end
		local helper = CombatService:PlayerCombatant(by)
		if not helper or helper.State ~= "Alive" then
			return
		end
		CombatService:Revive(player, by)
	end)
	prompt.Parent = record.Root

	clearLifeTask(player)
	lifeTask[player] = task.delay(p.DownedSeconds, function()
		lifeTask[player] = nil
		if record.State == "Downed" then
			die(player, "not revived in time")
		end
	end)
end

local function watchCharacter(player: Player, character: Model)
	local h = character:WaitForChild("Humanoid", 10) :: Humanoid?
	local root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	if not h or not root or character.Parent == nil then
		return
	end
	-- No regeneration: Roblox's Health script goes (Section 9: health comes back by healing)
	local function dropRegen(child: Instance)
		if child.Name == "Health" and child:IsA("Script") then
			child:Destroy()
		end
	end
	local regen = character:FindFirstChild("Health")
	if regen then
		dropRegen(regen)
	end
	character.ChildAdded:Connect(dropRegen)

	local p = Config.Get("Tuning", "Player")
	h.BreakJointsOnDeath = false
	h.RequiresNeck = false
	h.MaxHealth = p.Health
	h.Health = p.Health
	local spawnAt = respawnAt[player]
	respawnAt[player] = nil
	if spawnAt then
		task.defer(function()
			if character.Parent then
				character:PivotTo(spawnAt)
			end
		end)
	end

	local old = CombatService:PlayerCombatant(player)
	if old then
		CombatService:Unregister(old.Id)
	end
	local id = CombatService:Register(character, {
		Kind = "Player",
		Team = "Survivors",
		Root = root,
		Health = p.Health,
		Player = player,
		Id = playerId(player),
	})
	if not id then
		return
	end
	local record = combatants[id]
	setLife(player, "Alive", nil)
	player:SetAttribute("InvulnerableUntil", 0)

	h.HealthChanged:Connect(function(health: number)
		if health <= 0 and record.State == "Alive" and combatants[id] == record then
			down(player, record)
		end
	end)
	h.Died:Connect(function()
		if combatants[id] == record and record.State ~= "Dead" then
			die(player, "the character died")
		end
	end)
	character.AncestryChanged:Connect(function(_, parent)
		if parent == nil and combatants[id] == record then
			CombatService:Unregister(id)
		end
	end)
end

-- Damage and healing ---------------------------------------------------------------------------

-- Hurts a combatant; returns the damage done (0 for a teammate, an invulnerable dodge, or a
-- combatant already down).
function CombatService:Damage(targetId: string, amount: number, sourceId: string?, how: string?): number
	local target = combatants[targetId]
	if not target or amount <= 0 or target.State ~= "Alive" then
		return 0
	end
	local source = if sourceId then combatants[sourceId] else nil
	if source and source.Team == target.Team then
		return 0 -- no friendly fire (Section 9)
	end
	if now() < target.InvulnerableUntil then
		return 0
	end
	local done = amount
	if target.Kind == "Player" then
		local h = humanoidOf(target)
		if not h then
			return 0
		end
		if h.Health - amount <= 0 then
			-- A player's Humanoid never reaches 0: at 0 the server kills it whatever the client's
			-- states (playtest, Nov 8, 2026). It stays at 1 and the player is Downed instead; the
			-- HUD shows 0 while down (CombatController).
			done = h.Health
			h.Health = 1
			CombatService.Damaged:Fire(targetId, done, sourceId, how)
			if target.Player then
				down(target.Player, target)
			end
			return done
		end
		h.Health -= amount
	elseif target.Kind == "Resident" then
		if target.ResidentId then
			residents:Hurt(target.ResidentId, amount, how or "attacked")
		end
	else
		done = math.min(amount, target.Health)
		target.Health = math.max(target.Health - amount, 0)
		target.Model:SetAttribute("Health", target.Health)
		if target.Health <= 0 then
			target.State = "Dead"
			CombatService:Unregister(target.Id)
			CombatService.Damaged:Fire(targetId, done, sourceId, how)
			CombatService.Died:Fire(targetId)
			if not target.KeepModel then
				dissolve(target.Model)
			end
			return done
		end
	end
	CombatService.Damaged:Fire(targetId, done, sourceId, how)
	return done
end

function CombatService:Heal(id: string, amount: number): number
	local target = combatants[id]
	if not target or target.State ~= "Alive" or amount <= 0 then
		return 0
	end
	if target.Kind == "Player" then
		local h = humanoidOf(target)
		if not h then
			return 0
		end
		local before = h.Health
		h.Health = math.min(h.Health + amount, h.MaxHealth)
		return h.Health - before
	end
	local before = target.Health
	target.Health = math.min(target.Health + amount, target.MaxHealth)
	target.Model:SetAttribute("Health", target.Health)
	return target.Health - before
end

-- Residents' bodies ------------------------------------------------------------------------------

local function watchResidents()
	local bunkerRoot = grid:Root()
	if not bunkerRoot then
		log:Warn("no bunker yet: residents aren't combatants")
		return
	end
	local function attach(folder: Instance)
		if not folder:IsA("Folder") or folder.Name ~= "Residents" then
			return
		end
		local function add(body: Instance)
			if body:IsA("Model") then
				local residentId = body:GetAttribute("ResidentId") or body.Name
				if type(residentId) == "string" and string.match(residentId, "^N%d+$") then
					CombatService:Register(body, { Kind = "Resident", Team = "Survivors", ResidentId = residentId, Id = residentId })
				end
			end
		end
		for _, body in folder:GetChildren() do
			add(body)
		end
		folder.ChildAdded:Connect(add)
		folder.ChildRemoved:Connect(function(body: Instance)
			local id = if body:IsA("Model") then byModel[body] else nil
			if id then
				CombatService:Unregister(id)
			end
		end)
	end
	local existing = bunkerRoot:FindFirstChild("Residents")
	if existing then
		attach(existing)
	end
	bunkerRoot.ChildAdded:Connect(attach)
end

-- History --------------------------------------------------------------------------------------

local function record(t: number, keep: number)
	for _, c in combatants do
		local root = c.Root
		if root.Parent then
			local history = c.History
			table.insert(history, { T = t, P = root.Position })
			while #history > 0 and history[1].T < t - keep do
				table.remove(history, 1)
			end
		end
	end
end

-- Dev: a target dummy until Prompt 12's monsters ----------------------------------------------

local function spawnDummy(player: Player?, monsterId: string, health: number?): (string?, string?)
	player = player or Players:GetPlayers()[1] -- run from Studio's command bar: the first player
	local monster = Config.Find("Monsters", monsterId)
	if not monster then
		return nil, `no monster {monsterId}`
	end
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Monsters")
	local template = folder and folder:FindFirstChild(monster.Asset)
	if not (template and template:IsA("Model")) then
		return nil, `no model {monster.Asset} in ServerStorage.Assets.Monsters`
	end
	local model = template:Clone()
	model.Name = `Dummy_{monsterId}`
	local at = CFrame.new(Grid.CellPosition(2, 2) + Vector3.new(0, 0, 6))
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root then
		local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		look = if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)
		local spot = root.Position + look * 12
		at = CFrame.lookAt(spot, Vector3.new(root.Position.X, spot.Y, root.Position.Z))
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
		end
	end
	local primary = model.PrimaryPart
	if primary then
		primary.Anchored = true
	end
	-- stand it on the floor under the spot
	local hit = workspace:Raycast(at.Position + Vector3.new(0, 4, 0), Vector3.new(0, -20, 0))
	local floorY = if hit then hit.Position.Y else at.Position.Y - 3
	model:PivotTo(at)
	local cf, size = model:GetBoundingBox()
	model:PivotTo(at + Vector3.new(0, floorY - (cf.Position.Y - size.Y / 2), 0))
	local holder = workspace:FindFirstChild("Dummies") or Instance.new("Folder")
	holder.Name = "Dummies"
	holder.Parent = workspace
	model.Parent = holder
	local id = CombatService:Register(model, {
		Kind = "Monster",
		Team = "Monsters",
		Health = health or monster.Health,
		MonsterType = monsterId,
	})
	return id, nil
end

local function dummyAttackLoop()
	while true do
		task.wait(0.25)
		if dummyAttack then
			for _, c in combatants do
				if c.Kind == "Monster" and c.State == "Alive" and not c.Model:GetAttribute("Attacking") then
					local monster = Config.Find("Monsters", c.MonsterType)
					if monster then
						-- the nearest standing player in range
						local best, bestDistance = nil, math.huge
						for _, other in combatants do
							if other.Kind == "Player" and other.State == "Alive" then
								local distance = (other.Root.Position - c.Root.Position).Magnitude - c.Reach
								if distance <= monster.Range and distance < bestDistance then
									best, bestDistance = other, distance
								end
							end
						end
						if best then
							local target = best
							c.Model:SetAttribute("Attacking", true)
							task.spawn(function()
								local look = Vector3.new(target.Root.Position.X, c.Root.Position.Y, target.Root.Position.Z)
								if (look - c.Root.Position).Magnitude > 0.1 then
									c.Model:PivotTo(CFrame.lookAt(c.Root.Position, look) * (c.Root.CFrame:Inverse() * c.Model:GetPivot()))
								end
								-- the rig's attack clip (its Anim_Attack attribute, from the art pipeline)
								local animator = c.Model:FindFirstChildWhichIsA("Animator", true)
								local clipId = c.Model:GetAttribute("Anim_Attack")
								local hitAt = 0.7
								if animator and type(clipId) == "string" then
									local clip = Instance.new("Animation")
									clip.AnimationId = clipId
									local ok, track = pcall(function()
										return (animator :: Animator):LoadAnimation(clip)
									end)
									if ok and track then
										track:Play()
									end
								end
								task.wait(hitAt) -- the windup; the hit is checked again when it lands
								if combatants[c.Id] and target.State == "Alive" then
									local distance = (target.Root.Position - c.Root.Position).Magnitude - c.Reach
									if distance <= monster.Range + 1 then
										CombatService:Damage(target.Id, monster.Damage, c.Id, "struck")
									end
								end
								task.wait(math.max(monster.AttackSeconds - hitAt, 0.2))
								if c.Model.Parent then
									c.Model:SetAttribute("Attacking", nil)
								end
							end)
						end
					end
				end
			end
		end
	end
end

-- Lifecycle --------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	for _, c in CombatService:All() do
		local health, max = CombatService:HealthOf(c.Id)
		table.insert(lines, string.format("%s %s %s (%s): %d/%d %s, history %d", c.Id, c.Kind, c.Model.Name, c.Team,
			math.ceil(health), math.ceil(max), c.State, #c.History))
	end
	return if #lines > 0 then table.concat(lines, "\n") else "no combatants"
end

local function target(player: Player?, name: any): Player?
	if type(name) == "string" and name ~= "" then
		for _, p in Players:GetPlayers() do
			if string.lower(p.Name) == string.lower(name) or string.lower(p.DisplayName) == string.lower(name) then
				return p
			end
		end
		return nil
	end
	return player
end

function CombatService:Init(registry)
	grid = registry.BunkerGrid
	power = registry.PowerService
	residents = registry.ResidentService
	dev = registry.DevService

	dev:Register("combat", {
		Description = "Every combatant: health, state and position history.",
		Usage = "combat",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("hurt", {
		Description = "Hurt a player (you by default), as a monster would.",
		Usage = "hurt [amount] [player]",
		Run = function(player, args): string?
			local who = target(player, args[2])
			local c = who and CombatService:PlayerCombatant(who)
			if not c then
				return "no such player in the fight"
			end
			local done = CombatService:Damage(c.Id, tonumber(args[1]) or 25, nil, "dev")
			local health, max = CombatService:HealthOf(c.Id)
			return `{who and who.Name}: -{done}, {math.ceil(health)}/{max}`
		end,
	})
	dev:Register("heal", {
		Description = "Heal a player (you by default).",
		Usage = "heal [amount] [player]",
		Run = function(player, args): string?
			local who = target(player, args[2])
			local c = who and CombatService:PlayerCombatant(who)
			if not c then
				return "no such player in the fight"
			end
			local done = CombatService:Heal(c.Id, tonumber(args[1]) or 100)
			return `{who and who.Name}: +{done}`
		end,
	})
	dev:Register("down", {
		Description = "Down a player (you by default).",
		Usage = "down [player]",
		Run = function(player, args): string?
			local who = target(player, args[1])
			local c = who and CombatService:PlayerCombatant(who)
			if not c then
				return "no such player in the fight"
			end
			CombatService:Damage(c.Id, 10000, nil, "dev")
			return `{who and who.Name}: {who and who:GetAttribute("Life")}`
		end,
	})
	dev:Register("revive", {
		Description = "Revive a downed player (you by default), as a teammate would.",
		Usage = "revive [player]",
		Run = function(player, args): string?
			local who = target(player, args[1])
			if not who then
				return "no such player"
			end
			local ok, why = CombatService:Revive(who, nil)
			return if ok then `{who.Name} is up` else `can't: {why}`
		end,
	})
	dev:Register("kill", {
		Description = "Skip a downed player's wait: dead now, back after the respawn time.",
		Usage = "kill [player]",
		Run = function(player, args): string?
			local who = target(player, args[1])
			if not who then
				return "no such player"
			end
			die(who, "dev")
			return `{who.Name} is dead`
		end,
	})
	dev:Register("dummy", {
		Description = "A monster that stands still to be hit, in front of you (until Prompt 12's monsters).",
		Usage = "dummy [MonsterId] [health]",
		Run = function(player, args): string?
			local id, why = spawnDummy(player, tostring(args[1] or "HollowMiner"), tonumber(args[2]))
			return if id then `{id} is up` else `can't: {why}`
		end,
	})
	dev:Register("dummy.attack", {
		Description = "Dummies strike the nearest standing player in reach (on or off).",
		Usage = "dummy.attack [on|off]",
		Run = function(_player, args): string?
			dummyAttack = if args[1] == nil then not dummyAttack else args[1] == "on"
			return `dummies attack: {dummyAttack}`
		end,
	})
	dev:Register("dummy.clear", {
		Description = "Remove every dummy.",
		Usage = "dummy.clear",
		Run = function(): string?
			local count = 0
			for _, c in CombatService:All("Monsters") do
				if string.match(c.Model.Name, "^Dummy_") then
					CombatService:Unregister(c.Id)
					c.Model:Destroy()
					count += 1
				end
			end
			return `{count} removed`
		end,
	})
end

function CombatService:Start()
	local t = Combat.Tuning()
	Players.RespawnTime = Config.Get("Tuning", "Player").RespawnSeconds
	local function joined(player: Player)
		setLife(player, "Alive", nil)
		player.CharacterAdded:Connect(function(character)
			watchCharacter(player, character)
		end)
		if player.Character then
			task.spawn(watchCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(joined)
	for _, player in Players:GetPlayers() do
		joined(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		clearLifeTask(player)
		local c = CombatService:PlayerCombatant(player)
		if c then
			CombatService:Unregister(c.Id)
		end
		fellAt[player] = nil
		respawnAt[player] = nil
	end)

	watchResidents()

	local step = 1 / math.max(t.HistoryHz, 1)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= step then
			acc = 0
			record(now(), t.HistorySeconds + 0.2)
		end
	end)
	task.spawn(dummyAttackLoop)
	log:Info("combat ready: players %d health, downed %d s, respawn %d s", Config.Get("Tuning", "Player").Health,
		Config.Get("Tuning", "Player").DownedSeconds, Config.Get("Tuning", "Player").RespawnSeconds)
end

return CombatService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CC"><Properties><string name="Name">CycleClock</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CycleClock: 4:30 cycles, day and Surge phases, the year counter, Years per Cycle and skips
	(bible Sections 5 and 23). Run place only.

	A cycle is a 3:00 day (building, digging, trips outside) then a 1:30 Surge (a breach wave
	below, a storm above, one disaster). The siren sounds 20 seconds before the Surge. A Surge
	ends when its time is up, or earlier when ThreatDirector calls EndSurge (its last monster
	died and its disaster is fixed). A boss Surge (an era boss, or the final Surge's Source)
	has no timer and ignores EndSurge: it ends when its boss is beaten (ObjectiveService's
	BossDefeated; Landon, Nov 8, 2026). Then the year counter jumps by Years per Cycle and the
	next cycle starts. The arithmetic (Years per Cycle, era bosses, the final Surge, Endless)
	is Shared.Rules.Clock; the published values are Shared.RunState.

	Skips: when every player in the run has pressed Ready (the SetReady remote) or is resting
	in a Quarters bed (SetResting, called by the bed interaction), the day jumps to the siren.
	Ready and resting both count only during a day before the siren, and both reset at the
	siren (Landon, Nov 8, 2026), so a player still in bed when a day starts lies down again.

	RunDirector drives it: Begin when the intro ends, Halt on a victory or a defeat, Resume
	(after SetEndless) for Keep Going. When the final Surge ends (the Source is beaten) the
	clock halts by itself, before the year jumps, and fires CenturySurvived.

	API:
		CycleClock.CycleStarted: Signal<number>              -- the cycle number (residents eat and drink)
		CycleClock.SirenStarted: Signal<SurgeKind, string?>  -- 20 s to the Surge: its kind and boss
		CycleClock.SurgeStarted: Signal<SurgeKind, string?>
		CycleClock.SurgeEnded: Signal<SurgeKind, string>     -- how: "Time", "Cleared" or "Boss"
		CycleClock.YearChanged: Signal<number, number>       -- year, previous year (aging)
		CycleClock.EraChanged: Signal<string, string>        -- era, previous era
		CycleClock.CenturySurvived: Signal<()>
		CycleClock.Skipped: Signal<()>                       -- everyone was ready
		CycleClock:Begin(), :Halt(), :Resume(), :SetEndless(on)
		CycleClock:EndSurge(): boolean                       -- ThreatDirector: this Surge is cleared (not a boss Surge)
		CycleClock:SetResting(player, on): boolean           -- a player lies down in or leaves a Quarters bed
		CycleClock:Phase(), :Year(), :Cycle(), :Era(), :YearsPerCycle(), :Surge(), :TimeLeft(), :IsRunning(), :TimeScale()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Clock = require(Shared.Rules.Clock)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("CycleClock")

export type CyclePhase = RunState.CyclePhase
export type SurgeKind = Clock.SurgeKind

local CycleClock = {
	Name = "CycleClock",
	Dependencies = { "SessionService", "ObjectiveService", "DevService" },
	CycleStarted = Signal.new() :: Signal.Signal<number>,
	SirenStarted = Signal.new() :: Signal.Signal<SurgeKind, string?>,
	SurgeStarted = Signal.new() :: Signal.Signal<SurgeKind, string?>,
	SurgeEnded = Signal.new() :: Signal.Signal<SurgeKind, string>,
	YearChanged = Signal.new() :: Signal.Signal<number, number>,
	EraChanged = Signal.new() :: Signal.Signal<string, string>,
	CenturySurvived = Signal.new() :: Signal.Signal<()>,
	Skipped = Signal.new() :: Signal.Signal<()>,
}

local MAX_TIME_SCALE = 100

local session: any = nil
local objectives: any = nil
local set: (string, any) -> () = function() end
local tuning: { [string]: any } = {}

local state: Clock.State = Clock.NewState()
local begun = false
local running = false -- the timers are live
local halted = false -- RunDirector stopped the clock (a victory or a defeat)
local devPaused = false -- DevTools paused it
local cycleEndPending = false -- stopped after the final Surge, before the year jumps
local openEnded = false -- this phase has no timer (a boss Surge)
local phase: CyclePhase? = nil
local surgeKind: SurgeKind = "Tutorial"
local surgeBoss: string? = nil
local phaseLength = 0 -- seconds of clock time
local endsAt = 0 -- server time
local sirenAt: number? = nil -- server time; nil once the siren sounds, and during Surges
local siren = false
local leftWhenStopped = 0 -- clock seconds left in the phase when the clock stopped
local sirenInWhenStopped: number? = nil
local scale = 1
local ready: { [Player]: boolean } = {}
local resting: { [Player]: boolean } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Publishing ------------------------------------------------------------------------------

local function publishTimes()
	set("PhaseLength", phaseLength)
	set("PhaseOpen", if openEnded then true else nil)
	if openEnded then
		set("PhaseEndsAt", nil)
		set("PhaseLeft", nil)
	elseif running then
		set("PhaseEndsAt", endsAt)
		set("PhaseLeft", nil)
	else
		set("PhaseEndsAt", nil)
		set("PhaseLeft", leftWhenStopped / scale)
	end
end

local function publishSurge()
	set("SurgeKind", surgeKind)
	set("SurgeBoss", surgeBoss)
end

local function publishYear()
	set("Cycle", state.Cycle)
	set("Year", state.Year)
	set("Era", Clock.EraOf(state.Year))
	set("YearsPerCycle", Clock.YearsPerCycle(state.Completed))
end

-- Ready and skips -------------------------------------------------------------------------

local startSiren: () -> ()
local skipToSiren: (why: string) -> ()

-- A skip is possible during a day, before the siren.
local function canSkip(): boolean
	return running and phase == "Day" and sirenAt ~= nil
end

local function countReady(leaving: Player?)
	local inRun = 0
	local count = 0
	for _, player in session:ReadyPlayers() do
		if player ~= leaving then
			inRun += 1
			if ready[player] or resting[player] then
				count += 1
			end
		end
	end
	set("ReadyCount", count)
	set("ReadyNeeded", inRun)
	if inRun > 0 and count == inRun and canSkip() then
		skipToSiren("everyone is ready")
	end
end

local function setReady(player: Player, on: boolean)
	if (ready[player] == true) == on then
		return
	end
	ready[player] = if on then true else nil
	player:SetAttribute("Ready", on)
	countReady()
end

local function clearReady()
	for player in ready do
		if player.Parent then
			player:SetAttribute("Ready", false)
		end
	end
	table.clear(ready)
end

local function clearResting()
	for player in resting do
		if player.Parent then
			player:SetAttribute("Resting", false)
		end
	end
	table.clear(resting)
end

-- The SetReady remote and DevTools: Ready only counts during a day, before the siren.
local function requestReady(player: Player, on: boolean): boolean
	if not session:IsReady(player) then
		return false
	end
	if on and not canSkip() then
		return false
	end
	setReady(player, on)
	return true
end

-- Phases ----------------------------------------------------------------------------------

startSiren = function()
	sirenAt = nil
	siren = true
	set("Siren", true)
	clearReady()
	clearResting()
	countReady()
	log:Debug("cycle %d: siren (%s Surge)", state.Cycle, surgeKind)
	CycleClock.SirenStarted:Fire(surgeKind, surgeBoss)
end

skipToSiren = function(why: string)
	endsAt = now() + tuning.SurgeSirenSeconds / scale
	publishTimes()
	log:Info("cycle %d: %s; the day skips to the siren", state.Cycle, why)
	CycleClock.Skipped:Fire()
	startSiren()
end

local function startDay()
	phase = "Day"
	phaseLength = tuning.DaySeconds
	local t = now()
	endsAt = t + phaseLength / scale
	sirenAt = t + math.max(0, phaseLength - tuning.SurgeSirenSeconds) / scale
	siren = false
	openEnded = false
	surgeKind, surgeBoss = Clock.SurgeKind(state)
	clearReady()
	clearResting()
	set("CyclePhase", "Day")
	set("Siren", false)
	publishSurge()
	publishTimes()
	log:Info("cycle %d, Year %d: day (next Surge: %s)", state.Cycle, state.Year, surgeKind)
	CycleClock.CycleStarted:Fire(state.Cycle)
	countReady()
end

local function startSurge()
	surgeKind, surgeBoss = Clock.StartSurge(state)
	phase = "Surge"
	openEnded = Clock.IsOpenEnded(surgeKind)
	phaseLength = if openEnded then 0 else tuning.SurgeSeconds
	endsAt = if openEnded then math.huge else now() + phaseLength / scale
	sirenAt = nil
	siren = false
	clearReady()
	set("CyclePhase", "Surge")
	set("Siren", false)
	publishSurge()
	publishTimes()
	countReady()
	log:Info("cycle %d, Year %d: %s Surge %s", state.Cycle, state.Year, surgeKind, surgeBoss or "")
	CycleClock.SurgeStarted:Fire(surgeKind, surgeBoss)
end

local function endCycle()
	cycleEndPending = false
	local oldEra = Clock.EraOf(state.Year)
	local before, due = Clock.EndCycle(state)
	publishYear()
	if state.Year ~= before then
		CycleClock.YearChanged:Fire(state.Year, before)
	end
	local era = Clock.EraOf(state.Year)
	if era ~= oldEra then
		CycleClock.EraChanged:Fire(era, oldEra)
	end
	if due then
		log:Info("Year %d: %s comes at the next Surge", state.Year, due)
	end
	startDay()
end

local function freeze()
	if not running then
		return
	end
	local t = now()
	leftWhenStopped = if openEnded then 0 else math.max(0, endsAt - t) * scale
	sirenInWhenStopped = if sirenAt then math.max(0, sirenAt - t) * scale else nil
	running = false
	publishTimes()
end

local function thaw()
	if running or not begun or halted or devPaused then
		return
	end
	running = true
	if cycleEndPending then
		endCycle()
		return
	end
	local t = now()
	endsAt = if openEnded then math.huge else t + leftWhenStopped / scale
	sirenAt = if sirenInWhenStopped then t + sirenInWhenStopped / scale else nil
	publishTimes()
	countReady()
end

local function endSurge(how: string)
	local kind = surgeKind
	log:Info("cycle %d: %s Surge over (%s)", state.Cycle, kind, how)
	openEnded = false
	endsAt = now() -- nothing is left of it, however it ended
	cycleEndPending = true -- the year jumps next; if the clock stops first, Resume does it
	CycleClock.SurgeEnded:Fire(kind, how)
	if kind == "Final" then
		-- The century is over. Hold before the year jumps until RunDirector decides: a
		-- Century Victory, and Keep Going resumes the clock into Endless.
		if not halted then
			halted = true
			freeze()
			publishTimes()
			CycleClock.CenturySurvived:Fire()
		end
		return
	end
	if running then
		endCycle()
	end
end

local function tick()
	if not running then
		return
	end
	local t = now()
	if sirenAt and t >= sirenAt then
		startSiren()
	end
	if running and t >= endsAt then
		if phase == "Day" then
			startSurge()
		elseif phase == "Surge" then
			endSurge("Time")
		end
	end
end

local function setScale(value: number)
	local wasRunning = running
	if wasRunning then
		freeze()
	end
	scale = value
	if wasRunning then
		thaw()
	else
		publishTimes()
	end
	set("TimeScale", if scale == 1 then nil else scale)
end

-- API -------------------------------------------------------------------------------------

-- RunDirector: the intro is over; cycle 1 starts.
function CycleClock:Begin()
	if begun then
		return
	end
	begun = true
	running = true
	state.Completed = objectives:Completed()
	publishYear()
	startDay()
	if devPaused or halted then
		freeze()
	end
end

-- RunDirector: stop the clock (a victory or a defeat).
function CycleClock:Halt()
	halted = true
	freeze()
end

-- RunDirector: carry on after a Halt (Keep Going).
function CycleClock:Resume()
	if not halted then
		return
	end
	halted = false
	thaw()
end

-- RunDirector: Endless mode (no year cap, no more era bosses, Endless Surges).
function CycleClock:SetEndless(on: boolean)
	state.Endless = on
	if phase == "Day" then
		surgeKind, surgeBoss = Clock.SurgeKind(state)
		publishSurge()
	end
end

-- ThreatDirector: the Surge's last monster died and its disaster is fixed. A boss Surge
-- carries on until its boss is beaten, so this returns false then.
function CycleClock:EndSurge(): boolean
	if not running or phase ~= "Surge" or openEnded then
		return false
	end
	endSurge("Cleared")
	return true
end

-- The bed interaction: a player lies down in (or gets out of) a Quarters bed. Lying down
-- counts only during a day before the siren, like Ready; returns whether it counted.
function CycleClock:SetResting(player: Player, on: boolean): boolean
	if on and not canSkip() then
		return false
	end
	if (resting[player] == true) == on then
		return true
	end
	resting[player] = if on then true else nil
	player:SetAttribute("Resting", on)
	countReady()
	return true
end

-- Is the current phase a boss Surge with no timer?
function CycleClock:IsOpenEnded(): boolean
	return openEnded
end

function CycleClock:Phase(): CyclePhase?
	return phase
end

function CycleClock:Year(): number
	return state.Year
end

function CycleClock:Cycle(): number
	return state.Cycle
end

function CycleClock:Era(): string
	return Clock.EraOf(state.Year)
end

function CycleClock:YearsPerCycle(): number
	return Clock.YearsPerCycle(state.Completed)
end

-- The coming (during a day) or current Surge: its kind and boss.
function CycleClock:Surge(): (SurgeKind, string?)
	return surgeKind, surgeBoss
end

-- Real seconds left in the current phase.
function CycleClock:TimeLeft(): number
	if running then
		return math.max(0, endsAt - now())
	end
	return leftWhenStopped / scale
end

function CycleClock:IsRunning(): boolean
	return running
end

-- DevTools' time scale (1 normally): the economy runs at the same speed as the clock.
function CycleClock:TimeScale(): number
	return scale
end

-- DevTools --------------------------------------------------------------------------------

local function describe(): string
	local endless = if state.Endless then ", Endless" else ""
	local lines = {
		`cycle {state.Cycle}, Year {state.Year} ({Clock.EraOf(state.Year)}), {Clock.YearsPerCycle(state.Completed)} years per cycle{endless}`,
	}
	if not begun then
		table.insert(lines, "not started: the clock starts when the intro ends")
	else
		local stopped = ""
		if not running then
			local why = {}
			if devPaused then
				table.insert(why, "paused")
			end
			if halted then
				table.insert(why, "halted")
			end
			stopped = ` (stopped: {table.concat(why, ", ")})`
		end
		local sirenText = if siren then ", siren" else ""
		if openEnded then
			table.insert(lines, `{phase}: no timer, until {surgeBoss or "its boss"} is beaten{stopped}`)
		else
			table.insert(lines, `{phase} {string.format("%.1f", CycleClock:TimeLeft())} s left of {phaseLength} s{sirenText}{stopped}`)
		end
		local which = if phase == "Surge" then "this" else "next"
		local bossText = if surgeBoss then ` ({surgeBoss})` else ""
		local dueText = if state.PendingBoss then `, due: {state.PendingBoss}` else ""
		table.insert(lines, `{which} Surge: {surgeKind}{bossText}{dueText}`)
	end
	table.insert(lines, `ready {RunState.Get("ReadyCount") or 0}/{RunState.Get("ReadyNeeded") or 0}`)
	if scale ~= 1 then
		table.insert(lines, `time scale {scale}`)
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("clock", {
		Description = "The cycle clock: cycle, year, phase, time left, the coming Surge, ready count.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("clock.speed", {
		Description = "Run the clock faster or slower (1 is normal).",
		Usage = "clock.speed <0.1 to 100>",
		Run = function(_player, args): string?
			local value = tonumber(args[1])
			if not value or value < 0.1 or value > MAX_TIME_SCALE then
				return `usage: clock.speed <0.1 to {MAX_TIME_SCALE}>`
			end
			setScale(value)
			return describe()
		end,
	})
	dev:Register("clock.pause", {
		Description = "Pause the clock.",
		Run = function(): string?
			devPaused = true
			freeze()
			set("Paused", true)
			return describe()
		end,
	})
	dev:Register("clock.resume", {
		Description = "Resume a paused clock.",
		Run = function(): string?
			devPaused = false
			set("Paused", nil)
			thaw()
			return describe()
		end,
	})
	dev:Register("clock.next", {
		Description = "Jump to the next moment: day to siren, siren to Surge, Surge to the next cycle.",
		Run = function(): string?
			if not begun then
				return "the clock starts when the intro ends (run.skipintro)"
			elseif not running then
				return "the clock is stopped:\n" .. describe()
			end
			if phase == "Day" and sirenAt ~= nil then
				skipToSiren("DevTools")
			elseif phase == "Day" then
				startSurge()
			else
				endSurge("Time")
			end
			return describe()
		end,
	})
	dev:Register("clock.clear", {
		Description = "End the Surge as cleared (what ThreatDirector does when it is over).",
		Run = function(): string?
			if openEnded then
				return `a boss Surge lasts until its boss is beaten: boss.beat {surgeBoss or ""}`
			end
			if not CycleClock:EndSurge() then
				return "no running Surge to clear"
			end
			return describe()
		end,
	})
	dev:Register("boss.beat", {
		Description = "Beat a boss (the current Surge's by default), as the boss fight will: its objective, its Surge ends.",
		Usage = "boss.beat [bossId]",
		Run = function(_player, args): string?
			local id = if args[1] ~= nil then tostring(args[1]) else surgeBoss
			if not id then
				return "usage: boss.beat <bossId> (no boss Surge now)"
			end
			if not objectives:BossBeaten(id) then
				return `{id}: unknown, or already beaten`
			end
			return `{id} beaten\n{describe()}`
		end,
	})
	dev:Register("year", {
		Description = "Set the year counter (bosses come only when a cycle's jump reaches an era's end).",
		Usage = "year <1 to 100, more in Endless>",
		Run = function(_player, args): string?
			local value = tonumber(args[1])
			local top = if state.Endless then 100000 else tuning.FinalYear
			if not value or value ~= math.floor(value) or value < 1 or value > top then
				return `usage: year <1 to {top}>`
			end
			local before = state.Year
			local oldEra = Clock.EraOf(before)
			state.Year = value
			publishYear()
			if phase == "Day" then
				surgeKind, surgeBoss = Clock.SurgeKind(state)
				publishSurge()
			end
			if value ~= before then
				CycleClock.YearChanged:Fire(value, before)
			end
			if Clock.EraOf(value) ~= oldEra then
				CycleClock.EraChanged:Fire(Clock.EraOf(value), oldEra)
			end
			return describe()
		end,
	})
	dev:Register("ready.all", {
		Description = "Set Ready for every player, as if each pressed the button.",
		Usage = "ready.all [true|false]",
		Run = function(_player, args): string?
			local on = args[1] ~= false
			for _, player in session:ReadyPlayers() do
				requestReady(player, on)
			end
			return describe()
		end,
	})
	dev:Register("rest.all", {
		Description = "Put every player in (or out of) a Quarters bed, as the bed interaction will.",
		Usage = "rest.all [true|false]",
		Run = function(_player, args): string?
			local on = args[1] ~= false
			for _, player in session:ReadyPlayers() do
				CycleClock:SetResting(player, on)
			end
			return describe()
		end,
	})
end

-- Lifecycle -------------------------------------------------------------------------------

function CycleClock:Init(registry)
	session = registry.SessionService
	objectives = registry.ObjectiveService
	set = RunState.Writer("CycleClock")
	tuning = Clock.Tuning()
	publishYear()
	set("ReadyCount", 0)
	set("ReadyNeeded", 0)

	Remotes.OnServer("SetReady", function(player: Player, on: boolean)
		requestReady(player, on)
	end)
	registerCommands(registry.DevService)
end

function CycleClock:Start()
	objectives.Changed:Connect(function()
		state.Completed = objectives:Completed()
		set("YearsPerCycle", Clock.YearsPerCycle(state.Completed))
	end)
	objectives.BossDefeated:Connect(function(bossId: string)
		-- A boss Surge ends when its boss falls (even if a DevTools pause holds the clock;
		-- the year then jumps on resume).
		if begun and not halted and phase == "Surge" and openEnded and surgeBoss == bossId then
			endSurge("Boss")
		end
	end)
	session.PlayerReady:Connect(function(player: Player)
		player:SetAttribute("Ready", false)
		player:SetAttribute("Resting", false)
		countReady()
	end)
	session.PlayerLeaving:Connect(function(player: Player)
		ready[player] = nil
		resting[player] = nil
		countReady(player)
	end)
	RunService.Heartbeat:Connect(tick)
end

return CycleClock
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CD"><Properties><string name="Name">DevService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DevService: DevTools commands (bible Section 23: test commands gated to Studio and
	admins).

	Services register their own commands in Init:

		registry.DevService:Register("year", {
			Description = "Set the year counter.",
			Usage = "year <number>",
			Run = function(player, args) ... return "Year is now 25" end,
		})

	Three ways in, all through Execute:
	* in a game, an allowed player types `/dev <command> [args]` in chat (DevController sends
	  the DevCommand remote; permission is checked here, never trusted from the client);
	* in a Studio playtest, tools call ServerScriptService.DevTools.Invoke (a
	  BindableFunction made only in Studio): `Invoke:Invoke("test")`;
	* in Studio, the data tests and StructureCheck run once when the server starts.

	Allowed: everyone in Studio; outside Studio only Constants.ADMIN_USER_IDS. Players get a
	DevAllowed attribute so their client can show the command.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local BuildInfo = require(Shared.BuildInfo) :: any
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local TableUtil = require(Shared.Utilities.TableUtil)
local Types = require(Shared.Types)

local log = Log.new("DevService")
local IS_STUDIO = RunService:IsStudio()
local MAX_OUTPUT = 3000

local DevService = {
	Name = "DevService",
	Dependencies = {},
}

local commands: { [string]: Types.DevCommand } = {}

function DevService:IsAllowed(player: Player?): boolean
	if IS_STUDIO then
		return true
	end
	return player ~= nil and Constants.ADMIN_USER_IDS[player.UserId] == true
end

function DevService:Register(name: string, command: Types.DevCommand)
	assert(type(name) == "string" and string.find(name, "^[%w_%.%-]+$"), "DevService: command names are words")
	assert(commands[name] == nil, `DevService: command {name} is already registered`)
	assert(type(command.Run) == "function" and type(command.Description) == "string", "DevService: bad command")
	commands[name] = command
end

-- Runs a command for a player (nil = Studio tooling). Returns ok and the output text.
function DevService:Execute(player: Player?, name: string, args: { any }): (boolean, string)
	if not DevService:IsAllowed(player) then
		return false, "not allowed"
	end
	local command = commands[name]
	if not command then
		return false, `no command {name}; try help`
	end
	local who = if player then player.Name else "studio"
	local shown = {}
	for _, arg in args do
		table.insert(shown, tostring(arg))
	end
	log:Info("%s ran %s %s", who, name, table.concat(shown, " "))
	local ok, result = xpcall(command.Run, debug.traceback, player, args)
	if not ok then
		log:Error("%s failed: %s", name, tostring(result))
		return false, `{name} failed: {tostring(result)}`
	end
	local text = if result == nil then "done" else tostring(result)
	if #text > MAX_OUTPUT then
		text = string.sub(text, 1, MAX_OUTPUT) .. "\n...(cut)"
	end
	return true, text
end

local function splitLine(line: string): (string, { any })
	local words = {}
	for word in string.gmatch(line, "%S+") do
		local number = tonumber(word)
		if word == "true" then
			table.insert(words, true)
		elseif word == "false" then
			table.insert(words, false)
		elseif number ~= nil and number == number and math.abs(number) ~= math.huge then
			table.insert(words, number)
		else
			table.insert(words, word)
		end
	end
	local name = table.remove(words, 1)
	return tostring(name or "help"), words
end

local function runChecks(): string
	local DevTools = ServerScriptService:FindFirstChild("DevTools")
	if not DevTools then
		return "DevTools folder missing"
	end
	local lines = {}
	local structure = require(DevTools:FindFirstChild("StructureCheck") :: ModuleScript) :: any
	local tests = require(DevTools:FindFirstChild("DataTests") :: ModuleScript) :: any
	table.insert(lines, structure.Format(structure.Run({ Runtime = true })))
	table.insert(lines, tests.Format(tests.Run()))
	return table.concat(lines, "\n")
end

local function registerBuiltIns()
	DevService:Register("help", {
		Description = "List commands.",
		Run = function(): string?
			local lines = {}
			for _, name in TableUtil.SortedKeys(commands) do
				local command = commands[name]
				table.insert(lines, `{command.Usage or name}: {command.Description}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	DevService:Register("version", {
		Description = "Build, place and server.",
		Run = function(): string?
			return `{Constants.GAME_NAME} {BuildInfo.Label} | {Constants.PlaceKind()} | job {game.JobId} | Studio {IS_STUDIO}`
		end,
	})
	DevService:Register("ping", {
		Description = "Round trip check.",
		Run = function(player: Player?): string?
			local who = if player then player.Name else "studio"
			return `pong {who} at {string.format("%.3f", workspace:GetServerTimeNow())}`
		end,
	})
	DevService:Register("structure", {
		Description = "Run StructureCheck (instances, scripts, remotes, config).",
		Run = function(): string?
			local DevTools = ServerScriptService:FindFirstChild("DevTools")
			local structure = require((DevTools :: Instance):FindFirstChild("StructureCheck") :: ModuleScript) :: any
			return structure.Format(structure.Run({ Runtime = true }))
		end,
	})
	DevService:Register("test", {
		Description = "Run the data tests.",
		Usage = "test [name filter]",
		Run = function(_player: Player?, args: { any }): string?
			local DevTools = ServerScriptService:FindFirstChild("DevTools")
			local tests = require((DevTools :: Instance):FindFirstChild("DataTests") :: ModuleScript) :: any
			return tests.Format(tests.Run(if args[1] then tostring(args[1]) else nil))
		end,
	})
	DevService:Register("log", {
		Description = "Show or set the server log level (Debug, Info, Warn, Error).",
		Usage = "log [level]",
		Run = function(_player: Player?, args: { any }): string?
			local level = args[1]
			if level ~= nil then
				if not Log.IsLevel(level) then
					return "levels: Debug, Info, Warn, Error"
				end
				Log.SetLevel(level :: Log.Level)
			end
			return `server log level {Log.GetLevel()}`
		end,
	})
	DevService:Register("logs", {
		Description = "The last server log lines.",
		Usage = "logs [count]",
		Run = function(_player: Player?, args: { any }): string?
			local count = if type(args[1]) == "number" then args[1] else 20
			return table.concat(Log.Recent(count), "\n")
		end,
	})
	DevService:Register("remotes", {
		Description = "Traffic and rejections per remote.",
		Run = function(): string?
			local lines = {}
			local stats = Remotes.Stats()
			for _, name in TableUtil.SortedKeys(stats) do
				local s = stats[name]
				table.insert(
					lines,
					`{name}: received {s.Received}, rejected {s.Rejected}, rate-limited {s.Limited}, failed {s.Failed}`
				)
			end
			return table.concat(lines, "\n")
		end,
	})
	DevService:Register("players", {
		Description = "Players and their session state.",
		Run = function(): string?
			local lines = {}
			for _, player in Players:GetPlayers() do
				table.insert(
					lines,
					`{player.Name} ({player.UserId}) ready={tostring(player:GetAttribute("ClientReady") == true)}`
				)
			end
			return if #lines > 0 then table.concat(lines, "\n") else "no players"
		end,
	})
end

function DevService:Init(_registry)
	registerBuiltIns()
	Remotes.OnServer("DevCommand", function(player: Player, name: string, args: { any })
		local ok, text = DevService:Execute(player, name, args)
		if not ok and text == "not allowed" then
			log:Warn("%s (%d) tried dev command %s without permission", player.Name, player.UserId, name)
			return
		end
		local prefix = if ok then "" else "error: "
		Remotes.FireClient("Notice", player, prefix .. text)
	end)
end

function DevService:Start()
	local function mark(player: Player)
		player:SetAttribute("DevAllowed", DevService:IsAllowed(player))
	end
	Players.PlayerAdded:Connect(mark)
	for _, player in Players:GetPlayers() do
		mark(player)
	end

	if IS_STUDIO then
		local DevTools = ServerScriptService:FindFirstChild("DevTools")
		if DevTools then
			local invoke = Instance.new("BindableFunction")
			invoke.Name = "Invoke"
			invoke.OnInvoke = function(line: any, ...: any): string
				if type(line) ~= "string" then
					return "usage: Invoke:Invoke(\"command arg1 arg2\")"
				end
				local name, args = splitLine(line)
				for _, extra in { ... } do
					table.insert(args, extra)
				end
				local ok, text = DevService:Execute(nil, name, args)
				return (if ok then "" else "error: ") .. text
			end
			invoke.Parent = DevTools
			if DevTools:GetAttribute("RunChecksOnStart") ~= false then
				task.defer(function()
					log:Info("Studio start checks:\n%s", runChecks())
				end)
			end
		end
	end
end

return DevService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CE"><Properties><string name="Name">DigService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DigService: digging, what a dug cell holds, Push Deeper, the Drill Bay's queue and
	Disturbance (bible Sections 6, 7, 10 and 14). Run place only; Prompt 14. The arithmetic is
	Shared.Rules.Dig and Shared.Rules.Loot; the numbers are Config.DepthBands, Config.DigResults,
	Config.LootTables, Tuning.Digging and Tuning.Disturbance (provisional ones marked there).

	* Digging (Section 6): every Rock cell left of, right of or below an open cell has a dig
	  prompt at each face it can be dug from (Rules.Dig.Faces): on the wall line for a side, on
	  the floor of the cell above for digging down. Players who carry a Drill or a Pickaxe hold
	  Interact there (the prompt only shows to them); the cell takes its band's DigSeconds, the
	  Driller digs twice as fast (DigSpeed) and players on one cell stack. Progress stays when
	  they let go. The prompt's Progress attribute drives its gauge.
	* The Drill Bay (Sections 6 and 7): any player marks rock cells for its queue in the Command
	  View (MarkDig, no vote). Each working Drill Bay digs the first queued cell it can at
	  ResidentDigMultiplier of a player for each unit of its crew's output.
	* Push Deeper (Section 6): the first cell of a new band (floors 4, 7 and 10) needs a vote.
	  Trying to dig past RunState.DigLimit opens it (VoteService, Kind PushDeeper; solo runs pass
	  at once); a pass moves DigLimit to the band's last floor.
	* When a cell opens (BunkerGrid:Dig): Disturbance rises (DisturbancePerCell, DigDisturbance:
	  the Driller's level 3, Deep Charges), the cell's roll is applied (Rules.Dig.Roll, the same
	  all run, so the Driller's hints match), and now and then its passage caves in
	  (CaveInChance; Section 10: digging causes cave-ins).
	  * Ore pocket: the band's ore (Loot OrePocket; the Driller's DugOre) into the stockpile.
	  * Cave opening: a dark cave mouth in the back wall and a breach point (Section 10). The cave
	    behind it is Prompt 17's.
	  * Cache: a crate; holding Interact opens it: resources into the stockpile, throwables to
	    the player who opened it (Loot Cache; gear and radio logs wait for their prompts).
	  * Nest: monsters pour out at once (ThreatDirector:Burst), it is a breach point while it
	    lives and raises Disturbance every cycle (NestPerCycle); destroying it (it is a monster
	    combatant, NestHealth) pays Loot Nest and drops Disturbance by NestDestroyed.
	  * Hazard pockets (gas and water, Prompt 23) and cryo pods (Era II, Prompt 17) count as
	    Empty until their systems exist.
	  Nothing is built on a cell with a nest, a cache or a cave opening (BuildService:SetCellCheck).
	* Disturbance (Section 10): RunState.Disturbance 0 to 100. Digging, explosives
	  (WeaponService.Exploded, Explosive) and living nests raise it; it falls DecayPerCycle each
	  cycle and NestDestroyed when a nest is destroyed. Crossing ExtraBreachAt brings an extra
	  small breach (ThreatDirector:ExtraBreach); reaching TremorAt is a Tremor: a full breach wave
	  at once (ThreatDirector:Tremor), a cave-in (Section 10: Tremors cause cave-ins), the camera
	  shakes (RunState.TremorAt), and the meter drops to AfterTremor.
	* The Command View sees digging in front of each rock cell being dug or queued: a hazard
	  frame and a bar that fills with progress.

	Replication: the Digs collection, "S:<floor>,<column>" -> { Floor, Column, Progress, Diggers,
	Queue, Bay, Vote } for cells being dug or queued, "F:<floor>,<column>" -> { Floor, Column,
	Kind } for what dug cells hold (CaveOpening, Cache, Nest). RunState Disturbance, DigLimit,
	DigSeed, TremorAt and Nests.

	API:
		DigService:Disturbance(): number
		DigService:AddDisturbance(amount, source)        -- Overdrive, Breaching Charges (Prompt 20)
		DigService:DigNow(floor, column, cause, player?): (boolean, string?) -- abilities, DevTools
		DigService:Mark(floor, column, on, player?): (boolean, string?)
		DigService:SetModifier(source, key, value?)      -- DigSpeed, DigDisturbance (team-wide)
		DigService:Feature(floor, column): string?
		DigService.Dug: Signal<number, number, string, string, Player?> -- floor, column, result, cause, who finished it
	Dev: digs, dig, dig.roll, dig.mark, disturbance, disturbance.add, tremor, pushdeeper, nest, cache, cave.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Dig = require(Shared.Rules.Dig)
local Disasters = require(Shared.Rules.Disasters)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Loot = require(Shared.Rules.Loot)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("DigService")

local DigService = {
	Name = "DigService",
	Dependencies = {
		"BunkerGrid", "CycleClock", "RunDirector", "SessionService", "ReplicationService", "EconomyService", "WeaponService",
		"CombatService", "VoteService", "BuildService", "BreachService", "ThreatDirector", "DisasterService", "DevService",
	},
	Dug = Signal.new() :: Signal.Signal<number, number, string, string, Player?>,
}

-- Results whose systems exist; the rest count as Empty (hazard pockets: Prompt 23; cryo pods: 17).
local AVAILABLE: { [string]: boolean } = { Empty = true, OrePocket = true, CaveOpening = true, Cache = true, Nest = true }
-- Loot specials nothing hands out yet: gear (Prompt 26), radio logs (the Codex), and the rest.
local SKIP_SPECIALS: { [string]: boolean } = { Gear = true, RadioLog = true, Blueprint = true, Recruit = true, Glowshards = true }
local CAMERA_IGNORE_TAG = "CameraIgnore"
local MARK_COLOR = Color3.fromHex("#F2C14E") -- Hazard Yellow
local FILL_COLOR = Color3.fromHex("#E8743B") -- Signal Orange
local MAX_QUEUE = 12

type Site = {
	Key: string,
	Floor: number,
	Column: number,
	Progress: number,
	Diggers: { [Player]: number }, -- player -> speed
	Bay: boolean, -- a Drill Bay is digging it this tick
	Sent: string,
}
type Feature = {
	Key: string,
	Floor: number,
	Column: number,
	Kind: string, -- "CaveOpening" | "Cache" | "Nest"
	Model: Model?,
	CombatId: string?,
}

local grid: any = nil
local clock: any = nil
local director: any = nil
local session: any = nil
local economy: any = nil
local weapons: any = nil
local combat: any = nil
local votes: any = nil
local builds: any = nil
local breaches: any = nil
local threat: any = nil
local disasters: any = nil
local collection: any = nil
local set: (string, any) -> () = function() end

local rng = Random.new()
local sites: { [string]: Site } = {}
local queue: { string } = {}
local features: { [string]: Feature } = {}
local disturbance = 0
local limit = 3
local seed = 0
local votesOpen: { [number]: string } = {} -- a band's first floor -> its vote id
local retryAt: { [number]: number } = {}
local modifiers: { [string]: { [string]: number } } = {} -- key -> source -> value
local prompts: { [string]: { Part: BasePart, Prompt: ProximityPrompt, Key: string } } = {} -- "<key>|<side>"
local markers: { [string]: Model } = {}
local folder: Folder? = nil

-- Helpers -------------------------------------------------------------------------------------------

local function now(): number
	return workspace:GetServerTimeNow()
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function eraNumber(): number
	return table.find(Config.Ids("Eras"), clock:Era()) or 1
end

local function teamValue(key: string): number
	local value = 1
	for _, v in modifiers[key] or {} do
		value *= v
	end
	return value
end

local function classValue(player: Player?, key: string): number
	if not player then
		return 1
	end
	return Modifiers.ClassValue(player:GetAttribute("Class") :: string?, key) or 1
end

local function holder(): Folder?
	if folder and folder.Parent then
		return folder
	end
	local root = grid:Root()
	if not root then
		return nil
	end
	local found = root:FindFirstChild("Digging")
	if not found then
		found = Instance.new("Folder")
		found.Name = "Digging"
		found.Parent = root
	end
	folder = found :: Folder
	return folder
end

local function art(category: string, name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local f = assets and assets:FindFirstChild(category)
	local found = f and f:FindFirstChild(name)
	return if found and found:IsA("Model") then found else nil
end

local function bandName(floor: number): string
	return string.upper(Grid.BandOf(floor).Name)
end

local function where(floor: number, column: number): string
	return `FLOOR {floor} · COLUMN {column}`
end

local function inRun(): boolean
	return director:Phase() == "Playing"
end

-- Disturbance --------------------------------------------------------------------------------------

local function tremorCaveIn()
	local bunker = grid:Bunker()
	local doorways = Disasters.Doorways(bunker)
	local deepest = grid:DeepestFloor()
	local near = {}
	for _, d in doorways do
		if d.Floor >= deepest - 1 then
			table.insert(near, d)
		end
	end
	local list = if #near > 0 then near else doorways
	if #list == 0 then
		return
	end
	local pick = list[rng:NextInteger(1, #list)]
	disasters:CaveIn(pick.Floor, pick.Column, pick.Side, "Tremor")
end

local function setDisturbance(value: number, source: string)
	local before = disturbance
	disturbance = math.clamp(value, 0, Dig.DisturbanceTuning().Max)
	local extra, tremor = Dig.Crossed(before, disturbance)
	if tremor then
		disturbance = Dig.AfterTremor()
		log:Info("TREMOR (%s): Disturbance %.0f -> %.0f", source, before, disturbance)
		set("TremorAt", now())
		announce("Danger", "TREMOR! THE DEEP IS AWAKE: MONSTERS ARE BREAKING IN EVERYWHERE")
		if inRun() then
			local ok, err = pcall(function()
				threat:Tremor()
				tremorCaveIn()
			end)
			if not ok then
				log:Warn("tremor: %s", tostring(err))
			end
		end
	elseif extra then
		log:Info("Disturbance passed %d (%s): an extra breach", Dig.DisturbanceTuning().ExtraBreachAt, source)
		if inRun() then
			local ok, err = pcall(function()
				threat:ExtraBreach()
			end)
			if not ok then
				log:Warn("extra breach: %s", tostring(err))
			end
		end
	end
	set("Disturbance", math.floor(disturbance * 10 + 0.5) / 10)
end

function DigService:Disturbance(): number
	return disturbance
end

function DigService:AddDisturbance(amount: number, source: string)
	setDisturbance(Dig.AddDisturbance(disturbance, amount), source)
end

function DigService:SetModifier(source: string, key: string, value: number?)
	modifiers[key] = modifiers[key] or {}
	modifiers[key][source] = value
end

-- Sites and the Command View's marks ----------------------------------------------------------------

local function siteOf(key: string): Site?
	return sites[key]
end

local function getSite(floor: number, column: number): Site
	local key = Grid.Key(floor, column)
	local site = sites[key]
	if not site then
		site = { Key = key, Floor = floor, Column = column, Progress = 0, Diggers = {}, Bay = false, Sent = "" }
		sites[key] = site
	end
	return site
end

local function diggerCount(site: Site): number
	local n = 0
	for _ in site.Diggers do
		n += 1
	end
	return n
end

local function updateMarker(site: Site?, key: string)
	local floor, column = Grid.Parse(key)
	local queued = table.find(queue, key)
	local show = site ~= nil and (site.Progress > 0 or diggerCount(site) > 0 or site.Bay) or queued ~= nil
	local marker = markers[key]
	if not show or not floor or not column then
		if marker then
			marker:Destroy()
			markers[key] = nil
		end
		return
	end
	local parent = holder()
	if not parent then
		return
	end
	if not marker then
		local model = Instance.new("Model")
		model.Name = `Mark_{key}`
		local cell = Grid.CellPosition(floor, column)
		local pitch = Grid.Pitch()
		local t = Grid.Tuning()
		local z = cell.Z + pitch.Z / 2 + 1.2 -- in front of the rock face, where the Command View looks
		local w, h = t.CellWidth - 4, t.CellHeight - 3
		local centre = Vector3.new(cell.X, cell.Y + t.CellHeight / 2, z)
		local function bar(name: string, size: Vector3, at: Vector3, color: Color3)
			local p = Instance.new("Part")
			p.Name = name
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Color = color
			p.Size = size
			p.Position = at
			CollectionService:AddTag(p, CAMERA_IGNORE_TAG)
			p.Parent = model
			return p
		end
		bar("Top", Vector3.new(w, 0.5, 0.3), centre + Vector3.new(0, h / 2, 0), MARK_COLOR)
		bar("Bottom", Vector3.new(w, 0.5, 0.3), centre - Vector3.new(0, h / 2, 0), MARK_COLOR)
		bar("Left", Vector3.new(0.5, h, 0.3), centre - Vector3.new(w / 2, 0, 0), MARK_COLOR)
		bar("Right", Vector3.new(0.5, h, 0.3), centre + Vector3.new(w / 2, 0, 0), MARK_COLOR)
		local fill = bar("Fill", Vector3.new(0.1, 1.6, 0.35), centre - Vector3.new(w / 2 - 0.05, h / 2 - 1.6, 0), FILL_COLOR)
		fill:SetAttribute("Left", (centre - Vector3.new(w / 2 - 0.5, h / 2 - 1.6, 0)))
		fill:SetAttribute("Width", w - 1)
		model:SetAttribute("Cell", key)
		model.Parent = parent
		markers[key] = model
		marker = model
	end
	local fill = (marker :: Model):FindFirstChild("Fill") :: BasePart?
	if fill then
		local progress = if site then site.Progress else 0
		local width = (fill:GetAttribute("Width") :: number?) or 20
		local left = fill:GetAttribute("Left") :: Vector3?
		local length = math.max(width * progress, 0.1)
		fill.Size = Vector3.new(length, fill.Size.Y, fill.Size.Z)
		if left then
			fill.Position = left + Vector3.new(length / 2, 0, 0)
		end
		fill.Transparency = if progress > 0 then 0 else 1
	end
end

local function publishSite(key: string)
	local site = siteOf(key)
	local queued = table.find(queue, key)
	local floor, column = Grid.Parse(key)
	if not floor or not column then
		return
	end
	local band = Grid.BandOf(floor)
	local vote = votesOpen[band.Floors.From] ~= nil and Dig.NeedsVote(floor, limit)
	if not site and not queued then
		collection:Remove(`S:{key}`)
	else
		local progress = if site then math.floor(site.Progress * 100) / 100 else 0
		local diggers = if site then diggerCount(site) else 0
		local bay = site ~= nil and site.Bay
		local sent = `{progress}|{diggers}|{queued or 0}|{bay}|{vote}`
		if not site or site.Sent ~= sent then
			collection:Set(`S:{key}`, {
				Floor = floor, Column = column, Progress = progress, Diggers = diggers, Queue = queued, Bay = bay, Vote = vote,
			})
			if site then
				site.Sent = sent
			end
		end
	end
	-- the prompts' gauges and words
	for _, entry in prompts do
		if entry.Key == key then
			entry.Prompt:SetAttribute("Progress", if site then site.Progress else 0)
		end
	end
	updateMarker(site, key)
end

local function dropSite(key: string)
	sites[key] = nil
	local index = table.find(queue, key)
	if index then
		table.remove(queue, index)
		for _, other in queue do
			publishSite(other)
		end
	end
	publishSite(key)
end

function DigService:Mark(floor: number, column: number, on: boolean, player: Player?): (boolean, string?)
	local key = Grid.Key(floor, column)
	if not Grid.OnGrid(floor, column) or grid:State(floor, column) ~= "Rock" then
		return false, "Only rock can go on the dig queue."
	end
	local index = table.find(queue, key)
	if on then
		if index then
			return true, nil
		end
		if #queue >= MAX_QUEUE then
			return false, `The dig queue is full ({MAX_QUEUE} cells).`
		end
		table.insert(queue, key)
		log:Info("%s queued %s (%d in the queue)", if player then player.Name else "DevTools", key, #queue)
	else
		if not index then
			return true, nil
		end
		table.remove(queue, index)
		log:Info("%s took %s off the queue", if player then player.Name else "DevTools", key)
	end
	for _, other in queue do
		publishSite(other)
	end
	publishSite(key)
	return true, nil
end

-- Features: what dug cells hold -----------------------------------------------------------------------

local function publishFeature(f: Feature?, key: string)
	if f then
		collection:Set(`F:{key}`, { Floor = f.Floor, Column = f.Column, Kind = f.Kind })
	else
		collection:Remove(`F:{key}`)
	end
	local nests = 0
	for _, other in features do
		if other.Kind == "Nest" then
			nests += 1
		end
	end
	set("Nests", nests)
end

-- Monsters come out in front of the cave mouth or the nest's maw (the back of the cell is -Z).
local function breachPoint(f: Feature, kind: string): any
	local cell = Grid.CellPosition(f.Floor, f.Column)
	local out = cell + Vector3.new(0, 0.5, if kind == "Nest" then -2.5 else -6)
	return {
		Id = `{if kind == "Nest" then "N" else "O"}:{f.Key}`,
		Kind = kind,
		RoomId = nil,
		Floor = f.Floor,
		Column = f.Column,
		Weight = 1,
		Dark = false,
		At = CFrame.lookAt(out, out + Vector3.new(0, 0, 1)),
		Source = cell + Vector3.new(0, 3, -13),
	}
end

local function placeModel(f: Feature, source: Model?, offset: CFrame): Model
	local model: Model
	if source then
		model = source:Clone()
	else
		model = Instance.new("Model")
	end
	model.Name = `{f.Kind}_{f.Key}`
	model:SetAttribute("Cell", f.Key)
	model:SetAttribute("Feature", f.Kind)
	local parent = holder()
	model.Parent = parent
	if #model:GetChildren() == 0 then
		-- graybox until the art arrives
		local p = Instance.new("Part")
		p.Name = "Graybox"
		p.Size = if f.Kind == "Nest" then Vector3.new(7, 5, 6) elseif f.Kind == "Cache" then Vector3.new(3, 2.4, 2.4)
			else Vector3.new(10, 9, 1)
		p.Color = if f.Kind == "Nest" then Color3.fromHex("#6E4766") elseif f.Kind == "Cache" then Color3.fromHex("#5E6A44")
			else Color3.fromHex("#1B2A3A")
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.Parent = model
		model.PrimaryPart = p
		p.CFrame = Grid.CellCFrame(f.Floor, f.Column) * offset * CFrame.new(0, p.Size.Y / 2, 0)
		model.WorldPivot = Grid.CellCFrame(f.Floor, f.Column) * offset
	else
		model:PivotTo(Grid.CellCFrame(f.Floor, f.Column) * offset)
		if not model.PrimaryPart then
			-- the biggest part is the root (CombatService registers a nest by it)
			local best, volume = nil, 0
			for _, part in model:GetDescendants() do
				if part:IsA("BasePart") and part.Size.X * part.Size.Y * part.Size.Z > volume then
					best, volume = part, part.Size.X * part.Size.Y * part.Size.Z
				end
			end
			model.PrimaryPart = best
		end
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			if f.Kind ~= "Nest" then
				part.CanCollide = false
			end
		end
	end
	return model
end

local function removeFeature(key: string, how: string)
	local f = features[key]
	if not f then
		return
	end
	features[key] = nil
	if f.Kind == "CaveOpening" then
		breaches:SetExtraPoint(`O:{key}`, nil)
	elseif f.Kind == "Nest" then
		breaches:SetExtraPoint(`N:{key}`, nil)
		if f.CombatId then
			combat:Unregister(f.CombatId)
		end
	end
	if f.Model then
		f.Model:Destroy()
	end
	publishFeature(nil, key)
	log:Info("%s at %s gone (%s)", f.Kind, key, how)
end

local function giveDrops(drops: { Loot.Drop }, player: Player?, why: string): { Loot.Drop }
	local given: { Loot.Drop } = {}
	for _, drop in drops do
		if drop.Resource then
			local added = economy:Add(drop.Resource, drop.Count, why)
			if added and added > 0 then
				table.insert(given, { Resource = drop.Resource, Count = added })
			end
		elseif drop.Item and player then
			local took = weapons:GiveThrowable(player, drop.Item, drop.Count)
			if took > 0 then
				table.insert(given, { Item = drop.Item, Count = took })
			end
		end
	end
	return given
end

local function openCache(f: Feature, player: Player)
	if features[f.Key] ~= f then
		return
	end
	local band = Grid.BandOf(f.Floor)
	local drops = Loot.Roll("Cache", rng, { BandOre = band.Ore, Skip = SKIP_SPECIALS })
	local given = giveDrops(drops, player, `cache {f.Key}`)
	removeFeature(f.Key, "Opened")
	announce("Info", `{string.upper(player.DisplayName)} OPENED THE CACHE: {if #given > 0 then Loot.Text(given) else "NOTHING LEFT IN IT"}`)
end

local function destroyNest(f: Feature, killer: Player?)
	if features[f.Key] ~= f then
		return
	end
	local band = Grid.BandOf(f.Floor)
	local drops = Loot.Roll("Nest", rng, { BandOre = band.Ore, Skip = SKIP_SPECIALS })
	local given = giveDrops(drops, killer, `nest {f.Key}`)
	f.Model = nil -- CombatService dissolves a dead combatant's model itself
	f.CombatId = nil
	removeFeature(f.Key, "Destroyed")
	DigService:AddDisturbance(-Dig.DisturbanceTuning().NestDestroyed, "NestDestroyed")
	announce("Info", `THE NEST IS DESTROYED: {if #given > 0 then Loot.Text(given) else "NOTHING"} · DISTURBANCE -{Dig.DisturbanceTuning().NestDestroyed}`)
end

local function addFeature(kind: string, floor: number, column: number): Feature
	local key = Grid.Key(floor, column)
	removeFeature(key, "Replaced")
	local f: Feature = { Key = key, Floor = floor, Column = column, Kind = kind, Model = nil, CombatId = nil }
	features[key] = f
	local depth = Grid.Tuning().CellDepth
	if kind == "CaveOpening" then
		-- 2 studs off the back wall: the dug cell's rock face bulges up to 2 studs into the room
		f.Model = placeModel(f, art("Kit", "Kit_CaveMouth"), CFrame.new(0, 0, depth / 2 - 2))
		breaches:SetExtraPoint(`O:{key}`, breachPoint(f, "Cave"))
	elseif kind == "Cache" then
		-- towards the back and to the right, clear of the dug cells' dressing (the Mines' ore cart)
		local model = placeModel(f, art("Props", "Prop_SupplyCrate"), CFrame.new(-6, 0, 5) * CFrame.Angles(0, math.rad(-18), 0))
		f.Model = model
		local _, size = model:GetBoundingBox()
		local spot = Instance.new("Part")
		spot.Name = "CachePrompt"
		spot.Anchored = true
		spot.CanCollide = false
		spot.CanQuery = false
		spot.CanTouch = false
		spot.Transparency = 1
		spot.Size = Vector3.new(1, 1, 1)
		spot.CFrame = model:GetPivot() + Vector3.new(0, size.Y + 0.5, 0)
		spot.Parent = model
		local p = Instance.new("ProximityPrompt")
		p.ActionText = "Open the cache"
		p.ObjectText = "Dug up · loot for the team"
		p.HoldDuration = Dig.Tuning().CacheOpenSeconds
		p.MaxActivationDistance = 9
		p.RequiresLineOfSight = false
		p.Style = Enum.ProximityPromptStyle.Custom
		p:SetAttribute("Kind", "OpenCache")
		p.Parent = spot
		p.Triggered:Connect(function(player: Player)
			openCache(f, player)
		end)
	elseif kind == "Nest" then
		local model = placeModel(f, art("Props", "Prop_Nest"), CFrame.new(0, 0, 8))
		f.Model = model
		-- an ordinary monster id (M<n>): FireWeapon only takes those as hits
		local id = combat:Register(model, {
			Kind = "Monster", Team = "Monsters", Health = Dig.Tuning().NestHealth, MonsterType = "Nest",
		})
		f.CombatId = id
		breaches:SetExtraPoint(`N:{key}`, breachPoint(f, "Nest"))
	end
	publishFeature(f, key)
	return f
end

function DigService:Feature(floor: number, column: number): string?
	local f = features[Grid.Key(floor, column)]
	return if f then f.Kind else nil
end

-- Opening a cell ----------------------------------------------------------------------------------------

local function sideOf(floor: number, column: number, from: { Floor: number, Column: number }?): string?
	if not from or from.Floor ~= floor then
		return nil
	end
	return if from.Column < column then "Left" else "Right"
end

local function applyRoll(result: string, floor: number, column: number, finisher: Player?): string
	local band = Grid.BandOf(floor)
	if result == "OrePocket" then
		if not band.Ore then
			return "the rock is bare"
		end
		local drops = Loot.Roll("OrePocket", rng, { BandOre = band.Ore, OreMultiplier = classValue(finisher, "DugOre") })
		local given = giveDrops(drops, finisher, `ore pocket {Grid.Key(floor, column)}`)
		return `AN ORE POCKET: {if #given > 0 then Loot.Text(given) else "THE STOCKPILE IS FULL"}`
	elseif result == "CaveOpening" then
		addFeature("CaveOpening", floor, column)
		return "A CAVE OPENING: SOMETHING CAN COME THROUGH IT"
	elseif result == "Cache" then
		addFeature("Cache", floor, column)
		return "A CACHE: OPEN IT FOR THE TEAM"
	elseif result == "Nest" then
		local f = addFeature("Nest", floor, column)
		local at = Grid.CellCFrame(f.Floor, f.Column) * CFrame.new(0, 0.5, 3) * CFrame.Angles(0, math.pi, 0)
		local ok, err = pcall(function()
			threat:Burst(Dig.Tuning().NestBudget, at, `Nest:{f.Key}`)
		end)
		if not ok then
			log:Warn("nest burst: %s", tostring(err))
		end
		return "A NEST! MONSTERS POUR OUT · DESTROY IT"
	end
	return ""
end

local function open(floor: number, column: number, cause: string, finisher: Player?, from: { Floor: number, Column: number }?): (boolean, string?)
	local ok, why = grid:Dig(floor, column)
	if not ok then
		return false, why
	end
	local key = Grid.Key(floor, column)
	sites[key] = nil
	local index = table.find(queue, key)
	if index then
		table.remove(queue, index)
	end
	-- Section 10: every dug cell adds Disturbance (the Driller's level 3, Deep Charges)
	local amount = Dig.Tuning().DisturbancePerCell * classValue(finisher, "DigDisturbance") * teamValue("DigDisturbance")
	DigService:AddDisturbance(amount, "Digging")
	local result = Dig.Roll(seed, floor, column, eraNumber(), AVAILABLE)
	local found = applyRoll(result, floor, column, finisher)
	log:Info("dug %s (%s, %s): %s", key, cause, if finisher then finisher.Name else "-", result)
	announce(if result == "Nest" then "Danger" else "Info",
		`DUG THROUGH TO {where(floor, column)}{if found ~= "" then `: {found}` else ""}`)
	for _, other in queue do
		publishSite(other)
	end
	publishSite(key)
	-- Section 10: digging causes cave-ins, now and then the passage it was dug through
	local side = sideOf(floor, column, from)
	if side and rng:NextNumber() < Dig.Tuning().CaveInChance then
		task.defer(function()
			disasters:CaveIn(floor, column, side, "Digging")
		end)
	end
	DigService.Dug:Fire(floor, column, result, cause, finisher)
	return true, nil
end

function DigService:DigNow(floor: number, column: number, cause: string, player: Player?): (boolean, string?)
	local faces = Dig.Faces(grid:Bunker(), floor, column)
	return open(floor, column, cause, player, faces[1])
end

-- Push Deeper ------------------------------------------------------------------------------------------

local function setLimit(value: number)
	limit = value
	set("DigLimit", limit)
end

local function askPushDeeper(player: Player, floor: number, column: number)
	local band = Grid.BandOf(floor)
	local first = band.Floors.From
	if votesOpen[first] then
		Remotes.FireClient("Alert", player, "Info", `THE PUSH DEEPER VOTE IS ON: VOTE ON THE BANNER`)
		return
	end
	local wait = (retryAt[first] or 0) - os.clock()
	if wait > 0 then
		Remotes.FireClient("Alert", player, "Warning", `THE TEAM SAID NO TO PUSHING DEEPER: ASK AGAIN IN {math.ceil(wait)} S`)
		return
	end
	local key = Grid.Key(floor, column)
	local id, err = votes:Open({
		Kind = "PushDeeper",
		Proposer = player,
		Title = `PUSH DEEPER: THE {string.upper(band.Name)}`,
		Subject = { Floor = floor, Column = column, Span = 1, Label = "PUSH DEEPER" },
		Cells = { key },
		Check = function(): (boolean, string?)
			return true, nil
		end,
		OnPass = function()
			votesOpen[first] = nil
			if limit < Dig.LimitAfter(floor) then
				setLimit(Dig.LimitAfter(floor))
			end
			log:Info("Push Deeper passed: the %s (dig to floor %d)", band.Name, limit)
			announce("Info", `PUSH DEEPER: THE TEAM OPENS THE {string.upper(band.Name)} · DIG DOWN TO FLOOR {limit}`)
			for k in sites do
				publishSite(k)
			end
		end,
		OnFail = function(reason: string)
			votesOpen[first] = nil
			retryAt[first] = os.clock() + Dig.Tuning().VoteRetrySeconds
			log:Info("Push Deeper failed: %s", reason)
			for k in sites do
				publishSite(k)
			end
		end,
	})
	if not id then
		Remotes.FireClient("Alert", player, "Warning", string.upper(err or "THE VOTE COULDN'T START"))
		return
	end
	if id ~= "solo" and limit < floor then
		votesOpen[first] = id
	end
	publishSite(key)
end

-- Players digging ----------------------------------------------------------------------------------------

local function canDigNow(player: Player): boolean
	return player:GetAttribute("Life") == "Alive" and Dig.CanDigWith(weapons:Items(player))
end

local function startDigging(player: Player, key: string)
	local floor, column = Grid.Parse(key)
	if not floor or not column or not inRun() then
		return
	end
	if not Dig.CanDigWith(weapons:Items(player)) then
		Remotes.FireClient("Alert", player, "Warning", "DIGGING NEEDS A DRILL OR A PICKAXE")
		return
	end
	local ok = grid:Bunker():CanDig(floor, column)
	if not ok then
		return
	end
	if Dig.NeedsVote(floor, limit) then
		askPushDeeper(player, floor, column)
		return
	end
	local site = getSite(floor, column)
	site.Diggers[player] = classValue(player, "DigSpeed") * teamValue("DigSpeed")
	publishSite(key)
end

local function stopDigging(player: Player, key: string)
	local site = sites[key]
	if site and site.Diggers[player] then
		site.Diggers[player] = nil
		publishSite(key)
	end
end

-- Dig prompts ---------------------------------------------------------------------------------------------

local function promptText(floor: number, face: Dig.Face): (string, string)
	local action = if face.Side == "Above" then "Dig down" else "Dig"
	local object
	if Dig.NeedsVote(floor, limit) then
		object = `{Grid.BandOf(floor).Name} · Push Deeper vote first`
	else
		object = `{Grid.BandOf(floor).Name} · {Dig.Seconds(floor)} s · Drill or Pickaxe`
	end
	return action, object
end

local function refreshPrompts()
	local parent = holder()
	if not parent then
		return
	end
	local bunker = grid:Bunker()
	local t = Grid.Tuning()
	local wanted: { [string]: { Floor: number, Column: number, Face: Dig.Face } } = {}
	for floor = t.FloorMin, t.FloorMax do
		for column = t.ColumnMin, t.ColumnMax do
			if bunker:State(floor, column) == "Rock" then
				for _, face in Dig.Faces(bunker, floor, column) do
					wanted[`{Grid.Key(floor, column)}|{face.Side}`] = { Floor = floor, Column = column, Face = face }
				end
			end
		end
	end
	for id, entry in prompts do
		if not wanted[id] then
			entry.Part:Destroy()
			prompts[id] = nil
		end
	end
	for id, w in wanted do
		local key = Grid.Key(w.Floor, w.Column)
		local action, object = promptText(w.Floor, w.Face)
		local entry = prompts[id]
		if not entry then
			local part = Instance.new("Part")
			part.Name = `Dig_{id}`
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			part.Transparency = 1
			part.Size = Vector3.new(1, 1, 1)
			part.Position = Dig.FacePoint(w.Face, w.Floor, w.Column)
			CollectionService:AddTag(part, CAMERA_IGNORE_TAG)
			part.Parent = parent
			local p = Instance.new("ProximityPrompt")
			p.Style = Enum.ProximityPromptStyle.Custom
			p.RequiresLineOfSight = false
			p.MaxActivationDistance = Dig.Tuning().PromptReach
			-- the cell is dug when its progress is full; the hold itself never runs out first
			p.HoldDuration = math.max(Dig.Seconds(w.Floor) * 2, 10)
			p:SetAttribute("Kind", "DigCell")
			p:SetAttribute("Cell", key)
			p.Parent = part
			p.PromptButtonHoldBegan:Connect(function(player: Player)
				startDigging(player, key)
			end)
			p.PromptButtonHoldEnded:Connect(function(player: Player)
				stopDigging(player, key)
			end)
			p.Triggered:Connect(function(player: Player)
				stopDigging(player, key)
			end)
			entry = { Part = part, Prompt = p, Key = key }
			prompts[id] = entry
		end
		local e = entry :: any
		e.Prompt.ActionText = action
		e.Prompt.ObjectText = object
		local site = sites[key]
		e.Prompt:SetAttribute("Progress", if site then site.Progress else 0)
	end
end

-- The tick ---------------------------------------------------------------------------------------------------

local function drillBaySpeed(): number
	local base = Config.Get("Rooms", "DrillBay").Output.Base
	local speed = 0
	for _, room in grid:RoomsOfType("DrillBay") do
		if not room.Wrecked then
			local rate = economy:Rate(room.Id)
			speed += Dig.DrillBaySpeed(rate, base)
		end
	end
	return speed
end

local function bayTarget(): string?
	local bunker = grid:Bunker()
	for _, key in queue do
		local floor, column = Grid.Parse(key)
		if floor and column and bunker:CanDig(floor, column) and not Dig.NeedsVote(floor, limit) then
			return key
		end
	end
	return nil
end

local function near(player: Player, key: string): boolean
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not (root and root:IsA("BasePart")) then
		return false
	end
	for _, entry in prompts do
		if entry.Key == key and (entry.Part.Position - root.Position).Magnitude <= Dig.Tuning().PromptReach + 4 then
			return true
		end
	end
	return false
end

local function tick(dt: number)
	if not inRun() then
		return
	end
	-- the Drill Bay's queue
	local target = bayTarget()
	local baySpeed = if target then drillBaySpeed() else 0
	for key, site in sites do
		local wasBay = site.Bay
		site.Bay = key == target and baySpeed > 0
		if wasBay ~= site.Bay then
			publishSite(key)
		end
	end
	if target and baySpeed > 0 and not sites[target] then
		local floor, column = Grid.Parse(target)
		if floor and column then
			local site = getSite(floor, column)
			site.Bay = true
		end
	end
	for key, site in table.clone(sites) do
		local speeds = {}
		local finisher: Player? = nil
		for player, speed in table.clone(site.Diggers) do
			if player.Parent ~= Players or not canDigNow(player) or not near(player, key) then
				site.Diggers[player] = nil
			else
				table.insert(speeds, speed)
				finisher = player
			end
		end
		if site.Bay and baySpeed > 0 then
			table.insert(speeds, baySpeed)
		end
		if #speeds > 0 then
			if not grid:Bunker():CanDig(site.Floor, site.Column) then
				dropSite(key)
			elseif Dig.NeedsVote(site.Floor, limit) then
				site.Diggers = {}
				publishSite(key)
			else
				site.Progress = math.min(site.Progress + Dig.Rate(speeds, site.Floor) * dt, 1)
				if site.Progress >= 1 then
					local faces = Dig.Faces(grid:Bunker(), site.Floor, site.Column)
					local from = faces[1]
					if finisher then
						-- the face the finisher stood at
						local character = finisher.Character
						local root = character and character:FindFirstChild("HumanoidRootPart")
						if root and root:IsA("BasePart") then
							local best = math.huge
							for _, face in faces do
								local d = (Dig.FacePoint(face, site.Floor, site.Column) - root.Position).Magnitude
								if d < best then
									best, from = d, face
								end
							end
						end
					end
					open(site.Floor, site.Column, if finisher then "Player" else "DrillBay", finisher, from)
				else
					publishSite(key)
				end
			end
		elseif site.Progress <= 0 and not table.find(queue, key) then
			sites[key] = nil
			publishSite(key)
		else
			publishSite(key)
		end
	end
end

-- Each cycle (Section 10): Disturbance falls, living nests raise it.
local function onCycle()
	local t = Dig.DisturbanceTuning()
	local nests = 0
	for _, f in features do
		if f.Kind == "Nest" then
			nests += 1
		end
	end
	local change = nests * Dig.Tuning().NestPerCycle - t.DecayPerCycle
	if change ~= 0 then
		DigService:AddDisturbance(change, "Cycle")
	end
end

-- The world changed: prompts follow the open cells; features in cells that closed go.
local function onGridChanged()
	for key, f in table.clone(features) do
		local floor, column = Grid.Parse(key)
		if floor and column and grid:State(floor, column) ~= "Dug" and f.Kind ~= "CaveOpening" then
			removeFeature(key, "Gone")
		end
	end
	for key in table.clone(sites) do
		local floor, column = Grid.Parse(key)
		if floor and column and grid:State(floor, column) ~= "Rock" then
			dropSite(key)
		end
	end
	refreshPrompts()
end

-- DevTools -----------------------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	table.insert(lines, string.format("Disturbance %.1f (%s), dig limit floor %d, deepest floor %d, seed %d", disturbance,
		Dig.Level(disturbance), limit, grid:DeepestFloor(), seed))
	for key, site in sites do
		table.insert(lines, string.format("site %s: %.0f%%, %d diggers%s%s", key, site.Progress * 100, diggerCount(site),
			if site.Bay then ", the Drill Bay" else "", if table.find(queue, key) then `, queued {table.find(queue, key)}` else ""))
	end
	if #queue > 0 then
		table.insert(lines, `queue: {table.concat(queue, " ")} (Drill Bay speed {string.format("%.2f", drillBaySpeed())})`)
	end
	for key, f in features do
		table.insert(lines, `{f.Kind} at {key}{if f.CombatId then ` ({f.CombatId})` else ""}`)
	end
	local promptCount = 0
	for _ in prompts do
		promptCount += 1
	end
	table.insert(lines, `{promptCount} dig prompts`)
	for first, id in votesOpen do
		table.insert(lines, `Push Deeper vote for floor {first}: {id}`)
	end
	return table.concat(lines, "\n")
end

local function cellArgs(args: { any }): (number?, number?)
	return tonumber(args[1]), tonumber(args[2])
end

local function registerCommands(dev: any)
	dev:Register("digs", {
		Description = "Digging now: Disturbance, the dig limit, sites, the Drill Bay's queue, what dug cells hold.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("dig", {
		Description = "Dig a rock cell now, with its roll and Disturbance (no time, no vote).",
		Usage = "dig <floor> <column>",
		Run = function(player, args): string?
			local floor, column = cellArgs(args)
			if not floor or not column then
				return "usage: dig <floor> <column>"
			end
			local ok, why = DigService:DigNow(floor, column, "DevTools", player)
			return if ok then describe() else `can't dig: {why}`
		end,
	})
	dev:Register("dig.roll", {
		Description = "What a cell holds when it is dug (this run's roll), and the Driller's hint.",
		Usage = "dig.roll <floor> <column>",
		Run = function(_player, args): string?
			local floor, column = cellArgs(args)
			if not floor or not column then
				return "usage: dig.roll <floor> <column>"
			end
			return `{Dig.Roll(seed, floor, column, eraNumber(), AVAILABLE)} (hint {Dig.Hint(seed, floor, column, eraNumber(), AVAILABLE) or "none"})`
		end,
	})
	dev:Register("dig.mark", {
		Description = "Put a rock cell on the Drill Bay's queue (or off with 'off').",
		Usage = "dig.mark <floor> <column> [off]",
		Run = function(player, args): string?
			local floor, column = cellArgs(args)
			if not floor or not column then
				return "usage: dig.mark <floor> <column> [off]"
			end
			local ok, why = DigService:Mark(floor, column, args[3] ~= "off", player)
			return if ok then describe() else why
		end,
	})
	dev:Register("disturbance", {
		Description = "Set Disturbance (thresholds fire as in play).",
		Usage = "disturbance <value>",
		Run = function(_player, args): string?
			local n = tonumber(args[1])
			if not n then
				return "usage: disturbance <value>"
			end
			setDisturbance(n, "DevTools")
			return describe()
		end,
	})
	dev:Register("disturbance.add", {
		Description = "Add to Disturbance (or take away with a negative number), as digging would.",
		Usage = "disturbance.add <n>",
		Run = function(_player, args): string?
			local n = tonumber(args[1])
			if not n then
				return "usage: disturbance.add <n>"
			end
			DigService:AddDisturbance(n, "DevTools")
			return describe()
		end,
	})
	dev:Register("tremor", {
		Description = "A Tremor now (Disturbance to 100).",
		Run = function(): string?
			setDisturbance(Dig.DisturbanceTuning().TremorAt, "DevTools")
			return describe()
		end,
	})
	dev:Register("pushdeeper", {
		Description = "Open the next band without a vote (or set the dig limit).",
		Usage = "pushdeeper [floor]",
		Run = function(_player, args): string?
			local floor = tonumber(args[1]) or (limit + 1)
			setLimit(math.clamp(Dig.LimitAfter(math.clamp(floor, 1, Grid.Tuning().FloorMax)), 1, Grid.Tuning().FloorMax))
			refreshPrompts()
			return describe()
		end,
	})
	for _, kind in { "Nest", "Cache", "CaveOpening" } do
		local name = if kind == "CaveOpening" then "cave" else string.lower(kind)
		dev:Register(name, {
			Description = `Put a {kind} in a dug cell, as if digging had found it.`,
			Usage = `{name} <floor> <column>`,
			Run = function(player, args): string?
				local floor, column = cellArgs(args)
				if not floor or not column or grid:State(floor, column) ~= "Dug" then
					return `usage: {name} <floor> <column> (a dug cell)`
				end
				local found = applyRoll(kind, floor, column, player)
				return `{found}\n{describe()}`
			end,
		})
	end
end

-- Lifecycle -----------------------------------------------------------------------------------------------------

function DigService:Init(registry)
	grid = registry.BunkerGrid
	clock = registry.CycleClock
	director = registry.RunDirector
	session = registry.SessionService
	economy = registry.EconomyService
	weapons = registry.WeaponService
	combat = registry.CombatService
	votes = registry.VoteService
	builds = registry.BuildService
	breaches = registry.BreachService
	threat = registry.ThreatDirector
	disasters = registry.DisasterService
	collection = registry.ReplicationService:Collection("Digs")
	set = RunState.Writer("DigService")
	registerCommands(registry.DevService)
end

function DigService:Start()
	seed = Random.new():NextInteger(1, 2 ^ 30)
	limit = Dig.StartLimit()
	set("DigSeed", seed)
	set("DigLimit", limit)
	set("Disturbance", 0)
	set("Nests", 0)
	grid.Changed:Connect(onGridChanged)
	clock.CycleStarted:Connect(function(cycle: number)
		if cycle > 1 then
			onCycle()
		end
	end)
	weapons.Exploded:Connect(function()
		if inRun() then
			DigService:AddDisturbance(Dig.DisturbanceTuning().Explosive, "Explosive")
		end
	end)
	local lastHit: { [string]: string } = {} -- a nest's combatant id -> who hit it last
	local function isNest(id: string): boolean
		for _, f in features do
			if f.CombatId == id then
				return true
			end
		end
		return false
	end
	combat.Damaged:Connect(function(id: string, _amount: number, source: string?)
		if source and isNest(id) then
			lastHit[id] = source
		end
	end)
	combat.Died:Connect(function(id: string)
		for _, f in features do
			if f.CombatId == id then
				local killer: Player? = nil
				for _, player in Players:GetPlayers() do
					if `P{player.UserId}` == lastHit[id] then
						killer = player
					end
				end
				lastHit[id] = nil
				destroyNest(f, killer)
				return
			end
		end
	end)
	builds:SetCellCheck(function(floor: number, column: number): (boolean, string?)
		local f = features[Grid.Key(floor, column)]
		if not f then
			return true, nil
		elseif f.Kind == "Nest" then
			return false, "A nest is in that cell: destroy it first"
		elseif f.Kind == "Cache" then
			return false, "A cache is in that cell: open it first"
		end
		return false, "A cave opening is in that cell: it stays open to the Deep"
	end)
	Remotes.OnServer("MarkDig", function(player: Player, floor: number, column: number, on: boolean)
		local ok, why = DigService:Mark(floor, column, on, player)
		if not ok and why then
			Remotes.FireClient("Alert", player, "Warning", string.upper(why))
		end
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc >= Dig.Tuning().TickSeconds then
			local elapsed = math.min(acc, 1)
			acc = 0
			local ok, err = pcall(tick, elapsed)
			if not ok then
				log:Warn("tick: %s", tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player: Player)
		for key, site in sites do
			if site.Diggers[player] then
				site.Diggers[player] = nil
				publishSite(key)
			end
		end
	end)
	task.defer(refreshPrompts)
	log:Info("digging ready: dig to floor %d without a vote", limit)
end

return DigService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CF"><Properties><string name="Name">DisasterService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DisasterService: fires, blackouts, cave-ins, the Reactor meltdown and electrical surges (bible
	Section 10, with Sections 5, 6 and 23). Run place only; Prompt 13. The arithmetic is
	Shared.Rules.Disasters; the numbers are Config.Disasters and Tuning.Disasters (provisional).

	* Fire: a room burns with a strength (0 to 100) that grows. Every SpreadSeconds (15; FireSpread
	  multipliers slow it) a fire strong enough spreads through a doorway to the next room. It
	  burns the room's HP, the residents in it and the players in it (Firefighters take a
	  quarter). Residents caught in it beat it down (ResidentBrain's Extinguish), an Extinguisher
	  sprays it down (WeaponService.ToolTick; the Firefighter 3x), a Foam Grenade puts out every
	  fire in its burst (WeaponService.Foamed). At 0 it is out.
	* Blackout: a floor or the whole grid goes dark (PowerService:SetBlackout) for
	  DurationSeconds (BlackoutDuration multipliers), unless someone resets the fuse box in the
	  Reactor Core first (hold Interact FuseSeconds).
	* Cave-in: rubble blocks a doorway, or fills a dug cell (a tunnel), and can trap residents
	  (Lib.Hazards blocks the passages; routes go around; residents with no way round are
	  trapped). Anyone under it is hurt. Melee smashes it (WeaponService.Swung; the Fire Axe and
	  the Sledgehammer three times as hard) and a Drill or a Pickaxe digs through it in one hold.
	  Digging and Tremors (Prompt 14) bring cave-ins: CaveIn(floor, column, side?).
	* The meltdown (Section 10's Reactor overload; Landon, 2026-11-08): a Reactor Core at 0 HP
	  (BunkerGrid.Wrecked), or an overclocked one (Prompt 19), starts a 60-second meltdown. Three
	  valves in the Reactor Core turned at the same time stop it; with 1 or 2 players each turned
	  valve stays turned for 10 seconds. A meltdown that runs out loses the run
	  ("ReactorDestroyed"). It also starts a fire in the Reactor Core (Section 10: Reactor
	  overloads cause fires). The Reactor stays wrecked until it is repaired.
	* Electrical surge (Section 10: random, more often in Era III; ThreatDirector rolls one a
	  day): sparks damage the machines in one room for DurationSeconds; welding the room ends it
	  (BuildService.Repaired). Left alone it may end in a fire or a blackout of its floor.
	* The Surge's one disaster (Section 5): ThreatDirector pays for it from the Surge's budget
	  (SurgeDisaster) and it starts SurgeDelaySeconds into the Surge, a fire in a random room or
	  a blackout. A Surge can't end early while its disaster, a fire or a meltdown is on
	  (HoldsSurge; Section 5).

	Disasters run while the run is playing (like monsters and residents, they go on when DevTools
	pause the cycle clock).

	Replication: the Disasters collection, id -> one of
	  { Kind = "Fire", Room, Strength, Cause }                       id "F:<room>"
	  { Kind = "Blackout", Floor?, Rooms, EndsAt, Cause }             id "B:<n>" (Floor nil: the grid)
	  { Kind = "Rubble", Shape, Floor, Column, Side?, HP, MaxHP, Cause, Edges }  id "C:<n>"
	  { Kind = "Meltdown", Room, EndsAt, Valves, Solo, Cause }        id "M:<n>"; Valves: 0 open,
	                                                                  -1 held, else turned until
	  { Kind = "Surge", Room, EndsAt, Cause }                         id "S:<room>"
	and RunState Fires, BlackoutRooms, Rubble, Meltdown, MeltdownEndsAt, ValvesTurned.
	workspace.Bunker.Disasters holds the fuse box and valve prompts and the rubble.

	API:
		DisasterService:StartFire(roomId, cause, strength?): string?
		DisasterService:Extinguish(roomId, amount, how, player?): boolean   -- true when it went out
		DisasterService:StartBlackout(floor?, cause): string?             -- floor nil: the whole grid
		DisasterService:EndBlackout(how, player?)
		DisasterService:CaveIn(floor, column, side?, cause): (string?, string?) -- side "Left"/"Right": a doorway
		DisasterService:ClearRubble(id, how, player?)
		DisasterService:StartMeltdown(cause): boolean
		DisasterService:StartElectricalSurge(roomId, cause): string?
		DisasterService:SurgeDisaster(budget, rng): number   -- ThreatDirector: the ThreatCost spent
		DisasterService:HoldsSurge(): boolean                -- ThreatDirector: don't end the Surge yet
		DisasterService:SetModifier(source, key, value?)     -- FireSpread, BlackoutDuration
		DisasterService:Active(): { [string]: any }          -- the collection's entries
		DisasterService.Started: Signal<string, string>      -- id, kind
		DisasterService.Ended: Signal<string, string, string> -- id, kind, how
	Dev: disasters, fire, fire.out, blackout, blackout.end, cavein, rubble.clear, meltdown,
	meltdown.stop, valve, esurge, disaster.surge.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Rules.Combat)
local Config = require(Shared.Config)
local Disasters = require(Shared.Rules.Disasters)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Modifiers = require(Shared.Rules.Modifiers)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)
local Hazards = require(ServerScriptService.Lib.Hazards)

local log = Log.new("DisasterService")

local DisasterService = {
	Name = "DisasterService",
	Dependencies = {
		"BunkerGrid", "PowerService", "CycleClock", "RunDirector", "CombatService", "WeaponService",
		"ResidentService", "BuildService", "SessionService", "ReplicationService", "DevService",
	},
	Started = Signal.new() :: Signal.Signal<string, string>,
	Ended = Signal.new() :: Signal.Signal<string, string, string>,
}

local CAMERA_FADE_TAG = BunkerKit.CAMERA_FADE_TAG
local CAMERA_IGNORE_TAG = "CameraIgnore"
local ROCK = Color3.fromRGB(104, 92, 78)
local ROCK_DARK = Color3.fromRGB(72, 64, 56)
local TIMBER = Color3.fromRGB(118, 94, 72)

type Fire = { Id: string, Room: string, Strength: number, NextSpread: number, Carry: number, Cause: string, Sent: number }
type Blackout = { Id: string, Floor: number?, Units: { [string]: boolean }, EndsAt: number, Cause: string }
type Rubble = {
	Id: string,
	Shape: Disasters.Shape,
	Floor: number,
	Column: number,
	Side: string?,
	HP: number,
	MaxHP: number,
	Cause: string,
	Model: Model?,
	Points: { Vector3 }, -- where melee can hit it (each blocked face)
	Height: number,
	Edges: { { string } },
}
type Meltdown = { Id: string, Room: string, EndsAt: number, Valves: { number }, Cause: string, Sent: string }
type Surge = { Id: string, Room: string, EndsAt: number, Carry: number, Cause: string }

local grid: any = nil
local power: any = nil
local clock: any = nil
local director: any = nil
local combat: any = nil
local weapons: any = nil
local residents: any = nil
local builds: any = nil
local session: any = nil
local collection: any = nil
local set: (string, any) -> () = function() end

local rng = Random.new()
local fires: { [string]: Fire } = {} -- by room id
local blackout: Blackout? = nil
local rubble: { [string]: Rubble } = {}
local meltdown: Meltdown? = nil
local surges: { [string]: Surge } = {} -- by room id
local surgeDisaster: { Kind: string, Id: string?, Cycle: number }? = nil
local modifiers: { [string]: { [string]: number } } = {} -- key -> source -> value
local counter = 0
local folder: Folder? = nil
local fuseBox: BasePart? = nil
local valveParts: { BasePart } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

local function nextId(prefix: string): string
	counter += 1
	return `{prefix}:{counter}`
end

local function roomName(roomType: string): string
	local info = Config.Find("Rooms", roomType)
	return if info then string.upper(info.Name) else string.upper(roomType)
end

local function nameOf(roomId: string): string
	local room = grid:Room(roomId)
	return if room then `THE {roomName(room.Type)}` else "A ROOM"
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function playerCount(): number
	return math.max(#session:ReadyPlayers(), 1)
end

local function modifierValue(key: string): number
	local value = 1
	for _, v in modifiers[key] or {} do
		value *= v
	end
	return value
end

local function unitAt(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

local function holder(): Folder?
	if folder and folder.Parent then
		return folder
	end
	local root = grid:Root()
	if not root then
		return nil
	end
	local found = root:FindFirstChild("Disasters")
	if not found then
		found = Instance.new("Folder")
		found.Name = "Disasters"
		found.Parent = root
	end
	folder = found :: Folder
	return folder
end

-- The living players and residents in each unit.
local function occupants(): { [string]: { any } }
	local by: { [string]: { any } } = {}
	for _, c in combat:All("Survivors") do
		if c.State == "Alive" and c.Root.Parent then
			local unit = unitAt(c.Root.Position)
			if unit then
				by[unit] = by[unit] or {}
				table.insert(by[unit], c)
			end
		end
	end
	return by
end

-- Replication -----------------------------------------------------------------------------------------

local function publishCounts()
	local fireCount, rubbleCount = 0, 0
	for _ in fires do
		fireCount += 1
	end
	for _ in rubble do
		rubbleCount += 1
	end
	local dark = 0
	if blackout then
		for unit in blackout.Units do
			if grid:Room(unit) then
				dark += 1
			end
		end
	end
	set("Fires", fireCount)
	set("Rubble", rubbleCount)
	set("BlackoutRooms", dark)
	set("Meltdown", if meltdown then true else nil)
	set("MeltdownEndsAt", if meltdown then meltdown.EndsAt else nil)
	set("ValvesTurned", if meltdown then Disasters.ValvesOn(meltdown.Valves, now()) else nil)
end

local function publishFire(fire: Fire)
	fire.Sent = math.ceil(fire.Strength)
	collection:Set(fire.Id, { Kind = "Fire", Room = fire.Room, Strength = fire.Sent, Cause = fire.Cause })
end

local function publishRubble(r: Rubble)
	local edges = {}
	for _, edge in r.Edges do
		table.insert(edges, `{edge[1]}|{edge[2]}`)
	end
	collection:Set(r.Id, {
		Kind = "Rubble", Shape = r.Shape, Floor = r.Floor, Column = r.Column, Side = r.Side,
		HP = math.ceil(r.HP), MaxHP = r.MaxHP, Cause = r.Cause, Edges = edges,
	})
end

local function valveStates(m: Meltdown): { number }
	local t = now()
	local list = {}
	for i, value in m.Valves do
		list[i] = if value == Disasters.HELD then Disasters.HELD elseif value > t then value else 0
	end
	return list
end

local function publishMeltdown(m: Meltdown)
	local valves = valveStates(m)
	local key = table.concat(valves, ",")
	if key == m.Sent then
		return
	end
	m.Sent = key
	collection:Set(m.Id, {
		Kind = "Meltdown", Room = m.Room, EndsAt = m.EndsAt, Valves = valves,
		Solo = playerCount() <= Disasters.Tuning().Meltdown.SoloPlayers, Cause = m.Cause,
	})
end

-- Fire --------------------------------------------------------------------------------------------------

function DisasterService:StartFire(roomId: string, cause: string, strength: number?): string?
	local room = grid:Room(roomId)
	if not room or not Disasters.Burns(room.Type) or fires[roomId] then
		return nil
	end
	local fire: Fire = {
		Id = `F:{roomId}`,
		Room = roomId,
		Strength = strength or Disasters.Tuning().Fire.StartStrength,
		NextSpread = now() + Disasters.SpreadSeconds(modifierValue("FireSpread")),
		Carry = 0,
		Cause = cause,
		Sent = -1,
	}
	fires[roomId] = fire
	Hazards.SetFire(roomId, fire.Strength)
	publishFire(fire)
	publishCounts()
	log:Info("fire in %s (%s): %s", roomId, room.Type, cause)
	announce("Danger", if cause == "Spread" then `THE FIRE SPREADS TO {nameOf(roomId)}`
		else `FIRE IN {nameOf(roomId)}: PUT IT OUT BEFORE IT SPREADS`)
	DisasterService.Started:Fire(fire.Id, "Fire")
	return fire.Id
end

local function putOut(fire: Fire, how: string, player: Player?)
	if fires[fire.Room] ~= fire then
		return
	end
	fires[fire.Room] = nil
	Hazards.SetFire(fire.Room, nil)
	collection:Remove(fire.Id)
	publishCounts()
	log:Info("fire in %s out (%s%s)", fire.Room, how, if player then `, {player.Name}` else "")
	if how ~= "Gone" then
		announce("Info", `FIRE OUT IN {nameOf(fire.Room)}{if player then ` · {string.upper(player.DisplayName)}` else ""}`)
	end
	DisasterService.Ended:Fire(fire.Id, "Fire", how)
end

-- Puts `amount` of strength out of a room's fire. Returns true when it went out.
function DisasterService:Extinguish(roomId: string, amount: number, how: string, player: Player?): boolean
	local fire = fires[roomId]
	if not fire or amount <= 0 then
		return false
	end
	fire.Strength -= amount
	if fire.Strength <= 0 then
		putOut(fire, how, player)
		return true
	end
	Hazards.SetFire(roomId, fire.Strength)
	if math.ceil(fire.Strength) ~= fire.Sent then
		publishFire(fire)
	end
	return false
end

local function tickFires(dt: number, t: number, inside: { [string]: { any } })
	for roomId, fire in table.clone(fires) do
		local room = grid:Room(roomId)
		if not room then
			putOut(fire, "Gone")
			continue
		end
		local people = inside[roomId] or {}
		local fighters = 0
		for _, c in people do
			if c.Kind == "Resident" and c.Model:GetAttribute("Activity") == "Extinguish" then
				fighters += 1
			end
		end
		fire.Strength = Disasters.FireStep(fire.Strength, dt, fighters, 0)
		if fire.Strength <= 0 then
			putOut(fire, "Residents")
			continue
		end
		-- the room burns
		fire.Carry += Disasters.FireRoomDamage(fire.Strength, dt)
		if fire.Carry >= 1 and room.HP > 0 then
			local whole = math.floor(fire.Carry)
			fire.Carry -= whole
			grid:SetHP(roomId, room.HP - whole)
		end
		-- and so does everyone in it (Section 10: residents; the Firefighter's passive says players too)
		for _, c in people do
			if c.Kind == "Resident" then
				combat:Damage(c.Id, Disasters.FireResidentDamage(fire.Strength, dt), nil, "fire")
			elseif c.Kind == "Player" and c.Player then
				local taken = Modifiers.ClassValue(c.Player:GetAttribute("Class") :: string?, "FireFloodDamageTaken") or 1
				combat:Damage(c.Id, Disasters.FirePlayerDamage(fire.Strength, dt, taken), nil, "fire")
			end
		end
		-- it spreads to the next room (Section 10: every 15 seconds)
		if t >= fire.NextSpread then
			fire.NextSpread = t + Disasters.SpreadSeconds(modifierValue("FireSpread"))
			if Disasters.CanSpread(fire.Strength) then
				local targets = Disasters.SpreadTargets(grid:Bunker(), roomId, fires)
				if #targets > 0 then
					DisasterService:StartFire(targets[rng:NextInteger(1, #targets)], "Spread")
				end
			end
		end
		Hazards.SetFire(roomId, fire.Strength)
		if math.ceil(fire.Strength) ~= fire.Sent then
			publishFire(fire)
		end
	end
end

-- The Extinguisher: the first burning room along the player's facing within reach.
local function onToolTick(player: Player, tool: string, at: CFrame, dt: number)
	if tool ~= "Extinguisher" then
		return
	end
	local f = Disasters.Tuning().Fire
	local target: string? = nil
	for _, d in { 0, 4, 8, 12, f.ExtinguisherReach } do
		local unit = unitAt(at.Position + at.LookVector * d)
		if unit and fires[unit] then
			target = unit
			break
		end
	end
	player:SetAttribute("Spraying", target or "")
	if target then
		local speed = Modifiers.ClassValue(player:GetAttribute("Class") :: string?, "ExtinguishSpeed") or 1
		DisasterService:Extinguish(target, f.ExtinguisherPerSecond * speed * dt, "Extinguisher", player)
	end
end

-- A Foam Grenade puts out every fire whose room its burst reaches.
local function onFoamed(at: Vector3, radius: number, player: Player)
	local t = Grid.Tuning()
	for roomId, fire in table.clone(fires) do
		local room = grid:Room(roomId)
		if room then
			for offset = 0, room.Span - 1 do
				local cell = Grid.CellPosition(room.Floor, room.Column + offset)
				local low = cell - Vector3.new(t.CellWidth / 2, 0, t.CellDepth / 2)
				local high = cell + Vector3.new(t.CellWidth / 2, t.CellHeight, t.CellDepth / 2)
				local nearest = Vector3.new(math.clamp(at.X, low.X, high.X), math.clamp(at.Y, low.Y, high.Y), math.clamp(at.Z, low.Z, high.Z))
				if (nearest - at).Magnitude <= radius then
					putOut(fire, "Foam", player)
					break
				end
			end
		end
	end
end

-- Blackouts ---------------------------------------------------------------------------------------------

local function fusePosition(): Vector3?
	local reactor = grid:RoomsOfType("ReactorCore")[1]
	if not reactor then
		return nil
	end
	local model = grid:RoomModel(reactor.Id)
	local socket = if model then BunkerKit.Socket(model, "FuseBox") else nil
	if socket then
		return socket.Position + Vector3.new(0, 4, 0)
	end
	return Grid.CellPosition(reactor.Floor, reactor.Column) + Vector3.new(-12, 4, -6)
end

local function promptPart(name: string, position: Vector3): BasePart?
	local parent = holder()
	if not parent then
		return nil
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.Position = position
	CollectionService:AddTag(part, CAMERA_IGNORE_TAG)
	part.Parent = parent
	return part
end

local function prompt(part: BasePart, kind: string, action: string, object: string, hold: number, distance: number): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = hold
	p.MaxActivationDistance = distance
	p.RequiresLineOfSight = false
	p.Style = Enum.ProximityPromptStyle.Custom -- drawn by PromptController (Prompt 11)
	p:SetAttribute("Kind", kind)
	p.Parent = part
	return p
end

function DisasterService:EndBlackout(how: string, player: Player?)
	local current = blackout
	if not current then
		return
	end
	blackout = nil
	power:SetBlackout(nil)
	if fuseBox then
		fuseBox:Destroy()
		fuseBox = nil
	end
	collection:Remove(current.Id)
	publishCounts()
	log:Info("blackout %s over (%s)", current.Id, how)
	if how == "Fixed" then
		announce("Info", `FUSE BOX RESET{if player then ` BY {string.upper(player.DisplayName)}` else ""}: THE LIGHTS ARE BACK`)
	elseif how == "Expired" then
		announce("Info", "THE BLACKOUT IS OVER: THE LIGHTS ARE BACK")
	end
	DisasterService.Ended:Fire(current.Id, "Blackout", how)
end

function DisasterService:StartBlackout(floor: number?, cause: string): string?
	local units = Disasters.BlackoutUnits(grid:Bunker(), floor)
	if next(units) == nil then
		return nil
	end
	if blackout then
		DisasterService:EndBlackout("Replaced")
	end
	local id = nextId("B")
	local current: Blackout = {
		Id = id,
		Floor = floor,
		Units = units,
		EndsAt = now() + Disasters.BlackoutSeconds(modifierValue("BlackoutDuration")),
		Cause = cause,
	}
	blackout = current
	power:SetBlackout(units)
	local at = fusePosition()
	if at then
		local part = promptPart("FuseBox", at)
		if part then
			local p = prompt(part, "FuseBox", "Reset fuse box", "Reactor Core", Disasters.Tuning().FuseSeconds, 8)
			p.Triggered:Connect(function(player: Player)
				if blackout == current then
					DisasterService:EndBlackout("Fixed", player)
				end
			end)
			fuseBox = part
		end
	end
	local rooms = {}
	for unit in units do
		if grid:Room(unit) then
			table.insert(rooms, unit)
		end
	end
	table.sort(rooms)
	collection:Set(id, { Kind = "Blackout", Floor = floor, Rooms = rooms, EndsAt = current.EndsAt, Cause = cause })
	publishCounts()
	log:Info("blackout %s: %s (%s)", id, if floor then `floor {floor}` else "the whole grid", cause)
	announce("Danger", `BLACKOUT: {if floor then `FLOOR {floor} IS` else "THE WHOLE BUNKER IS"} DARK · RESET THE FUSE BOX IN THE REACTOR CORE`)
	DisasterService.Started:Fire(id, "Blackout")
	return id
end

-- Cave-ins ----------------------------------------------------------------------------------------------

local function art(name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local kit = assets and assets:FindFirstChild("Kit")
	local found = kit and kit:FindFirstChild(name)
	return if found and found:IsA("Model") then found else nil
end

-- Where rubble stands: for each blocked face, its centre, its size (thickness, height, width) and
-- the side a digger stands on.
type Face = { Centre: Vector3, Size: Vector3 }

local function facesOf(r: Rubble): { Face }
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local cell = Grid.CellPosition(r.Floor, r.Column)
	local faces: { Face } = {}
	if r.Shape == "Tunnel" then
		for _, dir in { -1, 1 } do
			table.insert(faces, {
				Centre = Vector3.new(cell.X + dir * pitch.X / 2, cell.Y + t.CellHeight / 2, cell.Z),
				Size = Vector3.new(2, t.CellHeight, t.CellDepth),
			})
		end
		return faces
	end
	local otherColumn = if r.Side == "Left" then r.Column - 1 else r.Column + 1
	local bunker = grid:Bunker()
	local roomSide = bunker:RoomAt(r.Floor, r.Column) ~= nil or bunker:RoomAt(r.Floor, otherColumn) ~= nil
	local wallX = (cell.X + Grid.CellPosition(r.Floor, otherColumn).X) / 2
	-- a room's side wall has the 8 x 10 doorway (the kit's); between two dug cells it is open rock
	local width = if roomSide then 8 else t.CellDepth
	local height = if roomSide then 10 else t.CellHeight
	table.insert(faces, { Centre = Vector3.new(wallX, cell.Y + height / 2, cell.Z), Size = Vector3.new(2, height, width) })
	return faces
end

-- A graybox pile: rocks and a broken timber across the face, sitting on the floor.
local function grayboxPile(parent: Model, face: Face, seed: number)
	local local_rng = Random.new(seed)
	local base = face.Centre - Vector3.new(0, face.Size.Y / 2, 0)
	local count = math.clamp(math.floor(face.Size.Z / 2.2), 4, 14)
	for i = 1, count do
		local rock = Instance.new("Part")
		rock.Name = "Rock"
		local s = local_rng:NextNumber(1.8, 3.6)
		rock.Size = Vector3.new(s * local_rng:NextNumber(0.9, 1.6), s * local_rng:NextNumber(0.7, 1.1), s * local_rng:NextNumber(0.9, 1.4))
		local z = -face.Size.Z / 2 + (i - 0.5) * face.Size.Z / count + local_rng:NextNumber(-0.6, 0.6)
		local pileHeight = face.Size.Y * 0.75 * (1 - math.abs(z) / (face.Size.Z / 2 + 2))
		local y = local_rng:NextNumber(0.3, math.max(pileHeight, 1))
		rock.CFrame = CFrame.new(base + Vector3.new(local_rng:NextNumber(-1.8, 1.8), y, z))
			* CFrame.Angles(local_rng:NextNumber(-0.6, 0.6), local_rng:NextNumber(0, math.pi), local_rng:NextNumber(-0.6, 0.6))
		rock.Material = Enum.Material.Slate
		rock.Color = if i % 3 == 0 then ROCK_DARK else ROCK
		rock.Parent = parent
	end
	local beam = Instance.new("Part")
	beam.Name = "Timber"
	beam.Size = Vector3.new(0.9, 0.9, math.min(face.Size.Z * 0.9, 12))
	beam.CFrame = CFrame.new(base + Vector3.new(0.4, face.Size.Y * 0.35, 0.5)) * CFrame.Angles(0.5, 0.15, 0)
	beam.Material = Enum.Material.Wood
	beam.Color = TIMBER
	beam.Parent = parent
end

local function buildRubble(r: Rubble): Model?
	local parent = holder()
	if not parent then
		return nil
	end
	local model = Instance.new("Model")
	model.Name = r.Id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model:SetAttribute("Shape", r.Shape)
	model:SetAttribute("HP", r.HP)
	model:SetAttribute("MaxHP", r.MaxHP)
	local faces = facesOf(r)
	local pile = Instance.new("Model")
	pile.Name = "Pile"
	pile.Parent = model
	for i, face in faces do
		-- the invisible block: nothing walks through until it is cleared
		local block = Instance.new("Part")
		block.Name = "Block"
		block.Anchored = true
		block.CanCollide = true
		block.CanQuery = false
		block.CanTouch = false
		block.CastShadow = false
		block.Transparency = 1
		block.Size = face.Size
		block.CFrame = CFrame.new(face.Centre)
		CollectionService:AddTag(block, CAMERA_IGNORE_TAG)
		block.Parent = model
		-- what you see: the art kit's pile, or a graybox one. A room's 8-wide doorway gets the
		-- doorway pile; a tunnel's ends and the open rock between two dug cells (32 wide) get the
		-- tunnel's rockfall.
		local source = art(if face.Size.Z > 12 then "Kit_Rubble_Tunnel" else "Kit_Rubble_Doorway")
		local floorAt = face.Centre - Vector3.new(0, face.Size.Y / 2, 0)
		if source then
			local copy = source:Clone()
			copy.Name = `Pile{i}`
			-- a filled tunnel: each pile sits inside the tunnel cell, its outer toe at the cell's
			-- end, so nothing spills into the room or the cell next door (a doorway's pile spills
			-- into both sides, as rubble through a doorway would)
			local at = floorAt
			if r.Shape == "Tunnel" then
				local inward = math.sign(Grid.CellPosition(r.Floor, r.Column).X - face.Centre.X)
				at += Vector3.new(inward * source:GetExtentsSize().Z / 2, 0, 0)
			end
			-- art faces -Z with its width along X: turn it to lie across the wall line
			copy:PivotTo(CFrame.new(at) * CFrame.Angles(0, math.pi / 2, 0))
			copy.Parent = pile
		else
			local group = Instance.new("Model")
			group.Name = `Pile{i}`
			group.Parent = pile
			grayboxPile(group, face, r.Floor * 100 + r.Column * 7 + i)
		end
		-- the dig prompt (a Drill or a Pickaxe), on the face at chest height, from either side
		local spot = promptPart(`Dig{i}`, Vector3.new(face.Centre.X, floorAt.Y + 3.5, face.Centre.Z + math.min(face.Size.Z / 2 - 1, 4)))
		if spot then
			spot.Parent = model
			local p = prompt(spot, "DigRubble", "Dig through", "Rubble · Drill or Pickaxe",
				Disasters.DigSeconds(r.Shape), 9)
			p:SetAttribute("Rubble", r.Id)
			p.Triggered:Connect(function(player: Player)
				if rubble[r.Id] ~= r then
					return
				end
				if Disasters.CanDig(weapons:Items(player)) then
					DisasterService:ClearRubble(r.Id, "Dug", player)
				else
					Remotes.FireClient("Alert", player, "Warning", "DIGGING NEEDS A DRILL OR A PICKAXE: SMASH IT WITH A MELEE WEAPON")
				end
			end)
		end
	end
	for _, part in pile:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			CollectionService:AddTag(part, CAMERA_FADE_TAG)
		end
	end
	local _, size = pile:GetBoundingBox()
	r.Height = size.Y
	model.Parent = parent
	return model
end

-- The pile sinks as it is broken up (readable from across a room), then goes.
local function showDamage(r: Rubble)
	local model = r.Model
	local pile = model and model:FindFirstChild("Pile")
	if not model or not pile or not pile:IsA("Model") then
		return
	end
	model:SetAttribute("HP", math.ceil(r.HP))
	local base = pile:GetAttribute("BaseCFrame")
	if typeof(base) ~= "CFrame" then
		base = pile:GetPivot()
		pile:SetAttribute("BaseCFrame", base)
	end
	local sink = (1 - math.clamp(r.HP / r.MaxHP, 0, 1)) * r.Height * 0.55
	pile:PivotTo((base :: CFrame) - Vector3.new(0, sink, 0))
end

local function blockEdges(r: Rubble)
	Hazards.Unblock(r.Id)
	r.Edges = Disasters.RubbleEdges(grid:Bunker(), r.Shape, r.Floor, r.Column, r.Side)
	for _, edge in r.Edges do
		Hazards.Block(edge[1], edge[2], r.Id)
	end
end

function DisasterService:ClearRubble(id: string, how: string, player: Player?)
	local r = rubble[id]
	if not r then
		return
	end
	rubble[id] = nil
	Hazards.Unblock(id)
	if r.Model then
		r.Model:Destroy()
	end
	collection:Remove(id)
	publishCounts()
	log:Info("rubble %s cleared (%s%s)", id, how, if player then `, {player.Name}` else "")
	announce("Info", `THE WAY IS CLEAR{if player then ` · {string.upper(player.DisplayName)} ` .. (if how == "Dug" then "DUG THROUGH" else "SMASHED THROUGH") else ""}`)
	DisasterService.Ended:Fire(id, "Rubble", how)
end

-- Hurts whoever the rubble falls on (Section 10) and moves players out of the block.
local function fallOn(r: Rubble)
	local damage = Disasters.Tuning().CaveIn.Damage
	local tunnel = if r.Shape == "Tunnel" then grid:Bunker():UnitAt(r.Floor, r.Column) else nil
	for _, c in combat:All("Survivors") do
		if c.State == "Alive" and c.Root.Parent then
			local position = c.Root.Position
			local under = tunnel ~= nil and unitAt(position) == tunnel
			for _, face in facesOf(r) do
				local offset = position - face.Centre
				local inBlock = math.abs(offset.X) <= face.Size.X / 2 + 1 and math.abs(offset.Z) <= face.Size.Z / 2
					and math.abs(offset.Y) <= face.Size.Y / 2 + 3
				if inBlock then
					under = true
					if c.Kind == "Player" then
						-- step out of the block, on the side they stood
						local dir = if offset.X >= 0 then 1 else -1
						c.Root.CFrame = c.Root.CFrame + Vector3.new(dir * (face.Size.X / 2 + 2.5 - math.abs(offset.X)), 0, 0)
					end
				end
			end
			if under then
				combat:Damage(c.Id, damage, nil, "cave-in")
			end
		end
	end
end

function DisasterService:CaveIn(floor: number, column: number, side: string?, cause: string): (string?, string?)
	local shape: Disasters.Shape = if side then "Doorway" else "Tunnel"
	if side and side ~= "Left" and side ~= "Right" then
		return nil, "side must be Left or Right"
	end
	local edges = Disasters.RubbleEdges(grid:Bunker(), shape, floor, column, side)
	if #edges == 0 then
		return nil, if shape == "Tunnel" then "only a dug cell with a way into it can cave in" else "there is no doorway there"
	end
	for _, other in rubble do
		for _, edge in other.Edges do
			for _, new in edges do
				if Hazards.EdgeKey(edge[1], edge[2]) == Hazards.EdgeKey(new[1], new[2]) then
					return nil, "rubble already blocks it"
				end
			end
		end
	end
	local id = nextId("C")
	local hp = Disasters.RubbleHP(shape)
	local r: Rubble = {
		Id = id, Shape = shape, Floor = floor, Column = column, Side = side, HP = hp, MaxHP = hp,
		Cause = cause, Model = nil, Points = {}, Height = 6, Edges = edges,
	}
	for _, face in facesOf(r) do
		table.insert(r.Points, face.Centre)
	end
	rubble[id] = r
	blockEdges(r)
	r.Model = buildRubble(r)
	fallOn(r)
	publishRubble(r)
	publishCounts()
	local here = grid:Bunker():UnitAt(floor, column)
	local hereRoom = if here then grid:Room(here) else nil
	local where = if hereRoom then nameOf(hereRoom.Id) else `THE TUNNEL ON FLOOR {floor}`
	log:Info("cave-in %s: %s at %d,%d%s (%s)", id, shape, floor, column, if side then ` {side}` else "", cause)
	announce("Danger", `CAVE-IN: RUBBLE BLOCKS {if shape == "Tunnel" then where else `A DOORWAY OF {where}`} · DIG OR SMASH THROUGH IT`)
	DisasterService.Started:Fire(id, "Rubble")
	return id, nil
end

-- A melee swing landing: the first rubble in its arc takes the hit.
local function onSwung(player: Player, at: CFrame, reach: number, arc: number, damage: number, item: string, _heavy: boolean)
	for id, r in table.clone(rubble) do
		for _, point in r.Points do
			if Combat.InArc(at, point, reach, arc, 4) then
				r.HP -= Disasters.RubbleDamage(item, damage)
				if r.HP <= 0 then
					DisasterService:ClearRubble(id, "Smashed", player)
				else
					showDamage(r)
					publishRubble(r)
				end
				return
			end
		end
	end
end

-- The meltdown ------------------------------------------------------------------------------------------

local function valvePositions(roomId: string): { Vector3 }
	local room = grid:Room(roomId)
	local model = grid:RoomModel(roomId)
	local list = {}
	if model then
		for i = 1, 3 do
			local socket = BunkerKit.Socket(model, `Valve{i}`)
			if socket then
				table.insert(list, socket.Position + Vector3.new(0, 3.5, 0))
			end
		end
	end
	if #list < 3 and room then
		table.clear(list)
		local cell = Grid.CellPosition(room.Floor, room.Column)
		for _, offset in { Vector3.new(-12, 3.5, -10), Vector3.new(12, 3.5, -10), Vector3.new(0, 3.5, -1.5) } do
			table.insert(list, cell + offset)
		end
	end
	return list
end

local function clearValves()
	for _, part in valveParts do
		part:Destroy()
	end
	table.clear(valveParts)
end

local function endMeltdown(how: string)
	local m = meltdown
	if not m then
		return
	end
	meltdown = nil
	clearValves()
	collection:Remove(m.Id)
	publishCounts()
	log:Info("meltdown %s over (%s)", m.Id, how)
	if how == "Fixed" then
		local room = grid:Room(m.Room)
		announce("Info", if room and room.Wrecked then "THE REACTOR IS STABLE · REPAIR IT TO GET ITS POWER BACK"
			else "THE REACTOR IS STABLE")
	elseif how == "Lost" then
		announce("Danger", "THE REACTOR CORE MELTED DOWN")
	end
	DisasterService.Ended:Fire(m.Id, "Meltdown", how)
end

function DisasterService:StartMeltdown(cause: string): boolean
	if meltdown or director:Phase() ~= "Playing" then
		return false
	end
	local reactor = grid:RoomsOfType("ReactorCore")[1]
	if not reactor then
		return false
	end
	local seconds = Config.Get("Disasters", "ReactorOverload").TimerSeconds or 60
	local m: Meltdown = { Id = nextId("M"), Room = reactor.Id, EndsAt = now() + seconds, Valves = { 0, 0, 0 }, Cause = cause, Sent = "" }
	meltdown = m
	clearValves()
	for i, position in valvePositions(reactor.Id) do
		local part = promptPart(`Valve{i}`, position)
		if part then
			part:SetAttribute("Valve", i)
			local p = prompt(part, "Valve", "Turn valve", `Valve {i}`, Disasters.Tuning().ValveSeconds, 7)
			p.Triggered:Connect(function(player: Player)
				if meltdown == m then
					m.Valves[i] = Disasters.ValveTurned(playerCount(), now())
					log:Info("%s turned valve %d", player.Name, i)
					publishMeltdown(m)
				end
			end)
			p.TriggerEnded:Connect(function(_player: Player)
				if meltdown == m then
					m.Valves[i] = Disasters.ValveReleased(m.Valves[i], playerCount(), now())
					publishMeltdown(m)
				end
			end)
			table.insert(valveParts, part)
		end
	end
	publishMeltdown(m)
	publishCounts()
	log:Warn("REACTOR MELTDOWN (%s): %d s", cause, seconds)
	announce("Danger", if playerCount() <= Disasters.Tuning().Meltdown.SoloPlayers
		then `REACTOR MELTDOWN IN {seconds} S: TURN ALL THREE VALVES IN THE REACTOR CORE · EACH STAYS TURNED {Disasters.Tuning().Meltdown.SoloValveSeconds} S`
		else `REACTOR MELTDOWN IN {seconds} S: TURN ALL THREE VALVES IN THE REACTOR CORE AT ONCE`)
	DisasterService.Started:Fire(m.Id, "Meltdown")
	if Disasters.Tuning().Meltdown.StartsFire then
		DisasterService:StartFire(reactor.Id, "Meltdown")
	end
	return true
end

local function tickMeltdown(t: number)
	local m = meltdown
	if not m then
		return
	end
	if Disasters.MeltdownStopped(m.Valves, t) then
		endMeltdown("Fixed")
		return
	end
	if t >= m.EndsAt then
		endMeltdown("Lost")
		director:Lose("ReactorDestroyed") -- Section 5: the Reactor Core melts down
		return
	end
	publishMeltdown(m)
	set("ValvesTurned", Disasters.ValvesOn(m.Valves, t))
end

-- Electrical surges -------------------------------------------------------------------------------------

function DisasterService:StartElectricalSurge(roomId: string, cause: string): string?
	local room = grid:Room(roomId)
	if not room or surges[roomId] or room.Type == "Shaft" then
		return nil
	end
	local info = Config.Get("Disasters", "ElectricalSurge")
	local s: Surge = { Id = `S:{roomId}`, Room = roomId, EndsAt = now() + (info.DurationSeconds or 20), Carry = 0, Cause = cause }
	surges[roomId] = s
	collection:Set(s.Id, { Kind = "Surge", Room = roomId, EndsAt = s.EndsAt, Cause = cause })
	log:Info("electrical surge in %s (%s)", roomId, cause)
	announce("Warning", `ELECTRICAL SURGE IN {nameOf(roomId)}: WELD IT BEFORE IT SPARKS A FIRE`)
	DisasterService.Started:Fire(s.Id, "Surge")
	return s.Id
end

local function endSurge(s: Surge, how: string, player: Player?)
	if surges[s.Room] ~= s then
		return
	end
	surges[s.Room] = nil
	collection:Remove(s.Id)
	log:Info("electrical surge in %s over (%s)", s.Room, how)
	if how == "Fixed" then
		announce("Info", `THE SURGE IN {nameOf(s.Room)} IS WELDED{if player then ` · {string.upper(player.DisplayName)}` else ""}`)
	end
	DisasterService.Ended:Fire(s.Id, "Surge", how)
end

local function tickSurges(dt: number, t: number)
	local info = Config.Get("Disasters", "ElectricalSurge")
	for roomId, s in table.clone(surges) do
		local room = grid:Room(roomId)
		if not room then
			endSurge(s, "Gone")
			continue
		end
		s.Carry += (info.RoomDamagePerSecond or 0) * dt
		if s.Carry >= 1 and room.HP > 0 then
			local whole = math.floor(s.Carry)
			s.Carry -= whole
			grid:SetHP(roomId, room.HP - whole)
		end
		if t >= s.EndsAt then
			endSurge(s, "Expired")
			local after = Disasters.SurgeAftermath(rng)
			if after == "Fire" then
				DisasterService:StartFire(roomId, "ElectricalSurge")
			elseif after == "Blackout" then
				DisasterService:StartBlackout(room.Floor, "ElectricalSurge")
			end
		end
	end
end

-- The Surge's disaster (Section 5) ------------------------------------------------------------------------

local function startKind(kind: string, cause: string): string?
	if kind == "Fire" then
		local options = {}
		for _, room in grid:Rooms() do
			if Disasters.Burns(room.Type) and not fires[room.Id] then
				table.insert(options, room.Id)
			end
		end
		if #options == 0 then
			return nil
		end
		return DisasterService:StartFire(options[rng:NextInteger(1, #options)], cause)
	elseif kind == "Blackout" then
		local floors: { number } = {}
		for _, room in grid:Rooms() do
			if not table.find(floors, room.Floor) then
				table.insert(floors, room.Floor)
			end
		end
		table.sort(floors)
		return DisasterService:StartBlackout(Disasters.BlackoutFloor(floors, rng), cause)
	end
	log:Warn("no Surge start for the disaster %s yet", kind)
	return nil
end

-- ThreatDirector: picks and pays for the Surge's one disaster; returns its ThreatCost (0: none).
function DisasterService:SurgeDisaster(budget: number, pick: Random?): number
	local era = table.find(Config.Ids("Eras"), clock:Era()) or 1
	local kind = Disasters.SurgePick(era, budget, pick or rng)
	if not kind then
		return 0
	end
	local entry = { Kind = kind, Id = nil :: string?, Cycle = clock:Cycle() }
	surgeDisaster = entry
	task.delay(Disasters.Tuning().SurgeDelaySeconds, function()
		if surgeDisaster ~= entry then
			return
		end
		if clock:Phase() ~= "Surge" or director:Phase() ~= "Playing" then
			surgeDisaster = nil
			return
		end
		entry.Id = startKind(kind, "Surge")
		if not entry.Id then
			surgeDisaster = nil
		end
	end)
	return Config.Get("Disasters", kind).ThreatCost
end

local function isActive(id: string): boolean
	return collection:Get(id) ~= nil
end

function DisasterService:HoldsSurge(): boolean
	if meltdown or next(fires) then
		return true
	end
	local entry = surgeDisaster
	if entry then
		return entry.Id == nil or isActive(entry.Id)
	end
	return false
end

-- Modifiers and queries --------------------------------------------------------------------------------

function DisasterService:SetModifier(source: string, key: string, value: number?)
	assert(key == "FireSpread" or key == "BlackoutDuration", `DisasterService:SetModifier: {key} isn't a disaster modifier`)
	modifiers[key] = modifiers[key] or {}
	modifiers[key][source] = value
end

function DisasterService:Active(): { [string]: any }
	return collection:All()
end

-- The tick --------------------------------------------------------------------------------------------

local function tick(dt: number)
	if director:Phase() ~= "Playing" then
		return
	end
	local t = now()
	local inside = occupants()
	tickFires(dt, t, inside)
	if blackout and t >= blackout.EndsAt then
		DisasterService:EndBlackout("Expired")
	end
	tickMeltdown(t)
	tickSurges(dt, t)
	publishCounts()
end

-- The world changed: rubble re-reads the passages it blocks; a blackout takes in new rooms on
-- its floor; fires in rooms that went are out.
local function onGridChanged()
	for id, r in table.clone(rubble) do
		if r.Shape == "Tunnel" and grid:Bunker():State(r.Floor, r.Column) ~= "Dug" then
			DisasterService:ClearRubble(id, "Gone")
		else
			blockEdges(r)
			publishRubble(r)
		end
	end
	if blackout then
		local units = Disasters.BlackoutUnits(grid:Bunker(), blackout.Floor)
		blackout.Units = units
		power:SetBlackout(units)
	end
end

-- DevTools --------------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	local t = now()
	for roomId, fire in fires do
		local room = grid:Room(roomId)
		table.insert(lines, string.format("fire %s %s: strength %.1f, spreads in %.0f s, HP %s (%s)", roomId,
			if room then room.Type else "?", fire.Strength, math.max(fire.NextSpread - t, 0),
			if room then `{room.HP}/{room.MaxHP}` else "?", fire.Cause))
	end
	if blackout then
		local n = 0
		for _ in blackout.Units do
			n += 1
		end
		table.insert(lines, string.format("blackout %s: %s, %d units, %.0f s left (%s)", blackout.Id,
			if blackout.Floor then `floor {blackout.Floor}` else "the whole grid", n, blackout.EndsAt - t, blackout.Cause))
	end
	for id, r in rubble do
		local edges = {}
		for _, edge in r.Edges do
			table.insert(edges, `{edge[1]}|{edge[2]}`)
		end
		table.insert(lines, string.format("rubble %s: %s at %d,%d%s, %d/%d HP, blocks %s (%s)", id, r.Shape, r.Floor, r.Column,
			if r.Side then ` {r.Side}` else "", math.ceil(r.HP), r.MaxHP, table.concat(edges, " "), r.Cause))
	end
	if meltdown then
		local valves = {}
		for i, value in meltdown.Valves do
			valves[i] = if value == Disasters.HELD then "held" elseif value > t then string.format("%.1fs", value - t) else "open"
		end
		table.insert(lines, string.format("meltdown %s in %s: %.1f s left, valves %s, %d players (%s)", meltdown.Id, meltdown.Room,
			meltdown.EndsAt - t, table.concat(valves, " "), playerCount(), meltdown.Cause))
	end
	for roomId, s in surges do
		table.insert(lines, string.format("electrical surge %s: %.0f s left (%s)", roomId, s.EndsAt - t, s.Cause))
	end
	if surgeDisaster then
		table.insert(lines, `this Surge's disaster: {surgeDisaster.Kind} {surgeDisaster.Id or "(starting)"}`)
	end
	table.insert(lines, `holds the Surge: {DisasterService:HoldsSurge()}`)
	return table.concat(lines, "\n")
end

local function roomArg(arg: any): string?
	local text = tostring(arg or "")
	if grid:Room(text) then
		return text
	end
	local ofType = grid:RoomsOfType(text)[1]
	return if ofType then ofType.Id else nil
end

local function registerCommands(dev: any)
	dev:Register("disasters", {
		Description = "Every disaster now: fires, the blackout, rubble, the meltdown, electrical surges.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("fire", {
		Description = "Start a fire in a room (by id or type).",
		Usage = "fire <roomId|RoomType> [strength]",
		Run = function(_player, args): string?
			local roomId = roomArg(args[1])
			if not roomId then
				return "usage: fire <roomId|RoomType> [strength]"
			end
			local id = DisasterService:StartFire(roomId, "DevTools", tonumber(args[2]))
			return if id then describe() else "it can't burn there (no such room, fireproof, or already burning)"
		end,
	})
	dev:Register("fire.out", {
		Description = "Put out a room's fire, or every fire.",
		Usage = "fire.out [roomId|RoomType]",
		Run = function(_player, args): string?
			local only = if args[1] then roomArg(args[1]) else nil
			for roomId, fire in table.clone(fires) do
				if only == nil or roomId == only then
					putOut(fire, "DevTools")
				end
			end
			return describe()
		end,
	})
	dev:Register("blackout", {
		Description = "A blackout on a floor, or the whole grid.",
		Usage = "blackout [floor|grid]",
		Run = function(_player, args): string?
			local floor = tonumber(args[1])
			if not floor and args[1] ~= "grid" then
				floor = (grid:RoomsOfType("ReactorCore")[1] or { Floor = 2 }).Floor
			end
			local id = DisasterService:StartBlackout(floor, "DevTools")
			return if id then describe() else "nothing to darken there"
		end,
	})
	dev:Register("blackout.end", {
		Description = "End the blackout, as if the fuse box were reset.",
		Run = function(): string?
			DisasterService:EndBlackout("DevTools")
			return describe()
		end,
	})
	dev:Register("cavein", {
		Description = "Rubble falls: in a doorway (side Left or Right of the cell) or filling a dug cell.",
		Usage = "cavein <floor> <column> [Left|Right]",
		Run = function(_player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: cavein <floor> <column> [Left|Right]"
			end
			local side = if args[3] then tostring(args[3]) else nil
			if side then
				side = string.upper(string.sub(side, 1, 1)) .. string.lower(string.sub(side, 2))
			end
			local id, why = DisasterService:CaveIn(floor, column, side, "DevTools")
			return if id then describe() else `no cave-in: {why}`
		end,
	})
	dev:Register("rubble.clear", {
		Description = "Clear rubble (by id, or all of it).",
		Usage = "rubble.clear [id]",
		Run = function(_player, args): string?
			for id in table.clone(rubble) do
				if args[1] == nil or id == tostring(args[1]) then
					DisasterService:ClearRubble(id, "DevTools")
				end
			end
			return describe()
		end,
	})
	dev:Register("meltdown", {
		Description = "Start a Reactor meltdown (as if the Reactor Core reached 0 HP, without the damage).",
		Run = function(): string?
			return if DisasterService:StartMeltdown("DevTools") then describe() else "no meltdown (one is on, no Reactor Core, or the run isn't playing)"
		end,
	})
	dev:Register("meltdown.stop", {
		Description = "Stop the meltdown, as if the valves were turned.",
		Run = function(): string?
			endMeltdown("DevTools")
			return describe()
		end,
	})
	dev:Register("valve", {
		Description = "Turn a meltdown valve as a player would (held: a team keeps holding it).",
		Usage = "valve <1|2|3> [held|release]",
		Run = function(_player, args): string?
			local m = meltdown
			local i = tonumber(args[1])
			if not m or not i or not m.Valves[i] then
				return "usage: valve <1|2|3> [held|release] during a meltdown"
			end
			if args[2] == "release" then
				m.Valves[i] = Disasters.ValveReleased(m.Valves[i], playerCount(), now())
			else
				m.Valves[i] = Disasters.ValveTurned(playerCount(), now())
			end
			publishMeltdown(m)
			return describe()
		end,
	})
	dev:Register("esurge", {
		Description = "An electrical surge in a room (by id or type).",
		Usage = "esurge <roomId|RoomType>",
		Run = function(_player, args): string?
			local roomId = roomArg(args[1])
			local id = if roomId then DisasterService:StartElectricalSurge(roomId, "DevTools") else nil
			return if id then describe() else "usage: esurge <roomId|RoomType> (not the Shaft, one per room)"
		end,
	})
	dev:Register("disaster.surge", {
		Description = "Start a Surge's disaster now (Fire or Blackout; random when not given).",
		Usage = "disaster.surge [Fire|Blackout]",
		Run = function(_player, args): string?
			local kind = if args[1] then tostring(args[1]) else Disasters.SurgePick(1, math.huge, rng) or "Fire"
			local id = startKind(kind, "Surge")
			return if id then describe() else `couldn't start {kind}`
		end,
	})
end

-- Lifecycle ---------------------------------------------------------------------------------------------

function DisasterService:Init(registry)
	grid = registry.BunkerGrid
	power = registry.PowerService
	clock = registry.CycleClock
	director = registry.RunDirector
	combat = registry.CombatService
	weapons = registry.WeaponService
	residents = registry.ResidentService
	builds = registry.BuildService
	session = registry.SessionService
	collection = registry.ReplicationService:Collection("Disasters")
	set = RunState.Writer("DisasterService")
	registerCommands(registry.DevService)
end

function DisasterService:Start()
	Hazards.Clear()
	-- Section 10 (Landon, 2026-11-08): a Reactor Core at 0 HP starts the meltdown
	grid.Wrecked:Connect(function(roomId: string)
		local room = grid:Room(roomId)
		if room and room.Type == "ReactorCore" then
			DisasterService:StartMeltdown("ReactorDestroyed")
		end
	end)
	grid.RoomChanged:Connect(function(roomId: string)
		if not grid:Room(roomId) then
			local fire = fires[roomId]
			if fire then
				putOut(fire, "Gone")
			end
			local s = surges[roomId]
			if s then
				endSurge(s, "Gone")
			end
		end
	end)
	grid.Changed:Connect(onGridChanged)
	weapons.ToolTick:Connect(onToolTick)
	weapons.Foamed:Connect(onFoamed)
	weapons.Swung:Connect(onSwung)
	builds.Repaired:Connect(function(roomId: string, _amount: number, how: string, player: Player?)
		local s = surges[roomId]
		if s and how == "Welder" then
			endSurge(s, "Fixed", player)
		end
	end)
	clock.SurgeEnded:Connect(function()
		surgeDisaster = nil
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		local step = Disasters.Tuning().TickSeconds
		if acc >= step then
			local elapsed = math.min(acc, 1)
			acc = 0
			local ok, err = pcall(tick, elapsed)
			if not ok then
				log:Warn("tick: %s", tostring(err))
			end
		end
	end)
	Players.PlayerRemoving:Connect(function()
		if meltdown then
			meltdown.Sent = "" -- the solo rule may change: send the valves again
		end
	end)
	publishCounts()
	log:Info("disasters ready")
end

return DisasterService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D0"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	EconomyService: the team's shared stockpile, production, consumption and caps (bible
	Sections 5, 13 and 23). Run place only.

	* The stockpile (Prompt 8): every stocked resource in Config.Resources starts at its Start
	  amount (Section 6). Caps: each resource's Cap plus CapPerStorageCell for every Storage
	  cell, times bunker-wide StockpileCaps modifiers (the Quartermaster, Prompt 20). Adding
	  stops at the cap; a stock above a lower cap keeps what it has but can't grow.
	* Production (Prompt 9): rooms make things all the time while the run clock runs (Section
	  5). A room's output per cycle is Rules.Economy.Output, Section 13's formula, from its crew,
	  level and span, whether it is lit (PowerService pushes the dark rooms in with SetPowered)
	  and bunker-wide modifiers (RoomOutput, AllOutput; the difficulty's ResourceMultiplier on
	  stock). Whole units go into the stockpile as they are made; the fractions carry over. Lab
	  research adds to Research. Outputs that aren't stock (the Lounge's morale, the Radio
	  Room's recruits, training, crafting, thawing, decon) get a rate here for the systems that
	  use them later (Rate).
	* Consumption (Prompt 9): at the start of every cycle each resident eats FoodPerCycle Food
	  (times their FoodUse and bunker-wide FoodUse) and drinks WaterPerCycle Water
	  (Tuning.Residents). If the stockpile can't cover it, it gives what it has, Shortfall fires
	  with what was missing (ResidentService makes the hungry pay in health and morale, Prompt 10)
	  and the team gets an alert.
	* The crew and the eaters come from ResidentService (Prompt 10) through SetResidents. Until
	  then nobody works or eats unless DevTools staffs rooms (`staff`) or seats eaters (`eaters`).
	* Replication: amounts are RunState values (one per resource, plus Research); every room
	  that makes something is in the Production collection: id -> { Rate (per cycle), Makes
	  (a resource id or an Output kind), Idle ("NoCrew", "Dark", "Wrecked" or nil), Workers }.

	API:
		EconomyService:Get(id), :Stock(), :Cap(id), :CanAfford(costs), :Spend(costs, reason)
		EconomyService:Add(id, amount, reason): number    -- what was added (the cap stops it)
		EconomyService:Research(), :AddResearch(amount)
		EconomyService:SetResidents(source)             -- ResidentService: { Crew = fn(roomId), Eaters = fn() }
		EconomyService:RefreshCrew()                    -- ResidentService: a crew changed
		EconomyService:Crew(roomId): Crew?
		EconomyService:SetPowered(dark)                 -- PowerService: the dark rooms
		EconomyService:Rate(roomId): (number, string?, string?)  -- per cycle, what, why idle
		EconomyService:SetModifier(source, key, value?, room?)   -- bunker-wide; nil clears
		EconomyService:Multiplier(key, roomType?), :OutputMultiplier(roomType)
		EconomyService.Changed: Signal<string>            -- a resource id, or "Research"
		EconomyService.CrewChanged: Signal<()>            -- crews or output modifiers changed
		EconomyService.Ate: Signal<number, taken, missing>       -- cycle, what was taken, what was short
		EconomyService.Shortfall: Signal<{ [string]: number }>      -- what was missing
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Economy = require(Shared.Rules.Economy)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("EconomyService")
local set = RunState.Writer("EconomyService")

export type Crew = Economy.Crew
export type Eater = { Id: string, FoodUse: number? }
export type Residents = {
	Crew: (roomId: string) -> Crew?,
	Eaters: () -> { Eater },
}

type RoomRate = { Rate: number, Makes: string?, Resource: string?, Idle: string?, Workers: number }

local EconomyService = {
	Name = "EconomyService",
	Dependencies = { "BunkerGrid", "CycleClock", "SessionService", "ReplicationService", "DevService" },
	Changed = Signal.new() :: Signal.Signal<string>,
	CrewChanged = Signal.new() :: Signal.Signal<()>,
	Ate = Signal.new() :: Signal.Signal<number, { [string]: number }, { [string]: number }>,
	Shortfall = Signal.new() :: Signal.Signal<{ [string]: number }>,
}

-- Bunker-wide modifier keys this service applies (Config.Modifiers, Prompt 9).
local MODIFIER_KEYS = { "RoomOutput", "AllOutput", "StockpileCaps", "FoodUse" }
local TICK_SECONDS = 0.5 -- production
local REFRESH_SECONDS = 2 -- rates again, in case

local grid: any = nil
local clock: any = nil
local session: any = nil
local productionCollection: any = nil
local stock: { [string]: number } = {}
local research = 0
local residents: Residents? = nil
local devCrew: { [string]: Crew } = {} -- DevTools: room id -> a pretend crew (Studio)
local devEaters = 0 -- DevTools: pretend residents who eat and drink
local dark: { [string]: boolean } = {} -- PowerService: dark room ids
local progress: { [string]: number } = {} -- room id -> fraction of its next unit
local carry: { [string]: number } = { Food = 0, Water = 0 }
local modifiers: { [string]: { Key: string, Value: number, Room: string? } } = {}
local rates: { [string]: RoomRate } = {}

local function stocked(): { string }
	local ids = {}
	for _, id in Config.Ids("Resources") do
		if Config.Get("Resources", id).Kind == "Stock" then
			table.insert(ids, id)
		end
	end
	return ids
end

local function publish(id: string)
	set(id, stock[id])
	EconomyService.Changed:Fire(id)
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function roomName(roomType: string): string
	return Config.Get("Rooms", roomType).Name
end

-- The stockpile ------------------------------------------------------------------------------

function EconomyService:Get(id: string): number
	return stock[id] or 0
end

function EconomyService:Stock(): { [string]: number }
	return table.clone(stock)
end

function EconomyService:Cap(id: string): number
	local resource = Config.Get("Resources", id)
	local cells = 0
	for _, room in grid:RoomsOfType("Storage") do
		cells += room.Span
	end
	return math.floor((resource.Cap + resource.CapPerStorageCell * cells) * EconomyService:Multiplier("StockpileCaps"))
end

function EconomyService:CanAfford(costs: { [string]: number }): (boolean, string?, number?)
	return Construction.CanAfford(costs, stock)
end

function EconomyService:Spend(costs: { [string]: number }, reason: string): (boolean, string?)
	local ok, short, missing = Construction.CanAfford(costs, stock)
	if not ok and short then
		return false, `the stockpile is {missing} {Config.Get("Resources", short).Name} short`
	end
	for id, amount in costs do
		if amount > 0 and stock[id] ~= nil then
			stock[id] -= amount
			publish(id)
		end
	end
	if next(costs) then
		log:Info("spent %s on %s", Construction.CostText(costs), reason)
	end
	return true, nil
end

function EconomyService:Add(id: string, amount: number, reason: string): number
	assert(stock[id] ~= nil, `EconomyService: {id} isn't a stocked resource`)
	assert(amount >= 0 and amount == amount, "EconomyService: Add takes a positive amount (Spend takes away)")
	local room = math.max(0, EconomyService:Cap(id) - stock[id])
	local added = math.min(math.floor(amount), room)
	if added > 0 then
		stock[id] += added
		publish(id)
		log:Debug("+%d %s (%s)", added, id, reason)
	end
	return added
end

function EconomyService:Research(): number
	return research
end

function EconomyService:AddResearch(amount: number)
	assert(amount >= 0 and amount == amount, "EconomyService: AddResearch takes a positive amount")
	research += amount
	set("Research", research)
	EconomyService.Changed:Fire("Research")
end

-- Modifiers ------------------------------------------------------------------------------------

-- The product of bunker-wide modifiers with `key`; RoomOutput only where its Room matches.
function EconomyService:Multiplier(key: string, roomType: string?): number
	local value = 1
	for _, modifier in modifiers do
		if modifier.Key == key and (modifier.Room == nil or modifier.Room == roomType) then
			value *= modifier.Value
		end
	end
	return value
end

-- Everything bunker-wide on a room type's output (power included): RoomOutput and AllOutput.
function EconomyService:OutputMultiplier(roomType: string): number
	return EconomyService:Multiplier("RoomOutput", roomType) * EconomyService:Multiplier("AllOutput")
end

local recompute: () -> () -- below

-- A bunker-wide modifier from `source` (a draft card, a class, a Legend); a nil value clears it.
function EconomyService:SetModifier(source: string, key: string, value: number?, room: string?)
	assert(table.find(MODIFIER_KEYS, key), `EconomyService: {key} isn't a modifier it applies`)
	modifiers[`{source}|{key}|{room or "*"}`] = if value then { Key = key, Value = value, Room = room } else nil
	recompute()
	EconomyService.CrewChanged:Fire() -- power rooms' output may have changed (Overclock)
end

-- Crews and production -------------------------------------------------------------------------

function EconomyService:SetResidents(source: Residents?)
	residents = source
	EconomyService:RefreshCrew()
end

function EconomyService:RefreshCrew()
	recompute()
	EconomyService.CrewChanged:Fire()
end

function EconomyService:Crew(roomId: string): Crew?
	local pretend = devCrew[roomId]
	if pretend then
		return pretend
	end
	local source = residents
	if source then
		local ok, crew = pcall(source.Crew, roomId)
		if ok then
			return crew
		end
		log:Warn("Crew(%s) failed: %s", roomId, tostring(crew))
	end
	return nil
end

function EconomyService:Eaters(): { Eater }
	local list: { Eater } = {}
	local source = residents
	if source then
		local ok, got = pcall(source.Eaters)
		if ok and type(got) == "table" then
			list = table.clone(got)
		elseif not ok then
			log:Warn("Eaters() failed: %s", tostring(got))
		end
	end
	for i = 1, devEaters do
		table.insert(list, { Id = `dev{i}` })
	end
	return list
end

function EconomyService:SetPowered(darkRooms: { [string]: boolean })
	dark = table.clone(darkRooms)
	recompute()
end

local function resourceMultiplier(): number
	local difficulty = Config.Find("Difficulties", RunState.Get("Difficulty") or "Normal")
	return if difficulty then difficulty.ResourceMultiplier else 1
end

local function rateOf(room: any): RoomRate?
	local kind, resource = Economy.Makes(room.Type, room.Floor)
	if not kind then
		return nil
	end
	local crew = EconomyService:Crew(room.Id)
	local workers = if crew then crew.Workers else 0
	local idle: string? = nil
	if room.Wrecked then
		idle = "Wrecked"
	elseif dark[room.Id] then
		idle = "Dark"
	elseif workers <= 0 or Economy.CrewFactor(crew) <= 0 then
		idle = "NoCrew"
	end
	local multiplier = EconomyService:OutputMultiplier(room.Type)
	if kind == "Resource" then
		multiplier *= resourceMultiplier()
	end
	local rate = if idle then 0 else Economy.Output(room.Type, room.Level, room.Span, crew, true, multiplier)
	return { Rate = rate, Makes = resource or kind, Resource = resource, Idle = idle, Workers = workers }
end

local function rounded(rate: number): number
	return math.floor(rate * 10 + 0.5) / 10
end

recompute = function()
	if not grid then
		return
	end
	local seen: { [string]: boolean } = {}
	for _, room in grid:Rooms() do
		local r = rateOf(room)
		if r then
			seen[room.Id] = true
			local old = rates[room.Id]
			rates[room.Id] = r
			if not old or rounded(old.Rate) ~= rounded(r.Rate) or old.Idle ~= r.Idle or old.Makes ~= r.Makes
				or old.Workers ~= r.Workers then
				productionCollection:Set(room.Id, { Rate = rounded(r.Rate), Makes = r.Makes, Idle = r.Idle, Workers = r.Workers })
			end
		end
	end
	for id in table.clone(rates) do
		if not seen[id] then
			rates[id] = nil
			progress[id] = nil
			productionCollection:Remove(id)
		end
	end
end

-- Output per cycle, what it makes, and why it is idle ("NoCrew", "Dark", "Wrecked").
function EconomyService:Rate(roomId: string): (number, string?, string?)
	local r = rates[roomId]
	if not r then
		return 0, nil, nil
	end
	return r.Rate, r.Makes, r.Idle
end

local function produce(seconds: number)
	local cycle = Economy.CycleSeconds()
	for id, r in rates do
		local research_ = r.Makes == "Research"
		if r.Rate > 0 and (r.Resource ~= nil or research_) then
			local whole, rest = Economy.Accrue(progress[id] or 0, r.Rate, seconds, cycle)
			progress[id] = rest
			if whole > 0 then
				if research_ then
					EconomyService:AddResearch(whole)
				elseif r.Resource and stock[r.Resource] ~= nil then
					EconomyService:Add(r.Resource, whole, id)
				end
			end
		end
	end
end

-- Food and water at the start of a cycle --------------------------------------------------------

local function eat(cycle: number)
	local eaters = EconomyService:Eaters()
	if #eaters == 0 then
		return
	end
	local t = Config.Get("Tuning", "Residents")
	local bunkerUse = EconomyService:Multiplier("FoodUse")
	local uses: { [string]: { number } } = { Food = {}, Water = {} }
	for _, eater in eaters do
		table.insert(uses.Food, (eater.FoodUse or 1) * bunkerUse)
		table.insert(uses.Water, 1)
	end
	local taken: { [string]: number } = {}
	local missing: { [string]: number } = {}
	for _, id in { "Food", "Water" } do
		local need, rest = Economy.Eat(uses[id], if id == "Food" then t.FoodPerCycle else t.WaterPerCycle, carry[id])
		carry[id] = rest
		local take = math.min(need, stock[id] or 0)
		if take > 0 then
			stock[id] -= take
			publish(id)
		end
		taken[id] = take
		if need > take then
			missing[id] = need - take
		end
	end
	log:Info("cycle %d: %d residents ate %d Food and drank %d Water", cycle, #eaters, taken.Food, taken.Water)
	EconomyService.Ate:Fire(cycle, taken, missing)
	if next(missing) then
		local parts = {}
		for _, id in { "Food", "Water" } do
			if missing[id] then
				table.insert(parts, `{missing[id]} {string.upper(id)}`)
			end
		end
		log:Warn("cycle %d: the stockpile ran short by %s", cycle, table.concat(parts, " and "))
		announce("Danger", `THE STOCKPILE RAN SHORT: {table.concat(parts, " AND ")} MISSING`)
		EconomyService.Shortfall:Fire(missing)
	end
end

-- DevTools --------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	for _, id in stocked() do
		table.insert(lines, `{id} {stock[id]}/{EconomyService:Cap(id)}`)
	end
	return "stockpile: " .. table.concat(lines, ", ") .. `; research {research}`
end

local function describeProduction(): string
	local lines = {}
	local totals: { [string]: number } = {}
	for _, room in grid:Rooms() do
		local r = rates[room.Id]
		if r then
			table.insert(lines, string.format("%s %s L%d: %.1f %s a cycle (%d working%s)", room.Id, room.Type, room.Level,
				r.Rate, r.Makes or "?", r.Workers, if r.Idle then `, idle: {r.Idle}` else ""))
			if r.Makes then
				totals[r.Makes] = (totals[r.Makes] or 0) + r.Rate
			end
		end
	end
	table.sort(lines)
	local sums = {}
	for what, amount in totals do
		table.insert(sums, string.format("%s %.1f", what, amount))
	end
	table.sort(sums)
	return `production a cycle: {if #sums > 0 then table.concat(sums, ", ") else "nothing"}\n`
		.. table.concat(lines, "\n") .. `\neaters {#EconomyService:Eaters()}; carry Food {string.format("%.2f", carry.Food)}`
end

local function resourceId(text: any): string?
	if type(text) ~= "string" then
		return nil
	end
	for _, id in stocked() do
		if string.lower(id) == string.lower(text) then
			return id
		end
	end
	return nil
end

-- "R3" or a room type (every room of it).
local function roomsNamed(text: string): { any }
	local room = grid:Room(text)
	if room then
		return { room }
	end
	for _, id in Config.Ids("Rooms") do
		if string.lower(id) == string.lower(text) then
			return grid:RoomsOfType(id)
		end
	end
	return {}
end

function EconomyService:Init(registry)
	grid = registry.BunkerGrid
	clock = registry.CycleClock
	session = registry.SessionService
	productionCollection = registry.ReplicationService:Collection("Production")
	local dev = registry.DevService
	dev:Register("stock", {
		Description = "The team's stockpile and its caps.",
		Usage = "stock",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("stock.set", {
		Description = "Set a resource's amount (ignores the cap).",
		Usage = "stock.set <resource> <amount>",
		Run = function(_player: Player, args): string?
			local id, amount = resourceId(args[1]), tonumber(args[2])
			if not id or not amount or amount < 0 then
				return "usage: stock.set <resource> <amount>"
			end
			stock[id] = math.floor(amount)
			publish(id)
			return describe()
		end,
	})
	dev:Register("stock.add", {
		Description = "Add to a resource (up to its cap).",
		Usage = "stock.add <resource> <amount>",
		Run = function(_player: Player, args): string?
			local id, amount = resourceId(args[1]), tonumber(args[2])
			if not id or not amount or amount < 0 then
				return "usage: stock.add <resource> <amount>"
			end
			EconomyService:Add(id, amount, "DevTools")
			return describe()
		end,
	})
	dev:Register("research", {
		Description = "Lab research so far; with an amount, add that much.",
		Usage = "research [amount]",
		Run = function(_player: Player, args): string?
			local amount = tonumber(args[1])
			if amount and amount > 0 then
				EconomyService:AddResearch(amount)
			end
			return `research {research}`
		end,
	})
	dev:Register("production", {
		Description = "What every room makes a cycle, and why idle rooms are idle.",
		Usage = "production",
		Run = function(): string?
			return describeProduction()
		end,
	})
	dev:Register("staff", {
		Description = "Studio: give rooms a pretend crew until residents arrive (Prompt 10).",
		Usage = "staff <roomId|roomType> <statSum> [workers] [morale]",
		Run = function(_player: Player, args): string?
			local found = roomsNamed(tostring(args[1] or ""))
			local statSum = tonumber(args[2])
			if #found == 0 or not statSum or statSum < 0 then
				return "usage: staff <roomId|roomType> <statSum> [workers] [morale]"
			end
			for _, room in found do
				local slots = Config.Get("Tuning", "Rooms").WorkerSlotsPerCell[room.Level] * room.Span
				local workers = math.clamp(math.floor(tonumber(args[3]) or math.ceil(statSum / 5)), 0, slots)
				if statSum == 0 or workers == 0 then
					devCrew[room.Id] = nil
				else
					devCrew[room.Id] = { Workers = workers, StatSum = statSum, Morale = tonumber(args[4]) or 1 }
				end
			end
			EconomyService:RefreshCrew()
			return describeProduction()
		end,
	})
	dev:Register("staff.clear", {
		Description = "Studio: remove every pretend crew.",
		Usage = "staff.clear",
		Run = function(): string?
			table.clear(devCrew)
			EconomyService:RefreshCrew()
			return describeProduction()
		end,
	})
	dev:Register("eaters", {
		Description = "Studio: pretend residents who eat and drink each cycle until residents arrive.",
		Usage = "eaters <count>",
		Run = function(_player: Player, args): string?
			local count = tonumber(args[1])
			if not count or count < 0 then
				return `eaters {devEaters}; usage: eaters <count>`
			end
			devEaters = math.floor(count)
			return `eaters {#EconomyService:Eaters()}`
		end,
	})
	dev:Register("eat", {
		Description = "Run the start-of-cycle meal now.",
		Usage = "eat",
		Run = function(): string?
			eat(RunState.Get("Cycle") or 0)
			return describe()
		end,
	})
end

function EconomyService:Start()
	for _, id in stocked() do
		stock[id] = Config.Get("Resources", id).Start
		publish(id)
	end
	set("Research", research)
	grid.RoomChanged:Connect(function(roomId: string)
		if not grid:Room(roomId) then
			devCrew[roomId] = nil
		end
		recompute()
	end)
	clock.CycleStarted:Connect(eat)
	RunState.Changed("Difficulty"):Connect(recompute)
	recompute()
	local acc, since = 0, 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		since += dt
		if since >= REFRESH_SECONDS then
			since = 0
			recompute()
		end
		if acc >= TICK_SECONDS then
			if clock:IsRunning() then
				produce(acc * clock:TimeScale())
			end
			acc = 0
		end
	end)
	log:Debug("stockpile ready: %s", describe())
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D1"><Properties><string name="Name">MonsterService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MonsterService: monsters in the bunker and the monster cap (bible Sections 10 and 23, the
	Appendix's monster table). Run place only; Prompt 12.

	Spawning
	* Spawn(type, at, tag?) makes a monster from ServerStorage.Assets.Monsters.<Asset> (A4), or a
	  graybox rig until its model exists, in workspace.Monsters. It registers with CombatService
	  (team Monsters) and carries Rig, MonsterType, Activity and AttackAt attributes for
	  NPCAnimator (Section 23: clips play on clients from replicated state).
	* At most Tuning.Threat.MaxMonsters are on the map at once (Section 23's cap of 25); the rest
	  wait in a queue and come out where they were meant to as others die.
	* Tags group monsters (a Surge's wave: "Surge:7"); Count(tag) includes the queue.

	Behaviour, 5 times a second (Tuning.MonsterAI)
	* Targets (Section 10): residents first, then machines, then players who hit them; each type
	  has its own order (Config.Monsters.Targets). "Players" means players who hit it in the last
	  AggroSeconds, or who come within ProximityAggro (Runners only answer hits: Section 10's
	  Tunnel Hound sprints past defenders). Downed residents and players are left alone.
	* Walking: the room graph (Lib.PathGraph: doorways, Shaft stairs; Section 23), MoveTo at the
	  type's MoveSpeed; stuck for StuckSeconds, it steps to its next waypoint.
	* Attacks: in Range, a windup (the rig's HitTime attribute, else WindupFraction of
	  AttackSeconds), then the hit is checked again (Monster Lab's rule) and lands:
	  - on a player or resident through CombatService:Damage;
	  - on a machine (a room): its HP falls by RoomDamageMultiplier of the damage (SmashesMachines:
	    SmashMultiplier times that). A wrecked
	    room stops (Prompt 9) and isn't a target until it is repaired. The Reactor Core at 0 HP
	    starts the meltdown (DisasterService, Prompt 13).
	* Traits: Latches (Burrow Tick) hangs on a resident and bites until killed or swatted;
	  Slows (Spitter Grub) keeps its distance and spits goo that slows (players: the SlowedUntil
	  attribute; residents: their walk); stunned monsters (StunnedUntil: melee, Shock Mines)
	  stand still.

	API:
		MonsterService.Spawned: Signal<string, string, string?> -- id, type, tag
		MonsterService.Died: Signal<string, string, string?>    -- id, type, tag
		MonsterService:Spawn(type, at: CFrame, tag?): string?   -- nil when queued (or no such type)
		MonsterService:Count(tag?): number                      -- alive plus queued
		MonsterService:All(): { { Id, Type, Tag, Position } }
		MonsterService:InUnit(unit): number                     -- monsters in a room or dug cell
		MonsterService:Clear()
	Dev: monster, monsters, monsters.clear.
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local Threat = require(Shared.Rules.Threat)
local Hazards = require(ServerScriptService.Lib.Hazards)
local PathGraph = require(ServerScriptService.Lib.PathGraph)

local log = Log.new("MonsterService")

local MonsterService = {
	Name = "MonsterService",
	Dependencies = { "CombatService", "BunkerGrid", "ResidentService", "RunDirector", "DevService" },
	Spawned = Signal.new() :: Signal.Signal<string, string, string?>,
	Died = Signal.new() :: Signal.Signal<string, string, string?>,
}

local MONSTER_GROUP = "Monsters"
local ARRIVE = 2.5
local REPLAN_SECONDS = 2.5
local FLOOR_PENALTY = 40 -- studs a floor's difference counts as, when picking the nearest target
local BLOCKED_SKIP_SECONDS = 6 -- rubble cuts a target off: look for others this long (Prompt 13)
local NO_MACHINE: { [string]: boolean } = { Shaft = true }

type Target = { Kind: string, Id: string, RoomId: string?, Position: Vector3 }
type Monster = {
	Id: string,
	Type: string,
	Tag: string?,
	Spec: any,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Target: Target?,
	TargetAt: number,
	Points: { Vector3 },
	Index: number,
	Best: number,
	Since: number,
	PlannedFor: string?, -- the target unit the points lead to
	PlannedAt: number,
	PlannedVersion: number, -- Lib.Hazards' version when planned: rubble falling or cleared plans again
	AttackReadyAt: number,
	Aggro: { [string]: number }, -- player combatant id -> until (os.clock)
	Skip: { [string]: number }, -- a target id rubble cuts it off from -> until (os.clock; Prompt 13)
	LatchedTo: string?, -- a resident id (Burrow Ticks)
	Latch: WeldConstraint?,
}

local combat: any = nil
local grid: any = nil
local residents: any = nil
local director: any = nil
local dev: any = nil

local monsters: { [string]: Monster } = {}
local queue: { { Type: string, At: CFrame, Tag: string? } } = {}
local folder: Folder? = nil
local rng = Random.new()

local function now(): number
	return workspace:GetServerTimeNow()
end

local function ai(): { [string]: any }
	return Config.Get("Tuning", "MonsterAI")
end

local function cap(): number
	return Config.Get("Tuning", "Threat").MaxMonsters
end

local function holder(): Folder
	if folder and folder.Parent then
		return folder
	end
	local f = workspace:FindFirstChild("Monsters")
	if not (f and f:IsA("Folder")) then
		f = Instance.new("Folder")
		f.Name = "Monsters"
		f.Parent = workspace
	end
	folder = f :: Folder
	return folder :: Folder
end

local function setActivity(m: Monster, activity: string)
	if m.Model:GetAttribute("Activity") ~= activity then
		m.Model:SetAttribute("Activity", activity)
	end
end

-- Models --------------------------------------------------------------------------------------

-- A graybox rig until A4's model exists: a root, a body, two glowing eyes. Sized by role.
local GRAYBOX: { [string]: { Size: Vector3, Colour: Color3 } } = {
	Swarmer = { Size = Vector3.new(2, 1.2, 2.4), Colour = Color3.fromRGB(64, 59, 55) },
	Runner = { Size = Vector3.new(2.2, 2.6, 4.4), Colour = Color3.fromRGB(94, 106, 68) },
	Brute = { Size = Vector3.new(4.5, 6, 3.5), Colour = Color3.fromRGB(64, 59, 55) },
	Ranged = { Size = Vector3.new(3, 2.4, 4.6), Colour = Color3.fromRGB(138, 154, 70) },
}

local function graybox(monsterType: string, spec: any): Model
	local look = GRAYBOX[spec.Role] or GRAYBOX.Runner
	local model = Instance.new("Model")
	model.Name = monsterType
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(look.Size.X, math.min(2, look.Size.Y), look.Size.Z)
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Size = look.Size
	body.Color = look.Colour
	body.Material = Enum.Material.Slate
	body.CFrame = root.CFrame
	body.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = body
	weld.Parent = body
	for _, x in { -0.25, 0.25 } do
		local eye = Instance.new("Part")
		eye.Name = "Eye"
		eye.Shape = Enum.PartType.Ball
		eye.Size = Vector3.new(0.4, 0.4, 0.4) * math.max(1, look.Size.X / 2.5)
		eye.Material = Enum.Material.Neon
		eye.Color = Color3.fromRGB(124, 255, 155)
		eye.CanCollide = false
		eye.CFrame = root.CFrame * CFrame.new(x * look.Size.X, look.Size.Y * 0.25, -look.Size.Z / 2)
		eye.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = root
		w.Part1 = eye
		w.Parent = eye
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.HipHeight = look.Size.Y / 2 - root.Size.Y / 2 + 0.1
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid
	model.PrimaryPart = root
	model:SetAttribute("Graybox", true)
	return model
end

local function makeModel(monsterType: string, spec: any): Model
	local assets = ServerStorage:FindFirstChild("Assets")
	local monstersFolder = assets and assets:FindFirstChild("Monsters")
	local template = monstersFolder and monstersFolder:FindFirstChild(spec.Asset)
	if template and template:IsA("Model") and template:FindFirstChildOfClass("Humanoid") then
		return template:Clone()
	end
	return graybox(monsterType, spec)
end

-- Spawning ------------------------------------------------------------------------------------

local function aliveCount(): number
	local n = 0
	for _ in monsters do
		n += 1
	end
	return n
end

local function standOn(model: Model, at: CFrame)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { holder(), model }
	local hit = workspace:Raycast(at.Position + Vector3.new(0, 4, 0), Vector3.new(0, -14, 0), params)
	local floorY = if hit then hit.Position.Y else at.Position.Y
	model:PivotTo(at)
	local cf, size = model:GetBoundingBox()
	model:PivotTo(at + Vector3.new(0, floorY - (cf.Position.Y - size.Y / 2) + 0.05, 0))
end

local function spawnNow(monsterType: string, at: CFrame, tag: string?): string?
	local spec = Config.Find("Monsters", monsterType)
	if not spec then
		return nil
	end
	local model = makeModel(monsterType, spec)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = (model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")) :: BasePart
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CollisionGroup = MONSTER_GROUP
			part.CanTouch = false
		end
	end
	humanoid.WalkSpeed = spec.MoveSpeed
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.MaxHealth = math.huge -- CombatService keeps a monster's health; the Humanoid only walks
	humanoid.Health = math.huge
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	model:SetAttribute("Rig", monsterType)
	model:SetAttribute("MonsterType", monsterType)
	model:SetAttribute("Activity", "Idle")
	if tag then
		model:SetAttribute("Tag", tag)
	end
	standOn(model, at)
	model.Parent = holder()
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local id = combat:Register(model, { Kind = "Monster", Team = "Monsters", Health = spec.Health, MonsterType = monsterType })
	if not id then
		model:Destroy()
		return nil
	end
	model.Name = `{monsterType}_{id}`
	monsters[id] = {
		Id = id,
		Type = monsterType,
		Tag = tag,
		Spec = spec,
		Model = model,
		Humanoid = humanoid,
		Root = root,
		Target = nil,
		TargetAt = 0,
		Points = {},
		Index = 1,
		Best = math.huge,
		Since = os.clock(),
		PlannedFor = nil,
		PlannedAt = 0,
		PlannedVersion = 0,
		AttackReadyAt = os.clock() + 0.6,
		Aggro = {},
		Skip = {},
		LatchedTo = nil,
		Latch = nil,
	}
	MonsterService.Spawned:Fire(id, monsterType, tag)
	return id
end

function MonsterService:Spawn(monsterType: string, at: CFrame, tag: string?): string?
	if not Config.Find("Monsters", monsterType) then
		return nil
	end
	if aliveCount() >= cap() then
		table.insert(queue, { Type = monsterType, At = at, Tag = tag })
		return nil
	end
	return spawnNow(monsterType, at, tag)
end

local function drainQueue()
	while #queue > 0 and aliveCount() < cap() do
		local next_ = table.remove(queue, 1)
		if next_ then
			spawnNow(next_.Type, next_.At, next_.Tag)
		end
	end
end

function MonsterService:Count(tag: string?): number
	local n = 0
	for _, m in monsters do
		if tag == nil or m.Tag == tag then
			n += 1
		end
	end
	for _, q in queue do
		if tag == nil or q.Tag == tag then
			n += 1
		end
	end
	return n
end

function MonsterService:Queued(): number
	return #queue
end

local function unitOf(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

function MonsterService:All(): { { Id: string, Type: string, Tag: string?, Position: Vector3, Unit: string? } }
	local list = {}
	for id, m in monsters do
		table.insert(list, { Id = id, Type = m.Type, Tag = m.Tag, Position = m.Root.Position, Unit = unitOf(m.Root.Position) })
	end
	return list
end

function MonsterService:InUnit(unit: string): number
	local n = 0
	for _, m in monsters do
		if unitOf(m.Root.Position) == unit then
			n += 1
		end
	end
	return n
end

local function unlatch(m: Monster)
	if m.Latch then
		m.Latch:Destroy()
		m.Latch = nil
	end
	if m.LatchedTo then
		m.LatchedTo = nil
		m.Humanoid.PlatformStand = false
	end
end

function MonsterService:Clear()
	table.clear(queue)
	for id, m in monsters do
		unlatch(m)
		combat:Unregister(id)
		m.Model:Destroy()
	end
	table.clear(monsters)
end

-- Targets -------------------------------------------------------------------------------------

local function floorOf(position: Vector3): number
	local floor = Grid.CellAt(position)
	return floor or 0
end

local function score(from: Vector3, to: Vector3): number
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z).Magnitude
	return flat + math.abs(floorOf(from) - floorOf(to)) * FLOOR_PENALTY
end

local function roomPoint(room: any): Vector3
	local column = room.Column + math.floor((room.Span - 1) / 2)
	local cell = Grid.CellPosition(room.Floor, column)
	return Vector3.new(cell.X + (if room.Span % 2 == 0 then Grid.Pitch().X / 2 else 0), cell.Y, cell.Z + 2)
end

local function skipped(m: Monster, id: string): boolean
	local untilAt = m.Skip[id]
	return untilAt ~= nil and untilAt > os.clock()
end

local function residentTarget(m: Monster): Target?
	local best, bestScore = nil, math.huge
	for _, c in combat:All("Survivors") do
		if c.Kind == "Resident" and c.State == "Alive" and c.ResidentId and not skipped(m, c.Id) then
			local record = residents:Get(c.ResidentId)
			if record and record.State == "Alive" then
				local s = score(m.Root.Position, c.Root.Position)
				if s < bestScore then
					best, bestScore = c, s
				end
			end
		end
	end
	return if best then { Kind = "Residents", Id = best.Id, Position = best.Root.Position } else nil
end

local function machineTarget(m: Monster): Target?
	local best, bestScore = nil, math.huge
	for _, room in grid:Rooms() do
		if not NO_MACHINE[room.Type] and not room.Wrecked and not skipped(m, room.Id) then
			local s = score(m.Root.Position, roomPoint(room))
			if s < bestScore then
				best, bestScore = room, s
			end
		end
	end
	return if best then { Kind = "Machines", Id = best.Id, RoomId = best.Id, Position = roomPoint(best) } else nil
end

local function playerTarget(m: Monster): Target?
	local t = ai()
	local best, bestScore = nil, math.huge
	local runner = m.Spec.Role == "Runner"
	for _, c in combat:All("Survivors") do
		if c.Kind == "Player" and c.State == "Alive" and c.Player and c.Player:GetAttribute("Life") == "Alive"
			and not skipped(m, c.Id) then
			local hit = (m.Aggro[c.Id] or 0) > os.clock()
			local s = score(m.Root.Position, c.Root.Position)
			local near = not runner and s <= t.ProximityAggro
			if (hit or near) and s < bestScore then
				best, bestScore = c, s
			end
		end
	end
	return if best then { Kind = "Players", Id = best.Id, Position = best.Root.Position } else nil
end

local function chooseTarget(m: Monster)
	local found: { [string]: Target } = {}
	local available: { [string]: boolean } = {}
	for _, kind in m.Spec.Targets do
		local target = if kind == "Residents" then residentTarget(m)
			elseif kind == "Machines" then machineTarget(m)
			elseif kind == "Players" then playerTarget(m)
			else nil
		if target then
			found[kind] = target
			available[kind] = true
		end
	end
	-- a player who is hitting it, or right in its face, comes before a far resident: anything
	-- in reach now beats walking away from a fight (the residents-first order picks among the rest)
	local player = found.Players
	if player and score(m.Root.Position, player.Position) <= m.Spec.Range + 4 and m.Spec.Role ~= "Runner" then
		m.Target = player
	else
		local kind = Threat.Choose(m.Spec.Targets, available)
		m.Target = if kind then found[kind] else nil
	end
	m.TargetAt = os.clock()
end

local function targetPosition(target: Target): Vector3?
	if target.Kind == "Machines" then
		local room = grid:Room(target.RoomId :: string)
		return if room and not room.Wrecked then roomPoint(room) else nil
	end
	local c = combat:Get(target.Id)
	if not c or c.State ~= "Alive" then
		return nil
	end
	if c.Kind == "Resident" then
		local record = residents:Get(c.ResidentId)
		if not record or record.State ~= "Alive" then
			return nil
		end
	elseif c.Kind == "Player" and c.Player and c.Player:GetAttribute("Life") ~= "Alive" then
		return nil
	end
	return c.Root.Position
end

-- Moving --------------------------------------------------------------------------------------

local function halt(m: Monster)
	m.Humanoid:MoveTo(m.Root.Position)
end

local function face(m: Monster, at: Vector3)
	local flat = Vector3.new(at.X, m.Root.Position.Y, at.Z)
	if (flat - m.Root.Position).Magnitude > 0.2 then
		m.Root.CFrame = CFrame.lookAt(m.Root.Position, flat)
	end
end

local function plan(m: Monster, goal: Vector3)
	local from = unitOf(m.Root.Position)
	local to = unitOf(goal + Vector3.new(0, 1, 0))
	m.Points = {}
	m.Index = 1
	m.Best = math.huge
	m.Since = os.clock()
	m.PlannedFor = to
	m.PlannedAt = os.clock()
	m.PlannedVersion = Hazards.Version()
	if from and to and from ~= to then
		local points, why = PathGraph.Waypoints(grid:Bunker(), function(unit: string): Model?
			return grid:RoomModel(unit)
		end, m.Root.Position, from, to, goal)
		if points then
			m.Points = points
			return
		end
		if why == "Blocked" then
			-- cave-in rubble stands between it and its target (Prompt 13): it looks for another
			-- one for a while instead of walking through the rubble
			if m.Target then
				m.Skip[m.Target.Id] = os.clock() + BLOCKED_SKIP_SECONDS
			end
			m.Target = nil
			m.Points = { m.Root.Position }
			return
		end
	end
	m.Points = { goal }
end

local function walk(m: Monster, goal: Vector3)
	local goalUnit = unitOf(goal + Vector3.new(0, 1, 0))
	if m.PlannedFor ~= goalUnit or os.clock() - m.PlannedAt > REPLAN_SECONDS or #m.Points == 0
		or m.PlannedVersion ~= Hazards.Version() then
		plan(m, goal)
		if not m.Target then
			-- rubble cut the target off (plan): wait here and choose again next tick
			halt(m)
			setActivity(m, "Idle")
			return
		end
	end
	-- the last point follows a moving target
	if #m.Points > 0 then
		m.Points[#m.Points] = goal
	end
	local point = m.Points[m.Index]
	if not point then
		m.Humanoid:MoveTo(goal)
		return
	end
	local root = m.Root
	local distance = Vector3.new(point.X - root.Position.X, 0, point.Z - root.Position.Z).Magnitude
	if distance <= ARRIVE and m.Index < #m.Points then
		m.Index += 1
		m.Best = math.huge
		m.Since = os.clock()
		point = m.Points[m.Index]
	elseif distance < m.Best - 0.5 then
		m.Best = distance
		m.Since = os.clock()
	elseif os.clock() - m.Since > ai().StuckSeconds then
		-- stuck on a corner or the stairs: step to the waypoint (as residents do)
		root.CFrame = CFrame.new(point + Vector3.new(0, m.Humanoid.HipHeight + root.Size.Y / 2, 0)) * root.CFrame.Rotation
		m.Best = math.huge
		m.Since = os.clock()
	end
	m.Humanoid:MoveTo(point)
	setActivity(m, "Walk")
end

-- Attacks -------------------------------------------------------------------------------------

local function inReach(m: Monster, target: Target, at: Vector3): boolean
	local c = combat:Get(m.Id)
	local reach = if c then c.Reach else 2
	local flat = Vector3.new(at.X - m.Root.Position.X, 0, at.Z - m.Root.Position.Z).Magnitude
	local sameFloor = math.abs(floorOf(at) - floorOf(m.Root.Position)) == 0
	local extra = if target.Kind == "Machines" then 4 else 1
	return sameFloor and flat - reach <= m.Spec.Range + extra
end

local function hurtRoom(m: Monster, roomId: string, amount: number)
	local room = grid:Room(roomId)
	if not room or room.Wrecked then
		return
	end
	local smash = if m.Spec.Traits and table.find(m.Spec.Traits, "SmashesMachines") then ai().SmashMultiplier else 1
	local hp = grid:SetHP(roomId, math.max(room.HP - amount * smash * ai().RoomDamageMultiplier, 0))
	if hp and hp <= 0 then
		-- a Reactor Core at 0 HP melts down (DisasterService listens to BunkerGrid.Wrecked;
		-- Landon, 2026-11-08: the 60-second meltdown instead of losing at once)
		log:Info("%s wrecked %s (%s)", m.Id, roomId, room.Type)
	end
end

local function slow(c: any, seconds: number)
	if c.Kind == "Player" and c.Player then
		c.Player:SetAttribute("SlowedUntil", now() + seconds)
	elseif c.Kind == "Resident" then
		c.Model:SetAttribute("SlowedUntil", now() + seconds)
	end
end

local function spit(m: Monster, target: Target)
	local t = ai()
	local goo = Instance.new("Part")
	goo.Name = "Goo"
	goo.Shape = Enum.PartType.Ball
	goo.Size = Vector3.new(0.9, 0.9, 0.9)
	goo.Material = Enum.Material.Neon
	goo.Color = Color3.fromRGB(124, 255, 155)
	goo.Anchored = true
	goo.CanCollide = false
	goo.CanQuery = false
	goo.CanTouch = false
	local from = m.Root.Position + Vector3.new(0, 1, 0) + m.Root.CFrame.LookVector * 1.5
	goo.Position = from
	goo.Parent = holder()
	local aim = (target.Position + Vector3.new(0, 0.5, 0)) - from
	local velocity = aim.Unit * t.GooSpeed + Vector3.new(0, aim.Magnitude * 0.12, 0)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { holder() }
	local position = from
	local flown = 0
	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function(dt)
		local step = velocity * dt
		local hit = workspace:Raycast(position, step, params)
		velocity -= Vector3.new(0, 24 * dt, 0)
		flown += dt
		if hit or flown > 3 then
			if connection then
				connection:Disconnect()
			end
			goo:Destroy()
			local at = if hit then hit.Position else position
			for _, c in combat:All("Survivors") do
				if (c.Root.Position - at).Magnitude <= 3 + c.Reach then
					combat:Damage(c.Id, m.Spec.Damage, m.Id, "goo")
					slow(c, t.GooSlowSeconds)
				end
			end
			return
		end
		position += step
		goo.Position = position
	end)
end

local function latch(m: Monster, c: any)
	if m.Latch or not c.Root then
		return
	end
	m.LatchedTo = c.ResidentId
	m.Humanoid.PlatformStand = true
	m.Root.CFrame = c.Root.CFrame * CFrame.new(0, 0.6, 0.9)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = c.Root
	weld.Part1 = m.Root
	weld.Parent = m.Root
	m.Latch = weld
	setActivity(m, "Latched")
end

local function attack(m: Monster, target: Target)
	if os.clock() < m.AttackReadyAt then
		return
	end
	local spec = m.Spec
	m.AttackReadyAt = os.clock() + spec.AttackSeconds
	local hitTime = m.Model:GetAttribute("HitTime")
	local windup = if type(hitTime) == "number" then hitTime else spec.AttackSeconds * ai().WindupFraction
	m.Model:SetAttribute("AttackAt", os.clock()) -- NPCAnimator replays the attack clip
	setActivity(m, "Attack")
	task.delay(windup, function()
		if not monsters[m.Id] then
			return
		end
		local at = targetPosition(target)
		if not at then
			return
		end
		if spec.Traits and table.find(spec.Traits, "Slows") then
			target.Position = at
			spit(m, target)
			return
		end
		if not inReach(m, target, at) then
			return -- the hit is checked again when it lands
		end
		if target.Kind == "Machines" then
			hurtRoom(m, target.RoomId :: string, spec.Damage)
			return
		end
		local c = combat:Get(target.Id)
		if not c then
			return
		end
		combat:Damage(c.Id, spec.Damage, m.Id, "attacked")
		if c.Kind == "Resident" and spec.Traits and table.find(spec.Traits, "Latches") then
			latch(m, c)
		end
	end)
end

-- The tick -----------------------------------------------------------------------------------------

local function step(m: Monster)
	local stunned = m.Model:GetAttribute("StunnedUntil")
	if type(stunned) == "number" and stunned > now() then
		unlatch(m)
		halt(m)
		setActivity(m, "Stunned")
		return
	end
	if m.LatchedTo then
		local c = combat:Get(m.LatchedTo)
		local record = residents:Get(m.LatchedTo)
		if not c or c.State ~= "Alive" or not record or record.State ~= "Alive" then
			unlatch(m)
		else
			if os.clock() >= m.AttackReadyAt then
				local t = ai()
				m.AttackReadyAt = os.clock() + m.Spec.AttackSeconds * t.LatchIntervalMultiplier
				m.Model:SetAttribute("AttackAt", os.clock())
				combat:Damage(c.Id, m.Spec.Damage * t.LatchDamageMultiplier, m.Id, "bitten")
			end
			return
		end
	end
	if not m.Target or os.clock() - m.TargetAt > 1 then
		chooseTarget(m)
	end
	local target = m.Target
	local at = if target then targetPosition(target) else nil
	if not target or not at then
		m.Target = nil
		halt(m)
		setActivity(m, "Idle")
		return
	end
	target.Position = at
	local ranged = m.Spec.Role == "Ranged"
	if inReach(m, target, at) then
		local flat = Vector3.new(at.X - m.Root.Position.X, 0, at.Z - m.Root.Position.Z).Magnitude
		if ranged and flat > m.Spec.Range * ai().KeepDistanceFraction then
			-- spitters keep their distance but close in a little while they spit
			m.Humanoid:MoveTo(m.Root.Position + (at - m.Root.Position).Unit * 2)
		else
			halt(m)
		end
		face(m, at)
		attack(m, target)
		return
	end
	walk(m, at)
end

local function loop()
	while true do
		task.wait(ai().TickSeconds)
		for id, m in monsters do
			if not m.Model.Parent then
				monsters[id] = nil
			else
				local ok, err = pcall(step, m)
				if not ok then
					log:Warn("%s: %s", id, tostring(err))
				end
			end
		end
	end
end

-- Lifecycle ----------------------------------------------------------------------------------------

local function nearPlayer(player: Player?): CFrame?
	local character = player and player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return nil
	end
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	look = if look.Magnitude > 0.1 then look.Unit else Vector3.new(0, 0, -1)
	local spot = root.Position + look * 14
	return CFrame.lookAt(spot, Vector3.new(root.Position.X, spot.Y, root.Position.Z))
end

function MonsterService:Init(registry)
	combat = registry.CombatService
	grid = registry.BunkerGrid
	residents = registry.ResidentService
	director = registry.RunDirector
	dev = registry.DevService

	pcall(function()
		PhysicsService:RegisterCollisionGroup(MONSTER_GROUP)
	end)
	pcall(function()
		PhysicsService:CollisionGroupSetCollidable(MONSTER_GROUP, MONSTER_GROUP, false)
	end)
	pcall(function()
		PhysicsService:RegisterCollisionGroup("Residents")
		PhysicsService:CollisionGroupSetCollidable(MONSTER_GROUP, "Residents", false)
	end)

	dev:Register("monster", {
		Description = "Spawn monsters in front of you (Prompt 12).",
		Usage = "monster <Type> [count]",
		Run = function(player, args): string?
			local monsterType = tostring(args[1] or "")
			if not Config.Find("Monsters", monsterType) then
				return `no monster {monsterType}`
			end
			player = player or Players:GetPlayers()[1]
			local at = nearPlayer(player)
			if not at then
				return "no player to spawn by"
			end
			local count = math.clamp(math.floor(tonumber(args[2]) or 1), 1, 30)
			local made = {}
			for i = 1, count do
				local offset = CFrame.new((i - 1) % 4 * 2.5 - 3.75, 0, -math.floor((i - 1) / 4) * 3)
				table.insert(made, MonsterService:Spawn(monsterType, at * offset, "Dev") or "queued")
			end
			return `{monsterType}: {table.concat(made, ", ")}`
		end,
	})
	dev:Register("monsters", {
		Description = "The monsters on the map, the queue and what each is after.",
		Usage = "monsters",
		Run = function(): string?
			local lines = { `{aliveCount()} on the map (cap {cap()}), {#queue} queued` }
			for id, m in monsters do
				local health = combat:HealthOf(id)
				local target = if m.Target then `{m.Target.Kind} {m.Target.Id}` else "nothing"
				table.insert(lines, `  {id} {m.Type} {math.ceil(health)}hp in {unitOf(m.Root.Position) or "?"}, after {target}, {m.Model:GetAttribute("Activity")}{if m.LatchedTo then ` (latched to {m.LatchedTo})` else ""}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("monsters.clear", {
		Description = "Remove every monster and the queue.",
		Usage = "monsters.clear",
		Run = function(): string?
			local n = aliveCount() + #queue
			MonsterService:Clear()
			return `{n} removed`
		end,
	})
end

function MonsterService:Start()
	holder()
	combat.Died:Connect(function(id: string)
		local m = monsters[id]
		if not m then
			return
		end
		unlatch(m)
		monsters[id] = nil
		MonsterService.Died:Fire(id, m.Type, m.Tag)
		task.defer(drainQueue)
	end)
	combat.Damaged:Connect(function(targetId: string, _amount: number, sourceId: string?)
		local m = monsters[targetId]
		if m and sourceId and string.sub(sourceId, 1, 1) == "P" then
			m.Aggro[sourceId] = os.clock() + ai().AggroSeconds
			if m.Target == nil or m.Target.Kind ~= "Residents" then
				m.TargetAt = 0 -- rethink now
			end
		end
	end)
	task.spawn(loop)
	log:Info("monsters ready: cap %d", cap())
end

return MonsterService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D2"><Properties><string name="Name">ObjectiveService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ObjectiveService: the run's big objectives (bible Sections 5, 12 and 23): Lost Crews
	rescued and era bosses beaten. Each one done adds its YearsPerCycle (Config.Objectives:
	+2 a crew, +1 a boss) to Years per Cycle, which CycleClock reads. Run place only.

	Prompt 3 keeps the record. The systems that rescue crews (Prompts 16 and 17) and beat the
	bosses (Prompts 15, 23 and 24) call Complete or BossBeaten. A boss's death is also what
	ends its Surge: boss Surges have no timer (Landon, Nov 8, 2026), so CycleClock listens to
	BossDefeated. The Source has no objective; beating it ends the final Surge (a Century
	Victory) or, in its chamber, wins the Deep Victory.

	API:
		ObjectiveService:Complete(objectiveId): boolean       -- false if unknown or already done
		ObjectiveService:BossBeaten(bossId): boolean          -- a boss died: its objective (if any), BossDefeated
		ObjectiveService:IsComplete(objectiveId): boolean
		ObjectiveService:Completed(): { [string]: boolean }   -- frozen copy
		ObjectiveService:Counts(): (number, number)           -- Lost Crews rescued, era bosses beaten
		ObjectiveService.Changed: Signal<string>              -- the objective just completed
		ObjectiveService:IsBossBeaten(bossId): boolean
		ObjectiveService.BossDefeated: Signal<string>         -- the boss just beaten (once per boss)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("ObjectiveService")

local ObjectiveService = {
	Name = "ObjectiveService",
	Dependencies = { "DevService" },
	Changed = Signal.new() :: Signal.Signal<string>,
	BossDefeated = Signal.new() :: Signal.Signal<string>,
}

local completed: { [string]: boolean } = {}
local defeated: { [string]: boolean } = {} -- bosses beaten this run
local snapshot: { [string]: boolean } = table.freeze({})
local set: ((string, any) -> ())? = nil

local function counts(): (number, number)
	local crews, bosses = 0, 0
	for id in completed do
		local objective = Config.Get("Objectives", id)
		if objective.Kind == "LostCrew" then
			crews += 1
		elseif objective.Kind == "Boss" then
			bosses += 1
		end
	end
	return crews, bosses
end

local function publish()
	local crews, bosses = counts()
	if set then
		set("LostCrews", crews)
		set("BossesBeaten", bosses)
	end
end

local function complete(objective: { [string]: any }): boolean
	if completed[objective.Id] then
		return false
	end
	completed[objective.Id] = true
	snapshot = table.freeze(table.clone(completed))
	publish()
	log:Info("%s done (+%d Years per Cycle)", objective.Name, objective.YearsPerCycle)
	ObjectiveService.Changed:Fire(objective.Id)
	return true
end

-- A Lost Crew rescued, or an era boss beaten (which is BossBeaten for that boss).
function ObjectiveService:Complete(objectiveId: string): boolean
	local objective = Config.Find("Objectives", objectiveId)
	if not objective then
		log:Warn("no objective %s", tostring(objectiveId))
		return false
	end
	if objective.Kind == "Boss" and objective.Boss and not completed[objective.Id] then
		return ObjectiveService:BossBeaten(objective.Boss)
	end
	return complete(objective)
end

function ObjectiveService:BossBeaten(bossId: string): boolean
	if not Config.Find("Bosses", bossId) then
		log:Warn("no boss %s", tostring(bossId))
		return false
	end
	if defeated[bossId] then
		return false
	end
	defeated[bossId] = true
	for _, objective in Config.All("Objectives") do
		if objective.Kind == "Boss" and objective.Boss == bossId then
			complete(objective)
		end
	end
	log:Info("%s beaten", bossId)
	ObjectiveService.BossDefeated:Fire(bossId)
	return true
end

function ObjectiveService:IsBossBeaten(bossId: string): boolean
	return defeated[bossId] == true
end

function ObjectiveService:IsComplete(objectiveId: string): boolean
	return completed[objectiveId] == true
end

function ObjectiveService:Completed(): { [string]: boolean }
	return snapshot
end

function ObjectiveService:Counts(): (number, number)
	return counts()
end

function ObjectiveService:Init(registry)
	set = RunState.Writer("ObjectiveService")
	publish()

	registry.DevService:Register("objectives", {
		Description = "List the run's objectives and which are done.",
		Run = function(): string?
			local lines = {}
			for _, objective in Config.All("Objectives") do
				local mark = if completed[objective.Id] then "done" else "    "
				table.insert(lines, `{mark} {objective.Id}: {objective.Name} (+{objective.YearsPerCycle})`)
			end
			local crews, bosses = counts()
			table.insert(lines, `Lost Crews {crews}, era bosses {bosses}`)
			return table.concat(lines, "\n")
		end,
	})
	registry.DevService:Register("objective", {
		Description = "Complete an objective (a Lost Crew rescued or an era boss beaten).",
		Usage = "objective <id>",
		Run = function(_player, args): string?
			local id = tostring(args[1] or "")
			if not Config.Find("Objectives", id) then
				return `no objective {id}; ids: {table.concat(Config.Ids("Objectives"), ", ")}`
			end
			if not ObjectiveService:Complete(id) then
				return `{id} was already done`
			end
			return `{id} done`
		end,
	})
end

return ObjectiveService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D3"><Properties><string name="Name">PingService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PingService: cell pings (bible Section 7: "Ping any cell; it shows on every player's
	mini-map"). Run place only.

	A player pings a cell from the Command View (the PingCell remote: floor, column). The
	server checks the cell is on the grid and the player's session is ready (the remote's rate
	limit stops spam), then tells every ready player (CellPinged: floor, column, the pinger's
	UserId and display name). Clients show the ping on the mini-map and in the Command View for
	Tuning.Ping.Seconds.

	The world ping (the Ping action in play, and the Rally ping of Section 11) comes with combat
	and residents and will go through here too.

	API:
		PingService:Ping(player, floor, column): (boolean, string?)
		PingService.Pinged: Signal<Player, number, number>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("PingService")

local PingService = {
	Name = "PingService",
	Dependencies = { "SessionService", "DevService" },
	Pinged = Signal.new() :: Signal.Signal<Player, number, number>,
}

local session: any = nil
local sent = 0

function PingService:Ping(player: Player, floor: number, column: number): (boolean, string?)
	if not session:IsReady(player) then
		return false, "not ready yet"
	elseif not Grid.OnGrid(floor, column) then
		return false, "off the grid"
	end
	sent += 1
	Remotes.FireClients("CellPinged", session:ReadyPlayers(), floor, column, player.UserId, player.DisplayName)
	log:Debug("%s pinged %s", player.Name, Grid.Key(floor, column))
	PingService.Pinged:Fire(player, floor, column)
	return true, nil
end

function PingService:Init(registry)
	session = registry.SessionService
	Remotes.OnServer("PingCell", function(player: Player, floor: number, column: number)
		PingService:Ping(player, floor, column)
	end)
	registry.DevService:Register("cell.ping", {
		Description = "Ping a cell as if from the Command View (every player sees it on the mini-map).",
		Usage = "cell.ping <floor> <column>",
		Run = function(player: Player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: cell.ping <floor> <column>"
			end
			local ok, why = PingService:Ping(player, floor, column)
			return if ok then `pinged {Grid.Key(floor, column)} ({sent} pings this run)` else `not pinged: {why}`
		end,
	})
end

return PingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D4"><Properties><string name="Name">PowerService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PowerService: the power balance and dark rooms (bible Sections 6 and 23). Run place only.

	Power is a live balance, not a stock. The Reactor Core and Generators make power from the
	residents working in them (Landon, Nov 8, 2026); every room draws Power[level] for each of
	its cells. When the draw passes what is made, rooms go dark farthest first: steps along the
	room graph from the nearest Reactor Core or Generator, dug cells counting (Rules.Economy
	.Balance has the rule). The balance is worked out again whenever the bunker, a crew or an
	output modifier changes, and every second in case.

	Dark rooms stop working (EconomyService.SetPowered), their lights drop to a dim red emergency
	glow and their Neon fittings (light strips, pendants) go dull; the room model carries a Dark
	attribute. Their morale loss (Prompt 10) and
	doubled monster spawns (Prompt 12) ask IsDark. The team gets an alert when rooms go dark
	and when the power comes back.

	Blackouts (Prompt 13, Section 10: a floor or the whole grid goes dark): DisasterService sets
	the units a blackout darkens (SetBlackout). They are dark on top of the balance, whatever
	power is made: lights, fittings, work and IsDark all follow, but the power alerts and
	DarkRooms count only rooms dark for want of power.

	Replication: RunState PowerMade, PowerUsed, PowerNeeded and DarkRooms; the Power collection,
	room id -> { Draw, Made, Dark, Steps, Blackout } for every room that draws or makes power.

	API:
		PowerService:IsDark(roomId): boolean            -- for want of power or in a blackout
		PowerService:IsBlackout(unit): boolean
		PowerService:SetBlackout(units?)                -- the units a blackout darkens; nil: none
		PowerService:Balance(): Economy.Balance
		PowerService:Refresh()
		PowerService.DarkChanged: Signal<{ string }, { string }>  -- went dark, lit again
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Economy = require(Shared.Rules.Economy)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("PowerService")
local set = RunState.Writer("PowerService")

local PowerService = {
	Name = "PowerService",
	Dependencies = { "BunkerGrid", "EconomyService", "SessionService", "ReplicationService", "DevService" },
	DarkChanged = Signal.new() :: Signal.Signal<{ string }, { string }>,
}

-- A dark room's lights: a dim red emergency glow (art direction, not a rule).
local EMERGENCY = Color3.fromRGB(255, 72, 48)
local DARK_BRIGHTNESS = 0.18 -- of the light's own brightness
local DARK_FITTING = Color3.fromRGB(64, 30, 26) -- a Neon fitting with the power off
local REFRESH_SECONDS = 1

local grid: any = nil
local economy: any = nil
local session: any = nil
local powerCollection: any = nil
local balance: Economy.Balance = { Made = 0, Needed = 0, Used = 0, Dark = {}, Draw = {}, MadeBy = {}, Steps = {} }
local published: { [string]: string } = {} -- room id -> what was last sent (to send only changes)
local pending = false
local blackout: { [string]: boolean } = {} -- units dark in a blackout (Prompt 13)
local darkNow: { [string]: boolean } = {} -- the balance's dark rooms plus the blackout

local function isDarkNow(unit: string): boolean
	return darkNow[unit] == true
end

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function roomName(roomType: string): string
	return Config.Get("Rooms", roomType).Name
end

local function round1(value: number): number
	return math.floor(value * 10 + 0.5) / 10
end

-- Lights ---------------------------------------------------------------------------------------

local function setLight(light: Instance, isDark: boolean)
	if not light:IsA("Light") then
		return
	end
	if (light:GetAttribute("PowerDark") == true) == isDark then
		return
	end
	if light:GetAttribute("LitBrightness") == nil then
		light:SetAttribute("LitBrightness", light.Brightness)
		light:SetAttribute("LitColor", light.Color)
	end
	local brightness = light:GetAttribute("LitBrightness")
	local color = light:GetAttribute("LitColor")
	if isDark then
		light.Brightness = (if type(brightness) == "number" then brightness else light.Brightness) * DARK_BRIGHTNESS
		light.Color = EMERGENCY
	else
		if type(brightness) == "number" then
			light.Brightness = brightness
		end
		if typeof(color) == "Color3" then
			light.Color = color
		end
	end
	light:SetAttribute("PowerDark", isDark)
end

-- A dark room's Neon fittings go dull (SmoothPlastic, dark red); lit again, they come back.
local function setFittings(model: Model, isDark: boolean)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and (item.Material == Enum.Material.Neon or item:GetAttribute("LitMaterial") ~= nil) then
			if isDark then
				if item:GetAttribute("LitMaterial") == nil then
					item:SetAttribute("LitMaterial", item.Material.Name)
					item:SetAttribute("LitColor", item.Color)
				end
				item.Material = Enum.Material.SmoothPlastic
				item.Color = DARK_FITTING
			else
				local material, color = item:GetAttribute("LitMaterial"), item:GetAttribute("LitColor")
				if type(material) == "string" then
					item.Material = (Enum.Material :: any)[material]
				end
				if typeof(color) == "Color3" then
					item.Color = color
				end
				item:SetAttribute("LitMaterial", nil)
				item:SetAttribute("LitColor", nil)
			end
		end
	end
end

local function applyLights()
	for _, light in CollectionService:GetTagged(BunkerKit.ROOM_LIGHT_TAG) do
		local unit = light:GetAttribute("Unit")
		if type(unit) == "string" then
			setLight(light, isDarkNow(unit))
		end
	end
	for _, room in grid:Rooms() do
		local model = grid:RoomModel(room.Id)
		if model then
			local isDark = isDarkNow(room.Id)
			if (model:GetAttribute("Dark") == true) ~= isDark then
				model:SetAttribute("Dark", isDark)
				setFittings(model, isDark)
			end
		end
	end
end

-- The balance ------------------------------------------------------------------------------------

local function publish()
	set("PowerMade", round1(balance.Made))
	set("PowerUsed", round1(balance.Used))
	set("PowerNeeded", round1(balance.Needed))
	local darkCount = 0
	for _ in balance.Dark do
		darkCount += 1
	end
	set("DarkRooms", darkCount)
	local seen: { [string]: boolean } = {}
	for _, room in grid:Rooms() do
		local draw, made = balance.Draw[room.Id], balance.MadeBy[room.Id]
		if draw or made then
			seen[room.Id] = true
			local entry = {
				Draw = draw or 0,
				Made = round1(made or 0),
				Dark = isDarkNow(room.Id),
				Steps = balance.Steps[room.Id] or -1, -- -1: nothing reaches it
				Blackout = blackout[room.Id] == true,
			}
			local key = `{entry.Draw}|{entry.Made}|{entry.Dark}|{entry.Steps}|{entry.Blackout}`
			if published[room.Id] ~= key then
				published[room.Id] = key
				powerCollection:Set(room.Id, entry)
			end
		end
	end
	for id in table.clone(published) do
		if not seen[id] then
			published[id] = nil
			powerCollection:Remove(id)
		end
	end
end

function PowerService:Refresh()
	pending = false
	local before = balance.Dark
	balance = Economy.Balance(grid:Bunker(), function(roomId: string): Economy.Crew?
		return economy:Crew(roomId)
	end, function(roomType: string): number
		return economy:OutputMultiplier(roomType)
	end)
	local wentDark, litAgain = {}, {}
	for id in balance.Dark do
		if not before[id] then
			table.insert(wentDark, id)
		end
	end
	for id in before do
		if not balance.Dark[id] and grid:Room(id) then
			table.insert(litAgain, id)
		end
	end
	local wasDark = darkNow
	darkNow = table.clone(balance.Dark)
	for unit in blackout do
		darkNow[unit] = true
	end
	economy:SetPowered(darkNow)
	publish()
	applyLights()
	local blackoutChanged = false
	for unit in darkNow do
		if not wasDark[unit] then
			blackoutChanged = true
		end
	end
	for unit in wasDark do
		if not darkNow[unit] then
			blackoutChanged = true
		end
	end
	if #wentDark > 0 or #litAgain > 0 then
		table.sort(wentDark)
		table.sort(litAgain)
		log:Info("power %.1f made, %.1f needed: dark %s", balance.Made, balance.Needed,
			if next(balance.Dark) then table.concat(wentDark, ", ") else "none")
		if #wentDark > 0 then
			local room = grid:Room(wentDark[1])
			local what = if #wentDark == 1 and room then `THE {string.upper(roomName(room.Type))} WENT DARK`
				else `{#wentDark} ROOMS WENT DARK`
			announce("Warning", `NOT ENOUGH POWER: {what}`)
		elseif not next(balance.Dark) then
			announce("Info", "POWER RESTORED: EVERY ROOM IS LIT")
		end
		PowerService.DarkChanged:Fire(wentDark, litAgain)
	elseif blackoutChanged then
		PowerService.DarkChanged:Fire({}, {})
	end
end

-- Many changes in one frame (a merge, a crew shuffle) make one refresh.
local function soon()
	if pending then
		return
	end
	pending = true
	task.defer(function()
		if pending then
			PowerService:Refresh()
		end
	end)
end

function PowerService:IsDark(roomId: string): boolean
	return darkNow[roomId] == true
end

function PowerService:IsBlackout(unit: string): boolean
	return blackout[unit] == true
end

-- The units (room ids, dug nodes) a blackout darkens; nil or {} ends it (DisasterService).
function PowerService:SetBlackout(units: { [string]: boolean }?)
	blackout = if units then table.clone(units) else {}
	PowerService:Refresh()
end

function PowerService:Balance(): Economy.Balance
	return balance
end

-- DevTools ---------------------------------------------------------------------------------------

local function describe(): string
	local lines = { string.format("power: %.1f made, %.1f used, %.1f needed", balance.Made, balance.Used, balance.Needed) }
	local rooms = grid:Rooms()
	table.sort(rooms, function(a, b)
		return Economy.Order(a.Id) < Economy.Order(b.Id)
	end)
	for _, room in rooms do
		local draw, made = balance.Draw[room.Id], balance.MadeBy[room.Id]
		if draw or made then
			table.insert(lines, string.format("%s %s L%d: %s, steps %s%s%s", room.Id, room.Type, room.Level,
				if made then string.format("makes %.1f", made) else `draws {draw}`,
				tostring(balance.Steps[room.Id] or "none"), if balance.Dark[room.Id] then ", DARK" else "",
				if blackout[room.Id] then ", BLACKOUT" else ""))
		end
	end
	return table.concat(lines, "\n")
end

function PowerService:Init(registry)
	grid = registry.BunkerGrid
	economy = registry.EconomyService
	session = registry.SessionService
	powerCollection = registry.ReplicationService:Collection("Power")
	registry.DevService:Register("power", {
		Description = "The power balance: what each room makes or draws, its steps and whether it is dark.",
		Usage = "power",
		Run = function(): string?
			PowerService:Refresh()
			return describe()
		end,
	})
end

function PowerService:Start()
	grid.RoomChanged:Connect(soon)
	grid.Changed:Connect(soon) -- digging changes the graph's steps
	economy.CrewChanged:Connect(soon)
	PowerService:Refresh()
	local since = 0
	RunService.Heartbeat:Connect(function(dt: number)
		since += dt
		if since >= REFRESH_SECONDS then
			since = 0
			PowerService:Refresh()
		end
	end)
end

return PowerService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D5"><Properties><string name="Name">ProfileService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileService: saved data (bible Section 23; Prompt 2). One profile per player, in both
	places.

	The stored value is a record { Data = profile, Lock = { Session, PlaceId, At }, Meta }.
	Every read-modify-write goes through UpdateAsync:
	* load claims the lock: a fresh lock held by another server means wait and retry (it may
	  be saving on the way out, as when a player teleports from the Lobby), and in the end
	  refuse; a stale lock (a crashed server) is taken over. Data newer than this server's
	  ProfileSchema.VERSION is never loaded or written.
	* the profile then goes through migrate, reconcile, validate (ProfileSchema.Load). A failed
	  or refused load kicks the player with a message and writes nothing.
	* saves happen every Constants.AUTOSAVE_SECONDS (staggered per player; each also refreshes
	  the lock), when the player leaves (and releases the lock) and on shutdown (BindToClose).
	  A save only writes if this server still holds the lock and the profile still validates.

	Gameplay never touches DataStores: it calls Update, AddGlowshards, SpendGlowshards and
	GrantPurchase. The player's own client sees their profile (minus receipts) in the
	"Profiles" collection of the delta channel. A session isn't ready until the profile loads
	(the "Profile" gate in SessionService).

	In Studio the store is PlayerProfiles_Studio, so tests never touch live saves; if Studio
	has no API access, an in-memory store stands in (and says so).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local TableUtil = require(Shared.Utilities.TableUtil)
local ProfileSchema = require(ServerScriptService:WaitForChild("Lib"):WaitForChild("ProfileSchema"))

local log = Log.new("ProfileService")

local IS_STUDIO = RunService:IsStudio()
local STORE_NAME = if IS_STUDIO then "PlayerProfiles_Studio" else "PlayerProfiles"
local SESSION_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local LOCK_STALE_SECONDS = if IS_STUDIO then 30 else Constants.AUTOSAVE_SECONDS * 3
local CLAIM_ATTEMPTS = 8
local CLAIM_WAIT_SECONDS = 2
local CALL_ATTEMPTS = 4
local SHUTDOWN_WAIT_SECONDS = if IS_STUDIO then 8 else 25
local GATE = "Profile"

local MESSAGES: { [string]: string } = {
	Locked = "Your save is still being written by another server. Please rejoin in a moment.",
	TooNew = "Your save is from a newer version of the game. Please rejoin to get an up-to-date server.",
	Corrupt = "We couldn't read your save, so nothing was changed. Please rejoin; if this keeps happening, let us know.",
	Invalid = "We couldn't read your save, so nothing was changed. Please rejoin; if this keeps happening, let us know.",
	Error = "Saved data is unavailable right now (Roblox DataStores). Please rejoin in a few minutes.",
	LockLost = "Your save was opened in another server, so this one stopped. Please rejoin.",
}

export type Profile = { [string]: any }

type Session = {
	Player: Player,
	Key: string,
	Data: Profile,
	Receipts: { [string]: boolean },
	Saving: boolean,
	Released: boolean,
	LockLost: boolean,
	NextSave: number,
	Saves: number,
}

local ProfileService = {
	Name = "ProfileService",
	Dependencies = { "SessionService", "ReplicationService", "DevService" },
	Loaded = Signal.new() :: Signal.Signal<Player, Profile>,
	Releasing = Signal.new() :: Signal.Signal<Player>,
}

local sessions: { [Player]: Session } = {}
local loading: { [Player]: boolean } = {}
local sessionService: any = nil
local profiles: any = nil
local store: any = nil
local storeKind = "none"
local usingDataStore = false
local shuttingDown = false
local releasesInFlight = 0

-- An in-memory store with DataStore semantics (values go through JSON, as they would).
local function memoryStore(): any
	local values: { [string]: string } = {}
	local memory = {}
	function memory.UpdateAsync(_self: any, key: string, transform: (any) -> any): any
		local current = values[key]
		local result = transform(if current then HttpService:JSONDecode(current) else nil)
		if result ~= nil then
			values[key] = HttpService:JSONEncode(result)
		end
		return result
	end
	function memory.GetAsync(_self: any, key: string): any
		local current = values[key]
		return if current then HttpService:JSONDecode(current) else nil
	end
	function memory.RemoveAsync(_self: any, key: string): any
		local current = values[key]
		values[key] = nil
		return if current then HttpService:JSONDecode(current) else nil
	end
	return memory
end

local function keyFor(userId: number): string
	return `Player_{userId}`
end

-- Calls a DataStore function with retries and backoff. Returns ok and its result or error.
local function attempt(what: string, call: () -> any): (boolean, any)
	local delay = 1
	local lastError: any = nil
	for try = 1, CALL_ATTEMPTS do
		local ok, result = pcall(call)
		if ok then
			return true, result
		end
		lastError = result
		log:Warn("%s failed (try %d of %d): %s", what, try, CALL_ATTEMPTS, tostring(result))
		if try < CALL_ATTEMPTS then
			task.wait(delay)
			delay = math.min(delay * 2, 8)
		end
	end
	return false, lastError
end

local function isForeignLock(lock: any): boolean
	return type(lock) == "table"
		and lock.Session ~= SESSION_ID
		and type(lock.At) == "number"
		and os.time() - lock.At < LOCK_STALE_SECONDS
end

local function isTooNew(data: any): boolean
	return type(data) == "table" and type(data.Version) == "number" and data.Version > ProfileSchema.VERSION
end

-- Claims a key's lock. Returns "Claimed" and the stored Data (nil for a new player), or
-- "Locked", "TooNew", "Corrupt" or "Error" (and the error).
local function claim(key: string): (string, any)
	local status, stored = "Error", nil
	local ok, err = attempt(`claim {key}`, function(): any
		status, stored = "Error", nil
		return store:UpdateAsync(key, function(old: any): any
			if old ~= nil and (type(old) ~= "table" or (old.Data ~= nil and type(old.Data) ~= "table")) then
				status = "Corrupt"
				return nil
			end
			local record = old or {}
			if isForeignLock(record.Lock) then
				status = "Locked"
				return nil
			end
			if isTooNew(record.Data) then
				status = "TooNew"
				return nil
			end
			record.Lock = { Session = SESSION_ID, PlaceId = game.PlaceId, At = os.time() }
			if type(record.Meta) ~= "table" then
				record.Meta = { Created = os.time(), Saves = 0 }
			end
			status, stored = "Claimed", record.Data
			return record
		end)
	end)
	if not ok then
		return "Error", tostring(err)
	end
	return status, stored
end

-- Gives a lock back without touching the data (after a load we can't use).
local function releaseLockOnly(key: string)
	attempt(`release {key}`, function(): any
		return store:UpdateAsync(key, function(old: any): any
			if type(old) ~= "table" or type(old.Lock) ~= "table" or old.Lock.Session ~= SESSION_ID then
				return nil
			end
			old.Lock = nil
			return old
		end)
	end)
end

-- Writes the session's profile (and releases the lock if asked). Only if we still hold it.
local function write(session: Session, release: boolean): boolean
	local valid, why = ProfileSchema.Validate(session.Data)
	if not valid then
		log:Error("%s: not saving an invalid profile (%s)", session.Key, tostring(why))
		return false
	end
	local data = session.Data
	local status = "Error"
	local ok, err = attempt(`save {session.Key}`, function(): any
		status = "Error"
		return store:UpdateAsync(session.Key, function(old: any): any
			local record = if type(old) == "table" then old else {}
			local lock = record.Lock
			if type(lock) ~= "table" or lock.Session ~= SESSION_ID then
				status = "LockLost"
				return nil
			end
			if isTooNew(record.Data) then
				status = "TooNew"
				return nil
			end
			record.Data = data
			record.Lock = if release then nil else { Session = SESSION_ID, PlaceId = game.PlaceId, At = os.time() }
			local meta = if type(record.Meta) == "table" then record.Meta else {}
			meta.Saves = (tonumber(meta.Saves) or 0) + 1
			meta.LastSave = os.time()
			meta.LastPlace = game.PlaceId
			record.Meta = meta
			status = "Saved"
			return record
		end)
	end)
	if not ok then
		log:Error("couldn't save %s: %s", session.Key, tostring(err))
		return false
	end
	if status == "LockLost" then
		session.LockLost = true
		log:Error("%s: the save lock is gone; not writing over another server", session.Key)
		if session.Player.Parent == Players and not release then
			session.Player:Kick(MESSAGES.LockLost)
		end
		return false
	end
	if status ~= "Saved" then
		log:Error("%s: save refused (%s)", session.Key, status)
		return false
	end
	session.Saves += 1
	return true
end

-- One write at a time per player; a release waits for a running save, then finishes.
local function save(session: Session, release: boolean): boolean
	while session.Saving do
		task.wait(0.1)
	end
	if session.Released or session.LockLost then
		return false
	end
	session.Saving = true
	local ok = write(session, release)
	session.Saving = false
	session.NextSave = os.clock() + Constants.AUTOSAVE_SECONDS
	if release then
		session.Released = true
	end
	return ok
end

local function publish(session: Session)
	local key = tostring(session.Player.UserId)
	if profiles:Get(key) == nil then
		profiles:Set(key, ProfileSchema.Public(session.Data))
	else
		profiles:Patch(key, ProfileSchema.Public(session.Data))
	end
end

local function load(player: Player)
	if loading[player] or sessions[player] then
		return
	end
	loading[player] = true
	local key = keyFor(player.UserId)
	local status, stored = "Locked", nil
	for try = 1, CLAIM_ATTEMPTS do
		status, stored = claim(key)
		if status ~= "Locked" or player.Parent ~= Players then
			break
		end
		log:Info("%s's save is open in another server; waiting (%d of %d)", player.Name, try, CLAIM_ATTEMPTS)
		task.wait(CLAIM_WAIT_SECONDS)
	end
	loading[player] = nil
	if status ~= "Claimed" then
		log:Error("%s: profile not loaded (%s %s)", player.Name, status, tostring(stored))
		if player.Parent == Players then
			sessionService:Fail(player, MESSAGES[status] or MESSAGES.Error)
		end
		return
	end
	local data, loadStatus, why = ProfileSchema.Load(stored)
	if not data then
		releaseLockOnly(key)
		log:Error("%s: profile %s (%s); nothing written", player.Name, loadStatus, tostring(why))
		if player.Parent == Players then
			sessionService:Fail(player, MESSAGES[loadStatus] or MESSAGES.Invalid)
		end
		return
	end
	local session: Session = {
		Player = player,
		Key = key,
		Data = data,
		Receipts = {},
		Saving = false,
		Released = false,
		LockLost = false,
		NextSave = os.clock() + (player.UserId % Constants.AUTOSAVE_SECONDS) + 5,
		Saves = 0,
	}
	for _, receiptId in data.Receipts do
		session.Receipts[receiptId] = true
	end
	if player.Parent ~= Players then
		release(session) -- left while loading: write what we migrated and let go
		return
	end
	sessions[player] = session
	publish(session)
	player:SetAttribute("ProfileLoaded", true)
	log:Info("%s: profile %s, %d Glowshards", player.Name, loadStatus, data.Glowshards)
	ProfileService.Loaded:Fire(player, data)
	sessionService:Pass(player, GATE)
end

-- Saves and lets go of a session; shutdown waits for every release in flight.
local function release(session: Session)
	releasesInFlight += 1
	local ok, err = pcall(save, session, true)
	releasesInFlight -= 1
	if not ok then
		log:Error("%s: release failed: %s", session.Key, tostring(err))
	end
end

local function leave(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	ProfileService.Releasing:Fire(player)
	profiles:Remove(tostring(player.UserId))
	release(session)
end

-- Public API --------------------------------------------------------------------------------

function ProfileService:IsLoaded(player: Player): boolean
	return sessions[player] ~= nil
end

-- The live profile (read it; change it only through Update).
function ProfileService:Get(player: Player): Profile?
	local session = sessions[player]
	return if session then session.Data else nil
end

--[[
	Changes a profile. `change` edits the table it is given and must not yield. If it errors or
	leaves the profile invalid, every change is undone and Update returns false. Changes are
	replicated to the player and saved with the next save.
]]
function ProfileService:Update(player: Player, change: (Profile) -> ()): boolean
	local session = sessions[player]
	if not session or session.Released then
		return false
	end
	local data = session.Data
	local backup = TableUtil.DeepCopy(data)
	local ok, err = pcall(change, data)
	local valid, why = true, nil
	if ok then
		valid, why = ProfileSchema.Validate(data)
	end
	if not ok or not valid then
		table.clear(data)
		for field, value in backup do
			data[field] = value
		end
		log:Error("%s: profile change undone (%s)", player.Name, tostring(if ok then why else err))
		return false
	end
	publish(session)
	return true
end

function ProfileService:AddGlowshards(player: Player, amount: number, reason: string): boolean
	assert(amount >= 0 and amount % 1 == 0, "AddGlowshards: a whole, positive amount")
	local ok = ProfileService:Update(player, function(data)
		data.Glowshards += amount
	end)
	if ok then
		log:Info("%s +%d Glowshards (%s)", player.Name, amount, reason)
	end
	return ok
end

-- Spends Glowshards if the player has enough. Returns false (and changes nothing) otherwise.
function ProfileService:SpendGlowshards(player: Player, amount: number, reason: string): boolean
	assert(amount >= 0 and amount % 1 == 0, "SpendGlowshards: a whole, positive amount")
	local data = ProfileService:Get(player)
	if not data or data.Glowshards < amount then
		return false
	end
	local ok = ProfileService:Update(player, function(profile)
		profile.Glowshards -= amount
	end)
	if ok then
		log:Info("%s -%d Glowshards (%s)", player.Name, amount, reason)
	end
	return ok
end

-- Saves now (yields). True when the profile is safely stored.
function ProfileService:SaveNow(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and save(session, false)
end

function ProfileService:HasReceipt(player: Player, receiptId: string): boolean
	local session = sessions[player]
	return session ~= nil and session.Receipts[receiptId] == true
end

--[[
	For ProcessReceipt (bible Section 17): grant first, record the receipt id in the profile,
	save, and only then tell Roblox it was granted. A repeated receipt is never granted twice:
	if the id is already recorded, the grant is skipped and only the save is redone.
]]
function ProfileService:GrantPurchase(player: Player, receiptId: string, grant: (Profile) -> ()): Enum.ProductPurchaseDecision
	local session = sessions[player]
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not session.Receipts[receiptId] then
		local ok = ProfileService:Update(player, function(data)
			grant(data)
			ProfileSchema.AddReceipt(data, receiptId)
		end)
		if not ok then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		session.Receipts[receiptId] = true
	end
	if save(session, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- DevTools ---------------------------------------------------------------------------------

local function targetOf(player: Player?, arg: any): Player?
	if type(arg) == "number" then
		return Players:GetPlayerByUserId(arg)
	end
	return player or Players:GetPlayers()[1]
end

local function summary(data: Profile): string
	local classes = TableUtil.SortedKeys(data.Classes)
	local legends = TableUtil.SortedKeys(data.Legends)
	return `v{data.Version}, {data.Glowshards} Glowshards, account level {data.AccountLevel}, `
		.. `classes {table.concat(classes :: { any }, "/")}, Legends {table.concat(legends :: { any }, "/")}, `
		.. `receipts {#data.Receipts}, first run done {tostring(data.FirstRunDone)}`
end

-- Runs the lock rules against a scratch key (Studio store only).
local function lockTest(): string
	local key = `Test_{SESSION_ID}`
	local lines = {}
	local function step(name: string, expected: string, got: string)
		table.insert(lines, `{if got == expected then "ok  " else "FAIL"} {name}: {got} (expected {expected})`)
	end
	store:RemoveAsync(key)
	step("new key", "Claimed", (claim(key)))
	store:UpdateAsync(key, function(old: any): any
		old.Lock = { Session = "another-server", PlaceId = 1, At = os.time() }
		return old
	end)
	step("fresh foreign lock", "Locked", (claim(key)))
	store:UpdateAsync(key, function(old: any): any
		old.Lock.At = os.time() - LOCK_STALE_SECONDS - 5
		return old
	end)
	step("stale foreign lock", "Claimed", (claim(key)))
	store:UpdateAsync(key, function(_old: any): any
		return { Data = { Version = ProfileSchema.VERSION + 1, Glowshards = 7 } }
	end)
	step("newer version", "TooNew", (claim(key)))
	local after = store:GetAsync(key)
	step("newer data untouched", "untouched", if after.Lock == nil and after.Data.Glowshards == 7 then "untouched" else "changed")
	store:UpdateAsync(key, function(_old: any): any
		return "garbage"
	end)
	step("corrupt record", "Corrupt", (claim(key)))
	store:RemoveAsync(key)
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("profile", {
		Description = "A player's profile (yours, or by user id).",
		Usage = "profile [userId]",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			local data = target and ProfileService:Get(target)
			if not target or not data then
				return "no loaded profile"
			end
			local session = sessions[target] :: Session
			return `{target.Name}: {summary(data)} | store {storeKind}, saves {session.Saves}`
		end,
	})
	dev:Register("profile.add", {
		Description = "Give Glowshards (testing).",
		Usage = "profile.add <amount> [userId]",
		Run = function(player: Player?, args: { any }): string?
			local amount = tonumber(args[1])
			local target = targetOf(player, args[2])
			if not amount or amount < 0 or amount % 1 ~= 0 or not target then
				return "usage: profile.add <whole amount> [userId]"
			end
			local ok = ProfileService:AddGlowshards(target, amount, "dev command")
			return if ok then `{target.Name} now has {(ProfileService:Get(target) :: Profile).Glowshards}` else "failed"
		end,
	})
	dev:Register("profile.save", {
		Description = "Save a profile now.",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			if not target then
				return "no player"
			end
			return if ProfileService:SaveNow(target) then `saved {target.Name}` else "save failed (see logs)"
		end,
	})
	dev:Register("profile.raw", {
		Description = "Read a stored record straight from the store (read-only).",
		Usage = "profile.raw [userId]",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			local userId = if type(args[1]) == "number" then args[1] else target and target.UserId
			if not userId then
				return "no player"
			end
			local ok, record = attempt("read", function(): any
				return store:GetAsync(keyFor(userId))
			end)
			if not ok then
				return `read failed: {tostring(record)}`
			end
			if record == nil then
				return "no record"
			end
			local lock = record.Lock
			local lockText = if type(lock) == "table"
				then `{if lock.Session == SESSION_ID then "this server" else tostring(lock.Session)}, {os.time() - (lock.At or 0)} s ago`
				else "none"
			local data = record.Data
			local dataText = if type(data) == "table" then summary(data) else "no data yet"
			local meta = record.Meta or {}
			return `lock: {lockText} | saves {tostring(meta.Saves)} | {dataText}`
		end,
	})
	dev:Register("profile.receipt", {
		Description = "Grant a test purchase through the receipt path (Studio only).",
		Usage = "profile.receipt <receiptId> <glowshards>",
		Run = function(player: Player?, args: { any }): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			local target = targetOf(player, nil)
			local receiptId, amount = tostring(args[1] or ""), tonumber(args[2])
			if not target or receiptId == "" or not amount or amount < 0 or amount % 1 ~= 0 then
				return "usage: profile.receipt <receiptId> <whole amount>"
			end
			local decision = ProfileService:GrantPurchase(target, receiptId, function(data)
				data.Glowshards += amount
			end)
			return `{decision.Name}; {target.Name} has {(ProfileService:Get(target) :: Profile).Glowshards} Glowshards`
		end,
	})
	dev:Register("profile.locktest", {
		Description = "Run the lock rules against a scratch key (Studio only).",
		Run = function(): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			return lockTest()
		end,
	})
end

-- Lifecycle --------------------------------------------------------------------------------

function ProfileService:Init(registry)
	sessionService = registry.SessionService
	sessionService:AddGate(GATE)
	profiles = registry.ReplicationService:Collection("Profiles", {
		Visible = function(player: Player, key: string): boolean
			return key == tostring(player.UserId)
		end,
	})
	registerCommands(registry.DevService)
end

function ProfileService:Start()
	local ok, result = pcall(function(): any
		local dataStore = DataStoreService:GetDataStore(STORE_NAME)
		dataStore:GetAsync("Probe")
		return dataStore
	end)
	if ok then
		store, storeKind, usingDataStore = result, `DataStore {STORE_NAME}`, true
	elseif IS_STUDIO then
		store, storeKind = memoryStore(), "memory (Studio has no DataStore access)"
		log:Warn("DataStores unavailable in this Studio session (%s): profiles live in memory only", tostring(result))
	else
		store, storeKind, usingDataStore = DataStoreService:GetDataStore(STORE_NAME), `DataStore {STORE_NAME}`, true
		log:Error("DataStore probe failed (%s); loads will retry", tostring(result))
	end
	log:Info("profiles in %s", storeKind)

	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(leave)

	game:BindToClose(function()
		shuttingDown = true
		for player, session in sessions do
			sessions[player] = nil
			task.spawn(release, session)
		end
		local waited = 0
		while (releasesInFlight > 0 or next(loading) ~= nil) and waited < SHUTDOWN_WAIT_SECONDS do
			waited += task.wait(0.2)
		end
		log:Info("shutdown: profiles released (%d still in flight after %.1f s)", releasesInFlight, waited)
	end)

	task.spawn(function()
		while not shuttingDown do
			task.wait(5)
			local now = os.clock()
			local budget = if usingDataStore
				then DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
				else math.huge
			for _, session in sessions do
				if budget > 10 and not session.Saving and now >= session.NextSave then
					budget -= 1
					task.spawn(save, session, false)
				end
			end
		end
	end)
end

return ProfileService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D6"><Properties><string name="Name">ReplicationService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ReplicationService: the server end of the delta channel (bible Section 23: collections
	such as rooms, residents and votes go through one delta channel; small values replicate
	as attributes instead).

	A system keeps its replicated state in collections:

		local Rooms = ReplicationService:Collection("Rooms")
		Rooms:Set("R12", { Kind = "Kitchen", Level = 1, Cell = { 2, 3 } })
		Rooms:Patch("R12", { Level = 2 })          -- only Level travels
		Rooms:Remove("R12")

	Changes are batched and flushed Constants.DELTA_HZ times a second to every ready player
	(SessionService); a player who becomes ready first gets a snapshot. Values must be
	remote-safe (Utilities.Delta.IsRemoteSafe); they are copied and frozen when set, so later
	edits to the caller's table can't leak into replicated state.

	A collection can be per-player with `Visible = function(player, key) -> boolean`
	(an inventory only its owner sees). Clients read collections through ReplicaController.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Constants = require(Shared.Constants)
local Delta = require(Shared.Utilities.Delta)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local TableUtil = require(Shared.Utilities.TableUtil)

local log = Log.new("ReplicationService")
local IS_STUDIO = RunService:IsStudio()

export type CollectionOptions = {
	Visible: ((player: Player, key: string) -> boolean)?,
}

export type Collection = {
	Name: string,
	Set: (self: Collection, key: string, value: any) -> (),
	Patch: (self: Collection, key: string, fields: { [string]: any }) -> (),
	Remove: (self: Collection, key: string) -> (),
	Clear: (self: Collection) -> (),
	Get: (self: Collection, key: string) -> any,
	All: (self: Collection) -> { [string]: any },
	Count: (self: Collection) -> number,
}

type State = {
	Name: string,
	Values: { [string]: any },
	Visible: ((player: Player, key: string) -> boolean)?,
}

local ReplicationService = {
	Name = "ReplicationService",
	Dependencies = { "SessionService", "DevService" },
}

local states: { [string]: State } = {}
local collections: { [string]: Collection } = {}
local pending: { Delta.Op } = {}
local counters = { Flushes = 0, OpsQueued = 0, EventsSent = 0, Snapshots = 0 }
local sessions: any = nil

local function queue(op: Delta.Op)
	table.insert(pending, op)
	counters.OpsQueued += 1
end

local function assertKey(state: State, key: any)
	if type(key) ~= "string" or key == "" then
		error(`{state.Name}: keys must be non-empty strings, got {tostring(key)}`, 3)
	end
end

local function assertSafe(state: State, key: string, value: any)
	local ok, why = Delta.IsRemoteSafe(value)
	if not ok then
		local message = `{state.Name}.{key} can't replicate: {why}`
		if IS_STUDIO then
			error(message, 3)
		end
		log:Error("%s", message)
	end
end

local CollectionClass = {}
CollectionClass.__index = CollectionClass

function CollectionClass.Set(self: any, key: string, value: any)
	local state: State = self._state
	assertKey(state, key)
	if value == nil then
		CollectionClass.Remove(self, key)
		return
	end
	assertSafe(state, key, value)
	if TableUtil.DeepEqual(state.Values[key], value) then
		return
	end
	local frozen = TableUtil.DeepFreeze(TableUtil.DeepCopy(value))
	state.Values[key] = frozen
	queue({ Delta.SET, state.Name, key, frozen })
end

function CollectionClass.Patch(self: any, key: string, fields: { [string]: any })
	local state: State = self._state
	assertKey(state, key)
	local old = state.Values[key]
	if type(old) ~= "table" then
		error(`{state.Name}.{key}: Patch needs an existing table value (use Set first)`, 2)
	end
	assertSafe(state, key, fields)
	local merged = Delta.Merge(old, TableUtil.DeepCopy(fields))
	local diff = Delta.Diff(old, merged)
	if not diff then
		return
	end
	state.Values[key] = TableUtil.DeepFreeze(merged)
	queue({ Delta.PATCH, state.Name, key, TableUtil.DeepFreeze(diff) })
end

function CollectionClass.Remove(self: any, key: string)
	local state: State = self._state
	assertKey(state, key)
	if state.Values[key] == nil then
		return
	end
	state.Values[key] = nil
	queue({ Delta.REMOVE, state.Name, key })
end

function CollectionClass.Clear(self: any)
	local state: State = self._state
	if next(state.Values) == nil then
		return
	end
	table.clear(state.Values)
	queue({ Delta.CLEAR, state.Name })
end

function CollectionClass.Get(self: any, key: string): any
	return self._state.Values[key]
end

-- A shallow copy of the whole collection (the values themselves are frozen).
function CollectionClass.All(self: any): { [string]: any }
	return table.clone(self._state.Values)
end

function CollectionClass.Count(self: any): number
	return TableUtil.Count(self._state.Values)
end

-- The named collection, created on first use. Options only apply when it's created.
function ReplicationService:Collection(name: string, options: CollectionOptions?): Collection
	assert(type(name) == "string" and string.find(name, "^[%a_][%w_]*$"), "Collection names are identifiers")
	local existing = collections[name]
	if existing then
		if options and options.Visible ~= states[name].Visible then
			error(`Collection {name} already exists with other options`, 2)
		end
		return existing
	end
	local state: State = { Name = name, Values = {}, Visible = options and options.Visible }
	states[name] = state
	local collection: Collection = setmetatable({ Name = name, _state = state }, CollectionClass) :: any
	collections[name] = collection
	return collection
end

local function visibleOps(player: Player, ops: { Delta.Op }): { Delta.Op }
	local list = {}
	for _, op in ops do
		local state = states[op[2]]
		local visible = state and state.Visible
		if visible == nil or op[1] == Delta.CLEAR then
			table.insert(list, op)
		else
			local ok, result = pcall(visible, player, op[3])
			if ok and result then
				table.insert(list, op)
			elseif not ok then
				log:Error("%s.Visible failed: %s", op[2], tostring(result))
			end
		end
	end
	return list
end

local function snapshotFor(player: Player): { Delta.Op }
	local ops: { Delta.Op } = {}
	for _, name in TableUtil.SortedKeys(states) do
		local state = states[name]
		for key, value in state.Values do
			table.insert(ops, { Delta.SET, name, key, value })
		end
	end
	return visibleOps(player, ops)
end

local function flush()
	if #pending == 0 then
		return
	end
	local ops = pending
	pending = {}
	counters.Flushes += 1
	local players = sessions:ReadyPlayers()
	if #players == 0 then
		return
	end
	local anyPerPlayer = false
	for _, op in ops do
		local state = states[op[2]]
		if state and state.Visible then
			anyPerPlayer = true
			break
		end
	end
	if not anyPerPlayer then
		Remotes.FireClients("Delta", players, ops, false)
		counters.EventsSent += #players
		return
	end
	for _, player in players do
		local list = visibleOps(player, ops)
		if #list > 0 then
			Remotes.FireClient("Delta", player, list, false)
			counters.EventsSent += 1
		end
	end
end

function ReplicationService:Init(registry)
	sessions = registry.SessionService
	local dev = registry.DevService

	dev:Register("rep", {
		Description = "Delta channel: collections, sizes and traffic.",
		Run = function(_player: Player?, _args: { any }): string?
			local lines = {
				("flushes %d, ops queued %d, events sent %d, snapshots %d, pending %d"):format(
					counters.Flushes,
					counters.OpsQueued,
					counters.EventsSent,
					counters.Snapshots,
					#pending
				),
			}
			for _, name in TableUtil.SortedKeys(states) do
				local state = states[name]
				local scope = if state.Visible then " (per player)" else ""
				table.insert(lines, `  {name}: {TableUtil.Count(state.Values)} values{scope}`)
			end
			return table.concat(lines, "\n")
		end,
	})

	dev:Register("rep.selftest", {
		Description = "Runs set, patch and remove on the _SelfTest collection; compare with `/dev replica _SelfTest` on a client.",
		Run = function(_player: Player?, _args: { any }): string?
			local test = ReplicationService:Collection("_SelfTest")
			test:Clear()
			test:Set("Alpha", { Count = 1, Label = "first", Tags = { "a", "b" } })
			test:Patch("Alpha", { Count = 2, Label = Delta.NONE })
			test:Set("Beta", { Count = 10 })
			test:Remove("Beta")
			test:Set("Gamma", { Where = Vector3.new(1, 2, 3), Done = true })
			test:Set("Stamp", { At = workspace:GetServerTimeNow() })
			return "queued: Alpha {Count=2, Tags={a,b}}, Gamma {Where=1,2,3, Done=true}, Stamp; Beta removed"
		end,
	})
end

function ReplicationService:Start()
	sessions.PlayerReady:Connect(function(player: Player)
		local ops = snapshotFor(player)
		Remotes.FireClient("Delta", player, ops, true)
		counters.Snapshots += 1
		log:Debug("snapshot to %s: %d values", player.Name, #ops)
	end)
	local interval = 1 / Constants.DELTA_HZ
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt: number)
		elapsed += dt
		if elapsed >= interval then
			elapsed = 0
			flush()
		end
	end)
end

-- Server-side view of a collection's values (for DevTools and tests).
function ReplicationService:Peek(name: string): { [string]: any }?
	local state = states[name]
	return if state then table.clone(state.Values) else nil
end

return ReplicationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D7"><Properties><string name="Name">ResidentBrain</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ResidentBrain: residents' routines and behaviour states in the world, phase 1 (bible Sections
	11 and 23). Run place only.

	Every resident in ResidentService has a body: a clone of ServerStorage.Assets.Residents
	.Resident_Common (the A0 resident; A3 brings the full kit) in workspace.Bunker.Residents,
	named by the resident's id, with ResidentId and Activity attributes. NPCAnimator (client)
	plays clips from Activity (Section 23).

	The routine, worked out 5 times a second (Section 11: work a shift, eat at the Kitchen, rest
	in Quarters; Tuning.Residents, provisional):
	* the first MealSeconds of each day: a seat at a Kitchen (standing room when the seats run out);
	* the rest of the day: a work spot in their job's room (WorkSpot1, 2... in the order they
	  joined it); with no job, their bed;
	* the Surge: their bed in the Quarters (Bed1, 2... by arrival; no bed: standing in the Quarters).
	* idle during the day: a seat in the Lounge when there is one (Section 11: socialise in the
	  Lounge; Landon, Nov 8, 2026), or by their bed.
	* Down: lying where they fell with a Revive prompt (a Medkit from the stockpile); dead: gone.
	* Danger (Prompt 12; Section 11: in danger the unarmed flee to the nearest safe room, and
	  they handle a single Burrow Tick themselves): a monster in their room, or within
	  ResidentFleeRadius on their floor, sends them to the nearest room with no monster in or
	  next to it, until ResidentCalmSeconds pass with none near. A lone Burrow Tick they swat
	  (ResidentSwatDamage every ResidentSwatSeconds). Spitter goo slows them (SlowedUntil).
	* Disasters (Prompt 13; Section 11: residents caught in a disaster fight it if they can, and
	  handle a small fire in their own room): a resident in a burning room beats the fire down
	  (Activity Extinguish; DisasterService counts them) until their health falls below
	  Tuning.Disasters.Fire.ResidentFleeHealth, then flees to a room with no fire and no monster,
	  and keeps out of burning rooms while that hurt. Cave-in rubble (Lib.Hazards) blocks
	  passages: routes go around it, and a resident with no way round is Trapped (they wait
	  where they are; ResidentService takes them off their crew) until it is cleared. When
	  rubble falls or is cleared, everyone plans their way again.
	They walk the room graph (Lib.PathGraph: doorways, Shaft stairs) with Humanoid:MoveTo, at a
	speed from their Speed stat. A resident stuck for STUCK_SECONDS steps to their next waypoint.
	Residents pass through each other and through players (collision groups).

	API:
		ResidentBrain:Body(id): Model?
		ResidentBrain:Activity(id): string?
]]

local Players = game:GetService("Players")
local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)
local Hazards = require(ServerScriptService.Lib.Hazards)
local PathGraph = require(ServerScriptService.Lib.PathGraph)

local log = Log.new("ResidentBrain")

local ResidentBrain = {
	Name = "ResidentBrain",
	Dependencies = { "ResidentService", "BunkerGrid", "CycleClock", "CombatService", "DevService" },
}

local TICK = 0.2 -- 5 Hz (Section 23)
local ARRIVE = 2 -- studs
local STUCK_SECONDS = 2.5
local RESIDENT_GROUP, PLAYER_GROUP = "Residents", "Players"

type Body = {
	Id: string,
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Goal: string?, -- what it is heading for: "Work:R4:WorkSpot2"
	GoalActivity: string,
	Points: { Vector3 },
	Index: number,
	Best: number, -- closest it has come to the current waypoint
	Since: number, -- when it last got closer
	Lying: boolean,
	Prompt: ProximityPrompt?,
	Trapped: boolean, -- rubble cuts them off from their goal (Prompt 13)
	HazardVersion: number, -- Lib.Hazards' version when the goal was planned
}

local residents: any = nil
local grid: any = nil
local clock: any = nil
local combat: any = nil
local fleeing: { [string]: { Until: number, Room: string? } } = {}
local swattedAt: { [string]: number } = {}
local bodies: { [string]: Body } = {}
local folder: Folder? = nil
local dayStartedAt = os.clock()

local function bodiesFolder(): Folder?
	if folder and folder.Parent then
		return folder
	end
	local root = grid:Root()
	if not root then
		return nil
	end
	local found = root:FindFirstChild("Residents")
	if not found then
		found = Instance.new("Folder")
		found.Name = "Residents"
		found.Parent = root
	end
	folder = found :: Folder
	return folder
end

local function setActivity(body: Body, activity: string)
	if body.Model:GetAttribute("Activity") ~= activity then
		body.Model:SetAttribute("Activity", activity)
	end
end

local function lie(body: Body, at: CFrame?)
	if body.Lying then
		return
	end
	body.Lying = true
	body.Humanoid:MoveTo(body.Root.Position)
	local base = at or body.Root.CFrame
	body.Root.Anchored = true
	-- on the back, a little above what they lie on
	body.Root.CFrame = CFrame.new(base.Position + Vector3.new(0, 1.2, 0)) * CFrame.Angles(-math.pi / 2, 0, 0)
end

local function standUp(body: Body)
	if not body.Lying then
		return
	end
	body.Lying = false
	local position = body.Root.Position
	body.Root.CFrame = CFrame.new(position + Vector3.new(0, 2, 0))
	body.Root.Anchored = false
end

local function speedFor(id: string): number
	local resident = residents:Get(id)
	local t = Config.Get("Tuning", "Residents")
	return t.WalkSpeedBase + (if resident then resident.Stats.Speed or 0 else 5) * t.WalkSpeedPerSpeed
end

local function slowedSpeed(body: any): number
	local base = speedFor(body.Id)
	local slowed = body.Model:GetAttribute("SlowedUntil")
	if type(slowed) == "number" and slowed > workspace:GetServerTimeNow() then
		return base * Config.Get("Tuning", "MonsterAI").GooSlowMultiplier
	end
	return base
end

local function spawnBody(id: string): Body?
	local holder = bodiesFolder()
	local assets = ServerStorage:FindFirstChild("Assets")
	local source = assets and assets:FindFirstChild("Residents") and assets.Residents:FindFirstChild("Resident_Common")
	if not holder or not source then
		log:Warn("no resident model (ServerStorage.Assets.Residents.Resident_Common) or no bunker yet")
		return nil
	end
	local model = (source :: Model):Clone()
	model.Name = id
	model:SetAttribute("ResidentId", id)
	model:SetAttribute("Activity", "Idle")
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	if not humanoid or not root then
		model:Destroy()
		log:Warn("the resident model has no Humanoid or HumanoidRootPart")
		return nil
	end
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.BreakJointsOnDeath = false
	humanoid.WalkSpeed = speedFor(id)
	if not humanoid:FindFirstChildOfClass("Animator") then
		Instance.new("Animator").Parent = humanoid
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CollisionGroup = RESIDENT_GROUP
			part.Anchored = false
			if part ~= root then
				part.CanCollide = false
			end
		end
	end
	-- start in their job room, or the Quarters, or the Medbay
	local resident = residents:Get(id)
	local room = (resident and resident.Job and grid:Room(resident.Job)) or grid:RoomsOfType("Quarters")[1]
		or grid:RoomsOfType("Medbay")[1]
	local start = if room then Grid.CellPosition(room.Floor, room.Column) else Vector3.zero
	model:PivotTo(CFrame.new(start + Vector3.new(0, 3, 8)))
	model.Parent = holder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local body: Body = {
		Id = id, Model = model, Humanoid = humanoid, Root = root, Goal = nil, GoalActivity = "Idle",
		Points = {}, Index = 1, Best = math.huge, Since = os.clock(), Lying = false, Prompt = nil,
		Trapped = false, HazardVersion = 0,
	}
	bodies[id] = body
	return body
end

-- Where a resident should be, and doing what -------------------------------------------------------

local function socketsOf(roomId: string, pattern: string): { CFrame }
	local model = grid:RoomModel(roomId)
	if not model then
		return {}
	end
	local found = BunkerKit.Sockets(model, pattern)
	local names = {}
	for name in found do
		table.insert(names, name)
	end
	table.sort(names, function(a: string, b: string): boolean
		return (tonumber(string.match(a, "%d+")) or 0) < (tonumber(string.match(b, "%d+")) or 0)
	end)
	local list = {}
	for _, name in names do
		table.insert(list, found[name])
	end
	return list
end

-- The n-th spot of a kind across every room of a type (seats in every Kitchen, beds in every
-- Quarters), or a place to stand in the first of those rooms when they run out.
local function spotAcross(roomType: string, pattern: string, n: number): (string?, CFrame?)
	local rooms = grid:RoomsOfType(roomType)
	table.sort(rooms, function(a, b)
		return a.Id < b.Id
	end)
	local i = n
	for _, room in rooms do
		local spots = socketsOf(room.Id, pattern)
		if i <= #spots then
			return room.Id, spots[i]
		end
		i -= #spots
	end
	local room = rooms[1]
	if room then
		local cell = Grid.CellPosition(room.Floor, room.Column + (n % room.Span))
		return room.Id, CFrame.new(cell + Vector3.new(((n * 3) % 12) - 6, 0, 4))
	end
	return nil, nil
end

-- Danger (Prompt 12) ---------------------------------------------------------------------------

local function unitAt(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

local function monstersNear(position: Vector3): { any }
	local t = Config.Get("Tuning", "MonsterAI")
	local near = {}
	local myUnit = unitAt(position)
	local myFloor = Grid.CellAt(position)
	for _, c in combat:All("Monsters") do
		local floor = Grid.CellAt(c.Root.Position)
		local sameUnit = myUnit ~= nil and unitAt(c.Root.Position) == myUnit
		if sameUnit or (floor == myFloor and (c.Root.Position - position).Magnitude <= t.ResidentFleeRadius) then
			table.insert(near, c)
		end
	end
	return near
end

-- The nearest room (by the room graph) with no monster in it or next to it; else any room with
-- none in it.
local function safeRoom(fromUnit: string?): string?
	if not fromUnit then
		return nil
	end
	local danger: { [string]: boolean } = {}
	for _, c in combat:All("Monsters") do
		local unit = unitAt(c.Root.Position)
		if unit then
			danger[unit] = true
		end
	end
	for unit in Hazards.Fires() do
		danger[unit] = true -- a burning room is no refuge (Prompt 13)
	end
	local bunker = grid:Bunker()
	local seen: { [string]: boolean } = { [fromUnit] = true }
	local queue = { fromUnit }
	local fallback: string? = nil
	local index = 1
	while index <= #queue do
		local unit = queue[index]
		index += 1
		local room = grid:Room(unit)
		if unit ~= fromUnit and room and room.Type ~= "Shaft" and not danger[unit] then
			local nextToDanger = false
			for _, other in bunker:Neighbors(unit) do
				if danger[other] then
					nextToDanger = true
				end
			end
			if not nextToDanger then
				return unit
			end
			fallback = fallback or unit
		end
		for _, other in Hazards.Neighbors(bunker, unit) do
			if not seen[other] then
				seen[other] = true
				table.insert(queue, other)
			end
		end
	end
	return fallback
end

local function danger(id: string): (string?, string?, CFrame?, string?)
	local body = bodies[id]
	if not body or not combat then
		return nil
	end
	local t = Config.Get("Tuning", "MonsterAI")
	local near = monstersNear(body.Root.Position)
	if #near == 1 and near[1].MonsterType == "BurrowTick" then
		fleeing[id] = nil
		return `Swat:{near[1].Id}`, nil, nil, "Fight"
	end
	local flee = fleeing[id]
	if #near > 0 then
		local room = if flee then flee.Room else nil
		local current = if room then grid:Room(room) else nil
		if not current or #monstersNear(Grid.CellPosition(current.Floor, current.Column)) > 0 then
			room = safeRoom(unitAt(body.Root.Position))
		end
		flee = { Until = os.clock() + t.ResidentCalmSeconds, Room = room }
		fleeing[id] = flee
	end
	-- fire where they stand (Prompt 13): fight it while they can, else get out
	local here = unitAt(body.Root.Position)
	if #near == 0 and here and Hazards.Fire(here) then
		local resident = residents:Get(id)
		local f = Config.Get("Tuning", "Disasters").Fire
		local healthy = resident ~= nil and resident.Health >= resident.MaxHealth * f.ResidentFleeHealth
		if healthy and not (flee and os.clock() < flee.Until) then
			local room = grid:Room(here)
			if room then
				local n = tonumber(string.match(id, "%d+")) or 0
				local cell = Grid.CellPosition(room.Floor, room.Column + n % room.Span)
				local spot = CFrame.new(cell + Vector3.new(((n * 5) % 15) - 7, 0, 3))
				return `Extinguish:{here}`, here, spot, "Extinguish"
			end
		end
		if not flee or not flee.Room or Hazards.Fire(flee.Room) then
			flee = { Until = os.clock() + t.ResidentCalmSeconds, Room = safeRoom(here) }
			fleeing[id] = flee
		end
	end
	if flee and os.clock() < flee.Until and flee.Room and grid:Room(flee.Room) then
		local room = grid:Room(flee.Room)
		local spot = CFrame.new(Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, 0, 4))
		return `Flee:{flee.Room}`, flee.Room, spot, "Flee"
	end
	fleeing[id] = nil
	return nil
end

local routine: (id: string, order: number, resident: any) -> (string, string?, CFrame?, string)

local function plan(id: string, order: number): (string, string?, CFrame?, string)
	local resident = residents:Get(id)
	if not resident then
		return "Gone", nil, nil, "Idle"
	end
	if resident.State == "Down" then
		return "Down", nil, nil, "Down"
	end
	local threatGoal, threatRoom, threatSpot, threatActivity = danger(id)
	if threatGoal then
		return threatGoal, threatRoom, threatSpot, threatActivity :: string
	end
	local goal, roomId, spot, activity = routine(id, order, resident)
	-- too hurt to fight a fire (Prompt 13): they keep out of burning rooms and wait where they are
	if roomId and Hazards.Fire(roomId) then
		local f = Config.Get("Tuning", "Disasters").Fire
		if resident.Health < resident.MaxHealth * f.ResidentFleeHealth then
			local body = bodies[id]
			local here = if body then unitAt(body.Root.Position) else nil
			if here ~= roomId then
				return "Wait:fire", nil, nil, "Idle"
			end
		end
	end
	return goal, roomId, spot, activity
end

routine = function(id: string, order: number, resident: any): (string, string?, CFrame?, string)
	local phase = clock:Phase()
	local mealSeconds = Config.Get("Tuning", "Residents").MealSeconds / math.max(clock:TimeScale(), 0.01)
	if phase == "Surge" or not clock:IsRunning() and phase == nil then
		local roomId, spot = spotAcross("Quarters", "^Bed%d+$", order)
		return `Sleep:{roomId}:{order}`, roomId, spot, "Sleep"
	end
	if phase == "Day" and os.clock() - dayStartedAt < mealSeconds and #grid:RoomsOfType("Kitchen") > 0 then
		local roomId, spot = spotAcross("Kitchen", "^Seat%d+$", order)
		return `Eat:{roomId}:{order}`, roomId, spot, "Eat"
	end
	if resident.Job and grid:Room(resident.Job) then
		local workers = residents:Workers(resident.Job)
		local index = 1
		for i, worker in workers do
			if worker.Id == id then
				index = i
			end
		end
		local spots = socketsOf(resident.Job, "^WorkSpot%d+$")
		local room = grid:Room(resident.Job)
		local spot = spots[index] or spots[1]
			or CFrame.new(Grid.CellPosition(room.Floor, room.Column) + Vector3.new(0, 0, 4))
		return `Work:{resident.Job}:{index}`, resident.Job, spot, "Work"
	end
	if #grid:RoomsOfType("Lounge") > 0 then
		local roomId, spot = spotAcross("Lounge", "^Seat%d+$", order)
		return `Idle:{roomId}:{order}`, roomId, spot, "Idle"
	end
	local roomId, spot = spotAcross("Quarters", "^Bed%d+$", order)
	return `Idle:{roomId}:{order}`, roomId, spot, "Idle"
end

local function unitOf(position: Vector3): string?
	local floor, column = Grid.CellAt(position)
	if not floor or not column then
		return nil
	end
	return grid:Bunker():UnitAt(floor, column)
end

local function setGoal(body: Body, goal: string, roomId: string?, spot: CFrame?, activity: string)
	body.HazardVersion = Hazards.Version()
	body.Goal = goal
	body.GoalActivity = activity
	body.Points = {}
	body.Index = 1
	body.Best = math.huge
	body.Since = os.clock()
	if not roomId or not spot then
		return
	end
	standUp(body)
	local from = unitOf(body.Root.Position)
	local to = unitOf(spot.Position + Vector3.new(0, 1, 0)) or roomId
	local points, why = nil, nil
	if from then
		points, why = PathGraph.Waypoints(grid:Bunker(), function(unit: string): Model?
			return grid:RoomModel(unit)
		end, body.Root.Position, from, to, spot.Position)
	end
	if why == "Blocked" then
		-- cave-in rubble cuts them off (Prompt 13): they wait where they are until it's cleared
		body.Points = {}
		body.GoalActivity = "Idle"
		body.Humanoid:MoveTo(body.Root.Position)
		setActivity(body, "Idle")
		if not body.Trapped then
			body.Trapped = true
			residents:SetTrapped(body.Id, true)
		end
		return
	end
	if body.Trapped then
		body.Trapped = false
		residents:SetTrapped(body.Id, false)
	end
	body.Points = points or { spot.Position }
	setActivity(body, "Walk")
end

local function revivePrompt(body: Body, on: boolean)
	if on and not body.Prompt then
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Revive (1 Medkit)"
		local resident = residents:Get(body.Id)
		prompt.ObjectText = if resident then Residents.Name(resident) else "Resident"
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 8
		prompt.RequiresLineOfSight = false
		prompt.Style = Enum.ProximityPromptStyle.Custom -- drawn by PromptController (Prompt 11)
		prompt:SetAttribute("Kind", "ReviveResident")
		prompt.Triggered:Connect(function(player: Player)
			local ok, why = residents:Revive(body.Id, player)
			if not ok and why then
				Remotes.FireClient("Alert", player, "Warning", why)
			end
		end)
		prompt.Parent = body.Root
		body.Prompt = prompt
	elseif not on and body.Prompt then
		body.Prompt:Destroy()
		body.Prompt = nil
	end
end

local function step(body: Body, order: number)
	local goal, roomId, spot, activity = plan(body.Id, order)
	if goal == "Gone" then
		return
	end
	if goal == "Down" then
		if body.Goal ~= "Down" then
			body.Goal = "Down"
			body.Points = {}
			lie(body, nil)
			setActivity(body, "Down")
			revivePrompt(body, true)
		end
		return
	end
	if body.Goal == "Down" then
		revivePrompt(body, false)
		standUp(body)
	end
	if goal ~= body.Goal or body.HazardVersion ~= Hazards.Version() then
		setGoal(body, goal, roomId, spot, activity)
	end
	local speed = slowedSpeed(body)
	if math.abs(body.Humanoid.WalkSpeed - speed) > 0.05 then
		body.Humanoid.WalkSpeed = speed
	end
	if string.sub(goal, 1, 5) == "Swat:" then
		-- a lone Burrow Tick: stand and swat it (Section 11)
		local tickId = string.sub(goal, 6)
		local tick = combat:Get(tickId)
		if tick and tick.State == "Alive" then
			local t = Config.Get("Tuning", "MonsterAI")
			local flat = Vector3.new(tick.Root.Position.X, body.Root.Position.Y, tick.Root.Position.Z)
			if (flat - body.Root.Position).Magnitude > 4 then
				body.Humanoid:MoveTo(flat)
			else
				body.Humanoid:MoveTo(body.Root.Position)
				if os.clock() - (swattedAt[body.Id] or 0) >= t.ResidentSwatSeconds then
					swattedAt[body.Id] = os.clock()
					combat:Damage(tickId, t.ResidentSwatDamage, body.Id, "swatted")
				end
			end
			setActivity(body, "Fight")
		end
		return
	end
	local target = body.Points[body.Index]
	if not target then
		-- arrived: face the spot's way, and lie down in bed
		if body.Model:GetAttribute("Activity") ~= body.GoalActivity then
			setActivity(body, body.GoalActivity)
			if body.GoalActivity == "Sleep" and spot and string.match(goal, "^Sleep") then
				lie(body, spot)
			end
		end
		return
	end
	local root = body.Root
	local distance = (Vector3.new(target.X, 0, target.Z) - Vector3.new(root.Position.X, 0, root.Position.Z)).Magnitude
	if distance <= ARRIVE and math.abs(target.Y - (root.Position.Y - 3)) < 6 then
		body.Index += 1
		body.Best = math.huge
		body.Since = os.clock()
		local nextPoint = body.Points[body.Index]
		if nextPoint then
			body.Humanoid:MoveTo(nextPoint)
		else
			body.Humanoid:MoveTo(root.Position)
		end
		return
	end
	if distance < body.Best - 0.5 then
		body.Best = distance
		body.Since = os.clock()
	elseif os.clock() - body.Since > STUCK_SECONDS then
		-- stuck on furniture or a corner: step to the waypoint
		root.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
		body.Best = math.huge
		body.Since = os.clock()
	end
	body.Humanoid:MoveTo(target)
end

-- Lifecycle -----------------------------------------------------------------------------------------

function ResidentBrain:Body(id: string): Model?
	local body = bodies[id]
	return if body then body.Model else nil
end

function ResidentBrain:Activity(id: string): string?
	local body = bodies[id]
	return if body then body.Model:GetAttribute("Activity") :: string? else nil
end

local function sync()
	for _, resident in residents:All() do
		local body = bodies[resident.Id]
		if resident.State == "Dead" then
			if body then
				bodies[resident.Id] = nil
				local model = body.Model
				task.delay(2, function()
					model:Destroy()
				end)
			end
		elseif not body then
			spawnBody(resident.Id)
		elseif body.Model.Parent == nil then
			bodies[resident.Id] = nil
		end
	end
end

local function groups()
	pcall(function()
		PhysicsService:RegisterCollisionGroup(RESIDENT_GROUP)
		PhysicsService:RegisterCollisionGroup(PLAYER_GROUP)
	end)
	PhysicsService:CollisionGroupSetCollidable(RESIDENT_GROUP, RESIDENT_GROUP, false)
	PhysicsService:CollisionGroupSetCollidable(RESIDENT_GROUP, PLAYER_GROUP, false)
	local function character(model: Model)
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") then
				part.CollisionGroup = PLAYER_GROUP
			end
		end
		model.DescendantAdded:Connect(function(part: Instance)
			if part:IsA("BasePart") then
				part.CollisionGroup = PLAYER_GROUP
			end
		end)
	end
	local function player(p: Player)
		if p.Character then
			character(p.Character)
		end
		p.CharacterAdded:Connect(character)
	end
	for _, p in Players:GetPlayers() do
		player(p)
	end
	Players.PlayerAdded:Connect(player)
end

function ResidentBrain:Init(registry)
	residents = registry.ResidentService
	grid = registry.BunkerGrid
	clock = registry.CycleClock
	combat = registry.CombatService
	registry.DevService:Register("brains", {
		Description = "Where every resident is going and what they are doing.",
		Usage = "brains",
		Run = function(): string?
			local lines = {}
			for id, body in bodies do
				table.insert(lines, string.format("%s %s -> %s (waypoint %d of %d), at %s", id,
					tostring(body.Model:GetAttribute("Activity")), tostring(body.Goal), body.Index, #body.Points,
					tostring(Vector3.new(math.floor(body.Root.Position.X), math.floor(body.Root.Position.Y), math.floor(body.Root.Position.Z)))))
			end
			table.sort(lines)
			return if #lines > 0 then table.concat(lines, "\n") else "no resident bodies"
		end,
	})
end

function ResidentBrain:Start()
	groups()
	clock.CycleStarted:Connect(function()
		dayStartedAt = os.clock()
	end)
	residents.Changed:Connect(function(id: string)
		local body = bodies[id]
		if body then
			body.Humanoid.WalkSpeed = speedFor(id)
		end
		sync()
	end)
	sync()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc < TICK then
			return
		end
		acc = 0
		local order = 0
		for _, resident in residents:All() do
			local body = bodies[resident.Id]
			if body and resident.State ~= "Dead" then
				order += 1
				local ok, err = pcall(step, body, order)
				if not ok then
					log:Warn("%s: %s", resident.Id, tostring(err))
				end
			end
		end
	end)
	log:Info("%d resident bodies in the bunker", #residents:All())
end

return ResidentBrain
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D8"><Properties><string name="Name">ResidentService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ResidentService: resident data, jobs, needs, morale, levels and death, phase 1 (bible Sections
	11 and 23). Run place only. The rules are Shared.Rules.Residents; walking and routines are
	ResidentBrain's.

	* The six founders (Tuning.StartingBunker: Common, levels 1 to 3) arrive idle when the run
	  starts (Landon, Nov 8, 2026): the players give them their jobs, and on a first run the
	  tutorial does (Prompt 31). Until someone works the Reactor Core the bunker is dark. When the
	  run starts, the team is told who is waiting for work.
	* Jobs: AssignResident (a room id, or "" for none) and AutoAssign come from players, with no
	  vote (Section 8). A room's crew goes to EconomyService (SetResidents), which works out
	  production and power. When a room goes, its workers move to the room standing in its cells
	  (a merge) if it has room, or go idle.
	* Every cycle, after the meal (EconomyService.Ate), each resident's needs move (Rules.Residents
	  .Cycle): rest with work and beds, the meal (the newest arrivals go hungry first when the
	  stockpile runs short; Landon, Nov 8, 2026), morale with job fit, dark job rooms and beds. Workers gain
	  XPPerWorkCycle; each level adds 1 to their job's stat. A staffed, lit Medbay heals the hurt.
	  Surviving a Surge gives everyone SurgeSurvivedMorale.
	* At 0 health a resident is down for DeathReviveSeconds: a player can revive them with a
	  Medkit from the stockpile (ReviveResident). Then they are gone for the run. When the last
	  one is gone, the run is lost (RunDirector, "ResidentsLost").
	* Trapped (Prompt 13): cave-in rubble cuts a resident off from where they need to be
	  (ResidentBrain says so). A trapped resident isn't in their room's crew until they are free.
	* Replication: the Residents collection, id -> { Name, First, Last, Age, Tier, Level, XP,
	  XPNext, Stats, Job, Health, MaxHealth, Rest, Morale, Mood, State, Hungry, Trapped, DownUntil }.

	API:
		ResidentService:All(): { Resident }, :Get(id), :Workers(roomId)
		ResidentService:Assign(id, roomId?): (boolean, string?)
		ResidentService:AutoAssign(): number          -- residents given a job
		ResidentService:Hurt(id, amount, how), :Revive(id, player?): (boolean, string?)
		ResidentService:SetTrapped(id, on)              -- ResidentBrain (Prompt 13)
		ResidentService:Add(tier?, level?): string    -- a new resident (recruits, rescues; DevTools)
		ResidentService.Changed: Signal<string>         -- a resident's data changed
		ResidentService.Assigned: Signal<string, string?> -- resident, room (first-run objective 1)
		ResidentService.Died: Signal<string, string>    -- resident, how
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Residents = require(Shared.Rules.Residents)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("ResidentService")

type Resident = Residents.Resident

local ResidentService = {
	Name = "ResidentService",
	Dependencies = { "BunkerGrid", "EconomyService", "PowerService", "CycleClock", "RunDirector", "SessionService", "ReplicationService", "DevService" },
	Changed = Signal.new() :: Signal.Signal<string>,
	Assigned = Signal.new() :: Signal.Signal<string, string?>,
	Died = Signal.new() :: Signal.Signal<string, string>,
}

local grid: any = nil
local economy: any = nil
local power: any = nil
local clock: any = nil
local director: any = nil
local session: any = nil
local collection: any = nil
local rng = Random.new()
local residents: { [string]: Resident } = {}
local count = 0
local usedNames: { [string]: boolean } = {}
local downUntil: { [string]: number } = {}
local downHow: { [string]: string } = {}
local jobCells: { [string]: { number } } = {} -- room id -> { floor, column } of the rooms people work in

local function announce(kind: string, text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), kind, text)
end

local function order(id: string): number
	return tonumber(string.match(id, "%d+")) or 0
end

local function sorted(): { Resident }
	local list = {}
	for _, resident in residents do
		table.insert(list, resident)
	end
	table.sort(list, function(a: Resident, b: Resident): boolean
		return order(a.Id) < order(b.Id)
	end)
	return list
end

local function logLine(resident: Resident, text: string)
	table.insert(resident.Log, `Year {RunState.Get("Year") or 1}: {text}`)
	if #resident.Log > 20 then
		table.remove(resident.Log, 1)
	end
end

local function publish(resident: Resident)
	local mood = Residents.MoraleState(resident.Morale)
	collection:Set(resident.Id, {
		Name = Residents.Name(resident),
		First = resident.First,
		Last = resident.Last,
		Age = resident.Age,
		Tier = resident.Tier,
		Level = resident.Level,
		XP = math.floor(resident.XP),
		XPNext = Residents.XPToLevel(resident.Level),
		Stats = table.clone(resident.Stats),
		Job = resident.Job,
		Health = math.floor(resident.Health + 0.5),
		MaxHealth = resident.MaxHealth,
		Rest = math.floor(resident.Rest + 0.5),
		Morale = math.floor(resident.Morale + 0.5),
		Mood = mood,
		State = resident.State,
		Hungry = resident.Hungry,
		Trapped = resident.Trapped == true,
		DownUntil = downUntil[resident.Id],
		Log = table.clone(resident.Log),
	})
	ResidentService.Changed:Fire(resident.Id)
end

-- Queries ------------------------------------------------------------------------------------------

function ResidentService:All(): { Resident }
	return sorted()
end

function ResidentService:Get(id: string): Resident?
	return residents[id]
end

function ResidentService:Workers(roomId: string): { Resident }
	local list = {}
	for _, resident in sorted() do
		if resident.Job == roomId and resident.State ~= "Dead" then
			table.insert(list, resident)
		end
	end
	return list
end

local function slotsFree(roomId: string, except: string?): number
	local room = grid:Room(roomId)
	if not room then
		return 0
	end
	local used = 0
	for _, resident in residents do
		if resident.Job == roomId and resident.State ~= "Dead" and resident.Id ~= except then
			used += 1
		end
	end
	return Residents.Slots(room.Type, room.Level, room.Span) - used
end

-- Jobs ---------------------------------------------------------------------------------------------

local function setJob(resident: Resident, roomId: string?)
	resident.Job = roomId
	if roomId then
		local room = grid:Room(roomId)
		if room then
			jobCells[roomId] = { room.Floor, room.Column }
		end
	end
	publish(resident)
	ResidentService.Assigned:Fire(resident.Id, roomId)
end

function ResidentService:Assign(id: string, roomId: string?): (boolean, string?)
	local resident = residents[id]
	if not resident or resident.State == "Dead" then
		return false, "That resident isn't in the bunker."
	end
	if roomId == nil then
		if resident.Job then
			setJob(resident, nil)
			economy:RefreshCrew()
		end
		return true, nil
	end
	local room = grid:Room(roomId)
	if not room then
		return false, "That room isn't there any more."
	end
	if not Residents.JobStat(room.Type) then
		return false, `Nobody works in the {Config.Get("Rooms", room.Type).Name}.`
	end
	if resident.Job == roomId then
		return true, nil
	end
	if slotsFree(roomId, id) <= 0 then
		return false, `The {Config.Get("Rooms", room.Type).Name} is full.`
	end
	setJob(resident, roomId)
	log:Info("%s works in %s (%s) now", Residents.Name(resident), roomId, room.Type)
	economy:RefreshCrew()
	return true, nil
end

function ResidentService:AutoAssign(): number
	local free = {}
	local taken: { [string]: number } = {}
	for _, resident in sorted() do
		if resident.State == "Alive" then
			if resident.Job and grid:Room(resident.Job) then
				taken[resident.Job] = (taken[resident.Job] or 0) + 1
			else
				table.insert(free, resident)
			end
		end
	end
	local rooms = {}
	for _, room in grid:Rooms() do
		table.insert(rooms, { Id = room.Id, Type = room.Type, Level = room.Level, Span = room.Span })
	end
	local plan = Residents.AutoAssign(rooms, taken, free)
	local n = 0
	for residentId, roomId in plan do
		local resident = residents[residentId]
		if resident then
			setJob(resident, roomId)
			n += 1
		end
	end
	if n > 0 then
		economy:RefreshCrew()
		log:Info("Auto-Assign gave %d resident(s) a job", n)
	end
	return n
end

-- A room went: its workers move to the room now standing in its cells (a merge), or go idle.
local function roomChanged(roomId: string)
	if grid:Room(roomId) then
		return
	end
	local cell = jobCells[roomId]
	jobCells[roomId] = nil
	local successor = if cell then grid:RoomAt(cell[1], cell[2]) else nil
	local moved = false
	for _, resident in sorted() do
		if resident.Job == roomId then
			if successor and Residents.JobStat(successor.Type) and slotsFree(successor.Id) > 0 then
				setJob(resident, successor.Id)
			else
				setJob(resident, nil)
			end
			moved = true
		end
	end
	if moved then
		economy:RefreshCrew()
	end
end

-- Health and death ---------------------------------------------------------------------------------

local function goDown(resident: Resident, how: string)
	if resident.State ~= "Alive" then
		return
	end
	resident.State = "Down"
	resident.Health = 0
	downUntil[resident.Id] = workspace:GetServerTimeNow() + Config.Get("Tuning", "Residents").DeathReviveSeconds
	downHow[resident.Id] = how
	logLine(resident, `fell ({how})`)
	publish(resident)
	economy:RefreshCrew()
	announce("Danger", `{string.upper(Residents.Name(resident))} IS DOWN: REVIVE THEM WITH A MEDKIT`)
end

local function checkLost()
	for _, resident in residents do
		if resident.State ~= "Dead" then
			return
		end
	end
	if next(residents) and director:Phase() == "Playing" then
		log:Warn("the last resident is gone: the bunker falls")
		director:Lose("ResidentsLost")
	end
end

local function die(resident: Resident)
	local how = downHow[resident.Id] or "unknown"
	resident.State = "Dead"
	downUntil[resident.Id] = nil
	downHow[resident.Id] = nil
	resident.Job = nil
	logLine(resident, `died ({how})`)
	publish(resident)
	economy:RefreshCrew()
	log:Warn("%s died (%s)", Residents.Name(resident), how)
	announce("Danger", `{string.upper(Residents.Name(resident))} DIED`)
	ResidentService.Died:Fire(resident.Id, how)
	checkLost()
end

function ResidentService:Hurt(id: string, amount: number, how: string)
	local resident = residents[id]
	if not resident or resident.State ~= "Alive" then
		return
	end
	resident.Health = math.max(0, resident.Health - amount)
	if resident.Health <= 0 then
		goDown(resident, how)
	else
		publish(resident)
	end
end

-- Cave-in rubble cuts a resident off (ResidentBrain): out of their crew until they are free.
function ResidentService:SetTrapped(id: string, on: boolean)
	local resident = residents[id]
	if not resident or (resident.Trapped == true) == on then
		return
	end
	resident.Trapped = on
	if on then
		logLine(resident, "trapped by a cave-in")
	end
	publish(resident)
	economy:RefreshCrew()
end

function ResidentService:Revive(id: string, player: Player?): (boolean, string?)
	local resident = residents[id]
	if not resident or resident.State ~= "Down" then
		return false, "Nobody is down there."
	end
	local paid, why = economy:Spend({ Medkits = 1 }, `reviving {Residents.Name(resident)}`)
	if not paid then
		return false, `No Medkit: {why}.`
	end
	resident.State = "Alive"
	resident.Health = math.max(1, math.floor(resident.MaxHealth * 0.25))
	downUntil[id] = nil
	downHow[id] = nil
	logLine(resident, if player then `revived by {player.DisplayName}` else "revived")
	publish(resident)
	economy:RefreshCrew()
	announce("Info", `{string.upper(Residents.Name(resident))} IS BACK ON THEIR FEET`)
	return true, nil
end

-- New residents ------------------------------------------------------------------------------------

function ResidentService:Add(tier: string?, level: number?): string
	count += 1
	local resident = Residents.Roll(rng, `N{count}`, tier or "Common", level or 1, usedNames)
	residents[resident.Id] = resident
	logLine(resident, "came into the bunker")
	publish(resident)
	return resident.Id
end

-- Once a cycle, after the meal ---------------------------------------------------------------------

local function beds(): number
	local n = 0
	for _, room in grid:RoomsOfType("Quarters") do
		local info = Config.Get("Rooms", "Quarters")
		n += (info.Beds and info.Beds[room.Level] or 0) * room.Span
	end
	return n
end

local function medbayHeals(): boolean
	for _, room in grid:RoomsOfType("Medbay") do
		if not room.Wrecked and not power:IsDark(room.Id) and economy:Crew(room.Id) then
			return true
		end
	end
	return false
end

local function afterMeal(cycle: number, _taken: { [string]: number }, missing: { [string]: number })
	local t = Config.Get("Tuning", "Residents")
	local alive = {}
	for _, resident in sorted() do
		if resident.State == "Alive" then
			table.insert(alive, resident)
		end
	end
	-- who goes hungry: one resident for each missing meal, the newest arrivals first
	local short = math.max(missing.Food or 0, missing.Water or 0)
	local hungry: { [string]: boolean } = {}
	for i = #alive, math.max(1, #alive - short + 1), -1 do
		if short > 0 then
			hungry[alive[i].Id] = true
		end
	end
	local bedsLeft = beds()
	local heals = medbayHeals()
	for _, resident in alive do
		local room = if resident.Job then grid:Room(resident.Job) else nil
		local jobStat = if room then Residents.JobStat(room.Type) else nil
		local bed = bedsLeft > 0
		if bed then
			bedsLeft -= 1
		end
		local notes = Residents.Cycle(resident, room ~= nil, jobStat, bed, not hungry[resident.Id],
			room ~= nil and power:IsDark(room.Id))
		for _, note in notes do
			logLine(resident, note)
		end
		if room and jobStat then
			local levels = Residents.AddXP(resident, t.XPPerWorkCycle, jobStat)
			if levels > 0 then
				logLine(resident, `reached level {resident.Level}`)
				announce("Info", `{string.upper(Residents.Name(resident))} REACHED LEVEL {resident.Level}`)
			end
		end
		if heals and resident.Health > 0 and resident.Health < resident.MaxHealth then
			resident.Health = math.min(resident.MaxHealth, resident.Health + t.MedbayHealPerCycle)
		end
		if resident.Health <= 0 then
			goDown(resident, if hungry[resident.Id] then "hunger" else "weakness")
		else
			publish(resident)
		end
	end
	log:Info("cycle %d: needs for %d residents (%d hungry, %d beds)", cycle, #alive, short, beds())
	economy:RefreshCrew()
end

local function afterSurge()
	local boost = Config.Get("Tuning", "Residents").SurgeSurvivedMorale
	for _, resident in residents do
		if resident.State == "Alive" then
			resident.Morale = math.min(100, resident.Morale + boost)
			publish(resident)
		end
	end
	economy:RefreshCrew()
end

-- DevTools ---------------------------------------------------------------------------------------

local function describe(resident: Resident): string
	local stats = {}
	for _, stat in Residents.StatIds() do
		table.insert(stats, `{string.sub(stat, 1, 3)} {resident.Stats[stat]}`)
	end
	local room = if resident.Job then grid:Room(resident.Job) else nil
	return string.format("%s %s, %d, L%d (%d/%d xp): %s; job %s; HP %d/%d, rest %d, morale %d (%s)%s%s",
		resident.Id, Residents.Name(resident), resident.Age, resident.Level, resident.XP, Residents.XPToLevel(resident.Level),
		table.concat(stats, ", "), if room then `{room.Id} {room.Type}` else "none", resident.Health, resident.MaxHealth,
		resident.Rest, resident.Morale, (Residents.MoraleState(resident.Morale)),
		if resident.Hungry then ", HUNGRY" else "", if resident.State ~= "Alive" then `, {resident.State}` else "")
end

local function describeAll(): string
	local lines = {}
	for _, resident in sorted() do
		table.insert(lines, describe(resident))
	end
	return if #lines > 0 then table.concat(lines, "\n") else "no residents"
end

function ResidentService:Init(registry)
	grid = registry.BunkerGrid
	economy = registry.EconomyService
	power = registry.PowerService
	clock = registry.CycleClock
	director = registry.RunDirector
	session = registry.SessionService
	collection = registry.ReplicationService:Collection("Residents")
	Remotes.OnServer("AssignResident", function(player: Player, id: string, roomId: string)
		local ok, why = ResidentService:Assign(id, if roomId == "" then nil else roomId)
		if not ok and why then
			Remotes.FireClient("Alert", player, "Warning", why)
		end
	end)
	Remotes.OnServer("AutoAssign", function(player: Player)
		local n = ResidentService:AutoAssign()
		Remotes.FireClient("Alert", player, "Info",
			if n > 0 then `AUTO-ASSIGN: {n} RESIDENT{if n == 1 then "" else "S"} PUT TO WORK` else "AUTO-ASSIGN: NO EMPTY JOB FITS ANYONE IDLE")
	end)
	Remotes.OnServer("ReviveResident", function(player: Player, id: string)
		local ok, why = ResidentService:Revive(id, player)
		if not ok and why then
			Remotes.FireClient("Alert", player, "Warning", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("residents", {
		Description = "Every resident: stats, job, needs and state.",
		Usage = "residents",
		Run = function(): string?
			return describeAll()
		end,
	})
	dev:Register("residents.auto", {
		Description = "Auto-Assign idle residents.",
		Usage = "residents.auto",
		Run = function(): string?
			return `assigned {ResidentService:AutoAssign()}\n{describeAll()}`
		end,
	})
	dev:Register("residents.add", {
		Description = "New residents (a recruit, for testing).",
		Usage = "residents.add [count] [tier] [level]",
		Run = function(_player: Player?, args): string?
			for _ = 1, math.clamp(tonumber(args[1]) or 1, 1, 20) do
				ResidentService:Add(if args[2] then tostring(args[2]) else nil, tonumber(args[3]))
			end
			return describeAll()
		end,
	})
	dev:Register("resident.assign", {
		Description = "Give a resident a job (a room id) or none.",
		Usage = "resident.assign <id> <roomId|none>",
		Run = function(_player: Player?, args): string?
			local id, roomId = tostring(args[1] or ""), tostring(args[2] or "")
			local ok, why = ResidentService:Assign(id, if roomId == "none" then nil else roomId)
			return if ok then describeAll() else `refused: {why}`
		end,
	})
	dev:Register("resident.hurt", {
		Description = "Hurt a resident (0 health: down, then dead).",
		Usage = "resident.hurt <id> <amount>",
		Run = function(_player: Player?, args): string?
			ResidentService:Hurt(tostring(args[1] or ""), tonumber(args[2]) or 10, "DevTools")
			return describeAll()
		end,
	})
	dev:Register("resident.revive", {
		Description = "Revive a downed resident with a Medkit from the stockpile.",
		Usage = "resident.revive <id>",
		Run = function(_player: Player?, args): string?
			local ok, why = ResidentService:Revive(tostring(args[1] or ""), nil)
			return if ok then describeAll() else `refused: {why}`
		end,
	})
	dev:Register("resident.set", {
		Description = "Set a resident's need or stat: health, rest, morale, xp or a stat name.",
		Usage = "resident.set <id> <field> <value>",
		Run = function(_player: Player?, args): string?
			local resident = residents[tostring(args[1] or "")]
			local field, value = string.lower(tostring(args[2] or "")), tonumber(args[3])
			if not resident or not value then
				return "usage: resident.set <id> <health|rest|morale|xp|Strength...> <value>"
			end
			if field == "health" then
				resident.Health = math.clamp(value, 0, resident.MaxHealth)
			elseif field == "rest" then
				resident.Rest = math.clamp(value, 0, 100)
			elseif field == "morale" then
				resident.Morale = math.clamp(value, 0, 100)
			elseif field == "xp" then
				Residents.AddXP(resident, value, nil)
			else
				for _, stat in Residents.StatIds() do
					if string.lower(stat) == field then
						resident.Stats[stat] = math.clamp(value, 1, Config.Get("Tuning", "Residents").StatCap)
						resident.MaxHealth = Residents.MaxHealth(resident.Stats)
					end
				end
			end
			publish(resident)
			economy:RefreshCrew()
			return describe(resident)
		end,
	})
end

function ResidentService:Start()
	local start = Config.Get("Tuning", "StartingBunker")
	for _ = 1, start.Residents do
		ResidentService:Add(start.ResidentTier, rng:NextInteger(start.ResidentLevels.Min, start.ResidentLevels.Max))
	end
	-- the founders start idle (Landon): when play starts, tell the team they're waiting for work
	director.PhaseChanged:Connect(function(phase: string, old: string)
		if phase ~= "Playing" or old ~= "Intro" then -- only when the run starts (not after Keep Going)
			return
		end
		local idle = 0
		for _, resident in residents do
			if resident.State == "Alive" and not resident.Job then
				idle += 1
			end
		end
		if idle > 0 then
			task.delay(2, function()
				announce("Warning", if idle == 1
					then "1 RESIDENT IS WAITING FOR A JOB: OPEN THE COMMAND VIEW AND ASSIGN THEM"
					else `{idle} RESIDENTS ARE WAITING FOR JOBS: OPEN THE COMMAND VIEW AND ASSIGN THEM`)
			end)
		end
	end)
	economy:SetResidents({
		Crew = function(roomId: string): Residents.Crew?
			local room = grid:Room(roomId)
			if not room then
				return nil
			end
			local workers = {}
			for _, resident in residents do
				if resident.Job == roomId and not resident.Trapped then
					table.insert(workers, resident)
				end
			end
			return Residents.Crew(workers, room.Type)
		end,
		Eaters = function(): { { Id: string, FoodUse: number? } }
			local list = {}
			for _, resident in sorted() do
				if resident.State == "Alive" then
					table.insert(list, { Id = resident.Id })
				end
			end
			return list
		end,
	})
	economy.Ate:Connect(afterMeal)
	clock.SurgeEnded:Connect(afterSurge)
	grid.RoomChanged:Connect(roomChanged)
	RunService.Heartbeat:Connect(function()
		if next(downUntil) == nil then
			return
		end
		local now = workspace:GetServerTimeNow()
		for id, untilTime in table.clone(downUntil) do
			local resident = residents[id]
			if resident and resident.State == "Down" and now >= untilTime then
				die(resident)
			end
		end
	end)
	log:Info("%d founders in the bunker:\n%s", start.Residents, describeAll())
end

return ResidentService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D9"><Properties><string name="Name">ResultsService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ResultsService: the run's results (bible Sections 5, 16, 18 and 21). Run place only; Prompt 15.
	The arithmetic is Shared.Rules.Results; payouts are Config.GlowshardRewards, the difficulty's
	PayoutMultiplier and Tuning.Account; the MVP weights are Tuning.Results.

	* While the run plays it counts each player's part (damage to monsters, kills, damage to
	  bosses, revives, cells dug, repairs) and the team's (monsters killed, cells dug, rooms built,
	  residents lost, disasters, bosses beaten), and keeps the run's story: the moments worth
	  telling, each with its year (a boss beaten, a resident's death, a Push Deeper, a Tremor, a
	  meltdown stopped, the end).
	* When the run ends (RunDirector.RunEnded) it pays everyone still in it: Glowshards
	  (Rules.Results.Payout: years, depth bands, a victory, bosses, the difficulty, the first win of
	  the day), account experience and levels, the profile's Stats (Runs, Wins, BestYear, Deepest,
	  BossesKilled, MonstersKilled, LastWinDay) and FirstRunDone, then saves. A run that ends again
	  after Keep Going pays only what is new (a ledger per player).
	* It publishes the Results collection ("Run" -> the results below) for the results screen.
	* The results screen's buttons (Section 21): Play Again opens a team vote (Config.Votes
	  PlayAgain; solo applies at once) that sends everyone to a fresh Run server; Keep Going, after a
	  victory, opens the Keep Going vote (Endless, RunDirector:KeepGoing); Return to Lobby sends the
	  player to the lobby. Teleports don't work in Studio: there it says so. Prompt 21 adds the
	  party list and loadouts in MemoryStore.

	Results: { Outcome, DefeatReason, Victory, Endless, Year, Cycle, Era, Difficulty, Seconds,
	DeepestFloor, Band, Team = { MonstersKilled, CellsDug, RoomsBuilt, ResidentsAlive, ResidentsLost,
	Disasters, Bosses }, Stories = { string }, MVP = user id (string) or nil, Players = { [user id]
	= { Name, Class, Damage, Kills, BossDamage, Revives, CellsDug, Repairs, Score, Glowshards,
	Lines = { { Text, Amount } }, XP, Level, LevelUp, Paid } }, At }.

	Dev: results, results.pay.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Results = require(Shared.Rules.Results)
local RunState = require(Shared.RunState)

local log = Log.new("ResultsService")

local ResultsService = {
	Name = "ResultsService",
	Dependencies = {
		"RunDirector", "CycleClock", "SessionService", "ProfileService", "CombatService", "MonsterService", "ResidentService",
		"BuildService", "DigService", "DisasterService", "ObjectiveService", "BossService", "BunkerGrid", "VoteService",
		"ReplicationService", "DevService",
	},
}

local STAT_KEYS = { "Damage", "Kills", "BossDamage", "Revives", "CellsDug", "Repairs" }

local director: any = nil
local clock: any = nil
local session: any = nil
local profiles: any = nil
local combat: any = nil
local residents: any = nil
local objectives: any = nil
local grid: any = nil
local votes: any = nil
local collection: any = nil

local stats: { [number]: { [string]: number } } = {} -- user id -> stats
local names: { [number]: string } = {}
local team = { MonstersKilled = 0, CellsDug = 0, RoomsBuilt = 0, ResidentsLost = 0, Disasters = 0 }
local bosses: { string } = {}
local stories: { string } = {}
local lastHit: { [string]: string } = {} -- combatant id -> who hit it last ("P<user id>")
local ledgers: { [number]: Results.Ledger } = {}
local paidKills: { [number]: number } = {} -- kills already added to the profile's MonstersKilled
local counted: { [number]: boolean } = {} -- the run counted in the profile's Runs
local deepest = 0
local voteOpen: { [string]: string } = {} -- vote kind -> id
local published: { [string]: any }? = nil

-- Counting -------------------------------------------------------------------------------------------

local function userOf(source: string?): number?
	if source and string.sub(source, 1, 1) == "P" then
		return tonumber(string.sub(source, 2))
	end
	return nil
end

local function bump(userId: number?, key: string, amount: number)
	if not userId then
		return
	end
	local s = stats[userId]
	if not s then
		s = {}
		for _, k in STAT_KEYS do
			s[k] = 0
		end
		stats[userId] = s
	end
	s[key] = (s[key] or 0) + amount
end

local function story(text: string)
	local year = clock:Year()
	table.insert(stories, `Year {year} · {text}`)
	local max = Results.Tuning().StoriesMax * 3
	if #stories > max then
		table.remove(stories, 1)
	end
end

local function residentName(id: string): string
	local r = residents:Get(id)
	return if r and r.Name then r.Name else "A resident"
end

-- The results -------------------------------------------------------------------------------------------

local function playerClass(player: Player): string
	local class = player:GetAttribute("Class")
	local entry = if type(class) == "string" then Config.Find("Classes", class) else nil
	return if entry then entry.Name else "Survivor"
end

local function teamNumbers(): { [string]: any }
	local alive, lost = 0, 0
	for _, r in residents:All() do
		if r.State == "Dead" then
			lost += 1
		else
			alive += 1
		end
	end
	local names_ = {}
	for _, bossId in bosses do
		table.insert(names_, Config.Get("Bosses", bossId).Name)
	end
	return {
		MonstersKilled = team.MonstersKilled,
		CellsDug = team.CellsDug,
		RoomsBuilt = team.RoomsBuilt,
		ResidentsAlive = alive,
		ResidentsLost = lost,
		Disasters = team.Disasters,
		Bosses = names_,
	}
end

local function endingStory(summary: any): string
	if summary.Outcome == "CenturyVictory" then
		return "The blast door opens on a clearing sky: a Century Victory"
	elseif summary.Outcome == "DeepVictory" then
		return "The Source is destroyed in its chamber: a Deep Victory"
	elseif summary.DefeatReason == "ReactorDestroyed" then
		return "The Reactor Core melted down and the bunker fell"
	elseif summary.DefeatReason == "ResidentsLost" then
		return "The last resident died and the bunker fell"
	end
	return "The run ended"
end

-- Pays one player and returns their row of the results.
local function pay(player: Player, summary: any, run: Results.Run): { [string]: any }
	local userId = player.UserId
	names[userId] = player.DisplayName
	local s = stats[userId] or {}
	local paid = ledgers[userId] or Results.EmptyLedger()
	local profile = profiles:Get(player)
	local today = Results.Day(os.time())
	local stats_ = if profile then profile.Stats else {}
	local firstWinToday = run.Victory ~= nil and (stats_.LastWinDay or -1) ~= today
	local payout = Results.Payout(run, paid, { FirstWinToday = firstWinToday })
	local xp = Results.AccountXP(run.Year, paid.Years)
	local level, levelUp = if profile then profile.AccountLevel else 1, false
	local ok = true
	if profile then
		ok = profiles:Update(player, function(data)
			data.Glowshards += payout.Total
			local newLevel, newXP = Results.LevelUp(data.AccountLevel, data.AccountXP, xp)
			levelUp = newLevel > data.AccountLevel
			data.AccountLevel, data.AccountXP = newLevel, newXP
			level = newLevel
			local st = data.Stats
			if not counted[userId] then
				st.Runs = (st.Runs or 0) + 1
			end
			if run.Victory and not paid.Victory then
				st.Wins = (st.Wins or 0) + 1
				st.LastWinDay = today
			end
			st.BestYear = math.max(st.BestYear or 0, run.Year)
			st.Deepest = math.max(st.Deepest or 0, run.DeepestFloor)
			local newBosses = 0
			for _, bossId in run.Bosses do
				if not paid.Bosses[bossId] then
					newBosses += 1
				end
			end
			st.BossesKilled = (st.BossesKilled or 0) + newBosses
			st.MonstersKilled = (st.MonstersKilled or 0) + math.max(0, (s.Kills or 0) - (paidKills[userId] or 0))
			data.FirstRunDone = true
		end)
	end
	if ok then
		ledgers[userId] = payout.Ledger
		paidKills[userId] = s.Kills or 0
		counted[userId] = true
		log:Info("%s paid %d Glowshards and %d experience (%s)", player.Name, payout.Total, xp, summary.Outcome or "?")
		task.spawn(function()
			profiles:SaveNow(player)
		end)
	else
		log:Warn("%s: the payout couldn't be written", player.Name)
	end
	local row: { [string]: any } = {
		Name = player.DisplayName,
		Class = playerClass(player),
		Score = Results.Score(s),
		Glowshards = if ok then payout.Total else 0,
		Lines = payout.Lines,
		XP = xp,
		Level = level,
		LevelUp = levelUp,
		Paid = ok and profile ~= nil,
	}
	for _, key in STAT_KEYS do
		row[key] = math.floor((s[key] or 0) + 0.5)
	end
	return row
end

local function build(summary: any)
	deepest = math.max(deepest, grid:DeepestFloor())
	local run: Results.Run = {
		Year = summary.Year,
		DeepestFloor = deepest,
		Victory = summary.Victory,
		Bosses = table.clone(bosses),
		Difficulty = summary.Difficulty,
	}
	story(endingStory(summary))
	local rows = {}
	local scoring: { [number]: { [string]: number } } = {}
	for _, player in session:ReadyPlayers() do
		rows[tostring(player.UserId)] = pay(player, summary, run)
		scoring[player.UserId] = stats[player.UserId] or {}
	end
	local mvp = Results.MVP(scoring)
	local shown = {}
	local max = Results.Tuning().StoriesMax
	for i = math.max(1, #stories - max + 1), #stories do
		table.insert(shown, stories[i])
	end
	local band = if deepest >= 1 then Grid.BandOf(deepest).Name else "Mines"
	published = {
		Outcome = summary.Outcome,
		DefeatReason = summary.DefeatReason,
		Victory = summary.Victory,
		Endless = summary.Endless,
		Year = summary.Year,
		Cycle = summary.Cycle,
		Era = summary.Era,
		Difficulty = summary.Difficulty,
		Seconds = math.floor(summary.Seconds),
		DeepestFloor = deepest,
		Band = band,
		Team = teamNumbers(),
		Stories = shown,
		MVP = if mvp then tostring(mvp) else nil,
		Players = rows,
		At = workspace:GetServerTimeNow(),
	}
	collection:Set("Run", published)
	log:Info("results: %s in Year %d, %d players, MVP %s", tostring(summary.Outcome), summary.Year, #session:ReadyPlayers(),
		if mvp then tostring(mvp) else "-")
end

-- The results screen's buttons ------------------------------------------------------------------------------

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function teleport(placeId: number, list: { Player }, reserved: boolean): (boolean, string?)
	if RunService:IsStudio() then
		return false, "TELEPORTS DON'T WORK IN STUDIO"
	end
	local options = Instance.new("TeleportOptions")
	if reserved then
		local ok, code = pcall(function()
			return TeleportService:ReserveServer(placeId)
		end)
		if not ok then
			return false, `NO SERVER: {tostring(code)}`
		end
		options.ReservedServerAccessCode = code
	end
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(placeId, list, options)
	end)
	if not ok then
		return false, `THE TELEPORT FAILED: {tostring(err)}`
	end
	return true, nil
end

local function openVote(player: Player, kind: string, title: string, onPass: () -> ())
	if voteOpen[kind] then
		alert(player, "Info", "THAT VOTE IS ALREADY ON: VOTE ON THE BANNER")
		return
	end
	local id, why = votes:Open({
		Kind = kind,
		Proposer = nil, -- the run is over, so the game opens it; the asker's yes goes in at once
		Title = title,
		OnPass = function()
			voteOpen[kind] = nil
			onPass()
		end,
		OnFail = function(reason: string)
			voteOpen[kind] = nil
			log:Info("%s failed: %s", kind, reason)
		end,
	})
	if not id then
		alert(player, "Warning", string.upper(why or "THE VOTE COULDN'T START"))
		return
	end
	if id ~= "solo" then
		voteOpen[kind] = id
		votes:Cast(player, id, "Yes")
	end
end

local function onPlayAgain(player: Player)
	if director:Phase() ~= "Ended" then
		alert(player, "Info", "THE RUN ISN'T OVER YET")
		return
	end
	openVote(player, "PlayAgain", `PLAY AGAIN? ({string.upper(player.DisplayName)} ASKS)`, function()
		local list = session:ReadyPlayers()
		local ok, why = teleport(Constants.PLACE_IDS.Run, list, true)
		Remotes.FireClients("Alert", list, if ok then "Info" else "Warning",
			if ok then "PLAY AGAIN: OFF TO A FRESH BUNKER" else `PLAY AGAIN PASSED · {why}`)
		log:Info("Play Again passed (%s)", if ok then "teleporting" else tostring(why))
	end)
end

local function onKeepGoing(player: Player)
	local summary = director:Summary()
	if director:Phase() ~= "Ended" or not summary.Victory or summary.Endless then
		alert(player, "Info", "KEEP GOING COMES AFTER A VICTORY")
		return
	end
	openVote(player, "KeepGoing", `KEEP GOING: ENDLESS MODE? ({string.upper(player.DisplayName)} ASKS)`, function()
		if director:KeepGoing() then
			Remotes.FireClients("Alert", session:ReadyPlayers(), "Info", "KEEP GOING: ENDLESS MODE STARTS NOW")
		end
	end)
end

local function onReturnToLobby(player: Player)
	if director:Phase() ~= "Ended" then
		alert(player, "Info", "THE RUN ISN'T OVER YET")
		return
	end
	local ok, why = teleport(Constants.PLACE_IDS.Lobby, { player }, false)
	if not ok then
		alert(player, "Warning", `RETURN TO LOBBY · {why}`)
	end
	log:Info("%s returns to the lobby (%s)", player.Name, if ok then "teleporting" else tostring(why))
end

-- DevTools -----------------------------------------------------------------------------------------------------

local function describe(): string
	local lines = { string.format("team: %d monsters killed, %d cells dug, %d rooms built, %d residents lost, %d disasters, bosses %s",
		team.MonstersKilled, team.CellsDug, team.RoomsBuilt, team.ResidentsLost, team.Disasters,
		if #bosses > 0 then table.concat(bosses, ", ") else "none") }
	for userId, s in stats do
		local parts = {}
		for _, key in STAT_KEYS do
			table.insert(parts, `{key} {math.floor(s[key] or 0)}`)
		end
		table.insert(lines, `{names[userId] or tostring(userId)}: {table.concat(parts, ", ")} (score {Results.Score(s)})`)
	end
	for _, line in stories do
		table.insert(lines, line)
	end
	if published then
		table.insert(lines, `published: {tostring(published.Outcome)}, MVP {tostring(published.MVP)}`)
		for id, row in published.Players do
			table.insert(lines, `  {id} {row.Name}: {row.Glowshards} Glowshards, +{row.XP} xp, level {row.Level}{if row.LevelUp then " (up)" else ""}`)
		end
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("results", {
		Description = "The run's numbers so far, its story, and the published results.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("results.stat", {
		Description = "Add to a player's results stat (Studio testing of the MVP).",
		Usage = "results.stat <Damage|Kills|BossDamage|Revives|CellsDug|Repairs> <amount>",
		Run = function(player, args): string?
			local key, amount = tostring(args[1] or ""), tonumber(args[2])
			if not table.find(STAT_KEYS, key) or not amount or not player then
				return "usage: results.stat <stat> <amount> (as a player)"
			end
			names[player.UserId] = player.DisplayName
			bump(player.UserId, key, amount)
			return describe()
		end,
	})
end

-- Lifecycle ---------------------------------------------------------------------------------------------------

local services: { [string]: any } = {}

function ResultsService:Init(registry)
	director = registry.RunDirector
	clock = registry.CycleClock
	session = registry.SessionService
	profiles = registry.ProfileService
	combat = registry.CombatService
	residents = registry.ResidentService
	objectives = registry.ObjectiveService
	grid = registry.BunkerGrid
	votes = registry.VoteService
	services.Build = registry.BuildService
	services.Dig = registry.DigService
	services.Disaster = registry.DisasterService
	services.Boss = registry.BossService
	collection = registry.ReplicationService:Collection("Results")
	registerCommands(registry.DevService)
end

function ResultsService:Start()
	-- Monsters' ids are M<n> (CombatService). A killing blow is Damaged after the target is
	-- unregistered, so the id says what it was, not CombatService:Get.
	combat.Damaged:Connect(function(id: string, amount: number, source: string?, _how: string?)
		if source then
			lastHit[id] = source
		end
		local userId = userOf(source)
		if userId and string.sub(id, 1, 1) == "M" then
			bump(userId, "Damage", amount)
			if services.Boss:IsBoss(id) then
				bump(userId, "BossDamage", amount)
			end
		end
	end)
	combat.Died:Connect(function(id: string)
		local source = lastHit[id]
		lastHit[id] = nil
		if string.sub(id, 1, 1) == "M" and not services.Boss:IsEggSac(id) then
			team.MonstersKilled += 1
			bump(userOf(source), "Kills", 1)
		end
	end)
	combat.Revived:Connect(function(_id: string, byUserId: number?)
		if byUserId then
			bump(byUserId, "Revives", 1)
		end
	end)
	residents.Died:Connect(function(id: string, how: string)
		team.ResidentsLost += 1
		story(`{residentName(id)} died ({how})`)
	end)
	services.Dig.Dug:Connect(function(floor: number, _column: number, result: string, _cause: string, finisher: Player?)
		team.CellsDug += 1
		deepest = math.max(deepest, floor)
		if finisher then
			bump(finisher.UserId, "CellsDug", 1)
		end
		if result == "Nest" then
			story("digging broke into a monster nest")
		end
	end)
	services.Build.Built:Connect(function(_roomId: string, kind: string)
		if kind == "Build" then
			team.RoomsBuilt += 1
		end
	end)
	services.Build.Repaired:Connect(function(_roomId: string, amount: number, _how: string, player: Player?)
		if player then
			bump(player.UserId, "Repairs", amount)
		end
	end)
	services.Disaster.Started:Connect(function(_id: string, kind: string)
		team.Disasters += 1
		if kind == "Meltdown" then
			story("the Reactor Core began to melt down")
		end
	end)
	services.Disaster.Ended:Connect(function(_id: string, kind: string, how: string)
		if kind == "Meltdown" and how == "Fixed" then
			story("three valves turned together stopped the meltdown")
		end
	end)
	services.Boss.Defeated:Connect(function(bossId: string, killer: Player?)
		if not table.find(bosses, bossId) then
			table.insert(bosses, bossId)
		end
		local name = Config.Get("Bosses", bossId).Name
		story(if killer then `{killer.DisplayName} struck the {name} down` else `the {name} fell`)
	end)
	objectives.BossDefeated:Connect(function(bossId: string)
		if not table.find(bosses, bossId) then
			table.insert(bosses, bossId) -- beaten another way (DevTools' boss.beat)
		end
	end)
	local lastLimit = RunState.Get("DigLimit")
	RunState.Changed("DigLimit"):Connect(function()
		local value = RunState.Get("DigLimit")
		if type(value) == "number" and type(lastLimit) == "number" and value > lastLimit then
			story(`the team pushed deeper, into the {Grid.BandOf(value).Name}`)
		end
		lastLimit = value
	end)
	RunState.Changed("TremorAt"):Connect(function()
		if type(RunState.Get("TremorAt")) == "number" then
			story("a Tremor shook the bunker and the Deep broke in")
		end
	end)
	director.RunEnded:Connect(function(summary: any)
		local ok, err = pcall(build, summary)
		if not ok then
			log:Error("results: %s", tostring(err))
		end
	end)
	Remotes.OnServer("PlayAgain", onPlayAgain)
	Remotes.OnServer("KeepGoing", onKeepGoing)
	Remotes.OnServer("ReturnToLobby", onReturnToLobby)
	log:Info("results ready")
end

return ResultsService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000DA"><Properties><string name="Name">RunDirector</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RunDirector: the run's lifecycle, how it ends, and Endless (bible Sections 4, 5 and 23;
	named so it never clashes with Roblox's RunService). Run place only.

		Waiting -> Intro -> Playing -> Ended (-> Playing again in Endless after Keep Going)

	* Waiting until the first player's session is ready (Prompt 21 adds waiting for the
	  party list the lobby writes to MemoryStore).
	* Intro: 30 seconds. The run clock starts at the 30-second mark for everyone, so a player
	  who skips the cutscene (personal, from 2 seconds in, Prompt 22) gains nothing.
	* Playing: CycleClock runs the cycles.
	* Victory: Century (the final Surge survived; CycleClock reports it) or Deep (the Source
	  destroyed in its chamber at depth 10; Prompt 25 calls Win("Deep")). After a victory the
	  team can Keep Going (a vote, Prompt 8): the run carries on in Endless.
	* Defeat: the Reactor Core is destroyed or the last resident dies (the systems that own
	  them call Lose). Players dying never loses the run.
	* The results screen (Prompt 15) reads Summary(); Play Again and Return to Lobby are
	  Prompt 21.

	API:
		RunDirector:Phase(): RunPhase
		RunDirector:Difficulty(): string                       -- Normal, Hard or Nightmare
		RunDirector:Win(kind: "Century" | "Deep"): boolean
		RunDirector:Lose(reason: "ReactorDestroyed" | "ResidentsLost"): boolean
		RunDirector:KeepGoing(): boolean
		RunDirector:Summary(): Summary
		RunDirector.PhaseChanged: Signal<RunPhase, RunPhase>   -- new, old
		RunDirector.RunEnded: Signal<Summary>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("RunDirector")
local IS_STUDIO = RunService:IsStudio()

export type RunPhase = RunState.RunPhase
export type VictoryKind = "Century" | "Deep"
export type DefeatReason = "ReactorDestroyed" | "ResidentsLost"
export type Summary = {
	Outcome: RunState.Outcome?,
	DefeatReason: DefeatReason?,
	Victory: VictoryKind?,
	Endless: boolean,
	Year: number,
	Cycle: number,
	Era: string,
	Difficulty: string,
	Seconds: number, -- played time, from the end of the intro
	Players: { number }, -- user ids of everyone who played in this run
}

local RunDirector = {
	Name = "RunDirector",
	Dependencies = { "SessionService", "CycleClock", "DevService" },
	PhaseChanged = Signal.new() :: Signal.Signal<RunPhase, RunPhase>,
	RunEnded = Signal.new() :: Signal.Signal<Summary>,
}

local session: any = nil
local clock: any = nil
local set: (string, any) -> () = function() end

local phase: RunPhase = "Waiting"
local difficulty = "Normal"
local outcome: RunState.Outcome? = nil
local defeatReason: DefeatReason? = nil
local victory: VictoryKind? = nil
local endless = false
local playingSince: number? = nil
local playedSeconds = 0
local played: { [number]: boolean } = {}

local function setPhase(new: RunPhase)
	local old = phase
	if old == new then
		return
	end
	phase = new
	set("RunPhase", new)
	log:Info("run: %s -> %s", old, new)
	RunDirector.PhaseChanged:Fire(new, old)
end

local function introSeconds(): number
	local devTools = ServerScriptService:FindFirstChild("DevTools")
	if IS_STUDIO and devTools and devTools:GetAttribute("SkipIntro") == true then
		return 0
	end
	return Config.Get("Tuning", "Clock").IntroSeconds
end

local function startPlaying()
	if phase ~= "Intro" then
		return
	end
	set("IntroEndsAt", nil)
	setPhase("Playing")
	playingSince = os.clock()
	clock:Begin()
end

local function startIntro()
	if phase ~= "Waiting" then
		return
	end
	local seconds = introSeconds()
	set("IntroEndsAt", workspace:GetServerTimeNow() + seconds)
	setPhase("Intro")
	task.delay(seconds, startPlaying)
end

local function finish(result: RunState.Outcome, reason: DefeatReason?)
	clock:Halt()
	outcome = result
	defeatReason = reason
	if playingSince then
		playedSeconds += os.clock() - playingSince
		playingSince = nil
	end
	set("Outcome", result)
	set("DefeatReason", reason)
	setPhase("Ended")
	local summary = RunDirector:Summary()
	log:Info("run over: %s %s in Year %d, cycle %d", result, reason or "", summary.Year, summary.Cycle)
	RunDirector.RunEnded:Fire(summary)
end

function RunDirector:Phase(): RunPhase
	return phase
end

-- Normal, Hard or Nightmare (Config.Difficulties). Normal until the lobby's pads choose (Prompt 21).
function RunDirector:Difficulty(): string
	return difficulty
end

-- A victory (Century: the final Surge survived; Deep: the Source destroyed in its chamber).
function RunDirector:Win(kind: VictoryKind): boolean
	assert(kind == "Century" or kind == "Deep", "RunDirector:Win takes Century or Deep")
	if phase ~= "Playing" or endless then
		return false
	end
	victory = kind
	set("Victory", kind)
	finish(if kind == "Century" then "CenturyVictory" else "DeepVictory", nil)
	return true
end

-- The bunker falls (the Reactor Core destroyed, or the last resident dead).
function RunDirector:Lose(reason: DefeatReason): boolean
	assert(reason == "ReactorDestroyed" or reason == "ResidentsLost", "RunDirector:Lose takes ReactorDestroyed or ResidentsLost")
	if phase ~= "Playing" then
		return false
	end
	finish("Defeat", reason)
	return true
end

-- Keep Going passed after a victory: the run carries on in Endless.
function RunDirector:KeepGoing(): boolean
	if phase ~= "Ended" or victory == nil or outcome == "Defeat" or endless then
		return false
	end
	endless = true
	outcome = nil
	set("Endless", true)
	set("Outcome", nil)
	clock:SetEndless(true)
	setPhase("Playing")
	playingSince = os.clock()
	clock:Resume()
	return true
end

function RunDirector:Summary(): Summary
	local ids = {}
	for userId in played do
		table.insert(ids, userId)
	end
	table.sort(ids)
	return {
		Outcome = outcome,
		DefeatReason = defeatReason,
		Victory = victory,
		Endless = endless,
		Year = clock:Year(),
		Cycle = clock:Cycle(),
		Era = clock:Era(),
		Difficulty = difficulty,
		Seconds = playedSeconds + (if playingSince then os.clock() - playingSince else 0),
		Players = ids,
	}
end

local function describe(): string
	local summary = RunDirector:Summary()
	local lines = { `run {phase}, {difficulty}, Year {summary.Year}, cycle {summary.Cycle}, played {string.format("%.0f", summary.Seconds)} s` }
	if phase == "Intro" then
		table.insert(lines, `intro: {string.format("%.1f", RunState.TimeLeft() or 0)} s left`)
	end
	if outcome then
		local reason = if defeatReason then ` ({defeatReason})` else ""
		table.insert(lines, `outcome: {outcome}{reason}`)
	end
	if victory then
		local now = if endless then ", now Endless" else ""
		table.insert(lines, `victory: {victory}{now}`)
	end
	table.insert(lines, `players: {#summary.Players}`)
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("run", {
		Description = "The run's phase, outcome and summary.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("run.skipintro", {
		Description = "End the intro now and start the clock.",
		Run = function(): string?
			if phase ~= "Intro" then
				return `no intro running (run is {phase})`
			end
			startPlaying()
			return describe()
		end,
	})
	dev:Register("run.win", {
		Description = "Win the run (Century or Deep).",
		Usage = "run.win <century|deep>",
		Run = function(_player, args): string?
			local word = string.lower(tostring(args[1] or ""))
			local kind: VictoryKind? = if word == "century" then "Century" elseif word == "deep" then "Deep" else nil
			if not kind then
				return "usage: run.win <century|deep>"
			end
			if not RunDirector:Win(kind) then
				local mode = if endless then ", Endless" else ""
				return `can't win now (run is {phase}{mode})`
			end
			return describe()
		end,
	})
	dev:Register("run.lose", {
		Description = "Lose the run (the Reactor Core destroyed, or the last resident dead).",
		Usage = "run.lose <reactor|residents>",
		Run = function(_player, args): string?
			local word = string.lower(tostring(args[1] or ""))
			local reason: DefeatReason? = if word == "reactor" then "ReactorDestroyed" elseif word == "residents" then "ResidentsLost" else nil
			if not reason then
				return "usage: run.lose <reactor|residents>"
			end
			if not RunDirector:Lose(reason) then
				return `can't lose now (run is {phase})`
			end
			return describe()
		end,
	})
	dev:Register("run.difficulty", {
		Description = "Play this run at another difficulty (Studio testing; the lobby's pads choose it later).",
		Usage = "run.difficulty <Normal|Hard|Nightmare>",
		Run = function(_player: Player?, args): string?
			local wanted = tostring(args[1] or "")
			for _, id in Config.Ids("Difficulties") do
				if string.lower(id) == string.lower(wanted) then
					difficulty = id
					set("Difficulty", difficulty)
					return describe()
				end
			end
			return "usage: run.difficulty <Normal|Hard|Nightmare>"
		end,
	})
	dev:Register("run.keepgoing", {
		Description = "Keep Going after a victory: carry on in Endless.",
		Run = function(): string?
			if not RunDirector:KeepGoing() then
				return `can't keep going (run is {phase}, outcome {tostring(outcome)})`
			end
			return describe()
		end,
	})
end

function RunDirector:Init(registry)
	session = registry.SessionService
	clock = registry.CycleClock
	set = RunState.Writer("RunDirector")
	set("RunPhase", phase)
	set("Difficulty", difficulty)
	set("Endless", false)
	registerCommands(registry.DevService)
end

function RunDirector:Start()
	clock.CenturySurvived:Connect(function()
		RunDirector:Win("Century")
	end)
	local function onReady(player: Player)
		played[player.UserId] = true
		startIntro()
	end
	session.PlayerReady:Connect(onReady)
	for _, player in session:ReadyPlayers() do
		onReady(player)
	end
end

return RunDirector
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000DB"><Properties><string name="Name">SessionService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SessionService: player sessions in this server (infrastructure, Prompt 0; gates Prompt 2).

	A player is "ready" once every gate has passed: the client has bootstrapped (the
	ClientReady remote) and each gate a service added (ProfileService adds "Profile": the save
	has loaded). Services that send a player state wait for PlayerReady instead of
	PlayerAdded, so nothing is sent before the client can receive it or before the player's
	data exists.

	API:
		SessionService:AddGate(name)           -- in Init: one more thing a session waits for
		SessionService:Pass(player, name)      -- that thing is done for this player
		SessionService:Fail(player, message)   -- it can't be done: the player is kicked
		SessionService.PlayerReady: Signal<Player>
		SessionService.PlayerLeaving: Signal<Player>
		SessionService:IsReady(player): boolean
		SessionService:ReadyPlayers(): { Player }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("SessionService")

local SessionService = {
	Name = "SessionService",
	Dependencies = {},
	PlayerReady = Signal.new() :: Signal.Signal<Player>,
	PlayerLeaving = Signal.new() :: Signal.Signal<Player>,
}

local CLIENT_GATE = "Client"
local gates: { string } = { CLIENT_GATE }
local passed: { [Player]: { [string]: boolean } } = {}
local ready: { [Player]: number } = {}

local function checkReady(player: Player)
	if ready[player] or player.Parent ~= Players then
		return
	end
	local done = passed[player]
	if not done then
		return
	end
	for _, gate in gates do
		if not done[gate] then
			return
		end
	end
	ready[player] = os.clock()
	player:SetAttribute("SessionReady", true)
	log:Debug("%s ready", player.Name)
	SessionService.PlayerReady:Fire(player)
end

function SessionService:AddGate(name: string)
	assert(not table.find(gates, name), `SessionService: gate {name} already exists`)
	table.insert(gates, name)
end

function SessionService:Pass(player: Player, gate: string)
	assert(table.find(gates, gate), `SessionService: no gate {gate}`)
	local done = passed[player]
	if not done then
		done = {}
		passed[player] = done
	end
	if done[gate] then
		return
	end
	done[gate] = true
	checkReady(player)
end

function SessionService:Fail(player: Player, message: string)
	log:Warn("%s can't start a session: %s", player.Name, message)
	player:Kick(message)
end

function SessionService:Init(_registry)
	Remotes.OnServer("ClientReady", function(player: Player)
		if player.Parent ~= Players then
			return
		end
		player:SetAttribute("ClientReady", true)
		SessionService:Pass(player, CLIENT_GATE)
	end)
end

function SessionService:Start()
	Players.PlayerRemoving:Connect(function(player: Player)
		SessionService.PlayerLeaving:Fire(player)
		ready[player] = nil
		passed[player] = nil
	end)
end

function SessionService:IsReady(player: Player): boolean
	return ready[player] ~= nil
end

function SessionService:ReadyPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if ready[player] then
			table.insert(list, player)
		end
	end
	return list
end

-- Which gates a player has passed (for DevTools).
function SessionService:Gates(player: Player): { [string]: boolean }
	local result: { [string]: boolean } = {}
	local done = passed[player] or {}
	for _, gate in gates do
		result[gate] = done[gate] == true
	end
	return result
end

return SessionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000DC"><Properties><string name="Name">ThreatDirector</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ThreatDirector: the danger budget (bible Section 10). Run place only; Prompt 12.

	* The threat level rises with the year, the deepest floor, Disturbance, bunker size and
	  player count (Rules.Threat.Level, Tuning.Threat). It is published as RunState.Threat.
	* Each Surge gets a budget from the threat level (the first cycle's is the small tutorial
	  wave, Section 5; a first run's Era I is 30% easier, Section 22) and spends it on monster
	  groups from the era's roster (Rules.Threat.Groups), opened at weighted breach points
	  (BreachService), up to MaxBreachPointsPerSurge places, in waves WaveSpacingSeconds apart.
	  Boss Surges bring their boss instead (Prompt 15). A Normal or Endless Surge first pays for
	  its one disaster from the budget (Section 5; DisasterService:SurgeDisaster, Prompt 13); the
	  Tutorial Surge is a small wave with no disaster.
	* A Surge ends as soon as its last monster dies and its disaster is fixed (Section 5):
	  CycleClock:EndSurge. Monsters left when a Surge times out stay and keep fighting.
	* Between Surges it spends TrickleBudget a cycle on single monsters at weighted points (not in
	  the first cycle, so the tutorial day stays calm), and minor incidents (Section 10): each day
	  from the second may bring one electrical surge (Rules.Disasters.ElectricalChance by era, at a
	  random moment of the day, in a random room).
	* Disturbance (DigService, Prompt 14) calls ExtraBreach at 50 and Tremor at 100; a nest dug open
	  calls Burst.
	* At most 25 monsters are on the map at once: MonsterService queues the rest.

	API:
		ThreatDirector:Level(): number
		ThreatDirector:SpendSurge(kind?): number      -- the wave now (DevTools; Tremor)
		ThreatDirector:ExtraBreach(): boolean        -- Disturbance 50 (Section 10)
		ThreatDirector:Tremor(): number              -- Disturbance 100: a full wave at once
		ThreatDirector:Burst(fraction, at, tag): number -- Prompt 14: a nest's monsters, at once
		ThreatDirector:IsFirstRun(): boolean         -- Prompt 15: someone's first run (a weaker Brood Mother)
		ThreatDirector:SetDisasterCheck(fn)          -- replaces DisasterService:HoldsSurge (tests)
	Dev: threat, surge.wave.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Disasters = require(Shared.Rules.Disasters)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Threat = require(Shared.Rules.Threat)

local log = Log.new("ThreatDirector")

local ThreatDirector = {
	Name = "ThreatDirector",
	Dependencies = {
		"CycleClock", "RunDirector", "BunkerGrid", "SessionService", "ProfileService", "BreachService", "MonsterService",
		"DisasterService", "DevService",
	},
}

local clock: any = nil
local director: any = nil
local grid: any = nil
local session: any = nil
local profiles: any = nil
local breaches: any = nil
local monsters: any = nil
local disasters: any = nil
local dev: any = nil
local set: (string, any) -> () = function() end

local rng = Random.new()
local surge: { Tag: string, Expected: number, Spawned: number, WavesLeft: number, LastWaveAt: number }? = nil
local trickle = 0
local disasterActive: () -> boolean = function()
	return false
end

local function tuning(): { [string]: any }
	return Config.Get("Tuning", "Threat")
end

local function disturbance(): number
	local ok, value = pcall(RunState.Get, "Disturbance")
	return if ok and type(value) == "number" then value else 0
end

local function firstRunEraI(): boolean
	if Threat.EraNumber(clock:Era()) ~= 1 then
		return false
	end
	for _, player in session:ReadyPlayers() do
		local data = profiles:Get(player)
		if data and data.FirstRunDone == false then
			return true
		end
	end
	return false
end

-- Is this an account's first run for anyone in it (Section 22: Era I is 30% easier and the Brood
-- Mother weaker)? Unlike the Era I easing, true in any era (the Brood Mother can come in Year 27).
function ThreatDirector:IsFirstRun(): boolean
	for _, player in session:ReadyPlayers() do
		local data = profiles:Get(player)
		if data and data.FirstRunDone == false then
			return true
		end
	end
	return false
end

function ThreatDirector:Level(): number
	return Threat.Level({
		Year = clock:Year(),
		DeepestFloor = grid:DeepestFloor(),
		Disturbance = disturbance(),
		Rooms = #grid:Rooms(),
		Players = math.max(#session:ReadyPlayers(), 1),
	})
end

-- Opens groups at up to `places` weighted points, in waves `spacing` seconds apart.
local function spend(groups: { Threat.Group }, tag: string, places: number, spacing: number): number
	if #groups == 0 then
		return 0
	end
	local points = {}
	local taken: { [string]: boolean } = {}
	for _ = 1, math.max(1, places) do
		local point = breaches:Pick(rng, taken)
		if point then
			taken[point.Id] = true
			table.insert(points, point)
		end
	end
	if #points == 0 then
		log:Warn("no breach points: %d groups not spent", #groups)
		return 0
	end
	local waves = math.min(#groups, 4)
	local byWave: { { Threat.Group } } = {}
	for i, group in groups do
		local w = (i - 1) % waves + 1
		byWave[w] = byWave[w] or {}
		table.insert(byWave[w], group)
	end
	local total = 0
	for w, list in byWave do
		for _, group in list do
			total += group.Count
		end
		local point = points[(w - 1) % #points + 1]
		task.delay((w - 1) * spacing, function()
			breaches:Open(point.Id, list, tag)
			if surge and surge.Tag == tag then
				surge.WavesLeft -= 1
				surge.LastWaveAt = os.clock()
			end
		end)
	end
	return total
end

function ThreatDirector:SpendSurge(kind: string?): number
	local level = ThreatDirector:Level()
	local surgeKind = kind or clock:Surge() or "Normal"
	local budget = Threat.SurgeBudget(level, surgeKind, firstRunEraI())
	if budget <= 0 then
		return 0
	end
	-- Section 5: a Surge brings a breach wave and one disaster; the disaster is paid for first
	local disasterCost = 0
	if surgeKind == "Normal" or surgeKind == "Endless" then
		disasterCost = disasters:SurgeDisaster(budget, rng)
		budget -= disasterCost
	end
	local groups = Threat.Groups(budget, Threat.Roster(clock:Era()), rng)
	local tag = `Surge:{clock:Cycle()}`
	local waves = math.min(#groups, 4)
	surge = { Tag = tag, Expected = 0, Spawned = 0, WavesLeft = waves, LastWaveAt = os.clock() }
	local t = tuning()
	local total = spend(groups, tag, math.min(t.MaxBreachPointsPerSurge, waves), t.WaveSpacingSeconds)
	if surge and surge.Tag == tag then
		surge.Expected = total
	end
	log:Info("%s Surge (threat %.1f, budget %.1f after %d for its disaster): %d monsters in %d groups", surgeKind, level,
		budget, disasterCost, total, #groups)
	return total
end

-- Disturbance's breaches (Prompt 14) are priced like a normal Surge now, so the first run's Era I
-- is easier for them too: a quarter of one for the extra breach, a whole one for a Tremor.
function ThreatDirector:ExtraBreach(): boolean
	local budget = Threat.SurgeBudget(ThreatDirector:Level(), "Normal", firstRunEraI()) * 0.25
	local groups = Threat.Groups(budget, Threat.Roster(clock:Era()), rng)
	return spend(groups, "Extra", 1, 0) > 0
end

function ThreatDirector:Tremor(): number
	local budget = Threat.SurgeBudget(ThreatDirector:Level(), "Normal", firstRunEraI())
	local groups = Threat.Groups(budget, Threat.Roster(clock:Era()), rng)
	return spend(groups, "Tremor", tuning().MaxBreachPointsPerSurge, 0)
end

-- Monsters all at once at one spot, no warning (Prompt 14: a nest pours its monsters out when it is
-- dug open): `fraction` of what a normal Surge would spend now (so the first run's Era I is
-- easier here too), bought like any group.
function ThreatDirector:Burst(fraction: number, at: CFrame, tag: string): number
	local budget = Threat.SurgeBudget(ThreatDirector:Level(), "Normal", firstRunEraI()) * fraction
	local groups = Threat.Groups(budget, Threat.Roster(clock:Era()), rng)
	local n = 0
	for _, group in groups do
		for _ = 1, group.Count do
			local offset = CFrame.new(((n % 3) - 1) * 2.2, 0, -math.floor(n / 3) * 1.6)
			monsters:Spawn(group.Type, at * offset, tag)
			n += 1
		end
	end
	log:Info("burst of %d monsters (%s)", n, tag)
	return n
end

function ThreatDirector:SetDisasterCheck(fn: () -> boolean)
	disasterActive = fn
end

-- A Surge ends as soon as its last monster dies and its disaster is fixed (Section 5).
local function checkCleared()
	if not surge or clock:Phase() ~= "Surge" then
		return
	end
	local current = surge
	if current.WavesLeft > 0 then
		return
	end
	local spawnedAll = current.Spawned >= current.Expected or os.clock() - current.LastWaveAt > 25
	if spawnedAll and monsters:Count(current.Tag) == 0 and not disasterActive() then
		surge = nil
		if clock:EndSurge() then
			log:Info("%s cleared: the Surge ends", current.Tag)
		end
	end
end

local function cheapest(roster: { string }): (string?, number)
	local best, cost = nil, math.huge
	for _, id in roster do
		local monster = Config.Get("Monsters", id)
		if monster.ThreatCost < cost then
			best, cost = id, monster.ThreatCost
		end
	end
	return best, cost
end

-- Between Surges: small spends on single monsters (Section 10).
local function trickleTick(dt: number)
	if clock:Phase() ~= "Day" or clock:Cycle() <= 1 or director:Phase() ~= "Playing" then
		return
	end
	local cycleSeconds = 270 / math.max(clock:TimeScale(), 0.01)
	trickle += Threat.TrickleBudget(ThreatDirector:Level(), firstRunEraI()) * dt / cycleSeconds
	local roster = Threat.Roster(clock:Era())
	local _, cost = cheapest(roster)
	if trickle < cost then
		return
	end
	local affordable = {}
	for _, id in roster do
		if Config.Get("Monsters", id).ThreatCost <= trickle then
			table.insert(affordable, id)
		end
	end
	local id = affordable[rng:NextInteger(1, #affordable)]
	trickle -= Config.Get("Monsters", id).ThreatCost
	spend({ { Type = id, Count = 1 } }, "Trickle", 1, 0)
end

function ThreatDirector:Init(registry)
	clock = registry.CycleClock
	director = registry.RunDirector
	grid = registry.BunkerGrid
	session = registry.SessionService
	profiles = registry.ProfileService
	breaches = registry.BreachService
	monsters = registry.MonsterService
	disasters = registry.DisasterService
	disasterActive = function(): boolean
		return disasters:HoldsSurge()
	end
	dev = registry.DevService
	set = RunState.Writer("ThreatDirector")

	dev:Register("threat", {
		Description = "The threat level, its inputs, the Surge's wave and the monsters (Prompt 12).",
		Usage = "threat",
		Run = function(): string?
			local level = ThreatDirector:Level()
			local lines = {
				string.format("threat %.1f: year %d, deepest floor %d, Disturbance %d, %d rooms, %d players",
					level, clock:Year(), grid:DeepestFloor(), disturbance(), #grid:Rooms(), math.max(#session:ReadyPlayers(), 1)),
				string.format("Surge budget %.1f (%s), between Surges %.1f a cycle (saved %.2f); first-run Era I: %s",
					Threat.SurgeBudget(level, clock:Surge() or "Normal", firstRunEraI()), tostring(clock:Surge()),
					Threat.TrickleBudget(level, firstRunEraI()), trickle, tostring(firstRunEraI())),
				`roster: {table.concat(Threat.Roster(clock:Era()), ", ")}`,
				if surge then `this Surge ({surge.Tag}): {surge.Spawned}/{surge.Expected} out, {surge.WavesLeft} waves to come, {monsters:Count(surge.Tag)} alive or queued` else "no Surge wave running",
				`monsters: {monsters:Count()} ({monsters:Queued()} queued)`,
			}
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("surge.wave", {
		Description = "Spend a Surge's budget now (Normal unless a kind is given).",
		Usage = "surge.wave [Tutorial|Normal]",
		Run = function(_player, args): string?
			local total = ThreatDirector:SpendSurge(if args[1] then tostring(args[1]) else "Normal")
			return `{total} monsters coming`
		end,
	})
end

function ThreatDirector:Start()
	clock.SurgeStarted:Connect(function(kind: string)
		if director:Phase() ~= "Playing" then
			return
		end
		task.spawn(function()
			ThreatDirector:SpendSurge(kind)
		end)
	end)
	clock.SurgeEnded:Connect(function()
		surge = nil
	end)
	-- minor incidents (Section 10): an electrical surge on some days, in a random room
	clock.CycleStarted:Connect(function(cycle: number)
		if cycle <= 1 or director:Phase() ~= "Playing" then
			return
		end
		local era = Threat.EraNumber(clock:Era())
		if rng:NextNumber() >= Disasters.ElectricalChance(era) then
			return
		end
		local dayScale = math.max(clock:TimeScale(), 0.01)
		task.delay(rng:NextNumber(25, 150) / dayScale, function()
			if clock:Phase() ~= "Day" or director:Phase() ~= "Playing" then
				return
			end
			local options = {}
			for _, room in grid:Rooms() do
				if room.Type ~= "Shaft" and not room.Wrecked then
					table.insert(options, room.Id)
				end
			end
			if #options > 0 then
				disasters:StartElectricalSurge(options[rng:NextInteger(1, #options)], "Incident")
			end
		end)
	end)
	monsters.Spawned:Connect(function(_id: string, _type: string, tag: string?)
		if surge and tag == surge.Tag then
			surge.Spawned += 1
		end
	end)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(1)
			local dt = os.clock() - last
			last = os.clock()
			pcall(checkCleared)
			pcall(trickleTick, dt)
			pcall(function()
				set("Threat", math.floor(ThreatDirector:Level() + 0.5))
				set("Monsters", monsters:Count())
			end)
		end
	end)
	log:Info("threat director ready")
end

return ThreatDirector
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000DD"><Properties><string name="Name">VoteService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VoteService: team votes (bible Section 8). Run place only.

	Anything that spends the shared stockpile or changes the run for everyone goes to a quick
	vote. Prompt 8 runs construction votes (BuildService opens them). Push Deeper (Prompt 14),
	the blueprint draft (19), Keep Going (15), Let them in? (30) and kicks (30) will open theirs
	here too.

	How a vote runs:
	* One vote is live on the banner at a time. Later proposals wait in a queue, and each gets
	  its full time once it goes live, so nothing runs out of time unseen.
	* The proposer counts as a yes. Not voting is abstaining, and a player can change their
	  vote until it closes.
	* Rules (Rules.Votes):
	  * a build passes with more yes than no after 15 s;
	  * spending more than 40% of a stock needs a majority of the whole team;
	  * everyone yes passes at once;
	  * ties fail. A tie-breaker (the Warden, Prompt 20) can pass one: SetTieBreaker.
	* Each player has at most one open proposal (queued or live). A failed one gives that
	  player a 20 s cooldown.
	* Solo runs have no votes: a proposal is checked again and applies at once.
	* When a vote passes, its Check runs again (costs, the cells still free). If that fails
	  now, the vote fails with the reason.
	* The Votes collection (id -> what the banner shows) replicates to every player. A closed
	  vote stays ResultSeconds with PASSED or FAILED, then goes.
	* Studio: `vote.bots <n> [yes|no|abstain]` adds pretend voters to the team, so the team
	  rules can be tried in a one-player playtest.

	API:
		VoteService:Open(spec): (string?, string?)     -- the vote id ("solo" when it applied at once), or why not
		VoteService:Cast(player, id, "Yes" | "No"): (boolean, string?)
		VoteService:CanPropose(player): (boolean, string?)
		VoteService:Reserved(exceptId?): { [string]: boolean }  -- cell keys held by open votes
		VoteService:TeamSize(): number
		VoteService:SetTieBreaker(fn: (voteId) -> boolean)
		VoteService.Opened: Signal<string>, VoteService.Closed: Signal<string, boolean, string?>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local Votes = require(Shared.Rules.Votes)

local log = Log.new("VoteService")

export type Spec = {
	Kind: string, -- a Config.Votes id
	Proposer: Player?, -- nil for votes the game opens
	Title: string, -- what is proposed: "KITCHEN", "QUARTERS TO LEVEL 2"
	Costs: { [string]: number }?, -- shown on the banner; a big spend needs a team majority
	Refund: { [string]: number }?, -- shown on the banner: what comes back (a tear-down)
	Subject: { Floor: number, Column: number, Span: number, Label: string }?, -- the ghost outline
	Cells: { string }?, -- cell keys it holds while open
	Check: (() -> (boolean, string?))?, -- run again when it passes
	OnPass: () -> (),
	OnFail: ((reason: string) -> ())?,
}

type Ballot = "Yes" | "No"
type Status = "Queued" | "Live" | "Passed" | "Failed"
type Vote = {
	Id: string,
	Spec: Spec,
	Rule: Votes.Rule,
	Status: Status,
	Ballots: { [number]: Ballot }, -- by UserId; pretend voters are negative
	EndsAt: number?,
	Result: string?,
}

local VoteService = {
	Name = "VoteService",
	Dependencies = { "SessionService", "ReplicationService", "DevService" },
	Opened = Signal.new() :: Signal.Signal<string>,
	Closed = Signal.new() :: Signal.Signal<string, boolean, string?>,
}

local session: any = nil
local collection: any = nil
local votes: { [string]: Vote } = {}
local queue: { string } = {} -- open votes in order; the first is live
local cooldowns: { [number]: number } = {} -- UserId -> os.clock() it ends
local nextId = 0
local tieBreaker: ((string) -> boolean)? = nil
local bots: { [number]: Ballot | false } = {} -- Studio: pretend voters (-1, -2, ...); false abstains

local function now(): number
	return workspace:GetServerTimeNow()
end

local function tuning(): { [string]: any }
	return Votes.Tuning()
end

-- Everyone who can vote: ready players, plus pretend voters in Studio.
local function team(): { number }
	local ids = {}
	for _, player in session:ReadyPlayers() do
		table.insert(ids, player.UserId)
	end
	for id in bots do
		table.insert(ids, id)
	end
	return ids
end

function VoteService:TeamSize(): number
	return #team()
end

local function count(vote: Vote): (number, number, number)
	local members = team()
	local yes, no = 0, 0
	for _, id in members do
		local ballot = vote.Ballots[id]
		if ballot == "Yes" then
			yes += 1
		elseif ballot == "No" then
			no += 1
		end
	end
	return yes, no, #members
end

local function nameOf(player: Player?): string
	return if player then string.upper(player.DisplayName) else "THE BUNKER"
end

local function publish(vote: Vote)
	local yes, no, size = count(vote)
	local ballots = {}
	for id, ballot in vote.Ballots do
		ballots[tostring(id)] = ballot
	end
	local position = table.find(queue, vote.Id)
	local spec = vote.Spec
	collection:Set(vote.Id, {
		Kind = spec.Kind,
		Title = spec.Title,
		Proposer = if spec.Proposer then spec.Proposer.UserId else 0,
		ProposerName = nameOf(spec.Proposer),
		Cost = if spec.Costs then Construction.CostText(spec.Costs) else "",
		Refund = if spec.Refund and next(spec.Refund) then Construction.CostText(spec.Refund) else nil,
		Rule = vote.Rule,
		Need = Votes.NeedText(vote.Rule, size),
		Status = vote.Status,
		EndsAt = vote.EndsAt,
		Seconds = Config.Get("Votes", spec.Kind).Seconds,
		Yes = yes,
		No = no,
		Team = size,
		Waiting = if position and position > 1 then position - 1 else 0,
		Ballots = ballots,
		Subject = spec.Subject,
		Result = vote.Result,
	})
end

local function publishQueue()
	for _, id in queue do
		local vote = votes[id]
		if vote then
			publish(vote)
		end
	end
end

local function stockNow(): { [string]: number }
	local stockpile = {}
	for _, resource in Config.Ids("Resources") do
		local value = RunState.Fields[resource] and RunState.Get(resource)
		if type(value) == "number" then
			stockpile[resource] = value
		end
	end
	return stockpile
end

local function goLive()
	local id = queue[1]
	local vote = if id then votes[id] else nil
	if not vote or vote.Status ~= "Queued" then
		return
	end
	vote.Status = "Live"
	-- the 40% rule against the stockpile as it is when the team votes
	vote.Rule = Votes.RuleFor(vote.Spec.Kind, Votes.BigSpend(vote.Spec.Costs, stockNow()))
	vote.EndsAt = now() + Config.Get("Votes", vote.Spec.Kind).Seconds
	for botId, ballot in bots do
		if ballot then
			vote.Ballots[botId] = ballot
		end
	end
	log:Info("%s live: %s (%s)", vote.Id, vote.Spec.Title, vote.Rule)
	VoteService.Opened:Fire(vote.Id)
	publishQueue()
end

local function close(vote: Vote, passed: boolean, reason: string?)
	if vote.Status ~= "Live" and vote.Status ~= "Queued" then
		return
	end
	if passed and vote.Spec.Check then
		local ok, why = vote.Spec.Check()
		if not ok then
			passed, reason = false, why or "it can't be done any more"
		end
	end
	vote.Status = if passed then "Passed" else "Failed"
	vote.Result = if passed then "PASSED" else `FAILED: {string.upper(reason or "not enough yes")}`
	local index = table.find(queue, vote.Id)
	if index then
		table.remove(queue, index)
	end
	local spec = vote.Spec
	if passed then
		local ok, err = pcall(spec.OnPass)
		if not ok then
			log:Error("%s passed but OnPass failed: %s", vote.Id, tostring(err))
		end
	else
		if spec.Proposer then
			cooldowns[spec.Proposer.UserId] = os.clock() + tuning().FailedCooldownSeconds
		end
		if spec.OnFail then
			local ok, err = pcall(spec.OnFail :: any, reason or "not enough yes")
			if not ok then
				log:Error("%s OnFail failed: %s", vote.Id, tostring(err))
			end
		end
	end
	log:Info("%s %s: %s", vote.Id, string.lower(vote.Status), reason or "")
	publish(vote)
	VoteService.Closed:Fire(vote.Id, passed, reason)
	task.delay(tuning().ResultSeconds, function()
		votes[vote.Id] = nil
		collection:Remove(vote.Id)
	end)
	goLive()
	publishQueue()
end

local function decide(vote: Vote)
	local yes, no, size = count(vote)
	local result = Votes.Outcome(vote.Rule, yes, no, size)
	if result == "Tie" and tieBreaker then
		local ok, pass = pcall(tieBreaker :: any, vote.Id)
		if ok and pass == true then
			close(vote, true, nil)
			return
		end
	end
	if result == "Pass" then
		close(vote, true, nil)
	elseif result == "Tie" then
		close(vote, false, "a tie")
	else
		close(vote, false, if vote.Rule == "MoreYes" then "more no than yes" else "not enough of the team said yes")
	end
end

-- API ---------------------------------------------------------------------------------------------

function VoteService:CanPropose(player: Player): (boolean, string?)
	if RunState.Get("RunPhase") ~= "Playing" then
		return false, "The run isn't under way."
	end
	if not session:IsReady(player) then
		return false, "You're not in the run yet."
	end
	for _, id in queue do
		local vote = votes[id]
		if vote and vote.Spec.Proposer == player then
			return false, "You already have a proposal open."
		end
	end
	local ends = cooldowns[player.UserId]
	if ends and os.clock() < ends then
		return false, `You can propose again in {math.ceil(ends - os.clock())} s.`
	end
	return true, nil
end

function VoteService:Reserved(exceptId: string?): { [string]: boolean }
	local cells = {}
	for _, id in queue do
		local vote = votes[id]
		if vote and id ~= exceptId and vote.Spec.Cells then
			for _, key in vote.Spec.Cells do
				cells[key] = true
			end
		end
	end
	return cells
end

function VoteService:Open(spec: Spec): (string?, string?)
	assert(Config.Find("Votes", spec.Kind), `VoteService: no vote kind {spec.Kind}`)
	if spec.Proposer then
		local ok, why = VoteService:CanPropose(spec.Proposer)
		if not ok then
			return nil, why
		end
	end
	-- Solo: no vote; check it and apply it at once (Section 8, rule 6).
	if tuning().SoloSkipsVotes and VoteService:TeamSize() <= 1 then
		if spec.Check then
			local ok, why = spec.Check()
			if not ok then
				return nil, why
			end
		end
		local ok, err = pcall(spec.OnPass)
		if not ok then
			log:Error("solo: %s failed to apply: %s", spec.Title, tostring(err))
			return nil, "That couldn't be done (see the server log)."
		end
		log:Info("solo: %s applied at once", spec.Title)
		return "solo", nil
	end
	nextId += 1
	local id = `V{nextId}`
	local vote: Vote = {
		Id = id,
		Spec = spec,
		Rule = Votes.RuleFor(spec.Kind, Votes.BigSpend(spec.Costs, stockNow())),
		Status = "Queued",
		Ballots = {},
	}
	if spec.Proposer then
		vote.Ballots[spec.Proposer.UserId] = "Yes"
	end
	votes[id] = vote
	table.insert(queue, id)
	log:Info("%s opened by %s: %s, %s", id, nameOf(spec.Proposer), spec.Title, vote.Rule)
	if #queue == 1 then
		goLive()
	else
		publish(vote)
	end
	return id, nil
end

function VoteService:Cast(player: Player, id: string, ballot: Ballot): (boolean, string?)
	local vote = votes[id]
	if not vote or vote.Status ~= "Live" then
		return false, "That vote isn't open."
	end
	if not session:IsReady(player) then
		return false, "You're not in the run yet."
	end
	vote.Ballots[player.UserId] = ballot
	local yes, _, size = count(vote)
	if Votes.AllYes(yes, size) then
		close(vote, true, nil)
	else
		publish(vote)
	end
	return true, nil
end

function VoteService:SetTieBreaker(fn: (string) -> boolean)
	tieBreaker = fn
end

-- Lifecycle --------------------------------------------------------------------------------------

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function describe(): string
	if #queue == 0 then
		return `no open votes; team {VoteService:TeamSize()}`
	end
	local lines = {}
	for _, id in queue do
		local vote = votes[id]
		if vote then
			local yes, no, size = count(vote)
			local left = if vote.EndsAt then string.format(", %.0f s left", math.max(0, vote.EndsAt - now())) else ""
			table.insert(lines, `{id} {vote.Status} {vote.Spec.Title}: {yes} yes, {no} no of {size} ({vote.Rule}{left})`)
		end
	end
	return table.concat(lines, "\n")
end

function VoteService:Init(registry)
	session = registry.SessionService
	collection = registry.ReplicationService:Collection("Votes")
	Remotes.OnServer("CastVote", function(player: Player, id: string, ballot: string)
		local ok, why = VoteService:Cast(player, id, ballot :: Ballot)
		if not ok and why then
			alert(player, "Info", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("votes", {
		Description = "Open votes, their tallies and time left.",
		Usage = "votes",
		Run = function(): string?
			return describe()
		end,
	})
	for _, ballot in { "Yes", "No" } do
		dev:Register(`vote.{string.lower(ballot)}`, {
			Description = `Vote {string.lower(ballot)} on the live vote, as you or as pretend voter n.`,
			Usage = `vote.{string.lower(ballot)} [n]`,
			Run = function(player: Player?, args): string?
				local id = queue[1]
				local vote = if id then votes[id] else nil
				if not vote or vote.Status ~= "Live" then
					return "no live vote"
				end
				local bot = tonumber(args[1])
				if bot then
					if bots[-bot] == nil then
						return `no pretend voter {bot}`
					end
					vote.Ballots[-bot] = ballot :: Ballot
					local yes, _, size = count(vote)
					if Votes.AllYes(yes, size) then
						close(vote, true, nil)
					else
						publish(vote)
					end
				else
					-- from Studio's server tools there's no caller: vote as the first player in the run
					local who = player or session:ReadyPlayers()[1]
					if not who then
						return "nobody is in the run to vote as"
					end
					VoteService:Cast(who, id :: string, ballot :: Ballot)
				end
				return describe()
			end,
		})
	end
	dev:Register("vote.test", {
		Description = "Open a vote the game proposes (no proposer, no effect), to try the queue and the telegram.",
		Usage = "vote.test [title]",
		Run = function(_player: Player, args): string?
			local title = string.upper(tostring(args[1] or "TEST VOTE"))
			local id, why = VoteService:Open({
				Kind = "Build",
				Title = title,
				OnPass = function()
					log:Info("test vote %s passed", title)
				end,
			})
			return if id then `opened {id}\n{describe()}` else `not opened: {why}`
		end,
	})
	dev:Register("vote.end", {
		Description = "Time is up on the live vote now.",
		Usage = "vote.end",
		Run = function(): string?
			local id = queue[1]
			local vote = if id then votes[id] else nil
			if not vote or vote.Status ~= "Live" then
				return "no live vote"
			end
			decide(vote)
			return describe()
		end,
	})
	dev:Register("vote.bots", {
		Description = "Studio: n pretend voters join the team, voting yes, no or abstaining on each vote as it goes live.",
		Usage = "vote.bots <n> [yes|no|abstain]",
		Run = function(_player: Player, args): string?
			if not RunService:IsStudio() then
				return "pretend voters are for Studio"
			end
			local n = math.clamp(math.floor(tonumber(args[1]) or 0), 0, 5)
			local stance = string.lower(tostring(args[2] or "abstain"))
			local ballot: Ballot? = if stance == "yes" then "Yes" elseif stance == "no" then "No" else nil
			table.clear(bots)
			for i = 1, n do
				bots[-i] = ballot or false
			end
			publishQueue()
			return `{n} pretend voter(s), {stance}; team {VoteService:TeamSize()}`
		end,
	})
end

function VoteService:Start()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local id = queue[1]
			local vote = if id then votes[id] else nil
			if vote and vote.Status == "Live" and vote.EndsAt and now() >= vote.EndsAt then
				decide(vote)
			end
		end
	end)
	session.PlayerLeaving:Connect(function(_player: Player)
		task.defer(publishQueue) -- the team is smaller: tallies and needs change
	end)
	session.PlayerReady:Connect(function(_player: Player)
		publishQueue()
	end)
end

return VoteService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000DE"><Properties><string name="Name">WeaponService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	WeaponService: what players carry and how they use it (bible Section 9; Section 23: firing,
	reloads, ammo and the server's hit checks). Run place only; Prompt 11.

	Loadouts
	* Each player carries their class kit (Config.Classes): the Survivor until the Lobby sends a
	  loadout (Prompt 21); /dev class switches it. Kit items are Standard rarity.
	* Section 9's loadout is two guns, one melee weapon, one tool and two throwables. The hotbar
	  holds the guns (slots 1 and 2), the tool (3) and the throwables (4 and 5); the melee weapon
	  has its own button. A kit with no melee weapon punches (Tuning.Combat.Unarmed).
	* The selected slot's item is held: a clone of its model (ServerStorage.Assets.Weapons)
	  welded to the right hand at its Grip socket. Slot 0 holds the melee weapon. A swing holds
	  the melee weapon until it ends.
	* Ammo: each gun's magazine, and the player's carried ammo (Tuning.Combat.CarriedAmmo.Start
	  the first time they spawn in a run, up to .Max). A reload moves whole shots from carried
	  ammo into the magazine over the gun's ReloadSeconds; changing slots cancels it. At a
	  Workshop or an Armory, holding Interact for RestockSeconds fills carried ammo from the
	  team's Ammo stockpile (Section 9: players restock at the Armory or Workshop).

	Guns (Section 23: the client fires for instant feedback; the server checks)
	* FireWeapon(slot, shot, origin, aim, time, claims). The shot's number must be the next one,
	  the gun held, loaded, not reloading and past its fire interval (RateTolerance early at
	  most), and the origin near the player. Every pellet's direction comes from the shot's
	  seed (Rules.Combat.Spread), so the client can't choose its spread. Each claimed hit must
	  lie on its pellet's ray, within range, in the line of sight (the server's own raycast)
	  and near where the target was over the last LagSeconds. Only monsters can be hit.
	* A flame gun (Cone) burns every monster in its cone each tick; a Projectile gun's round
	  flies under gravity, run by the server, and bursts on what it touches (BlastRadius;
	  players' explosives never damage the bunker).
	* HitConfirmed tells the shooter what each hit did (hit markers, damage numbers).

	Melee, dodge, sprint, stamina (Section 9)
	* MeleeSwing(heavy, facing): light swings chain into ComboSteps hits; a heavy swing costs
	  HeavySwingStamina and takes HeavySwingMultiplier as long. The hit lands at the windup's
	  end and is checked then (reach and arc in front, Monster Lab's rule), with the weapon's
	  knockback and stun (StunnedUntil on the monster, for Prompt 12's AI).
	* Dodge(direction): DodgeStamina, then DodgeInvulnerableSeconds of invulnerability
	  (CombatService); the client moves the character.
	* Sprint(on): drains SprintStaminaPerSecond while moving; stamina grows back after
	  StaminaRegenDelay.

	Medkits and throwables (Landon, 2026-11-08)
	* Players carry up to Tuning.Player.Loadout.Medkits Medkits (the Medic's kit starts with 5
	  and may carry 5). UseMedkit heals MedkitHeal over MedkitSeconds; going down cancels it and
	  keeps the Medkit. A Medbay's restock point fills carried Medkits from the team's stockpile
	  (Section 13: Medkits come from the Medbay).
	* A throwable slot (4 or 5) holds a stack (Count). With it selected, Fire throws one
	  (ThrowItem): it flies under ThrowGravity and acts where it lands: a Frag Grenade bursts
	  (Radius, Damage, monsters only), a Flare lights the spot for LightSeconds, a Foam Grenade
	  sprays foam (Foamed fires for Prompt 13's fires) and a Shock Mine arms and stuns the
	  monsters that come near it.

	Tools (Prompt 13): with the tool slot (3) held, holding Fire uses the tool (UseTool on and
	off; the client faces where the camera looks). While a tool is in use, ToolTick fires
	ToolTickSeconds apart with the player's root CFrame: DisasterService sprays fires with the
	Extinguisher, BuildService repairs with the Welder. Changing slots, swinging or going down
	stops it. ToolInUse (the item id) shows the use to every client (spray, sparks).
	Swung fires when a melee swing lands (after its windup), for what else a swing can hit
	(DisasterService: cave-in rubble).

	Attributes on the Player (all replicate): Class, Slot, Item1 to Item5, Mag1 and Mag2,
	Count4 and Count5, MeleeItem, CarriedAmmo, Medkits, HealEndsAt, Stamina, ReloadEndsAt,
	ShotSalt, ShotNext, SwingEndsAt, ToolInUse.
	API: Loadout(player), Items(player): { string }, Carries(player, itemId): boolean,
	GiveThrowable(player, itemId, count): number (Prompt 14: caches); signals Foamed, ToolTick,
	Swung (Prompt 13) and Exploded (Prompt 14: explosives raise Disturbance);
	SetHitModifier(fn) (Prompt 15: a boss's armour and weak points scale hits and may rename them,
	"weakpoint").
	Dev: class, give, ammo, medkits, loadout, stamina.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage.Shared
local Combat = require(Shared.Rules.Combat)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("WeaponService")

local SLOTS = 5
local GUN_SLOTS = 2
local MOVING_SPEED = 2 -- studs/s: below this a sprinting player isn't moving
local STAMINA_HZ = 10

type Held = { Item: string, Rarity: string, Magazine: number?, Count: number? }
type Loadout = {
	Class: string,
	Slots: { [number]: Held? },
	Melee: Held,
	Selected: number,
	Carried: number,
	Stamina: number,
	SpentAt: number, -- os.clock() of the last stamina spend
	Sprinting: boolean,
	Salt: number,
	NextShot: number,
	LastShotAt: number,
	ReloadEndsAt: number,
	ReloadToken: number,
	SwingEndsAt: number,
	ComboStep: number,
	LastSwingAt: number,
	DodgeReadyAt: number,
	Medkits: number,
	MedkitCap: number,
	HealEndsAt: number,
	HealToken: number,
	LastThrowAt: number,
	ToolOn: string?, -- the tool in use (Prompt 13)
}

local WeaponService = {
	Name = "WeaponService",
	Dependencies = { "CombatService", "EconomyService", "BunkerGrid", "SessionService", "DevService" },
	-- A Foam Grenade burst: position, radius, the thrower (Prompt 13's fires listen).
	Foamed = Signal.new() :: Signal.Signal<Vector3, number, Player>,
	-- A tool in use (Prompt 13): the player, the tool, their root CFrame, the seconds since the last tick.
	ToolTick = Signal.new() :: Signal.Signal<Player, string, CFrame, number>,
	-- A melee swing landing: the player, where they stood facing, its reach, its arc in degrees,
	-- its damage, the weapon, heavy or not (Prompt 13: rubble).
	Swung = Signal.new() :: Signal.Signal<Player, CFrame, number, number, number, string, boolean>,
	-- A player's explosive went off: where, its radius, whose (Prompt 14: explosives raise Disturbance).
	Exploded = Signal.new() :: Signal.Signal<Vector3, number, Player>,
}

local combat: any = nil
local economy: any = nil
local grid: any = nil
local dev: any = nil

local loadouts: { [Player]: Loadout } = {}
local restockFolder: Folder? = nil

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Loadouts --------------------------------------------------------------------------------

local function kitOf(classId: string): (
	{ [number]: Held? },
	Held,
	number
)
	local class = Config.Find("Classes", classId) or Config.Get("Classes", "Survivor")
	local guns, throwables, counts = {}, {}, {}
	local tool: string? = nil
	local melee: string? = nil
	local medkits = 0
	for _, stack in class.Kit do
		local item = Config.Find("Items", stack.Item)
		if item then
			if item.Kind == "Gun" then
				table.insert(guns, stack.Item)
			elseif item.Kind == "Melee" then
				melee = melee or stack.Item
			elseif item.Kind == "Tool" then
				tool = tool or stack.Item
			elseif item.Kind == "Throwable" then
				table.insert(throwables, stack.Item)
				table.insert(counts, stack.Count or 1)
			elseif stack.Item == "Medkit" then
				medkits += stack.Count or 1
			end
		end
	end
	local slots: { [number]: Held? } = {}
	for i = 1, GUN_SLOTS do
		local id = guns[i]
		if id then
			local gun = Combat.Gun(id)
			slots[i] = { Item = id, Rarity = "Standard", Magazine = if gun then gun.Magazine else 0 }
		end
	end
	if tool then
		slots[3] = { Item = tool, Rarity = "Standard" }
	end
	for i = 1, 2 do
		if throwables[i] then
			slots[3 + i] = { Item = throwables[i], Rarity = "Standard", Count = counts[i] }
		end
	end
	return slots, { Item = melee or Combat.UNARMED, Rarity = "Standard" }, medkits
end

local function publish(player: Player, state: Loadout)
	player:SetAttribute("Class", state.Class)
	player:SetAttribute("Slot", state.Selected)
	for i = 1, SLOTS do
		local held = state.Slots[i]
		player:SetAttribute(`Item{i}`, if held then held.Item else nil)
		if i <= GUN_SLOTS then
			player:SetAttribute(`Mag{i}`, if held then held.Magazine else nil)
		end
	end
	for i = 4, SLOTS do
		local held = state.Slots[i]
		player:SetAttribute(`Count{i}`, if held then held.Count else nil)
	end
	player:SetAttribute("MeleeItem", state.Melee.Item)
	player:SetAttribute("CarriedAmmo", state.Carried)
	player:SetAttribute("Medkits", state.Medkits)
	player:SetAttribute("HealEndsAt", if state.HealEndsAt > now() then state.HealEndsAt else nil)
	player:SetAttribute("ShotSalt", state.Salt)
	player:SetAttribute("ShotNext", state.NextShot)
	player:SetAttribute("ReloadEndsAt", if state.ReloadEndsAt > now() then state.ReloadEndsAt else nil)
end

local function firstSlot(state: Loadout): number
	for i = 1, SLOTS do
		if state.Slots[i] then
			return i
		end
	end
	return 0
end

local function newLoadout(player: Player, classId: string, carried: number?): Loadout
	local slots, melee, medkits = kitOf(classId)
	local p = Config.Get("Tuning", "Player")
	local state: Loadout = {
		Class = classId,
		Slots = slots,
		Melee = melee,
		Selected = 0,
		Carried = carried or Combat.Tuning().CarriedAmmo.Start,
		Stamina = p.Stamina,
		SpentAt = 0,
		Sprinting = false,
		Salt = Random.new():NextInteger(1, 2 ^ 30),
		NextShot = 1,
		LastShotAt = -math.huge,
		ReloadEndsAt = 0,
		ReloadToken = 0,
		SwingEndsAt = 0,
		ComboStep = 0,
		LastSwingAt = -math.huge,
		DodgeReadyAt = 0,
		Medkits = medkits,
		MedkitCap = math.max(p.Loadout.Medkits, medkits),
		HealEndsAt = 0,
		HealToken = 0,
		LastThrowAt = -math.huge,
		ToolOn = nil,
	}
	player:SetAttribute("ToolInUse", nil)
	state.Selected = firstSlot(state)
	loadouts[player] = state
	player:SetAttribute("Stamina", state.Stamina)
	publish(player, state)
	return state
end

-- Held models ------------------------------------------------------------------------------

local function modelOf(itemId: string): Model?
	local item = Config.Find("Items", itemId)
	if not item or not item.Asset then
		return nil
	end
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Weapons")
	local template = folder and folder:FindFirstChild(item.Asset)
	return if template and template:IsA("Model") then template else nil
end

local function holdItem(player: Player, itemId: string?)
	local character = player.Character
	if not character then
		return
	end
	local old = character:FindFirstChild("HeldItem")
	if old and old:GetAttribute("Item") == itemId then
		return
	end
	if old then
		old:Destroy()
	end
	if not itemId then
		return
	end
	local hand = character:FindFirstChild("RightHand")
	local template = modelOf(itemId)
	if not (hand and hand:IsA("BasePart") and template) then
		return
	end
	local model = template:Clone()
	model.Name = "HeldItem"
	model:SetAttribute("Item", itemId)
	local primary = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	if not primary then
		model:Destroy()
		return
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored = false
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Massless = true
		end
	end
	-- Sockets are the model's Socket_<Name> attributes, relative to its pivot (the art
	-- pipeline's AssetSetup). The Grip socket sits in the hand's grip with the item's front
	-- (-Z) along the fingers: forward when the forearm points forward. The Muzzle and Tip
	-- sockets become attachments, for the client's flashes and tracers.
	local pivot = model:GetPivot()
	local function socket(name: string): CFrame?
		local value = model:GetAttribute(`Socket_{name}`)
		return if typeof(value) == "CFrame" then pivot * value else nil
	end
	local gripWorld = socket("Grip") or pivot
	local gripInPrimary = primary.CFrame:ToObjectSpace(gripWorld)
	for _, name in { "Muzzle", "Tip" } do
		local at = socket(name)
		if at then
			local attachment = Instance.new("Attachment")
			attachment.Name = name
			attachment.CFrame = primary.CFrame:ToObjectSpace(at)
			attachment.Parent = primary
		end
	end
	local handGrip = hand:FindFirstChild("RightGripAttachment")
	local handCFrame = if handGrip and handGrip:IsA("Attachment") then handGrip.CFrame else CFrame.new(0, -0.15, 0) * CFrame.Angles(-math.pi / 2, 0, 0)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part ~= primary then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = primary
			weld.Part1 = part
			weld.Parent = part
		end
	end
	local weld = Instance.new("Weld")
	weld.Name = "GripWeld"
	weld.Part0 = hand
	weld.Part1 = primary
	weld.C0 = handCFrame
	weld.C1 = gripInPrimary
	weld.Parent = primary
	model.Parent = character
end

-- What the player should be holding now.
local function refreshHeld(player: Player, state: Loadout)
	if now() < state.SwingEndsAt then
		holdItem(player, if state.Melee.Item ~= Combat.UNARMED then state.Melee.Item else nil)
		return
	end
	local held = state.Slots[state.Selected]
	if held then
		holdItem(player, held.Item)
	elseif state.Selected == 0 and state.Melee.Item ~= Combat.UNARMED then
		holdItem(player, state.Melee.Item)
	else
		holdItem(player, nil)
	end
end

local function alive(player: Player): boolean
	return player:GetAttribute("Life") == "Alive"
end

local function spend(state: Loadout, player: Player, amount: number): boolean
	if state.Stamina < amount then
		return false
	end
	state.Stamina -= amount
	state.SpentAt = os.clock()
	player:SetAttribute("Stamina", state.Stamina)
	return true
end

-- Line of sight: does the world block the way from `from` to `to`?
local function blocked(from: Vector3, to: Vector3, ignore: { Instance }): boolean
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.IgnoreWater = true
	local offset = to - from
	local distance = offset.Magnitude
	if distance < 0.5 then
		return false
	end
	local hit = workspace:Raycast(from, offset.Unit * (distance - 0.5), params)
	return hit ~= nil
end

-- Everything a shot passes through when judging the line of sight: people and monsters.
local function bodies(): { Instance }
	local list: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(list, player.Character)
		end
	end
	for _, c in combat:All() do
		if c.Kind ~= "Player" then
			table.insert(list, c.Model)
		end
	end
	return list
end

local function confirm(player: Player, targetId: string, done: number, point: Vector3?)
	local target = combat:Get(targetId)
	local killed = target == nil or target.State == "Dead"
	Remotes.FireClient("HitConfirmed", player, targetId, done, killed, point)
end

-- Guns ---------------------------------------------------------------------------------------

-- A boss's armour and weak points (Prompt 15): BossService's hook scales a hit and may rename it.
local hitModifier: ((target: any, point: Vector3?, how: string, player: Player) -> (number, string?))? = nil

local function modified(target: any, amount: number, point: Vector3?, how: string, player: Player): (number, string)
	local fn = hitModifier
	if fn then
		local ok, multiplier, newHow = pcall(fn, target, point, how, player)
		if ok and type(multiplier) == "number" then
			return amount * multiplier, if type(newHow) == "string" then newHow else how
		elseif not ok then
			log:Warn("hit modifier: %s", tostring(multiplier))
		end
	end
	return amount, how
end

local function explode(player: Player, at: Vector3, radius: number, damage: number, shooterId: string)
	WeaponService.Exploded:Fire(at, radius, player)
	local blast = Instance.new("Explosion")
	blast.BlastPressure = 0 -- visual only: players' explosives never damage the bunker (Section 9)
	blast.DestroyJointRadiusPercent = 0
	blast.BlastRadius = radius
	blast.Position = at
	blast.Parent = workspace
	local ignore = bodies()
	for _, c in combat:All("Monsters") do
		local distance = (c.Root.Position - at).Magnitude - c.Reach
		if distance <= radius and not blocked(at, c.Root.Position, ignore) then
			local scale = 1 - math.clamp(distance / radius, 0, 1) * 0.5
			local amount, how = modified(c, damage * scale, at, "blast", player)
			local done = combat:Damage(c.Id, amount, shooterId, how)
			if done > 0 then
				confirm(player, c.Id, done, c.Root.Position)
			end
		end
	end
end

local function launch(player: Player, origin: Vector3, direction: Vector3, gun: { [string]: any }, damage: number, shooterId: string)
	local t = Combat.Tuning()
	local round = Instance.new("Part")
	round.Name = "Round"
	round.Shape = Enum.PartType.Ball
	round.Size = Vector3.new(0.6, 0.6, 0.6)
	round.Material = Enum.Material.Neon
	round.Color = Color3.fromRGB(232, 116, 59)
	round.Anchored = true
	round.CanCollide = false
	round.CanQuery = false
	round.CanTouch = false
	round.CFrame = CFrame.new(origin)
	round.Parent = workspace
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { round, player.Character :: Instance }
	local velocity = direction.Unit * t.ProjectileSpeed
	local position = origin
	local travelled = 0
	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function(dt)
		local step = velocity * dt
		local hit = workspace:Raycast(position, step, params)
		velocity -= Vector3.new(0, t.ProjectileGravity * dt, 0)
		travelled += step.Magnitude
		if hit or travelled > gun.Range then
			if connection then
				connection:Disconnect()
			end
			round:Destroy()
			explode(player, if hit then hit.Position else position + step, gun.BlastRadius or 8, damage, shooterId)
			return
		end
		position += step
		round.CFrame = CFrame.new(position)
	end)
end

-- Throwables (Landon, 2026-11-08: Fire throws the held one) ------------------------------------

local THROWN_COLOURS: { [string]: Color3 } = {
	FragGrenade = Color3.fromRGB(96, 104, 66),
	Flare = Color3.fromRGB(232, 92, 59),
	FoamGrenade = Color3.fromRGB(236, 232, 218),
	ShockMine = Color3.fromRGB(230, 182, 46),
}

local function thrownPart(itemId: string): BasePart
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Weapons")
	local item = Config.Find("Items", itemId)
	local template = folder and item and item.Asset and folder:FindFirstChild(item.Asset)
	local primary = template and template:IsA("Model") and template:FindFirstChildWhichIsA("BasePart", true)
	local part: BasePart
	if primary then
		part = (primary :: BasePart):Clone()
		for _, child in part:GetChildren() do
			if not child:IsA("SurfaceAppearance") then
				child:Destroy()
			end
		end
	else -- graybox until A2 brings the model
		local ball = Instance.new("Part")
		ball.Shape = Enum.PartType.Ball
		ball.Size = Vector3.new(0.7, 0.7, 0.7)
		ball.Color = THROWN_COLOURS[itemId] or Color3.fromRGB(200, 200, 200)
		ball.Material = if itemId == "Flare" then Enum.Material.Neon else Enum.Material.SmoothPlastic
		part = ball
	end
	part.Name = `Thrown_{itemId}`
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	return part
end

local function burst(at: Vector3, colour: Color3, count: number, speed: number)
	local holder = Instance.new("Part")
	holder.Name = "Burst"
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(0.2, 0.2, 0.2)
	holder.Position = at
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(colour)
	emitter.LightEmission = 0.4
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1.6) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(0.5, 1.1)
	emitter.Speed = NumberRange.new(speed * 0.5, speed)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 4
	emitter.Rate = 0
	emitter.Parent = holder
	holder.Parent = workspace
	emitter:Emit(count)
	Debris:AddItem(holder, 2)
end

local function placeMine(player: Player, at: Vector3, throwable: { [string]: any })
	local t = Combat.Tuning()
	local mine = thrownPart("ShockMine")
	mine.Name = "ShockMine"
	mine.Position = at + Vector3.new(0, 0.3, 0)
	mine:SetAttribute("Owner", player.UserId)
	mine.Parent = workspace
	local armedAt = os.clock() + t.MineArmSeconds
	local endsAt = os.clock() + t.MineLifetimeSeconds
	task.spawn(function()
		while mine.Parent and os.clock() < endsAt do
			task.wait(0.2)
			if os.clock() >= armedAt then
				local hit = {}
				for _, c in combat:All("Monsters") do
					if (c.Root.Position - mine.Position).Magnitude - c.Reach <= throwable.Radius then
						table.insert(hit, c)
					end
				end
				if #hit > 0 then
					for _, c in hit do
						c.Model:SetAttribute("StunnedUntil", now() + (throwable.StunSeconds or 2))
					end
					burst(mine.Position, Color3.fromRGB(120, 200, 255), 40, 18)
					break
				end
			end
		end
		mine:Destroy()
	end)
end

local function landed(player: Player, itemId: string, throwable: { [string]: any }, at: Vector3)
	local attacker = combat:PlayerCombatant(player)
	local shooterId = if attacker then attacker.Id else `P{player.UserId}`
	if itemId == "ShockMine" or throwable.Trap then
		placeMine(player, at, throwable)
	elseif throwable.Damage and throwable.Damage > 0 then
		explode(player, at, throwable.Radius, throwable.Damage, shooterId)
	elseif throwable.LightSeconds then
		local flare = thrownPart("Flare")
		flare.Name = "Flare"
		flare.Position = at + Vector3.new(0, 0.35, 0)
		flare:SetAttribute("Radius", throwable.Radius)
		flare:SetAttribute("RevealsHidden", throwable.RevealsHidden == true)
		local light = Instance.new("PointLight")
		light.Range = math.min(throwable.Radius, 60)
		light.Brightness = 4
		light.Color = Color3.fromRGB(255, 128, 84)
		light.Shadows = true
		light.Parent = flare
		local sparks = Instance.new("ParticleEmitter")
		sparks.Color = ColorSequence.new(Color3.fromRGB(255, 150, 90))
		sparks.LightEmission = 1
		sparks.Size = NumberSequence.new(0.25, 0)
		sparks.Lifetime = NumberRange.new(0.3, 0.7)
		sparks.Speed = NumberRange.new(4, 9)
		sparks.SpreadAngle = Vector2.new(30, 30)
		sparks.Rate = 40
		sparks.Parent = flare
		flare.Parent = workspace
		Debris:AddItem(flare, throwable.LightSeconds)
	elseif throwable.Extinguishes then
		burst(at, Color3.fromRGB(240, 240, 232), 90, 22)
		WeaponService.Foamed:Fire(at, throwable.Radius, player)
	end
end

local function throwObject(player: Player, origin: Vector3, direction: Vector3, itemId: string, throwable: { [string]: any })
	local t = Combat.Tuning()
	local thrown = thrownPart(itemId)
	thrown.CFrame = CFrame.new(origin)
	thrown.Parent = workspace
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = bodies()
	local velocity = direction.Unit * t.ThrowSpeed
	local position = origin
	local flown = 0
	local connection: RBXScriptConnection? = nil
	connection = RunService.Heartbeat:Connect(function(dt)
		local step = velocity * dt
		local hit = workspace:Raycast(position, step, params)
		velocity -= Vector3.new(0, t.ThrowGravity * dt, 0)
		flown += dt
		if hit or flown > 6 then
			if connection then
				connection:Disconnect()
			end
			thrown:Destroy()
			local at = if hit then hit.Position + hit.Normal * 0.2 else position
			local ok, err = pcall(landed, player, itemId, throwable, at)
			if not ok then
				log:Warn("%s landed badly: %s", itemId, tostring(err))
			end
			return
		end
		position += step
		thrown.CFrame = CFrame.new(position) * CFrame.Angles(flown * 9, flown * 5, 0)
	end)
end

local function onThrow(player: Player, slot: number, origin: Vector3, aim: Vector3)
	local state = loadouts[player]
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not state or not root or not alive(player) or state.Selected ~= slot or now() < state.SwingEndsAt then
		return
	end
	local held = state.Slots[slot]
	local item = held and Config.Find("Items", held.Item)
	if not held or not item or item.Kind ~= "Throwable" or not item.Throwable or (held.Count or 0) <= 0 then
		return
	end
	local t = Combat.Tuning()
	if os.clock() - state.LastThrowAt < t.ThrowCooldownSeconds * (1 - t.RateTolerance) then
		return
	end
	if (origin - root.Position).Magnitude > t.OriginTolerance or aim.Magnitude < 0.5 then
		return
	end
	state.LastThrowAt = os.clock()
	held.Count = (held.Count or 1) - 1
	local itemId = held.Item
	if held.Count <= 0 then
		state.Slots[slot] = nil
	end
	publish(player, state)
	if not state.Slots[slot] then
		refreshHeld(player, state)
	end
	throwObject(player, origin, aim, itemId, item.Throwable)
end

local function onFire(player: Player, slot: number, shot: number, origin: Vector3, aim: Vector3, time: number, claims: { any })
	local state = loadouts[player]
	local shooter = combat:PlayerCombatant(player)
	if not state or not shooter or not alive(player) then
		return
	end
	local held = state.Slots[slot]
	local gun = if held then Combat.Gun(held.Item) else nil
	if not held or not gun or state.Selected ~= slot then
		return
	end
	local t = Combat.Tuning()
	if shot ~= state.NextShot then
		player:SetAttribute("ShotNext", state.NextShot) -- the client resyncs from this
		return
	end
	local clock = os.clock()
	if now() < state.ReloadEndsAt or (held.Magazine or 0) < 1 then
		return
	end
	if clock - state.LastShotAt < Combat.Interval(held.Item) * (1 - t.RateTolerance) then
		return
	end
	if (origin - shooter.Root.Position).Magnitude > t.OriginTolerance or aim.Magnitude < 0.9 then
		return
	end
	held.Magazine = (held.Magazine or 0) - 1
	state.NextShot += 1
	state.LastShotAt = clock
	player:SetAttribute(`Mag{slot}`, held.Magazine)
	player:SetAttribute("ShotNext", state.NextShot)

	local damage = Combat.Damage(held.Item, held.Rarity)
	local serverNow = now()
	local from = math.clamp(time, serverNow - t.LagSeconds, serverNow) - 0.05
	local ignore = bodies()

	if gun.Projectile then
		launch(player, origin, aim, gun, damage, shooter.Id)
		return
	end
	if gun.Cone then
		for _, c in combat:All("Monsters") do
			if Combat.InCone(origin, aim, c.Root.Position, gun.Range, gun.SpreadDegrees, c.Reach)
				and not blocked(origin, c.Root.Position, ignore) then
				local amount, how = modified(c, damage, nil, "burned", player)
				local done = combat:Damage(c.Id, amount, shooter.Id, how)
				if done > 0 then
					confirm(player, c.Id, done, c.Root.Position)
				end
			end
		end
		return
	end
	local pellets = Combat.Spread(Combat.ShotSeed(state.Salt, shot), aim, held.Item)
	local used: { [number]: boolean } = {}
	for _, claim in claims do
		local direction = pellets[claim.Pellet]
		local target = combat:Get(claim.Id)
		if direction and not used[claim.Pellet] and target and target.Team == "Monsters" and target.State == "Alive" then
			used[claim.Pellet] = true
			local ok, why = Combat.CheckHit(origin, direction, claim.Point, gun.Range, target.History, from, serverNow, target.Reach)
			if ok and blocked(origin, claim.Point, ignore) then
				ok, why = false, "the line of sight is blocked"
			end
			if ok then
				local amount, how = modified(target, damage, claim.Point, "shot", player)
				local done = combat:Damage(target.Id, amount, shooter.Id, how)
				if done > 0 then
					confirm(player, target.Id, done, claim.Point)
				end
			else
				log:Debug("%s: a hit on %s refused: %s", player.Name, claim.Id, tostring(why))
			end
		end
	end
end

local function onReload(player: Player)
	local state = loadouts[player]
	if not state or not alive(player) then
		return
	end
	local held = state.Slots[state.Selected]
	local gun = if held then Combat.Gun(held.Item) else nil
	if not held or not gun or now() < state.ReloadEndsAt then
		return
	end
	if (held.Magazine or 0) >= gun.Magazine or state.Carried < gun.AmmoPerShot then
		return
	end
	state.ReloadToken += 1
	local token = state.ReloadToken
	state.ReloadEndsAt = now() + gun.ReloadSeconds
	player:SetAttribute("ReloadEndsAt", state.ReloadEndsAt)
	task.delay(gun.ReloadSeconds, function()
		if loadouts[player] ~= state or state.ReloadToken ~= token then
			return
		end
		state.ReloadEndsAt = 0
		player:SetAttribute("ReloadEndsAt", nil)
		if state.Slots[state.Selected] == held then
			held.Magazine, state.Carried = Combat.Reload(held.Magazine or 0, state.Carried, held.Item)
			player:SetAttribute(`Mag{state.Selected}`, held.Magazine)
			player:SetAttribute("CarriedAmmo", state.Carried)
		end
	end)
end

local function cancelReload(player: Player, state: Loadout)
	if state.ReloadEndsAt > 0 then
		state.ReloadToken += 1
		state.ReloadEndsAt = 0
		player:SetAttribute("ReloadEndsAt", nil)
	end
end

-- Tools (Prompt 13) -------------------------------------------------------------------------------

local function stopTool(player: Player, state: Loadout)
	if state.ToolOn then
		state.ToolOn = nil
		player:SetAttribute("ToolInUse", nil)
	end
end

local function onUseTool(player: Player, on: boolean)
	local state = loadouts[player]
	if not state then
		return
	end
	if not on then
		stopTool(player, state)
		return
	end
	local held = state.Slots[state.Selected]
	local item = held and Config.Find("Items", held.Item)
	if not held or not item or item.Kind ~= "Tool" or not alive(player) or now() < state.SwingEndsAt then
		return
	end
	state.ToolOn = held.Item
	player:SetAttribute("ToolInUse", held.Item)
end

local function toolLoop()
	local last = os.clock()
	while true do
		task.wait(Config.Get("Tuning", "Repairs").ToolTickSeconds)
		local dt = math.min(os.clock() - last, 0.5)
		last = os.clock()
		for player, state in loadouts do
			local tool = state.ToolOn
			if tool then
				local c = combat:PlayerCombatant(player)
				local held = state.Slots[state.Selected]
				if not c or not alive(player) or not held or held.Item ~= tool then
					stopTool(player, state)
				else
					WeaponService.ToolTick:Fire(player, tool, c.Root.CFrame, dt)
				end
			end
		end
	end
end

-- Bosses (Prompt 15): fn(target, point?, how, player) -> (multiplier, how?) for every hit on a
-- monster: its armour, its weak points, what burns.
function WeaponService:SetHitModifier(fn: ((target: any, point: Vector3?, how: string, player: Player) -> (number, string?))?)
	hitModifier = fn
end

-- Everything a player carries: hotbar items and the melee weapon.
function WeaponService:Items(player: Player): { string }
	local state = loadouts[player]
	local list = {}
	if state then
		for i = 1, SLOTS do
			local held = state.Slots[i]
			if held then
				table.insert(list, held.Item)
			end
		end
		table.insert(list, state.Melee.Item)
	end
	return list
end

function WeaponService:Carries(player: Player, itemId: string): boolean
	return table.find(WeaponService:Items(player), itemId) ~= nil
end

-- Throwables found (Prompt 14: a dug cell's cache): onto the slot that holds the same item, up to
-- ThrowableStack, then into an empty throwable slot. Returns how many the player took.
function WeaponService:GiveThrowable(player: Player, itemId: string, count: number): number
	local state = loadouts[player]
	local item = Config.Find("Items", itemId)
	if not state or not item or item.Kind ~= "Throwable" or count <= 0 then
		return 0
	end
	local cap = Combat.Tuning().ThrowableStack
	local left = count
	for _, pass in { "Same", "Empty" } do
		for slot = 4, SLOTS do
			local held = state.Slots[slot]
			if left > 0 and pass == "Same" and held and held.Item == itemId then
				local room = math.max(cap - (held.Count or 0), 0)
				local add = math.min(room, left)
				held.Count = (held.Count or 0) + add
				left -= add
			elseif left > 0 and pass == "Empty" and not held then
				local add = math.min(cap, left)
				state.Slots[slot] = { Item = itemId, Rarity = "Standard", Count = add }
				left -= add
			end
		end
	end
	if left < count then
		publish(player, state)
		refreshHeld(player, state)
	end
	return count - left
end

local function onSelect(player: Player, slot: number)
	local state = loadouts[player]
	if not state or state.Selected == slot then
		return
	end
	stopTool(player, state)
	cancelReload(player, state)
	state.Selected = slot
	player:SetAttribute("Slot", slot)
	refreshHeld(player, state)
end

-- Melee --------------------------------------------------------------------------------------

local function onSwing(player: Player, heavy: boolean, facing: Vector3)
	local state = loadouts[player]
	local attacker = combat:PlayerCombatant(player)
	if not state or not attacker or not alive(player) then
		return
	end
	local clock = now()
	if clock < state.SwingEndsAt - 0.08 then
		return -- still swinging (a little early is network jitter)
	end
	local item = state.Melee.Item
	local p = Config.Get("Tuning", "Player")
	if heavy and not spend(state, player, p.HeavySwingStamina) then
		return
	end
	local step = if heavy then 0 else Combat.NextCombo(state.ComboStep, clock - state.LastSwingAt)
	local windup, length = Combat.Swing(item, heavy)
	state.ComboStep = step
	state.LastSwingAt = clock + length
	state.SwingEndsAt = clock + length
	player:SetAttribute("SwingEndsAt", state.SwingEndsAt)
	cancelReload(player, state)
	stopTool(player, state)
	refreshHeld(player, state)

	local t = Combat.Tuning()
	local melee = Combat.Melee(item) or t.Unarmed
	local damage = Combat.Damage(item, state.Melee.Rarity, heavy)
	task.delay(windup, function()
		if not alive(player) or combat:PlayerCombatant(player) ~= attacker then
			return
		end
		local root = attacker.Root
		local look = Vector3.new(facing.X, 0, facing.Z)
		if look.Magnitude < 0.1 then
			look = root.CFrame.LookVector
		end
		local at = CFrame.lookAt(root.Position, root.Position + look)
		local ignore = bodies()
		for _, c in combat:All("Monsters") do
			if Combat.InArc(at, c.Root.Position, t.MeleeReach + t.MeleeReachTolerance, t.MeleeArcDegrees, c.Reach)
				and not blocked(root.Position, c.Root.Position, ignore) then
				local swingPoint = root.Position + look.Unit * t.MeleeReach * 0.6
				local amount, how = modified(c, damage, swingPoint, if heavy then "smashed" else "struck", player)
				local done = combat:Damage(c.Id, amount, attacker.Id, how)
				if done > 0 then
					confirm(player, c.Id, done, c.Root.Position)
					if melee.Knockback and not c.Root.Anchored then
						local push = (c.Root.Position - root.Position) * Vector3.new(1, 0, 1)
						if push.Magnitude > 0.1 then
							c.Root.AssemblyLinearVelocity += push.Unit * melee.Knockback + Vector3.new(0, melee.Knockback * 0.3, 0)
						end
					end
					if melee.StunSeconds then
						c.Model:SetAttribute("StunnedUntil", now() + melee.StunSeconds)
					end
				end
			end
		end
		WeaponService.Swung:Fire(player, at, t.MeleeReach + t.MeleeReachTolerance, t.MeleeArcDegrees, damage, item, heavy)
	end)
	task.delay(length, function()
		if loadouts[player] == state and now() >= state.SwingEndsAt - 0.01 then
			player:SetAttribute("SwingEndsAt", nil)
			refreshHeld(player, state)
		end
	end)
end

-- Dodge, sprint, stamina ------------------------------------------------------------------------

local function onDodge(player: Player, _direction: Vector3)
	local state = loadouts[player]
	local me = combat:PlayerCombatant(player)
	if not state or not me or not alive(player) then
		return
	end
	local clock = now()
	if clock < state.DodgeReadyAt then
		return
	end
	local t = Combat.Tuning()
	if not spend(state, player, Config.Get("Tuning", "Player").DodgeStamina) then
		return
	end
	state.DodgeReadyAt = clock + t.DodgeSeconds + t.DodgeCooldownSeconds
	combat:SetInvulnerable(me.Id, clock + t.DodgeInvulnerableSeconds)
end

local function onSprint(player: Player, on: boolean)
	local state = loadouts[player]
	if state then
		state.Sprinting = on and alive(player)
	end
end

local function staminaLoop()
	local p = Config.Get("Tuning", "Player")
	local dt = 1 / STAMINA_HZ
	while true do
		task.wait(dt)
		for player, state in loadouts do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local moving = false
			if root then
				local v = root.AssemblyLinearVelocity
				moving = Vector3.new(v.X, 0, v.Z).Magnitude > MOVING_SPEED
			end
			local sprinting = state.Sprinting and moving and state.Stamina > 0
			local before = state.Stamina
			state.Stamina = Combat.Stamina(state.Stamina, p.Stamina, dt, sprinting, os.clock() - state.SpentAt)
			if sprinting then
				state.SpentAt = os.clock()
			end
			if state.Stamina <= 0 then
				state.Sprinting = false
			end
			if math.abs(state.Stamina - before) > 1e-6 then
				local shown = player:GetAttribute("Stamina")
				if type(shown) ~= "number" or math.abs(shown - state.Stamina) >= 1 or state.Stamina == 0 or state.Stamina == p.Stamina then
					player:SetAttribute("Stamina", math.floor(state.Stamina * 10 + 0.5) / 10)
				end
			end
		end
	end
end

-- Restocking at a Workshop or Armory -----------------------------------------------------------

local function restock(player: Player): (number, string?)
	local state = loadouts[player]
	if not state or not alive(player) then
		return 0, "not now"
	end
	local max = Combat.Tuning().CarriedAmmo.Max
	local want = max - state.Carried
	if want <= 0 then
		return 0, "you're full"
	end
	local have = economy:Get("Ammo")
	local take = math.min(want, have)
	if take <= 0 then
		return 0, "the stockpile has no Ammo"
	end
	local ok, why = economy:Spend({ Ammo = take }, `restock for {player.Name}`)
	if not ok then
		return 0, why
	end
	state.Carried += take
	player:SetAttribute("CarriedAmmo", state.Carried)
	return take, nil
end

-- Medkits (Landon, 2026-11-08: the Heal button uses one over MedkitSeconds) -------------------

local function cancelHeal(player: Player, state: Loadout)
	if state.HealEndsAt > 0 then
		state.HealEndsAt = 0
		state.HealToken += 1
		player:SetAttribute("HealEndsAt", nil)
	end
end

local function onMedkit(player: Player)
	local state = loadouts[player]
	local c = combat:PlayerCombatant(player)
	if not state or not c or not alive(player) or now() < state.HealEndsAt then
		return
	end
	if state.Medkits <= 0 then
		Remotes.FireClient("Alert", player, "Warning", "NO MEDKITS: TAKE SOME AT THE MEDBAY")
		return
	end
	local health, max = combat:HealthOf(c.Id)
	if health >= max then
		Remotes.FireClient("Alert", player, "Info", "ALREADY AT FULL HEALTH")
		return
	end
	local p = Config.Get("Tuning", "Player")
	state.HealToken += 1
	local token = state.HealToken
	state.HealEndsAt = now() + p.MedkitSeconds
	player:SetAttribute("HealEndsAt", state.HealEndsAt)
	task.delay(p.MedkitSeconds, function()
		if loadouts[player] ~= state or state.HealToken ~= token then
			return
		end
		state.HealEndsAt = 0
		player:SetAttribute("HealEndsAt", nil)
		local me = combat:PlayerCombatant(player)
		if not me or not alive(player) or state.Medkits <= 0 then
			return
		end
		state.Medkits -= 1
		player:SetAttribute("Medkits", state.Medkits)
		combat:Heal(me.Id, p.MedkitHeal)
	end)
end

local function restockMedkits(player: Player): (number, string?)
	local state = loadouts[player]
	if not state or not alive(player) then
		return 0, "not now"
	end
	local want = state.MedkitCap - state.Medkits
	if want <= 0 then
		return 0, "you're full"
	end
	local take = math.min(want, economy:Get("Medkits"))
	if take <= 0 then
		return 0, "the stockpile has no Medkits"
	end
	local ok, why = economy:Spend({ Medkits = take }, `Medkits for {player.Name}`)
	if not ok then
		return 0, why
	end
	state.Medkits += take
	player:SetAttribute("Medkits", state.Medkits)
	return take, nil
end

local function syncRestockPoints()
	local root = grid:Root()
	if not root then
		return
	end
	local folder = restockFolder
	if not folder or folder.Parent == nil then
		folder = Instance.new("Folder")
		folder.Name = "Restock"
		folder.Parent = root
		restockFolder = folder
	end
	local wanted: { [string]: Vector3 } = {}
	local kinds: { [string]: string } = {}
	for _, roomType in { "Workshop", "Armory", "Medbay" } do
		for _, room in grid:RoomsOfType(roomType) do
			local model = grid:RoomModel(room.Id)
			local medbay = roomType == "Medbay"
			local socket = model and model:FindFirstChild(if medbay then "MedkitCabinet" else "Restock", true)
			wanted[room.Id] = if socket and socket:IsA("Attachment")
				then socket.WorldPosition
				else Grid.CellPosition(room.Floor, room.Column) + (if medbay then Vector3.new(-5, 3, 2) else Vector3.new(0, 3, 2))
			kinds[room.Id] = if medbay then "RestockMedkits" else "Restock"
		end
	end
	for _, point in (folder :: Folder):GetChildren() do
		local roomId = point:GetAttribute("RoomId")
		if type(roomId) ~= "string" or not wanted[roomId] or point:GetAttribute("Kind") ~= kinds[roomId] then
			point:Destroy()
		end
	end
	for roomId, position in wanted do
		local point = (folder :: Folder):FindFirstChild(roomId)
		if not point then
			local part = Instance.new("Part")
			part.Name = roomId
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.Transparency = 1
			part.Size = Vector3.new(1, 1, 1)
			part:SetAttribute("RoomId", roomId)
			local kind = kinds[roomId]
			part:SetAttribute("Kind", kind)
			local medkits = kind == "RestockMedkits"
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "RestockPrompt"
			prompt.ActionText = if medkits then "Take Medkits" else "Restock ammo"
			local room = grid:Room(roomId)
			prompt.ObjectText = if room then Config.Get("Rooms", room.Type).Name else "Ammo"
			prompt.HoldDuration = Combat.Tuning().RestockSeconds
			prompt.MaxActivationDistance = 10
			prompt.RequiresLineOfSight = false
			prompt.Style = Enum.ProximityPromptStyle.Custom
			prompt:SetAttribute("Kind", kind)
			prompt.Triggered:Connect(function(player: Player)
				local took, why = (if medkits then restockMedkits else restock)(player)
				local what = if medkits then (if took == 1 then "MEDKIT" else "MEDKITS") else "AMMO"
				Remotes.FireClient("Alert", player, if took > 0 then "Info" else "Warning",
					if took > 0 then `TOOK {took} {what} FROM THE STOCKPILE` else `CAN'T RESTOCK: {string.upper(why or "")}`)
			end)
			prompt.Parent = part
			part.Parent = folder
			point = part
		end
		(point :: BasePart).Position = position
	end
end

-- Lifecycle --------------------------------------------------------------------------------------

local function describe(player: Player): string
	local state = loadouts[player]
	if not state then
		return "no loadout"
	end
	local lines = { `{player.Name}: {state.Class}, slot {state.Selected}, carried {state.Carried}, Medkits {state.Medkits}/{state.MedkitCap}, stamina {math.floor(state.Stamina)}` }
	for i = 1, SLOTS do
		local held = state.Slots[i]
		if held then
			table.insert(lines, `  {i}: {held.Item} ({held.Rarity}){if held.Magazine then ` {held.Magazine} loaded` else ""}{if held.Count then ` x{held.Count}` else ""}`)
		end
	end
	table.insert(lines, `  melee: {state.Melee.Item}`)
	return table.concat(lines, "\n")
end

function WeaponService:Loadout(player: Player): Loadout?
	return loadouts[player]
end

function WeaponService:Init(registry)
	combat = registry.CombatService
	economy = registry.EconomyService
	grid = registry.BunkerGrid
	dev = registry.DevService

	dev:Register("loadout", {
		Description = "Your loadout: class, hotbar, magazines, carried ammo and stamina.",
		Usage = "loadout",
		Run = function(player): string?
			return if player then describe(player) else "players only"
		end,
	})
	dev:Register("class", {
		Description = "Take a class's kit (until the Lobby's loadouts, Prompt 21).",
		Usage = "class <ClassId>",
		Run = function(player, args): string?
			if not player then
				return "players only"
			end
			local id = tostring(args[1] or "")
			if not Config.Find("Classes", id) then
				return `no class {id}`
			end
			local old = loadouts[player]
			local state = newLoadout(player, id, if old then old.Carried else nil)
			refreshHeld(player, state)
			return describe(player)
		end,
	})
	dev:Register("give", {
		Description = "Put an item in a hotbar slot (guns 1-2, tool 3, throwables 4-5) or as the melee weapon.",
		Usage = "give <ItemId> [slot|melee] [rarity] [count]",
		Run = function(player, args): string?
			local state = player and loadouts[player]
			if not player or not state then
				return "players only"
			end
			local itemId = tostring(args[1] or "")
			local item = Config.Find("Items", itemId)
			if not item then
				return `no item {itemId}`
			end
			local rarity = if Config.Find("ItemRarities", args[3]) then tostring(args[3]) else "Standard"
			if item.Kind == "Melee" or args[2] == "melee" then
				state.Melee = { Item = itemId, Rarity = rarity }
			else
				local slot = tonumber(args[2]) or (if item.Kind == "Gun" then 1 elseif item.Kind == "Tool" then 3 else 4)
				local gun = Combat.Gun(itemId)
				local count = if item.Kind == "Throwable"
					then math.clamp(math.floor(tonumber(args[4]) or Combat.Tuning().ThrowableStack), 1, 99)
					else nil
				state.Slots[slot] = { Item = itemId, Rarity = rarity, Magazine = if gun then gun.Magazine else nil, Count = count }
			end
			publish(player, state)
			refreshHeld(player, state)
			return describe(player)
		end,
	})
	dev:Register("ammo", {
		Description = "Set your carried ammo.",
		Usage = "ammo [amount]",
		Run = function(player, args): string?
			local state = player and loadouts[player]
			if not player or not state then
				return "players only"
			end
			state.Carried = math.max(0, math.floor(tonumber(args[1]) or Combat.Tuning().CarriedAmmo.Max))
			player:SetAttribute("CarriedAmmo", state.Carried)
			return describe(player)
		end,
	})
	dev:Register("medkits", {
		Description = "Set your carried Medkits.",
		Usage = "medkits [count]",
		Run = function(player, args): string?
			local state = player and loadouts[player]
			if not player or not state then
				return "players only"
			end
			state.Medkits = math.clamp(math.floor(tonumber(args[1]) or state.MedkitCap), 0, 99)
			player:SetAttribute("Medkits", state.Medkits)
			return describe(player)
		end,
	})
	dev:Register("stamina", {
		Description = "Set your stamina.",
		Usage = "stamina [amount]",
		Run = function(player, args): string?
			local state = player and loadouts[player]
			if not player or not state then
				return "players only"
			end
			state.Stamina = math.clamp(tonumber(args[1]) or 100, 0, Config.Get("Tuning", "Player").Stamina)
			player:SetAttribute("Stamina", state.Stamina)
			return describe(player)
		end,
	})
end

function WeaponService:Start()
	local function joined(player: Player)
		player.CharacterAdded:Connect(function()
			local state = loadouts[player] or newLoadout(player, "Survivor")
			state.SwingEndsAt = 0
			state.Sprinting = false
			cancelReload(player, state)
			cancelHeal(player, state)
			stopTool(player, state)
			task.defer(function()
				if player.Character then
					player.Character:WaitForChild("RightHand", 10)
					refreshHeld(player, state)
				end
			end)
		end)
		if player.Character then
			local state = loadouts[player] or newLoadout(player, "Survivor")
			task.defer(refreshHeld, player, state)
		end
	end
	Players.PlayerAdded:Connect(joined)
	for _, player in Players:GetPlayers() do
		joined(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		loadouts[player] = nil
	end)

	Remotes.OnServer("SelectSlot", onSelect)
	Remotes.OnServer("FireWeapon", onFire)
	Remotes.OnServer("ReloadWeapon", onReload)
	Remotes.OnServer("MeleeSwing", onSwing)
	Remotes.OnServer("Dodge", onDodge)
	Remotes.OnServer("Sprint", onSprint)
	Remotes.OnServer("ThrowItem", onThrow)
	Remotes.OnServer("UseMedkit", onMedkit)
	Remotes.OnServer("UseTool", onUseTool)

	combat.Downed:Connect(function(id: string)
		local c = combat:Get(id)
		local player = c and c.Player
		local state = player and loadouts[player]
		if player and state then
			state.Sprinting = false
			cancelReload(player, state)
			cancelHeal(player, state)
			stopTool(player, state)
		end
	end)

	grid.RoomChanged:Connect(function()
		task.defer(syncRestockPoints)
	end)
	syncRestockPoints()
	task.spawn(staminaLoop)
	task.spawn(toolLoop)
	log:Info("weapons ready: the Survivor's kit by default, carried ammo %d", Combat.Tuning().CarriedAmmo.Start)
end

return WeaponService
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX000000E1"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX000000E1"><Properties><string name="Name">Documentation</string></Properties><Item class="ModuleScript" referent="RBX000000E1"><Properties><string name="Name">ARCHITECTURE</string><ProtectedString name="Source"><![CDATA[--!strict
return [=[
# 100 Years Of Fallout: ARCHITECTURE

The living map of the code (bible Section 23). Every prompt updates it. The bible wins: if
this document, the code and the bible disagree, the bible is right and the difference is a
bug or a Bible Question.

## Places

| Place | Id | Players | Role |
|---|---|---|---|
| Lobby (start place) | 135073046693952 | 30 | hub, shops, Legends Hall, quests, leaderboards, elevator pads |
| Run (reserved servers) | 72892455946761 | 6 | the bunker, the surface and the Deep |

Both places run the same shared code, bootstraps and infrastructure services. Each adds its
own services and controllers on top (Run: RunDirector, BunkerGrid...; Lobby: PadService,
ClassShopService...). `Constants.PlaceKind()` says which place is running.

## Where code lives (both places)

```
ReplicatedStorage
  Shared                         (Folder) code both sides run
    BuildInfo                    which build is installed; written by the installer
    Constants                    identity and engine limits (never gameplay numbers)
    Types                        types that cross module or network boundaries
    Remotes                      the one list of RemoteEvents + the only API to use them
    RunState                     the run's small values, replicated as attributes on it (Run)
    UIContract                   the parts of the UI layout the code uses (StructureCheck checks them)
    Config                       content aggregator; one child ModuleScript per content type
    Rules                        pure game rules both sides share (Clock, Grid, Bunker, CameraRig, Hud,
                                 CommandView, Votes, Construction, Economy, Residents, Combat)
    Utilities                    Check, Delta, Loader, Log, RateLimit, Signal, TableUtil, Trove
ServerScriptService
  Bootstrap                      (Script) the only server script
  Services                       one ModuleScript per service
  Lib                            server-only modules that aren't services (ProfileSchema; Run: BunkerKit)
  DevTools                       StructureCheck, DataTests (+ Invoke in Studio playtests)
StarterPlayer.StarterPlayerScripts
  ClientBootstrap                (LocalScript) the only client script
  Controllers                    one ModuleScript per controller
  Lib                            client-only modules that aren't controllers (Fade, KitRuntime, Movement, UIKit, UISamples)
StarterGui
  Reticle                        the aim sight (built in Studio, studio/ui/Reticle.lua)
  Frame                          The Frame, the one menu layout (both places; studio/ui/Frame.lua)
  HUD                            the run HUD (Run; studio/ui/HUD.lua)
ServerStorage
  Documentation.ARCHITECTURE     this document
  Assets                         models from the art pipeline (Run)
  ArtPipeline.AssetSetup         art pipeline helper (Run; not game code)
```

Rules: only the two bootstraps are scripts; everything else is a ModuleScript. No `_G`, no
`shared`: modules `require` each other. Server-only code never goes in ReplicatedStorage.
Objects named `A0_...` (showroom, sample screens) are art-pipeline samples, allowed until
gameplay replaces them; the A0 sample screens now sit in `ServerStorage.UIArchive` (Run).

## Where code comes from

The source of truth is the repo `landonhjones2020-bit/100years-assets`, folder `game/`
(Rojo naming: `init.luau` makes the folder a module, `.server.luau` is a Script,
`.client.luau` a LocalScript). `game/shared`, `game/server`, `game/client` and `game/docs`
go to both places; `game/places/<Place>/...` only to that place.

`tools/game_sync.py build` turns the tree into one Model asset (`exports/Code/GameCode.rbxmx`,
holding a Lobby and a Run variant), which is uploaded through Open Cloud like the art and
installed into each place by the Luau that `tools/game_sync.py install <assetId> <Place>`
prints. The install replaces the managed folders wholesale and refuses to run if a script was
edited in Studio since the last install (StructureCheck's Sources check), so nothing written
in Studio is lost: bring such edits back into the repo first.

## Lifecycle

Server: `Bootstrap` → `Remotes.Setup()` → `Loader.Collect(Services)` → every `Init` in
dependency order → every `Start` on its own thread → `ReplicatedStorage` attributes
`PlaceKind`, `Build`, `ServerReady` (and `ServerBroken` if a service failed).

Client: `ClientBootstrap` → every controller's `Init`, then `Start` → waits for `ServerReady`
→ fires `ClientReady` → the server marks the session ready and sends the snapshot.

## Writing a service or controller

```lua
--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)

local log = Log.new("CycleClock")

local CycleClock = {
	Name = "CycleClock",                 -- must equal the ModuleScript name
	Dependencies = { "DevService" },    -- only these can be read from the registry
}

function CycleClock:Init(registry)     -- wire up: remotes, signals, dev commands. No loops.
	registry.DevService:Register("year", { Description = "...", Run = function(player, args) ... end })
end

function CycleClock:Start()            -- runs after every Init: loops, timers, world state
end

return CycleClock
```

* Top-level code in a module has no side effects (StructureCheck requires modules at edit
  time to validate them). Do the work in `Init` and `Start`.
* `Init` must not yield or loop; it is timed and anything over 0.5 s is reported.
* A module whose `Init` errors is reported; modules depending on it are skipped, and the
  server sets `ServerBroken`.
* Talk across modules through methods and Signals the other module exposes, never by
  reaching into its internals.

## Networking

* Every RemoteEvent is an entry in `Shared.Remotes` (`To`, `Args`, `Rate`, `Doc`, and `Place`
  for remotes only one place has). Nothing else creates remotes; StructureCheck flags any that
  appear elsewhere.
* Clients send intentions (propose this room, fire at this point), never results. Each
  client → server remote checks every argument (`Utilities.Check`: finite numbers, valid
  UTF-8, lists without holes, shapes without unknown fields) and rate-limits each player
  before its handler runs. Handlers still check ownership, ranges and game state.
* Small values (year, resources, cycle phase) replicate as attributes.
* Collections (rooms, residents, votes...) go through the delta channel:
  `ReplicationService:Collection("Rooms")` with `Set`, `Patch`, `Remove`, `Clear` on the
  server, `ReplicaController:Get/All/Changed` on the client. Changes are batched and sent
  `Constants.DELTA_HZ` times a second; a player gets a snapshot when their session becomes
  ready. Values must be remote-safe (`Delta.IsRemoteSafe`): lists or string-keyed tables,
  finite numbers, no Instances, no functions. Per-player collections pass `Visible`.

## The run (Run place)

`RunDirector` owns the lifecycle and how a run ends; `CycleClock` owns cycles, phases, the year
counter, Years per Cycle and skips; `ObjectiveService` keeps the Lost Crews rescued and era
bosses beaten (bible Sections 4, 5 and 23). The century's arithmetic is `Shared.Rules.Clock`,
pure functions the data tests hold to the bible.

```
Waiting --first player ready--> Intro (30 s) --> Playing --> Ended --Keep Going--> Playing (Endless)
                                                    |  Day 3:00 (siren at 2:40) -> Surge 1:30 -> year jump -> next Day
```

* The run clock starts at the 30-second mark for everyone; skipping the cutscene is personal.
* Years per Cycle = 1 + the `YearsPerCycle` of every objective done (`Config.Objectives`: +2 a
  Lost Crew, +1 an era boss), at most 12. The year jumps at the end of each cycle.
* A jump that reaches or passes 25, 50 or 75 makes that era's boss the next Surge (once, unless
  already beaten). At 100 the year stops and the next Surge is the final one (the Source); when
  it ends the clock halts and RunDirector declares a Century Victory.
* Surges end when their time is up, or earlier through `CycleClock:EndSurge()` (ThreatDirector,
  when the last monster is dead and the disaster fixed). A boss Surge (an era boss or the final
  Surge) has no timer (`PhaseOpen`) and ignores EndSurge: it ends when its boss is beaten,
  `ObjectiveService:BossBeaten(bossId)` -> `BossDefeated` (Landon, 2026-11-08).
* Skips: when every player in the run has pressed Ready (`SetReady` remote) or rests in a
  Quarters bed (`CycleClock:SetResting`), the day jumps to the siren. Both count only during a
  day before the siren and both reset at the siren (Landon, 2026-11-08).
* Keep Going after any victory, even an early Deep Victory, starts Endless at once (Landon).
* Defeat: `RunDirector:Lose("ReactorDestroyed" | "ResidentsLost")`; Deep Victory:
  `RunDirector:Win("Deep")`; Keep Going: `RunDirector:KeepGoing()` (no more era bosses or year
  cap, Endless Surges). The results screen reads `RunDirector:Summary()`.
* Signals for other systems: `CycleClock.CycleStarted` (residents eat and drink), `YearChanged`
  (aging), `EraChanged`, `SirenStarted`, `SurgeStarted`, `SurgeEnded` (the blueprint draft),
  `Skipped`; `RunDirector.PhaseChanged`, `RunEnded`; `ObjectiveService.Changed`.

**RunState** (`Shared.RunState`): the run's small values, replicated as attributes on that
ModuleScript. Each has one writer, which gets a setter from `RunState.Writer(name)`; anyone
reads `RunState.Get`, `RunState.Changed`, `RunState.TimeLeft()` (times are server time, so
every client counts down to the same moment).

| Writer | Values |
|---|---|
| RunDirector | RunPhase, IntroEndsAt, Difficulty, Outcome, DefeatReason, Victory, Endless |
| CycleClock | Cycle, Year, Era, YearsPerCycle, CyclePhase, PhaseLength, PhaseEndsAt, PhaseLeft, PhaseOpen, Siren, SurgeKind, SurgeBoss, ReadyCount, ReadyNeeded, Paused, TimeScale |
| ObjectiveService | LostCrews, BossesBeaten |

Players carry `Ready` and `Resting` attributes (CycleClock). In Studio, set the attribute
`SkipIntro` on `ServerScriptService.DevTools` to true to start runs without the 30 s intro.

## The bunker (Run place)

`BunkerGrid` holds the run's bunker (bible Section 6): the data and rules are
`Shared.Rules.Bunker`, the geometry `Shared.Rules.Grid`, and `Lib.BunkerKit` builds the world.

* Cells: columns -6 to 6, floors 1 to 10 (the depth; floor 10 is the Source Chamber). Every cell
  is Rock, Dug or part of a room. Rooms are 1 to 3 cells side by side on one floor.
* Rules (Rules.Bunker): dig a Rock cell left of, right of or below a dug cell or room; place a room
  on Dug cells (MaxCells, Unique, a room's own Floor, never in the Source Chamber); merge two
  matching rooms of one level side by side (never different levels); Fixed rooms (Blast Door,
  Reactor Core) never merge or go; levels 1 to 3. HP is per cell: `Tuning.Rooms.HP[level]`
  times the cells (Landon, 2026-11-08); a merged room keeps both rooms' HP. Votes, costs,
  build and dig times come from BuildService and DigService.
* The room graph: a node per room (`R3`) and per Dug cell (`D:2,3`); edges through doorways
  (side-by-side open cells of different units) and between stacked Shafts. A dug cell is a step
  when power counts steps from a Reactor Core or a Generator (Landon, 2026-11-08).
* The run starts with `Tuning.StartingBunker`: floor 1 Blast Door (2 cells), Shaft, Quarters
  (2 cells), a dug cell; floor 2 Kitchen, Water Purifier, Shaft, Reactor Core, Medbay, a dug
  cell; the Shafts in column 0, rock at column -3 (the bible's diagram).
* World (Rules.Grid): `Tuning.Grid.Origin` is the interior floor centre of floor 1, column 0
  (0, -120, 0). Cells repeat every 34 studs along +X and 18 down; the front, where the Command
  View camera sits, faces +Z. Art models face -Z: place them with `Grid.CellCFrame`.
* `workspace.Bunker` (built at server start, rebuilt around each change) from the A1 art in
  `ServerStorage.Assets.Kit` and `.Rooms`, each piece falling back to the Prompt 4 graybox when
  missing: `Frame` (a ring of rock cells), `Rock` (models named by cell key), `Dug` (models
  `D:<key>`), `Rooms` (models named by room id, with RoomId, RoomType, Floor, Column, Span,
  Level and Art attributes). Every unit is Persistent. Players spawn in the Medbay; the place's
  other spawns are disabled when the server starts.
* Tags: `FrontWall` (front wall parts: hidden in the Command View), `CameraFade` (furniture,
  the Blast Door set, the stair, vents, lamps, cave props: the camera passes through and fades
  them), `RoomLight` (PointLights, with a `Unit` attribute, for the power system). Floors,
  walls, ceilings and rock stop the camera.
* Gameplay points: each room's `Sockets` part holds an Attachment per socket of its art
  (WorkSpot1.., Bed1.., Seat1.., Core, Valve1.., FuseBox, Breaker, Tap, Bench, Respawn, Door,
  SurfaceExit, Vent, Lift, Chute, Top, Bottom, Light1..), numbered across the room's cells.
  Read them with `BunkerKit.Socket(model, name)` and `BunkerKit.Sockets(model, pattern)`.
* Replication: the `Cells` collection (`"floor,column"` -> `{ Room = id }`, `{}` when Dug) and
  the `Rooms` collection (id -> Type, Floor, Column, Span, Level, HP, MaxHP).

## The camera and input (both places)

`InputController` turns PC, touch and gamepad input into actions; `CameraController` is the
over-the-shoulder camera (bible Section 9); `Lib.Fade` makes world parts see-through on this
client only. The camera's geometry is `Shared.Rules.CameraRig`, its numbers `Tuning.Camera`.

* Actions follow the bible's controls table (`BINDINGS` in InputController). Listen with
  `InputController:On(action, began, ended)`; HUD touch buttons join with
  `BindButton(action, button)`. Moving and jumping stay Roblox's. `Block(reason)` stops gameplay
  actions while a screen is open (CommandView is never blocked).
* Roblox marks Tab as processed before ContextActionService sees it begin, so Tab (and the
  gamepad's View button) are also read from UserInputService when processed (no text box
  focused, Roblox's menu closed). `GuiService.AutoSelectGuiEnabled` is off: Roblox would take
  the View button for its own UI selection, and our screens select for the gamepad themselves.
* Right shoulder by default; `SwapShoulder` (V, right stick click) swaps. `Aim` (right mouse,
  left trigger; Run place only) narrows the view 70 to 50, brings the camera in, slows walking
  and turns the character with the camera.
* Zoom caps: the wheel or a pinch zooms between `Distance.Min` and `Distance.Max`, at most
  `IndoorMax` in a bunker cell. A spherecast from the shoulder stops the camera at floors, walls,
  ceilings and rock (in at once, out gently); in a cell it also stays between the floor and the
  ceiling panels (not in a Shaft, which is open overhead).
* Wall fade: `FrontWall` and `CameraFade` parts never stop the camera and fade while they hide
  the character or touch the camera; characters and `CameraIgnore` are passed through. The
  local character fades when the camera reaches its head.
* PC: the mouse is locked to the centre and `StarterGui.Reticle` shows the sight.
  `CameraController:FreeCursor(reason, true)` frees it for menus; `Suspend(reason)` and
  `Resume(reason)` hand the camera to another view (Command View, cutscenes).
* Fallback: repeated errors stop the controller and give the camera to Roblox's, set to
  Invisicam in both places (`StarterPlayer.DevCameraOcclusionMode`); `EnableMouseLockOption` is
  off. StructureCheck checks both settings and the Reticle.

## The UI (both places)

Bible Section 18. The layout is real instances in StarterGui, built through the Studio
connector by `studio/ui/*.lua` (`python3 tools/ui_luau.py studio/ui/<Screen>.lua` prints the
Luau; send it with `execute_luau`, Edit) and then given Landon's AutoScale Lite pass. Code
never builds layout: it clones templates and sets text and images.

* `Shared.UIContract` lists every part of `StarterGui.Frame` and `StarterGui.HUD` the code
  uses. StructureCheck fails if one is missing, and also checks ScreenInsets
  CoreUISafeInsets, ResetOnSpawn off, ZIndexBehavior Sibling, Scale-only sizes, TextScaled
  text with a UITextSizeConstraint of at least 12, and no scripts inside a GUI.
* `Lib.UIKit` is generated from `ui/kit.json` by `tools/pack_ui.py` (the sprite table).
  `Lib.KitRuntime.Watch(gui)` keeps 9-slice corners, strokes and scroll bars in step with the
  screen height and runs the push-buttons (RectUp/RectDown/RectHover/RectDisabled attributes).
* `UIController` is The Frame: `Register(name, screen)`, `Open(name, args)`, `Close()`,
  `SetChips`, `SetMainAction`, `SetHint`, `SetFooterActions`, `Clone(template)`,
  `SetSprite`, `SetRarity`, `Clear`. A screen is a page (a clone of `Templates.Page`, or a page
  built for it under `Cabinet.Pages`) filling zones B, C and D; `Docked = true` is the Command
  View's mode (zone C shows the world). While a screen is open the cursor is free, gameplay
  input is blocked (`InputController:Block`) and the HUD hides (its alerts then show in the
  Frame's footer for a few seconds: `UIController:Notice`). Backspace or B closes; Enter or Y
  presses the main action; L1 and R1 switch tabs.
* `HUDController` fills the run HUD: the year flip counter, era, cycle dial, phase and time
  left, Ready (the SetReady remote), siren and Surge banners, health, the class and ability,
  stockpile chips, the hotbar's selection, the Command View button and the touch buttons
  (through `InputController:BindButton`; Roblox's jump button hides while ours shows).
  Landon's answers (2026-11-08): Ready has its own key, Z on PC and D-pad down on console (a
  key chip on the button); on PC a click of the mouse wheel frees the cursor for HUD buttons and
  the vote telegram, and another click locks it again; the stockpile chips show the
  EconomyService amounts (RunState), and the Copper and Crystal chips appear only once the team
  has dug into their bands. Server alerts (the `Alert` remote) go to the alert feed. For later
  systems: `Alert`, `Banner`, `SetVital`, `SetClass`, `SetResource`, `SetSlot`,
  `HotbarSelected`.
* `MiniMapController` draws the side-view mini-map around the player from the Cells and Rooms
  collections; `Blink(key, on)` for alerts.
* Changing a screen after Landon's AutoScale Lite pass: edit the instances in place (and the
  builder file to match), or rebuild and ask for the pass again. `studio/ui/patches/` holds
  such in-place patches.

## The Command View (Run place)

Bible Section 7. `CommandViewController` registers the screen `CommandView`: the Frame in
docked mode (`Cabinet.Pages.CommandView`, zone C open on the live bunker), opened and closed
by Tab, the View button, the HUD's Command View button, Backspace or B. The character stays
where it was, held by a ContextActionService sink (its movement keys and jump) with Roblox's
touch thumbstick and jump button hidden (`GuiService.TouchControlsEnabled`), and can be hit:
`DamageEdge` flashes when its health drops. Its arithmetic and build-menu rules are
`Shared.Rules.CommandView` (pure, data-tested); numbers in `Tuning.CommandView`.

* Camera: straight at the bunker from +Z, at most `MaxDistance` (440 studs) away. At the
  lowest graphics level Roblox stops drawing parts about 500 studs from the camera (measured in
  Studio, 2026-11-08: 500 drew, 525 didn't; level 2 draws about 800), so the camera never backs
  off past the cap: `Rules.CommandView.Lens(height)` keeps the narrow 8 degree field of view
  while it fits, then widens it (14 degrees at the opening 6 floors, 25 at the 11-floor limit).
  The view's centre sits in zone C's centre; it opens centred on the character with a 0.3 s
  move, and the close moves back and resumes CameraController. `FrontWall` parts hide while it
  is open; the lighting lifts (`Ambient`, `OutdoorAmbient`, `ExposureCompensation`).
* Input: drag or WASD/arrows to pan, the wheel or a pinch to zoom (1.5 to 11 floors), click or
  tap a cell; gamepad: left stick pans, right stick zooms, A picks the centre (`Cursor`).
  Picking casts from the camera through the point onto the cells' plane (`Grid.CellAt`).
* Detail panel (zone D): a room (condition, power, what it does; Upgrade, Merge with a
  matching neighbour, Tear Down), an open cell (the build menu: available rooms with costs,
  then locked ones and why, from `RoomChoice`; Fixed rooms are never listed), rock (whether it
  can be dug, the band's ore, the next band's Push Deeper). Choosing an option arms the main
  action ("Propose ..."), greyed until a system calls `SetHandler(action, fn)` for Build,
  Upgrade, Merge or TearDown (Prompt 8: votes).
* For later systems: `SetOverlay(name, provider)` (Power, Morale, Threat, Production: the
  provider returns a lamp sprite and a short reading per room, shown on the room label and the
  reading chip under it; the legend sits at the top of the panel; Power and Production are
  registered from the `Power` and `Production` collections, Prompt 9),
  `ShowGhost(id, floor, column, span, label)` / `HideGhost(id)` (votes), `Blink(roomId, on)`
  (breaches, disasters), `Select(floor, column)`, `IsOpen`, `Toggle`, `State`, and the
  `Selected` signal. Labels, marks and pings cover cell interiors (`Rules.CommandView.CellBox`).
* Pings: the footer's Ping button or G / D-pad up sends `PingCell(floor, column)`;
  `PingService` checks the session and the cell and fires `CellPinged(floor, column, userId,
  name)` to every ready player. The pin shows in the Command View and on the HUD mini-map for
  `Tuning.Ping.Seconds` (6).
* Landon (2026-11-08): no team list replaces Roblox's player list (it stays off in the run),
  and the widest view stays as built: about 5 columns by 8 floors, panning for the rest.
* With votes (Prompt 8): an open cell under construction shows UNDER CONSTRUCTION and its
  progress, a cell or room with an open vote shows the proposal and offers nothing else, rows
  the stockpile can't pay show what's short, the main action says Build (not Propose) in a solo
  run, and ghosts mark open proposals ("KITCHEN?") and sites ("KITCHEN 45%").

## Votes, construction, the economy and power (Run place)

Bible Sections 5, 6, 8, 13 and 23. Rules are pure modules the data tests hold to the bible:
`Shared.Rules.Votes` (outcomes, the 40% rule, what a vote needs),
`Shared.Rules.Construction` (costs, refunds, unlocks, reserved cells, construction time, a plan
for each proposal) and `Shared.Rules.Economy` (Section 13's output formula, power made and
drawn, steps along the room graph, the dark order, eating with carry).

* `EconomyService` keeps the team's stockpile:
  * every stocked resource in `Config.Resources` from its Start amount;
  * caps: Cap plus CapPerStorageCell for each Storage cell, times StockpileCaps modifiers;
  * Lab research, from 0.
  * Amounts replicate as RunState values (one per resource, plus Research).
  * API: `Spend(costs, reason)`, `Add(id, amount, reason)` (capped), `CanAfford`, `Get`, `Stock`,
    `Cap`, `AddResearch`.
* Production (Prompt 9): rooms make things all the time while the clock runs. A room's output
  per cycle comes from its crew, level, span, light and modifiers, spread over a 270 s cycle;
  whole units go into the stockpile and the fractions carry. Production is published per room
  in the `Production` collection: { Rate, Makes, Idle, Workers }.
* Consumption (Prompt 9): at each `CycleStarted` every eater takes 1 Food (times FoodUse) and 1
  Water; a shortfall alerts the team and fires `Shortfall`.
* Crews and eaters come from `SetResidents({ Crew, Eaters })` (ResidentService, Prompt 10);
  call `RefreshCrew()` on changes.
* Other API: `SetModifier(source, key, value?, room?)` for RoomOutput, AllOutput,
  StockpileCaps and FoodUse; `Rate(roomId)`.
* `PowerService` keeps the live power balance:
  * the Reactor Core and Generators make power from their crews (Landon: they need residents);
  * every room draws Power[level] per cell, except a wrecked one (0 HP), which draws nothing
    until it is repaired;
  * when the draw passes what is made, rooms go dark farthest first by steps from the nearest
    power room (dug cells count; unreachable rooms first; at the same distance the biggest
    draw, then the newest);
  * rooms that draw nothing never go dark.
  * It pushes the dark rooms to EconomyService (`SetPowered`), dims their lights to emergency
    red and dulls their Neon fittings (the room model's `Dark` attribute), alerts the team, and
    publishes RunState PowerMade, PowerUsed, PowerNeeded, DarkRooms and the `Power` collection:
    { Draw, Made, Dark, Steps }.
  * API: `IsDark(roomId)`, `Balance()`, `Refresh()`, `DarkChanged`.
* `VoteService` runs votes (`Open(spec)`: kind, proposer, title, costs, the ghost's subject, the
  cells it holds, a re-check, OnPass, OnFail). One vote is live at a time; later ones queue and
  each gets its full time. The proposer counts as a yes; abstaining is not voting; a vote can be
  changed until it closes; everyone yes passes at once; ties fail unless a tie-breaker (the
  Warden, Prompt 20: `SetTieBreaker`) passes them; spending more than 40% of a stock needs a
  majority of the whole team. One open proposal per player; a failed one means a 20 s cooldown.
  Solo runs skip the vote (checked again, applied at once). The `Votes` collection carries what
  the telegram shows; a closed vote stays `Tuning.Votes.ResultSeconds` (3) with its result.
* `BuildService` takes the `Propose` remote (action, floor, column, room type or the other
  room), plans it (`Rules.Construction.Plan`: the bunker's rules, unlocks, the stockpile, Lab
  research for level 3, cells held by open votes and sites) and opens a vote. On a pass it plans
  again, pays, and: Build starts a construction site (20 s a cell, 25% faster per player standing
  in it, `Sites` collection, `workspace.Bunker.Sites` drawn by `BunkerKit.Site`), then places the
  room; Upgrade (costs per cell, so a merged room pays for each cell), Merge and TearDown apply at
  once. Tearing down gives back half of what the room cost (`Construction.Refund`, Landon). On a
  difficulty with `UpgradesTakeTime` (Nightmare) an upgrade is a site over the room instead
  (Kind "Upgrade"; the room works at its old level until it's done). `Unlock(roomType)` for drafts
  and cryo pods (`Unlocked` collection). Signals: `Proposed`, `Built`, `TornDown`.
* `VoteController` (client) fills the vote telegram, `StarterGui.Votes` (its own ScreenGui at
  DisplayOrder 6, above The Frame, so a vote can be answered from any screen): what and its cost,
  then who, the tally and the time, the timer strip, YES and NO (your vote stays pressed in:
  `KitRuntime.SetLatched`). On a controller Y votes: a tap for yes, a hold for no (Landon). While
  your ballot is open, Y is bound above The Frame's main action (Y), so it votes from any screen;
  key chips on YES and NO show on a gamepad. It draws the Command View's ghosts, sends `Propose`
  from the Command View's main action, and plays `SoundService.VoteOpen` / `VotePassed` when they
  exist (Prompt 32).
* Remotes: `Propose`, `CastVote` (client to server, Run), `Alert` (server to client: a message
  for the HUD's alert feed).

## Residents (Run place)

Bible Sections 11 and 23, phase 1. `Shared.Rules.Residents` is pure: rolls, max health (Grit),
levels, morale states, a room's crew, the Auto-Assign matching, one cycle of needs.

* `ResidentService` owns the records:
  * the six founders at the start, idle (Landon: the team, or the first-run tutorial, gives
    them jobs); when the run starts the alert feed says how many are waiting for jobs;
  * jobs: `Assign(id, roomId?)`, `AutoAssign()`, and the `AssignResident` and `AutoAssign`
    remotes, with no vote;
  * the crew and eater source for EconomyService (`SetResidents`);
  * needs, XP and Medbay healing after each meal (`EconomyService.Ate`; the newest arrivals go
    hungry first); Surge morale;
  * death: down for 20 s, `Revive` with a stockpile Medkit (the `ReviveResident` remote and a
    prompt), then gone; the last one gone loses the run.
  * The `Residents` collection carries the records for the UI.
* `ResidentBrain` gives each resident a body (the A0 resident) in `workspace.Bunker.Residents`
  and runs the routine at 5 Hz:
  * the first 20 s of a day at a Kitchen seat, the rest at a work spot, the Surge in bed;
  * idle residents at a Lounge seat when there is a Lounge, otherwise by their bed;
  * down: lying with a revive prompt.
  * Bodies walk `Lib.PathGraph` routes (front aisles, doorways, Shaft stairs) with
    Humanoid:MoveTo and carry an `Activity` attribute. Residents don't collide with each other
    or players.
* `NPCAnimator` (client) plays `Config.Animations` clips for each body's Activity.
* `ResidentsController` (client): the Residents screen (Section 18), opened from the Command
  View's footer: tabs All, Working, Idle, Hurt; a resident card; Assign (the free job on their
  best stat) or Take off the job; the footer's Auto-Assign.
* The Command View lists a room's workers and the idle residents best at its job (Assign, Take
  off the job, Auto-Assign), and its Morale overlay reads the workers' average morale.

## Combat (Run place)

Bible Sections 9 and 23 (Prompt 11). `Shared.Rules.Combat` is pure: guns and melee weapons by
rarity, damage, fire intervals, pellets, the seeded spread, reloads, hit checks against position
history, cones and arcs, aim assist, combos, swing timing, stamina, the nearest respawn point.
The client predicts with it and the server checks with it.

* `CombatService` owns everyone who can be hurt:
  * `Register(model, spec)` for players (on spawn), residents' bodies (ResidentBrain) and
    monsters (Prompt 12; a dev dummy until then). Ids: `P<UserId>`, `N#`, `M#`.
  * Each combatant has a team, health, a reach and 1 s of positions at 20 Hz for the shot checks
    (Section 23: where the target was over the last 250 ms).
  * `Damage(id, amount, sourceId?, how?)`: no friendly fire, nothing during a dodge's
    invulnerable moment. A player's Humanoid never reaches 0 health: the lethal hit leaves it at
    1 and downs the player. All damage goes through here.
  * Players: Downed (20 s, crawling, a revive prompt for teammates), then Dead, then a respawn at
    the nearest working Medbay (not wrecked, not dark) or the Blast Door hall. The `Life`,
    `LifeEndsAt` and `InvulnerableUntil` attributes on the Player carry it. No natural
    regeneration.
  * Signals: `Damaged`, `Downed`, `Revived`, `Died`. Dead monsters dissolve.
* `WeaponService` owns what players carry and do:
  * the loadout (the class kit until Prompt 21): guns on hotbar slots 1 and 2, the tool on 3,
    throwables on 4 and 5, the melee weapon on its own button; the held item is a clone of its
    model welded to the hand at its Grip socket;
  * the remotes `SelectSlot`, `FireWeapon` (checked hits, then `HitConfirmed`), `ReloadWeapon`,
    `MeleeSwing`, `Dodge`, `Sprint`;
  * magazines, carried ammo and restocking at Workshop and Armory restock points (from the
    team's Ammo); Medkits restocked at the Medbay from the team's Medkits;
  * Landon's Prompt 11 answers: `UseMedkit` heals over `MedkitSeconds` (1.5 s, walking at
    `HealWalkMultiplier`; H, hold D-pad up, the Heal touch button), cancelled by being hit or
    swapping; `ThrowItem` throws the slot's throwable along an arc (Frag Grenade explodes, Flare
    lights, Foam Grenade puts out fire through `WeaponService.Foamed`, Shock Mine arms and stuns
    monsters through `StunnedUntil`); every class kit has a melee weapon;
  * stamina (sprint, dodge, heavy swings);
  * the Player attributes `Class`, `Slot`, `Item1` to `Item5`, `Mag1`, `Mag2`, `MeleeItem`,
    `CarriedAmmo`, `Stamina`, `ReloadEndsAt`, `ShotSalt`, `ShotNext`, `SwingEndsAt`.
* `CombatController` (client): input (fire, aim, reload, melee, dodge, sprint, the hotbar), the
  shot's feedback, recoil, aim assist on gamepad and touch, the roll, the HUD's hotbar and stamina
  gauge, hit and kill markers, damage numbers, health bars, the downed and out telegrams, the
  players' clips (`Config.Animations`).
* `PromptController` (client) draws every Custom-style ProximityPrompt from
  `HUD.Templates.Prompt` (the key's chip, the action, a hold gauge; on touch the plate is the
  button). Holding a revive prompt plays the kneel clip.
* `Lib.Movement` (client) works out one walk speed from several reasons (aiming, sprinting,
  crawling) on top of `StarterPlayer.CharacterWalkSpeed`.

## Threats and monsters (Run place)

Bible Section 10 (Prompt 12). `Shared.Rules.Threat` is pure: the threat level (year, deepest
floor, Disturbance, rooms and players, `Tuning.Threat`), Surge and trickle budgets (the
Tutorial Surge has its own; Boss and Final Surges spend nothing here; an account's first run in
Era I spends 70%), the era's roster (each era's new monsters up to now, never Surface-only),
groups bought from a budget (variety, group sizes), weighted breach picks and target order.

* `ThreatDirector` spends the budgets:
  * at each Surge: groups split into up to 4 waves `WaveSpacingSeconds` apart, at up to
    `MaxBreachPointsPerSurge` breach points, tagged `Surge:<cycle>`;
  * between Surges (the day, from cycle 2): single monsters when the trickle budget allows;
  * ends the Surge early (`CycleClock:EndSurge()`) once every wave is out, none of its monsters
    is left and no disaster holds it (`DisasterService:HoldsSurge`; `SetDisasterCheck` for tests);
  * pays for a Normal or Endless Surge's one disaster first (`DisasterService:SurgeDisaster`),
    and from the second day rolls a daily electrical surge (Prompt 13);
  * `ExtraBreach` and `Tremor` for Disturbance (Prompt 14); `RunState.Threat` and
    `RunState.Monsters` every second.
* `BreachService` owns breach points: room vents `V:<roomId>` (not the Shaft or the Blast Door;
  dark rooms weigh `DarkRoomWeight`, barricaded ones `BarricadeWeight`) and every dug cell at the
  rock edge, on any floor, `D:f,c` (Landon's Prompt 12 answer). `Open(point, groups, tag)` shows 10 s of dust and a pulsing
  red light, adds to the `Breaches` collection, sends `BreachWarning` to ready players, then
  spawns `SpawnSpacingSeconds` apart. Signal `Opened`.
* `MonsterService` owns monsters:
  * `Spawn(type, cframe, tag)` clones `ServerStorage.Assets.Monsters.<Asset>` (a graybox when
    missing), registers it with CombatService (team Monsters) and sets `Rig`, `MonsterType`,
    `Activity` and `AttackAt`; the server owns its physics; collision group Monsters. At most
    `MaxMonsters` (25) on the map, the rest queue; `Count(tag)` includes the queue.
  * The AI ticks every `MonsterAI.TickSeconds`: targets in the type's order (residents,
    machines, players who hit it, any player within `ProximityAggro` except Runners), walks the
    PathGraph (a stuck monster is moved on), attacks after a windup (the model's `HitTime`
    attribute, written from the generator's meta), damages rooms through `BunkerGrid:SetHP`
    (`RoomDamageMultiplier`, Brutes `SmashMultiplier`; a Reactor Core at 0 HP starts
    DisasterService's meltdown, Prompt 13), skips a target that rubble cuts off for a while
    (`Skip`) and plans again when `Lib.Hazards` changes,
    spits goo (`SlowedUntil`), latches ticks (a weld, bites every `AttackSeconds` ×
    `LatchIntervalMultiplier`), and obeys `StunnedUntil`.
  * Signals `Spawned` and `Died`; dev commands `monster`, `monsters`, `monsters.clear`.
* `ResidentBrain` (Prompt 12): residents near a monster flee to a safe room (no monster in or
  next to it) until `ResidentCalmSeconds` pass, swat a lone Burrow Tick, and walk slower while
  `SlowedUntil` lasts.
* `ThreatController` (client): the breach alert and mini-map blink, the Command View's Threat
  overlay (monsters, breach countdowns, likely dark rooms, vents) and the Slowed movement reason.
* `NPCAnimator` plays monsters' clips by `Rig:Activity` too (Attack replays on each
  `AttackAt`; Flee and Run fall back to Walk, Fight to Attack).
* Bosses are art and config so far (Prompt 15 fights the first): `Boss_BroodMother` in
  `ServerStorage.Assets.Bosses` has a `Belly` part with Role `WeakPoint` (raycasts hit it),
  sockets `Ovipositor`, `Maw` and `Slam`, `HitTime` 0.8 and `LayTime` 1.4, and seven clips in
  `Config.Animations` (Rig `BroodMother`); `Boss_BroodMother_EggSac` is what she lays.

## Disasters and repairs (Run place)

Bible Section 10, with Sections 5, 6 and 11 (Prompt 13). `Shared.Rules.Disasters` is pure: fire
growth, damage and spread targets (doorways on one floor; `Fireproof` rooms such as the Shaft
never burn), the Surge's pick (`SurgeWeight` disasters of the era and before that the budget
pays for), blackout floors and units, the valves (`ValveTurned`, `ValveReleased`, `ValvesOn`,
`MeltdownStopped`; solo players' turns last `SoloValveSeconds`, a team's while held), rubble HP,
dig times, damage and the passages it blocks, electrical surge odds and aftermath, repair rates.
The numbers are `Config.Disasters` and `Tuning.Disasters` / `Tuning.Repairs` (provisional).
`Shared.Rules.Modifiers.ClassValue(class, key, level?)` folds a class's passive modifiers
(ExtinguishSpeed, FireFloodDamageTaken, RepairSpeed; level 2 and 3 effects with Prompt 20).

* `DisasterService` owns every disaster and the `Disasters` collection (ids `F:<room>` fire,
  `B:<n>` blackout, `C:<n>` rubble, `M:<n>` meltdown, `S:<room>` electrical surge), RunState
  `Fires`, `BlackoutRooms`, `Rubble`, `Meltdown`, `MeltdownEndsAt`, `ValvesTurned`, and
  `workspace.Bunker.Disasters` (the fuse box, the valves, the rubble). It ticks every
  `TickSeconds` while the run is playing (also with the dev clock paused):
  * fires grow, burn rooms (`BunkerGrid:SetHP`), players (CombatService, the Firefighter a
    quarter) and residents, spread every `SpreadSeconds` (`SetModifier(source, "FireSpread",
    x)`), and go out under residents (ResidentBrain's Extinguish activity), the Extinguisher
    (`WeaponService.ToolTick`, the Firefighter 3x) and Foam Grenades (`WeaponService.Foamed`);
  * blackouts darken units through `PowerService:SetBlackout` until the fuse box in the Reactor
    Core is held for `FuseSeconds` or `DurationSeconds` pass (`BlackoutDuration` modifiers);
  * `CaveIn(floor, column, side?, cause)` drops rubble in a doorway or fills a dug cell: it
    blocks graph edges in `Lib.Hazards` (PathGraph routes round them or answers Blocked), hurts
    whoever is under it, shows `Kit_Rubble_Doorway` or `Kit_Rubble_Tunnel` (by the face's
    width; a filled tunnel's piles sit inside the tunnel) over an invisible block, and goes when
    a Drill or Pickaxe holder digs through (one hold) or melee smashes it (`WeaponService.Swung`;
    BreaksRubble weapons 3x); the pile sinks as it is hit;
  * a Reactor Core wrecked (`BunkerGrid.Wrecked`) starts the meltdown (`StartMeltdown`): a fire
    in the Reactor, the valves' prompts, `TimerSeconds` to turn all three; it ends Fixed, or
    Lost (`RunDirector:Lose("ReactorDestroyed")`);
  * electrical surges damage a room's machines until it is welded (`BuildService.Repaired`) or
    they expire into a fire or a floor blackout;
  * `SurgeDisaster(budget, rng)` buys the Surge's one disaster (started `SurgeDelaySeconds` in);
    `HoldsSurge()` keeps the Surge open while it, any fire or a meltdown is on.
  * Signals `Started` and `Ended`; dev commands `disasters`, `fire`, `fire.out`, `blackout`,
    `blackout.end`, `cavein`, `rubble.clear`, `meltdown`, `meltdown.stop`, `valve`, `esurge`,
    `disaster.surge`.
* Wrecked rooms (`Rules.Bunker`): a room at 0 HP is `Wrecked` (no output, power made or drawn,
  crew or machine target) until it is back to `RepairedAt` (25%) of its HP. `BunkerGrid` fires
  `Wrecked` and `Repaired` and applies HP modifiers (`SetHPModifier`, Reinforced Walls).
* Repairs (`BuildService`): the Welder held (`UseTool`) repairs the first damaged room ahead
  within `WelderReach` (`RepairSpeed`: the Engineer 2x); residents at work repair their own room
  by Smarts; `Repair(roomId, amount, how, player?)` and the `Repaired` signal; wreck and works
  again alerts; dev `repairs`, `repair`.
* `ResidentService:SetTrapped` and ResidentBrain: a resident whose route is Blocked waits,
  trapped (out of the crew), until the rubble goes; residents fight a fire where they stand
  until hurt below `ResidentFleeHealth`, then keep out of burning rooms.
* `WeaponService`: tools (`Kind = "Tool"`) are used by holding Fire (`UseTool` true/false); it
  fires `ToolTick` every `ToolTickSeconds` and sets the `ToolInUse` attribute; `Swung` for melee
  landings, `Foamed` for Foam Grenade bursts, `Items(player)`.
* `DisasterController` (client): flames, smoke, embers and light per burning cell, steam, surge
  sparks, the meltdown's alarm light, rubble dust, the tools' foam and sparks from the held
  model's Muzzle, the Welder's room HP bar, the HUD's Meltdown telegram and valve plates, the dig
  prompt shown only to Drill and Pickaxe holders, statuses and blinking in the Command View and
  on the mini-map (`CommandViewController:SetStatus`, `SetConditionNote`), and the named sounds
  once Prompt 32 adds them.
* Art: `Tool_Extinguisher` and `Tool_Welder` in `ServerStorage.Assets.Weapons` (Grip and Muzzle
  sockets), `Kit_Rubble_Doorway` and `Kit_Rubble_Tunnel` in `ServerStorage.Assets.Kit`, their
  icons in the items atlas.

## Digging, Disturbance and Push Deeper (Run place)

Bible Sections 6, 7, 10 and 14 (Prompt 14). `Shared.Rules.Dig` is pure: the faces a rock cell
is dug from (`Faces`: left, right or from the cell above) and where their prompts stand
(`FacePoint`), dig seconds by band (`Config.DepthBands`), stacking (`Rate`: the Driller's
`DigSpeed` 2), the Drill Bay's speed (`DrillBaySpeed`: `ResidentDigMultiplier` of a player per
unit of crew output), Push Deeper (`StartLimit` 3, `LimitAfter` the band's last floor,
`NeedsVote`), the roll (`Roll(seed, floor, column, era, available)`: the same for a cell all run,
results whose systems don't exist yet count as Empty; `Hint` for the Driller's eye; `Depth` into
rock), and Disturbance (`AddDisturbance`, `Crossed`: the extra breach and the Tremor,
`AfterTremor`, `Level` CALM, RISING, UNSETTLED, DANGER). `Shared.Rules.Loot` rolls
`Config.LootTables` (`BandOre` lines, skipped specials, `OreMultiplier`; `Text` for alerts). The
numbers are `Tuning.Digging` and `Tuning.Disturbance` (provisional).

* `DigService` owns digging and the `Digs` collection (`S:<floor>,<column>` a cell being dug or
  queued: Progress, Diggers, Queue, Bay, Vote; `F:<floor>,<column>` what a dug cell holds:
  CaveOpening, Cache or Nest), RunState `Disturbance`, `DigLimit`, `DigSeed`, `TremorAt`,
  `Nests`, and `workspace.Bunker.Digging` (the dig prompts, the Command View's markers, the
  features' models). It ticks every `TickSeconds` while the run is playing:
  * a dig prompt (Kind `DigCell`, attributes `Cell` and `Progress`) at every face of every
    diggable rock cell; `PromptButtonHoldBegan` adds the player as a digger if they carry a Drill
    or a Pickaxe (`WeaponService:Items`), `HoldEnded` takes them off; diggers must stay alive,
    armed and near; progress stays when they let go;
  * the Drill Bay digs the first diggable queued cell (`Mark(floor, column, on, player)`, the
    `MarkDig` remote, up to 12) at the summed speed of every working Drill Bay
    (`EconomyService:Rate`);
  * past `DigLimit` a hold opens a Push Deeper vote (`VoteService:Open`, Kind `PushDeeper`; solo
    applies at once); a pass moves `DigLimit` to the band's last floor, a failure waits
    `VoteRetrySeconds`;
  * a cell that opens (`BunkerGrid:Dig`) adds `DisturbancePerCell` (the Driller's level 3
    `DigDisturbance`, `SetModifier(source, "DigDisturbance", x)`), applies its roll, announces it,
    fires `Dug(floor, column, result, cause)`, and caves in the passage it was dug through
    `CaveInChance` of the time (`DisasterService:CaveIn`, sideways digs only);
  * results: an ore pocket pays band ore into the stockpile (`DugOre`); a cave opening shows
    `Kit_CaveMouth` 2 studs off the back wall and adds a breach point
    (`BreachService:SetExtraPoint`, Kind `Cave`); a cache shows `Prop_SupplyCrate` with an
    `OpenCache` prompt (resources to the stockpile, throwables to the opener's hotbar through
    `WeaponService:GiveThrowable`; gear and radio logs skipped until their prompts); a nest shows
    `Prop_Nest`, registers it with CombatService as a monster (an ordinary `M<n>` id, so
    FireWeapon accepts hits), adds a breach point (Kind `Nest`) and pours out
    `ThreatDirector:Burst(NestBudget)`; destroyed (`CombatService.Died`), it pays Loot `Nest` and
    drops Disturbance by `NestDestroyed`;
  * nothing is built on a feature's cell (`BuildService:SetCellCheck`);
  * Disturbance: explosions (`WeaponService.Exploded`) add `Explosive`; each new cycle living
    nests add `NestPerCycle` each and it falls `DecayPerCycle`; crossing `ExtraBreachAt` calls
    `ThreatDirector:ExtraBreach()`, reaching `TremorAt` calls `ThreatDirector:Tremor()`, caves in
    a doorway near the deepest floor, sets `TremorAt` and drops to `AfterTremor`;
  * API `Disturbance()`, `AddDisturbance(amount, source)`, `DigNow(floor, column, cause,
    player?)`, `Mark`, `SetModifier`, `Feature(floor, column)`; dev commands `digs`, `dig`,
    `dig.roll`, `dig.mark`, `disturbance`, `disturbance.add`, `tremor`, `pushdeeper`, `nest`,
    `cache`, `cave`.
* `ThreatDirector`: `Burst(fraction, at, tag)` spawns monsters at once at a spot; `ExtraBreach`
  and `Tremor` are priced as a quarter and a whole of a normal Surge's budget (the first run's
  Era I easing applies). `BreachService:SetExtraPoint(id, point?)` adds points other services
  own. `WeaponService`: `Exploded(position, radius, player)`, `GiveThrowable(player, item,
  count)`. `BuildService:SetCellCheck(fn)`.
* `DigController` (client): shows the dig prompts only to Drill and Pickaxe carriers; dust and
  chips at the faces of cells being dug and a burst when a cell opens; the camera shake at a
  Tremor (`CameraController:Shake`); the Command View's rock notes (dig time, progress, queue
  place, Push Deeper, the Driller's eye from `DigSeed` and `OreSightCells`), dug cells' notes
  (cave opening, cache, nest) and the queue options (`CommandViewController:SetCellNotes`,
  `SetRockOptions`, choices `MarkDig` and `UnmarkDig`, never voted).
* `HUDController`: the Disturbance seismograph (the level word and colour, a trace that swings
  harder as it rises, blinking at DANGER, a jump at a Tremor). `PromptController`: a prompt's
  `Progress` attribute drives its gauge (shared progress).
* Art: `Tool_Drill` and `Weapon_Pickaxe` in `ServerStorage.Assets.Weapons`, `Prop_Nest` in
  `Props`, `Kit_CaveMouth` in `Kit`, their icons in the items atlas.

## Saved data

One profile per player (bible Section 23), shape and migrations in `Lib.ProfileSchema`, I/O in
`ProfileService`. The stored record is `{ Data, Lock, Meta }` in the `PlayerProfiles` DataStore
(`PlayerProfiles_Studio` in Studio, so tests never touch live saves), key `Player_<userId>`.

* Load claims the lock through UpdateAsync. A fresh lock from another server: wait and retry
  (8 tries, 2 s apart), then kick with a message. A stale lock (3 autosaves old; 30 s in
  Studio): taken over. A newer version: refused, nothing written. Then migrate, reconcile,
  validate; a failure kicks the player and writes nothing.
* Saves: every 120 s (staggered; refreshes the lock), on leaving (releases it) and on
  shutdown (BindToClose waits for every release). A save writes only if this server still
  holds the lock and the profile validates; losing the lock kicks the player.
* Gameplay calls `ProfileService:Update(player, fn)` (undone if it errors or leaves the profile
  invalid), `AddGlowshards`, `SpendGlowshards`, and `GrantPurchase(player, receiptId, grant)`
  for ProcessReceipt: grant, record the receipt, save, then report granted; a repeated
  receipt is never granted twice.
* The player's client reads its own profile (minus receipts) from the `Profiles` collection.
* A session isn't ready until its profile loads (SessionService gate `Profile`).
* Changing the shape: raise `ProfileSchema.VERSION`, add a migration, update `Default` and the
  shape. Old servers refuse newer saves, so a rolling update can't corrupt them.

## Content

All content is data in `Shared.Config` (bible Section 23). Each content type is a child
ModuleScript returning `{ Schema = Check.shape(...), Entries = { Id = entry }, Order = {...}? }`
(or `Schemas`, one checker per entry, for Tuning). Config validates every entry at load
(fields, ids, `Check.ref` cross-references), freezes it and adds `Id`. Read with
`Config.Get(type, id)` (errors if missing), `Config.Find` (for ids from players or saves),
`Config.All(type)`, `Config.Ids(type)`. Problems are listed by `Config.Errors()`, logged, and
fail StructureCheck and the data tests. `Config._Fields` holds checkers the content modules
share (modules starting with `_` are helpers, not types).

Content types (Prompt 1): Badges, Bosses, Classes, Conditions, DepthBands, DigResults,
Difficulties, Disasters, DraftCards, Eras, GamePasses, GlowshardPacks, GlowshardRewards,
ItemRarities, Items, Leaderboards, Legends, LootTables, Modifiers, MoraleStates, Monsters,
Objectives, Quests, Recipes, ResidentNames, Resources, Rooms, Stats, SurfaceLocations,
TalentSlots, TeamBoosts, Tiers, Traits, Tuning, Votes, WandererOutcomes.

**Effects are data.** Classes, traits, Legends, draft cards and passes describe what they do
as modifiers: `{ Key = "RoomOutput", Value = 1.25, Room = "Medbay", Scope = "Bunker" }`.
`Config.Modifiers` is the vocabulary: each key's unit (Multiplier, Add, Set, Flag, Chance),
default scope, and the prompt whose system applies it. A system reads the keys it owns; a new
effect is a new key plus the code that honours it.

**Rule numbers** live in `Config.Tuning`, one entry per system (Clock, Grid, StartingBunker,
Rooms, Votes, Player, Digging, Disturbance, Threat, Residents, Aging, Morale, Trader,
Wanderers, Expeditions, Surface, Legends, ClassShop, Account, Lobby).

## DevTools

* `/dev <command>` in chat for allowed players (everyone in Studio; outside Studio only the
  admins in `Constants.ADMIN_USER_IDS`); `/dev help` lists commands. Services add their own
  in `Init` with `DevService:Register`.
* In a Studio playtest: `ServerScriptService.DevTools.Invoke:Invoke("test")` on the server,
  `PlayerScripts.DevInvoke:Invoke("replica Rooms")` on a client.
* `structure`: StructureCheck. `test [filter]`: DataTests. Both run once whenever a Studio
  playtest starts (set the `RunChecksOnStart` attribute on DevTools to false to stop that).
* Other built-ins: `version`, `ping`, `players`, `remotes`, `log [level]`, `logs [count]`,
  `rep`, `rep.selftest`; on the client `replica <collection>`, `client`, `clock`,
  `ready [true|false]` (fires SetReady like the HUD button), `camera`, `camera.shoulder`,
  `camera.aim [bool]`, `camera.look <yaw> <pitch>`, `camera.zoom <studs>`, `camera.cursor`,
  `ui`, `ui.sample`, `ui.list`, `ui.dock`, `ui.open <screen>`, `ui.close`, `ui.tab <id>`,
  `ui.main`, `hud`, `hud.alert <Danger|Warning|Info> <text>`, `hud.banner <text>`,
  `hud.slot <n>`, `hud.touch [bool]`, `cv` (the Command View's state and options), `cv.open`,
  `cv.close`, `cv.select <floor> <column>`, `cv.ping`, `cv.ghost <floor> <column> <span>
  [label]`, `cv.unghost`, `cv.blink <roomId> [false]`, `cv.overlay <name> [false]` (a sample
  reading for screenshots).
* The bunker (Run place): `grid` (map), `grid.rooms`, `grid.graph`, `grid.dig <floor> <column>`,
  `grid.build <Type> <floor> <column> [span] [level]`, `grid.remove <id>`, `grid.merge <id> <id>`,
  `grid.level <id> <level>`, `grid.rebuild`, `grid.sockets <id>`, `grid.art`.
* The run (Run place): `run`, `run.skipintro`, `run.win <century|deep>`,
  `run.lose <reactor|residents>`, `run.keepgoing`; `clock`, `clock.speed <x>`, `clock.pause`,
  `clock.resume`, `clock.next`, `clock.clear`, `boss.beat [bossId]`, `year <n>`,
  `ready.all [bool]`, `rest.all [bool]`; `objectives`, `objective <id>`; `cell.ping <floor>
  <column>` (pings as the first player).
* Votes and construction (Run place): `stock`, `stock.set <resource> <n>`, `stock.add
  <resource> <n>`, `research [n]`; `votes`, `vote.yes [n]`, `vote.no [n]` (as you, or as pretend
  voter n), `vote.end` (time is up now), `vote.test [title]` (a vote with no proposer and no
  effect), `vote.bots <n> [yes|no|abstain]` (Studio: pretend voters join the team); `build
  <Build|Upgrade|Merge|TearDown> <floor> <column> [roomType|otherRoomId]`, `sites`,
  `site.finish [id]`, `unlock <roomType>`. From Studio's server tools, `build` and `vote.yes|no`
  act as the first player in the run. On the client, `vote` prints the telegram and the ghosts.
* Residents (Run place): `residents`, `residents.auto`, `residents.add [count] [tier] [level]`,
  `resident.assign <id> <roomId|none>`, `resident.hurt <id> <amount>`, `resident.revive <id>`,
  `resident.set <id> <health|rest|morale|xp|stat> <value>`, `brains` (where each body is going).
* The economy and power (Run place): `production` (every room's rate and why idle rooms are
  idle), `staff <roomId|roomType> <statSum> [workers] [morale]` and `staff.clear` (Studio: pretend
  crews until residents arrive), `eaters <n>` (pretend eaters), `eat` (the start-of-cycle meal
  now), `power` (the balance, steps and dark rooms), `run.difficulty <Normal|Hard|Nightmare>`.
* `ServerStorage.NS_Pipeline` (an outside Night Shift importer plugin's empty working folder,
  which Landon can't remove) is only a StructureCheck warning; scripts inside it would be an
  error.

## Conventions

* `--!strict` in every file. Tabs. PascalCase for modules, types, methods and content ids;
  camelCase for locals. Content ids: letters, digits and `_`, starting with a letter.
* Logging through `Utilities.Log` (`Log.new("Tag")`), never bare `print`.
* Tunables are content (Config); identity and engine limits are `Constants`.
* Every prompt ends with Design Notes and a Delivery Report in `game/reports/`.

