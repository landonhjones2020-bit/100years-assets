						{ -31.003, 7.69, -108.795, 0.017, 0.967, -0.244, 0.066, 35.475 }, { -31.107, 7.693, -108.759, 0.017, 0.967, -0.244, 0.068, 35.386 }, { -31.214, 7.697, -108.719, 0.018, 0.967, -0.244, 0.069, 35.289 },
