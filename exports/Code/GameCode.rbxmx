		CrystalColossusStagger = { Rig = "CrystalColossus", Activity = "Stagger", AssetId = "rbxassetid://103101122241503", Looped = false,
			Text = "Down on one knee on its club, head hanging, 3.5 s (A10, CrystalColossus_Stagger)" },
