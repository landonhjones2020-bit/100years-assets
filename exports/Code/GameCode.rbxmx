-- The only scripts: everything else is a ModuleScript (bible Section 23).
local ENTRY_SCRIPTS: { [string]: string } = {
	["ServerScriptService.Bootstrap"] = "Script",
	["StarterPlayer.StarterPlayerScripts.ClientBootstrap"] = "LocalScript",
}

-- Roblox's own player and character scripts, which it inserts under StarterPlayer when a
-- playtest starts (PlayerModule also carries InputSetup and ServerAuthority scripts).
local ROBLOX_DEFAULTS: { [string]: boolean } = {
	PlayerModule = true,
	PlayerScriptsLoader = true,
	RbxCharacterSounds = true,
	Animate = true,
	Health = true,
}

-- Scripts inside a player's character (Roblox copies Animate and Health into it).
local function inCharacter(instance: Instance): boolean
	local players = game:GetService("Players")
	local model = instance:FindFirstAncestorOfClass("Model")
	while model do
		if players:GetPlayerFromCharacter(model) then
			return true
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function isRobloxDefault(instance: Instance): boolean
	local node: Instance? = instance
	while node and node.Parent ~= game do
		if ROBLOX_DEFAULTS[node.Name] then
			return node:FindFirstAncestorOfClass("StarterPlayer") ~= nil
		end
		node = node.Parent
	end
	return false
end

local SCRIPT_ROOTS = {
	"Workspace",
	"ReplicatedFirst",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Lighting",
	"SoundService",
}

local function find(path: string): Instance?
	local node: Instance? = game
	for segment in string.gmatch(path, "[^%.]+") do
		if node == game then
			local ok, service = pcall(game.GetService, game, segment)
			node = if ok then service else nil
		else
			node = (node :: Instance):FindFirstChild(segment)
		end
		if not node then
			return nil
		end
	end
	return node
end

local function pathOf(instance: Instance): string
	return instance:GetFullName()
end

-- An art-pipeline sample (A0_Showroom, A0_HUD...): allowed until gameplay replaces it.
local function isSample(instance: Instance): boolean
	local node: Instance? = instance
	while node and node ~= game do
		if string.sub(node.Name, 1, 3) == "A0_" then
			return true
		end
		node = node.Parent
	end
	return false
end

local function fnv1a(text: string): string
	local hash = 2166136261
	for index = 1, #text do
		hash = bit32.bxor(hash, string.byte(text, index))
		hash = (bit32.lshift(hash, 24) + hash * 403) % 4294967296
	end
	return string.format("%08x", hash)
end

local StructureCheck = {}

StructureCheck.Hash = fnv1a

function StructureCheck.Run(options: Options?): Result
	local runtime = options ~= nil and options.Runtime == true
	local sources = options ~= nil and options.Sources == true
	local result: Result = { Errors = {}, Warnings = {}, Passed = 0, Notes = {} }
	local function pass()
		result.Passed += 1
	end
	local function fail(message: string)
		table.insert(result.Errors, message)
	end
	local function warnOf(message: string)
		table.insert(result.Warnings, message)
	end

	-- 1. The skeleton (shared, then this place's own)
	local placeKind: string? = nil
	do
		local constantsModule = find("ReplicatedStorage.Shared.Constants")
		if constantsModule and constantsModule:IsA("ModuleScript") then
			local ok, kind = pcall((require(constantsModule) :: any).PlaceKind)
			placeKind = if ok then kind else nil
		end
	end
	local skeleton = table.clone(SKELETON)
	for _, item in (if placeKind then PLACE_SKELETON[placeKind] else nil) or {} do
		table.insert(skeleton, item)
	end
	for _, item in skeleton do
		local path, className = item[1], item[2]
		local found = find(path)
		if not found then
			fail(`missing {path} ({className})`)
		elseif found.ClassName ~= className then
			fail(`{path} is a {found.ClassName}, should be a {className}`)
		else
			pass()
		end
	end
	for kind, items in PLACE_SKELETON do
		if kind ~= placeKind then
			for _, item in items do
				if find(item[1]) then
					fail(`{item[1]} belongs to the {kind} place only`)
				end
			end
		end
	end

	-- 2. Every installed file, and (from a plugin) whether it was edited after install
	local buildInfo: any = nil
	local buildModule = find("ReplicatedStorage.Shared.BuildInfo")
	if buildModule and buildModule:IsA("ModuleScript") then
		local ok, info = pcall(require, buildModule)
		if ok and type(info) == "table" and type(info.Files) == "table" then
			buildInfo = info
			pass()
		else
			fail("BuildInfo doesn't load or has no Files")
		end
	end
	if buildInfo then
		table.insert(result.Notes, `build {buildInfo.Label}`)
		for path, file in buildInfo.Files do
			local found = find(path)
			if not found then
				fail(`installed file missing: {path} ({file.Class})`)
			elseif found.ClassName ~= file.Class then
				fail(`{path} is a {found.ClassName}, installed as a {file.Class}`)
			else
				pass()
				if sources and found:IsA("LuaSourceContainer") then
					local ok, source = pcall(function()
						return (found :: any).Source
					end)
					if ok and fnv1a(source) ~= file.Hash then
						warnOf(`{path} was edited in Studio after install (the repo copy differs)`)
					end
				end
			end
		end
	end

	-- 3. Services: names, shape and a dependency order with no cycle
	local servicesFolder = find("ServerScriptService.Services")
	if servicesFolder then
		local Loader = require(ReplicatedStorage.Shared.Utilities.Loader) :: any
		local ok, modules = pcall(Loader.Collect, servicesFolder, "Service")
		if not ok then
			fail(tostring(modules))
		else
			local order, problem = Loader.Order(modules)
			if order then
				pass()
				table.insert(result.Notes, `services: {table.concat(order, ", ")}`)
			else
				fail(`services: {problem}`)
			end
		end
		for _, child in servicesFolder:GetChildren() do
			if not child:IsA("ModuleScript") then
				warnOf(`{pathOf(child)}: only ModuleScripts belong in Services`)
			end
		end
	end
	local controllers = find("StarterPlayer.StarterPlayerScripts.Controllers")
	if controllers then
		for _, child in controllers:GetChildren() do
			if not child:IsA("ModuleScript") then
				warnOf(`{pathOf(child)}: only ModuleScripts belong in Controllers`)
			else
				pass()
			end
		end
	end

	-- 4. Stray scripts: only the two bootstraps run code
	local samples = 0
	for _, rootName in SCRIPT_ROOTS do
		local ok, root = pcall(game.GetService, game, rootName)
		if not ok then
			continue
		end
		for _, descendant in (root :: Instance):GetDescendants() do
			if not descendant:IsA("BaseScript") then
				continue
			end
			local path = pathOf(descendant)
			if ENTRY_SCRIPTS[path] == descendant.ClassName then
				pass()
			elseif isSample(descendant) then
				samples += 1
			elseif isRobloxDefault(descendant) or inCharacter(descendant) then
				continue
			else
				warnOf(`stray {descendant.ClassName} {path}: only Bootstrap and ClientBootstrap are scripts; make it a module`)
			end
		end
	end
	if samples > 0 then
		table.insert(result.Notes, `{samples} script(s) in A0_ art samples (allowed until gameplay replaces them)`)
	end

	-- 5. Remotes: only the ones Shared.Remotes defines
	local remotesModule = find("ReplicatedStorage.Shared.Remotes")
	for _, rootName in { "ReplicatedStorage", "Workspace", "ReplicatedFirst" } do
		local root = game:GetService(rootName :: any) :: Instance
		for _, descendant in root:GetDescendants() do
			if
				(descendant:IsA("RemoteEvent") or descendant:IsA("RemoteFunction") or descendant:IsA("UnreliableRemoteEvent"))
				and descendant.Parent ~= remotesModule
			then
				warnOf(`stray remote {pathOf(descendant)}: add it to Shared.Remotes instead`)
			end
		end
	end
	if runtime and remotesModule then
		local Remotes = require(remotesModule :: ModuleScript) :: any
		for name, definition in Remotes.Definitions do
			local found = remotesModule:FindFirstChild(name)
			local className = if definition.Unreliable then "UnreliableRemoteEvent" else "RemoteEvent"
			if not Remotes.InPlace(name) then
				if found then
					fail(`remote {name} exists, but it belongs to the {definition.Place} place only`)
				else
					pass()
				end
			elseif not found then
				fail(`remote {name} wasn't created`)
			elseif found.ClassName ~= className then
				fail(`remote {name} is a {found.ClassName}, should be a {className}`)
			else
				pass()
			end
		end
		for _, child in remotesModule:GetChildren() do
			if Remotes.Definitions[child.Name] == nil then
				warnOf(`unknown remote {child.Name} under Shared.Remotes`)
			end
		end
	end

	-- 6. Config data
	local configModule = find("ReplicatedStorage.Shared.Config")
	if configModule and configModule:IsA("ModuleScript") then
		local ok, Config = pcall(require, configModule)
		if not ok then
			fail(`Config doesn't load: {Config}`)
		else
			local errors = (Config :: any).Errors()
			if #errors == 0 then
				pass()
				table.insert(result.Notes, `config types: {#(Config :: any).Types()}`)
			end
			for _, problem in errors do
				fail(`config: {problem}`)
			end
		end
	end

	-- 7. Place identity
	local constantsModule = find("ReplicatedStorage.Shared.Constants")
	if constantsModule and constantsModule:IsA("ModuleScript") then
		local Constants = require(constantsModule) :: any
		local ok, kind = pcall(Constants.PlaceKind)
		if not ok then
			fail(tostring(kind))
		else
			pass()
			table.insert(result.Notes, `place {kind} ({game.PlaceId})`)
			local attribute = workspace:GetAttribute("PlaceKind")
			if attribute ~= nil and attribute ~= kind then
				fail(`Workspace PlaceKind says {attribute} but this is {kind}`)
			end
			if buildInfo and buildInfo.Place ~= kind then
				fail(`installed build is for {buildInfo.Place}, but this place is {kind}`)
			end
		end
	end

	-- 8. Leftovers. ServerStorage.NS_Pipeline is the working folder of an outside Studio plugin
	-- (the Night Shift importer) that Landon can't remove (2026-11-08: not in Manage Plugins, its
	-- file deleted). It holds an empty Jobs folder and MeshCache, so it is only a warning; scripts
	-- inside it would be an error.
	local leftover = ServerStorage:FindFirstChild("NS_Pipeline")
	if leftover then
		local scripts = 0
		for _, item in leftover:GetDescendants() do
			if item:IsA("LuaSourceContainer") then
				scripts += 1
			end
		end
		if scripts > 0 then
			fail(`ServerStorage.NS_Pipeline (an outside plugin's folder) holds {scripts} script(s): delete it`)
		else
			warnOf("ServerStorage.NS_Pipeline is back (an outside Studio plugin's empty working folder; harmless)")
		end
	else
		pass()
	end

	-- 8b. Place settings the camera relies on (Prompt 5): Roblox's shift lock off (the camera
	-- locks the mouse itself) and Invisicam for Roblox's camera, the fallback
	local StarterPlayer = game:GetService("StarterPlayer")
	if StarterPlayer.EnableMouseLockOption then
		fail("StarterPlayer.EnableMouseLockOption must be off: the over-the-shoulder camera locks the mouse itself")
	else
		pass()
	end
	if StarterPlayer.DevCameraOcclusionMode ~= Enum.DevCameraOcclusionMode.Invisicam then
		fail("StarterPlayer.DevCameraOcclusionMode must be Invisicam (the camera's fallback, bible Section 9)")
	else
		pass()
	end

	-- 8c. The UI layout (bible Section 18, Prompt 6): the Frame (both places) and the HUD (Run)
	-- exist with every part the code uses (Shared.UIContract), ScreenGui settings per rule 7,
	-- Scale-only sizes, text that scales and never drops below 12, and no scripts inside
	local contractModule = find("ReplicatedStorage.Shared.UIContract")
	if contractModule and contractModule:IsA("ModuleScript") then
		local UIContract = require(contractModule) :: any
		local StarterGui = game:GetService("StarterGui")
		for screenName, screen in UIContract.Screens do
			local wanted = placeKind ~= nil and table.find(screen.Places, placeKind) ~= nil
			local gui = StarterGui:FindFirstChild(screenName)
			if not wanted then
				if gui then
					fail(`StarterGui.{screenName} belongs to the {table.concat(screen.Places, " and ")} place only`)
				end
				continue
			end
			if not gui or not gui:IsA("ScreenGui") then
				fail(`missing StarterGui.{screenName} (ScreenGui): build it with tools/ui_luau.py studio/ui/{screenName}.lua`)
				continue
			end
			pass()
			if
				gui.ResetOnSpawn
				or gui.ZIndexBehavior ~= Enum.ZIndexBehavior.Sibling
				or gui.ScreenInsets ~= Enum.ScreenInsets.CoreUISafeInsets
			then
				fail(`StarterGui.{screenName} needs ScreenInsets CoreUISafeInsets, ResetOnSpawn off and ZIndexBehavior Sibling (bible Section 18)`)
			else
				pass()
			end
			if gui.DisplayOrder ~= screen.DisplayOrder then
				warnOf(`StarterGui.{screenName} DisplayOrder is {gui.DisplayOrder}, expected {screen.DisplayOrder}`)
			end
			local missing = {}
			for _, path in screen.Paths do
				if UIContract.Find(gui, path) then
					pass()
				else
					table.insert(missing, path)
				end
			end
			if #missing > 0 then
				fail(`StarterGui.{screenName} lacks {#missing} part(s) the code uses: {table.concat(missing, ", ", 1, math.min(#missing, 6))}`)
			end
			local offsets, unreadable, scripts = 0, 0, 0
			for _, item in gui:GetDescendants() do
				if item:IsA("GuiObject") then
					local size, position = item.Size, item.Position
					if size.X.Offset ~= 0 or size.Y.Offset ~= 0 or position.X.Offset ~= 0 or position.Y.Offset ~= 0 then
						offsets += 1
					end
				end
				if item:IsA("TextLabel") or item:IsA("TextButton") or item:IsA("TextBox") then
					local limit = item:FindFirstChildOfClass("UITextSizeConstraint")
					if not (item :: any).TextScaled or not limit or limit.MinTextSize < 12 then
						unreadable += 1
					end
				end
				if item:IsA("BaseScript") then
					scripts += 1
				end
			end
			if offsets > 0 then
				fail(`StarterGui.{screenName}: {offsets} element(s) use pixel offsets; all UI is Scale (bible Section 18)`)
			else
				pass()
			end
			if unreadable > 0 then
				fail(`StarterGui.{screenName}: {unreadable} text element(s) without TextScaled and a UITextSizeConstraint of at least 12`)
			else
				pass()
			end
			if scripts > 0 then
				fail(`StarterGui.{screenName} holds {scripts} script(s); the game code drives the UI`)
			else
				pass()
			end
		end
	end

	-- 9. The architecture document
	local doc = find("ServerStorage.Documentation.ARCHITECTURE")
	if doc and doc:IsA("ModuleScript") then
		local ok, text = pcall(require, doc)
		if ok and type(text) == "string" and #text > 200 then
			pass()
		else
			fail("Documentation.ARCHITECTURE must return the document text")
		end
	end

	-- 10. The boot result
	if runtime then
		if ReplicatedStorage:GetAttribute("ServerReady") == true then
			pass()
		else
			fail("ServerReady isn't set: Bootstrap didn't finish")
		end
		local broken = ReplicatedStorage:GetAttribute("ServerBroken")
		if broken then
			fail(`services that failed to start: {broken}`)
		end
		local DevTools = ServerScriptService:FindFirstChild("DevTools")
		if DevTools and not DevTools:FindFirstChild("Invoke") and game:GetService("RunService"):IsStudio() then
			warnOf("DevTools.Invoke wasn't created (DevService didn't start?)")
		end
		-- The run's replicated values (Run place): set, and each one allowed
		local runStateModule = find("ReplicatedStorage.Shared.RunState")
		if placeKind == "Run" and runStateModule and runStateModule:IsA("ModuleScript") then
			local RunState = require(runStateModule) :: any
			if RunState.Get("RunPhase") == nil then
				fail("RunState.RunPhase isn't set: RunDirector didn't start")
			else
				pass()
			end
			for name, value in runStateModule:GetAttributes() do
				local ok, why = RunState.Check(name, value)
				if ok then
					pass()
				else
					fail(`RunState: {why}`)
				end
			end
		end
		-- The bunker's world (Run place): BunkerGrid built it
		if placeKind == "Run" then
			local bunker = workspace:FindFirstChild("Bunker")
			if not bunker then
				fail("workspace.Bunker is missing: BunkerGrid didn't build the bunker")
			else
				for _, name in { "Frame", "Rock", "Dug", "Rooms" } do
					if bunker:FindFirstChild(name) then
						pass()
					else
						fail(`workspace.Bunker.{name} is missing`)
					end
				end
				local rooms = bunker:FindFirstChild("Rooms")
				if rooms and #rooms:GetChildren() == 0 then
					fail("workspace.Bunker.Rooms is empty")
				end
				-- Every room carries its gameplay points; the art kit, when the place has it,
				-- built every room; the Medbay has the spawn and the Blast Door its exit.
				local ServerStorage = game:GetService("ServerStorage")
				local assets = ServerStorage:FindFirstChild("Assets")
				local kit = assets and assets:FindFirstChild("Kit")
				local hasArt = kit ~= nil and kit:FindFirstChild("Kit_Floor") ~= nil
				for _, room in if rooms then rooms:GetChildren() else {} do
					local kind = room:GetAttribute("RoomType")
					local sockets = room:FindFirstChild("Sockets")
					if sockets and sockets:IsA("BasePart") then
						pass()
					else
						fail(`room {room.Name} ({kind}) has no Sockets part`)
					end
					if hasArt and room:GetAttribute("Art") ~= true then
						fail(`room {room.Name} ({kind}) was built from the graybox although the art kit is in ServerStorage.Assets`)
					elseif hasArt then
						pass()
					end
					if kind == "Medbay" then
						if room:FindFirstChild("MedbaySpawn") then
							pass()
						else
							fail(`Medbay {room.Name} has no MedbaySpawn`)
						end
					elseif kind == "BlastDoor" then
						if sockets and sockets:FindFirstChild("SurfaceExit") then
							pass()
						else
							fail(`Blast Door {room.Name} has no SurfaceExit socket`)
						end
					end
				end
			end
		end
	end

	return result
end

function StructureCheck.Format(result: Result): string
	local lines = {
		`StructureCheck: {#result.Errors} errors, {#result.Warnings} warnings, {result.Passed} checks passed`,
	}
	for _, message in result.Errors do
		table.insert(lines, `  ERROR {message}`)
	end
	for _, message in result.Warnings do
		table.insert(lines, `  warn  {message}`)
	end
	for _, message in result.Notes do
		table.insert(lines, `  note  {message}`)
	end
	return table.concat(lines, "\n")
end

return StructureCheck
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000000AA"><Properties><string name="Name">Lib</string></Properties><Item class="ModuleScript" referent="RBX000000A9"><Properties><string name="Name">BunkerKit</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BunkerKit: builds the bunker's world from Rules.Bunker data (bible Section 6).

	It builds from the A1 art kit in ServerStorage.Assets (bible Section 19): the Kit_* shell
	pieces, Kit_Rock_<Band> and Kit_Dug_<Band>, Kit_Shaft_L<level>, Kit_BlastDoor_L<level>,
	Kit_Vent and Room_<Type>_L<level>, each copied to its cell with Grid.CellCFrame. A piece
	the place doesn't have falls back to the Prompt 4 graybox (plain parts with the same
	sizes), so the bunker always builds, even in a place without the art.

	workspace.Bunker
	  Frame     rock around the grid: a column each side, a row above floor 1, a row below 10
	  Rock      one model per Rock cell, named by its key ("3,-2"); alternate cells turned
	  Dug       one model per Dug cell, named by its graph node ("D:2,3")
	  Rooms     one model per room, named by its id ("R4")

	* Every unit streams as Persistent, so the Command View always has the whole bunker
	  (bible Section 23).
	* Every room has walls. A side wall gets a doorway when the cell beyond it is open
	  (rooms connect sideways through doorways in shared walls). Cells of one room have no
	  wall between them.
	* Front walls carry the FrontWall tag (every part of a front wall piece, and the front
	  face of a dug cell): solid while playing, hidden in the Command View (Prompt 7).
	* Furniture, the Blast Door set, the stair, vents, lamps and cave props carry the
	  CameraFade tag: the over-the-shoulder camera passes through them and fades them when
	  they hide the character (Prompt 5). Floors, walls, ceilings and rock stop the camera.
	* Stacked Shafts get a hole in the upper one's floor, a hole in the lower one's ceiling
	  and the stair in the lower one.
	* Each room has a Sockets part (invisible) with an Attachment per gameplay point its art
	  carries: WorkSpot1.., Bed1.., Seat1.., Core, Valve1.., FuseBox, Breaker, Tap, Bench,
	  Respawn, Door, SurfaceExit, Vent, Lift, Chute, Top, Bottom, Light1.. Numbered points
	  count up across the room's cells from left to right; an unnumbered point that repeats
	  gets its cell's number (Breaker, Breaker2). BunkerKit.Socket and .Sockets read them.
	* The Medbay holds the players' spawn on its respawn pad (Section 6).
	* Lights: two per room cell at the ceiling strip, a lantern per dug cell, the Reactor's
	  core glow and the Kitchen's pendants. Each carries the RoomLight tag and a Unit
	  attribute (room id or dug node) for the power system (dark rooms, blackouts).
	* Each room gets one vent (a breach point, Section 10) in its first cell, except the
	  Shaft and the Blast Door (the door is the surface breach point).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage.Shared
local Bunker = require(Shared.Rules.Bunker)
local Config = require(Shared.Config)
local Grid = require(Shared.Rules.Grid)

local BunkerKit = {}

BunkerKit.FRONT_WALL_TAG = "FrontWall"
BunkerKit.ROOM_LIGHT_TAG = "RoomLight"
BunkerKit.CAMERA_FADE_TAG = "CameraFade"

local ASSET_TAG = "Asset" -- marks the source models in ServerStorage.Assets; copies drop it
local HALF_TURN = CFrame.Angles(0, math.pi, 0)

-- Graybox (Prompt 4) ---------------------------------------------------------------------

local DOOR_WIDTH, DOOR_HEIGHT = 8, 10 -- the kit's doorway
local CRUST, BEDROCK, EDGE = 6, 6, 6 -- rock around the grid
local SHAFT_HOLE = { FromX = 2, Depth = 8 } -- the opening between stacked Shafts, at the back right

local ROOM_COLORS: { [string]: Color3 } = {
	BlastDoor = Color3.fromRGB(96, 102, 110),
	Shaft = Color3.fromRGB(214, 168, 46),
	ReactorCore = Color3.fromRGB(58, 148, 160),
	Generator = Color3.fromRGB(210, 120, 40),
	Kitchen = Color3.fromRGB(200, 96, 64),
	WaterPurifier = Color3.fromRGB(70, 130, 190),
	Quarters = Color3.fromRGB(140, 120, 180),
	Medbay = Color3.fromRGB(226, 226, 220),
	Storage = Color3.fromRGB(150, 116, 80),
	Workshop = Color3.fromRGB(170, 150, 90),
}
local DEFAULT_ROOM_COLOR = Color3.fromRGB(170, 170, 160)
local WALL_COLOR = Color3.fromRGB(226, 216, 190) -- Steadfast cream
local FRONT_COLOR = Color3.fromRGB(200, 190, 166)
local CEILING_COLOR = Color3.fromRGB(236, 230, 214)
local LAMP_COLOR = Color3.fromRGB(255, 236, 196)
local BAND_COLORS: { [string]: Color3 } = {
	Mines = Color3.fromRGB(118, 94, 72),
	FloodedCaverns = Color3.fromRGB(74, 94, 108),
	CrystalHollows = Color3.fromRGB(100, 82, 128),
	SourceChamber = Color3.fromRGB(116, 52, 52),
}

-- Art lights ---------------------------------------------------------------------------------

type LightSpec = { Range: number, Brightness: number, Color: Color3 }

local CEILING_LIGHT: LightSpec = { Range = 18, Brightness = 1, Color = Color3.fromRGB(255, 228, 188) }
local DUG_LIGHTS: { [string]: LightSpec } = {
	Mines = { Range = 20, Brightness = 0.9, Color = Color3.fromRGB(255, 196, 120) },
	FloodedCaverns = { Range = 22, Brightness = 0.8, Color = Color3.fromRGB(140, 200, 210) },
	CrystalHollows = { Range = 22, Brightness = 1, Color = Color3.fromHex("8FE3E0") },
	SourceChamber = { Range = 22, Brightness = 1, Color = Color3.fromHex("7CFF9B") },
}
-- Rooms whose own Light sockets are real fixtures (the rest light from the ceiling kit).
local ACCENT_LIGHTS: { [string]: LightSpec } = {
	ReactorCore = { Range = 16, Brightness = 2, Color = Color3.fromHex("8FE3E0") },
	Kitchen = { Range = 12, Brightness = 0.8, Color = Color3.fromRGB(255, 214, 160) },
}
local NO_VENT: { [string]: boolean } = { Shaft = true, BlastDoor = true }

type Folders = { Root: Instance, Frame: Model, Rock: Model, Dug: Folder, Rooms: Folder }
type Socket = { Name: string, CFrame: CFrame }
type Holder = { Part: BasePart, Counters: { [string]: number }, Taken: { [string]: boolean } }

-- Parts --------------------------------------------------------------------------------------

-- An anchored block between two corners.
local function block(parent: Instance, name: string, low: Vector3, high: Vector3, color: Color3, material: Enum.Material): Part?
	local size = high - low
	if size.X <= 0.01 or size.Y <= 0.01 or size.Z <= 0.01 then
		return nil
	end
	local part = Instance.new("Part")
	part.Name = name
	part.Anchored = true
	part.Size = size
	part.CFrame = CFrame.new((low + high) / 2)
	part.Color = color
	part.Material = material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

-- A horizontal slab, with an optional rectangular hole (x and z ranges) cut out of it.
local function slab(
	parent: Instance,
	name: string,
	low: Vector3,
	high: Vector3,
	hole: { MinX: number, MaxX: number, MinZ: number, MaxZ: number }?,
	color: Color3,
	material: Enum.Material
)
	if not hole then
		block(parent, name, low, high, color, material)
		return
	end
	block(parent, name, low, Vector3.new(hole.MinX, high.Y, high.Z), color, material)
	block(parent, name, Vector3.new(hole.MaxX, low.Y, low.Z), high, color, material)
	block(parent, name, Vector3.new(hole.MinX, low.Y, low.Z), Vector3.new(hole.MaxX, high.Y, hole.MinZ), color, material)
	block(parent, name, Vector3.new(hole.MinX, low.Y, hole.MaxZ), Vector3.new(hole.MaxX, high.Y, high.Z), color, material)
end

-- The camera passes through this (and fades it when it hides the character).
local function fadeable(item: Instance)
	CollectionService:AddTag(item, BunkerKit.CAMERA_FADE_TAG)
end

local function newModel(name: string, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = name
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model.Parent = parent
	return model
end

local function addLight(parent: Instance, spec: LightSpec, unit: string)
	local light = Instance.new("PointLight")
	light.Range = spec.Range
	light.Brightness = spec.Brightness
	light.Color = spec.Color
	light.Shadows = false
	light:SetAttribute("Unit", unit)
	CollectionService:AddTag(light, BunkerKit.ROOM_LIGHT_TAG)
	light.Parent = parent
end

local function lamp(parent: Instance, cell: Vector3, bright: boolean, unit: string)
	local t = Grid.Tuning()
	local y = cell.Y + t.CellHeight - 0.6
	local part = block(
		parent,
		"Lamp",
		Vector3.new(cell.X - 2, y - 0.2, cell.Z + 3),
		Vector3.new(cell.X + 2, y, cell.Z + 5),
		LAMP_COLOR,
		if bright then Enum.Material.Neon else Enum.Material.SmoothPlastic
	)
	if part then
		part.CanCollide = false
		part.CastShadow = false
		fadeable(part)
		addLight(part, {
			Range = if bright then 30 else 18,
			Brightness = if bright then 1.4 else 0.6,
			Color = LAMP_COLOR,
		}, unit)
	end
end

local function label(wall: BasePart, text: string)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Label"
	gui.Face = Enum.NormalId.Back -- +Z: into the room
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 0.2
	local textLabel = Instance.new("TextLabel")
	textLabel.BackgroundTransparency = 1
	textLabel.Size = UDim2.new(1, 0, 0, 56)
	textLabel.Position = UDim2.new(0, 0, 0, 16)
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextScaled = true
	textLabel.TextColor3 = Color3.fromRGB(40, 44, 48)
	textLabel.Text = text
	textLabel.Parent = gui
	gui.Parent = wall
end

-- Art ----------------------------------------------------------------------------------------

local function art(category: string, name: string): Model?
	local assets = ServerStorage:FindFirstChild("Assets")
	local folder = if assets then assets:FindFirstChild(category) else nil
	local found = if folder then folder:FindFirstChild(name) else nil
	if found and found:IsA("Model") then
		return found
	end
	return nil
end

-- Has this place got the art kit? Without it the bunker is all graybox.
function BunkerKit.HasArt(): boolean
	return art("Kit", "Kit_Floor") ~= nil
end

-- A copy of an art model with its pivot at `at`.
local function place(source: Model, name: string, parent: Instance, at: CFrame, persistent: boolean?): Model
	local copy = source:Clone()
	copy.Name = name
	CollectionService:RemoveTag(copy, ASSET_TAG)
	if persistent then
		copy.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end
	copy:PivotTo(at)
	copy.Parent = parent
	return copy
end

local function piece(name: string, label_: string, parent: Instance, at: CFrame): Model?
	local source = art("Kit", name)
	return if source then place(source, label_, parent, at) else nil
end

-- "WorkSpot12" -> "WorkSpot", 12; "Core" -> "Core", nil.
local function splitName(name: string): (string, number?)
	local base, digits = string.match(name, "^(.-)(%d+)$")
	if base and base ~= "" then
		return base, tonumber(digits)
	end
	return name, nil
end

-- A placed copy's sockets (its Socket_<name> attributes, in the model's own space) in the
-- world, sorted by name and then number.
local function socketsOf(copy: Model): { Socket }
	local list: { Socket } = {}
	local pivot = copy:GetPivot()
	for key, value in copy:GetAttributes() do
		local name = string.match(key, "^Socket_(.+)$")
		if name and typeof(value) == "CFrame" then
			table.insert(list, { Name = name, CFrame = pivot * value })
		end
	end
	table.sort(list, function(a: Socket, b: Socket): boolean
		local baseA, numberA = splitName(a.Name)
		local baseB, numberB = splitName(b.Name)
		if baseA ~= baseB then
			return baseA < baseB
		end
		return (numberA or 0) < (numberB or 0)
	end)
	return list
end

local function attach(part: BasePart, name: string, at: CFrame): Attachment
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.CFrame = part.CFrame:ToObjectSpace(at)
	attachment.Parent = part
	return attachment
end

local function newHolder(model: Model, at: Vector3): Holder
	local part = Instance.new("Part")
	part.Name = "Sockets"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.one
	part.CFrame = CFrame.new(at)
	part.Parent = model
	return { Part = part, Counters = {}, Taken = {} }
end

-- Adds a gameplay point to a room, numbered within the room (see the header).
local function addSocket(holder: Holder, name: string, at: CFrame, cellIndex: number): Attachment
	local base, number = splitName(name)
	local final = name
	if number then
		holder.Counters[base] = (holder.Counters[base] or 0) + 1
		final = base .. holder.Counters[base]
	elseif holder.Taken[name] then
		final = name .. cellIndex
	end
	holder.Taken[final] = true
	return attach(holder.Part, final, at)
end

-- Every socket of a placed copy into the room's holder; returns the new attachments.
local function collect(holder: Holder, copy: Model, cellIndex: number): { Attachment }
	local made = {}
	for _, socket in socketsOf(copy) do
		table.insert(made, addSocket(holder, socket.Name, socket.CFrame, cellIndex))
	end
	return made
end

local function tagFront(model: Model, whole: boolean)
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and (whole or item:GetAttribute("Role") == "FrontWall") then
			CollectionService:AddTag(item, BunkerKit.FRONT_WALL_TAG)
		end
	end
end

-- The ceiling piece's two lamps, on its light strip.
local function ceilingLights(copy: Model, unit: string)
	local strip = copy:FindFirstChild("CeilingLight")
	if not (strip and strip:IsA("BasePart")) then
		return
	end
	for _, socket in socketsOf(copy) do
		if string.match(socket.Name, "^Light%d*$") then
			addLight(attach(strip, socket.Name, socket.CFrame), CEILING_LIGHT, unit)
		end
	end
end

-- Rooms: shells ------------------------------------------------------------------------------

type Shape = { ShaftBelow: boolean, ShaftAbove: boolean, LeftOpen: boolean, RightOpen: boolean }

-- A side wall on the plane between two cells: solid, or with a centred doorway.
local function sideWall(parent: Instance, name: string, x0: number, x1: number, floorY: number, z: number, doorway: boolean)
	local t = Grid.Tuning()
	local top = floorY + t.CellHeight
	local back, front = z - t.CellDepth / 2, z + t.CellDepth / 2
	if not doorway then
		block(parent, name, Vector3.new(x0, floorY, back), Vector3.new(x1, top, front), WALL_COLOR, Enum.Material.SmoothPlastic)
		return
	end
	local half = DOOR_WIDTH / 2
	block(parent, name, Vector3.new(x0, floorY, back), Vector3.new(x1, top, z - half), WALL_COLOR, Enum.Material.SmoothPlastic)
	block(parent, name, Vector3.new(x0, floorY, z + half), Vector3.new(x1, top, front), WALL_COLOR, Enum.Material.SmoothPlastic)
	block(parent, name, Vector3.new(x0, floorY + DOOR_HEIGHT, z - half), Vector3.new(x1, top, z + half), WALL_COLOR, Enum.Material.SmoothPlastic)
end

-- Inside a room of several cells the ceiling, back wall and front wall pieces leave the
-- 2-stud strip over the wall line between two cells bare: a steel beam closes the ceiling
-- and steel posts close the walls (the front post belongs to that front wall piece, so it
-- fades and hides with it).
local SEAM_COLOR = Color3.fromHex("8D969D") -- palette: steel
local SEAM_WIDTH = 2.4 -- over the 2-stud strip, a little each side
local SEAM_DEPTH = 0.6

local function seamPart(parent: Instance, name: string, low: Vector3, high: Vector3): Part?
	local part = block(parent, name, low, high, SEAM_COLOR, Enum.Material.SmoothPlastic)
	if part then
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
	end
	return part
end

local function seams(model: Model, floor: number, column: number, front: Model?)
	local t = Grid.Tuning()
	local cell = Grid.CellPosition(floor, column)
	local x = cell.X - t.CellWidth / 2 - t.WallThickness -- the line between this cell and the one on its left
	local y0, top = cell.Y, cell.Y + t.CellHeight
	local back, frontZ = cell.Z - t.CellDepth / 2, cell.Z + t.CellDepth / 2
	local half = SEAM_WIDTH / 2
	seamPart(model, "CeilingSeam", Vector3.new(x - t.WallThickness, top - 1.5, back), Vector3.new(x + t.WallThickness, top, frontZ))
	seamPart(model, "BackSeam", Vector3.new(x - half, y0, back), Vector3.new(x + half, top, back + SEAM_DEPTH))
	local post = seamPart(front or model, "FrontSeam", Vector3.new(x - half, y0, frontZ - SEAM_DEPTH), Vector3.new(x + half, top, frontZ))
	if post then
		CollectionService:AddTag(post, BunkerKit.FRONT_WALL_TAG)
	end
end

-- The art shell: per cell a floor, a ceiling with its lamps, a back and a front wall, and
-- side walls at the room's two ends (the left one is the right-hand piece turned around).
local function shellArt(model: Model, room: Bunker.Room, shape: Shape)
	for offset = 0, room.Span - 1 do
		local column = room.Column + offset
		local key = Grid.Key(room.Floor, column)
		local at = Grid.CellCFrame(room.Floor, column)
		local floor = piece(if shape.ShaftBelow then "Kit_FloorHole" else "Kit_Floor", `Floor {key}`, model, at)
		local rail = if floor then floor:FindFirstChild("HoleRail") else nil
		if rail then
			fadeable(rail)
		end
		local ceiling = piece(if shape.ShaftAbove then "Kit_CeilingHole" else "Kit_Ceiling", `Ceiling {key}`, model, at)
		if ceiling then
			ceilingLights(ceiling, room.Id)
		end
		piece("Kit_WallBack", `WallBack {key}`, model, at)
		local front = piece("Kit_WallFront", `WallFront {key}`, model, at)
		if offset == 0 then
			piece(if shape.LeftOpen then "Kit_WallSideDoor" else "Kit_WallSide", `WallLeft {key}`, model, at * HALF_TURN)
		else
			seams(model, room.Floor, column, front)
		end
		if front then
			tagFront(front, true)
		end
		if offset == room.Span - 1 then
			piece(if shape.RightOpen then "Kit_WallSideDoor" else "Kit_WallSide", `WallRight {key}`, model, at)
		end
	end
end

-- The graybox shell (Prompt 4): slabs, walls with doorways, a lamp per cell and a label.
local function shellGraybox(model: Model, room: Bunker.Room, info: { [string]: any }, shape: Shape)
	local t = Grid.Tuning()
	local W, H, D, T, S = t.CellWidth, t.CellHeight, t.CellDepth, t.WallThickness, t.SlabThickness
	local first = Grid.CellPosition(room.Floor, room.Column)
	local last = Grid.CellPosition(room.Floor, room.Column + room.Span - 1)
	local y0, z0 = first.Y, first.Z
	local xL, xR = first.X - W / 2 - T, last.X + W / 2 + T
	local color = ROOM_COLORS[room.Type] or DEFAULT_ROOM_COLOR
	local hole = {
		MinX = first.X + SHAFT_HOLE.FromX,
		MaxX = first.X + W / 2,
		MinZ = z0 - D / 2,
		MaxZ = z0 - D / 2 + SHAFT_HOLE.Depth,
	}

	slab(model, "Floor", Vector3.new(xL, y0 - S, z0 - D / 2 - T), Vector3.new(xR, y0, z0 + D / 2 + T), if shape.ShaftBelow then hole else nil, color, Enum.Material.SmoothPlastic)
	slab(model, "Ceiling", Vector3.new(xL + T, y0 + H - 0.5, z0 - D / 2), Vector3.new(xR - T, y0 + H, z0 + D / 2), if shape.ShaftAbove then hole else nil, CEILING_COLOR, Enum.Material.SmoothPlastic)
	local back = block(model, "BackWall", Vector3.new(xL, y0, z0 - D / 2 - T), Vector3.new(xR, y0 + H, z0 - D / 2), WALL_COLOR, Enum.Material.SmoothPlastic)
	local front = block(model, "FrontWall", Vector3.new(xL, y0, z0 + D / 2), Vector3.new(xR, y0 + H, z0 + D / 2 + T), FRONT_COLOR, Enum.Material.SmoothPlastic)
	if front then
		CollectionService:AddTag(front, BunkerKit.FRONT_WALL_TAG)
	end
	sideWall(model, "SideWallLeft", xL, xL + T, y0, z0, shape.LeftOpen)
	sideWall(model, "SideWallRight", xR - T, xR, y0, z0, shape.RightOpen)
	for offset = 0, room.Span - 1 do
		lamp(model, Grid.CellPosition(room.Floor, room.Column + offset), true, room.Id)
	end
	if back then
		label(back, `{info.Name}  L{room.Level}  ({room.Id})`)
	end
end

-- Rooms: insides -----------------------------------------------------------------------------

-- The graybox stair up from a Shaft to the Shaft above: a plank along the back, rising to
-- the right.
local function grayboxStair(parent: Instance, cell: Vector3)
	local t = Grid.Tuning()
	local rise = t.CellHeight + t.SlabThickness
	local run = t.CellWidth - 4
	local zMid = cell.Z - t.CellDepth / 2 + SHAFT_HOLE.Depth / 2
	local angle = math.atan2(rise, run)
	local length = math.sqrt(rise * rise + run * run)
	local normal = Vector3.new(-math.sin(angle), math.cos(angle), 0)
	local mid = Vector3.new(cell.X, cell.Y + rise / 2, zMid) - normal * 0.5
	local plank = Instance.new("Part")
	plank.Name = "Stair"
	plank.Anchored = true
	plank.Size = Vector3.new(length, 1, SHAFT_HOLE.Depth)
	plank.CFrame = CFrame.new(mid) * CFrame.Angles(0, 0, angle)
	plank.Color = ROOM_COLORS.Shaft
	plank.Material = Enum.Material.DiamondPlate
	fadeable(plank)
	plank.Parent = parent
end

-- Graybox stand-ins for a room's furniture when its art is missing, with the same sockets.
local function grayboxInterior(model: Model, room: Bunker.Room, info: { [string]: any }, centre: Vector3, holder: Holder)
	local t = Grid.Tuning()
	local y0, z0 = centre.Y, centre.Z
	local backZ = z0 - t.CellDepth / 2
	if room.Type == "ReactorCore" then
		local base = block(model, "CoreBase", Vector3.new(centre.X - 4, y0, z0 - 8), Vector3.new(centre.X + 4, y0 + 1, z0), Color3.fromRGB(60, 64, 70), Enum.Material.DiamondPlate)
		if base then
			fadeable(base)
		end
		local core = Instance.new("Part")
		core.Name = "Core"
		core.Anchored = true
		core.Shape = Enum.PartType.Cylinder
		core.Size = Vector3.new(10, 5, 5)
		core.CFrame = CFrame.new(centre.X, y0 + 6, z0 - 4) * CFrame.Angles(0, 0, math.rad(90))
		core.Material = Enum.Material.Neon
		core.Color = Color3.fromRGB(90, 200, 230)
		fadeable(core)
		core.Parent = model
		addSocket(holder, "Core", CFrame.new(centre.X, y0, z0 - 4), 1)
	elseif room.Type == "BlastDoor" then
		local door = Instance.new("Part")
		door.Name = "Door"
		door.Anchored = true
		door.Shape = Enum.PartType.Cylinder
		door.Size = Vector3.new(1, 13, 13)
		door.CFrame = CFrame.new(centre.X, y0 + 7, backZ + 0.5) * CFrame.Angles(0, math.rad(90), 0)
		door.Material = Enum.Material.DiamondPlate
		door.Color = Color3.fromRGB(70, 74, 80)
		fadeable(door)
		door.Parent = model
		addSocket(holder, "Door", CFrame.new(centre.X, y0, backZ + 3), 1)
		addSocket(holder, "SurfaceExit", CFrame.new(centre.X, y0 + t.CellHeight, backZ + 3), 1)
	elseif room.Type == "Medbay" then
		addSocket(holder, "Respawn", CFrame.new(centre.X, y0, z0 + 6), 1)
	elseif room.Type == "Quarters" and info.Beds then
		local beds = info.Beds[room.Level]
		for offset = 0, room.Span - 1 do
			local cell = Grid.CellPosition(room.Floor, room.Column + offset)
			local pitch = (t.CellWidth - 2) / beds
			for index = 1, beds do
				local x = cell.X - t.CellWidth / 2 + 1 + pitch * (index - 0.5)
				local bed = block(model, "Bed", Vector3.new(x - 1.4, y0, backZ + 0.5), Vector3.new(x + 1.4, y0 + 1.6, backZ + 7), Color3.fromRGB(120, 104, 160), Enum.Material.Fabric)
				if bed then
					bed:SetAttribute("Bed", offset * beds + index)
					fadeable(bed)
				end
				addSocket(holder, `Bed{index}`, CFrame.new(x, y0 + 1.6, backZ + 3.75), offset + 1)
			end
		end
	end
end

-- A room's insides: the Blast Door set, the Shaft stair, or its furniture per cell, then
-- its vent. Missing art falls back to the graybox. Returns whether the furniture is art.
local function interior(model: Model, room: Bunker.Room, info: { [string]: any }, shape: Shape, centre: Vector3, holder: Holder): boolean
	local first = Grid.CellPosition(room.Floor, room.Column)
	local isArt = false
	if room.Type == "BlastDoor" then
		local source = art("Kit", `Kit_BlastDoor_L{room.Level}`)
		if source then
			local set = place(source, "BlastDoor", model, CFrame.new(centre) * HALF_TURN)
			fadeable(set)
			collect(holder, set, 1)
			isArt = true
		else
			grayboxInterior(model, room, info, centre, holder)
		end
	elseif room.Type == "Shaft" then
		isArt = BunkerKit.HasArt()
		if shape.ShaftAbove then
			local source = art("Kit", `Kit_Shaft_L{room.Level}`)
			if source then
				local stair = place(source, "Stair", model, Grid.CellCFrame(room.Floor, room.Column))
				fadeable(stair)
				collect(holder, stair, 1)
			else
				grayboxStair(model, first)
				isArt = false
			end
		end
	else
		local source = art("Rooms", `Room_{room.Type}_L{room.Level}`)
		if source then
			local accent = ACCENT_LIGHTS[room.Type]
			for offset = 0, room.Span - 1 do
				local column = room.Column + offset
				local copy = place(source, `Interior {Grid.Key(room.Floor, column)}`, model, Grid.CellCFrame(room.Floor, column))
				fadeable(copy)
				for _, attachment in collect(holder, copy, offset + 1) do
					if accent and string.match(attachment.Name, "^Light%d*$") then
						addLight(attachment, accent, room.Id)
					end
				end
			end
			isArt = true
		else
			grayboxInterior(model, room, info, centre, holder)
		end
	end
	if not NO_VENT[room.Type] then
		local vent = piece("Kit_Vent", "Vent", model, Grid.CellCFrame(room.Floor, room.Column))
		if vent then
			fadeable(vent)
			collect(holder, vent, 1)
		end
	end
	return isArt
end

-- The players' spawn on the Medbay's Respawn point: invisible on the art pad, a red pad in
-- the graybox.
local function medbaySpawn(model: Model, holder: Holder, visible: boolean)
	local respawn = holder.Part:FindFirstChild("Respawn")
	if not (respawn and respawn:IsA("Attachment")) then
		return
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "MedbaySpawn"
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Size = Vector3.new(6, if visible then 1 else 0.2, 6)
	spawn.CFrame = CFrame.new(respawn.WorldPosition + Vector3.new(0, spawn.Size.Y / 2, 0))
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Color = Color3.fromRGB(196, 60, 60)
	if not visible then
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.CanQuery = false
		spawn.CastShadow = false
	end
	for _, child in spawn:GetChildren() do
		if child:IsA("Decal") then
			child:Destroy()
		end
	end
	spawn.Parent = model
end

-- Units --------------------------------------------------------------------------------------

local function buildRoom(bunker: Bunker.Bunker, room: Bunker.Room, parent: Instance): Model
	local info = Config.Get("Rooms", room.Type)
	local first = Grid.CellPosition(room.Floor, room.Column)
	local last = Grid.CellPosition(room.Floor, room.Column + room.Span - 1)
	local centre = (first + last) / 2

	local model = newModel(room.Id, parent)
	model:SetAttribute("RoomId", room.Id)
	model:SetAttribute("RoomType", room.Type)
	model:SetAttribute("Floor", room.Floor)
	model:SetAttribute("Column", room.Column)
	model:SetAttribute("Span", room.Span)
	model:SetAttribute("Level", room.Level)

	local shape: Shape = {
		ShaftBelow = room.Type == "Shaft" and bunker:IsShaft(room.Floor + 1, room.Column),
		ShaftAbove = room.Type == "Shaft" and bunker:IsShaft(room.Floor - 1, room.Column),
		LeftOpen = bunker:IsOpen(room.Floor, room.Column - 1),
		RightOpen = bunker:IsOpen(room.Floor, room.Column + room.Span),
	}
	local holder = newHolder(model, centre)
	local artShell = BunkerKit.HasArt()
	if artShell then
		shellArt(model, room, shape)
	else
		shellGraybox(model, room, info, shape)
	end
	local artInside = interior(model, room, info, shape, centre, holder)
	medbaySpawn(model, holder, not artInside)
	model:SetAttribute("Art", artShell and artInside)
	return model
end

local function buildDug(floor: number, column: number, parent: Instance): Model
	local t = Grid.Tuning()
	local band = Grid.BandOf(floor)
	local name = "D:" .. Grid.Key(floor, column)
	local source = art("Kit", `Kit_Dug_{band.Id}`)
	if source then
		local model = place(source, name, parent, Grid.CellCFrame(floor, column), true)
		model:SetAttribute("Floor", floor)
		model:SetAttribute("Column", column)
		model:SetAttribute("Band", band.Id)
		model:SetAttribute("Art", true)
		tagFront(model, false)
		for _, item in model:GetChildren() do
			if item:IsA("BasePart") and item.Name ~= "Floor" and item.Name ~= "BackRock" and item.Name ~= "FrontWall" then
				fadeable(item) -- timber, carts, pipes and other cave props
			end
		end
		local host = model:FindFirstChild("Floor")
		if host and host:IsA("BasePart") then
			for _, socket in socketsOf(model) do
				if socket.Name == "Light" then
					addLight(attach(host, "Light", socket.CFrame), DUG_LIGHTS[band.Id] or DUG_LIGHTS.Mines, name)
				end
			end
		end
		return model
	end

	local W, H, D, T, S = t.CellWidth, t.CellHeight, t.CellDepth, t.WallThickness, t.SlabThickness
	local cell = Grid.CellPosition(floor, column)
	local rock = BAND_COLORS[band.Id] or BAND_COLORS.Mines
	local model = newModel(name, parent)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	local x0, x1 = cell.X - W / 2 - T, cell.X + W / 2 + T
	block(model, "Floor", Vector3.new(x0, cell.Y - S, cell.Z - D / 2 - T), Vector3.new(x1, cell.Y, cell.Z + D / 2 + T), rock:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Ground)
	block(model, "BackRock", Vector3.new(x0, cell.Y, cell.Z - D / 2 - T), Vector3.new(x1, cell.Y + H, cell.Z - D / 2), rock, Enum.Material.Slate)
	local front = block(model, "FrontWall", Vector3.new(x0, cell.Y, cell.Z + D / 2), Vector3.new(x1, cell.Y + H, cell.Z + D / 2 + T), rock, Enum.Material.Slate)
	if front then
		CollectionService:AddTag(front, BunkerKit.FRONT_WALL_TAG)
	end
	lamp(model, cell, false, name)
	return model
end

-- Construction sites (Prompt 8) ----------------------------------------------------------------

local TIMBER = Color3.fromRGB(118, 94, 72)
local HAZARD = Color3.fromRGB(214, 168, 46)
local SITE_GHOST = { From = 0.8, To = 0.3 } -- the coming room's transparency, from the start to the end

--[[
	A construction site in open cells (BuildService): the coming room's interior art, see-through
	and firming up as the build goes on (SetSiteProgress), behind a timber scaffold with a
	hazard-striped plank. Graybox scaffolding until the art kit has a scaffold piece. Nothing on
	it collides; the camera passes through it.
]]
function BunkerKit.Site(parent: Instance, name: string, roomType: string, floor: number, column: number, span: number): Model
	local t = Grid.Tuning()
	local model = newModel(name, parent)
	model:SetAttribute("RoomType", roomType)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	model:SetAttribute("Span", span)
	local ghost = Instance.new("Model")
	ghost.Name = "Ghost"
	ghost.Parent = model
	local source = art("Rooms", `Room_{roomType}_L1`)
	for offset = 0, span - 1 do
		local cell = Grid.CellPosition(floor, column + offset)
		if source then
			place(source, `Interior {Grid.Key(floor, column + offset)}`, ghost, Grid.CellCFrame(floor, column + offset))
		else
			local color = ROOM_COLORS[roomType] or DEFAULT_ROOM_COLOR
			block(ghost, "Block", cell + Vector3.new(-t.CellWidth / 4, 0, -t.CellDepth / 4), cell + Vector3.new(t.CellWidth / 4, t.CellHeight / 3, t.CellDepth / 4), color, Enum.Material.SmoothPlastic)
		end
		-- the scaffold: two posts, a top beam and a striped plank across the back of the cell
		local x0, x1 = cell.X - t.CellWidth / 2 + 2, cell.X + t.CellWidth / 2 - 2
		local z = cell.Z - t.CellDepth / 2 + 3
		for _, x in { x0, x1 } do
			block(model, "Post", Vector3.new(x - 0.5, cell.Y, z - 0.5), Vector3.new(x + 0.5, cell.Y + t.CellHeight - 0.5, z + 0.5), TIMBER, Enum.Material.Wood)
		end
		block(model, "Beam", Vector3.new(x0 - 0.5, cell.Y + t.CellHeight - 2, z - 0.5), Vector3.new(x1 + 0.5, cell.Y + t.CellHeight - 1, z + 0.5), TIMBER, Enum.Material.Wood)
		block(model, "Plank", Vector3.new(x0 - 0.5, cell.Y + t.CellHeight * 0.45, z - 0.3), Vector3.new(x1 + 0.5, cell.Y + t.CellHeight * 0.45 + 1.2, z + 0.3), HAZARD, Enum.Material.SmoothPlastic)
	end
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") then
			item.Anchored = true
			item.CanCollide = false
			item.CanTouch = false
			item.CanQuery = false
			item.CastShadow = false
			if item:IsDescendantOf(ghost) then
				item:SetAttribute("SiteSolid", item.Transparency)
			end
		elseif item:IsA("Light") or item:IsA("ProximityPrompt") or item:IsA("Script") then
			item:Destroy()
		end
	end
	fadeable(model)
	BunkerKit.SetSiteProgress(model, 0)
	return model
end

-- Firms the coming room up as its site builds (0 to 1), in steps of 5% so it isn't sent every frame.
function BunkerKit.SetSiteProgress(model: Model, progress: number)
	local ghost = model:FindFirstChild("Ghost")
	if not ghost then
		return
	end
	local alpha = SITE_GHOST.From + (SITE_GHOST.To - SITE_GHOST.From) * math.clamp(progress, 0, 1)
	alpha = math.floor(alpha * 20 + 0.5) / 20
	if model:GetAttribute("SiteAlpha") == alpha then
		return
	end
	model:SetAttribute("SiteAlpha", alpha)
	for _, item in ghost:GetDescendants() do
		if item:IsA("BasePart") then
			local solid = item:GetAttribute("SiteSolid")
			if type(solid) == "number" and solid < 1 then
				item.Transparency = math.max(solid, alpha)
			end
		end
	end
end

-- A rock cell's art, turned half a turn on alternate cells so the face doesn't repeat.
local function rockArt(bandId: string, name: string, parent: Instance, floor: number, column: number): Model?
	local source = art("Kit", `Kit_Rock_{bandId}`)
	if not source then
		return nil
	end
	local at = Grid.CellCFrame(floor, column)
	if (floor + column) % 2 == 1 then
		at *= HALF_TURN
	end
	local model = place(source, name, parent, at)
	model:SetAttribute("Floor", floor)
	model:SetAttribute("Column", column)
	model:SetAttribute("Band", bandId)
	return model
end

local function buildRock(floor: number, column: number, parent: Instance)
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local band = Grid.BandOf(floor)
	local key = Grid.Key(floor, column)
	if rockArt(band.Id, key, parent, floor, column) then
		return
	end
	local cell = Grid.CellPosition(floor, column)
	local part = block(
		parent,
		key,
		Vector3.new(cell.X - pitch.X / 2, cell.Y - t.SlabThickness, cell.Z - pitch.Z / 2),
		Vector3.new(cell.X + pitch.X / 2, cell.Y + t.CellHeight, cell.Z + pitch.Z / 2),
		BAND_COLORS[band.Id] or BAND_COLORS.Mines,
		Enum.Material.Slate
	)
	if part then
		part:SetAttribute("Floor", floor)
		part:SetAttribute("Column", column)
		part:SetAttribute("Band", band.Id)
	end
end

local function buildFrame(parent: Model)
	local t = Grid.Tuning()
	if art("Kit", "Kit_Rock_Mines") then
		-- A ring of rock cells: the Mines above floor 1, the Source's rock under floor 10, and
		-- each floor's band at the grid's two sides.
		for floor = t.FloorMin - 1, t.FloorMax + 1 do
			local outside = floor < t.FloorMin or floor > t.FloorMax
			local bandId = if floor < t.FloorMin then "Mines" elseif floor > t.FloorMax then "SourceChamber" else Grid.BandOf(floor).Id
			for column = t.ColumnMin - 1, t.ColumnMax + 1 do
				if outside or column < t.ColumnMin or column > t.ColumnMax then
					rockArt(bandId, `Frame {Grid.Key(floor, column)}`, parent, floor, column)
				end
			end
		end
		return
	end

	local pitch = Grid.Pitch()
	local topCell = Grid.CellPosition(t.FloorMin, t.ColumnMin)
	local bottomCell = Grid.CellPosition(t.FloorMax, t.ColumnMax)
	local left = topCell.X - pitch.X / 2
	local right = bottomCell.X + pitch.X / 2
	local top = topCell.Y + t.CellHeight
	local bottom = bottomCell.Y - t.SlabThickness
	local back, front = topCell.Z - pitch.Z / 2, topCell.Z + pitch.Z / 2
	local crust = BAND_COLORS.Mines:Lerp(Color3.fromRGB(90, 80, 60), 0.5)
	for column = t.ColumnMin, t.ColumnMax do
		local x = Grid.CellPosition(t.FloorMin, column).X
		block(parent, `Crust {column}`, Vector3.new(x - pitch.X / 2, top, back), Vector3.new(x + pitch.X / 2, top + CRUST, front), crust, Enum.Material.Ground)
	end
	block(parent, "Bedrock", Vector3.new(left - EDGE, bottom - BEDROCK, back), Vector3.new(right + EDGE, bottom, front), Color3.fromRGB(40, 34, 34), Enum.Material.Basalt)
	block(parent, "EdgeLeft", Vector3.new(left - EDGE, bottom, back), Vector3.new(left, top + CRUST, front), crust, Enum.Material.Slate)
	block(parent, "EdgeRight", Vector3.new(right, bottom, back), Vector3.new(right + EDGE, top + CRUST, front), crust, Enum.Material.Slate)
end

-- Sync ---------------------------------------------------------------------------------------

local function folders(root: Instance): Folders
	local function child(name: string, className: string): Instance
		local found = root:FindFirstChild(name)
		if not found then
			found = Instance.new(className)
			found.Name = name
			if found:IsA("Model") then
				found.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
			end
			found.Parent = root
		end
		return found :: Instance
	end
	return {
		Root = root,
		Frame = child("Frame", "Model") :: Model,
		Rock = child("Rock", "Model") :: Model,
		Dug = child("Dug", "Folder") :: Folder,
		Rooms = child("Rooms", "Folder") :: Folder,
	}
end

--[[
	Makes the world under `root` match `bunker`. With `dirty` (cell keys), only those cells
	and the units holding them are rebuilt (BunkerGrid passes the changed cells and their
	neighbours); without it, everything is.
]]
function BunkerKit.Sync(bunker: Bunker.Bunker, root: Instance, dirty: { [string]: boolean }?)
	local t = Grid.Tuning()
	local f = folders(root)
	if #f.Frame:GetChildren() == 0 then
		buildFrame(f.Frame)
	end

	local keys: { string } = {}
	if dirty then
		for key in dirty do
			table.insert(keys, key)
		end
	else
		for floor = t.FloorMin, t.FloorMax do
			for column = t.ColumnMin, t.ColumnMax do
				table.insert(keys, Grid.Key(floor, column))
			end
		end
	end

	local units: { [string]: boolean } = {}
	for _, key in keys do
		local floor, column = Grid.Parse(key)
		if not floor or not column or not Grid.OnGrid(floor, column) then
			continue
		end
		local rock = f.Rock:FindFirstChild(key)
		if bunker:State(floor, column) == "Rock" then
			if not rock then
				buildRock(floor, column, f.Rock)
			end
		else
			if rock then
				rock:Destroy()
			end
			local unit = bunker:UnitAt(floor, column)
			if unit then
				units[unit] = true
			end
		end
	end

	-- Models whose unit is gone or is being rebuilt
	for _, model in f.Rooms:GetChildren() do
		if units[model.Name] or bunker:Room(model.Name) == nil then
			model:Destroy()
		end
	end
	for _, model in f.Dug:GetChildren() do
		local floor, column = Grid.Parse(string.sub(model.Name, 3))
		local current = if floor and column then bunker:UnitAt(floor, column) else nil
		if units[model.Name] or current ~= model.Name then
			model:Destroy()
		end
	end

	for unit in units do
		local room = bunker:Room(unit)
		if room then
			buildRoom(bunker, room, f.Rooms)
		else
			local floor, column = Grid.Parse(string.sub(unit, 3))
			if floor and column then
				buildDug(floor, column, f.Dug)
			end
		end
	end
end

-- Queries ------------------------------------------------------------------------------------

-- A room's gameplay point (an Attachment on its Sockets part), in the world.
function BunkerKit.Socket(model: Instance, name: string): CFrame?
	local holder = model:FindFirstChild("Sockets")
	local attachment = if holder then holder:FindFirstChild(name) else nil
	if attachment and attachment:IsA("Attachment") then
		return attachment.WorldCFrame
	end
	return nil
end

-- A room's gameplay points whose names match a Lua pattern ("^WorkSpot%d+$"), or all.
function BunkerKit.Sockets(model: Instance, pattern: string?): { [string]: CFrame }
	local found: { [string]: CFrame } = {}
	local holder = model:FindFirstChild("Sockets")
	if holder then
		for _, item in holder:GetChildren() do
			if item:IsA("Attachment") and (pattern == nil or string.match(item.Name, pattern)) then
				found[item.Name] = item.WorldCFrame
			end
		end
	end
	return found
end

-- Counts parts under the bunker (DevTools).
function BunkerKit.PartCount(root: Instance): number
	local count = 0
	for _, item in root:GetDescendants() do
		if item:IsA("BasePart") then
			count += 1
		end
	end
	return count
end

return BunkerKit
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AA"><Properties><string name="Name">ProfileSchema</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileSchema: the shape of a player's saved data (bible Section 23), its defaults, its
	migrations, and the load pipeline: migrate, then reconcile, then validate. Pure (no
	DataStores), so the data tests can run it on fixtures. ProfileService does the I/O.

	Version history:
	  1  2026-11-08  first version (Prompt 2)

	To change the shape: raise VERSION, add MIGRATIONS[old] that turns version old into old+1,
	and update Default() and SHAPE. Never rename or drop a field without a migration: during
	a rolling update old and new servers run side by side, and an old server refuses (never
	overwrites) data newer than it knows.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Check = require(Shared.Utilities.Check)
local Config = require(Shared.Config)
local TableUtil = require(Shared.Utilities.TableUtil)

local ProfileSchema = {}

ProfileSchema.VERSION = 1
ProfileSchema.RECEIPTS_KEPT = 200

-- version -> function turning a profile of that version into the next version
local MIGRATIONS: { [number]: (data: { [string]: any }) -> { [string]: any } } = {}

-- Fields whose value is a fixed-shape record (reconciled field by field); every other table
-- field is a map whose keys belong to the player (classes owned, badges earned...).
local RECORDS: { [string]: boolean } = {
	Talents = true,
	Cosmetics = true,
	Stats = true,
	Quests = true,
	ClassShop = true,
}

local Id = Check.string(64, { pattern = "^[%a][%w_]*$" })

local SHAPE = Check.shape({
	Version = Check.integer(1),
	Glowshards = Check.integer(0, 1e9),
	Classes = Check.map(Id, Check.shape({ Level = Check.integer(1, 3), XP = Check.number({ min = 0 }) }), 100),
	Talents = Check.shape({ Slots = Check.integer(0, 3), Equipped = Check.array(Id, 3) }),
	Legends = Check.map(Id, Check.shape({ Renown = Check.integer(1, 5) }), 200),
	Cosmetics = Check.shape({
		Owned = Check.map(Id, Check.boolean(), 2000),
		Equipped = Check.map(Id, Id, 32),
	}),
	Stats = Check.map(Id, Check.number({ min = 0 }), 64),
	Badges = Check.map(Id, Check.number({ min = 0 }), 500),
	Quests = Check.shape({
		Daily = Check.array(Check.any(), 10),
		Weekly = Check.array(Check.any(), 10),
		LastReset = Check.number({ min = 0 }),
	}),
	ClassShop = Check.shape({
		Day = Check.integer(0),
		Slots = Check.array(Id, 4),
		RerollsUsed = Check.integer(0),
		Wishlist = Check.optional(Id),
	}),
	AccountLevel = Check.integer(1, 100),
	AccountXP = Check.number({ min = 0 }),
	Settings = Check.map(Id, Check.primitive(64), 64),
	Receipts = Check.array(Check.string(64, { min = 1 }), 200),
	FirstRunDone = Check.boolean(),
})

-- A new player's profile: the free class and the starter Legend are theirs (bible Sections
-- 14 and 15).
function ProfileSchema.Default(): { [string]: any }
	local classes: { [string]: any } = {}
	for _, class in Config.All("Classes") do
		if class.Tier == "Free" then
			classes[class.Id] = { Level = 1, XP = 0 }
		end
	end
	local legends: { [string]: any } = {}
	local starter = Config.Get("Tuning", "Legends").StarterLegend
	legends[starter] = { Renown = 1 }
	return {
		Version = ProfileSchema.VERSION,
		Glowshards = 0,
		Classes = classes,
		Talents = { Slots = 0, Equipped = {} },
		Legends = legends,
		Cosmetics = { Owned = {}, Equipped = {} },
		Stats = { Runs = 0, Wins = 0, BestYear = 0, Deepest = 0 },
		Badges = {},
		Quests = { Daily = {}, Weekly = {}, LastReset = 0 },
		ClassShop = { Day = 0, Slots = {}, RerollsUsed = 0 },
		AccountLevel = 1,
		AccountXP = 0,
		Settings = {},
		Receipts = {},
		FirstRunDone = false,
	}
end

-- Runs every migration from data.Version up to VERSION. Errors if a step is missing.
function ProfileSchema.Migrate(data: { [string]: any }): { [string]: any }
	local version = data.Version
	if type(version) ~= "number" then
		version = 1
		data.Version = 1
	end
	while version < ProfileSchema.VERSION do
		local step = MIGRATIONS[version]
		if not step then
			error(`no migration from profile version {version}`)
		end
		data = step(data)
		version += 1
		data.Version = version
	end
	return data
end

-- Fills in fields the profile is missing (new fields, new record fields) from the defaults.
-- Never touches the player's own keys in maps.
function ProfileSchema.Reconcile(data: { [string]: any }): { [string]: any }
	local defaults = ProfileSchema.Default()
	for field, value in defaults do
		local current = data[field]
		if current == nil then
			data[field] = value
		elseif RECORDS[field] and type(current) == "table" and type(value) == "table" then
			for subField, subValue in value do
				if current[subField] == nil then
					current[subField] = subValue
				end
			end
		end
	end
	return data
end

function ProfileSchema.Validate(data: any): (boolean, string?)
	return SHAPE(data)
end

export type LoadStatus = "New" | "Loaded" | "TooNew" | "Invalid"

--[[
	The whole load pipeline for stored Data (nil for a new player): returns the profile to use
	and a status. TooNew and Invalid return no profile: the player must not play on it (and
	nothing may be written).
]]
function ProfileSchema.Load(stored: any): ({ [string]: any }?, LoadStatus, string?)
	if stored == nil then
		return ProfileSchema.Default(), "New", nil
	end
	if type(stored) ~= "table" then
		return nil, "Invalid", `stored data is a {type(stored)}`
	end
	if type(stored.Version) == "number" and stored.Version > ProfileSchema.VERSION then
		return nil, "TooNew", `version {stored.Version} is newer than {ProfileSchema.VERSION}`
	end
	local data = TableUtil.DeepCopy(stored)
	local ok, result = pcall(ProfileSchema.Migrate, data)
	if not ok then
		return nil, "Invalid", tostring(result)
	end
	data = ProfileSchema.Reconcile(result)
	local valid, why = ProfileSchema.Validate(data)
	if not valid then
		return nil, "Invalid", why
	end
	return data, "Loaded", nil
end

-- What the player's own client sees: everything except the receipt log.
function ProfileSchema.Public(data: { [string]: any }): { [string]: any }
	local copy = TableUtil.DeepCopy(data)
	copy.Receipts = nil
	return copy
end

-- Adds a receipt id, keeping the newest RECEIPTS_KEPT.
function ProfileSchema.AddReceipt(data: { [string]: any }, receiptId: string)
	local receipts = data.Receipts
	table.insert(receipts, receiptId)
	while #receipts > ProfileSchema.RECEIPTS_KEPT do
		table.remove(receipts, 1)
	end
end

ProfileSchema._MIGRATIONS = MIGRATIONS -- for the data tests

return ProfileSchema
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000000B7"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX000000AC"><Properties><string name="Name">BuildService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BuildService: construction, upgrades, merges and teardown (bible Sections 6 and 8). Run
	place only.

	* Proposing: a player proposes from the Command View (the Propose remote).
	  Rules.Construction.Plan checks it against the bunker, the unlocks, the stockpile, Lab
	  research, and the cells already held by open votes and construction sites. Then
	  VoteService puts it to the team (in a solo run it applies at once).
	* When the vote passes, it is planned again (anything may have changed meanwhile) and paid
	  for (EconomyService), and then:
	  * Build: a construction site goes on the cell. It takes 20 s a cell
	    (Tuning.Rooms.BuildSecondsPerCell), 25% faster for every player standing in it
	    (HelperBuildSpeed; residents join with Prompt 10). When it's done the room is placed
	    (BunkerGrid).
	  * Upgrade: the room's level goes up at once.
	  * Merge: the two rooms become one at once.
	  * TearDown: the room goes at once and its cells are open cells again. Nothing comes back
	    (the bible names no refund).
	* Sites replicate in the Sites collection: id -> { Type, Floor, Column, Span, Progress
	  (0 to 1), Helpers }. In the world they stand in workspace.Bunker.Sites (BunkerKit.Site).
	* Rooms won from blueprint drafts and cryo pods: Unlock(roomType) (Prompts 17 and 19). They
	  replicate in the Unlocked collection (room type -> true) for the Command View's menu.
	Repairs come with Prompt 13.

	API:
		BuildService:Propose(player, proposal): (boolean, string?)
		BuildService:Unlock(roomType), :Unlocked(): { [string]: boolean }
		BuildService:Reserved(exceptVoteId?): { [string]: boolean }  -- votes' and sites' cells
		BuildService:FinishSite(id): boolean                           -- DevTools
		BuildService.Proposed: Signal<Player, string>   -- proposer, action (first-run objective 2)
		BuildService.Built: Signal<string, string>      -- room id, action (Build, Upgrade, Merge)
		BuildService.TornDown: Signal<string, string>   -- room id, room type
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("BuildService")

local BuildService = {
	Name = "BuildService",
	Dependencies = { "BunkerGrid", "EconomyService", "VoteService", "SessionService", "ReplicationService", "DevService" },
	Proposed = Signal.new() :: Signal.Signal<Player, string>,
	Built = Signal.new() :: Signal.Signal<string, string>,
	TornDown = Signal.new() :: Signal.Signal<string, string>,
}

type Site = {
	Id: string,
	Type: string,
	Floor: number,
	Column: number,
	Span: number,
	Cells: { string },
	Seconds: number,
	Done: number, -- seconds of work done (helpers make it grow faster)
	Helpers: number,
	Sent: number, -- the progress last replicated
	Model: Model?,
}

local grid: any = nil
local economy: any = nil
local votes: any = nil
local session: any = nil
local sitesCollection: any = nil
local unlockedCollection: any = nil
local sites: { [string]: Site } = {}
local siteCount = 0
local unlocked: { [string]: boolean } = {}

local function roomName(roomType: string): string
	return Config.Get("Rooms", roomType).Name
end

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function announce(text: string)
	Remotes.FireClients("Alert", session:ReadyPlayers(), "Info", text)
end

-- "The stockpile is 70 Scrap short." -> "the stockpile is 70 Scrap short" (the banner adds FAILED:)
local function clause(text: string): string
	local trimmed = string.gsub(text, "%.$", "")
	return (string.gsub(trimmed, "^%u", string.lower))
end

function BuildService:Reserved(exceptVoteId: string?): { [string]: boolean }
	local cells = votes:Reserved(exceptVoteId)
	for _, site in sites do
		for _, key in site.Cells do
			cells[key] = true
		end
	end
	return cells
end

local function context(exceptVoteId: string?): Construction.Context
	return {
		Era = table.find(Config.Ids("Eras"), RunState.Get("Era") or "") or 1,
		Deepest = grid:DeepestFloor(),
		Unlocked = unlocked,
		Stock = economy:Stock(),
		Research = economy:Research(),
		Reserved = BuildService:Reserved(exceptVoteId),
	}
end

-- Sites ---------------------------------------------------------------------------------------------

local function publishSite(site: Site)
	local progress = math.floor(math.min(1, site.Done / site.Seconds) * 100) / 100
	site.Sent = progress
	sitesCollection:Set(site.Id, {
		Type = site.Type,
		Floor = site.Floor,
		Column = site.Column,
		Span = site.Span,
		Progress = progress,
		Helpers = site.Helpers,
		Seconds = site.Seconds,
	})
end

local function sitesFolder(): Instance?
	local root = grid:Root()
	if not root then
		return nil
	end
	local folder = root:FindFirstChild("Sites")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Sites"
		folder.Parent = root
	end
	return folder
end

local function startSite(plan: Construction.Plan)
	siteCount += 1
	local site: Site = {
		Id = `S{siteCount}`,
		Type = plan.RoomType,
		Floor = plan.Floor,
		Column = plan.Column,
		Span = plan.Span,
		Cells = Construction.Cells(plan),
		Seconds = Construction.Seconds(plan.Span),
		Done = 0,
		Helpers = 0,
		Sent = -1,
	}
	local folder = sitesFolder()
	if folder then
		site.Model = BunkerKit.Site(folder, site.Id, site.Type, site.Floor, site.Column, site.Span)
	end
	sites[site.Id] = site
	publishSite(site)
	log:Info("%s: building a %s at %s (%d s)", site.Id, site.Type, Grid.Key(site.Floor, site.Column), site.Seconds)
	announce(`BUILDING A {string.upper(roomName(site.Type))}: STAND IN IT TO HELP`)
end

local function finishSite(site: Site)
	sites[site.Id] = nil
	sitesCollection:Remove(site.Id)
	if site.Model then
		site.Model:Destroy()
	end
	local roomId, why = grid:PlaceRoom(site.Type, site.Floor, site.Column, site.Span)
	if roomId then
		log:Info("%s done: %s is %s", site.Id, site.Type, roomId)
		announce(`{string.upper(roomName(site.Type))} BUILT`)
		BuildService.Built:Fire(roomId, "Build")
	else
		log:Warn("%s couldn't place its %s: %s", site.Id, site.Type, tostring(why))
	end
end

function BuildService:FinishSite(id: string): boolean
	local site = sites[id]
	if not site then
		return false
	end
	finishSite(site)
	return true
end

-- Players standing in a site's cells (alive).
local function helpersAt(site: Site): number
	local n = 0
	for _, player in session:ReadyPlayers() do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and root:IsA("BasePart") and humanoid and humanoid.Health > 0 then
			local floor, column = Grid.CellAt(root.Position)
			if floor == site.Floor and column and column >= site.Column and column < site.Column + site.Span then
				n += 1
			end
		end
	end
	return n
end

local function tick(dt: number)
	for _, site in sites do
		site.Helpers = helpersAt(site)
		site.Done += dt * Construction.Rate(site.Helpers)
		if site.Done >= site.Seconds then
			finishSite(site)
		else
			local progress = site.Done / site.Seconds
			if site.Model then
				BunkerKit.SetSiteProgress(site.Model, progress)
			end
			local current = sitesCollection:Get(site.Id)
			if progress - site.Sent >= 0.01 or (current and current.Helpers ~= site.Helpers) then
				publishSite(site)
			end
		end
	end
end

-- Applying a passed proposal ------------------------------------------------------------------------

local function apply(plan: Construction.Plan)
	local paid, why = economy:Spend(plan.Costs, plan.Label)
	if not paid then
		log:Warn("%s passed but couldn't be paid: %s", plan.Label, tostring(why))
		announce(`{plan.Label}: {string.upper(why or "can't pay")}`)
		return
	end
	if plan.Action == "Build" then
		startSite(plan)
	elseif plan.Action == "Upgrade" then
		local roomId, level = plan.RoomId :: string, plan.Level :: number
		local ok, err = grid:SetLevel(roomId, level)
		if ok then
			announce(`{string.upper(roomName(plan.RoomType))} UPGRADED TO LEVEL {level}`)
			BuildService.Built:Fire(roomId, "Upgrade")
		else
			log:Warn("upgrade of %s failed: %s", roomId, tostring(err))
		end
	elseif plan.Action == "Merge" then
		local merged, err = grid:MergeRooms(plan.RoomId :: string, plan.Other :: string)
		if merged then
			announce(`{string.upper(roomName(plan.RoomType))} MERGED`)
			BuildService.Built:Fire(merged, "Merge")
		else
			log:Warn("merge of %s and %s failed: %s", tostring(plan.RoomId), tostring(plan.Other), tostring(err))
		end
	elseif plan.Action == "TearDown" then
		local roomId = plan.RoomId :: string
		local ok, err = grid:RemoveRoom(roomId)
		if ok then
			announce(`{string.upper(roomName(plan.RoomType))} TORN DOWN`)
			BuildService.TornDown:Fire(roomId, plan.RoomType)
		else
			log:Warn("teardown of %s failed: %s", roomId, tostring(err))
		end
	end
end

-- Proposals ------------------------------------------------------------------------------------------

-- The ghost outline's label in the Command View: "KITCHEN?", "LEVEL 2?", "MERGE?", "TEAR DOWN?".
local function ghostLabel(plan: Construction.Plan): string
	if plan.Action == "Build" then
		return `{string.upper(roomName(plan.RoomType))}?`
	elseif plan.Action == "Upgrade" then
		return `LEVEL {plan.Level}?`
	elseif plan.Action == "Merge" then
		return "MERGE?"
	end
	return "TEAR DOWN?"
end

function BuildService:Propose(player: Player, proposal: Construction.Proposal): (boolean, string?)
	local ok, why = votes:CanPropose(player)
	if not ok then
		return false, why
	end
	local plan, reason = Construction.Plan(grid:Bunker(), proposal, context(nil))
	if not plan then
		return false, reason
	end
	local voteId: string? = nil
	local latest: Construction.Plan = plan
	local id, err = votes:Open({
		Kind = "Build",
		Proposer = player,
		Title = plan.Label,
		Costs = plan.Costs,
		Subject = { Floor = plan.Floor, Column = plan.Column, Span = plan.Span, Label = ghostLabel(plan) },
		Cells = Construction.Cells(plan),
		Check = function(): (boolean, string?)
			local again, why2 = Construction.Plan(grid:Bunker(), proposal, context(voteId))
			if again then
				latest = again
				return true, nil
			end
			return false, clause(why2 or "it can't be done any more")
		end,
		OnPass = function()
			apply(latest)
		end,
	})
	if not id then
		return false, err
	end
	voteId = id
	log:Info("%s proposed %s (%s)", player.Name, plan.Label, id)
	BuildService.Proposed:Fire(player, plan.Action)
	return true, nil
end

function BuildService:Unlock(roomType: string)
	assert(Config.Find("Rooms", roomType), `BuildService: no room type {roomType}`)
	unlocked[roomType] = true
	unlockedCollection:Set(roomType, true)
end

function BuildService:Unlocked(): { [string]: boolean }
	return table.clone(unlocked)
end

-- Lifecycle ------------------------------------------------------------------------------------------

local function describeSites(): string
	local lines = {}
	for id, site in sites do
		table.insert(lines, string.format("%s %s at %s: %.0f%% (%d helping, %.1f of %d s)", id, site.Type,
			Grid.Key(site.Floor, site.Column), math.min(1, site.Done / site.Seconds) * 100, site.Helpers, site.Done, site.Seconds))
	end
	table.sort(lines)
	return if #lines > 0 then table.concat(lines, "\n") else "no construction sites"
end

function BuildService:Init(registry)
	grid = registry.BunkerGrid
	economy = registry.EconomyService
	votes = registry.VoteService
	session = registry.SessionService
	sitesCollection = registry.ReplicationService:Collection("Sites")
	unlockedCollection = registry.ReplicationService:Collection("Unlocked")
	Remotes.OnServer("Propose", function(player: Player, action: string, floor: number, column: number, detail: string)
		local proposal: Construction.Proposal = {
			Action = action :: Construction.Action,
			Floor = floor,
			Column = column,
			RoomType = if action == "Build" then detail else nil,
			Other = if action == "Merge" then detail else nil,
		}
		local ok, why = BuildService:Propose(player, proposal)
		if not ok and why then
			alert(player, "Warning", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("build", {
		Description = "Propose construction as you would from the Command View.",
		Usage = "build <Build|Upgrade|Merge|TearDown> <floor> <column> [roomType|otherRoomId]",
		Run = function(player: Player, args): string?
			local action, floor, column = tostring(args[1] or ""), tonumber(args[2]), tonumber(args[3])
			if not table.find({ "Build", "Upgrade", "Merge", "TearDown" }, action) or not floor or not column then
				return "usage: build <Build|Upgrade|Merge|TearDown> <floor> <column> [roomType|otherRoomId]"
			end
			local detail = if args[4] ~= nil then tostring(args[4]) else nil
			local ok, why = BuildService:Propose(player, {
				Action = action :: Construction.Action,
				Floor = floor,
				Column = column,
				RoomType = if action == "Build" then detail else nil,
				Other = if action == "Merge" then detail else nil,
			})
			return if ok then `proposed\n{describeSites()}` else `refused: {why}`
		end,
	})
	dev:Register("sites", {
		Description = "Construction sites and their progress.",
		Usage = "sites",
		Run = function(): string?
			return describeSites()
		end,
	})
	dev:Register("site.finish", {
		Description = "Finish a construction site now (or every site).",
		Usage = "site.finish [id]",
		Run = function(_player: Player, args): string?
			local id = if args[1] ~= nil then tostring(args[1]) else nil
			local done = 0
			for siteId in table.clone(sites) do
				if id == nil or siteId == id then
					if BuildService:FinishSite(siteId) then
						done += 1
					end
				end
			end
			return `finished {done} site(s)\n{describeSites()}`
		end,
	})
	dev:Register("unlock", {
		Description = "Unlock a room type as if a blueprint draft had won it.",
		Usage = "unlock <roomType>",
		Run = function(_player: Player, args): string?
			local roomType = tostring(args[1] or "")
			if not Config.Find("Rooms", roomType) then
				return "usage: unlock <roomType>"
			end
			BuildService:Unlock(roomType)
			return `unlocked {roomType}`
		end,
	})
end

function BuildService:Start()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt: number)
		acc += dt
		if acc >= 0.25 then
			tick(acc)
			acc = 0
		end
	end)
end

return BuildService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AD"><Properties><string name="Name">BunkerGrid</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	BunkerGrid: the bunker's cells, rooms, levels, merges and the room graph (bible Sections 6
	and 23). Run place only.

	The data and its rules are Shared.Rules.Bunker (Rock, Dug and room cells; dig left, right
	or down; rooms on Dug cells, MaxCells, Unique, Fixed, floor rules; matching rooms merge;
	levels 1 to 3; the graph of doorways and Shafts). This service holds the run's one bunker,
	starts it from Tuning.StartingBunker, builds the world from it (Lib.BunkerKit, graybox
	until the A1 art) and replicates it:
	* Cells collection: "floor,column" -> { Room = id } for every open cell ({} when Dug);
	* Rooms collection: id -> { Type, Floor, Column, Span, Level, HP, MaxHP }.

	Votes, costs and build time are BuildService's (Prompt 8); dig time, cell rolls and Push
	Deeper are DigService's (Prompt 14). They call the methods below.

	API:
		BunkerGrid:Bunker(): Bunker               -- the live data: read only
		BunkerGrid:State(floor, column), :Room(id), :RoomAt(floor, column), :Rooms(), :RoomsOfType(type)
		BunkerGrid:Dig(floor, column): (boolean, string?)
		BunkerGrid:PlaceRoom(type, floor, column, span, level?): (string?, string?)
		BunkerGrid:RemoveRoom(id): (boolean, string?)
		BunkerGrid:MergeRooms(a, b): (string?, string?)
		BunkerGrid:SetLevel(id, level): (boolean, string?)
		BunkerGrid:SetHP(id, hp): number?
		BunkerGrid:Neighbors(unit), :Graph(), :DeepestFloor()
		BunkerGrid:RoomModel(id): Model?, :Root(): Folder
		BunkerGrid.Changed: Signal<{ string }>    -- the cell keys whose state changed
		BunkerGrid.RoomChanged: Signal<string>    -- a room was added, changed or removed
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Bunker = require(Shared.Rules.Bunker)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local BunkerKit = require(ServerScriptService.Lib.BunkerKit)

local log = Log.new("BunkerGrid")

local BunkerGrid = {
	Name = "BunkerGrid",
	Dependencies = { "ReplicationService", "DevService" },
	Changed = Signal.new() :: Signal.Signal<{ string }>,
	RoomChanged = Signal.new() :: Signal.Signal<string>,
}

local CODES: { [string]: string } = {
	BlastDoor = "BLD", Shaft = "SHF", ReactorCore = "RCT", Generator = "GEN", Kitchen = "KIT",
	WaterPurifier = "WTR", Quarters = "QTR", Medbay = "MED", Storage = "STO", Workshop = "WRK",
	Armory = "ARM", RadioRoom = "RAD", Lounge = "LNG", Lab = "LAB", DrillBay = "DRL",
	Greenhouse = "GRN", TrainingRoom = "TRN", DeconRoom = "DCN", CryoBay = "CRY",
	TradingPost = "TRD", Memorial = "MEM",
}

local bunker: Bunker.Bunker = Bunker.new()
local root: Folder? = nil
local cellsCollection: any = nil
local roomsCollection: any = nil

-- Replication and the world ---------------------------------------------------------------

local function publishRoom(id: string)
	local room = bunker:Room(id)
	if room then
		roomsCollection:Set(id, {
			Type = room.Type,
			Floor = room.Floor,
			Column = room.Column,
			Span = room.Span,
			Level = room.Level,
			HP = room.HP,
			MaxHP = room.MaxHP,
		})
	elseif roomsCollection:Get(id) ~= nil then
		roomsCollection:Remove(id)
	end
end

local function publishCell(key: string)
	local floor, column = Grid.Parse(key)
	if not floor or not column then
		return
	end
	local state, id = bunker:State(floor, column)
	if state == "Dug" then
		cellsCollection:Set(key, {})
	elseif state == "Room" then
		cellsCollection:Set(key, { Room = id })
	elseif cellsCollection:Get(key) ~= nil then
		cellsCollection:Remove(key)
	end
end

-- The cells of these rooms and cells, and their neighbours left, right, above and below.
local function around(cells: { { number } }): { [string]: boolean }
	local dirty: { [string]: boolean } = {}
	for _, cell in cells do
		local floor, column = cell[1], cell[2]
		for _, offset in { { 0, 0 }, { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } } do
			local f, c = floor + offset[1], column + offset[2]
			if Grid.OnGrid(f, c) then
				dirty[Grid.Key(f, c)] = true
			end
		end
	end
	return dirty
end

local function roomCells(room: Bunker.Room): { { number } }
	local cells = {}
	for offset = 0, room.Span - 1 do
		table.insert(cells, { room.Floor, room.Column + offset })
	end
	return cells
end

-- After a change: replicate the changed cells and rooms, rebuild the world around them.
local function changed(cells: { { number } }, roomIds: { string })
	local keys = {}
	for _, cell in cells do
		local key = Grid.Key(cell[1], cell[2])
		table.insert(keys, key)
		publishCell(key)
	end
	for _, id in roomIds do
		publishRoom(id)
	end
	if root then
		BunkerKit.Sync(bunker, root, around(cells))
	end
	BunkerGrid.Changed:Fire(keys)
	for _, id in roomIds do
		BunkerGrid.RoomChanged:Fire(id)
	end
end

-- API ----------------------------------------------------------------------------------------

function BunkerGrid:Bunker(): Bunker.Bunker
	return bunker
end

function BunkerGrid:Root(): Folder?
	return root
end

function BunkerGrid:State(floor: number, column: number): (Bunker.CellState?, string?)
	return bunker:State(floor, column)
end

function BunkerGrid:Room(id: string): Bunker.Room?
	return bunker:Room(id)
end

function BunkerGrid:RoomAt(floor: number, column: number): Bunker.Room?
	return bunker:RoomAt(floor, column)
end

function BunkerGrid:Rooms(): { Bunker.Room }
	return bunker:AllRooms()
end

function BunkerGrid:RoomsOfType(roomType: string): { Bunker.Room }
	return bunker:RoomsOfType(roomType)
end

function BunkerGrid:Neighbors(unit: string): { string }
	return bunker:Neighbors(unit)
end

function BunkerGrid:Graph(): { [string]: { string } }
	return bunker:Graph()
end

function BunkerGrid:DeepestFloor(): number
	return bunker:DeepestFloor()
end

function BunkerGrid:RoomModel(id: string): Model?
	local folder = root and root:FindFirstChild("Rooms")
	local model = folder and folder:FindFirstChild(id)
	return if model and model:IsA("Model") then model else nil
end

function BunkerGrid:Dig(floor: number, column: number): (boolean, string?)
	local ok, why = bunker:Dig(floor, column)
	if ok then
		log:Info("dug %s", Grid.Key(floor, column))
		changed({ { floor, column } }, {})
	end
	return ok, why
end

function BunkerGrid:PlaceRoom(roomType: string, floor: number, column: number, span: number, level: number?): (string?, string?)
	local id, why = bunker:Place(roomType, floor, column, span, level)
	if id then
		local room = bunker:Room(id) :: Bunker.Room
		log:Info("%s %s on floor %d, columns %d to %d", id, roomType, floor, column, column + span - 1)
		changed(roomCells(room), { id })
	end
	return id, why
end

function BunkerGrid:RemoveRoom(id: string): (boolean, string?)
	local room = bunker:Room(id)
	local cells = if room then roomCells(room) else {}
	local ok, why = bunker:Remove(id)
	if ok then
		log:Info("%s torn down", id)
		changed(cells, { id })
	end
	return ok, why
end

function BunkerGrid:MergeRooms(a: string, b: string): (string?, string?)
	local first, second = bunker:Room(a), bunker:Room(b)
	local cells = {}
	for _, room in { first, second } do
		if room then
			for _, cell in roomCells(room) do
				table.insert(cells, cell)
			end
		end
	end
	local id, why = bunker:Merge(a, b)
	if id then
		log:Info("%s and %s merged into %s", a, b, id)
		changed(cells, { a, b })
	end
	return id, why
end

function BunkerGrid:SetLevel(id: string, level: number): (boolean, string?)
	local ok, why = bunker:SetLevel(id, level)
	if ok then
		changed(roomCells(bunker:Room(id) :: Bunker.Room), { id })
	end
	return ok, why
end

function BunkerGrid:SetHP(id: string, hp: number): number?
	local result = bunker:SetHP(id, hp)
	if result then
		roomsCollection:Patch(id, { HP = result })
		BunkerGrid.RoomChanged:Fire(id)
	end
	return result
end

-- DevTools ----------------------------------------------------------------------------------

local function map(): string
	local t = Grid.Tuning()
	local lines = {}
	local header = { "floor  " }
	for column = t.ColumnMin, t.ColumnMax do
		table.insert(header, string.format("%5d", column))
	end
	table.insert(lines, table.concat(header))
	local last = math.min(t.FloorMax, math.max(bunker:DeepestFloor() + 1, 3))
	for floor = t.FloorMin, last do
		local row = { string.format("%5d  ", floor) }
		for column = t.ColumnMin, t.ColumnMax do
			local state, id = bunker:State(floor, column)
			local token = "  ###"
			if state == "Dug" then
				token = "  ..."
			elseif state == "Room" and id then
				local room = bunker:Room(id) :: Bunker.Room
				token = `  {CODES[room.Type] or string.sub(room.Type, 1, 3)}`
			end
			table.insert(row, token)
		end
		table.insert(lines, table.concat(row))
	end
	return table.concat(lines, "\n")
end

local function roomList(): string
	local lines = {}
	for _, room in bunker:AllRooms() do
		table.insert(lines, `{room.Id} {room.Type} L{room.Level} floor {room.Floor} columns {room.Column}..{room.Column + room.Span - 1} HP {room.HP}/{room.MaxHP}`)
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("grid", {
		Description = "The bunker map (### rock, ... dug, room codes) and its size.",
		Run = function(): string?
			local parts = if root then BunkerKit.PartCount(root) else 0
			return `{map()}\n{#bunker:AllRooms()} rooms, deepest floor {bunker:DeepestFloor()}, {parts} parts`
		end,
	})
	dev:Register("grid.rooms", {
		Description = "Every room: id, type, level, cells and HP.",
		Run = function(): string?
			return roomList()
		end,
	})
	dev:Register("grid.graph", {
		Description = "The room graph: each room or dug cell and what it connects to.",
		Run = function(): string?
			local lines = {}
			local graph = bunker:Graph()
			for _, unit in bunker:Units() do
				table.insert(lines, `{unit}: {table.concat(graph[unit], ", ")}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	dev:Register("grid.dig", {
		Description = "Dig a rock cell (no time, no vote: DigService adds those).",
		Usage = "grid.dig <floor> <column>",
		Run = function(_player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: grid.dig <floor> <column>"
			end
			local ok, why = BunkerGrid:Dig(floor, column)
			return if ok then map() else `can't dig: {why}`
		end,
	})
	dev:Register("grid.build", {
		Description = "Place a room on dug cells (no vote or cost: BuildService adds those).",
		Usage = "grid.build <RoomType> <floor> <column> [span] [level]",
		Run = function(_player, args): string?
			local roomType = tostring(args[1] or "")
			local floor, column = tonumber(args[2]), tonumber(args[3])
			local span, level = tonumber(args[4]) or 1, tonumber(args[5])
			if not floor or not column then
				return "usage: grid.build <RoomType> <floor> <column> [span] [level]"
			end
			local id, why = BunkerGrid:PlaceRoom(roomType, floor, column, span, level)
			return if id then `{id} placed\n{map()}` else `can't build: {why}`
		end,
	})
	dev:Register("grid.remove", {
		Description = "Tear a room down (its cells become dug).",
		Usage = "grid.remove <roomId>",
		Run = function(_player, args): string?
			local ok, why = BunkerGrid:RemoveRoom(tostring(args[1] or ""))
			return if ok then map() else `can't remove: {why}`
		end,
	})
	dev:Register("grid.merge", {
		Description = "Merge two matching rooms side by side.",
		Usage = "grid.merge <roomId> <roomId>",
		Run = function(_player, args): string?
			local id, why = BunkerGrid:MergeRooms(tostring(args[1] or ""), tostring(args[2] or ""))
			return if id then `merged into {id}\n{roomList()}` else `can't merge: {why}`
		end,
	})
	dev:Register("grid.level", {
		Description = "Set a room's level (1 to 3).",
		Usage = "grid.level <roomId> <level>",
		Run = function(_player, args): string?
			local ok, why = BunkerGrid:SetLevel(tostring(args[1] or ""), tonumber(args[2]) or 0)
			return if ok then roomList() else `can't set the level: {why}`
		end,
	})
	dev:Register("grid.sockets", {
		Description = "A room's gameplay points (work spots, beds, valves...) and where they are.",
		Usage = "grid.sockets <roomId>",
		Run = function(_player, args): string?
			local model = BunkerGrid:RoomModel(tostring(args[1] or ""))
			if not model then
				return "usage: grid.sockets <roomId> (see grid.rooms)"
			end
			local lines = {}
			for name, at in BunkerKit.Sockets(model) do
				local p = at.Position
				table.insert(lines, string.format("%s (%.1f, %.1f, %.1f)", name, p.X, p.Y, p.Z))
			end
			table.sort(lines)
			return `{model.Name}: {#lines} sockets\n{table.concat(lines, "\n")}`
		end,
	})
	dev:Register("grid.art", {
		Description = "Which units are built from the art kit and which from the graybox.",
		Run = function(): string?
			if not root then
				return "no bunker world yet"
			end
			local art, gray = {}, {}
			for _, folderName in { "Rooms", "Dug" } do
				local folder = root:FindFirstChild(folderName)
				for _, model in if folder then folder:GetChildren() else {} do
					table.insert(if model:GetAttribute("Art") then art else gray, model.Name)
				end
			end
			local lights = 0
			for _, item in root:GetDescendants() do
				if item:IsA("PointLight") then
					lights += 1
				end
			end
			return `art kit: {if BunkerKit.HasArt() then "yes" else "missing"}\nart: {table.concat(art, ", ")}\ngraybox: {table.concat(gray, ", ")}\n{lights} lights, {BunkerKit.PartCount(root)} parts`
		end,
	})
	dev:Register("grid.rebuild", {
		Description = "Rebuild the whole bunker world from the data.",
		Run = function(): string?
			if not root then
				return "no bunker world yet"
			end
			local began = os.clock()
			root:ClearAllChildren()
			BunkerKit.Sync(bunker, root, nil)
			return `rebuilt {BunkerKit.PartCount(root)} parts in {string.format("%.1f", (os.clock() - began) * 1000)} ms`
		end,
	})
end

-- Lifecycle -----------------------------------------------------------------------------------

function BunkerGrid:Init(registry)
	bunker = Bunker.FromStart()
	cellsCollection = registry.ReplicationService:Collection("Cells")
	roomsCollection = registry.ReplicationService:Collection("Rooms")
	for key in bunker.Cells do
		publishCell(key)
	end
	for _, room in bunker:AllRooms() do
		publishRoom(room.Id)
	end
	registerCommands(registry.DevService)
end

function BunkerGrid:Start()
	local began = os.clock()
	local old = workspace:FindFirstChild("Bunker")
	if old then
		old:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "Bunker"
	BunkerKit.Sync(bunker, folder, nil)
	folder.Parent = workspace
	root = folder

	-- Players spawn in the Medbay (their respawn point); other spawns in the place sleep.
	for _, item in workspace:GetDescendants() do
		if item:IsA("SpawnLocation") and not item:IsDescendantOf(folder) then
			item.Enabled = false
		end
	end
	local open = 0
	for _ in bunker.Cells do
		open += 1
	end
	log:Info(
		"bunker built from the %s: %d rooms, %d open cells, %d parts in %.1f ms",
		if BunkerKit.HasArt() then "art kit" else "graybox",
		#bunker:AllRooms(),
		open,
		BunkerKit.PartCount(folder),
		(os.clock() - began) * 1000
	)
end

return BunkerGrid
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AE"><Properties><string name="Name">CycleClock</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CycleClock: 4:30 cycles, day and Surge phases, the year counter, Years per Cycle and skips
	(bible Sections 5 and 23). Run place only.

	A cycle is a 3:00 day (building, digging, trips outside) then a 1:30 Surge (a breach wave
	below, a storm above, one disaster). The siren sounds 20 seconds before the Surge. A Surge
	ends when its time is up, or earlier when ThreatDirector calls EndSurge (its last monster
	died and its disaster is fixed). A boss Surge (an era boss, or the final Surge's Source)
	has no timer and ignores EndSurge: it ends when its boss is beaten (ObjectiveService's
	BossDefeated; Landon, Nov 8, 2026). Then the year counter jumps by Years per Cycle and the
	next cycle starts. The arithmetic (Years per Cycle, era bosses, the final Surge, Endless)
	is Shared.Rules.Clock; the published values are Shared.RunState.

	Skips: when every player in the run has pressed Ready (the SetReady remote) or is resting
	in a Quarters bed (SetResting, called by the bed interaction), the day jumps to the siren.
	Ready and resting both count only during a day before the siren, and both reset at the
	siren (Landon, Nov 8, 2026), so a player still in bed when a day starts lies down again.

	RunDirector drives it: Begin when the intro ends, Halt on a victory or a defeat, Resume
	(after SetEndless) for Keep Going. When the final Surge ends (the Source is beaten) the
	clock halts by itself, before the year jumps, and fires CenturySurvived.

	API:
		CycleClock.CycleStarted: Signal<number>              -- the cycle number (residents eat and drink)
		CycleClock.SirenStarted: Signal<SurgeKind, string?>  -- 20 s to the Surge: its kind and boss
		CycleClock.SurgeStarted: Signal<SurgeKind, string?>
		CycleClock.SurgeEnded: Signal<SurgeKind, string>     -- how: "Time", "Cleared" or "Boss"
		CycleClock.YearChanged: Signal<number, number>       -- year, previous year (aging)
		CycleClock.EraChanged: Signal<string, string>        -- era, previous era
		CycleClock.CenturySurvived: Signal<()>
		CycleClock.Skipped: Signal<()>                       -- everyone was ready
		CycleClock:Begin(), :Halt(), :Resume(), :SetEndless(on)
		CycleClock:EndSurge(): boolean                       -- ThreatDirector: this Surge is cleared (not a boss Surge)
		CycleClock:SetResting(player, on): boolean           -- a player lies down in or leaves a Quarters bed
		CycleClock:Phase(), :Year(), :Cycle(), :Era(), :YearsPerCycle(), :Surge(), :TimeLeft(), :IsRunning()
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Clock = require(Shared.Rules.Clock)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("CycleClock")

export type CyclePhase = RunState.CyclePhase
export type SurgeKind = Clock.SurgeKind

local CycleClock = {
	Name = "CycleClock",
	Dependencies = { "SessionService", "ObjectiveService", "DevService" },
	CycleStarted = Signal.new() :: Signal.Signal<number>,
	SirenStarted = Signal.new() :: Signal.Signal<SurgeKind, string?>,
	SurgeStarted = Signal.new() :: Signal.Signal<SurgeKind, string?>,
	SurgeEnded = Signal.new() :: Signal.Signal<SurgeKind, string>,
	YearChanged = Signal.new() :: Signal.Signal<number, number>,
	EraChanged = Signal.new() :: Signal.Signal<string, string>,
	CenturySurvived = Signal.new() :: Signal.Signal<()>,
	Skipped = Signal.new() :: Signal.Signal<()>,
}

local MAX_TIME_SCALE = 100

local session: any = nil
local objectives: any = nil
local set: (string, any) -> () = function() end
local tuning: { [string]: any } = {}

local state: Clock.State = Clock.NewState()
local begun = false
local running = false -- the timers are live
local halted = false -- RunDirector stopped the clock (a victory or a defeat)
local devPaused = false -- DevTools paused it
local cycleEndPending = false -- stopped after the final Surge, before the year jumps
local openEnded = false -- this phase has no timer (a boss Surge)
local phase: CyclePhase? = nil
local surgeKind: SurgeKind = "Tutorial"
local surgeBoss: string? = nil
local phaseLength = 0 -- seconds of clock time
local endsAt = 0 -- server time
local sirenAt: number? = nil -- server time; nil once the siren sounds, and during Surges
local siren = false
local leftWhenStopped = 0 -- clock seconds left in the phase when the clock stopped
local sirenInWhenStopped: number? = nil
local scale = 1
local ready: { [Player]: boolean } = {}
local resting: { [Player]: boolean } = {}

local function now(): number
	return workspace:GetServerTimeNow()
end

-- Publishing ------------------------------------------------------------------------------

local function publishTimes()
	set("PhaseLength", phaseLength)
	set("PhaseOpen", if openEnded then true else nil)
	if openEnded then
		set("PhaseEndsAt", nil)
		set("PhaseLeft", nil)
	elseif running then
		set("PhaseEndsAt", endsAt)
		set("PhaseLeft", nil)
	else
		set("PhaseEndsAt", nil)
		set("PhaseLeft", leftWhenStopped / scale)
	end
end

local function publishSurge()
	set("SurgeKind", surgeKind)
	set("SurgeBoss", surgeBoss)
end

local function publishYear()
	set("Cycle", state.Cycle)
	set("Year", state.Year)
	set("Era", Clock.EraOf(state.Year))
	set("YearsPerCycle", Clock.YearsPerCycle(state.Completed))
end

-- Ready and skips -------------------------------------------------------------------------

local startSiren: () -> ()
local skipToSiren: (why: string) -> ()

-- A skip is possible during a day, before the siren.
local function canSkip(): boolean
	return running and phase == "Day" and sirenAt ~= nil
end

local function countReady(leaving: Player?)
	local inRun = 0
	local count = 0
	for _, player in session:ReadyPlayers() do
		if player ~= leaving then
			inRun += 1
			if ready[player] or resting[player] then
				count += 1
			end
		end
	end
	set("ReadyCount", count)
	set("ReadyNeeded", inRun)
	if inRun > 0 and count == inRun and canSkip() then
		skipToSiren("everyone is ready")
	end
end

local function setReady(player: Player, on: boolean)
	if (ready[player] == true) == on then
		return
	end
	ready[player] = if on then true else nil
	player:SetAttribute("Ready", on)
	countReady()
end

local function clearReady()
	for player in ready do
		if player.Parent then
			player:SetAttribute("Ready", false)
		end
	end
	table.clear(ready)
end

local function clearResting()
	for player in resting do
		if player.Parent then
			player:SetAttribute("Resting", false)
		end
	end
	table.clear(resting)
end

-- The SetReady remote and DevTools: Ready only counts during a day, before the siren.
local function requestReady(player: Player, on: boolean): boolean
	if not session:IsReady(player) then
		return false
	end
	if on and not canSkip() then
		return false
	end
	setReady(player, on)
	return true
end

-- Phases ----------------------------------------------------------------------------------

startSiren = function()
	sirenAt = nil
	siren = true
	set("Siren", true)
	clearReady()
	clearResting()
	countReady()
	log:Debug("cycle %d: siren (%s Surge)", state.Cycle, surgeKind)
	CycleClock.SirenStarted:Fire(surgeKind, surgeBoss)
end

skipToSiren = function(why: string)
	endsAt = now() + tuning.SurgeSirenSeconds / scale
	publishTimes()
	log:Info("cycle %d: %s; the day skips to the siren", state.Cycle, why)
	CycleClock.Skipped:Fire()
	startSiren()
end

local function startDay()
	phase = "Day"
	phaseLength = tuning.DaySeconds
	local t = now()
	endsAt = t + phaseLength / scale
	sirenAt = t + math.max(0, phaseLength - tuning.SurgeSirenSeconds) / scale
	siren = false
	openEnded = false
	surgeKind, surgeBoss = Clock.SurgeKind(state)
	clearReady()
	clearResting()
	set("CyclePhase", "Day")
	set("Siren", false)
	publishSurge()
	publishTimes()
	log:Info("cycle %d, Year %d: day (next Surge: %s)", state.Cycle, state.Year, surgeKind)
	CycleClock.CycleStarted:Fire(state.Cycle)
	countReady()
end

local function startSurge()
	surgeKind, surgeBoss = Clock.StartSurge(state)
	phase = "Surge"
	openEnded = Clock.IsOpenEnded(surgeKind)
	phaseLength = if openEnded then 0 else tuning.SurgeSeconds
	endsAt = if openEnded then math.huge else now() + phaseLength / scale
	sirenAt = nil
	siren = false
	clearReady()
	set("CyclePhase", "Surge")
	set("Siren", false)
	publishSurge()
	publishTimes()
	countReady()
	log:Info("cycle %d, Year %d: %s Surge %s", state.Cycle, state.Year, surgeKind, surgeBoss or "")
	CycleClock.SurgeStarted:Fire(surgeKind, surgeBoss)
end

local function endCycle()
	cycleEndPending = false
	local oldEra = Clock.EraOf(state.Year)
	local before, due = Clock.EndCycle(state)
	publishYear()
	if state.Year ~= before then
		CycleClock.YearChanged:Fire(state.Year, before)
	end
	local era = Clock.EraOf(state.Year)
	if era ~= oldEra then
		CycleClock.EraChanged:Fire(era, oldEra)
	end
	if due then
		log:Info("Year %d: %s comes at the next Surge", state.Year, due)
	end
	startDay()
end

local function freeze()
	if not running then
		return
	end
	local t = now()
	leftWhenStopped = if openEnded then 0 else math.max(0, endsAt - t) * scale
	sirenInWhenStopped = if sirenAt then math.max(0, sirenAt - t) * scale else nil
	running = false
	publishTimes()
end

local function thaw()
	if running or not begun or halted or devPaused then
		return
	end
	running = true
	if cycleEndPending then
		endCycle()
		return
	end
	local t = now()
	endsAt = if openEnded then math.huge else t + leftWhenStopped / scale
	sirenAt = if sirenInWhenStopped then t + sirenInWhenStopped / scale else nil
	publishTimes()
	countReady()
end

local function endSurge(how: string)
	local kind = surgeKind
	log:Info("cycle %d: %s Surge over (%s)", state.Cycle, kind, how)
	openEnded = false
	endsAt = now() -- nothing is left of it, however it ended
	cycleEndPending = true -- the year jumps next; if the clock stops first, Resume does it
	CycleClock.SurgeEnded:Fire(kind, how)
	if kind == "Final" then
		-- The century is over. Hold before the year jumps until RunDirector decides: a
		-- Century Victory, and Keep Going resumes the clock into Endless.
		if not halted then
			halted = true
			freeze()
			publishTimes()
			CycleClock.CenturySurvived:Fire()
		end
		return
	end
	if running then
		endCycle()
	end
end

local function tick()
	if not running then
		return
	end
	local t = now()
	if sirenAt and t >= sirenAt then
		startSiren()
	end
	if running and t >= endsAt then
		if phase == "Day" then
			startSurge()
		elseif phase == "Surge" then
			endSurge("Time")
		end
	end
end

local function setScale(value: number)
	local wasRunning = running
	if wasRunning then
		freeze()
	end
	scale = value
	if wasRunning then
		thaw()
	else
		publishTimes()
	end
	set("TimeScale", if scale == 1 then nil else scale)
end

-- API -------------------------------------------------------------------------------------

-- RunDirector: the intro is over; cycle 1 starts.
function CycleClock:Begin()
	if begun then
		return
	end
	begun = true
	running = true
	state.Completed = objectives:Completed()
	publishYear()
	startDay()
	if devPaused or halted then
		freeze()
	end
end

-- RunDirector: stop the clock (a victory or a defeat).
function CycleClock:Halt()
	halted = true
	freeze()
end

-- RunDirector: carry on after a Halt (Keep Going).
function CycleClock:Resume()
	if not halted then
		return
	end
	halted = false
	thaw()
end

-- RunDirector: Endless mode (no year cap, no more era bosses, Endless Surges).
function CycleClock:SetEndless(on: boolean)
	state.Endless = on
	if phase == "Day" then
		surgeKind, surgeBoss = Clock.SurgeKind(state)
		publishSurge()
	end
end

-- ThreatDirector: the Surge's last monster died and its disaster is fixed. A boss Surge
-- carries on until its boss is beaten, so this returns false then.
function CycleClock:EndSurge(): boolean
	if not running or phase ~= "Surge" or openEnded then
		return false
	end
	endSurge("Cleared")
	return true
end

-- The bed interaction: a player lies down in (or gets out of) a Quarters bed. Lying down
-- counts only during a day before the siren, like Ready; returns whether it counted.
function CycleClock:SetResting(player: Player, on: boolean): boolean
	if on and not canSkip() then
		return false
	end
	if (resting[player] == true) == on then
		return true
	end
	resting[player] = if on then true else nil
	player:SetAttribute("Resting", on)
	countReady()
	return true
end

-- Is the current phase a boss Surge with no timer?
function CycleClock:IsOpenEnded(): boolean
	return openEnded
end

function CycleClock:Phase(): CyclePhase?
	return phase
end

function CycleClock:Year(): number
	return state.Year
end

function CycleClock:Cycle(): number
	return state.Cycle
end

function CycleClock:Era(): string
	return Clock.EraOf(state.Year)
end

function CycleClock:YearsPerCycle(): number
	return Clock.YearsPerCycle(state.Completed)
end

-- The coming (during a day) or current Surge: its kind and boss.
function CycleClock:Surge(): (SurgeKind, string?)
	return surgeKind, surgeBoss
end

-- Real seconds left in the current phase.
function CycleClock:TimeLeft(): number
	if running then
		return math.max(0, endsAt - now())
	end
	return leftWhenStopped / scale
end

function CycleClock:IsRunning(): boolean
	return running
end

-- DevTools --------------------------------------------------------------------------------

local function describe(): string
	local endless = if state.Endless then ", Endless" else ""
	local lines = {
		`cycle {state.Cycle}, Year {state.Year} ({Clock.EraOf(state.Year)}), {Clock.YearsPerCycle(state.Completed)} years per cycle{endless}`,
	}
	if not begun then
		table.insert(lines, "not started: the clock starts when the intro ends")
	else
		local stopped = ""
		if not running then
			local why = {}
			if devPaused then
				table.insert(why, "paused")
			end
			if halted then
				table.insert(why, "halted")
			end
			stopped = ` (stopped: {table.concat(why, ", ")})`
		end
		local sirenText = if siren then ", siren" else ""
		if openEnded then
			table.insert(lines, `{phase}: no timer, until {surgeBoss or "its boss"} is beaten{stopped}`)
		else
			table.insert(lines, `{phase} {string.format("%.1f", CycleClock:TimeLeft())} s left of {phaseLength} s{sirenText}{stopped}`)
		end
		local which = if phase == "Surge" then "this" else "next"
		local bossText = if surgeBoss then ` ({surgeBoss})` else ""
		local dueText = if state.PendingBoss then `, due: {state.PendingBoss}` else ""
		table.insert(lines, `{which} Surge: {surgeKind}{bossText}{dueText}`)
	end
	table.insert(lines, `ready {RunState.Get("ReadyCount") or 0}/{RunState.Get("ReadyNeeded") or 0}`)
	if scale ~= 1 then
		table.insert(lines, `time scale {scale}`)
	end
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("clock", {
		Description = "The cycle clock: cycle, year, phase, time left, the coming Surge, ready count.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("clock.speed", {
		Description = "Run the clock faster or slower (1 is normal).",
		Usage = "clock.speed <0.1 to 100>",
		Run = function(_player, args): string?
			local value = tonumber(args[1])
			if not value or value < 0.1 or value > MAX_TIME_SCALE then
				return `usage: clock.speed <0.1 to {MAX_TIME_SCALE}>`
			end
			setScale(value)
			return describe()
		end,
	})
	dev:Register("clock.pause", {
		Description = "Pause the clock.",
		Run = function(): string?
			devPaused = true
			freeze()
			set("Paused", true)
			return describe()
		end,
	})
	dev:Register("clock.resume", {
		Description = "Resume a paused clock.",
		Run = function(): string?
			devPaused = false
			set("Paused", nil)
			thaw()
			return describe()
		end,
	})
	dev:Register("clock.next", {
		Description = "Jump to the next moment: day to siren, siren to Surge, Surge to the next cycle.",
		Run = function(): string?
			if not begun then
				return "the clock starts when the intro ends (run.skipintro)"
			elseif not running then
				return "the clock is stopped:\n" .. describe()
			end
			if phase == "Day" and sirenAt ~= nil then
				skipToSiren("DevTools")
			elseif phase == "Day" then
				startSurge()
			else
				endSurge("Time")
			end
			return describe()
		end,
	})
	dev:Register("clock.clear", {
		Description = "End the Surge as cleared (what ThreatDirector does when it is over).",
		Run = function(): string?
			if openEnded then
				return `a boss Surge lasts until its boss is beaten: boss.beat {surgeBoss or ""}`
			end
			if not CycleClock:EndSurge() then
				return "no running Surge to clear"
			end
			return describe()
		end,
	})
	dev:Register("boss.beat", {
		Description = "Beat a boss (the current Surge's by default), as the boss fight will: its objective, its Surge ends.",
		Usage = "boss.beat [bossId]",
		Run = function(_player, args): string?
			local id = if args[1] ~= nil then tostring(args[1]) else surgeBoss
			if not id then
				return "usage: boss.beat <bossId> (no boss Surge now)"
			end
			if not objectives:BossBeaten(id) then
				return `{id}: unknown, or already beaten`
			end
			return `{id} beaten\n{describe()}`
		end,
	})
	dev:Register("year", {
		Description = "Set the year counter (bosses come only when a cycle's jump reaches an era's end).",
		Usage = "year <1 to 100, more in Endless>",
		Run = function(_player, args): string?
			local value = tonumber(args[1])
			local top = if state.Endless then 100000 else tuning.FinalYear
			if not value or value ~= math.floor(value) or value < 1 or value > top then
				return `usage: year <1 to {top}>`
			end
			local before = state.Year
			local oldEra = Clock.EraOf(before)
			state.Year = value
			publishYear()
			if phase == "Day" then
				surgeKind, surgeBoss = Clock.SurgeKind(state)
				publishSurge()
			end
			if value ~= before then
				CycleClock.YearChanged:Fire(value, before)
			end
			if Clock.EraOf(value) ~= oldEra then
				CycleClock.EraChanged:Fire(Clock.EraOf(value), oldEra)
			end
			return describe()
		end,
	})
	dev:Register("ready.all", {
		Description = "Set Ready for every player, as if each pressed the button.",
		Usage = "ready.all [true|false]",
		Run = function(_player, args): string?
			local on = args[1] ~= false
			for _, player in session:ReadyPlayers() do
				requestReady(player, on)
			end
			return describe()
		end,
	})
	dev:Register("rest.all", {
		Description = "Put every player in (or out of) a Quarters bed, as the bed interaction will.",
		Usage = "rest.all [true|false]",
		Run = function(_player, args): string?
			local on = args[1] ~= false
			for _, player in session:ReadyPlayers() do
				CycleClock:SetResting(player, on)
			end
			return describe()
		end,
	})
end

-- Lifecycle -------------------------------------------------------------------------------

function CycleClock:Init(registry)
	session = registry.SessionService
	objectives = registry.ObjectiveService
	set = RunState.Writer("CycleClock")
	tuning = Clock.Tuning()
	publishYear()
	set("ReadyCount", 0)
	set("ReadyNeeded", 0)

	Remotes.OnServer("SetReady", function(player: Player, on: boolean)
		requestReady(player, on)
	end)
	registerCommands(registry.DevService)
end

function CycleClock:Start()
	objectives.Changed:Connect(function()
		state.Completed = objectives:Completed()
		set("YearsPerCycle", Clock.YearsPerCycle(state.Completed))
	end)
	objectives.BossDefeated:Connect(function(bossId: string)
		-- A boss Surge ends when its boss falls (even if a DevTools pause holds the clock;
		-- the year then jumps on resume).
		if begun and not halted and phase == "Surge" and openEnded and surgeBoss == bossId then
			endSurge("Boss")
		end
	end)
	session.PlayerReady:Connect(function(player: Player)
		player:SetAttribute("Ready", false)
		player:SetAttribute("Resting", false)
		countReady()
	end)
	session.PlayerLeaving:Connect(function(player: Player)
		ready[player] = nil
		resting[player] = nil
		countReady(player)
	end)
	RunService.Heartbeat:Connect(tick)
end

return CycleClock
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AF"><Properties><string name="Name">DevService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DevService: DevTools commands (bible Section 23: test commands gated to Studio and
	admins).

	Services register their own commands in Init:

		registry.DevService:Register("year", {
			Description = "Set the year counter.",
			Usage = "year <number>",
			Run = function(player, args) ... return "Year is now 25" end,
		})

	Three ways in, all through Execute:
	* in a game, an allowed player types `/dev <command> [args]` in chat (DevController sends
	  the DevCommand remote; permission is checked here, never trusted from the client);
	* in a Studio playtest, tools call ServerScriptService.DevTools.Invoke (a
	  BindableFunction made only in Studio): `Invoke:Invoke("test")`;
	* in Studio, the data tests and StructureCheck run once when the server starts.

	Allowed: everyone in Studio; outside Studio only Constants.ADMIN_USER_IDS. Players get a
	DevAllowed attribute so their client can show the command.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local BuildInfo = require(Shared.BuildInfo) :: any
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local TableUtil = require(Shared.Utilities.TableUtil)
local Types = require(Shared.Types)

local log = Log.new("DevService")
local IS_STUDIO = RunService:IsStudio()
local MAX_OUTPUT = 3000

local DevService = {
	Name = "DevService",
	Dependencies = {},
}

local commands: { [string]: Types.DevCommand } = {}

function DevService:IsAllowed(player: Player?): boolean
	if IS_STUDIO then
		return true
	end
	return player ~= nil and Constants.ADMIN_USER_IDS[player.UserId] == true
end

function DevService:Register(name: string, command: Types.DevCommand)
	assert(type(name) == "string" and string.find(name, "^[%w_%.%-]+$"), "DevService: command names are words")
	assert(commands[name] == nil, `DevService: command {name} is already registered`)
	assert(type(command.Run) == "function" and type(command.Description) == "string", "DevService: bad command")
	commands[name] = command
end

-- Runs a command for a player (nil = Studio tooling). Returns ok and the output text.
function DevService:Execute(player: Player?, name: string, args: { any }): (boolean, string)
	if not DevService:IsAllowed(player) then
		return false, "not allowed"
	end
	local command = commands[name]
	if not command then
		return false, `no command {name}; try help`
	end
	local who = if player then player.Name else "studio"
	local shown = {}
	for _, arg in args do
		table.insert(shown, tostring(arg))
	end
	log:Info("%s ran %s %s", who, name, table.concat(shown, " "))
	local ok, result = xpcall(command.Run, debug.traceback, player, args)
	if not ok then
		log:Error("%s failed: %s", name, tostring(result))
		return false, `{name} failed: {tostring(result)}`
	end
	local text = if result == nil then "done" else tostring(result)
	if #text > MAX_OUTPUT then
		text = string.sub(text, 1, MAX_OUTPUT) .. "\n...(cut)"
	end
	return true, text
end

local function splitLine(line: string): (string, { any })
	local words = {}
	for word in string.gmatch(line, "%S+") do
		local number = tonumber(word)
		if word == "true" then
			table.insert(words, true)
		elseif word == "false" then
			table.insert(words, false)
		elseif number ~= nil and number == number and math.abs(number) ~= math.huge then
			table.insert(words, number)
		else
			table.insert(words, word)
		end
	end
	local name = table.remove(words, 1)
	return tostring(name or "help"), words
end

local function runChecks(): string
	local DevTools = ServerScriptService:FindFirstChild("DevTools")
	if not DevTools then
		return "DevTools folder missing"
	end
	local lines = {}
	local structure = require(DevTools:FindFirstChild("StructureCheck") :: ModuleScript) :: any
	local tests = require(DevTools:FindFirstChild("DataTests") :: ModuleScript) :: any
	table.insert(lines, structure.Format(structure.Run({ Runtime = true })))
	table.insert(lines, tests.Format(tests.Run()))
	return table.concat(lines, "\n")
end

local function registerBuiltIns()
	DevService:Register("help", {
		Description = "List commands.",
		Run = function(): string?
			local lines = {}
			for _, name in TableUtil.SortedKeys(commands) do
				local command = commands[name]
				table.insert(lines, `{command.Usage or name}: {command.Description}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	DevService:Register("version", {
		Description = "Build, place and server.",
		Run = function(): string?
			return `{Constants.GAME_NAME} {BuildInfo.Label} | {Constants.PlaceKind()} | job {game.JobId} | Studio {IS_STUDIO}`
		end,
	})
	DevService:Register("ping", {
		Description = "Round trip check.",
		Run = function(player: Player?): string?
			local who = if player then player.Name else "studio"
			return `pong {who} at {string.format("%.3f", workspace:GetServerTimeNow())}`
		end,
	})
	DevService:Register("structure", {
		Description = "Run StructureCheck (instances, scripts, remotes, config).",
		Run = function(): string?
			local DevTools = ServerScriptService:FindFirstChild("DevTools")
			local structure = require((DevTools :: Instance):FindFirstChild("StructureCheck") :: ModuleScript) :: any
			return structure.Format(structure.Run({ Runtime = true }))
		end,
	})
	DevService:Register("test", {
		Description = "Run the data tests.",
		Usage = "test [name filter]",
		Run = function(_player: Player?, args: { any }): string?
			local DevTools = ServerScriptService:FindFirstChild("DevTools")
			local tests = require((DevTools :: Instance):FindFirstChild("DataTests") :: ModuleScript) :: any
			return tests.Format(tests.Run(if args[1] then tostring(args[1]) else nil))
		end,
	})
	DevService:Register("log", {
		Description = "Show or set the server log level (Debug, Info, Warn, Error).",
		Usage = "log [level]",
		Run = function(_player: Player?, args: { any }): string?
			local level = args[1]
			if level ~= nil then
				if not Log.IsLevel(level) then
					return "levels: Debug, Info, Warn, Error"
				end
				Log.SetLevel(level :: Log.Level)
			end
			return `server log level {Log.GetLevel()}`
		end,
	})
	DevService:Register("logs", {
		Description = "The last server log lines.",
		Usage = "logs [count]",
		Run = function(_player: Player?, args: { any }): string?
			local count = if type(args[1]) == "number" then args[1] else 20
			return table.concat(Log.Recent(count), "\n")
		end,
	})
	DevService:Register("remotes", {
		Description = "Traffic and rejections per remote.",
		Run = function(): string?
			local lines = {}
			local stats = Remotes.Stats()
			for _, name in TableUtil.SortedKeys(stats) do
				local s = stats[name]
				table.insert(
					lines,
					`{name}: received {s.Received}, rejected {s.Rejected}, rate-limited {s.Limited}, failed {s.Failed}`
				)
			end
			return table.concat(lines, "\n")
		end,
	})
	DevService:Register("players", {
		Description = "Players and their session state.",
		Run = function(): string?
			local lines = {}
			for _, player in Players:GetPlayers() do
				table.insert(
					lines,
					`{player.Name} ({player.UserId}) ready={tostring(player:GetAttribute("ClientReady") == true)}`
				)
			end
			return if #lines > 0 then table.concat(lines, "\n") else "no players"
		end,
	})
end

function DevService:Init(_registry)
	registerBuiltIns()
	Remotes.OnServer("DevCommand", function(player: Player, name: string, args: { any })
		local ok, text = DevService:Execute(player, name, args)
		if not ok and text == "not allowed" then
			log:Warn("%s (%d) tried dev command %s without permission", player.Name, player.UserId, name)
			return
		end
		local prefix = if ok then "" else "error: "
		Remotes.FireClient("Notice", player, prefix .. text)
	end)
end

function DevService:Start()
	local function mark(player: Player)
		player:SetAttribute("DevAllowed", DevService:IsAllowed(player))
	end
	Players.PlayerAdded:Connect(mark)
	for _, player in Players:GetPlayers() do
		mark(player)
	end

	if IS_STUDIO then
		local DevTools = ServerScriptService:FindFirstChild("DevTools")
		if DevTools then
			local invoke = Instance.new("BindableFunction")
			invoke.Name = "Invoke"
			invoke.OnInvoke = function(line: any, ...: any): string
				if type(line) ~= "string" then
					return "usage: Invoke:Invoke(\"command arg1 arg2\")"
				end
				local name, args = splitLine(line)
				for _, extra in { ... } do
					table.insert(args, extra)
				end
				local ok, text = DevService:Execute(nil, name, args)
				return (if ok then "" else "error: ") .. text
			end
			invoke.Parent = DevTools
			if DevTools:GetAttribute("RunChecksOnStart") ~= false then
				task.defer(function()
					log:Info("Studio start checks:\n%s", runChecks())
				end)
			end
		end
	end
end

return DevService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B0"><Properties><string name="Name">EconomyService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	EconomyService: the team's shared stockpile (bible Sections 13 and 23). Run place only.

	Prompt 8 brings the stockpile itself, so construction can be paid for:
	* Every stocked resource in Config.Resources starts at its Start amount (Section 6: 300
	  Scrap, 30 Food, 30 Water, 4 Medkits, 200 Ammo; the ores start at 0).
	* Caps: each resource's Cap, plus CapPerStorageCell for every Storage cell in the bunker.
	  Adding stops at the cap. Nothing is lost when a Storage goes and a stock sits above its
	  new cap; it just can't grow.
	* Lab research so far (level 3 upgrades need it), from 0.
	* Amounts replicate as RunState values, one per resource, plus Research (Section 23: small
	  values such as resources replicate as attributes).
	Production, consumption and power come with Prompt 9 (EconomyService and PowerService).

	API:
		EconomyService:Get(id): number
		EconomyService:Stock(): { [string]: number }     -- a copy of every stocked amount
		EconomyService:Cap(id): number
		EconomyService:CanAfford(costs): (boolean, string?, number?)  -- the short resource, how much
		EconomyService:Spend(costs, reason): (boolean, string?)
		EconomyService:Add(id, amount, reason): number    -- what was added (the cap stops it)
		EconomyService:Research(): number
		EconomyService:AddResearch(amount)
		EconomyService.Changed: Signal<string>            -- a resource id, or "Research"
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("EconomyService")
local set = RunState.Writer("EconomyService")

local EconomyService = {
	Name = "EconomyService",
	Dependencies = { "BunkerGrid", "DevService" },
	Changed = Signal.new() :: Signal.Signal<string>,
}

local grid: any = nil
local stock: { [string]: number } = {}
local research = 0

local function stocked(): { string }
	local ids = {}
	for _, id in Config.Ids("Resources") do
		if Config.Get("Resources", id).Kind == "Stock" then
			table.insert(ids, id)
		end
	end
	return ids
end

local function publish(id: string)
	set(id, stock[id])
	EconomyService.Changed:Fire(id)
end

function EconomyService:Get(id: string): number
	return stock[id] or 0
end

function EconomyService:Stock(): { [string]: number }
	return table.clone(stock)
end

function EconomyService:Cap(id: string): number
	local resource = Config.Get("Resources", id)
	local cells = 0
	for _, room in grid:RoomsOfType("Storage") do
		cells += room.Span
	end
	return resource.Cap + resource.CapPerStorageCell * cells
end

function EconomyService:CanAfford(costs: { [string]: number }): (boolean, string?, number?)
	return Construction.CanAfford(costs, stock)
end

function EconomyService:Spend(costs: { [string]: number }, reason: string): (boolean, string?)
	local ok, short, missing = Construction.CanAfford(costs, stock)
	if not ok and short then
		return false, `the stockpile is {missing} {Config.Get("Resources", short).Name} short`
	end
	for id, amount in costs do
		if amount > 0 and stock[id] ~= nil then
			stock[id] -= amount
			publish(id)
		end
	end
	log:Info("spent %s on %s", Construction.CostText(costs), reason)
	return true, nil
end

function EconomyService:Add(id: string, amount: number, reason: string): number
	assert(stock[id] ~= nil, `EconomyService: {id} isn't a stocked resource`)
	assert(amount >= 0 and amount == amount, "EconomyService: Add takes a positive amount (Spend takes away)")
	local room = math.max(0, EconomyService:Cap(id) - stock[id])
	local added = math.min(math.floor(amount), room)
	if added > 0 then
		stock[id] += added
		publish(id)
		log:Debug("+%d %s (%s)", added, id, reason)
	end
	return added
end

function EconomyService:Research(): number
	return research
end

function EconomyService:AddResearch(amount: number)
	assert(amount >= 0 and amount == amount, "EconomyService: AddResearch takes a positive amount")
	research += amount
	set("Research", research)
	EconomyService.Changed:Fire("Research")
end

-- DevTools ----------------------------------------------------------------------------------------

local function describe(): string
	local lines = {}
	for _, id in stocked() do
		table.insert(lines, `{id} {stock[id]}/{EconomyService:Cap(id)}`)
	end
	return "stockpile: " .. table.concat(lines, ", ") .. `; research {research}`
end

local function resourceId(text: any): string?
	if type(text) ~= "string" then
		return nil
	end
	for _, id in stocked() do
		if string.lower(id) == string.lower(text) then
			return id
		end
	end
	return nil
end

function EconomyService:Init(registry)
	grid = registry.BunkerGrid
	local dev = registry.DevService
	dev:Register("stock", {
		Description = "The team's stockpile and its caps.",
		Usage = "stock",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("stock.set", {
		Description = "Set a resource's amount (ignores the cap).",
		Usage = "stock.set <resource> <amount>",
		Run = function(_player: Player, args): string?
			local id, amount = resourceId(args[1]), tonumber(args[2])
			if not id or not amount or amount < 0 then
				return "usage: stock.set <resource> <amount>"
			end
			stock[id] = math.floor(amount)
			publish(id)
			return describe()
		end,
	})
	dev:Register("stock.add", {
		Description = "Add to a resource (up to its cap).",
		Usage = "stock.add <resource> <amount>",
		Run = function(_player: Player, args): string?
			local id, amount = resourceId(args[1]), tonumber(args[2])
			if not id or not amount or amount < 0 then
				return "usage: stock.add <resource> <amount>"
			end
			EconomyService:Add(id, amount, "DevTools")
			return describe()
		end,
	})
	dev:Register("research", {
		Description = "Lab research so far; with an amount, add that much.",
		Usage = "research [amount]",
		Run = function(_player: Player, args): string?
			local amount = tonumber(args[1])
			if amount and amount > 0 then
				EconomyService:AddResearch(amount)
			end
			return `research {research}`
		end,
	})
end

function EconomyService:Start()
	for _, id in stocked() do
		stock[id] = Config.Get("Resources", id).Start
		publish(id)
	end
	set("Research", research)
	log:Debug("stockpile ready: %s", describe())
end

return EconomyService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B1"><Properties><string name="Name">ObjectiveService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ObjectiveService: the run's big objectives (bible Sections 5, 12 and 23): Lost Crews
	rescued and era bosses beaten. Each one done adds its YearsPerCycle (Config.Objectives:
	+2 a crew, +1 a boss) to Years per Cycle, which CycleClock reads. Run place only.

	Prompt 3 keeps the record. The systems that rescue crews (Prompts 16 and 17) and beat the
	bosses (Prompts 15, 23 and 24) call Complete or BossBeaten. A boss's death is also what
	ends its Surge: boss Surges have no timer (Landon, Nov 8, 2026), so CycleClock listens to
	BossDefeated. The Source has no objective; beating it ends the final Surge (a Century
	Victory) or, in its chamber, wins the Deep Victory.

	API:
		ObjectiveService:Complete(objectiveId): boolean       -- false if unknown or already done
		ObjectiveService:BossBeaten(bossId): boolean          -- a boss died: its objective (if any), BossDefeated
		ObjectiveService:IsComplete(objectiveId): boolean
		ObjectiveService:Completed(): { [string]: boolean }   -- frozen copy
		ObjectiveService:Counts(): (number, number)           -- Lost Crews rescued, era bosses beaten
		ObjectiveService.Changed: Signal<string>              -- the objective just completed
		ObjectiveService:IsBossBeaten(bossId): boolean
		ObjectiveService.BossDefeated: Signal<string>         -- the boss just beaten (once per boss)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("ObjectiveService")

local ObjectiveService = {
	Name = "ObjectiveService",
	Dependencies = { "DevService" },
	Changed = Signal.new() :: Signal.Signal<string>,
	BossDefeated = Signal.new() :: Signal.Signal<string>,
}

local completed: { [string]: boolean } = {}
local defeated: { [string]: boolean } = {} -- bosses beaten this run
local snapshot: { [string]: boolean } = table.freeze({})
local set: ((string, any) -> ())? = nil

local function counts(): (number, number)
	local crews, bosses = 0, 0
	for id in completed do
		local objective = Config.Get("Objectives", id)
		if objective.Kind == "LostCrew" then
			crews += 1
		elseif objective.Kind == "Boss" then
			bosses += 1
		end
	end
	return crews, bosses
end

local function publish()
	local crews, bosses = counts()
	if set then
		set("LostCrews", crews)
		set("BossesBeaten", bosses)
	end
end

local function complete(objective: { [string]: any }): boolean
	if completed[objective.Id] then
		return false
	end
	completed[objective.Id] = true
	snapshot = table.freeze(table.clone(completed))
	publish()
	log:Info("%s done (+%d Years per Cycle)", objective.Name, objective.YearsPerCycle)
	ObjectiveService.Changed:Fire(objective.Id)
	return true
end

-- A Lost Crew rescued, or an era boss beaten (which is BossBeaten for that boss).
function ObjectiveService:Complete(objectiveId: string): boolean
	local objective = Config.Find("Objectives", objectiveId)
	if not objective then
		log:Warn("no objective %s", tostring(objectiveId))
		return false
	end
	if objective.Kind == "Boss" and objective.Boss and not completed[objective.Id] then
		return ObjectiveService:BossBeaten(objective.Boss)
	end
	return complete(objective)
end

function ObjectiveService:BossBeaten(bossId: string): boolean
	if not Config.Find("Bosses", bossId) then
		log:Warn("no boss %s", tostring(bossId))
		return false
	end
	if defeated[bossId] then
		return false
	end
	defeated[bossId] = true
	for _, objective in Config.All("Objectives") do
		if objective.Kind == "Boss" and objective.Boss == bossId then
			complete(objective)
		end
	end
	log:Info("%s beaten", bossId)
	ObjectiveService.BossDefeated:Fire(bossId)
	return true
end

function ObjectiveService:IsBossBeaten(bossId: string): boolean
	return defeated[bossId] == true
end

function ObjectiveService:IsComplete(objectiveId: string): boolean
	return completed[objectiveId] == true
end

function ObjectiveService:Completed(): { [string]: boolean }
	return snapshot
end

function ObjectiveService:Counts(): (number, number)
	return counts()
end

function ObjectiveService:Init(registry)
	set = RunState.Writer("ObjectiveService")
	publish()

	registry.DevService:Register("objectives", {
		Description = "List the run's objectives and which are done.",
		Run = function(): string?
			local lines = {}
			for _, objective in Config.All("Objectives") do
				local mark = if completed[objective.Id] then "done" else "    "
				table.insert(lines, `{mark} {objective.Id}: {objective.Name} (+{objective.YearsPerCycle})`)
			end
			local crews, bosses = counts()
			table.insert(lines, `Lost Crews {crews}, era bosses {bosses}`)
			return table.concat(lines, "\n")
		end,
	})
	registry.DevService:Register("objective", {
		Description = "Complete an objective (a Lost Crew rescued or an era boss beaten).",
		Usage = "objective <id>",
		Run = function(_player, args): string?
			local id = tostring(args[1] or "")
			if not Config.Find("Objectives", id) then
				return `no objective {id}; ids: {table.concat(Config.Ids("Objectives"), ", ")}`
			end
			if not ObjectiveService:Complete(id) then
				return `{id} was already done`
			end
			return `{id} done`
		end,
	})
end

return ObjectiveService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B2"><Properties><string name="Name">PingService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	PingService: cell pings (bible Section 7: "Ping any cell; it shows on every player's
	mini-map"). Run place only.

	A player pings a cell from the Command View (the PingCell remote: floor, column). The
	server checks the cell is on the grid and the player's session is ready (the remote's rate
	limit stops spam), then tells every ready player (CellPinged: floor, column, the pinger's
	UserId and display name). Clients show the ping on the mini-map and in the Command View for
	Tuning.Ping.Seconds.

	The world ping (the Ping action in play, and the Rally ping of Section 11) comes with combat
	and residents and will go through here too.

	API:
		PingService:Ping(player, floor, column): (boolean, string?)
		PingService.Pinged: Signal<Player, number, number>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("PingService")

local PingService = {
	Name = "PingService",
	Dependencies = { "SessionService", "DevService" },
	Pinged = Signal.new() :: Signal.Signal<Player, number, number>,
}

local session: any = nil
local sent = 0

function PingService:Ping(player: Player, floor: number, column: number): (boolean, string?)
	if not session:IsReady(player) then
		return false, "not ready yet"
	elseif not Grid.OnGrid(floor, column) then
		return false, "off the grid"
	end
	sent += 1
	Remotes.FireClients("CellPinged", session:ReadyPlayers(), floor, column, player.UserId, player.DisplayName)
	log:Debug("%s pinged %s", player.Name, Grid.Key(floor, column))
	PingService.Pinged:Fire(player, floor, column)
	return true, nil
end

function PingService:Init(registry)
	session = registry.SessionService
	Remotes.OnServer("PingCell", function(player: Player, floor: number, column: number)
		PingService:Ping(player, floor, column)
	end)
	registry.DevService:Register("cell.ping", {
		Description = "Ping a cell as if from the Command View (every player sees it on the mini-map).",
		Usage = "cell.ping <floor> <column>",
		Run = function(player: Player, args): string?
			local floor, column = tonumber(args[1]), tonumber(args[2])
			if not floor or not column then
				return "usage: cell.ping <floor> <column>"
			end
			local ok, why = PingService:Ping(player, floor, column)
			return if ok then `pinged {Grid.Key(floor, column)} ({sent} pings this run)` else `not pinged: {why}`
		end,
	})
end

return PingService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B3"><Properties><string name="Name">ProfileService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileService: saved data (bible Section 23; Prompt 2). One profile per player, in both
	places.

	The stored value is a record { Data = profile, Lock = { Session, PlaceId, At }, Meta }.
	Every read-modify-write goes through UpdateAsync:
	* load claims the lock: a fresh lock held by another server means wait and retry (it may
	  be saving on the way out, as when a player teleports from the Lobby), and in the end
	  refuse; a stale lock (a crashed server) is taken over. Data newer than this server's
	  ProfileSchema.VERSION is never loaded or written.
	* the profile then goes through migrate, reconcile, validate (ProfileSchema.Load). A failed
	  or refused load kicks the player with a message and writes nothing.
	* saves happen every Constants.AUTOSAVE_SECONDS (staggered per player; each also refreshes
	  the lock), when the player leaves (and releases the lock) and on shutdown (BindToClose).
	  A save only writes if this server still holds the lock and the profile still validates.

	Gameplay never touches DataStores: it calls Update, AddGlowshards, SpendGlowshards and
	GrantPurchase. The player's own client sees their profile (minus receipts) in the
	"Profiles" collection of the delta channel. A session isn't ready until the profile loads
	(the "Profile" gate in SessionService).

	In Studio the store is PlayerProfiles_Studio, so tests never touch live saves; if Studio
	has no API access, an in-memory store stands in (and says so).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local TableUtil = require(Shared.Utilities.TableUtil)
local ProfileSchema = require(ServerScriptService:WaitForChild("Lib"):WaitForChild("ProfileSchema"))

local log = Log.new("ProfileService")

local IS_STUDIO = RunService:IsStudio()
local STORE_NAME = if IS_STUDIO then "PlayerProfiles_Studio" else "PlayerProfiles"
local SESSION_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local LOCK_STALE_SECONDS = if IS_STUDIO then 30 else Constants.AUTOSAVE_SECONDS * 3
local CLAIM_ATTEMPTS = 8
local CLAIM_WAIT_SECONDS = 2
local CALL_ATTEMPTS = 4
local SHUTDOWN_WAIT_SECONDS = if IS_STUDIO then 8 else 25
local GATE = "Profile"

local MESSAGES: { [string]: string } = {
	Locked = "Your save is still being written by another server. Please rejoin in a moment.",
	TooNew = "Your save is from a newer version of the game. Please rejoin to get an up-to-date server.",
	Corrupt = "We couldn't read your save, so nothing was changed. Please rejoin; if this keeps happening, let us know.",
	Invalid = "We couldn't read your save, so nothing was changed. Please rejoin; if this keeps happening, let us know.",
	Error = "Saved data is unavailable right now (Roblox DataStores). Please rejoin in a few minutes.",
	LockLost = "Your save was opened in another server, so this one stopped. Please rejoin.",
}

export type Profile = { [string]: any }

type Session = {
	Player: Player,
	Key: string,
	Data: Profile,
	Receipts: { [string]: boolean },
	Saving: boolean,
	Released: boolean,
	LockLost: boolean,
	NextSave: number,
	Saves: number,
}

local ProfileService = {
	Name = "ProfileService",
	Dependencies = { "SessionService", "ReplicationService", "DevService" },
	Loaded = Signal.new() :: Signal.Signal<Player, Profile>,
	Releasing = Signal.new() :: Signal.Signal<Player>,
}

local sessions: { [Player]: Session } = {}
local loading: { [Player]: boolean } = {}
local sessionService: any = nil
local profiles: any = nil
local store: any = nil
local storeKind = "none"
local usingDataStore = false
local shuttingDown = false
local releasesInFlight = 0

-- An in-memory store with DataStore semantics (values go through JSON, as they would).
local function memoryStore(): any
	local values: { [string]: string } = {}
	local memory = {}
	function memory.UpdateAsync(_self: any, key: string, transform: (any) -> any): any
		local current = values[key]
		local result = transform(if current then HttpService:JSONDecode(current) else nil)
		if result ~= nil then
			values[key] = HttpService:JSONEncode(result)
		end
		return result
	end
	function memory.GetAsync(_self: any, key: string): any
		local current = values[key]
		return if current then HttpService:JSONDecode(current) else nil
	end
	function memory.RemoveAsync(_self: any, key: string): any
		local current = values[key]
		values[key] = nil
		return if current then HttpService:JSONDecode(current) else nil
	end
	return memory
end

local function keyFor(userId: number): string
	return `Player_{userId}`
end

-- Calls a DataStore function with retries and backoff. Returns ok and its result or error.
local function attempt(what: string, call: () -> any): (boolean, any)
	local delay = 1
	local lastError: any = nil
	for try = 1, CALL_ATTEMPTS do
		local ok, result = pcall(call)
		if ok then
			return true, result
		end
		lastError = result
		log:Warn("%s failed (try %d of %d): %s", what, try, CALL_ATTEMPTS, tostring(result))
		if try < CALL_ATTEMPTS then
			task.wait(delay)
			delay = math.min(delay * 2, 8)
		end
	end
	return false, lastError
end

local function isForeignLock(lock: any): boolean
	return type(lock) == "table"
		and lock.Session ~= SESSION_ID
		and type(lock.At) == "number"
		and os.time() - lock.At < LOCK_STALE_SECONDS
end

local function isTooNew(data: any): boolean
	return type(data) == "table" and type(data.Version) == "number" and data.Version > ProfileSchema.VERSION
end

-- Claims a key's lock. Returns "Claimed" and the stored Data (nil for a new player), or
-- "Locked", "TooNew", "Corrupt" or "Error" (and the error).
local function claim(key: string): (string, any)
	local status, stored = "Error", nil
	local ok, err = attempt(`claim {key}`, function(): any
		status, stored = "Error", nil
		return store:UpdateAsync(key, function(old: any): any
			if old ~= nil and (type(old) ~= "table" or (old.Data ~= nil and type(old.Data) ~= "table")) then
				status = "Corrupt"
				return nil
			end
			local record = old or {}
			if isForeignLock(record.Lock) then
				status = "Locked"
				return nil
			end
			if isTooNew(record.Data) then
				status = "TooNew"
				return nil
			end
			record.Lock = { Session = SESSION_ID, PlaceId = game.PlaceId, At = os.time() }
			if type(record.Meta) ~= "table" then
				record.Meta = { Created = os.time(), Saves = 0 }
			end
			status, stored = "Claimed", record.Data
			return record
		end)
	end)
	if not ok then
		return "Error", tostring(err)
	end
	return status, stored
end

-- Gives a lock back without touching the data (after a load we can't use).
local function releaseLockOnly(key: string)
	attempt(`release {key}`, function(): any
		return store:UpdateAsync(key, function(old: any): any
			if type(old) ~= "table" or type(old.Lock) ~= "table" or old.Lock.Session ~= SESSION_ID then
				return nil
			end
			old.Lock = nil
			return old
		end)
	end)
end

-- Writes the session's profile (and releases the lock if asked). Only if we still hold it.
local function write(session: Session, release: boolean): boolean
	local valid, why = ProfileSchema.Validate(session.Data)
	if not valid then
		log:Error("%s: not saving an invalid profile (%s)", session.Key, tostring(why))
		return false
	end
	local data = session.Data
	local status = "Error"
	local ok, err = attempt(`save {session.Key}`, function(): any
		status = "Error"
		return store:UpdateAsync(session.Key, function(old: any): any
			local record = if type(old) == "table" then old else {}
			local lock = record.Lock
			if type(lock) ~= "table" or lock.Session ~= SESSION_ID then
				status = "LockLost"
				return nil
			end
			if isTooNew(record.Data) then
				status = "TooNew"
				return nil
			end
			record.Data = data
			record.Lock = if release then nil else { Session = SESSION_ID, PlaceId = game.PlaceId, At = os.time() }
			local meta = if type(record.Meta) == "table" then record.Meta else {}
			meta.Saves = (tonumber(meta.Saves) or 0) + 1
			meta.LastSave = os.time()
			meta.LastPlace = game.PlaceId
			record.Meta = meta
			status = "Saved"
			return record
		end)
	end)
	if not ok then
		log:Error("couldn't save %s: %s", session.Key, tostring(err))
		return false
	end
	if status == "LockLost" then
		session.LockLost = true
		log:Error("%s: the save lock is gone; not writing over another server", session.Key)
		if session.Player.Parent == Players and not release then
			session.Player:Kick(MESSAGES.LockLost)
		end
		return false
	end
	if status ~= "Saved" then
		log:Error("%s: save refused (%s)", session.Key, status)
		return false
	end
	session.Saves += 1
	return true
end

-- One write at a time per player; a release waits for a running save, then finishes.
local function save(session: Session, release: boolean): boolean
	while session.Saving do
		task.wait(0.1)
	end
	if session.Released or session.LockLost then
		return false
	end
	session.Saving = true
	local ok = write(session, release)
	session.Saving = false
	session.NextSave = os.clock() + Constants.AUTOSAVE_SECONDS
	if release then
		session.Released = true
	end
	return ok
end

local function publish(session: Session)
	local key = tostring(session.Player.UserId)
	if profiles:Get(key) == nil then
		profiles:Set(key, ProfileSchema.Public(session.Data))
	else
		profiles:Patch(key, ProfileSchema.Public(session.Data))
	end
end

local function load(player: Player)
	if loading[player] or sessions[player] then
		return
	end
	loading[player] = true
	local key = keyFor(player.UserId)
	local status, stored = "Locked", nil
	for try = 1, CLAIM_ATTEMPTS do
		status, stored = claim(key)
		if status ~= "Locked" or player.Parent ~= Players then
			break
		end
		log:Info("%s's save is open in another server; waiting (%d of %d)", player.Name, try, CLAIM_ATTEMPTS)
		task.wait(CLAIM_WAIT_SECONDS)
	end
	loading[player] = nil
	if status ~= "Claimed" then
		log:Error("%s: profile not loaded (%s %s)", player.Name, status, tostring(stored))
		if player.Parent == Players then
			sessionService:Fail(player, MESSAGES[status] or MESSAGES.Error)
		end
		return
	end
	local data, loadStatus, why = ProfileSchema.Load(stored)
	if not data then
		releaseLockOnly(key)
		log:Error("%s: profile %s (%s); nothing written", player.Name, loadStatus, tostring(why))
		if player.Parent == Players then
			sessionService:Fail(player, MESSAGES[loadStatus] or MESSAGES.Invalid)
		end
		return
	end
	local session: Session = {
		Player = player,
		Key = key,
		Data = data,
		Receipts = {},
		Saving = false,
		Released = false,
		LockLost = false,
		NextSave = os.clock() + (player.UserId % Constants.AUTOSAVE_SECONDS) + 5,
		Saves = 0,
	}
	for _, receiptId in data.Receipts do
		session.Receipts[receiptId] = true
	end
	if player.Parent ~= Players then
		release(session) -- left while loading: write what we migrated and let go
		return
	end
	sessions[player] = session
	publish(session)
	player:SetAttribute("ProfileLoaded", true)
	log:Info("%s: profile %s, %d Glowshards", player.Name, loadStatus, data.Glowshards)
	ProfileService.Loaded:Fire(player, data)
	sessionService:Pass(player, GATE)
end

-- Saves and lets go of a session; shutdown waits for every release in flight.
local function release(session: Session)
	releasesInFlight += 1
	local ok, err = pcall(save, session, true)
	releasesInFlight -= 1
	if not ok then
		log:Error("%s: release failed: %s", session.Key, tostring(err))
	end
end

local function leave(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	ProfileService.Releasing:Fire(player)
	profiles:Remove(tostring(player.UserId))
	release(session)
end

-- Public API --------------------------------------------------------------------------------

function ProfileService:IsLoaded(player: Player): boolean
	return sessions[player] ~= nil
end

-- The live profile (read it; change it only through Update).
function ProfileService:Get(player: Player): Profile?
	local session = sessions[player]
	return if session then session.Data else nil
end

--[[
	Changes a profile. `change` edits the table it is given and must not yield. If it errors or
	leaves the profile invalid, every change is undone and Update returns false. Changes are
	replicated to the player and saved with the next save.
]]
function ProfileService:Update(player: Player, change: (Profile) -> ()): boolean
	local session = sessions[player]
	if not session or session.Released then
		return false
	end
	local data = session.Data
	local backup = TableUtil.DeepCopy(data)
	local ok, err = pcall(change, data)
	local valid, why = true, nil
	if ok then
		valid, why = ProfileSchema.Validate(data)
	end
	if not ok or not valid then
		table.clear(data)
		for field, value in backup do
			data[field] = value
		end
		log:Error("%s: profile change undone (%s)", player.Name, tostring(if ok then why else err))
		return false
	end
	publish(session)
	return true
end

function ProfileService:AddGlowshards(player: Player, amount: number, reason: string): boolean
	assert(amount >= 0 and amount % 1 == 0, "AddGlowshards: a whole, positive amount")
	local ok = ProfileService:Update(player, function(data)
		data.Glowshards += amount
	end)
	if ok then
		log:Info("%s +%d Glowshards (%s)", player.Name, amount, reason)
	end
	return ok
end

-- Spends Glowshards if the player has enough. Returns false (and changes nothing) otherwise.
function ProfileService:SpendGlowshards(player: Player, amount: number, reason: string): boolean
	assert(amount >= 0 and amount % 1 == 0, "SpendGlowshards: a whole, positive amount")
	local data = ProfileService:Get(player)
	if not data or data.Glowshards < amount then
		return false
	end
	local ok = ProfileService:Update(player, function(profile)
		profile.Glowshards -= amount
	end)
	if ok then
		log:Info("%s -%d Glowshards (%s)", player.Name, amount, reason)
	end
	return ok
end

-- Saves now (yields). True when the profile is safely stored.
function ProfileService:SaveNow(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and save(session, false)
end

function ProfileService:HasReceipt(player: Player, receiptId: string): boolean
	local session = sessions[player]
	return session ~= nil and session.Receipts[receiptId] == true
end

--[[
	For ProcessReceipt (bible Section 17): grant first, record the receipt id in the profile,
	save, and only then tell Roblox it was granted. A repeated receipt is never granted twice:
	if the id is already recorded, the grant is skipped and only the save is redone.
]]
function ProfileService:GrantPurchase(player: Player, receiptId: string, grant: (Profile) -> ()): Enum.ProductPurchaseDecision
	local session = sessions[player]
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not session.Receipts[receiptId] then
		local ok = ProfileService:Update(player, function(data)
			grant(data)
			ProfileSchema.AddReceipt(data, receiptId)
		end)
		if not ok then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		session.Receipts[receiptId] = true
	end
	if save(session, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- DevTools ---------------------------------------------------------------------------------

local function targetOf(player: Player?, arg: any): Player?
	if type(arg) == "number" then
		return Players:GetPlayerByUserId(arg)
	end
	return player or Players:GetPlayers()[1]
end

local function summary(data: Profile): string
	local classes = TableUtil.SortedKeys(data.Classes)
	local legends = TableUtil.SortedKeys(data.Legends)
	return `v{data.Version}, {data.Glowshards} Glowshards, account level {data.AccountLevel}, `
		.. `classes {table.concat(classes :: { any }, "/")}, Legends {table.concat(legends :: { any }, "/")}, `
		.. `receipts {#data.Receipts}, first run done {tostring(data.FirstRunDone)}`
end

-- Runs the lock rules against a scratch key (Studio store only).
local function lockTest(): string
	local key = `Test_{SESSION_ID}`
	local lines = {}
	local function step(name: string, expected: string, got: string)
		table.insert(lines, `{if got == expected then "ok  " else "FAIL"} {name}: {got} (expected {expected})`)
	end
	store:RemoveAsync(key)
	step("new key", "Claimed", (claim(key)))
	store:UpdateAsync(key, function(old: any): any
		old.Lock = { Session = "another-server", PlaceId = 1, At = os.time() }
		return old
	end)
	step("fresh foreign lock", "Locked", (claim(key)))
	store:UpdateAsync(key, function(old: any): any
		old.Lock.At = os.time() - LOCK_STALE_SECONDS - 5
		return old
	end)
	step("stale foreign lock", "Claimed", (claim(key)))
	store:UpdateAsync(key, function(_old: any): any
		return { Data = { Version = ProfileSchema.VERSION + 1, Glowshards = 7 } }
	end)
	step("newer version", "TooNew", (claim(key)))
	local after = store:GetAsync(key)
	step("newer data untouched", "untouched", if after.Lock == nil and after.Data.Glowshards == 7 then "untouched" else "changed")
	store:UpdateAsync(key, function(_old: any): any
		return "garbage"
	end)
	step("corrupt record", "Corrupt", (claim(key)))
	store:RemoveAsync(key)
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("profile", {
		Description = "A player's profile (yours, or by user id).",
		Usage = "profile [userId]",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			local data = target and ProfileService:Get(target)
			if not target or not data then
				return "no loaded profile"
			end
			local session = sessions[target] :: Session
			return `{target.Name}: {summary(data)} | store {storeKind}, saves {session.Saves}`
		end,
	})
	dev:Register("profile.add", {
		Description = "Give Glowshards (testing).",
		Usage = "profile.add <amount> [userId]",
		Run = function(player: Player?, args: { any }): string?
			local amount = tonumber(args[1])
			local target = targetOf(player, args[2])
			if not amount or amount < 0 or amount % 1 ~= 0 or not target then
				return "usage: profile.add <whole amount> [userId]"
			end
			local ok = ProfileService:AddGlowshards(target, amount, "dev command")
			return if ok then `{target.Name} now has {(ProfileService:Get(target) :: Profile).Glowshards}` else "failed"
		end,
	})
	dev:Register("profile.save", {
		Description = "Save a profile now.",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			if not target then
				return "no player"
			end
			return if ProfileService:SaveNow(target) then `saved {target.Name}` else "save failed (see logs)"
		end,
	})
	dev:Register("profile.raw", {
		Description = "Read a stored record straight from the store (read-only).",
		Usage = "profile.raw [userId]",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			local userId = if type(args[1]) == "number" then args[1] else target and target.UserId
			if not userId then
				return "no player"
			end
			local ok, record = attempt("read", function(): any
				return store:GetAsync(keyFor(userId))
			end)
			if not ok then
				return `read failed: {tostring(record)}`
			end
			if record == nil then
				return "no record"
			end
			local lock = record.Lock
			local lockText = if type(lock) == "table"
				then `{if lock.Session == SESSION_ID then "this server" else tostring(lock.Session)}, {os.time() - (lock.At or 0)} s ago`
				else "none"
			local data = record.Data
			local dataText = if type(data) == "table" then summary(data) else "no data yet"
			local meta = record.Meta or {}
			return `lock: {lockText} | saves {tostring(meta.Saves)} | {dataText}`
		end,
	})
	dev:Register("profile.receipt", {
		Description = "Grant a test purchase through the receipt path (Studio only).",
		Usage = "profile.receipt <receiptId> <glowshards>",
		Run = function(player: Player?, args: { any }): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			local target = targetOf(player, nil)
			local receiptId, amount = tostring(args[1] or ""), tonumber(args[2])
			if not target or receiptId == "" or not amount or amount < 0 or amount % 1 ~= 0 then
				return "usage: profile.receipt <receiptId> <whole amount>"
			end
			local decision = ProfileService:GrantPurchase(target, receiptId, function(data)
				data.Glowshards += amount
			end)
			return `{decision.Name}; {target.Name} has {(ProfileService:Get(target) :: Profile).Glowshards} Glowshards`
		end,
	})
	dev:Register("profile.locktest", {
		Description = "Run the lock rules against a scratch key (Studio only).",
		Run = function(): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			return lockTest()
		end,
	})
end

-- Lifecycle --------------------------------------------------------------------------------

function ProfileService:Init(registry)
	sessionService = registry.SessionService
	sessionService:AddGate(GATE)
	profiles = registry.ReplicationService:Collection("Profiles", {
		Visible = function(player: Player, key: string): boolean
			return key == tostring(player.UserId)
		end,
	})
	registerCommands(registry.DevService)
end

function ProfileService:Start()
	local ok, result = pcall(function(): any
		local dataStore = DataStoreService:GetDataStore(STORE_NAME)
		dataStore:GetAsync("Probe")
		return dataStore
	end)
	if ok then
		store, storeKind, usingDataStore = result, `DataStore {STORE_NAME}`, true
	elseif IS_STUDIO then
		store, storeKind = memoryStore(), "memory (Studio has no DataStore access)"
		log:Warn("DataStores unavailable in this Studio session (%s): profiles live in memory only", tostring(result))
	else
		store, storeKind, usingDataStore = DataStoreService:GetDataStore(STORE_NAME), `DataStore {STORE_NAME}`, true
		log:Error("DataStore probe failed (%s); loads will retry", tostring(result))
	end
	log:Info("profiles in %s", storeKind)

	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(leave)

	game:BindToClose(function()
		shuttingDown = true
		for player, session in sessions do
			sessions[player] = nil
			task.spawn(release, session)
		end
		local waited = 0
		while (releasesInFlight > 0 or next(loading) ~= nil) and waited < SHUTDOWN_WAIT_SECONDS do
			waited += task.wait(0.2)
		end
		log:Info("shutdown: profiles released (%d still in flight after %.1f s)", releasesInFlight, waited)
	end)

	task.spawn(function()
		while not shuttingDown do
			task.wait(5)
			local now = os.clock()
			local budget = if usingDataStore
				then DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
				else math.huge
			for _, session in sessions do
				if budget > 10 and not session.Saving and now >= session.NextSave then
					budget -= 1
					task.spawn(save, session, false)
				end
			end
		end
	end)
end

return ProfileService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B4"><Properties><string name="Name">ReplicationService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ReplicationService: the server end of the delta channel (bible Section 23: collections
	such as rooms, residents and votes go through one delta channel; small values replicate
	as attributes instead).

	A system keeps its replicated state in collections:

		local Rooms = ReplicationService:Collection("Rooms")
		Rooms:Set("R12", { Kind = "Kitchen", Level = 1, Cell = { 2, 3 } })
		Rooms:Patch("R12", { Level = 2 })          -- only Level travels
		Rooms:Remove("R12")

	Changes are batched and flushed Constants.DELTA_HZ times a second to every ready player
	(SessionService); a player who becomes ready first gets a snapshot. Values must be
	remote-safe (Utilities.Delta.IsRemoteSafe); they are copied and frozen when set, so later
	edits to the caller's table can't leak into replicated state.

	A collection can be per-player with `Visible = function(player, key) -> boolean`
	(an inventory only its owner sees). Clients read collections through ReplicaController.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Constants = require(Shared.Constants)
local Delta = require(Shared.Utilities.Delta)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local TableUtil = require(Shared.Utilities.TableUtil)

local log = Log.new("ReplicationService")
local IS_STUDIO = RunService:IsStudio()

export type CollectionOptions = {
	Visible: ((player: Player, key: string) -> boolean)?,
}

export type Collection = {
	Name: string,
	Set: (self: Collection, key: string, value: any) -> (),
	Patch: (self: Collection, key: string, fields: { [string]: any }) -> (),
	Remove: (self: Collection, key: string) -> (),
	Clear: (self: Collection) -> (),
	Get: (self: Collection, key: string) -> any,
	All: (self: Collection) -> { [string]: any },
	Count: (self: Collection) -> number,
}

type State = {
	Name: string,
	Values: { [string]: any },
	Visible: ((player: Player, key: string) -> boolean)?,
}

local ReplicationService = {
	Name = "ReplicationService",
	Dependencies = { "SessionService", "DevService" },
}

local states: { [string]: State } = {}
local collections: { [string]: Collection } = {}
local pending: { Delta.Op } = {}
local counters = { Flushes = 0, OpsQueued = 0, EventsSent = 0, Snapshots = 0 }
local sessions: any = nil

local function queue(op: Delta.Op)
	table.insert(pending, op)
	counters.OpsQueued += 1
end

local function assertKey(state: State, key: any)
	if type(key) ~= "string" or key == "" then
		error(`{state.Name}: keys must be non-empty strings, got {tostring(key)}`, 3)
	end
end

local function assertSafe(state: State, key: string, value: any)
	local ok, why = Delta.IsRemoteSafe(value)
	if not ok then
		local message = `{state.Name}.{key} can't replicate: {why}`
		if IS_STUDIO then
			error(message, 3)
		end
		log:Error("%s", message)
	end
end

local CollectionClass = {}
CollectionClass.__index = CollectionClass

function CollectionClass.Set(self: any, key: string, value: any)
	local state: State = self._state
	assertKey(state, key)
	if value == nil then
		CollectionClass.Remove(self, key)
		return
	end
	assertSafe(state, key, value)
	if TableUtil.DeepEqual(state.Values[key], value) then
		return
	end
	local frozen = TableUtil.DeepFreeze(TableUtil.DeepCopy(value))
	state.Values[key] = frozen
	queue({ Delta.SET, state.Name, key, frozen })
end

function CollectionClass.Patch(self: any, key: string, fields: { [string]: any })
	local state: State = self._state
	assertKey(state, key)
	local old = state.Values[key]
	if type(old) ~= "table" then
		error(`{state.Name}.{key}: Patch needs an existing table value (use Set first)`, 2)
	end
	assertSafe(state, key, fields)
	local merged = Delta.Merge(old, TableUtil.DeepCopy(fields))
	local diff = Delta.Diff(old, merged)
	if not diff then
		return
	end
	state.Values[key] = TableUtil.DeepFreeze(merged)
	queue({ Delta.PATCH, state.Name, key, TableUtil.DeepFreeze(diff) })
end

function CollectionClass.Remove(self: any, key: string)
	local state: State = self._state
	assertKey(state, key)
	if state.Values[key] == nil then
		return
	end
	state.Values[key] = nil
	queue({ Delta.REMOVE, state.Name, key })
end

function CollectionClass.Clear(self: any)
	local state: State = self._state
	if next(state.Values) == nil then
		return
	end
	table.clear(state.Values)
	queue({ Delta.CLEAR, state.Name })
end

function CollectionClass.Get(self: any, key: string): any
	return self._state.Values[key]
end

-- A shallow copy of the whole collection (the values themselves are frozen).
function CollectionClass.All(self: any): { [string]: any }
	return table.clone(self._state.Values)
end

function CollectionClass.Count(self: any): number
	return TableUtil.Count(self._state.Values)
end

-- The named collection, created on first use. Options only apply when it's created.
function ReplicationService:Collection(name: string, options: CollectionOptions?): Collection
	assert(type(name) == "string" and string.find(name, "^[%a_][%w_]*$"), "Collection names are identifiers")
	local existing = collections[name]
	if existing then
		if options and options.Visible ~= states[name].Visible then
			error(`Collection {name} already exists with other options`, 2)
		end
		return existing
	end
	local state: State = { Name = name, Values = {}, Visible = options and options.Visible }
	states[name] = state
	local collection: Collection = setmetatable({ Name = name, _state = state }, CollectionClass) :: any
	collections[name] = collection
	return collection
end

local function visibleOps(player: Player, ops: { Delta.Op }): { Delta.Op }
	local list = {}
	for _, op in ops do
		local state = states[op[2]]
		local visible = state and state.Visible
		if visible == nil or op[1] == Delta.CLEAR then
			table.insert(list, op)
		else
			local ok, result = pcall(visible, player, op[3])
			if ok and result then
				table.insert(list, op)
			elseif not ok then
				log:Error("%s.Visible failed: %s", op[2], tostring(result))
			end
		end
	end
	return list
end

local function snapshotFor(player: Player): { Delta.Op }
	local ops: { Delta.Op } = {}
	for _, name in TableUtil.SortedKeys(states) do
		local state = states[name]
		for key, value in state.Values do
			table.insert(ops, { Delta.SET, name, key, value })
		end
	end
	return visibleOps(player, ops)
end

local function flush()
	if #pending == 0 then
		return
	end
	local ops = pending
	pending = {}
	counters.Flushes += 1
	local players = sessions:ReadyPlayers()
	if #players == 0 then
		return
	end
	local anyPerPlayer = false
	for _, op in ops do
		local state = states[op[2]]
		if state and state.Visible then
			anyPerPlayer = true
			break
		end
	end
	if not anyPerPlayer then
		Remotes.FireClients("Delta", players, ops, false)
		counters.EventsSent += #players
		return
	end
	for _, player in players do
		local list = visibleOps(player, ops)
		if #list > 0 then
			Remotes.FireClient("Delta", player, list, false)
			counters.EventsSent += 1
		end
	end
end

function ReplicationService:Init(registry)
	sessions = registry.SessionService
	local dev = registry.DevService

	dev:Register("rep", {
		Description = "Delta channel: collections, sizes and traffic.",
		Run = function(_player: Player?, _args: { any }): string?
			local lines = {
				("flushes %d, ops queued %d, events sent %d, snapshots %d, pending %d"):format(
					counters.Flushes,
					counters.OpsQueued,
					counters.EventsSent,
					counters.Snapshots,
					#pending
				),
			}
			for _, name in TableUtil.SortedKeys(states) do
				local state = states[name]
				local scope = if state.Visible then " (per player)" else ""
				table.insert(lines, `  {name}: {TableUtil.Count(state.Values)} values{scope}`)
			end
			return table.concat(lines, "\n")
		end,
	})

	dev:Register("rep.selftest", {
		Description = "Runs set, patch and remove on the _SelfTest collection; compare with `/dev replica _SelfTest` on a client.",
		Run = function(_player: Player?, _args: { any }): string?
			local test = ReplicationService:Collection("_SelfTest")
			test:Clear()
			test:Set("Alpha", { Count = 1, Label = "first", Tags = { "a", "b" } })
			test:Patch("Alpha", { Count = 2, Label = Delta.NONE })
			test:Set("Beta", { Count = 10 })
			test:Remove("Beta")
			test:Set("Gamma", { Where = Vector3.new(1, 2, 3), Done = true })
			test:Set("Stamp", { At = workspace:GetServerTimeNow() })
			return "queued: Alpha {Count=2, Tags={a,b}}, Gamma {Where=1,2,3, Done=true}, Stamp; Beta removed"
		end,
	})
end

function ReplicationService:Start()
	sessions.PlayerReady:Connect(function(player: Player)
		local ops = snapshotFor(player)
		Remotes.FireClient("Delta", player, ops, true)
		counters.Snapshots += 1
		log:Debug("snapshot to %s: %d values", player.Name, #ops)
	end)
	local interval = 1 / Constants.DELTA_HZ
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt: number)
		elapsed += dt
		if elapsed >= interval then
			elapsed = 0
			flush()
		end
	end)
end

-- Server-side view of a collection's values (for DevTools and tests).
function ReplicationService:Peek(name: string): { [string]: any }?
	local state = states[name]
	return if state then table.clone(state.Values) else nil
end

return ReplicationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B5"><Properties><string name="Name">RunDirector</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RunDirector: the run's lifecycle, how it ends, and Endless (bible Sections 4, 5 and 23;
	named so it never clashes with Roblox's RunService). Run place only.

		Waiting -> Intro -> Playing -> Ended (-> Playing again in Endless after Keep Going)

	* Waiting until the first player's session is ready (Prompt 21 adds waiting for the
	  party list the lobby writes to MemoryStore).
	* Intro: 30 seconds. The run clock starts at the 30-second mark for everyone, so a player
	  who skips the cutscene (personal, from 2 seconds in, Prompt 22) gains nothing.
	* Playing: CycleClock runs the cycles.
	* Victory: Century (the final Surge survived; CycleClock reports it) or Deep (the Source
	  destroyed in its chamber at depth 10; Prompt 25 calls Win("Deep")). After a victory the
	  team can Keep Going (a vote, Prompt 8): the run carries on in Endless.
	* Defeat: the Reactor Core is destroyed or the last resident dies (the systems that own
	  them call Lose). Players dying never loses the run.
	* The results screen (Prompt 15) reads Summary(); Play Again and Return to Lobby are
	  Prompt 21.

	API:
		RunDirector:Phase(): RunPhase
		RunDirector:Win(kind: "Century" | "Deep"): boolean
		RunDirector:Lose(reason: "ReactorDestroyed" | "ResidentsLost"): boolean
		RunDirector:KeepGoing(): boolean
		RunDirector:Summary(): Summary
		RunDirector.PhaseChanged: Signal<RunPhase, RunPhase>   -- new, old
		RunDirector.RunEnded: Signal<Summary>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Log = require(Shared.Utilities.Log)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("RunDirector")
local IS_STUDIO = RunService:IsStudio()

export type RunPhase = RunState.RunPhase
export type VictoryKind = "Century" | "Deep"
export type DefeatReason = "ReactorDestroyed" | "ResidentsLost"
export type Summary = {
	Outcome: RunState.Outcome?,
	DefeatReason: DefeatReason?,
	Victory: VictoryKind?,
	Endless: boolean,
	Year: number,
	Cycle: number,
	Era: string,
	Difficulty: string,
	Seconds: number, -- played time, from the end of the intro
	Players: { number }, -- user ids of everyone who played in this run
}

local RunDirector = {
	Name = "RunDirector",
	Dependencies = { "SessionService", "CycleClock", "DevService" },
	PhaseChanged = Signal.new() :: Signal.Signal<RunPhase, RunPhase>,
	RunEnded = Signal.new() :: Signal.Signal<Summary>,
}

local session: any = nil
local clock: any = nil
local set: (string, any) -> () = function() end

local phase: RunPhase = "Waiting"
local difficulty = "Normal"
local outcome: RunState.Outcome? = nil
local defeatReason: DefeatReason? = nil
local victory: VictoryKind? = nil
local endless = false
local playingSince: number? = nil
local playedSeconds = 0
local played: { [number]: boolean } = {}

local function setPhase(new: RunPhase)
	local old = phase
	if old == new then
		return
	end
	phase = new
	set("RunPhase", new)
	log:Info("run: %s -> %s", old, new)
	RunDirector.PhaseChanged:Fire(new, old)
end

local function introSeconds(): number
	local devTools = ServerScriptService:FindFirstChild("DevTools")
	if IS_STUDIO and devTools and devTools:GetAttribute("SkipIntro") == true then
		return 0
	end
	return Config.Get("Tuning", "Clock").IntroSeconds
end

local function startPlaying()
	if phase ~= "Intro" then
		return
	end
	set("IntroEndsAt", nil)
	setPhase("Playing")
	playingSince = os.clock()
	clock:Begin()
end

local function startIntro()
	if phase ~= "Waiting" then
		return
	end
	local seconds = introSeconds()
	set("IntroEndsAt", workspace:GetServerTimeNow() + seconds)
	setPhase("Intro")
	task.delay(seconds, startPlaying)
end

local function finish(result: RunState.Outcome, reason: DefeatReason?)
	clock:Halt()
	outcome = result
	defeatReason = reason
	if playingSince then
		playedSeconds += os.clock() - playingSince
		playingSince = nil
	end
	set("Outcome", result)
	set("DefeatReason", reason)
	setPhase("Ended")
	local summary = RunDirector:Summary()
	log:Info("run over: %s %s in Year %d, cycle %d", result, reason or "", summary.Year, summary.Cycle)
	RunDirector.RunEnded:Fire(summary)
end

function RunDirector:Phase(): RunPhase
	return phase
end

-- A victory (Century: the final Surge survived; Deep: the Source destroyed in its chamber).
function RunDirector:Win(kind: VictoryKind): boolean
	assert(kind == "Century" or kind == "Deep", "RunDirector:Win takes Century or Deep")
	if phase ~= "Playing" or endless then
		return false
	end
	victory = kind
	set("Victory", kind)
	finish(if kind == "Century" then "CenturyVictory" else "DeepVictory", nil)
	return true
end

-- The bunker falls (the Reactor Core destroyed, or the last resident dead).
function RunDirector:Lose(reason: DefeatReason): boolean
	assert(reason == "ReactorDestroyed" or reason == "ResidentsLost", "RunDirector:Lose takes ReactorDestroyed or ResidentsLost")
	if phase ~= "Playing" then
		return false
	end
	finish("Defeat", reason)
	return true
end

-- Keep Going passed after a victory: the run carries on in Endless.
function RunDirector:KeepGoing(): boolean
	if phase ~= "Ended" or victory == nil or outcome == "Defeat" or endless then
		return false
	end
	endless = true
	outcome = nil
	set("Endless", true)
	set("Outcome", nil)
	clock:SetEndless(true)
	setPhase("Playing")
	playingSince = os.clock()
	clock:Resume()
	return true
end

function RunDirector:Summary(): Summary
	local ids = {}
	for userId in played do
		table.insert(ids, userId)
	end
	table.sort(ids)
	return {
		Outcome = outcome,
		DefeatReason = defeatReason,
		Victory = victory,
		Endless = endless,
		Year = clock:Year(),
		Cycle = clock:Cycle(),
		Era = clock:Era(),
		Difficulty = difficulty,
		Seconds = playedSeconds + (if playingSince then os.clock() - playingSince else 0),
		Players = ids,
	}
end

local function describe(): string
	local summary = RunDirector:Summary()
	local lines = { `run {phase}, {difficulty}, Year {summary.Year}, cycle {summary.Cycle}, played {string.format("%.0f", summary.Seconds)} s` }
	if phase == "Intro" then
		table.insert(lines, `intro: {string.format("%.1f", RunState.TimeLeft() or 0)} s left`)
	end
	if outcome then
		local reason = if defeatReason then ` ({defeatReason})` else ""
		table.insert(lines, `outcome: {outcome}{reason}`)
	end
	if victory then
		local now = if endless then ", now Endless" else ""
		table.insert(lines, `victory: {victory}{now}`)
	end
	table.insert(lines, `players: {#summary.Players}`)
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("run", {
		Description = "The run's phase, outcome and summary.",
		Run = function(): string?
			return describe()
		end,
	})
	dev:Register("run.skipintro", {
		Description = "End the intro now and start the clock.",
		Run = function(): string?
			if phase ~= "Intro" then
				return `no intro running (run is {phase})`
			end
			startPlaying()
			return describe()
		end,
	})
	dev:Register("run.win", {
		Description = "Win the run (Century or Deep).",
		Usage = "run.win <century|deep>",
		Run = function(_player, args): string?
			local word = string.lower(tostring(args[1] or ""))
			local kind: VictoryKind? = if word == "century" then "Century" elseif word == "deep" then "Deep" else nil
			if not kind then
				return "usage: run.win <century|deep>"
			end
			if not RunDirector:Win(kind) then
				local mode = if endless then ", Endless" else ""
				return `can't win now (run is {phase}{mode})`
			end
			return describe()
		end,
	})
	dev:Register("run.lose", {
		Description = "Lose the run (the Reactor Core destroyed, or the last resident dead).",
		Usage = "run.lose <reactor|residents>",
		Run = function(_player, args): string?
			local word = string.lower(tostring(args[1] or ""))
			local reason: DefeatReason? = if word == "reactor" then "ReactorDestroyed" elseif word == "residents" then "ResidentsLost" else nil
			if not reason then
				return "usage: run.lose <reactor|residents>"
			end
			if not RunDirector:Lose(reason) then
				return `can't lose now (run is {phase})`
			end
			return describe()
		end,
	})
	dev:Register("run.keepgoing", {
		Description = "Keep Going after a victory: carry on in Endless.",
		Run = function(): string?
			if not RunDirector:KeepGoing() then
				return `can't keep going (run is {phase}, outcome {tostring(outcome)})`
			end
			return describe()
		end,
	})
end

function RunDirector:Init(registry)
	session = registry.SessionService
	clock = registry.CycleClock
	set = RunState.Writer("RunDirector")
	set("RunPhase", phase)
	set("Difficulty", difficulty)
	set("Endless", false)
	registerCommands(registry.DevService)
end

function RunDirector:Start()
	clock.CenturySurvived:Connect(function()
		RunDirector:Win("Century")
	end)
	local function onReady(player: Player)
		played[player.UserId] = true
		startIntro()
	end
	session.PlayerReady:Connect(onReady)
	for _, player in session:ReadyPlayers() do
		onReady(player)
	end
end

return RunDirector
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B6"><Properties><string name="Name">SessionService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SessionService: player sessions in this server (infrastructure, Prompt 0; gates Prompt 2).

	A player is "ready" once every gate has passed: the client has bootstrapped (the
	ClientReady remote) and each gate a service added (ProfileService adds "Profile": the save
	has loaded). Services that send a player state wait for PlayerReady instead of
	PlayerAdded, so nothing is sent before the client can receive it or before the player's
	data exists.

	API:
		SessionService:AddGate(name)           -- in Init: one more thing a session waits for
		SessionService:Pass(player, name)      -- that thing is done for this player
		SessionService:Fail(player, message)   -- it can't be done: the player is kicked
		SessionService.PlayerReady: Signal<Player>
		SessionService.PlayerLeaving: Signal<Player>
		SessionService:IsReady(player): boolean
		SessionService:ReadyPlayers(): { Player }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("SessionService")

local SessionService = {
	Name = "SessionService",
	Dependencies = {},
	PlayerReady = Signal.new() :: Signal.Signal<Player>,
	PlayerLeaving = Signal.new() :: Signal.Signal<Player>,
}

local CLIENT_GATE = "Client"
local gates: { string } = { CLIENT_GATE }
local passed: { [Player]: { [string]: boolean } } = {}
local ready: { [Player]: number } = {}

local function checkReady(player: Player)
	if ready[player] or player.Parent ~= Players then
		return
	end
	local done = passed[player]
	if not done then
		return
	end
	for _, gate in gates do
		if not done[gate] then
			return
		end
	end
	ready[player] = os.clock()
	player:SetAttribute("SessionReady", true)
	log:Debug("%s ready", player.Name)
	SessionService.PlayerReady:Fire(player)
end

function SessionService:AddGate(name: string)
	assert(not table.find(gates, name), `SessionService: gate {name} already exists`)
	table.insert(gates, name)
end

function SessionService:Pass(player: Player, gate: string)
	assert(table.find(gates, gate), `SessionService: no gate {gate}`)
	local done = passed[player]
	if not done then
		done = {}
		passed[player] = done
	end
	if done[gate] then
		return
	end
	done[gate] = true
	checkReady(player)
end

function SessionService:Fail(player: Player, message: string)
	log:Warn("%s can't start a session: %s", player.Name, message)
	player:Kick(message)
end

function SessionService:Init(_registry)
	Remotes.OnServer("ClientReady", function(player: Player)
		if player.Parent ~= Players then
			return
		end
		player:SetAttribute("ClientReady", true)
		SessionService:Pass(player, CLIENT_GATE)
	end)
end

function SessionService:Start()
	Players.PlayerRemoving:Connect(function(player: Player)
		SessionService.PlayerLeaving:Fire(player)
		ready[player] = nil
		passed[player] = nil
	end)
end

function SessionService:IsReady(player: Player): boolean
	return ready[player] ~= nil
end

function SessionService:ReadyPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if ready[player] then
			table.insert(list, player)
		end
	end
	return list
end

-- Which gates a player has passed (for DevTools).
function SessionService:Gates(player: Player): { [string]: boolean }
	local result: { [string]: boolean } = {}
	local done = passed[player] or {}
	for _, gate in gates do
		result[gate] = done[gate] == true
	end
	return result
end

return SessionService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B7"><Properties><string name="Name">VoteService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VoteService: team votes (bible Section 8). Run place only.

	Anything that spends the shared stockpile or changes the run for everyone goes to a quick
	vote. Prompt 8 runs construction votes (BuildService opens them). Push Deeper (Prompt 14),
	the blueprint draft (19), Keep Going (15), Let them in? (30) and kicks (30) will open theirs
	here too.

	How a vote runs:
	* One vote is live on the banner at a time. Later proposals wait in a queue, and each gets
	  its full time once it goes live, so nothing runs out of time unseen.
	* The proposer counts as a yes. Not voting is abstaining, and a player can change their
	  vote until it closes.
	* Rules (Rules.Votes):
	  * a build passes with more yes than no after 15 s;
	  * spending more than 40% of a stock needs a majority of the whole team;
	  * everyone yes passes at once;
	  * ties fail. A tie-breaker (the Warden, Prompt 20) can pass one: SetTieBreaker.
	* Each player has at most one open proposal (queued or live). A failed one gives that
	  player a 20 s cooldown.
	* Solo runs have no votes: a proposal is checked again and applies at once.
	* When a vote passes, its Check runs again (costs, the cells still free). If that fails
	  now, the vote fails with the reason.
	* The Votes collection (id -> what the banner shows) replicates to every player. A closed
	  vote stays ResultSeconds with PASSED or FAILED, then goes.
	* Studio: `vote.bots <n> [yes|no|abstain]` adds pretend voters to the team, so the team
	  rules can be tried in a one-player playtest.

	API:
		VoteService:Open(spec): (string?, string?)     -- the vote id ("solo" when it applied at once), or why not
		VoteService:Cast(player, id, "Yes" | "No"): (boolean, string?)
		VoteService:CanPropose(player): (boolean, string?)
		VoteService:Reserved(exceptId?): { [string]: boolean }  -- cell keys held by open votes
		VoteService:TeamSize(): number
		VoteService:SetTieBreaker(fn: (voteId) -> boolean)
		VoteService.Opened: Signal<string>, VoteService.Closed: Signal<string, boolean, string?>
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Config = require(Shared.Config)
local Construction = require(Shared.Rules.Construction)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local Votes = require(Shared.Rules.Votes)

local log = Log.new("VoteService")

export type Spec = {
	Kind: string, -- a Config.Votes id
	Proposer: Player?, -- nil for votes the game opens
	Title: string, -- what is proposed: "KITCHEN", "QUARTERS TO LEVEL 2"
	Costs: { [string]: number }?, -- shown on the banner; a big spend needs a team majority
	Subject: { Floor: number, Column: number, Span: number, Label: string }?, -- the ghost outline
	Cells: { string }?, -- cell keys it holds while open
	Check: (() -> (boolean, string?))?, -- run again when it passes
	OnPass: () -> (),
	OnFail: ((reason: string) -> ())?,
}

type Ballot = "Yes" | "No"
type Status = "Queued" | "Live" | "Passed" | "Failed"
type Vote = {
	Id: string,
	Spec: Spec,
	Rule: Votes.Rule,
	Status: Status,
	Ballots: { [number]: Ballot }, -- by UserId; pretend voters are negative
	EndsAt: number?,
	Result: string?,
}

local VoteService = {
	Name = "VoteService",
	Dependencies = { "SessionService", "ReplicationService", "DevService" },
	Opened = Signal.new() :: Signal.Signal<string>,
	Closed = Signal.new() :: Signal.Signal<string, boolean, string?>,
}

local session: any = nil
local collection: any = nil
local votes: { [string]: Vote } = {}
local queue: { string } = {} -- open votes in order; the first is live
local cooldowns: { [number]: number } = {} -- UserId -> os.clock() it ends
local nextId = 0
local tieBreaker: ((string) -> boolean)? = nil
local bots: { [number]: Ballot | false } = {} -- Studio: pretend voters (-1, -2, ...); false abstains

local function now(): number
	return workspace:GetServerTimeNow()
end

local function tuning(): { [string]: any }
	return Votes.Tuning()
end

-- Everyone who can vote: ready players, plus pretend voters in Studio.
local function team(): { number }
	local ids = {}
	for _, player in session:ReadyPlayers() do
		table.insert(ids, player.UserId)
	end
	for id in bots do
		table.insert(ids, id)
	end
	return ids
end

function VoteService:TeamSize(): number
	return #team()
end

local function count(vote: Vote): (number, number, number)
	local members = team()
	local yes, no = 0, 0
	for _, id in members do
		local ballot = vote.Ballots[id]
		if ballot == "Yes" then
			yes += 1
		elseif ballot == "No" then
			no += 1
		end
	end
	return yes, no, #members
end

local function nameOf(player: Player?): string
	return if player then string.upper(player.DisplayName) else "THE BUNKER"
end

local function publish(vote: Vote)
	local yes, no, size = count(vote)
	local ballots = {}
	for id, ballot in vote.Ballots do
		ballots[tostring(id)] = ballot
	end
	local position = table.find(queue, vote.Id)
	local spec = vote.Spec
	collection:Set(vote.Id, {
		Kind = spec.Kind,
		Title = spec.Title,
		Proposer = if spec.Proposer then spec.Proposer.UserId else 0,
		ProposerName = nameOf(spec.Proposer),
		Cost = if spec.Costs then Construction.CostText(spec.Costs) else "",
		Rule = vote.Rule,
		Need = Votes.NeedText(vote.Rule, size),
		Status = vote.Status,
		EndsAt = vote.EndsAt,
		Seconds = Config.Get("Votes", spec.Kind).Seconds,
		Yes = yes,
		No = no,
		Team = size,
		Waiting = if position and position > 1 then position - 1 else 0,
		Ballots = ballots,
		Subject = spec.Subject,
		Result = vote.Result,
	})
end

local function publishQueue()
	for _, id in queue do
		local vote = votes[id]
		if vote then
			publish(vote)
		end
	end
end

local function stockNow(): { [string]: number }
	local stockpile = {}
	for _, resource in Config.Ids("Resources") do
		local value = RunState.Fields[resource] and RunState.Get(resource)
		if type(value) == "number" then
			stockpile[resource] = value
		end
	end
	return stockpile
end

local function goLive()
	local id = queue[1]
	local vote = if id then votes[id] else nil
	if not vote or vote.Status ~= "Queued" then
		return
	end
	vote.Status = "Live"
	-- the 40% rule against the stockpile as it is when the team votes
	vote.Rule = Votes.RuleFor(vote.Spec.Kind, Votes.BigSpend(vote.Spec.Costs, stockNow()))
	vote.EndsAt = now() + Config.Get("Votes", vote.Spec.Kind).Seconds
	for botId, ballot in bots do
		if ballot then
			vote.Ballots[botId] = ballot
		end
	end
	log:Info("%s live: %s (%s)", vote.Id, vote.Spec.Title, vote.Rule)
	VoteService.Opened:Fire(vote.Id)
	publishQueue()
end

local function close(vote: Vote, passed: boolean, reason: string?)
	if vote.Status ~= "Live" and vote.Status ~= "Queued" then
		return
	end
	if passed and vote.Spec.Check then
		local ok, why = vote.Spec.Check()
		if not ok then
			passed, reason = false, why or "it can't be done any more"
		end
	end
	vote.Status = if passed then "Passed" else "Failed"
	vote.Result = if passed then "PASSED" else `FAILED: {string.upper(reason or "not enough yes")}`
	local index = table.find(queue, vote.Id)
	if index then
		table.remove(queue, index)
	end
	local spec = vote.Spec
	if passed then
		local ok, err = pcall(spec.OnPass)
		if not ok then
			log:Error("%s passed but OnPass failed: %s", vote.Id, tostring(err))
		end
	else
		if spec.Proposer then
			cooldowns[spec.Proposer.UserId] = os.clock() + tuning().FailedCooldownSeconds
		end
		if spec.OnFail then
			local ok, err = pcall(spec.OnFail :: any, reason or "not enough yes")
			if not ok then
				log:Error("%s OnFail failed: %s", vote.Id, tostring(err))
			end
		end
	end
	log:Info("%s %s: %s", vote.Id, string.lower(vote.Status), reason or "")
	publish(vote)
	VoteService.Closed:Fire(vote.Id, passed, reason)
	task.delay(tuning().ResultSeconds, function()
		votes[vote.Id] = nil
		collection:Remove(vote.Id)
	end)
	goLive()
	publishQueue()
end

local function decide(vote: Vote)
	local yes, no, size = count(vote)
	local result = Votes.Outcome(vote.Rule, yes, no, size)
	if result == "Tie" and tieBreaker then
		local ok, pass = pcall(tieBreaker :: any, vote.Id)
		if ok and pass == true then
			close(vote, true, nil)
			return
		end
	end
	if result == "Pass" then
		close(vote, true, nil)
	elseif result == "Tie" then
		close(vote, false, "a tie")
	else
		close(vote, false, if vote.Rule == "MoreYes" then "more no than yes" else "not enough of the team said yes")
	end
end

-- API ---------------------------------------------------------------------------------------------

function VoteService:CanPropose(player: Player): (boolean, string?)
	if RunState.Get("RunPhase") ~= "Playing" then
		return false, "The run isn't under way."
	end
	if not session:IsReady(player) then
		return false, "You're not in the run yet."
	end
	for _, id in queue do
		local vote = votes[id]
		if vote and vote.Spec.Proposer == player then
			return false, "You already have a proposal open."
		end
	end
	local ends = cooldowns[player.UserId]
	if ends and os.clock() < ends then
		return false, `You can propose again in {math.ceil(ends - os.clock())} s.`
	end
	return true, nil
end

function VoteService:Reserved(exceptId: string?): { [string]: boolean }
	local cells = {}
	for _, id in queue do
		local vote = votes[id]
		if vote and id ~= exceptId and vote.Spec.Cells then
			for _, key in vote.Spec.Cells do
				cells[key] = true
			end
		end
	end
	return cells
end

function VoteService:Open(spec: Spec): (string?, string?)
	assert(Config.Find("Votes", spec.Kind), `VoteService: no vote kind {spec.Kind}`)
	if spec.Proposer then
		local ok, why = VoteService:CanPropose(spec.Proposer)
		if not ok then
			return nil, why
		end
	end
	-- Solo: no vote; check it and apply it at once (Section 8, rule 6).
	if tuning().SoloSkipsVotes and VoteService:TeamSize() <= 1 then
		if spec.Check then
			local ok, why = spec.Check()
			if not ok then
				return nil, why
			end
		end
		local ok, err = pcall(spec.OnPass)
		if not ok then
			log:Error("solo: %s failed to apply: %s", spec.Title, tostring(err))
			return nil, "That couldn't be done (see the server log)."
		end
		log:Info("solo: %s applied at once", spec.Title)
		return "solo", nil
	end
	nextId += 1
	local id = `V{nextId}`
	local vote: Vote = {
		Id = id,
		Spec = spec,
		Rule = Votes.RuleFor(spec.Kind, Votes.BigSpend(spec.Costs, stockNow())),
		Status = "Queued",
		Ballots = {},
	}
	if spec.Proposer then
		vote.Ballots[spec.Proposer.UserId] = "Yes"
	end
	votes[id] = vote
	table.insert(queue, id)
	log:Info("%s opened by %s: %s, %s", id, nameOf(spec.Proposer), spec.Title, vote.Rule)
	if #queue == 1 then
		goLive()
	else
		publish(vote)
	end
	return id, nil
end

function VoteService:Cast(player: Player, id: string, ballot: Ballot): (boolean, string?)
	local vote = votes[id]
	if not vote or vote.Status ~= "Live" then
		return false, "That vote isn't open."
	end
	if not session:IsReady(player) then
		return false, "You're not in the run yet."
	end
	vote.Ballots[player.UserId] = ballot
	local yes, _, size = count(vote)
	if Votes.AllYes(yes, size) then
		close(vote, true, nil)
	else
		publish(vote)
	end
	return true, nil
end

function VoteService:SetTieBreaker(fn: (string) -> boolean)
	tieBreaker = fn
end

-- Lifecycle --------------------------------------------------------------------------------------

local function alert(player: Player, kind: string, text: string)
	Remotes.FireClient("Alert", player, kind, text)
end

local function describe(): string
	if #queue == 0 then
		return `no open votes; team {VoteService:TeamSize()}`
	end
	local lines = {}
	for _, id in queue do
		local vote = votes[id]
		if vote then
			local yes, no, size = count(vote)
			local left = if vote.EndsAt then string.format(", %.0f s left", math.max(0, vote.EndsAt - now())) else ""
			table.insert(lines, `{id} {vote.Status} {vote.Spec.Title}: {yes} yes, {no} no of {size} ({vote.Rule}{left})`)
		end
	end
	return table.concat(lines, "\n")
end

function VoteService:Init(registry)
	session = registry.SessionService
	collection = registry.ReplicationService:Collection("Votes")
	Remotes.OnServer("CastVote", function(player: Player, id: string, ballot: string)
		local ok, why = VoteService:Cast(player, id, ballot :: Ballot)
		if not ok and why then
			alert(player, "Info", why)
		end
	end)
	local dev = registry.DevService
	dev:Register("votes", {
		Description = "Open votes, their tallies and time left.",
		Usage = "votes",
		Run = function(): string?
			return describe()
		end,
	})
	for _, ballot in { "Yes", "No" } do
		dev:Register(`vote.{string.lower(ballot)}`, {
			Description = `Vote {string.lower(ballot)} on the live vote, as you or as pretend voter n.`,
			Usage = `vote.{string.lower(ballot)} [n]`,
			Run = function(player: Player, args): string?
				local id = queue[1]
				local vote = if id then votes[id] else nil
				if not vote or vote.Status ~= "Live" then
					return "no live vote"
				end
				local bot = tonumber(args[1])
				if bot then
					if bots[-bot] == nil then
						return `no pretend voter {bot}`
					end
					vote.Ballots[-bot] = ballot :: Ballot
					local yes, _, size = count(vote)
					if Votes.AllYes(yes, size) then
						close(vote, true, nil)
					else
						publish(vote)
					end
				else
					VoteService:Cast(player, id :: string, ballot :: Ballot)
				end
				return describe()
			end,
		})
	end
	dev:Register("vote.test", {
		Description = "Open a vote the game proposes (no proposer, no effect), to try the queue and the telegram.",
		Usage = "vote.test [title]",
		Run = function(_player: Player, args): string?
			local title = string.upper(tostring(args[1] or "TEST VOTE"))
			local id, why = VoteService:Open({
				Kind = "Build",
				Title = title,
				OnPass = function()
					log:Info("test vote %s passed", title)
				end,
			})
			return if id then `opened {id}\n{describe()}` else `not opened: {why}`
		end,
	})
	dev:Register("vote.end", {
		Description = "Time is up on the live vote now.",
		Usage = "vote.end",
		Run = function(): string?
			local id = queue[1]
			local vote = if id then votes[id] else nil
			if not vote or vote.Status ~= "Live" then
				return "no live vote"
			end
			decide(vote)
			return describe()
		end,
	})
	dev:Register("vote.bots", {
		Description = "Studio: n pretend voters join the team, voting yes, no or abstaining on each vote as it goes live.",
		Usage = "vote.bots <n> [yes|no|abstain]",
		Run = function(_player: Player, args): string?
			if not RunService:IsStudio() then
				return "pretend voters are for Studio"
			end
			local n = math.clamp(math.floor(tonumber(args[1]) or 0), 0, 5)
			local stance = string.lower(tostring(args[2] or "abstain"))
			local ballot: Ballot? = if stance == "yes" then "Yes" elseif stance == "no" then "No" else nil
			table.clear(bots)
			for i = 1, n do
				bots[-i] = ballot or false
			end
			publishQueue()
			return `{n} pretend voter(s), {stance}; team {VoteService:TeamSize()}`
		end,
	})
end

function VoteService:Start()
	task.spawn(function()
		while true do
			task.wait(0.25)
			local id = queue[1]
			local vote = if id then votes[id] else nil
			if vote and vote.Status == "Live" and vote.EndsAt and now() >= vote.EndsAt then
				decide(vote)
			end
		end
	end)
	session.PlayerLeaving:Connect(function(_player: Player)
		task.defer(publishQueue) -- the team is smaller: tallies and needs change
	end)
	session.PlayerReady:Connect(function(_player: Player)
		publishQueue()
	end)
end

return VoteService
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX000000BA"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX000000BA"><Properties><string name="Name">Documentation</string></Properties><Item class="ModuleScript" referent="RBX000000BA"><Properties><string name="Name">ARCHITECTURE</string><ProtectedString name="Source"><![CDATA[--!strict
return [=[
# 100 Years Of Fallout: ARCHITECTURE

The living map of the code (bible Section 23). Every prompt updates it. The bible wins: if
this document, the code and the bible disagree, the bible is right and the difference is a
bug or a Bible Question.

## Places

| Place | Id | Players | Role |
|---|---|---|---|
| Lobby (start place) | 135073046693952 | 30 | hub, shops, Legends Hall, quests, leaderboards, elevator pads |
| Run (reserved servers) | 72892455946761 | 6 | the bunker, the surface and the Deep |

Both places run the same shared code, bootstraps and infrastructure services. Each adds its
own services and controllers on top (Run: RunDirector, BunkerGrid...; Lobby: PadService,
ClassShopService...). `Constants.PlaceKind()` says which place is running.

## Where code lives (both places)

```
ReplicatedStorage
  Shared                         (Folder) code both sides run
    BuildInfo                    which build is installed; written by the installer
    Constants                    identity and engine limits (never gameplay numbers)
    Types                        types that cross module or network boundaries
    Remotes                      the one list of RemoteEvents + the only API to use them
    RunState                     the run's small values, replicated as attributes on it (Run)
    UIContract                   the parts of the UI layout the code uses (StructureCheck checks them)
    Config                       content aggregator; one child ModuleScript per content type
    Rules                        pure game rules both sides share (Clock, Grid, Bunker, CameraRig, Hud)
    Utilities                    Check, Delta, Loader, Log, RateLimit, Signal, TableUtil, Trove
ServerScriptService
  Bootstrap                      (Script) the only server script
  Services                       one ModuleScript per service
  Lib                            server-only modules that aren't services (ProfileSchema; Run: BunkerKit)
  DevTools                       StructureCheck, DataTests (+ Invoke in Studio playtests)
StarterPlayer.StarterPlayerScripts
  ClientBootstrap                (LocalScript) the only client script
  Controllers                    one ModuleScript per controller
  Lib                            client-only modules that aren't controllers (Fade, KitRuntime, UIKit, UISamples)
StarterGui
  Reticle                        the aim sight (built in Studio, studio/ui/Reticle.lua)
  Frame                          The Frame, the one menu layout (both places; studio/ui/Frame.lua)
  HUD                            the run HUD (Run; studio/ui/HUD.lua)
ServerStorage
  Documentation.ARCHITECTURE     this document
  Assets                         models from the art pipeline (Run)
  ArtPipeline.AssetSetup         art pipeline helper (Run; not game code)
```

Rules: only the two bootstraps are scripts; everything else is a ModuleScript. No `_G`, no
`shared`: modules `require` each other. Server-only code never goes in ReplicatedStorage.
Objects named `A0_...` (showroom, sample screens) are art-pipeline samples, allowed until
gameplay replaces them; the A0 sample screens now sit in `ServerStorage.UIArchive` (Run).

## Where code comes from

The source of truth is the repo `landonhjones2020-bit/100years-assets`, folder `game/`
(Rojo naming: `init.luau` makes the folder a module, `.server.luau` is a Script,
`.client.luau` a LocalScript). `game/shared`, `game/server`, `game/client` and `game/docs`
go to both places; `game/places/<Place>/...` only to that place.

`tools/game_sync.py build` turns the tree into one Model asset (`exports/Code/GameCode.rbxmx`,
holding a Lobby and a Run variant), which is uploaded through Open Cloud like the art and
installed into each place by the Luau that `tools/game_sync.py install <assetId> <Place>`
prints. The install replaces the managed folders wholesale and refuses to run if a script was
edited in Studio since the last install (StructureCheck's Sources check), so nothing written
in Studio is lost: bring such edits back into the repo first.

## Lifecycle

Server: `Bootstrap` → `Remotes.Setup()` → `Loader.Collect(Services)` → every `Init` in
dependency order → every `Start` on its own thread → `ReplicatedStorage` attributes
`PlaceKind`, `Build`, `ServerReady` (and `ServerBroken` if a service failed).

Client: `ClientBootstrap` → every controller's `Init`, then `Start` → waits for `ServerReady`
→ fires `ClientReady` → the server marks the session ready and sends the snapshot.

## Writing a service or controller

```lua
--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)

local log = Log.new("CycleClock")

local CycleClock = {
	Name = "CycleClock",                 -- must equal the ModuleScript name
	Dependencies = { "DevService" },    -- only these can be read from the registry
}

function CycleClock:Init(registry)     -- wire up: remotes, signals, dev commands. No loops.
	registry.DevService:Register("year", { Description = "...", Run = function(player, args) ... end })
end

function CycleClock:Start()            -- runs after every Init: loops, timers, world state
end

return CycleClock
```

* Top-level code in a module has no side effects (StructureCheck requires modules at edit
  time to validate them). Do the work in `Init` and `Start`.
* `Init` must not yield or loop; it is timed and anything over 0.5 s is reported.
* A module whose `Init` errors is reported; modules depending on it are skipped, and the
  server sets `ServerBroken`.
* Talk across modules through methods and Signals the other module exposes, never by
  reaching into its internals.

## Networking

* Every RemoteEvent is an entry in `Shared.Remotes` (`To`, `Args`, `Rate`, `Doc`, and `Place`
  for remotes only one place has). Nothing else creates remotes; StructureCheck flags any that
  appear elsewhere.
* Clients send intentions (propose this room, fire at this point), never results. Each
  client → server remote checks every argument (`Utilities.Check`: finite numbers, valid
  UTF-8, lists without holes, shapes without unknown fields) and rate-limits each player
  before its handler runs. Handlers still check ownership, ranges and game state.
* Small values (year, resources, cycle phase) replicate as attributes.
* Collections (rooms, residents, votes...) go through the delta channel:
  `ReplicationService:Collection("Rooms")` with `Set`, `Patch`, `Remove`, `Clear` on the
  server, `ReplicaController:Get/All/Changed` on the client. Changes are batched and sent
  `Constants.DELTA_HZ` times a second; a player gets a snapshot when their session becomes
  ready. Values must be remote-safe (`Delta.IsRemoteSafe`): lists or string-keyed tables,
  finite numbers, no Instances, no functions. Per-player collections pass `Visible`.

## The run (Run place)

`RunDirector` owns the lifecycle and how a run ends; `CycleClock` owns cycles, phases, the year
counter, Years per Cycle and skips; `ObjectiveService` keeps the Lost Crews rescued and era
bosses beaten (bible Sections 4, 5 and 23). The century's arithmetic is `Shared.Rules.Clock`,
pure functions the data tests hold to the bible.

```
Waiting --first player ready--> Intro (30 s) --> Playing --> Ended --Keep Going--> Playing (Endless)
                                                    |  Day 3:00 (siren at 2:40) -> Surge 1:30 -> year jump -> next Day
```

* The run clock starts at the 30-second mark for everyone; skipping the cutscene is personal.
* Years per Cycle = 1 + the `YearsPerCycle` of every objective done (`Config.Objectives`: +2 a
  Lost Crew, +1 an era boss), at most 12. The year jumps at the end of each cycle.
* A jump that reaches or passes 25, 50 or 75 makes that era's boss the next Surge (once, unless
  already beaten). At 100 the year stops and the next Surge is the final one (the Source); when
  it ends the clock halts and RunDirector declares a Century Victory.
* Surges end when their time is up, or earlier through `CycleClock:EndSurge()` (ThreatDirector,
  when the last monster is dead and the disaster fixed). A boss Surge (an era boss or the final
  Surge) has no timer (`PhaseOpen`) and ignores EndSurge: it ends when its boss is beaten,
  `ObjectiveService:BossBeaten(bossId)` -> `BossDefeated` (Landon, 2026-11-08).
* Skips: when every player in the run has pressed Ready (`SetReady` remote) or rests in a
  Quarters bed (`CycleClock:SetResting`), the day jumps to the siren. Both count only during a
  day before the siren and both reset at the siren (Landon, 2026-11-08).
* Keep Going after any victory, even an early Deep Victory, starts Endless at once (Landon).
* Defeat: `RunDirector:Lose("ReactorDestroyed" | "ResidentsLost")`; Deep Victory:
  `RunDirector:Win("Deep")`; Keep Going: `RunDirector:KeepGoing()` (no more era bosses or year
  cap, Endless Surges). The results screen reads `RunDirector:Summary()`.
* Signals for other systems: `CycleClock.CycleStarted` (residents eat and drink), `YearChanged`
  (aging), `EraChanged`, `SirenStarted`, `SurgeStarted`, `SurgeEnded` (the blueprint draft),
  `Skipped`; `RunDirector.PhaseChanged`, `RunEnded`; `ObjectiveService.Changed`.

**RunState** (`Shared.RunState`): the run's small values, replicated as attributes on that
ModuleScript. Each has one writer, which gets a setter from `RunState.Writer(name)`; anyone
reads `RunState.Get`, `RunState.Changed`, `RunState.TimeLeft()` (times are server time, so
every client counts down to the same moment).

| Writer | Values |
|---|---|
| RunDirector | RunPhase, IntroEndsAt, Difficulty, Outcome, DefeatReason, Victory, Endless |
| CycleClock | Cycle, Year, Era, YearsPerCycle, CyclePhase, PhaseLength, PhaseEndsAt, PhaseLeft, PhaseOpen, Siren, SurgeKind, SurgeBoss, ReadyCount, ReadyNeeded, Paused, TimeScale |
| ObjectiveService | LostCrews, BossesBeaten |

Players carry `Ready` and `Resting` attributes (CycleClock). In Studio, set the attribute
`SkipIntro` on `ServerScriptService.DevTools` to true to start runs without the 30 s intro.

## The bunker (Run place)

`BunkerGrid` holds the run's bunker (bible Section 6): the data and rules are
`Shared.Rules.Bunker`, the geometry `Shared.Rules.Grid`, and `Lib.BunkerKit` builds the world.

* Cells: columns -6 to 6, floors 1 to 10 (the depth; floor 10 is the Source Chamber). Every cell
  is Rock, Dug or part of a room. Rooms are 1 to 3 cells side by side on one floor.
* Rules (Rules.Bunker): dig a Rock cell left of, right of or below a dug cell or room; place a room
  on Dug cells (MaxCells, Unique, a room's own Floor, never in the Source Chamber); merge two
  matching rooms of one level side by side (never different levels); Fixed rooms (Blast Door,
  Reactor Core) never merge or go; levels 1 to 3. HP is per cell: `Tuning.Rooms.HP[level]`
  times the cells (Landon, 2026-11-08); a merged room keeps both rooms' HP. Votes, costs,
  build and dig times come from BuildService and DigService.
* The room graph: a node per room (`R3`) and per Dug cell (`D:2,3`); edges through doorways
  (side-by-side open cells of different units) and between stacked Shafts. A dug cell is a step
  when power counts steps from a Reactor Core or a Generator (Landon, 2026-11-08).
* The run starts with `Tuning.StartingBunker`: floor 1 Blast Door (2 cells), Shaft, Quarters
  (2 cells), a dug cell; floor 2 Kitchen, Water Purifier, Shaft, Reactor Core, Medbay, a dug
  cell; the Shafts in column 0, rock at column -3 (the bible's diagram).
* World (Rules.Grid): `Tuning.Grid.Origin` is the interior floor centre of floor 1, column 0
  (0, -120, 0). Cells repeat every 34 studs along +X and 18 down; the front, where the Command
  View camera sits, faces +Z. Art models face -Z: place them with `Grid.CellCFrame`.
* `workspace.Bunker` (built at server start, rebuilt around each change) from the A1 art in
  `ServerStorage.Assets.Kit` and `.Rooms`, each piece falling back to the Prompt 4 graybox when
  missing: `Frame` (a ring of rock cells), `Rock` (models named by cell key), `Dug` (models
  `D:<key>`), `Rooms` (models named by room id, with RoomId, RoomType, Floor, Column, Span,
  Level and Art attributes). Every unit is Persistent. Players spawn in the Medbay; the place's
  other spawns are disabled when the server starts.
* Tags: `FrontWall` (front wall parts: hidden in the Command View), `CameraFade` (furniture,
  the Blast Door set, the stair, vents, lamps, cave props: the camera passes through and fades
  them), `RoomLight` (PointLights, with a `Unit` attribute, for the power system). Floors,
  walls, ceilings and rock stop the camera.
* Gameplay points: each room's `Sockets` part holds an Attachment per socket of its art
  (WorkSpot1.., Bed1.., Seat1.., Core, Valve1.., FuseBox, Breaker, Tap, Bench, Respawn, Door,
  SurfaceExit, Vent, Lift, Chute, Top, Bottom, Light1..), numbered across the room's cells.
  Read them with `BunkerKit.Socket(model, name)` and `BunkerKit.Sockets(model, pattern)`.
* Replication: the `Cells` collection (`"floor,column"` -> `{ Room = id }`, `{}` when Dug) and
  the `Rooms` collection (id -> Type, Floor, Column, Span, Level, HP, MaxHP).

## The camera and input (both places)

`InputController` turns PC, touch and gamepad input into actions; `CameraController` is the
over-the-shoulder camera (bible Section 9); `Lib.Fade` makes world parts see-through on this
client only. The camera's geometry is `Shared.Rules.CameraRig`, its numbers `Tuning.Camera`.

* Actions follow the bible's controls table (`BINDINGS` in InputController). Listen with
  `InputController:On(action, began, ended)`; HUD touch buttons join with
  `BindButton(action, button)`. Moving and jumping stay Roblox's. `Block(reason)` stops gameplay
  actions while a screen is open (CommandView is never blocked).
* Roblox marks Tab as processed before ContextActionService sees it begin, so Tab (and the
  gamepad's View button) are also read from UserInputService when processed (no text box
  focused, Roblox's menu closed). `GuiService.AutoSelectGuiEnabled` is off: Roblox would take
  the View button for its own UI selection, and our screens select for the gamepad themselves.
* Right shoulder by default; `SwapShoulder` (V, right stick click) swaps. `Aim` (right mouse,
  left trigger; Run place only) narrows the view 70 to 50, brings the camera in, slows walking
  and turns the character with the camera.
* Zoom caps: the wheel or a pinch zooms between `Distance.Min` and `Distance.Max`, at most
  `IndoorMax` in a bunker cell. A spherecast from the shoulder stops the camera at floors, walls,
  ceilings and rock (in at once, out gently); in a cell it also stays between the floor and the
  ceiling panels (not in a Shaft, which is open overhead).
* Wall fade: `FrontWall` and `CameraFade` parts never stop the camera and fade while they hide
  the character or touch the camera; characters and `CameraIgnore` are passed through. The
  local character fades when the camera reaches its head.
* PC: the mouse is locked to the centre and `StarterGui.Reticle` shows the sight.
  `CameraController:FreeCursor(reason, true)` frees it for menus; `Suspend(reason)` and
  `Resume(reason)` hand the camera to another view (Command View, cutscenes).
* Fallback: repeated errors stop the controller and give the camera to Roblox's, set to
  Invisicam in both places (`StarterPlayer.DevCameraOcclusionMode`); `EnableMouseLockOption` is
  off. StructureCheck checks both settings and the Reticle.

## The UI (both places)

Bible Section 18. The layout is real instances in StarterGui, built through the Studio
connector by `studio/ui/*.lua` (`python3 tools/ui_luau.py studio/ui/<Screen>.lua` prints the
Luau; send it with `execute_luau`, Edit) and then given Landon's AutoScale Lite pass. Code
never builds layout: it clones templates and sets text and images.

* `Shared.UIContract` lists every part of `StarterGui.Frame` and `StarterGui.HUD` the code
  uses. StructureCheck fails if one is missing, and also checks ScreenInsets
  CoreUISafeInsets, ResetOnSpawn off, ZIndexBehavior Sibling, Scale-only sizes, TextScaled
  text with a UITextSizeConstraint of at least 12, and no scripts inside a GUI.
* `Lib.UIKit` is generated from `ui/kit.json` by `tools/pack_ui.py` (the sprite table).
  `Lib.KitRuntime.Watch(gui)` keeps 9-slice corners, strokes and scroll bars in step with the
  screen height and runs the push-buttons (RectUp/RectDown/RectHover/RectDisabled attributes).
* `UIController` is The Frame: `Register(name, screen)`, `Open(name, args)`, `Close()`,
  `SetChips`, `SetMainAction`, `SetHint`, `SetFooterActions`, `Clone(template)`,
  `SetSprite`, `SetRarity`, `Clear`. A screen is a page (a clone of `Templates.Page`, or a page
  built for it under `Cabinet.Pages`) filling zones B, C and D; `Docked = true` is the Command
  View's mode (zone C shows the world). While a screen is open the cursor is free, gameplay
  input is blocked (`InputController:Block`) and the HUD hides. Backspace or B closes; Enter
  or Y presses the main action; L1 and R1 switch tabs.
* `HUDController` fills the run HUD: the year flip counter, era, cycle dial, phase and time
  left, Ready (the SetReady remote), siren and Surge banners, health, the class and ability,
  stockpile chips, the hotbar's selection, the Command View button and the touch buttons
  (through `InputController:BindButton`; Roblox's jump button hides while ours shows). On PC,
  holding Left Alt frees the cursor to click HUD buttons. For later systems: `Alert`,
  `Banner`, `SetVital`, `SetClass`, `SetResource`, `SetSlot`, `HotbarSelected`.
* `MiniMapController` draws the side-view mini-map around the player from the Cells and Rooms
  collections; `Blink(key, on)` for alerts.
* Changing a screen after Landon's AutoScale Lite pass: edit the instances in place (and the
  builder file to match), or rebuild and ask for the pass again. `studio/ui/patches/` holds
  such in-place patches.

## The Command View (Run place)

Bible Section 7. `CommandViewController` registers the screen `CommandView`: the Frame in
docked mode (`Cabinet.Pages.CommandView`, zone C open on the live bunker), opened and closed
by Tab, the View button, the HUD's Command View button, Backspace or B. The character stays
where it was, held by a ContextActionService sink (its movement keys and jump) with Roblox's
touch thumbstick and jump button hidden (`GuiService.TouchControlsEnabled`), and can be hit:
`DamageEdge` flashes when its health drops. Its arithmetic and build-menu rules are
`Shared.Rules.CommandView` (pure, data-tested); numbers in `Tuning.CommandView`.

* Camera: straight at the bunker from +Z, at most `MaxDistance` (440 studs) away. At the
  lowest graphics level Roblox stops drawing parts about 500 studs from the camera (measured in
  Studio, 2026-11-08: 500 drew, 525 didn't; level 2 draws about 800), so the camera never backs
  off past the cap: `Rules.CommandView.Lens(height)` keeps the narrow 8 degree field of view
  while it fits, then widens it (14 degrees at the opening 6 floors, 25 at the 11-floor limit).
  The view's centre sits in zone C's centre; it opens centred on the character with a 0.3 s
  move, and the close moves back and resumes CameraController. `FrontWall` parts hide while it
  is open; the lighting lifts (`Ambient`, `OutdoorAmbient`, `ExposureCompensation`).
* Input: drag or WASD/arrows to pan, the wheel or a pinch to zoom (1.5 to 11 floors), click or
  tap a cell; gamepad: left stick pans, right stick zooms, A picks the centre (`Cursor`).
  Picking casts from the camera through the point onto the cells' plane (`Grid.CellAt`).
* Detail panel (zone D): a room (condition, power, what it does; Upgrade, Merge with a
  matching neighbour, Tear Down), an open cell (the build menu: available rooms with costs,
  then locked ones and why, from `RoomChoice`; Fixed rooms are never listed), rock (whether it
  can be dug, the band's ore, the next band's Push Deeper). Choosing an option arms the main
  action ("Propose ..."), greyed until a system calls `SetHandler(action, fn)` for Build,
  Upgrade, Merge or TearDown (Prompt 8: votes).
* For later systems: `SetOverlay(name, provider)` (Power, Morale, Threat, Production: the
  provider returns a lamp sprite per room; the legend sits at the top of the panel),
  `ShowGhost(id, floor, column, span, label)` / `HideGhost(id)` (votes), `Blink(roomId, on)`
  (breaches, disasters), `Select(floor, column)`, `IsOpen`, `Toggle`, `State`, and the
  `Selected` signal. Labels, marks and pings cover cell interiors (`Rules.CommandView.CellBox`).
* Pings: the footer's Ping button or G / D-pad up sends `PingCell(floor, column)`;
  `PingService` checks the session and the cell and fires `CellPinged(floor, column, userId,
  name)` to every ready player. The pin shows in the Command View and on the HUD mini-map for
  `Tuning.Ping.Seconds` (6).

## Saved data

One profile per player (bible Section 23), shape and migrations in `Lib.ProfileSchema`, I/O in
`ProfileService`. The stored record is `{ Data, Lock, Meta }` in the `PlayerProfiles` DataStore
(`PlayerProfiles_Studio` in Studio, so tests never touch live saves), key `Player_<userId>`.

* Load claims the lock through UpdateAsync. A fresh lock from another server: wait and retry
  (8 tries, 2 s apart), then kick with a message. A stale lock (3 autosaves old; 30 s in
  Studio): taken over. A newer version: refused, nothing written. Then migrate, reconcile,
  validate; a failure kicks the player and writes nothing.
* Saves: every 120 s (staggered; refreshes the lock), on leaving (releases it) and on
  shutdown (BindToClose waits for every release). A save writes only if this server still
  holds the lock and the profile validates; losing the lock kicks the player.
* Gameplay calls `ProfileService:Update(player, fn)` (undone if it errors or leaves the profile
  invalid), `AddGlowshards`, `SpendGlowshards`, and `GrantPurchase(player, receiptId, grant)`
  for ProcessReceipt: grant, record the receipt, save, then report granted; a repeated
  receipt is never granted twice.
* The player's client reads its own profile (minus receipts) from the `Profiles` collection.
* A session isn't ready until its profile loads (SessionService gate `Profile`).
* Changing the shape: raise `ProfileSchema.VERSION`, add a migration, update `Default` and the
  shape. Old servers refuse newer saves, so a rolling update can't corrupt them.

## Content

All content is data in `Shared.Config` (bible Section 23). Each content type is a child
ModuleScript returning `{ Schema = Check.shape(...), Entries = { Id = entry }, Order = {...}? }`
(or `Schemas`, one checker per entry, for Tuning). Config validates every entry at load
(fields, ids, `Check.ref` cross-references), freezes it and adds `Id`. Read with
`Config.Get(type, id)` (errors if missing), `Config.Find` (for ids from players or saves),
`Config.All(type)`, `Config.Ids(type)`. Problems are listed by `Config.Errors()`, logged, and
fail StructureCheck and the data tests. `Config._Fields` holds checkers the content modules
share (modules starting with `_` are helpers, not types).

Content types (Prompt 1): Badges, Bosses, Classes, Conditions, DepthBands, DigResults,
Difficulties, Disasters, DraftCards, Eras, GamePasses, GlowshardPacks, GlowshardRewards,
ItemRarities, Items, Leaderboards, Legends, LootTables, Modifiers, MoraleStates, Monsters,
Objectives, Quests, Recipes, ResidentNames, Resources, Rooms, Stats, SurfaceLocations,
TalentSlots, TeamBoosts, Tiers, Traits, Tuning, Votes, WandererOutcomes.

**Effects are data.** Classes, traits, Legends, draft cards and passes describe what they do
as modifiers: `{ Key = "RoomOutput", Value = 1.25, Room = "Medbay", Scope = "Bunker" }`.
`Config.Modifiers` is the vocabulary: each key's unit (Multiplier, Add, Set, Flag, Chance),
default scope, and the prompt whose system applies it. A system reads the keys it owns; a new
effect is a new key plus the code that honours it.

**Rule numbers** live in `Config.Tuning`, one entry per system (Clock, Grid, StartingBunker,
Rooms, Votes, Player, Digging, Disturbance, Threat, Residents, Aging, Morale, Trader,
Wanderers, Expeditions, Surface, Legends, ClassShop, Account, Lobby).

## DevTools

* `/dev <command>` in chat for allowed players (everyone in Studio; outside Studio only the
  admins in `Constants.ADMIN_USER_IDS`); `/dev help` lists commands. Services add their own
  in `Init` with `DevService:Register`.
* In a Studio playtest: `ServerScriptService.DevTools.Invoke:Invoke("test")` on the server,
  `PlayerScripts.DevInvoke:Invoke("replica Rooms")` on a client.
* `structure`: StructureCheck. `test [filter]`: DataTests. Both run once whenever a Studio
  playtest starts (set the `RunChecksOnStart` attribute on DevTools to false to stop that).
* Other built-ins: `version`, `ping`, `players`, `remotes`, `log [level]`, `logs [count]`,
  `rep`, `rep.selftest`; on the client `replica <collection>`, `client`, `clock`,
  `ready [true|false]` (fires SetReady like the HUD button), `camera`, `camera.shoulder`,
  `camera.aim [bool]`, `camera.look <yaw> <pitch>`, `camera.zoom <studs>`, `camera.cursor`,
  `ui`, `ui.sample`, `ui.list`, `ui.dock`, `ui.open <screen>`, `ui.close`, `ui.tab <id>`,
  `ui.main`, `hud`, `hud.alert <Danger|Warning|Info> <text>`, `hud.banner <text>`,
  `hud.slot <n>`, `hud.touch [bool]`, `cv` (the Command View's state and options), `cv.open`,
  `cv.close`, `cv.select <floor> <column>`, `cv.ping`, `cv.ghost <floor> <column> <span>
  [label]`, `cv.unghost`, `cv.blink <roomId> [false]`, `cv.overlay <name> [false]` (a sample
  reading for screenshots).
* The bunker (Run place): `grid` (map), `grid.rooms`, `grid.graph`, `grid.dig <floor> <column>`,
  `grid.build <Type> <floor> <column> [span] [level]`, `grid.remove <id>`, `grid.merge <id> <id>`,
  `grid.level <id> <level>`, `grid.rebuild`, `grid.sockets <id>`, `grid.art`.
* The run (Run place): `run`, `run.skipintro`, `run.win <century|deep>`,
  `run.lose <reactor|residents>`, `run.keepgoing`; `clock`, `clock.speed <x>`, `clock.pause`,
  `clock.resume`, `clock.next`, `clock.clear`, `boss.beat [bossId]`, `year <n>`,
  `ready.all [bool]`, `rest.all [bool]`; `objectives`, `objective <id>`; `cell.ping <floor>
  <column>` (pings as the first player).

## Conventions

* `--!strict` in every file. Tabs. PascalCase for modules, types, methods and content ids;
  camelCase for locals. Content ids: letters, digits and `_`, starting with a letter.
* Logging through `Utilities.Log` (`Log.new("Tag")`), never bare `print`.
* Tunables are content (Config); identity and engine limits are `Constants`.
* Every prompt ends with Design Notes and a Delivery Report in `game/reports/`.

## Services and controllers

| Place | Name | Kind | Depends on | Owns |
|---|---|---|---|---|
| both | SessionService | service | | player sessions: gates (client ready, profile loaded), ready, leaving |
| both | DevService | service | | DevTools commands and permission |
| both | ReplicationService | service | SessionService, DevService | the delta channel (server) |
| both | ProfileService | service | SessionService, ReplicationService, DevService | saved data: session-locked profiles, Glowshards, purchase receipts |
| Run | ObjectiveService | service | DevService | Lost Crews rescued, era bosses beaten, their Years per Cycle bonuses |
| Run | CycleClock | service | SessionService, ObjectiveService, DevService | 4:30 cycles, day and Surge phases, the year counter, Years per Cycle, skips |
| Run | RunDirector | service | SessionService, CycleClock, DevService | the run's lifecycle (intro, playing, ended), win and lose, Endless, the summary |
| Run | BunkerGrid | service | ReplicationService, DevService | cells, rooms, levels, merges, the room graph; builds `workspace.Bunker` |
| Run | PingService | service | SessionService, DevService | cell pings (PingCell in, CellPinged out to every ready player) |
| both | ReplicaController | controller | | the delta channel mirror (client) |
| both | InputController | controller | | devices, the bible's action bindings, look and zoom input |
| both | CameraController | controller | InputController, ReplicaController | the over-the-shoulder camera: shoulder, aim, zoom caps, wall fade, the mouse lock and reticle |
| both | UIController | controller | InputController, CameraController | The Frame: screens, pages, tabs, chips, the main action, footer |
| both | HUDController | controller | InputController, UIController, CameraController | the run HUD (Run; nothing in the Lobby yet) |
| both | MiniMapController | controller | ReplicaController, HUDController | the HUD's side-view mini-map and its pings (Run) |
| both | CommandViewController | controller | InputController, CameraController, UIController, ReplicaController, HUDController | the Command View (Run): its camera, picking, detail panel, build menu, overlays, ghosts, pings |
| both | DevController | controller | ReplicaController, InputController, CameraController, UIController, HUDController, CommandViewController | `/dev` chat command, Studio DevInvoke |

## Prompt log

* **Prompt 0 (2026-11-08)**: architecture foundation in both places. Shared modules, Config
  aggregator, remotes with validation and rate limits, the delta channel, bootstraps with
  declared dependencies, DevTools, this document. No gameplay.
* **Prompt 1 (2026-11-08)**: content definitions. 36 content types with schemas and the
  bible's starter data (provisional numbers marked), the modifier vocabulary, Tuning for
  every system, and data tests that hold the content to the bible.
* **Prompt 2 (2026-11-08)**: saved data. ProfileService with session locks, migrations,
  autosave, release and shutdown saves, purchase receipts; SessionService gates.
* **Prompt 3 (2026-11-08)**: the run lifecycle and the cycle clock (Run place). RunDirector,
  CycleClock, ObjectiveService, Shared.Rules.Clock, Shared.RunState, the SetReady remote,
  place-only remotes and code (`game/places/Run`); win and lose stubs for later prompts.
* **Prompt 4 (2026-11-08)**: the bunker grid (Run place). BunkerGrid, Rules.Grid, Rules.Bunker,
  Lib.BunkerKit (graybox kit), the starting bunker centred on the Shaft column as the bible's
  diagram draws it, the Cells and Rooms collections, spawning in the Medbay.
* **A1 in the bunker (2026-11-08)**: BunkerKit builds from the art kit (graybox fallback per
  piece), a Sockets part per room, room lights, vents, the frame as rock cells.
* **Prompt 5 (2026-11-08)**: the over-the-shoulder camera with wall fade and zoom caps
  (CameraController, InputController, Lib.Fade, Rules.CameraRig, StarterGui.Reticle) in both
  places. Landon's answers to the Prompt 3 and 4 questions: boss Surges and the final Surge run
  until the boss is beaten, resting resets at the siren, HP per cell, dug cells count as power
  steps.
* **Prompt 6 (2026-11-08)**: The Frame and the HUD skeleton, ready for the AutoScale Lite pass.
  StarterGui.Frame (both places) and StarterGui.HUD (Run) built from the UI kit; UIController,
  HUDController, MiniMapController, Lib.KitRuntime, Lib.UIKit, Lib.UISamples (dev samples),
  Shared.UIContract, Rules.Hud; a HUD atlas (touch buttons, action icons, copper and crystal).
* **Prompt 7 (2026-11-08)**: the Command View (Run). CommandViewController (docked Frame, a
  capped far camera that widens its field of view past 440 studs so the lowest graphics level
  still draws the bunker, pan, zoom, picking, room, open cell and rock details, the build menu
  with unlocks, overlays, vote ghosts, blinking labels, the damage edge), PingService and pings on
  the mini-map, Rules.CommandView, Bunker.FromSnapshot; Tab and the View button reach it
  although Roblox marks them processed; Roblox's player list is off in the run.
]=]
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX000000CB"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX000000BC"><Properties><string name="Name">ClientBootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ClientBootstrap: the only LocalScript (bible Section 23). It loads every controller in
	the Controllers folder beside it, runs every Init in dependency order and then every
	Start, waits for the server to be ready and tells it the client is ready (ClientReady),
	which makes the server send the replication snapshot.

	Never add another LocalScript: write a controller (see Documentation.ARCHITECTURE).
]]

local began = os.clock()

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Utilities = Shared:WaitForChild("Utilities")
local Loader = require(Utilities:WaitForChild("Loader"))
local Log = require(Utilities:WaitForChild("Log"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local SERVER_WAIT_SECONDS = 30

local log = Log.new("ClientBootstrap")

local controllers = Loader.Collect(script.Parent:WaitForChild("Controllers"), "Controller")
local report = Loader.Run(controllers, log)

local waited = 0
while ReplicatedStorage:GetAttribute("ServerReady") ~= true and waited < SERVER_WAIT_SECONDS do
	waited += task.wait(0.1)
end
if ReplicatedStorage:GetAttribute("ServerReady") ~= true then
	log:Warn("the server isn't ready after %d s; continuing", SERVER_WAIT_SECONDS)
end

Remotes.FireServer("ClientReady")
log:Info(
	"client ready: %d controllers (%s) in %.1f ms",
	#report.Order,
	table.concat(report.Order, ", "),
	(os.clock() - began) * 1000
)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000000C6"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX000000BE"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CameraController: the over-the-shoulder camera (bible Sections 9 and 26: "wall fade and zoom
	caps built and tested in prompt 5, before anything depends on them").

	* Over the right shoulder by default; SwapShoulder (V, the right stick click, the HUD's
	  Shoulder button) moves it to the other side in ShoulderSwapSeconds.
	* Aim (right mouse, the left trigger, the HUD's Aim button; Run place only) narrows the
	  field of view from 70 to 50 (Tuning.Player.AimFieldOfView), brings the camera in to
	  AimDistance, slows walking to AimWalkSpeed and turns the character to where the camera
	  looks.
	* Zoom (the wheel, a pinch) between Distance.Min and Distance.Max, capped at IndoorMax while
	  the character is in a bunker cell.
	* Zoom caps: a spherecast from the shoulder keeps the camera out of walls, slabs and rock: it
	  pulls in at once and eases back out. In a bunker cell the camera also stays between the
	  floor and the ceiling panels, sliding in along its view (Shafts are open overhead).
	* Wall fade: front walls (FrontWall tag) and furniture (CameraFade tag) never stop the
	  camera; when they stand between the camera and the character, or touch the camera, they
	  fade (Lib.Fade, this client only). So the camera can stand outside a room's open front.
	  Characters and anything tagged CameraIgnore are passed through.
	* The local character fades as the camera comes within CharacterFadeDistance of the head.
	* PC: the mouse is locked to the centre with the cursor hidden and the Reticle shown; any
	  controller frees the cursor with FreeCursor(reason, true) (menus, the Command View).
	* Other views take the camera with Suspend(reason) and give it back with Resume(reason).
	* Fallback: if the update errors ErrorsBeforeFallback times in a row, the controller stops
	  and hands the camera to Roblox's default camera, which the places set to Invisicam
	  (StarterPlayer.DevCameraOcclusionMode).
]]

local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CameraRig = require(Shared.Rules.CameraRig)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local Fade = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Fade"))

local log = Log.new("CameraController")

local FRONT_WALL_TAG = "FrontWall"
local FADE_TAG = "CameraFade"
local IGNORE_TAG = "CameraIgnore"
local FADE_SOURCE = "Camera"
local RENDER_NAME = "100Y_Camera"
local RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 1
local MAX_FADE_HITS = 4
local PIVOT_LAG = 2 -- the smoothed pivot never trails the head by more than this (studs)

local CameraController = {
	Name = "CameraController",
	Dependencies = { "InputController", "ReplicaController" },
	ShoulderChanged = Signal.new() :: Signal.Signal<number>,
	AimChanged = Signal.new() :: Signal.Signal<boolean>,
}

local input: any = nil
local replica: any = nil
local t: { [string]: any } = {}
local aimFieldOfView = 50
local inRun = false

local yaw = 0
local pitch = 0
local side = 1 -- 1: right shoulder, -1: left
local sideBlend = 1
local aiming = false
local aimBlend = 0
local wanted = 9 -- the zoom the player chose
local distance = 9 -- the camera's distance this frame
local pivotY: number? = nil
local sensitivity = 1
local suspended: { [string]: boolean } = {}
local cursorFree: { [string]: boolean } = {}
local errors = 0
local stopped = false
local wasActive = false
local faded: { [BasePart]: boolean } = {}
local characterFade = 0
local fadedCharacter: Model? = nil
local walkHumanoid: Humanoid? = nil
local baseWalkSpeed = 16
local slowed = false
local reticle: { Gui: ScreenGui, Hip: GuiObject?, Aim: GuiObject? }? = nil
local lastFrame = { Distance = 0, Blocked = false, Indoors = false, Fading = 0, Position = Vector3.zero }

local blockParams = RaycastParams.new()
blockParams.FilterType = Enum.RaycastFilterType.Exclude
blockParams.IgnoreWater = true
local fadeParams = RaycastParams.new()
fadeParams.FilterType = Enum.RaycastFilterType.Include
fadeParams.IgnoreWater = true
local nearParams = OverlapParams.new()
nearParams.FilterType = Enum.RaycastFilterType.Include
local filtersDirty = true

-- Filters ------------------------------------------------------------------------------------

-- The camera passes through characters, CameraIgnore, CameraFade and front walls; it fades
-- the last two.
local function rebuildFilters()
	filtersDirty = false
	local passThrough: { Instance } = {}
	local fadeable: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(passThrough, player.Character)
		end
	end
	for _, item in CollectionService:GetTagged(IGNORE_TAG) do
		table.insert(passThrough, item)
	end
	for _, tag in { FADE_TAG, FRONT_WALL_TAG } do
		for _, item in CollectionService:GetTagged(tag) do
			table.insert(passThrough, item)
			table.insert(fadeable, item)
		end
	end
	blockParams.FilterDescendantsInstances = passThrough
	fadeParams.FilterDescendantsInstances = fadeable
	nearParams.FilterDescendantsInstances = fadeable
end

local function markDirty()
	filtersDirty = true
end

-- Fading -------------------------------------------------------------------------------------

-- A front wall fades as a whole piece; anything else fades alone.
local function fadeGroup(part: BasePart, into: { [BasePart]: number }, amount: number)
	if CollectionService:HasTag(part, FRONT_WALL_TAG) then
		local parent = part.Parent
		if parent and parent:IsA("Model") then
			for _, sibling in parent:GetChildren() do
				if sibling:IsA("BasePart") and CollectionService:HasTag(sibling, FRONT_WALL_TAG) then
					into[sibling] = math.max(into[sibling] or 0, t.FrontWallTransparency)
				end
			end
		end
		into[part] = math.max(into[part] or 0, t.FrontWallTransparency)
		return
	end
	into[part] = math.max(into[part] or 0, amount)
end

-- Fadeable parts on the lines from the camera to points on the character.
local function occluders(from: Vector3, targets: { Vector3 }, into: { [BasePart]: number })
	for _, target in targets do
		local origin = from
		for _ = 1, MAX_FADE_HITS do
			local delta = target - origin
			if delta.Magnitude < 0.05 then
				break
			end
			local hit = workspace:Raycast(origin, delta, fadeParams)
			if not hit then
				break
			end
			local part = hit.Instance
			if part:IsA("BasePart") then
				fadeGroup(part, into, t.FadeTransparency)
			end
			origin = hit.Position + delta.Unit * 0.05
		end
	end
end

local function applyFades(now: { [BasePart]: number })
	for part in faded do
		if now[part] == nil then
			Fade.Clear(part, FADE_SOURCE)
			faded[part] = nil
		end
	end
	for part, amount in now do
		Fade.Set(part, FADE_SOURCE, amount)
		faded[part] = true
	end
end

local function clearFades()
	Fade.ClearSource(FADE_SOURCE)
	table.clear(faded)
end

local function fadeCharacter(character: Model?, amount: number)
	if character ~= fadedCharacter then
		characterFade = -1
		fadedCharacter = character
	end
	if not character or math.abs(amount - characterFade) < 0.01 then
		return
	end
	characterFade = amount
	for _, item in character:GetDescendants() do
		if item:IsA("BasePart") or item:IsA("Decal") then
			local target: any = item
			target.LocalTransparencyModifier = amount
		end
	end
end

-- Mouse, reticle, walking --------------------------------------------------------------------

local function active(): boolean
	return not stopped and next(suspended) == nil
end

local function updateMouse()
	local locked = active() and next(cursorFree) == nil and input:Device() ~= "Touch" and not GuiService.MenuIsOpen
	local behavior = if locked then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	if UserInputService.MouseBehavior ~= behavior then
		UserInputService.MouseBehavior = behavior
	end
	if UserInputService.MouseIconEnabled == locked then
		UserInputService.MouseIconEnabled = not locked
	end
end

local function findReticle()
	local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local gui = playerGui and playerGui:FindFirstChild("Reticle")
	if gui and gui:IsA("ScreenGui") then
		local hip = gui:FindFirstChild("Hip", true)
		local aim = gui:FindFirstChild("Aim", true)
		reticle = {
			Gui = gui,
			Hip = if hip and hip:IsA("GuiObject") then hip else nil,
			Aim = if aim and aim:IsA("GuiObject") then aim else nil,
		}
	else
		reticle = nil
	end
end

local function updateReticle()
	local current = reticle
	if not current or current.Gui.Parent == nil then
		findReticle()
		current = reticle
	end
	if not current then
		return
	end
	local show = active() and next(cursorFree) == nil
	if current.Gui.Enabled ~= show then
		current.Gui.Enabled = show
	end
	local aimed = aimBlend >= 0.5
	if current.Hip and current.Hip.Visible ~= (inRun and not aimed) then
		current.Hip.Visible = inRun and not aimed
	end
	if current.Aim and current.Aim.Visible ~= (inRun and aimed) then
		current.Aim.Visible = inRun and aimed
	end
end

-- Aiming slows walking and turns the character with the camera.
local function updateWalking(humanoid: Humanoid, root: BasePart)
	if humanoid ~= walkHumanoid then
		walkHumanoid = humanoid
		baseWalkSpeed = humanoid.WalkSpeed
		slowed = false
	end
	if aiming ~= slowed then
		slowed = aiming
		humanoid.WalkSpeed = if aiming then baseWalkSpeed * t.AimWalkSpeed else baseWalkSpeed
		humanoid.AutoRotate = not aiming
	end
	if aiming then
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	end
end

local function releaseWalking()
	local humanoid = walkHumanoid
	if humanoid and slowed and humanoid.Parent then
		humanoid.WalkSpeed = baseWalkSpeed
		humanoid.AutoRotate = true
	end
	slowed = false
end

-- Is the cell at this point a Shaft (open overhead for the stair)?
local function inShaft(point: Vector3): boolean
	local floor, column = Grid.CellAt(point)
	if not floor or not column then
		return false
	end
	local cell = replica:Get("Cells", Grid.Key(floor, column))
	local roomId = if type(cell) == "table" then cell.Room else nil
	local room = if type(roomId) == "string" then replica:Get("Rooms", roomId) else nil
	return type(room) == "table" and room.Type == "Shaft"
end

-- The frame ----------------------------------------------------------------------------------

local function step(dt: number)
	updateMouse()
	updateReticle()
	if not active() then
		if wasActive then
			wasActive = false
			clearFades()
			releaseWalking()
			fadeCharacter(fadedCharacter, 0)
		end
		input:TakeLook(dt)
		input:TakeZoom()
		return
	end
	wasActive = true
	local camera = workspace.CurrentCamera
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = humanoid and humanoid.RootPart
	if not camera or not character or not humanoid or not root then
		input:TakeLook(dt)
		input:TakeZoom()
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	if filtersDirty then
		rebuildFilters()
	end

	-- Look, shoulder and aim
	local turn = input:TakeLook(dt) * sensitivity * (1 + (t.AimSensitivity - 1) * aimBlend)
	yaw -= math.rad(turn.X)
	pitch = CameraRig.ClampPitch(pitch - math.rad(turn.Y))
	sideBlend = CameraRig.MoveToward(sideBlend, side, dt * 2 / math.max(t.ShoulderSwapSeconds, 1e-3))
	aimBlend = CameraRig.MoveToward(aimBlend, if aiming then 1 else 0, dt / math.max(t.AimBlendSeconds, 1e-3))

	-- The pivot: head height, its height smoothed a little (stairs)
	local head = root.Position + Vector3.new(0, t.PivotHeight, 0)
	local smoothY = if pivotY then CameraRig.Approach(pivotY, head.Y, t.PivotFollowPerSecond, dt) else head.Y
	pivotY = math.clamp(smoothY, head.Y - PIVOT_LAG, head.Y + PIVOT_LAG)
	local pivot = Vector3.new(head.X, pivotY :: number, head.Z)

	-- Indoors: the bunker cell the character is in
	local low: number?, high: number? = nil, nil
	if inRun then
		low, high = CameraRig.CellHeights(pivot)
	end
	local indoors = low ~= nil
	if indoors and inShaft(pivot) then
		high = nil -- the Shaft is open overhead (the stair goes up through it)
	end

	-- Zoom
	local nearest, farthest = CameraRig.ZoomRange(indoors)
	local zoomInput = input:TakeZoom()
	if zoomInput ~= 0 then
		wanted = math.clamp(math.min(wanted, farthest) + zoomInput, nearest, if indoors then farthest else t.Distance.Max)
	end
	local zoomGoal = math.clamp(wanted, nearest, farthest)
	local goal = zoomGoal + (math.min(t.AimDistance, zoomGoal) - zoomGoal) * aimBlend

	-- The focus beside the head, kept out of a wall the character stands against
	local shoulder = t.ShoulderOffset * (1 + (t.AimShoulder - 1) * aimBlend)
	local focus = CameraRig.Focus(pivot, yaw, sideBlend, shoulder, t.ShoulderRaise)
	local toFocus = focus - pivot
	if toFocus.Magnitude > 1e-3 then
		local hit = workspace:Spherecast(pivot, t.CollisionRadius * 0.75, toFocus, blockParams)
		if hit then
			focus = pivot + toFocus.Unit * math.max(0, hit.Distance - t.WallMargin)
		end
	end

	-- How far back the camera can go: walls and rock, then the cell's floor and ceiling
	local rotation = CameraRig.Rotation(yaw, pitch)
	local look = rotation.LookVector
	local allowed = goal
	local blocked = false
	local hit = workspace:Spherecast(focus, t.CollisionRadius, -look * goal, blockParams)
	if hit then
		allowed = math.max(t.NearestDistance, hit.Distance - t.WallMargin)
		blocked = true
	end
	if indoors then
		local limit = CameraRig.HeightLimit(focus, look, low :: number, high or math.huge)
		if limit < allowed then
			allowed = math.max(t.NearestDistance, limit)
			blocked = true
		end
	end
	if allowed < distance then
		distance = allowed -- pull in at once
	else
		distance = CameraRig.Approach(distance, allowed, t.EaseOutPerSecond, dt)
	end

	local position = focus - look * distance
	camera.CFrame = CFrame.new(position) * rotation
	camera.Focus = CFrame.new(focus)
	camera.FieldOfView = t.FieldOfView + (aimFieldOfView - t.FieldOfView) * aimBlend

	-- Wall fade: between the camera and the character, and touching the camera
	local fades: { [BasePart]: number } = {}
	occluders(position, { head, root.Position, focus }, fades)
	for _, part in workspace:GetPartBoundsInRadius(position, t.NearFadeRadius, nearParams) do
		fadeGroup(part, fades, 1)
	end
	applyFades(fades)

	-- The character fades when the camera is at its head
	local gap = (position - head).Magnitude
	local closeness = math.clamp((t.CharacterFadeDistance - gap) / (t.CharacterFadeDistance * 0.5), 0, 1)
	fadeCharacter(character, closeness)

	updateWalking(humanoid, root)

	lastFrame.Distance = distance
	lastFrame.Blocked = blocked
	lastFrame.Indoors = indoors
	lastFrame.Fading = Fade.Count(FADE_SOURCE)
	lastFrame.Position = position
end

local function onRender(dt: number)
	if stopped then
		return
	end
	local ok, err = pcall(step, dt)
	if ok then
		errors = 0
		return
	end
	errors += 1
	log:Warn("camera update failed (%d): %s", errors, tostring(err))
	if errors >= t.ErrorsBeforeFallback then
		stopped = true
		clearFades()
		releaseWalking()
		local camera = workspace.CurrentCamera
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = t.FieldOfView
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		log:Error("the over-the-shoulder camera stopped; Roblox's camera (Invisicam) takes over")
	end
end

-- API ----------------------------------------------------------------------------------------

function CameraController:SwapShoulder()
	side = -side
	CameraController.ShoulderChanged:Fire(side)
end

function CameraController:SetShoulder(value: number)
	local wantedSide = if value < 0 then -1 else 1
	if wantedSide ~= side then
		CameraController:SwapShoulder()
	end
end

function CameraController:SetAiming(on: boolean)
	local value = on and inRun and active() and next(cursorFree) == nil
	if value == aiming then
		return
	end
	aiming = value
	CameraController.AimChanged:Fire(value)
end

function CameraController:IsAiming(): boolean
	return aiming
end

-- Point the camera (degrees): yaw 0 looks toward -Z, pitch below 0 looks down.
function CameraController:SetLook(yawDegrees: number, pitchDegrees: number)
	yaw = math.rad(yawDegrees)
	pitch = CameraRig.ClampPitch(math.rad(pitchDegrees))
end

function CameraController:SetZoom(studs: number)
	wanted = math.clamp(studs, t.Distance.Min, t.Distance.Max)
end

-- A sensitivity multiplier from the player's settings (Settings screen, later).
function CameraController:SetSensitivity(value: number)
	sensitivity = math.clamp(value, 0.1, 4)
end

-- Another view takes the camera (the Command View, a cutscene) until Resume(reason).
function CameraController:Suspend(reason: string)
	suspended[reason] = true
end

function CameraController:Resume(reason: string)
	suspended[reason] = nil
end

-- A menu frees the mouse cursor while it is open.
function CameraController:FreeCursor(reason: string, on: boolean)
	cursorFree[reason] = if on then true else nil
end

function CameraController:State(): { [string]: any }
	return {
		Active = active(),
		Stopped = stopped,
		Yaw = math.deg(yaw) % 360,
		Pitch = math.deg(pitch),
		Shoulder = if side > 0 then "right" else "left",
		Aiming = aiming,
		Wanted = wanted,
		Distance = lastFrame.Distance,
		Blocked = lastFrame.Blocked,
		Indoors = lastFrame.Indoors,
		Fading = lastFrame.Fading,
		Position = lastFrame.Position,
		FieldOfView = if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView else 0,
		Device = input:Device(),
		Suspended = next(suspended) ~= nil,
		CursorFree = next(cursorFree) ~= nil,
	}
end

-- Lifecycle ----------------------------------------------------------------------------------

function CameraController:Init(registry)
	input = registry.InputController
	replica = registry.ReplicaController
	t = CameraRig.Tuning()
	aimFieldOfView = Config.Get("Tuning", "Player").AimFieldOfView[2]
	inRun = Constants.PlaceKind() == "Run"
	pitch = math.rad(t.StartPitch)
	wanted = t.Distance.Default
	distance = wanted
	Fade.SetSeconds(t.FadeSeconds)
end

function CameraController:Start()
	input:On("SwapShoulder", function()
		CameraController:SwapShoulder()
	end)
	input:On("Aim", function()
		CameraController:SetAiming(true)
	end, function()
		CameraController:SetAiming(false)
	end)

	for _, tag in { FADE_TAG, FRONT_WALL_TAG, IGNORE_TAG } do
		CollectionService:GetInstanceAddedSignal(tag):Connect(markDirty)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(markDirty)
	end
	local function watch(player: Player)
		player.CharacterAdded:Connect(markDirty)
		player.CharacterRemoving:Connect(markDirty)
	end
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(markDirty)

	-- A new character looks the way it spawned facing
	local function faceSpawn(character: Model)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and root:IsA("BasePart") then
			local lookVector = root.CFrame.LookVector
			yaw = math.atan2(-lookVector.X, -lookVector.Z)
			pitch = math.rad(t.StartPitch)
			pivotY = nil
			distance = math.min(wanted, select(2, CameraRig.ZoomRange(inRun)))
		end
		aiming = false
		aimBlend = 0
	end
	Players.LocalPlayer.CharacterAdded:Connect(faceSpawn)
	if Players.LocalPlayer.Character then
		task.spawn(faceSpawn, Players.LocalPlayer.Character)
	end

	RunService:BindToRenderStep(RENDER_NAME, RENDER_PRIORITY, onRender)
	log:Debug("over-the-shoulder camera on (%s)", if inRun then "Run" else "Lobby")
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000BF"><Properties><string name="Name">CommandViewController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CommandViewController: the Command View (bible Section 7), a flat side view of the whole
	bunker that any player opens with one button, anywhere, while the character stays in the
	world and can be hit. Run place only.

	* Open and close: the CommandView action (Tab, the console's View button, the HUD button).
	  It is The Frame in docked mode (Section 18): top bar, tab rail and detail panel, with the
	  live bunker in zone C (the page Cabinet.Pages.CommandView, built in Studio).
	* Camera: far away with a narrow field of view, looking at the bunker's front, so it reads
	  nearly flat. It opens centred on the character with a 0.3 s move and moves back over the
	  shoulder on close. Front walls fade out (Lib.Fade, source "CommandView") and the lighting
	  lifts a little so the rock reads. The character's controls are off while it's open.
	* Moving the view: drag (mouse or one finger), WASD or the arrow keys, the left stick; zoom
	  with the wheel, a pinch or the right stick.
	* Picking: click or tap a cell; on a gamepad, A picks the cell under the centre mark. The
	  detail panel shows a room (level, cells, condition, power, output; actions: upgrade, merge,
	  tear down), an open cell (the build menu: every room type with its cost, or why it's
	  locked) or rock (whether it can be dug, its band and ore).
	* Proposals go through handlers the votes set (SetHandler: "Build", "Upgrade", "Merge",
	  "TearDown"; Prompt 8). Without a handler the main action stays greyed out.
	* Overlays (tabs Power, Morale, Threat, Production) colour the room labels' lamps from
	  providers later systems register (SetOverlay); without one they read "no readings yet".
	* Ping: the footer's Ping button or the Ping key (G, the D-pad's up) pings the selected cell
	  (the PingCell remote); every player sees it here and on the mini-map.
	* Taking damage while the view is open flashes the screen edge red.

	API for later prompts: SetHandler(action, fn(choice)), SetOverlay(name, provider),
	ShowGhost(id, floor, column, span, label) and HideGhost(id) for open votes, Blink(key, on)
	for alerts, Select(floor, column), IsOpen(), State().
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Bunker = require(Shared.Rules.Bunker)
local CV = require(Shared.Rules.CommandView)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Construction = require(Shared.Rules.Construction)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local UIContract = require(Shared.UIContract)
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Fade = require(Lib:WaitForChild("Fade"))
local KitRuntime = require(Lib:WaitForChild("KitRuntime"))

local log = Log.new("CommandViewController")

export type Choice = {
	Action: string, -- "Build", "Upgrade", "Merge", "TearDown"
	Floor: number,
	Column: number,
	RoomType: string?, -- Build
	RoomId: string?, -- Upgrade, Merge, TearDown
	Other: string?, -- Merge: the room it joins
	Level: number?, -- Upgrade: the new level
}
export type Overlay = (roomId: string, room: any) -> (string?, string?) -- lamp sprite, legend text

local SCREEN = "CommandView"
local FADE_SOURCE = "CommandView"
local FRONT_WALL_TAG = "FrontWall"
local RENDER_NAME = "100Y_CommandView"
local RENDER_PRIORITY = Enum.RenderPriority.Camera.Value - 1 -- before CameraController drains zoom input
local PING_ACTION = "100Y_CVPing"
local PICK_ACTION = "100Y_CVPick"
local HOLD_ACTION = "100Y_CVHold"
local TABS = {
	{ Id = "Build", Label = "Build", Icon = "Icon_Grid" },
	{ Id = "Power", Label = "Power", Icon = "Icon_Power" },
	{ Id = "Morale", Label = "Morale", Icon = "Icon_Check" },
	{ Id = "Threat", Label = "Threat", Icon = "Icon_Shield" },
	{ Id = "Production", Label = "Production", Icon = "Icon_Scrap" },
}
local OVERLAY_TEXT: { [string]: string } = { -- bible Section 7's overlays
	Power = "Rooms by power: lit or dark.",
	Morale = "Rooms by their workers' morale.",
	Threat = "Likely breach points.",
	Production = "Rooms by what they make each cycle.",
}
local PAN_KEYS: { [Enum.KeyCode]: Vector2 } = {
	[Enum.KeyCode.W] = Vector2.new(0, 1),
	[Enum.KeyCode.Up] = Vector2.new(0, 1),
	[Enum.KeyCode.S] = Vector2.new(0, -1),
	[Enum.KeyCode.Down] = Vector2.new(0, -1),
	[Enum.KeyCode.A] = Vector2.new(-1, 0),
	[Enum.KeyCode.Left] = Vector2.new(-1, 0),
	[Enum.KeyCode.D] = Vector2.new(1, 0),
	[Enum.KeyCode.Right] = Vector2.new(1, 0),
}
local CREAM = Color3.fromHex("#F2E6C9")
local RUST = Color3.fromHex("#B5412B")

local CommandViewController = {
	Name = "CommandViewController",
	Dependencies = { "InputController", "CameraController", "UIController", "ReplicaController", "HUDController" },
	Opened = Signal.new() :: Signal.Signal<()>,
	Closed = Signal.new() :: Signal.Signal<()>,
	Selected = Signal.new() :: Signal.Signal<number?, number?>,
}

local input: any = nil
local cameraController: any = nil
local ui: any = nil
local replica: any = nil
local inRun = false

local t: { [string]: any } = {}
local open = false
local center = Vector2.zero -- the view's centre: world X and Y
local height = 60 -- studs of the bunker that fit the view's height
local gridZ = 0
local bounds: CV.Bounds = { Left = 0, Right = 0, Top = 0, Bottom = 0 }
local moving: { Alpha: number, From: CFrame, FromFov: number, To: (() -> (CFrame, number))?, Back: boolean, Done: (() -> ())? }? = nil
local before: { CFrame: CFrame, FieldOfView: number }? = nil
local lightingBefore: { [string]: any }? = nil
local selected: { number }? = nil
local choice: Choice? = nil
local tab = "Build"
local bunker: any = nil
local bunkerDirty = true
local labels: { [string]: any } = {}
local labelsDirty = true
local ghosts: { [string]: { Frame: any, Floor: number, Column: number, Span: number } } = {}
local pings: { { Frame: any, Floor: number, Column: number, Until: number } } = {}
local blinking: { [string]: boolean } = {}
local handlers: { [string]: (Choice) -> () } = {}
local overlays: { [string]: Overlay } = {}
local selectionMark: any = nil
local drag: { Start: Vector2, Last: Vector2, Moved: boolean, Touch: InputObject? }? = nil
local pinch: { [InputObject]: Vector2 } = {}
local lastHealth: number? = nil
local frontWalls: { [BasePart]: boolean } = {}
local connections: { RBXScriptConnection } = {}

-- Layout --------------------------------------------------------------------------------------

local function gui(): ScreenGui?
	return ui:Gui()
end

local function part(path: string): any
	local root = gui()
	assert(root, "CommandViewController: no Frame")
	local found = UIContract.Find(root, path)
	assert(found, `CommandViewController: Frame.{path} is missing (see Shared.UIContract)`)
	return found
end

local function page(): any
	return part("Cabinet.Pages.CommandView")
end

local function clone(template: string): any
	local copy = part("Templates." .. template):Clone()
	copy.Visible = true
	return copy
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Screen and world ---------------------------------------------------------------------------

-- Zone C's rectangle in viewport pixels (GUI coordinates plus the top inset).
local function viewRect(): (Vector2, Vector2)
	local view = part("Cabinet.Pages.CommandView.View")
	local inset = GuiService:GetGuiInset()
	return view.AbsolutePosition + inset, view.AbsoluteSize
end

local function inView(point: Vector2): boolean
	local origin, size = viewRect()
	return point.X >= origin.X and point.Y >= origin.Y and point.X <= origin.X + size.X and point.Y <= origin.Y + size.Y
end

-- The camera for the current centre and zoom: far away along +Z, looking at the bunker's front,
-- shifted so the centre shows in the middle of zone C rather than the middle of the screen.
local function viewCFrame(): (CFrame, number)
	local camera = workspace.CurrentCamera
	local distance, fieldOfView = CV.Lens(height)
	local viewport = camera.ViewportSize
	local origin, size = viewRect()
	local zoneCentre = origin + size / 2
	local offset = zoneCentre - viewport / 2
	local perPixel = height / math.max(viewport.Y, 1)
	local position = Vector3.new(center.X - offset.X * perPixel, center.Y + offset.Y * perPixel, gridZ + distance)
	return CFrame.lookAt(position, position - Vector3.zAxis), fieldOfView
end

-- The cell under a viewport point: the ray meets the plane of the cells' centres.
local function cellAt(point: Vector2): (number?, number?)
	local ray = workspace.CurrentCamera:ViewportPointToRay(point.X, point.Y)
	if math.abs(ray.Direction.Z) < 1e-6 then
		return nil, nil
	end
	local along = (gridZ - ray.Origin.Z) / ray.Direction.Z
	if along <= 0 then
		return nil, nil
	end
	local floor, column = Grid.CellAt(ray.Origin + ray.Direction * along)
	if floor and column and Grid.OnGrid(floor, column) then
		return floor, column
	end
	return nil, nil
end

-- Cells from column to column + span - 1 on a floor (their interiors, floor to ceiling) in
-- zone C's scale.
local function cellRect(floor: number, column: number, span: number): (UDim2, UDim2, boolean)
	local camera = workspace.CurrentCamera
	local low, high = CV.CellBox(floor, column, span)
	local a = camera:WorldToViewportPoint(Vector3.new(low.X, high.Y, gridZ))
	local b = camera:WorldToViewportPoint(Vector3.new(high.X, low.Y, gridZ))
	local origin, size = viewRect()
	local x0, y0 = (math.min(a.X, b.X) - origin.X) / size.X, (math.min(a.Y, b.Y) - origin.Y) / size.Y
	local x1, y1 = (math.max(a.X, b.X) - origin.X) / size.X, (math.max(a.Y, b.Y) - origin.Y) / size.Y
	local visible = x1 > 0 and y1 > 0 and x0 < 1 and y0 < 1
	return UDim2.fromScale(x0, y0), UDim2.fromScale(x1 - x0, y1 - y0), visible
end

-- A world point in zone C's scale.
local function pointIn(world: Vector3): (UDim2, boolean)
	local p = workspace.CurrentCamera:WorldToViewportPoint(world)
	local origin, size = viewRect()
	local x, y = (p.X - origin.X) / size.X, (p.Y - origin.Y) / size.Y
	return UDim2.fromScale(x, y), x >= 0 and y >= 0 and x <= 1 and y <= 1
end

-- The bunker -----------------------------------------------------------------------------------

local function currentBunker(): any
	if bunkerDirty or not bunker then
		bunker = Bunker.FromSnapshot(replica:All("Cells"), replica:All("Rooms"))
		bunkerDirty = false
	end
	return bunker
end

local function context(): CV.Context
	local era = table.find(Config.Ids("Eras"), RunState.Get("Era") or "") or 1
	local unlocked = {}
	for roomType in replica:All("Unlocked") do
		unlocked[roomType] = true
	end
	return { Era = era, Deepest = currentBunker():DeepestFloor(), Unlocked = unlocked }
end

-- The stockpile as EconomyService replicates it (RunState, one value per resource).
local function stockNow(): { [string]: number }
	local stock = {}
	for _, id in Config.Ids("Resources") do
		if RunState.Fields[id] then
			local value = RunState.Get(id)
			if type(value) == "number" then
				stock[id] = value
			end
		end
	end
	return stock
end

local function covers(thing: any, floor: number, column: number): boolean
	return type(thing) == "table" and thing.Floor == floor and type(thing.Column) == "number"
		and column >= thing.Column and column < thing.Column + (thing.Span or 1)
end

-- The construction site on a cell (BuildService's Sites collection), if any.
local function siteAt(floor: number, column: number): any
	for _, site in replica:All("Sites") do
		if covers(site, floor, column) then
			return site
		end
	end
	return nil
end

-- The open vote (live or waiting) whose proposal covers a cell, if any.
local function voteAt(floor: number, column: number): any
	for _, vote in replica:All("Votes") do
		if type(vote) == "table" and (vote.Status == "Live" or vote.Status == "Queued") and covers(vote.Subject, floor, column) then
			return vote
		end
	end
	return nil
end

-- "120 SCRAP" when the stockpile can pay, else "120 SCRAP · 40 SHORT", and whether it can.
local function costLine(costs: { [string]: number }): (string, boolean)
	local ok, short, missing = Construction.CanAfford(costs, stockNow())
	if ok or not short then
		return CV.CostText(costs), true
	end
	return `{CV.CostText(costs)}  ·  {missing} {string.upper(Config.Get("Resources", short).Name)} SHORT`, false
end

local function roomName(roomType: string): string
	local info = Config.Find("Rooms", roomType)
	return if info then info.Name else roomType
end

-- Labels, marks and pings ---------------------------------------------------------------------

local function overlayLamp(roomId: string, room: any): string?
	if tab == "Build" then
		return nil
	end
	local provider = overlays[tab]
	if not provider then
		return nil
	end
	local ok, lamp = pcall(provider, roomId, room)
	return if ok then lamp else nil
end

local function rebuildLabels()
	labelsDirty = false
	local holder = part("Cabinet.Pages.CommandView.View.Labels")
	clear(holder)
	table.clear(labels)
	for id, room in replica:All("Rooms") do
		local label = clone("RoomLabel")
		label.Name = id
		label:FindFirstChild("Name").Text = `{string.upper(roomName(room.Type))}  ·  L{room.Level}`
		label.Parent = holder
		labels[id] = label
	end
end

local function placeLabels()
	for id, label in labels do
		local room = replica:Get("Rooms", id)
		if room then
			-- just under the room's ceiling (the label hangs from its top edge)
			local low, high = CV.CellBox(room.Floor, room.Column, room.Span)
			local top = Vector3.new((low.X + high.X) / 2, high.Y - 1, gridZ)
			local position, visible = pointIn(top)
			label.Position = position
			label.Visible = visible
			label.ImageColor3 = if blinking[id] then RUST else Color3.new(1, 1, 1)
			local lamp = label:FindFirstChild("Lamp")
			local sprite = overlayLamp(id, room)
			lamp.Visible = sprite ~= nil
			if sprite then
				KitRuntime.SetSprite(lamp, sprite)
			end
		end
	end
end

local function placeMarks()
	if selectionMark then
		local floor, column, span = selected and selected[1], selected and selected[2], 1
		if selected and floor and column then
			local roomId = currentBunker():UnitAt(floor, column)
			local room = roomId and currentBunker():Room(roomId)
			if room then
				column, span = room.Column, room.Span
			end
			local position, size, visible = cellRect(floor, column, span)
			selectionMark.Position = position
			selectionMark.Size = size
			selectionMark.Visible = visible
		else
			selectionMark.Visible = false
		end
	end
	for _, ghost in ghosts do
		local position, size, visible = cellRect(ghost.Floor, ghost.Column, ghost.Span)
		ghost.Frame.Position = position
		ghost.Frame.Size = size
		ghost.Frame.Visible = visible
	end
	local now = os.clock()
	for i = #pings, 1, -1 do
		local ping = pings[i]
		if now > ping.Until then
			ping.Frame:Destroy()
			table.remove(pings, i)
		else
			-- the pin's tip at the middle of the cell's interior
			local low, high = CV.CellBox(ping.Floor, ping.Column, 1)
			local position, visible = pointIn(Vector3.new((low.X + high.X) / 2, (low.Y + high.Y) / 2, gridZ))
			ping.Frame.Position = position
			ping.Frame.Visible = visible
		end
	end
end

-- The detail panel ------------------------------------------------------------------------------

-- "there is already one" -> "There is already one" (Rules.Bunker's reasons are lower case)
local function sentence(text: string): string
	return (string.gsub(text, "^%l", string.upper))
end

local function section(order: number, label: string, body: string)
	local s = ui:Clone("Section")
	s.LayoutOrder = order
	s:FindFirstChild("Label").Text = string.upper(label)
	s:FindFirstChild("Body").Text = body
	s.Parent = part("Cabinet.Pages.CommandView.Detail.Body")
end

local rowConnections: { RBXScriptConnection } = {}
local refreshDetail: () -> ()

local function optionRow(order: number, name: string, value: string, enabled: boolean, pick: Choice?)
	local row = clone("OptionRow")
	row.LayoutOrder = order
	row:FindFirstChild("Name").Text = string.upper(name)
	row:FindFirstChild("Value").Text = value
	row.ImageTransparency = if enabled then 0 else 0.35
	local lamp = row:FindFirstChild("Lamp")
	local isChosen = pick ~= nil and choice ~= nil and choice.Action == pick.Action and choice.RoomType == pick.RoomType
		and choice.Other == pick.Other and choice.RoomId == pick.RoomId
	KitRuntime.SetSprite(lamp, if isChosen then "Lamp_Orange" else "Lamp_Off")
	lamp.Visible = pick ~= nil
	if pick and enabled then
		table.insert(rowConnections, row.Activated:Connect(function()
			choice = pick
			refreshDetail()
		end))
	end
	row.Parent = part("Cabinet.Pages.CommandView.Detail.Options")
end

local function setMainAction()
	local current = choice
	if not current then
		ui:SetMainAction(nil)
		return
	end
	-- solo runs have no votes (Section 8, rule 6): the choice applies at once
	local verb = if (RunState.Get("ReadyNeeded") or 1) <= 1 then
		(if current.Action == "Build" then "Build" elseif current.Action == "Upgrade" then "Upgrade to" elseif current.Action == "Merge" then "Merge" else "Tear down")
		else "Propose"
	local label = if current.Action == "Build" then `{verb} {roomName(current.RoomType or "")}`
		elseif current.Action == "Upgrade" then (if verb == "Propose" then `Propose level {current.Level}` else `Upgrade to level {current.Level}`)
		elseif current.Action == "Merge" then (if verb == "Propose" then "Propose merge" else "Merge")
		else (if verb == "Propose" then "Propose teardown" else "Tear down")
	local handler = handlers[current.Action]
	ui:SetMainAction({
		Label = label,
		Enabled = handler ~= nil,
		OnPress = function()
			local h = handlers[current.Action]
			if h then
				h(current)
				-- proposed: the panel shows the proposal once the vote replicates
				choice = nil
				refreshDetail()
			end
		end,
	})
end

local function showRoom(roomId: string)
	local b = currentBunker()
	local room = b:Room(roomId) :: any
	local info = Config.Get("Rooms", room.Type)
	local detail = part("Cabinet.Pages.CommandView.Detail")
	detail:FindFirstChild("Name").Text = string.upper(info.Name)
	detail:FindFirstChild("Sub").Text = `LEVEL {room.Level}  ·  {room.Span} CELL{if room.Span > 1 then "S" else ""}  ·  FLOOR {room.Floor}`
	section(1, "Condition", if room.HP <= 0 then `Wrecked: 0 of {room.MaxHP} HP` else `{room.HP} of {room.MaxHP} HP`)
	if info.PowerOutput then
		section(2, "Power", `Makes {info.PowerOutput[room.Level] * room.Span}`)
	elseif info.Power[room.Level] > 0 then
		section(2, "Power", `Draws {info.Power[room.Level] * room.Span}`)
	end
	if info.Output and info.Output.Resource then
		local resource = Config.Get("Resources", info.Output.Resource)
		section(3, "Output", `{info.Output.Base} {resource.Name} per cell a cycle at level 1, with average workers`)
	end
	section(4, "What it does", info.Text)
	-- a proposal already open on this room: no second one until it closes (Section 8)
	local openVote = voteAt(room.Floor, room.Column)
	if openVote then
		section(5, "Proposal open", `{openVote.ProposerName}: {openVote.Title}. Vote on the banner.`)
	end
	local order = 1
	if room.Level < 3 then
		local nextLevel = room.Level + 1
		local costs = Construction.CostsAt(room.Type, nextLevel, room.Span)
		local value, affordable = costLine(costs)
		local research = Construction.ResearchFor(room.Type, nextLevel)
		local have = RunState.Get("Research") or 0
		local enabled = affordable and have >= research and not openVote
		if research > 0 then
			value = if affordable and have < research then `Needs {research} Lab research ({math.floor(have)} so far)`
				else `{value}  ·  {research} LAB RESEARCH`
		end
		optionRow(order, `Upgrade to level {nextLevel}`, value, enabled,
			if enabled then { Action = "Upgrade", Floor = room.Floor, Column = room.Column, RoomId = roomId, Level = nextLevel } else nil)
		order += 1
	end
	for _, column in { room.Column - 1, room.Column + room.Span } do
		local otherId = b:UnitAt(room.Floor, column)
		local other = otherId and b:Room(otherId)
		if other and other.Id ~= roomId then
			local ok, why = b:CanMerge(roomId, other.Id)
			if ok or other.Type == room.Type then
				local can = ok and not openVote and not voteAt(other.Floor, other.Column)
				optionRow(order, `Merge with the {roomName(other.Type)}`, if ok then `{room.Span + other.Span} cells together` else sentence(why or ""), can,
					if can then { Action = "Merge", Floor = room.Floor, Column = room.Column, RoomId = roomId, Other = other.Id } else nil)
				order += 1
			end
		end
	end
	local canRemove, why = b:CanRemove(roomId)
	local can = canRemove and not openVote
	optionRow(order, "Tear down", if canRemove then "Its cells become open cells again" else sentence(why or ""), can,
		if can then { Action = "TearDown", Floor = room.Floor, Column = room.Column, RoomId = roomId } else nil)
end

local function showOpenCell(floor: number, column: number)
	local detail = part("Cabinet.Pages.CommandView.Detail")
	detail:FindFirstChild("Sub").Text = `FLOOR {floor}  ·  COLUMN {column}  ·  {string.upper(Grid.BandOf(floor).Name)}`
	local site = siteAt(floor, column)
	if site then
		detail:FindFirstChild("Name").Text = "UNDER CONSTRUCTION"
		section(1, "Building", `A {roomName(site.Type)}: {math.floor((site.Progress or 0) * 100)}% built.`)
		section(2, "Help", if (site.Helpers or 0) > 0
			then `{site.Helpers} helping; each one builds it 25% faster.`
			else "Stand in the cell to build it faster.")
		return
	end
	local vote = voteAt(floor, column)
	if vote then
		detail:FindFirstChild("Name").Text = "PROPOSED"
		section(1, "Vote", `{vote.ProposerName}: {vote.Title}. Vote on the banner.`)
		return
	end
	detail:FindFirstChild("Name").Text = "OPEN CELL"
	section(1, "Build here", "Pick a room type, then propose it to the team.")
	local b = currentBunker()
	local ctx = context()
	local available, locked = {}, {}
	for _, roomType in Config.Ids("Rooms") do
		-- Fixed rooms (the Blast Door, the Reactor Core) come with the bunker and are never built
		if not Config.Get("Rooms", roomType).Fixed then
			local ok, why = CV.RoomChoice(b, roomType, floor, column, ctx)
			table.insert(if ok then available else locked, { Type = roomType, Why = why })
		end
	end
	local order = 1
	for _, entry in available do
		local info = Config.Get("Rooms", entry.Type)
		local value, affordable = costLine(Construction.CostsAt(entry.Type, 1))
		optionRow(order, info.Name, value, affordable,
			if affordable then { Action = "Build", Floor = floor, Column = column, RoomType = entry.Type } else nil)
		order += 1
	end
	for _, entry in locked do
		optionRow(order, Config.Get("Rooms", entry.Type).Name, sentence(entry.Why or ""), false, nil)
		order += 1
	end
end

local function showRock(floor: number, column: number)
	local detail = part("Cabinet.Pages.CommandView.Detail")
	local band = Grid.BandOf(floor)
	detail:FindFirstChild("Name").Text = "ROCK"
	detail:FindFirstChild("Sub").Text = `FLOOR {floor}  ·  COLUMN {column}  ·  {string.upper(band.Name)}`
	local b = currentBunker()
	local ok, why = b:CanDig(floor, column)
	section(1, "Digging", if ok then "Can be dug: it is beside or under a dug cell or room." else `Can't be dug yet: {why}.`)
	if band.Ore then
		section(2, "Ore", `{Config.Get("Resources", band.Ore).Name} in the {band.Name}.`)
	end
	if Grid.IsBandStart(floor) and floor > b:DeepestFloor() then
		section(3, "Next band", `The first cell of the {band.Name}: opening it needs a Push Deeper vote.`)
	end
end

local function showNothing()
	local detail = part("Cabinet.Pages.CommandView.Detail")
	local b = currentBunker()
	local rooms, open = 0, 0
	for _ in replica:All("Rooms") do
		rooms += 1
	end
	for _, cell in replica:All("Cells") do
		if type(cell) == "table" and cell.Room == nil then
			open += 1
		end
	end
	detail:FindFirstChild("Name").Text = "BUNKER SECTION"
	detail:FindFirstChild("Sub").Text = `{rooms} ROOMS  ·  {open} OPEN CELL{if open == 1 then "" else "S"}  ·  DEPTH {b:DeepestFloor()}`
	section(1, "Pick a cell", "A room to upgrade, merge or tear down, an open cell to build on, or rock to dig.")
end

local function showOverlayLegend()
	local text = OVERLAY_TEXT[tab]
	if not text then
		return
	end
	-- at the top of the detail panel, above whatever is selected
	section(0, `{tab} overlay`, if overlays[tab] then text else `{text} No readings yet.`)
end

local lastRefreshed: string? = nil -- the selection the panel last showed

refreshDetail = function()
	if not open then
		return
	end
	-- a refresh of the same selection (a vote's tally, a site's progress) keeps the menu's scroll
	local options = part("Cabinet.Pages.CommandView.Detail.Options")
	local key = if selected then Grid.Key(selected[1], selected[2]) else ""
	local scroll = if key == lastRefreshed then options.CanvasPosition else Vector2.zero
	lastRefreshed = key
	for _, connection in rowConnections do
		connection:Disconnect()
	end
	table.clear(rowConnections)
	clear(part("Cabinet.Pages.CommandView.Detail.Body"))
	clear(options)
	local cell = selected
	if not cell then
		choice = nil
		showNothing()
	else
		local state, roomId = currentBunker():State(cell[1], cell[2])
		if state == "Room" and roomId then
			showRoom(roomId)
		elseif state == "Dug" then
			showOpenCell(cell[1], cell[2])
		else
			choice = nil
			showRock(cell[1], cell[2])
		end
	end
	showOverlayLegend()
	setMainAction()
	if scroll ~= Vector2.zero then
		task.defer(function()
			options.CanvasPosition = scroll -- after the list layout has sized the canvas again
		end)
	end
end

-- Selecting and pinging -------------------------------------------------------------------------

function CommandViewController:Select(floor: number?, column: number?)
	if floor and column and Grid.OnGrid(floor, column) then
		local same = selected ~= nil and selected[1] == floor and selected[2] == column
		selected = { floor, column }
		if not same then
			choice = nil
		end
	else
		selected = nil
		choice = nil
	end
	refreshDetail()
	CommandViewController.Selected:Fire(floor, column)
end

local function pingSelected()
	if selected and Remotes.InPlace("PingCell") then
		Remotes.FireServer("PingCell", selected[1], selected[2])
	end
end

local function onPinged(floor: number, column: number)
	if not open or type(floor) ~= "number" or type(column) ~= "number" then
		return
	end
	local mark = clone("PingMark")
	mark.Parent = part("Cabinet.Pages.CommandView.View.Marks")
	table.insert(pings, { Frame = mark, Floor = floor, Column = column, Until = os.clock() + Config.Get("Tuning", "Ping").Seconds })
end

-- Moving the camera -----------------------------------------------------------------------------

local function panBy(world: Vector2)
	center = CV.Clamp(center + world, bounds)
end

local function zoomBy(factor: number)
	local pitch = Grid.Pitch()
	height = math.clamp(height * factor, t.MinFloors * pitch.Y, t.MaxFloors * pitch.Y)
end

local function readInput(dt: number)
	-- wheel and pinch (InputController gathers both; we take them before CameraController)
	local zoom = input:TakeZoom()
	if zoom ~= 0 then
		local step = Config.Get("Tuning", "Camera").ZoomStep
		zoomBy(1 + t.ZoomStep * zoom / step)
	end
	input:TakeLook(dt) -- one-finger drags arrive here too; the view pans from its own touch tracking
	local perSecond = height * t.PanFloorsPerSecond / t.StartFloors
	local move = Vector2.zero
	if not UserInputService:GetFocusedTextBox() then
		for key, direction in PAN_KEYS do
			if UserInputService:IsKeyDown(key) then
				move += direction
			end
		end
	end
	for _, state in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if state.KeyCode == Enum.KeyCode.Thumbstick1 and state.Position.Magnitude > t.StickDeadzone then
			move += Vector2.new(state.Position.X, state.Position.Y)
		elseif state.KeyCode == Enum.KeyCode.Thumbstick2 and math.abs(state.Position.Y) > t.StickDeadzone then
			zoomBy(1 - state.Position.Y * dt * 1.5)
		end
	end
	if move.Magnitude > 0 then
		panBy(move.Unit * math.min(move.Magnitude, 1) * perSecond * dt)
	end
end

local function render(dt: number)
	if not open and not moving then
		return
	end
	local camera = workspace.CurrentCamera
	if open and not (moving and moving.Back) then
		readInput(dt)
	end
	local current = moving
	if current then
		current.Alpha = math.min(1, current.Alpha + dt / math.max(t.MoveSeconds, 0.01))
		local eased = TweenService:GetValue(current.Alpha, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		local toCFrame, toFov = (current.To :: any)()
		camera.CFrame = current.From:Lerp(toCFrame, eased)
		camera.FieldOfView = current.FromFov + (toFov - current.FromFov) * eased
		if current.Alpha >= 1 then
			moving = nil
			if current.Done then
				current.Done()
			end
		end
	else
		local cframe, fov = viewCFrame()
		camera.CFrame = cframe
		camera.FieldOfView = fov
	end
	if open then
		if labelsDirty then
			rebuildLabels()
		end
		placeLabels()
		placeMarks()
		local cursor = part("Cabinet.Pages.CommandView.View.Cursor")
		cursor.Visible = input:Device() == "Gamepad"
	end
end

-- Input handlers ---------------------------------------------------------------------------------

local function onInputBegan(io: InputObject)
	if not open then
		return
	end
	if io.UserInputType == Enum.UserInputType.MouseButton1 then
		local point = UserInputService:GetMouseLocation()
		if inView(point) then
			drag = { Start = point, Last = point, Moved = false, Touch = nil }
		end
	elseif io.UserInputType == Enum.UserInputType.Touch then
		local point = Vector2.new(io.Position.X, io.Position.Y) + GuiService:GetGuiInset()
		if inView(point) then
			pinch[io] = point
			local count = 0
			for _ in pinch do
				count += 1
			end
			drag = if count == 1 then { Start = point, Last = point, Moved = false, Touch = io } else nil
		end
	end
end

local function onInputChanged(io: InputObject)
	if not open then
		return
	end
	local current = drag
	if io.UserInputType == Enum.UserInputType.MouseMovement and current and not current.Touch then
		local point = UserInputService:GetMouseLocation()
		local delta = point - current.Last
		current.Last = point
		if (point - current.Start).Magnitude > t.DragPixels then
			current.Moved = true
		end
		if current.Moved then
			local perPixel = height / math.max(workspace.CurrentCamera.ViewportSize.Y, 1)
			panBy(Vector2.new(-delta.X, delta.Y) * perPixel)
		end
	elseif io.UserInputType == Enum.UserInputType.Touch and pinch[io] then
		local point = Vector2.new(io.Position.X, io.Position.Y) + GuiService:GetGuiInset()
		pinch[io] = point
		if current and current.Touch == io then
			local delta = point - current.Last
			current.Last = point
			if (point - current.Start).Magnitude > t.DragPixels then
				current.Moved = true
			end
			if current.Moved then
				local perPixel = height / math.max(workspace.CurrentCamera.ViewportSize.Y, 1)
				panBy(Vector2.new(-delta.X, delta.Y) * perPixel)
			end
		end
	end
end

local function onInputEnded(io: InputObject)
	local current = drag
	if io.UserInputType == Enum.UserInputType.MouseButton1 and current and not current.Touch then
		drag = nil
		if open and not current.Moved then
			CommandViewController:Select(cellAt(current.Start))
		end
	elseif io.UserInputType == Enum.UserInputType.Touch then
		pinch[io] = nil
		if current and current.Touch == io then
			drag = nil
			if open and not current.Moved then
				CommandViewController:Select(cellAt(current.Start))
			end
		end
	end
end

-- Open and close ---------------------------------------------------------------------------------

-- The character stays where it was left: its movement keys and sticks are sunk while the view is
-- open (Roblox's PlayerModule isn't an instance in every place, so this goes through
-- ContextActionService rather than its controls object).
-- Roblox's touch thumbstick and jump button: hidden while the view is open, or a drag in zone C
-- could walk the character away (it stays where it was left, Section 7).
local touchControlsBefore: boolean? = nil

local function holdCharacter(on: boolean)
	if not on then
		ContextActionService:UnbindAction(HOLD_ACTION)
		if touchControlsBefore ~= nil then
			GuiService.TouchControlsEnabled = touchControlsBefore
			touchControlsBefore = nil
		end
		return
	end
	if touchControlsBefore == nil then
		touchControlsBefore = GuiService.TouchControlsEnabled
	end
	GuiService.TouchControlsEnabled = false
	ContextActionService:BindActionAtPriority(HOLD_ACTION, function()
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 20,
		Enum.PlayerActions.CharacterForward, Enum.PlayerActions.CharacterBackward,
		Enum.PlayerActions.CharacterLeft, Enum.PlayerActions.CharacterRight, Enum.PlayerActions.CharacterJump,
		Enum.KeyCode.Thumbstick1, Enum.KeyCode.Space)
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:Move(Vector3.zero)
	end
end

local function fadeFrontWalls(on: boolean)
	if on then
		for _, item in CollectionService:GetTagged(FRONT_WALL_TAG) do
			if item:IsA("BasePart") then
				Fade.Set(item, FADE_SOURCE, 1)
				frontWalls[item] = true
			end
		end
	else
		Fade.ClearSource(FADE_SOURCE)
		table.clear(frontWalls)
	end
end

local function liftLighting(on: boolean)
	if on then
		lightingBefore = {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			ExposureCompensation = Lighting.ExposureCompensation,
		}
		Lighting.Ambient = Color3.fromHex(t.Ambient)
		Lighting.OutdoorAmbient = Color3.fromHex(t.OutdoorAmbient)
		Lighting.ExposureCompensation = t.ExposureCompensation
	elseif lightingBefore then
		Lighting.Ambient = lightingBefore.Ambient
		Lighting.OutdoorAmbient = lightingBefore.OutdoorAmbient
		Lighting.ExposureCompensation = lightingBefore.ExposureCompensation
		lightingBefore = nil
	end
end

local function flashEdge()
	local edge = part("DamageEdge")
	edge.Visible = true
	for _, strip in edge:GetChildren() do
		if strip:IsA("Frame") then
			strip.BackgroundTransparency = 0
			TweenService:Create(strip, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = 1,
			}):Play()
		end
	end
	task.delay(0.65, function()
		if edge.Parent then
			edge.Visible = false
		end
	end)
end

local function helpText(): string
	local device = input:Device()
	if device == "Gamepad" then
		return "LEFT STICK MOVE  ·  RIGHT STICK ZOOM  ·  A PICK  ·  D-PAD UP PING"
	elseif device == "Touch" then
		return "DRAG TO MOVE  ·  PINCH TO ZOOM  ·  TAP A CELL"
	end
	return "DRAG OR WASD TO MOVE  ·  SCROLL TO ZOOM  ·  CLICK A CELL  ·  G PING"
end

local function bindKeys(on: boolean)
	if not on then
		ContextActionService:UnbindAction(PING_ACTION)
		ContextActionService:UnbindAction(PICK_ACTION)
		return
	end
	ContextActionService:BindActionAtPriority(PING_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then
			pingSelected()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 20, Enum.KeyCode.G, Enum.KeyCode.DPadUp)
	ContextActionService:BindActionAtPriority(PICK_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then
			local origin, size = viewRect()
			CommandViewController:Select(cellAt(origin + size / 2))
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 30, Enum.KeyCode.ButtonA)
end

local function onOpen(_page: Frame)
	open = true
	local camera = workspace.CurrentCamera
	before = { CFrame = camera.CFrame, FieldOfView = camera.FieldOfView }
	cameraController:Suspend(SCREEN)
	camera.CameraType = Enum.CameraType.Scriptable
	holdCharacter(true)
	bounds = CV.Bounds()
	gridZ = Grid.CellPosition(1, 0).Z
	height = t.StartFloors * Grid.Pitch().Y
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	center = CV.Clamp(if root and root:IsA("BasePart") then Vector2.new(root.Position.X, root.Position.Y) else Vector2.zero, bounds)
	selected = nil
	choice = nil
	labelsDirty = true
	fadeFrontWalls(true)
	liftLighting(true)
	selectionMark = clone("CellMark")
	selectionMark.Visible = false
	selectionMark.Parent = part("Cabinet.Pages.CommandView.View.Marks")
	part("Cabinet.Pages.CommandView.View.Help.Text").Text = helpText()
	ui:SetFooterActions({ { Label = "Ping", OnPress = pingSelected } })
	bindKeys(true)
	GuiService.SelectedObject = nil
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	lastHealth = if humanoid then humanoid.Health else nil
	moving = { Alpha = 0, From = camera.CFrame, FromFov = camera.FieldOfView, To = viewCFrame, Back = false, Done = nil }
	refreshDetail()
	CommandViewController.Opened:Fire()
end

local function onClose()
	if not open then
		return
	end
	open = false
	bindKeys(false)
	drag = nil
	table.clear(pinch)
	for _, ping in pings do
		ping.Frame:Destroy()
	end
	table.clear(pings)
	if selectionMark then
		selectionMark:Destroy()
		selectionMark = nil
	end
	for _, connection in rowConnections do
		connection:Disconnect()
	end
	table.clear(rowConnections)
	fadeFrontWalls(false)
	liftLighting(false)
	holdCharacter(false)
	local camera = workspace.CurrentCamera
	local back = before
	before = nil
	if back then
		local target = back
		moving = {
			Alpha = 0,
			From = camera.CFrame,
			FromFov = camera.FieldOfView,
			To = function()
				return target.CFrame, target.FieldOfView
			end,
			Back = true,
			Done = function()
				cameraController:Resume(SCREEN)
			end,
		}
	else
		cameraController:Resume(SCREEN)
	end
	CommandViewController.Closed:Fire()
end

-- API ----------------------------------------------------------------------------------------------

function CommandViewController:Toggle()
	if not inRun or not ui:Gui() then
		return
	end
	if ui:Current() == SCREEN then
		ui:Close()
	elseif not ui:IsOpen() then
		ui:Open(SCREEN)
	end
end

function CommandViewController:IsOpen(): boolean
	return open
end

-- A proposal's handler: "Build", "Upgrade", "Merge" or "TearDown" (the votes, Prompt 8).
function CommandViewController:SetHandler(action: string, handler: ((Choice) -> ())?)
	handlers[action] = handler
	if open then
		setMainAction()
	end
end

-- An overlay's provider: (roomId, room) -> lamp sprite (Lamp_Green, Lamp_Amber, Lamp_Red...).
function CommandViewController:SetOverlay(name: string, provider: Overlay?)
	assert(OVERLAY_TEXT[name], `CommandViewController: no overlay {name}`)
	overlays[name] = provider
	if open then
		refreshDetail()
	end
end

-- A ghost outline for an open vote (Section 7), until HideGhost.
function CommandViewController:ShowGhost(id: string, floor: number, column: number, span: number, label: string?)
	CommandViewController:HideGhost(id)
	if not gui() then
		return
	end
	local mark = clone("CellMark")
	mark.BackgroundColor3 = CREAM
	local stroke = mark:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = CREAM
	end
	local text = mark:FindFirstChild("Label")
	if text and label then
		text.Text = string.upper(label)
		text.Visible = true
	end
	mark.Parent = part("Cabinet.Pages.CommandView.View.Marks")
	ghosts[id] = { Frame = mark, Floor = floor, Column = column, Span = span }
end

-- Changes a ghost's label (a site's progress: "KITCHEN 45%").
function CommandViewController:SetGhostLabel(id: string, label: string)
	local ghost = ghosts[id]
	local text = ghost and ghost.Frame:FindFirstChild("Label")
	if text then
		text.Text = string.upper(label)
		text.Visible = true
	end
end

function CommandViewController:HideGhost(id: string)
	local ghost = ghosts[id]
	if ghost then
		ghost.Frame:Destroy()
		ghosts[id] = nil
	end
end

-- Lights a room's label (by room id) rust red while on.
function CommandViewController:Blink(key: string, on: boolean)
	blinking[key] = if on then true else nil
end

function CommandViewController:State(): { [string]: any }
	local pitch = Grid.Pitch()
	return {
		Open = open,
		Center = center,
		Floors = height / pitch.Y,
		Distance = (CV.Lens(height)),
		Selected = if selected then Grid.Key(selected[1], selected[2]) else nil,
		Choice = if choice then `{choice.Action} {choice.RoomType or choice.RoomId or ""}` else nil,
		Tab = tab,
		Labels = (function()
			local n = 0
			for _ in labels do
				n += 1
			end
			return n
		end)(),
		Pings = #pings,
		Ghosts = (function()
			local n = 0
			for _ in ghosts do
				n += 1
			end
			return n
		end)(),
		Blinking = (function()
			local keys = {}
			for key in blinking do
				table.insert(keys, key)
			end
			table.sort(keys)
			return table.concat(keys, ",")
		end)(),
		FieldOfView = workspace.CurrentCamera.FieldOfView,
	}
end

-- Lifecycle ------------------------------------------------------------------------------------------

function CommandViewController:Init(registry)
	input = registry.InputController
	cameraController = registry.CameraController
	ui = registry.UIController
	replica = registry.ReplicaController
	inRun = Constants.PlaceKind() == "Run"
	t = CV.Tuning()
end

function CommandViewController:Start()
	if not inRun then
		return
	end
	local waited = 0
	while not ui:Gui() and waited < 20 do
		waited += task.wait(0.25)
	end
	local root = ui:Gui()
	if not root or not UIContract.Find(root, "Cabinet.Pages.CommandView") then
		log:Warn("the Frame has no Command View page; it can't open")
		return
	end
	ui:Register(SCREEN, {
		Title = "Command View",
		Subtitle = "STEADFAST SHELTER CO.  ·  BUNKER IN SECTION",
		Tabs = TABS,
		Page = SCREEN,
		Docked = true,
		GamepadSelect = false,
		Hint = "Your character stays where you left it, and can be hit.",
		OnOpen = function(p: Frame)
			onOpen(p)
		end,
		OnTab = function(id: string)
			tab = id
			if open then
				refreshDetail()
			end
		end,
		OnClose = onClose,
	})
	input:On("CommandView", function()
		CommandViewController:Toggle()
	end)
	replica:Changed("Cells"):Connect(function()
		bunkerDirty = true
		if open then
			refreshDetail()
		end
	end)
	replica:Changed("Rooms"):Connect(function()
		bunkerDirty = true
		labelsDirty = true
		if open then
			refreshDetail()
		end
	end)
	-- sites, votes, unlocks and the stockpile change what the panel offers: refresh it, at most
	-- twice a second
	local pending = false
	local function soon()
		if open and not pending then
			pending = true
			task.delay(0.5, function()
				pending = false
				if open then
					refreshDetail()
				end
			end)
		end
	end
	for _, name in { "Sites", "Votes", "Unlocked" } do
		replica:Changed(name):Connect(soon)
	end
	for _, id in Config.Ids("Resources") do
		if RunState.Fields[id] then
			RunState.Changed(id):Connect(soon)
		end
	end
	RunState.Changed("Research"):Connect(soon)
	RunState.Changed("ReadyNeeded"):Connect(soon)
	Remotes.OnClient("CellPinged", onPinged)
	CollectionService:GetInstanceAddedSignal(FRONT_WALL_TAG):Connect(function(item: Instance)
		if open and item:IsA("BasePart") then
			Fade.Set(item, FADE_SOURCE, 1)
		end
	end)
	input.DeviceChanged:Connect(function()
		if open then
			part("Cabinet.Pages.CommandView.View.Help.Text").Text = helpText()
		end
	end)
	table.insert(connections, UserInputService.InputBegan:Connect(onInputBegan))
	table.insert(connections, UserInputService.InputChanged:Connect(onInputChanged))
	table.insert(connections, UserInputService.InputEnded:Connect(onInputEnded))
	local function watchHealth(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid and humanoid:IsA("Humanoid") then
			lastHealth = humanoid.Health -- so the first hit after spawning flashes too
			humanoid.HealthChanged:Connect(function(health: number)
				if open and lastHealth and health < lastHealth then
					flashEdge()
				end
				lastHealth = health
			end)
		end
	end
	Players.LocalPlayer.CharacterAdded:Connect(watchHealth)
	if Players.LocalPlayer.Character then
		task.spawn(watchHealth, Players.LocalPlayer.Character)
	end
	RunService:BindToRenderStep(RENDER_NAME, RENDER_PRIORITY, render)
	log:Debug("Command View ready")
end

return CommandViewController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C0"><Properties><string name="Name">DevController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DevController: the client side of DevTools.

	For players the server marked DevAllowed (everyone in Studio, admins in a live game) it
	adds a chat command: `/dev <command> [args]` (or `/d`). Commands run on the server
	(DevService checks permission again); the answer comes back as a Notice, shown in the
	chat and the output. Four commands run on the client:
	* `/dev replica <collection>` prints this client's mirror of a collection;
	* `/dev client` prints the client's replication counters;
	* `/dev clock` prints the run state as this client sees it (Run place), with the time
	  left counted on this client from the replicated server time;
	* `/dev ready [true|false]` fires the SetReady remote, as the HUD's Ready button will,
	  and reports what the server did;
	* `/dev camera` prints the over-the-shoulder camera's state; `camera.shoulder`,
	  `camera.aim [true|false]`, `camera.look <yaw> <pitch>` (degrees), `camera.zoom <studs>`
	  and `camera.cursor` (frees or locks the mouse) drive it for tests.
	* `/dev ui` prints The Frame's state; `ui.sample`, `ui.list` and `ui.dock` open the dev sample screens
	  (Lib.UISamples), `ui.open <screen>` any registered screen, `ui.close` closes, `ui.tab <id>`
	  switches tabs, `ui.main` presses the main action.
	* `/dev hud` prints the HUD's state; `hud.alert <Danger|Warning|Info> <text>`,
	  `hud.banner <text>`, `hud.slot <1-5>` and `hud.touch [true|false]` (shows the touch
	  buttons on any device, for screenshots) drive it.
	* `/dev vote` prints the vote telegram (what it shows, your vote) and the Command View's
	  ghosts; the server's `votes`, `vote.yes|no [n]`, `vote.end` and `vote.bots` run votes.
	* `/dev cv` prints the Command View's state (with the detail panel's options); `cv.open`,
	  `cv.close`, `cv.select <floor> <column>` and `cv.ping` drive it; `cv.ghost <floor> <column>
	  <span> [label]` / `cv.unghost` show a vote's ghost outline, `cv.blink <roomId> [false]` blinks
	  a room's label, `cv.overlay <Power|Morale|Threat|Production> [false]` sets a sample reading.

	In Studio it also makes PlayerScripts.DevInvoke (a BindableFunction) so tools can run the
	same commands from the Client datamodel: DevInvoke:Invoke("replica _SelfTest").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Log = require(Shared.Utilities.Log)
local UISamples = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("UISamples"))
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local TableUtil = require(Shared.Utilities.TableUtil)

local log = Log.new("DevController")
local CHAT_LINES = 12

local DevController = {
	Name = "DevController",
	Dependencies = {
		"ReplicaController",
		"InputController",
		"CameraController",
		"UIController",
		"HUDController",
		"CommandViewController",
		"VoteController",
	},
}

local replica: any = nil
local camera: any = nil
local ui: any = nil
local hud: any = nil
local registryInput: any = nil
local commandView: any = nil
local voteView: any = nil
local devCursorFree = false
local lastNotice: string? = nil
local commandMade = false

local function dump(value: any, depth: number?): string
	local level = depth or 0
	if type(value) == "string" then
		return if value == "\0none" then "NONE" else string.format("%q", value)
	elseif typeof(value) == "Vector3" then
		return string.format("(%g, %g, %g)", value.X, value.Y, value.Z)
	elseif type(value) ~= "table" then
		return tostring(value)
	elseif level > 4 then
		return "{...}"
	end
	local parts = {}
	for _, key in TableUtil.SortedKeys(value) do
		table.insert(parts, `{tostring(key)}={dump(value[key], level + 1)}`)
	end
	return "{" .. table.concat(parts, ", ") .. "}"
end

local function escape(text: string): string
	return (string.gsub(string.gsub(string.gsub(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

local function show(text: string)
	print(`[100Y dev] {text}`)
	local channels = TextChatService:FindFirstChild("TextChannels")
	local system = channels and channels:FindFirstChild("RBXSystem")
	if system and system:IsA("TextChannel") then
		local lines = string.split(text, "\n")
		for index = 1, math.min(#lines, CHAT_LINES) do
			pcall(system.DisplaySystemMessage, system, escape(lines[index]))
		end
		if #lines > CHAT_LINES then
			pcall(system.DisplaySystemMessage, system, `... {#lines - CHAT_LINES} more lines in the output (F9)`)
		end
	end
end

local function parse(text: string): (string, { any })
	local words = {}
	for word in string.gmatch(text, "%S+") do
		local number = tonumber(word)
		if word == "true" or word == "false" then
			table.insert(words, word == "true")
		elseif number ~= nil and number == number and math.abs(number) ~= math.huge then
			table.insert(words, number)
		else
			table.insert(words, string.sub(word, 1, 120))
		end
	end
	local name = table.remove(words, 1)
	return if type(name) == "string" then name else "help", words
end

local function describeClock(): string
	local runPhase = RunState.Get("RunPhase")
	if runPhase == nil then
		return "no run state in this place"
	end
	local left = RunState.TimeLeft()
	local leftText = if RunState.Get("PhaseOpen") then "no timer (until its boss is beaten)"
		elseif left then string.format("%.1f s left", left)
		else "stopped"
	local boss = RunState.Get("SurgeBoss")
	local bossText = if boss then ` ({boss})` else ""
	return `client sees: {runPhase}, cycle {RunState.Get("Cycle")}, Year {RunState.Get("Year")} ({RunState.Get("Era")}), `
		.. `{RunState.Get("CyclePhase") or "-"} {leftText}, siren {tostring(RunState.Get("Siren") == true)}, `
		.. `Surge {RunState.Get("SurgeKind") or "-"}{bossText}, {RunState.Get("YearsPerCycle")} years per cycle, `
		.. `ready {RunState.Get("ReadyCount") or 0}/{RunState.Get("ReadyNeeded") or 0}`
end

local function pressReady(on: boolean): string
	if not Remotes.InPlace("SetReady") then
		return "there is no run clock in this place"
	end
	local player = Players.LocalPlayer
	Remotes.FireServer("SetReady", on)
	local waited = 0
	while waited < 2 and player:GetAttribute("Ready") ~= on and not (on and RunState.Get("Siren") == true) do
		waited += task.wait()
	end
	return `SetReady {on}: my Ready is {tostring(player:GetAttribute("Ready"))}\n{describeClock()}`
end

local function describeUI(): string
	task.wait()
	local gui = ui:Gui()
	if not gui then
		return "ui: no Frame in this place"
	end
	local page = ui:Page()
	local items = 0
	if page then
		local content = page:FindFirstChild("Content")
		for _, name in { "Grid", "List" } do
			local holder = content and content:FindFirstChild(name)
			if holder and holder:IsA("GuiObject") and holder.Visible then
				for _, child in holder:GetChildren() do
					if child:IsA("GuiObject") then
						items += 1
					end
				end
			end
		end
	end
	return string.format(
		"ui: %s, screen %s, tab %s, %d items, cursor free %s, input blocked %s",
		if gui.Enabled then "open" else "closed",
		tostring(ui:Current()),
		tostring(ui:CurrentTab()),
		items,
		tostring(camera:State().CursorFree),
		tostring(registryInput:IsBlocked())
	)
end

local function describeHUD(): string
	task.wait()
	local state = hud:State()
	if not state.Present then
		return "hud: no HUD in this place"
	end
	return string.format(
		"hud: %s, year %s, phase %s, time %s, ready button %s, slot %d, touch %s, class %s",
		if state.Enabled then "shown" elseif state.Hidden then "hidden (a menu is open)" else "hidden",
		tostring(state.Year),
		tostring(state.Phase),
		tostring(state.TimeLeft),
		tostring(state.Ready),
		state.Slot,
		tostring(state.Touch),
		tostring(state.Class)
	)
end

local function describeCommandView(): string
	task.wait()
	task.wait()
	local state = commandView:State()
	local main = ""
	local gui = ui:Gui()
	local button = gui and gui:FindFirstChild("Cabinet") and gui.Cabinet:FindFirstChild("MainAction")
	if button and button.Visible then
		main = `, main action "{button.Content.Label.Text}" ({if button:GetAttribute("Disabled") then "greyed out" else "live"})`
	end
	local detail = ""
	local page = gui and gui:FindFirstChild("Cabinet") and gui.Cabinet.Pages:FindFirstChild("CommandView")
	if page then
		local options = {}
		for _, row in page.Detail.Options:GetChildren() do
			if row:IsA("GuiObject") then
				table.insert(options, { row.LayoutOrder, `{row:FindFirstChild("Name").Text} ({row:FindFirstChild("Value").Text})` })
			end
		end
		table.sort(options, function(a, b)
			return a[1] < b[1]
		end)
		local names = {}
		for i, option in options do
			if i <= 24 then
				table.insert(names, `{i}. {option[2]}`)
			end
		end
		detail = `\n  detail: {page.Detail:FindFirstChild("Name").Text} / {page.Detail.Sub.Text}`
			.. (if #names > 0 then "\n  options: " .. table.concat(names, "; ") else "")
	end
	return string.format(
		"command view: %s, centre (%.0f, %.0f), %.1f floors high, camera %.0f studs away, FOV %.1f, selected %s, choice %s, tab %s, %d labels, %d pings",
		if state.Open then "open" else "closed",
		state.Center.X,
		state.Center.Y,
		state.Floors,
		state.Distance,
		state.FieldOfView,
		tostring(state.Selected),
		tostring(state.Choice),
		state.Tab,
		state.Labels,
		state.Pings
	) .. (if state.Ghosts > 0 then `, {state.Ghosts} ghost(s)` else "")
		.. (if state.Blinking ~= "" then `, blinking {state.Blinking}` else "") .. main .. detail
end

local function describeCamera(): string
	task.wait() -- let a frame apply what the command changed
	task.wait()
	local state = camera:State()
	local p = state.Position
	return string.format(
		"camera: %s, %s shoulder, yaw %.0f, pitch %.0f, zoom %.1f (wanted %.1f), %s%s, FOV %.0f, %s%s, %d faded, device %s%s at (%.1f, %.1f, %.1f)",
		if state.Stopped then "STOPPED (Roblox camera)" elseif state.Active then "on" else "suspended",
		state.Shoulder,
		state.Yaw,
		state.Pitch,
		state.Distance,
		state.Wanted,
		if state.Indoors then "indoors" else "outdoors",
		if state.Blocked then ", held in by a wall" else "",
		state.FieldOfView,
		if state.Aiming then "aiming" else "not aiming",
		if state.CursorFree then ", cursor free" else "",
		state.Fading,
		state.Device,
		if state.Suspended then ", suspended" else "",
		p.X,
		p.Y,
		p.Z
	)
end

-- Runs a command line; client-side commands answer here, the rest go to the server.
local function run(text: string): string?
	local name, args = parse(text)
	if name == "replica" then
		local collection = tostring(args[1] or "")
		local values = replica:All(collection)
		local keys = TableUtil.SortedKeys(values)
		if #keys == 0 then
			return `{collection}: empty on this client`
		end
		local lines = { `{collection}: {#keys} values` }
		for _, key in keys do
			table.insert(lines, `  {key} = {dump(values[key])}`)
		end
		return table.concat(lines, "\n")
	elseif name == "client" then
		local stats = replica:Stats()
		return `client: ready={tostring(replica:IsReady())}, delta events {stats.Events}, ops {stats.Ops}, snapshots {stats.Snapshots}`
	elseif name == "clock" then
		return describeClock()
	elseif name == "ready" then
		return pressReady(args[1] ~= false)
	elseif name == "camera" then
		return describeCamera()
	elseif name == "camera.shoulder" then
		camera:SwapShoulder()
		return describeCamera()
	elseif name == "camera.aim" then
		camera:SetAiming(args[1] ~= false)
		return describeCamera()
	elseif name == "camera.look" then
		camera:SetLook(tonumber(args[1]) or 0, tonumber(args[2]) or 0)
		return describeCamera()
	elseif name == "camera.zoom" then
		camera:SetZoom(tonumber(args[1]) or 9)
		return describeCamera()
	elseif name == "camera.cursor" then
		devCursorFree = not devCursorFree
		camera:FreeCursor("DevTools", devCursorFree)
		return describeCamera()
	elseif name == "ui" then
		return describeUI()
	elseif name == "ui.sample" or name == "ui.list" or name == "ui.dock" then
		UISamples.Register(ui, replica)
		ui:Open(if name == "ui.sample" then "Sample" elseif name == "ui.list" then "SampleList" else "SampleDocked")
		return describeUI()
	elseif name == "ui.open" then
		UISamples.Register(ui, replica)
		ui:Open(tostring(args[1] or "Sample"))
		return describeUI()
	elseif name == "ui.close" then
		ui:Close()
		return describeUI()
	elseif name == "ui.tab" then
		ui:SelectTab(tostring(args[1] or ""))
		return describeUI()
	elseif name == "ui.main" then
		ui:PressMainAction()
		return describeUI()
	elseif name == "hud" then
		return describeHUD()
	elseif name == "hud.alert" then
		local kind = tostring(args[1] or "Warning")
		local words = {}
		for i = 2, #args do
			table.insert(words, tostring(args[i]))
		end
		hud:Alert(if kind == "Danger" or kind == "Info" then kind else "Warning", table.concat(words, " "))
		return describeHUD()
	elseif name == "hud.banner" then
		local words = {}
		for _, word in args do
			table.insert(words, tostring(word))
		end
		hud:Banner(table.concat(words, " "), "Warning", 6)
		return describeHUD()
	elseif name == "hud.slot" then
		hud:SelectSlot(tonumber(args[1]) or 1)
		return describeHUD()
	elseif name == "hud.touch" then
		hud:SetForceTouch(args[1] ~= false)
		return describeHUD()
	elseif name == "vote" then
		local state = voteView:State()
		return `vote telegram: {if state.Visible then "showing " .. tostring(state.Shown) else "hidden"}`
			.. (if state.Visible then `\n  {state.Proposal}\n  {state.Tally}\n  your vote: {tostring(state.Mine)}` else "")
			.. `\n  ghosts: {if state.Ghosts ~= "" then state.Ghosts else "none"}`
	elseif name == "cv" then
		return describeCommandView()
	elseif name == "cv.open" or name == "cv.close" then
		if commandView:IsOpen() ~= (name == "cv.open") then
			commandView:Toggle()
		end
		task.wait(0.5)
		return describeCommandView()
	elseif name == "cv.select" then
		commandView:Select(tonumber(args[1]), tonumber(args[2]))
		return describeCommandView()
	elseif name == "cv.ping" then
		local state = commandView:State()
		if not state.Selected then
			return "cv.ping: select a cell first (cv.select <floor> <column>)"
		end
		local floor, column = string.match(state.Selected, "^(%-?%d+),(%-?%d+)$")
		Remotes.FireServer("PingCell", tonumber(floor), tonumber(column))
		task.wait(0.5)
		return describeCommandView()
	elseif name == "cv.ghost" then
		-- the outline a vote will show for a proposed room (Prompt 8 calls ShowGhost)
		commandView:ShowGhost("dev", tonumber(args[1]) or 2, tonumber(args[2]) or 3, tonumber(args[3]) or 1,
			if args[4] ~= nil then tostring(args[4]) else "Proposed")
		return describeCommandView()
	elseif name == "cv.unghost" then
		commandView:HideGhost("dev")
		return describeCommandView()
	elseif name == "cv.blink" then
		commandView:Blink(tostring(args[1] or "R1"), args[2] ~= false)
		return describeCommandView()
	elseif name == "cv.overlay" then
		-- a sample reading for screenshots (green, amber, red by room number), until the systems
		-- that own each overlay register real ones
		local overlay = tostring(args[1] or "Power")
		if args[2] == false then
			commandView:SetOverlay(overlay, nil)
		else
			local lamps = { "Lamp_Green", "Lamp_Amber", "Lamp_Red" }
			commandView:SetOverlay(overlay, function(roomId: string): string?
				return lamps[(tonumber(string.match(roomId, "%d+")) or 0) % 3 + 1]
			end)
		end
		return describeCommandView()
	end
	if #args > 8 then
		return "at most 8 arguments"
	end
	Remotes.FireServer("DevCommand", string.sub(name, 1, 48), args)
	return nil
end

local function makeChatCommand()
	if commandMade or Players.LocalPlayer:GetAttribute("DevAllowed") ~= true then
		return
	end
	commandMade = true
	local command = Instance.new("TextChatCommand")
	command.Name = "DevCommand"
	command.PrimaryAlias = "/dev"
	command.SecondaryAlias = "/d"
	command.Triggered:Connect(function(_source: TextSource, message: string)
		local rest = string.match(message, "^%S+%s*(.*)$") or ""
		local answer = run(if rest == "" then "help" else rest)
		if answer then
			show(answer)
		end
	end)
	command.Parent = TextChatService
	log:Debug("/dev ready")
end

function DevController:Init(registry)
	replica = registry.ReplicaController
	camera = registry.CameraController
	ui = registry.UIController
	hud = registry.HUDController
	registryInput = registry.InputController
	commandView = registry.CommandViewController
	voteView = registry.VoteController
	Remotes.OnClient("Notice", function(text: any)
		if type(text) == "string" then
			lastNotice = text
			show(text)
		end
	end)
end

function DevController:Start()
	local player = Players.LocalPlayer
	player:GetAttributeChangedSignal("DevAllowed"):Connect(makeChatCommand)
	makeChatCommand()

	if RunService:IsStudio() then
		local invoke = Instance.new("BindableFunction")
		invoke.Name = "DevInvoke"
		invoke.OnInvoke = function(line: any): string
			if type(line) ~= "string" then
				return "usage: DevInvoke:Invoke(\"replica Rooms\")"
			end
			lastNotice = nil
			local answer = run(line)
			if answer then
				return answer
			end
			local waited = 0
			while lastNotice == nil and waited < 5 do
				waited += task.wait()
			end
			return lastNotice or "no answer from the server within 5 s"
		end
		invoke.Parent = script.Parent.Parent
	end
end

return DevController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C1"><Properties><string name="Name">HUDController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	HUDController: the run HUD (bible Section 18), StarterGui.HUD in the Run place. Fixed
	positions, separate from The Frame; this controller only fills the layout in.

	Live now:
	* Top centre: the year flip counter (the tiles flip when the year changes), the era, the
	  cycle dial (day, then Surge) with the phase and the time left, and the Ready button with
	  the team's count (the SetReady remote). A boss Surge has no timer.
	* Banners under the vote telegram: the siren and the start of each Surge.
	* Top left: health from the character; the class and its ability (the Survivor until the
	  loadout arrives); stamina and radiation rest until combat.
	* Top right: the stockpile chips (values come with the economy, Prompt 9), the seismograph
	  at rest (Disturbance, Prompt 14) and the Command View button.
	* Bottom centre: the hotbar's selection (1 to 5, the D-pad, a tap).
	* Bottom right on touch: Fire, Aim, Melee, Ability, Interact, Jump, Dodge, Sprint (a
	  toggle), Ping and Shoulder, bound through InputController. Roblox's own jump button is
	  hidden while ours shows.

	On PC the camera locks the mouse; a click of the mouse wheel frees the cursor to click HUD
	buttons, and another click locks it again. Ready has its own key (Z, D-pad down).

	For later systems: Alert(kind, text) for the alert feed, Banner(text, kind) for
	announcements, SetVital, SetClass, SetResource, SetSlot and the HotbarSelected signal.

	The HUD hides during the intro and while a Frame screen is open.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Grid = require(Shared.Rules.Grid)
local Hud = require(Shared.Rules.Hud)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local UIContract = require(Shared.UIContract)
local Lib = script.Parent.Parent:WaitForChild("Lib")
local KitRuntime = require(Lib:WaitForChild("KitRuntime"))
local UIKit = require(Lib:WaitForChild("UIKit"))

local log = Log.new("HUDController")

export type AlertKind = "Danger" | "Warning" | "Info"

local COLORS = {
	cream = Color3.fromHex("#F2E6C9"),
	navy = Color3.fromHex("#1B2A3A"),
	hazard = Color3.fromHex("#F2C14E"),
	signal = Color3.fromHex("#E8743B"),
	leaf = Color3.fromHex("#7CC26A"),
}
-- The stockpile chips: Section 18 lists power, Food, Water, Scrap, ore and Ammo.
local STOCK = {
	{ Id = "Power", Icon = "Icon_Power" },
	{ Id = "Food", Icon = "Icon_Food" },
	{ Id = "Water", Icon = "Icon_Water" },
	{ Id = "Scrap", Icon = "Icon_Scrap" },
	{ Id = "Iron", Icon = "Icon_Iron" },
	{ Id = "Copper", Icon = "Icon_Copper" },
	{ Id = "Crystal", Icon = "Icon_Crystal" },
	{ Id = "Ammo", Icon = "Icon_Ammo" },
}
-- Touch buttons and the actions they drive (Jump and the Sprint toggle are handled here).
local TOUCH_ACTIONS = {
	Fire = "Fire",
	Aim = "Aim",
	Melee = "Melee",
	Ability = "Ability",
	Interact = "Interact",
	Dodge = "Dodge",
	Ping = "Ping",
	Shoulder = "SwapShoulder",
}
local ABILITY_ICONS: { [string]: string } = { Security = "Icon_Shield" } -- more with the class icons (A11)
local MAX_ALERTS = 3
local FLIP_SECONDS = 0.07
local TICK_SECONDS = 0.1

local HUDController = {
	Name = "HUDController",
	Dependencies = { "InputController", "UIController", "CameraController", "ReplicaController" },
	HotbarSelected = Signal.new() :: Signal.Signal<number>,
}

local input: any = nil
local replica: any = nil
local ui: any = nil
local camera: any = nil
local gui: ScreenGui? = nil
local inRun = false
local hidden: { [string]: boolean } = {}
local forceTouch = false
local sprintOn = false
local selectedSlot = 1
local alertCount = 0
local bannerToken = 0
local shownYear: number? = nil
local digitHome: { [Instance]: { UDim2 } } = {}
local resourceChips: { [string]: any } = {}
local jumpGuard: RBXScriptConnection? = nil
local classId = "Survivor"
local classLevel = 1

local function part(path: string): any
	assert(gui, "HUDController: no HUD")
	local found = UIContract.Find(gui, path)
	assert(found, `HUDController: HUD.{path} is missing (see Shared.UIContract)`)
	return found
end

local function clone(template: string): any
	local copy = part("Templates." .. template):Clone()
	copy.Visible = true
	return copy
end

local function humanoid(): Humanoid?
	local character = Players.LocalPlayer.Character
	return if character then character:FindFirstChildOfClass("Humanoid") else nil
end

local function refreshVisible()
	if not gui then
		return
	end
	local phase = RunState.Get("RunPhase")
	local live = inRun and (phase == "Playing" or phase == "Ended")
	gui.Enabled = live and next(hidden) == nil
end

-- Top centre --------------------------------------------------------------------------------

local function flip(digit: TextLabel, value: string)
	local home = digitHome[digit]
	if not home then
		home = { digit.Size, digit.Position }
		digitHome[digit] = home
	end
	if digit.Text == value then
		return
	end
	local size, position = home[1], home[2]
	local squash = TweenService:Create(digit, TweenInfo.new(FLIP_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = UDim2.new(size.X.Scale, 0, 0, 0),
		Position = UDim2.new(position.X.Scale, 0, position.Y.Scale + size.Y.Scale / 2, 0),
	})
	squash.Completed:Once(function()
		digit.Text = value
		TweenService:Create(digit, TweenInfo.new(FLIP_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = size,
			Position = position,
		}):Play()
	end)
	squash:Play()
end

local function showYear()
	local year = RunState.Get("Year")
	if type(year) ~= "number" then
		return
	end
	local digits = Hud.YearDigits(year)
	for i = 1, 3 do
		local digit = part(`YearClock.Tile{i}.Digit`)
		if shownYear == nil then
			digit.Text = digits[i]
		else
			flip(digit, digits[i])
		end
	end
	shownYear = year
end

local function showEra()
	local id = RunState.Get("Era")
	local era = if type(id) == "string" then Config.Find("Eras", id) else nil
	if not era then
		part("YearClock.Era").Text = ""
		part("YearClock.EraName").Text = ""
		return
	end
	local index = table.find(Config.Ids("Eras"), id)
	part("YearClock.Era").Text = "ERA " .. Hud.Numeral(index or 1)
	part("YearClock.EraName").Text = string.upper(era.Name)
end

local function bossName(): string
	local id = RunState.Get("SurgeBoss")
	local boss = if type(id) == "string" then Config.Find("Bosses", id) else nil
	return if boss then string.upper(boss.Name) else "THE BOSS"
end

local function tickClock()
	local phase = RunState.Get("CyclePhase")
	local open = RunState.Get("PhaseOpen") == true
	local siren = RunState.Get("Siren") == true
	local left = RunState.TimeLeft()
	local scale = RunState.Get("TimeScale")
	local length = RunState.Get("PhaseLength")
	local realLength = if type(length) == "number" then length / (if type(scale) == "number" and scale > 0 then scale else 1) else nil
	local clock = Config.Get("Tuning", "Clock")
	local pointer = part("CycleDial.Pointer")
	pointer.Position = UDim2.fromScale(
		Hud.DialPosition(phase, realLength, left, open, clock.DaySeconds, clock.SurgeSeconds),
		pointer.Position.Y.Scale
	)
	local phaseText, phaseColor = "", COLORS.cream
	if phase == "Day" then
		phaseText = if siren then "SIREN" else `DAY {RunState.Get("Cycle") or 1}`
		phaseColor = if siren then COLORS.hazard else COLORS.cream
	elseif phase == "Surge" then
		local kind = RunState.Get("SurgeKind")
		phaseText = if kind == "Boss" or kind == "Final" then "BOSS" else "SURGE"
		phaseColor = COLORS.signal
	end
	local phaseLabel = part("Phase.Text")
	phaseLabel.Text = phaseText
	phaseLabel.TextColor3 = phaseColor
	local timeLabel = part("TimeLeft.Text")
	timeLabel.Text = if open then "--:--" else Hud.Clock(left)
	timeLabel.TextColor3 = if siren and (os.clock() % 1) < 0.5 then COLORS.hazard else COLORS.cream

	local ready = part("Ready")
	local canReady = RunState.Get("RunPhase") == "Playing" and phase == "Day" and not siren
		and (RunState.Get("ReadyNeeded") or 0) > 0
	ready.Visible = canReady
	if canReady then
		local mine = Players.LocalPlayer:GetAttribute("Ready") == true
		KitRuntime.SetSprite(part("Ready.Content.Lamp"), if mine then "Lamp_Green" else "Lamp_Off")
		part("Ready.Content.Count").Text = `{RunState.Get("ReadyCount") or 0} OF {RunState.Get("ReadyNeeded") or 0}`
	end
end

-- Banners and alerts ----------------------------------------------------------------------

local function bannerStyle(kind: AlertKind): (string, Color3)
	if kind == "Danger" then
		return "Alert_Danger", COLORS.signal
	elseif kind == "Info" then
		return "Alert_Info", COLORS.cream
	end
	return "Alert_Warning", COLORS.hazard
end

function HUDController:Banner(text: string, kind: AlertKind?, seconds: number?)
	if not gui then
		return
	end
	local sprite, color = bannerStyle(kind or "Warning")
	local banner = part("Banner")
	KitRuntime.SetSprite(part("Banner.Icon"), sprite)
	local label = part("Banner.Text")
	label.Text = string.upper(text)
	label.TextColor3 = color
	banner.Visible = true
	bannerToken += 1
	local token = bannerToken
	task.delay(seconds or 4, function()
		if token == bannerToken then
			banner.Visible = false
		end
	end)
end

function HUDController:Alert(kind: AlertKind, text: string, seconds: number?)
	if not gui then
		return
	end
	local holder = part("Alerts")
	local slips = {}
	for _, child in holder:GetChildren() do
		if child:IsA("GuiObject") then
			table.insert(slips, child)
		end
	end
	table.sort(slips, function(a, b)
		return a.LayoutOrder > b.LayoutOrder -- oldest last
	end)
	while #slips >= MAX_ALERTS do
		local oldest = table.remove(slips) :: GuiObject
		oldest:Destroy()
	end
	alertCount += 1
	local slip = clone("AlertSlip")
	slip.Name = "Alert" .. alertCount
	slip.LayoutOrder = -alertCount -- newest on top
	KitRuntime.SetSprite(slip.Icon, (bannerStyle(kind)))
	slip.Text.Text = string.upper(text)
	slip.Parent = holder
	task.delay(seconds or 8, function()
		if slip.Parent then
			slip:Destroy()
		end
	end)
end

local function onSiren()
	if RunState.Get("Siren") ~= true then
		return
	end
	local kind = RunState.Get("SurgeKind")
	local who = if kind == "Boss" or kind == "Final" then bossName() else "SURGE"
	HUDController:Banner(`SIREN  ·  {who} IN 0:20`, "Warning", 5)
end

local function onPhase()
	if RunState.Get("CyclePhase") ~= "Surge" then
		return
	end
	if RunState.Get("PhaseOpen") == true then
		HUDController:Banner(`{bossName()}  ·  THE SURGE ENDS WHEN IT FALLS`, "Danger", 6)
	else
		HUDController:Banner("SURGE  ·  HOLD THE BUNKER", "Danger", 4)
	end
end

-- Top left --------------------------------------------------------------------------------

function HUDController:SetVital(name: string, fraction: number, text: string?)
	if not gui then
		return
	end
	part(`Vitals.{name}.Needle`).Rotation = Hud.NeedleRotation(fraction)
	if text then
		local value: any = UIContract.Find(gui, `Vitals.{name}.Value`)
		if value then
			value.Text = text
		end
	end
end

local function watchHealth(character: Model)
	local h = character:WaitForChild("Humanoid", 10)
	if not h or not h:IsA("Humanoid") then
		return
	end
	local function update()
		local max = math.max(h.MaxHealth, 1)
		HUDController:SetVital("Health", h.Health / max, tostring(math.max(0, math.ceil(h.Health))))
	end
	h.HealthChanged:Connect(update)
	h:GetPropertyChangedSignal("MaxHealth"):Connect(update)
	update()
end

local function keyText(): string
	local device = input:Device()
	return if device == "Gamepad" then "LB" elseif device == "Keyboard" then "Q" else ""
end

-- Ready's own key (Landon, 2026-11-08): Z on PC, the D-pad's down on console (InputController).
local function readyKeyText(): string
	local device = input:Device()
	return if device == "Gamepad" then "DOWN" elseif device == "Keyboard" then "Z" else ""
end

function HUDController:SetClass(id: string, level: number?)
	local class = Config.Find("Classes", id)
	if not class or not gui then
		return
	end
	classId = id
	classLevel = level or 1
	part("Vitals.AbilityName").Text = string.upper(class.Ability.Name)
	part("Vitals.Class").Text = `{string.upper(class.Name)}  ·  LV {classLevel}`
	local icon = part("Vitals.Ability.Icon")
	local sprite = ABILITY_ICONS[id]
	icon.Visible = sprite ~= nil
	if sprite then
		KitRuntime.SetSprite(icon, sprite)
	end
	local touchIcon = part("Touch.Ability.Content.Icon")
	if sprite then
		KitRuntime.SetSprite(touchIcon, sprite)
	end
end

-- Top right -------------------------------------------------------------------------------

function HUDController:SetResource(id: string, text: string, lamp: string?)
	local chip = resourceChips[id]
	if not chip then
		return
	end
	chip.Value.Text = text
	chip.Lamp.Visible = lamp ~= nil
	if lamp then
		KitRuntime.SetSprite(chip.Lamp, lamp)
	end
end

local cursorFree = false -- PC: the mouse wheel freed the cursor for the HUD

-- Copper and Crystal chips stay hidden until the team digs into their bands (Config.DepthBands).
local function refreshOreChips()
	local deepest = 1 -- the run starts with floors 1 and 2 built
	for key in replica:All("Cells") do
		local floor = Grid.Parse(key)
		if floor and floor > deepest then
			deepest = floor
		end
	end
	for _, band in Config.All("DepthBands") do
		local chip = if band.Ore then resourceChips[band.Ore] else nil
		if chip then
			chip.Visible = deepest >= band.Floors.From
		end
	end
end

local function buildStockpile()
	local holder = part("Stockpile.Resources")
	for _, child in holder:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	for i, entry in STOCK do
		if Config.Find("Resources", entry.Id) and UIKit.Sprites[entry.Icon] then
			local chip = clone("ResourceChip")
			chip.Name = entry.Id
			chip.LayoutOrder = i
			KitRuntime.SetSprite(chip.Icon, entry.Icon)
			chip.Value.Text = "—"
			chip.Parent = holder
			resourceChips[entry.Id] = chip
		end
	end
	HUDController:SetResource("Power", "—", "Lamp_Off")
end

-- Hotbar ----------------------------------------------------------------------------------

function HUDController:SelectSlot(index: number)
	if not gui or index < 1 or index > 5 then
		return
	end
	selectedSlot = index
	for i = 1, 5 do
		KitRuntime.SetSprite(part(`Hotbar.Slot{i}`), if i == index then "Hotbar_Selected" else "Hotbar_Slot")
	end
	HUDController.HotbarSelected:Fire(index)
end

function HUDController:SelectedSlot(): number
	return selectedSlot
end

-- A hotbar slot's item icon (a kit sprite) and ammo text; nil empties it.
function HUDController:SetSlot(index: number, icon: string?, ammo: string?)
	if not gui then
		return
	end
	local item = part(`Hotbar.Slot{index}.Item`)
	item.Visible = icon ~= nil
	if icon then
		KitRuntime.SetSprite(item, icon)
	end
	local count = part(`Hotbar.Slot{index}.Ammo`)
	count.Visible = ammo ~= nil
	count.Text = ammo or ""
end

-- Touch -----------------------------------------------------------------------------------

local function robloxJumpButton(): GuiObject?
	local touchGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
	touchGui = touchGui and touchGui:FindFirstChild("TouchGui")
	local frame = touchGui and touchGui:FindFirstChild("TouchControlFrame")
	local jump = frame and frame:FindFirstChild("JumpButton")
	return if jump and jump:IsA("GuiObject") then jump else nil
end

local function guardRobloxJump(on: boolean)
	if jumpGuard then
		jumpGuard:Disconnect()
		jumpGuard = nil
	end
	local jump = robloxJumpButton()
	if not jump then
		return
	end
	if on then
		jump.Visible = false
		jumpGuard = jump:GetPropertyChangedSignal("Visible"):Connect(function()
			if jump.Visible then
				jump.Visible = false
			end
		end)
	end
end

local function refreshDevice()
	if not gui then
		return
	end
	local device = input:Device()
	local touch = forceTouch or device == "Touch"
	part("Touch").Visible = touch
	guardRobloxJump(touch and device == "Touch")
	local key = keyText()
	part("Vitals.Ability.Key").Visible = key ~= ""
	part("Vitals.Ability.Key.Text").Text = key
	local readyKey = readyKeyText()
	part("Ready.Key").Visible = readyKey ~= ""
	part("Ready.Key.Text").Text = readyKey
	local viewKey = part("CommandView.Content.Key")
	viewKey.Text = if device == "Gamepad" then "VIEW" elseif device == "Keyboard" then "TAB" else ""
	for i = 1, 5 do
		part(`Hotbar.Slot{i}.Key`).Visible = device == "Keyboard"
	end
end

local function setSprintToggle(on: boolean)
	sprintOn = on
	input:Press("Sprint", on, "TouchToggle")
	local button = part("Touch.Sprint")
	local up, down = button:GetAttribute("RectUp"), button:GetAttribute("RectDown")
	if on and not button:GetAttribute("RestUp") then
		button:SetAttribute("RestUp", up)
		button:SetAttribute("RectUp", down) -- stays pressed while on
	elseif not on and button:GetAttribute("RestUp") then
		button:SetAttribute("RectUp", button:GetAttribute("RestUp"))
		button:SetAttribute("RestUp", nil)
	end
	button.ImageRectOffset = button:GetAttribute("RectUp")
end

local function bindTouch()
	for name, action in TOUCH_ACTIONS do
		input:BindButton(action, part("Touch." .. name))
	end
	part("Touch.Sprint").Activated:Connect(function()
		setSprintToggle(not sprintOn)
	end)
	local jump = part("Touch.Jump")
	jump.MouseButton1Down:Connect(function()
		local h = humanoid()
		if h then
			h.Jump = true
		end
	end)
end

-- Lifecycle -------------------------------------------------------------------------------

function HUDController:SetForceTouch(on: boolean)
	forceTouch = on
	refreshDevice()
end

function HUDController:Hide(reason: string, on: boolean)
	hidden[reason] = if on then true else nil
	refreshVisible()
end

function HUDController:State(): { [string]: any }
	return {
		Present = gui ~= nil,
		Enabled = gui ~= nil and gui.Enabled,
		Year = shownYear,
		Phase = if gui then part("Phase.Text").Text else nil,
		TimeLeft = if gui then part("TimeLeft.Text").Text else nil,
		Ready = if gui then part("Ready").Visible else nil,
		Slot = selectedSlot,
		Touch = if gui then part("Touch").Visible else nil,
		Class = classId,
		Hidden = next(hidden) ~= nil,
	}
end

function HUDController:Gui(): ScreenGui?
	return gui
end

function HUDController:Init(registry)
	input = registry.InputController
	replica = registry.ReplicaController
	ui = registry.UIController
	camera = registry.CameraController
	inRun = Constants.PlaceKind() == "Run"
end

function HUDController:Start()
	if not inRun then
		return -- the Lobby's own HUD comes with the lobby (Prompt 21)
	end
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local found = playerGui:WaitForChild("HUD", 20)
	if not found or not found:IsA("ScreenGui") then
		log:Warn("no HUD ScreenGui in this place")
		return
	end
	gui = found
	KitRuntime.Watch(found)
	-- Tab opens the Command View (bible Section 7), so Roblox's player list (also on Tab) is off
	-- in the run.
	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
	end)
	buildStockpile()
	HUDController:SetClass("Survivor", 1)
	HUDController:SetVital("Stamina", 1)
	HUDController:SetVital("Radiation", 0)
	HUDController:SelectSlot(1)
	bindTouch()
	refreshDevice()
	input.DeviceChanged:Connect(refreshDevice)

	-- the stockpile (EconomyService replicates the amounts as RunState values; Power is Prompt 9's)
	for _, entry in STOCK do
		if RunState.Fields[entry.Id] then
			local function show()
				local value = RunState.Get(entry.Id)
				HUDController:SetResource(entry.Id, if type(value) == "number" then tostring(value) else "—")
			end
			RunState.Changed(entry.Id):Connect(show)
			show()
		end
	end
	-- messages from the server for the alert feed (a refused proposal, a room built...)
	Remotes.OnClient("Alert", function(kind: any, text: any)
		if type(text) == "string" then
			HUDController:Alert(if kind == "Danger" or kind == "Warning" then kind else "Info", text)
		end
	end)

	-- the clock
	RunState.Changed("Year"):Connect(showYear)
	RunState.Changed("Era"):Connect(showEra)
	RunState.Changed("Siren"):Connect(onSiren)
	RunState.Changed("CyclePhase"):Connect(onPhase)
	RunState.Changed("RunPhase"):Connect(refreshVisible)
	showYear()
	showEra()
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt: number)
		elapsed += dt
		if elapsed >= TICK_SECONDS and gui and gui.Enabled then
			elapsed = 0
			tickClock()
		end
	end)
	local function pressReady()
		if Remotes.InPlace("SetReady") and part("Ready").Visible then
			Remotes.FireServer("SetReady", Players.LocalPlayer:GetAttribute("Ready") ~= true)
		end
	end
	part("Ready").Activated:Connect(pressReady)
	input:On("Ready", pressReady)

	-- health, the ability, the hotbar, the Command View
	Players.LocalPlayer.CharacterAdded:Connect(watchHealth)
	if Players.LocalPlayer.Character then
		task.spawn(watchHealth, Players.LocalPlayer.Character)
	end
	part("Vitals.Ability").Activated:Connect(function()
		input:Press("Ability", true, "HudAbility")
		input:Press("Ability", false, "HudAbility")
	end)
	for i = 1, 5 do
		input:On(`Hotbar{i}`, function()
			HUDController:SelectSlot(i)
		end)
		part(`Hotbar.Slot{i}`).Activated:Connect(function()
			HUDController:SelectSlot(i)
		end)
	end
	input:On("HotbarNext", function()
		HUDController:SelectSlot(selectedSlot % 5 + 1)
	end)
	input:On("HotbarPrevious", function()
		HUDController:SelectSlot((selectedSlot - 2) % 5 + 1)
	end)
	input:BindButton("CommandView", part("CommandView"))
	-- PC: the camera locks the mouse; a click of the mouse wheel frees the cursor to click the
	-- HUD (and the vote telegram), and another click locks it again (Landon, 2026-11-08)
	UserInputService.InputBegan:Connect(function(io: InputObject)
		if io.UserInputType == Enum.UserInputType.MouseButton3 then
			cursorFree = not cursorFree
			camera:FreeCursor("HudCursor", cursorFree)
		end
	end)

	-- the ore chips show once the team has dug into that ore's band (Landon, 2026-11-08)
	replica:Changed("Cells"):Connect(refreshOreChips)
	refreshOreChips()

	-- menus hide the HUD (and take back a cursor the wheel freed: the menu frees its own)
	ui.Opened:Connect(function()
		HUDController:Hide("Frame", true)
		if cursorFree then
			cursorFree = false
			camera:FreeCursor("HudCursor", false)
		end
	end)
	ui.Closed:Connect(function()
		HUDController:Hide("Frame", false)
	end)
	refreshVisible()
	tickClock()
	log:Debug("HUD ready")
end

return HUDController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C2"><Properties><string name="Name">InputController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	InputController: turns PC, touch and gamepad input into the game's actions (bible Section 9,
	Controls; Section 23).

	* Device: "Keyboard" (mouse and keyboard), "Gamepad" or "Touch", from the last input used;
	  DeviceChanged fires when it changes.
	* Actions: the bible's controls table (BINDINGS). A controller listens with
	  InputController:On(action, began, ended?); the action is bound with ContextActionService
	  above Roblox's own bindings the first time someone listens. Touch buttons from the HUD
	  join with InputController:BindButton(action, button). Jump and moving stay Roblox's.
	* Look and zoom: mouse movement (while the mouse is locked), the right stick, a one-finger
	  drag on open screen and a two-finger pinch are gathered between frames; the camera takes
	  them with TakeLook(dt) (degrees) and TakeZoom() (studs, positive = farther).
	* Touches that start on a GUI or Roblox's thumbstick are the GUI's, never the camera's.
	* Block(reason, true) holds gameplay actions off while a menu is open: new presses are
	  ignored and anything held is released. Command View still passes, so its key can close
	  the docked Frame.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CameraRig = require(Shared.Rules.CameraRig)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("InputController")

export type Device = "Keyboard" | "Gamepad" | "Touch"

-- Section 9's controls table. Touch buttons come from the HUD (BindButton).
local BINDINGS: { [string]: { Enum.KeyCode | Enum.UserInputType } } = {
	Fire = { Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2 },
	Aim = { Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2 },
	Melee = { Enum.KeyCode.F, Enum.KeyCode.ButtonR1 },
	Reload = { Enum.KeyCode.R, Enum.KeyCode.ButtonX }, -- a tap of X on console
	Interact = { Enum.KeyCode.E, Enum.KeyCode.ButtonX }, -- a hold of X on console
	Ability = { Enum.KeyCode.Q, Enum.KeyCode.ButtonL1 },
	Sprint = { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3 },
	Dodge = { Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB },
	SwapShoulder = { Enum.KeyCode.V, Enum.KeyCode.ButtonR3 },
	HotbarNext = { Enum.KeyCode.DPadRight },
	HotbarPrevious = { Enum.KeyCode.DPadLeft },
	Hotbar1 = { Enum.KeyCode.One },
	Hotbar2 = { Enum.KeyCode.Two },
	Hotbar3 = { Enum.KeyCode.Three },
	Hotbar4 = { Enum.KeyCode.Four },
	Hotbar5 = { Enum.KeyCode.Five },
	Ping = { Enum.KeyCode.G, Enum.KeyCode.DPadUp },
	CommandView = { Enum.KeyCode.Tab, Enum.KeyCode.ButtonSelect },
	Ready = { Enum.KeyCode.Z, Enum.KeyCode.DPadDown }, -- Landon, 2026-11-08: Ready gets its own key
}
local PRIORITY = Enum.ContextActionPriority.High.Value + 10
local NEVER_BLOCKED: { [string]: boolean } = { CommandView = true }
-- Keys the engine marks as processed before ContextActionService sees them begin (Tab: Roblox
-- keeps it for its player list and UI navigation; the gamepad's View button: Roblox's own UI
-- selection, which Init turns off). These are read from UserInputService too, unless a text box
-- has focus or Roblox's menu is open.
local PROCESSED_KEYS: { [Enum.KeyCode]: string } =
	{ [Enum.KeyCode.Tab] = "CommandView", [Enum.KeyCode.ButtonSelect] = "CommandView" }

type Listener = { Began: (() -> ())?, Ended: (() -> ())? }

local InputController = {
	Name = "InputController",
	Dependencies = {},
	DeviceChanged = Signal.new(),
}

local device: Device = "Keyboard"
local listeners: { [string]: { Listener } } = {}
local held: { [string]: { [any]: boolean } } = {}
local bound: { [string]: boolean } = {}
local blocked: { [string]: boolean } = {}

local mouseLook = Vector2.zero -- pixels since the last TakeLook
local touchLook = Vector2.zero
local stick = Vector2.zero -- the right stick, -1 to 1
local zoom = 0 -- studs since the last TakeZoom
local touches: { [InputObject]: Vector2 } = {} -- camera touches and where they were last
local pinchGap: number? = nil

-- The player's own Roblox camera sensitivity (Settings menu), read each frame.
local gameSettings: any = nil
local function robloxSensitivity(key: string): number
	if not gameSettings then
		return 1
	end
	local ok, value = pcall(function()
		return gameSettings[key]
	end)
	return if ok and type(value) == "number" and value > 0 then value else 1
end

local function deviceOf(inputType: Enum.UserInputType): Device?
	if inputType == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.find(inputType.Name, "^Gamepad") then
		return "Gamepad"
	elseif inputType == Enum.UserInputType.Keyboard or string.find(inputType.Name, "^Mouse") then
		return "Keyboard"
	end
	return nil
end

local function setDevice(inputType: Enum.UserInputType)
	local found = deviceOf(inputType)
	if found and found ~= device then
		device = found
		InputController.DeviceChanged:Fire(device)
	end
end

-- An action's state from one source (a key, a button); began on the first, ended on the last.
local function press(action: string, source: any, down: boolean)
	local sources = held[action]
	if not sources then
		sources = {}
		held[action] = sources
	end
	local wasDown = next(sources) ~= nil
	if down and not wasDown and next(blocked) ~= nil and not NEVER_BLOCKED[action] then
		return
	end
	sources[source] = if down then true else nil
	local isDown = next(sources) ~= nil
	if isDown == wasDown then
		return
	end
	for _, listener in listeners[action] or {} do
		local handler = if isDown then listener.Began else listener.Ended
		if handler then
			task.spawn(handler)
		end
	end
end

local function bind(action: string)
	local inputs = BINDINGS[action]
	if bound[action] or not inputs then
		return
	end
	bound[action] = true
	ContextActionService:BindActionAtPriority(
		"100Y_" .. action,
		function(_name: string, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
			if state == Enum.UserInputState.Begin then
				press(action, input.KeyCode.Name .. input.UserInputType.Name, true)
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				press(action, input.KeyCode.Name .. input.UserInputType.Name, false)
			end
			return Enum.ContextActionResult.Pass
		end,
		false,
		PRIORITY,
		table.unpack(inputs)
	)
end

-- Listens to an action. Returns a function that stops listening.
function InputController:On(action: string, began: (() -> ())?, ended: (() -> ())?): () -> ()
	assert(BINDINGS[action], `InputController: unknown action {action}`)
	local list = listeners[action]
	if not list then
		list = {}
		listeners[action] = list
	end
	local listener: Listener = { Began = began, Ended = ended }
	table.insert(list, listener)
	bind(action)
	return function()
		local index = table.find(list, listener)
		if index then
			table.remove(list, index)
		end
	end
end

-- Is the action held right now (by any key, button or touch button)?
function InputController:IsDown(action: string): boolean
	local sources = held[action]
	return sources ~= nil and next(sources) ~= nil
end

-- A HUD touch button drives an action while it is pressed. Returns a cleanup function.
function InputController:BindButton(action: string, button: GuiButton): () -> ()
	assert(BINDINGS[action], `InputController: unknown action {action}`)
	local down = button.MouseButton1Down:Connect(function()
		press(action, button, true)
	end)
	local up = button.MouseButton1Up:Connect(function()
		press(action, button, false)
	end)
	local left = button.MouseLeave:Connect(function()
		press(action, button, false)
	end)
	return function()
		down:Disconnect()
		up:Disconnect()
		left:Disconnect()
		press(action, button, false)
	end
end

-- Presses or releases an action from code (DevTools, tests, a toggle on touch).
function InputController:Press(action: string, down: boolean, source: string?)
	assert(BINDINGS[action], `InputController: unknown action {action}`)
	press(action, source or "code", down)
end

function InputController:Device(): Device
	return device
end

-- Holds gameplay actions off while a menu is open (reason: the menu's name).
function InputController:Block(reason: string, on: boolean)
	blocked[reason] = if on then true else nil
	if on then
		for action, sources in held do
			if not NEVER_BLOCKED[action] then
				for source in sources do
					press(action, source, false)
				end
			end
		end
	end
end

function InputController:IsBlocked(): boolean
	return next(blocked) ~= nil
end

-- Look input since the last call, in degrees (X turns, Y tilts; positive = right and down).
function InputController:TakeLook(dt: number): Vector2
	local t = CameraRig.Tuning()
	local degrees = mouseLook * t.MouseDegreesPerPixel * robloxSensitivity("MouseSensitivity")
		+ touchLook * t.TouchDegreesPerPixel * robloxSensitivity("MouseSensitivity")
		+ CameraRig.Stick(stick, t.StickDeadzone) * Vector2.new(1, -1) * t.GamepadDegreesPerSecond * dt
			* robloxSensitivity("GamepadCameraSensitivity")
	mouseLook = Vector2.zero
	touchLook = Vector2.zero
	return degrees
end

-- Zoom input since the last call, in studs (positive = farther).
function InputController:TakeZoom(): number
	local value = zoom
	zoom = 0
	return value
end

function InputController:Init()
	local ok, settings = pcall(function()
		return UserSettings():GetService("UserGameSettings")
	end)
	gameSettings = if ok then settings else nil
	device = deviceOf(UserInputService:GetLastInputType())
		or (if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "Touch" else "Keyboard")
	-- The View button opens the Command View (bible Section 7); with this on, Roblox takes that
	-- button for its own UI selection. Our screens select for the gamepad themselves (UIController).
	GuiService.AutoSelectGuiEnabled = false
end

function InputController:Start()
	UserInputService.LastInputTypeChanged:Connect(setDevice)
	UserInputService.InputBegan:Connect(function(io: InputObject, processed: boolean)
		local action = PROCESSED_KEYS[io.KeyCode]
		if action and processed and bound[action] and not UserInputService:GetFocusedTextBox() and not GuiService.MenuIsOpen then
			press(action, "Processed" .. io.KeyCode.Name, true)
		end
	end)
	UserInputService.InputEnded:Connect(function(io: InputObject)
		local action = PROCESSED_KEYS[io.KeyCode]
		if action then
			press(action, "Processed" .. io.KeyCode.Name, false)
		end
	end)

	UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
				mouseLook += Vector2.new(input.Delta.X, input.Delta.Y)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseWheel then
			if not processed then
				zoom -= input.Position.Z * CameraRig.Tuning().ZoomStep
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.zero
		end
	end)

	-- Touch: a drag on open screen looks around; two fingers pinch to zoom.
	UserInputService.TouchStarted:Connect(function(touch: InputObject, processed: boolean)
		if not processed then
			touches[touch] = Vector2.new(touch.Position.X, touch.Position.Y)
			pinchGap = nil
		end
	end)
	UserInputService.TouchMoved:Connect(function(touch: InputObject)
		local last = touches[touch]
		if not last then
			return
		end
		local now = Vector2.new(touch.Position.X, touch.Position.Y)
		touches[touch] = now
		local live = {}
		for other, at in touches do
			table.insert(live, at)
		end
		if #live >= 2 then
			local gap = (live[1] - live[2]).Magnitude
			if pinchGap then
				zoom -= (gap - pinchGap) * CameraRig.Tuning().PinchStudsPerPixel
			end
			pinchGap = gap
		else
			touchLook += now - last
		end
	end)
	UserInputService.TouchEnded:Connect(function(touch: InputObject)
		touches[touch] = nil
		pinchGap = nil
	end)
	log:Debug("input ready (%s)", device)
end

return InputController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C3"><Properties><string name="Name">MiniMapController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MiniMapController: the side-view mini-map on the HUD (bible Section 18: "a side-view
	mini-map of the bunker with alerts blinking").

	It draws a window of the bunker around the player (Rules.Hud.MapWindow: 5 columns, 5 floors)
	from the replicated Cells and Rooms collections: each room as one block across its cells with
	its short name, a dug cell as a faint block, rock as bare blueprint paper. The player's cell
	lights an orange pilot lamp. The footer names the deepest band and floor reached.
	Pinged cells (PingService, from the Command View) show a yellow pin for Tuning.Ping.Seconds.
	Blink(roomId, on) is for the alerts (AlertController, Prompt 12).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Grid = require(Shared.Rules.Grid)
local Hud = require(Shared.Rules.Hud)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)

local log = Log.new("MiniMapController")

local COLUMNS = 5
local ROWS = 5
local INSET = 0.05 -- of a cell, on each side
local POLL_SECONDS = 0.25
local NAVY = Color3.fromHex("#1B2A3A")
local RUST = Color3.fromHex("#B5412B")

local MiniMapController = {
	Name = "MiniMapController",
	Dependencies = { "ReplicaController", "HUDController" },
}

local replica: any = nil
local hud: any = nil
local cellsFrame: Frame? = nil
local you: ImageLabel? = nil
local depthLabel: TextLabel? = nil
local template: Frame? = nil
local playerCell: { number }? = nil
local dirty = true
local blinking: { [string]: boolean } = {}
local blocks: { [string]: Frame } = {}
local window = { 0, 1 } -- the first column and first floor shown
local pingTemplate: Instance? = nil
local pingMarks: { { Frame: any, Floor: number, Column: number, Until: number } } = {}

local function placePings()
	local now = os.clock()
	for i = #pingMarks, 1, -1 do
		local ping = pingMarks[i]
		if now > ping.Until then
			ping.Frame:Destroy()
			table.remove(pingMarks, i)
		else
			local x = (ping.Column - window[1] + 0.5) / COLUMNS
			local y = (ping.Floor - window[2] + 0.75) / ROWS
			ping.Frame.Position = UDim2.fromScale(x, y)
			ping.Frame.Visible = x > 0 and x < 1 and y > 0 and y <= 1
		end
	end
end

local function shortName(roomType: string): string
	local room = Config.Find("Rooms", roomType)
	local name = if room then room.Name else roomType
	return string.upper(string.match(name, "^(%S+)") or name)
end

local function block(key: string, floor: number, column: number, span: number, first: { number }, label: string, dug: boolean)
	local frame = (template :: Frame):Clone()
	frame.Name = key
	frame.Visible = true
	local c0, f0 = first[1], first[2]
	local from = math.max(column, c0)
	local to = math.min(column + span - 1, c0 + COLUMNS - 1)
	frame.Position = UDim2.fromScale((from - c0 + INSET) / COLUMNS, (floor - f0 + INSET) / ROWS)
	frame.Size = UDim2.fromScale((to - from + 1 - 2 * INSET) / COLUMNS, (1 - 2 * INSET) / ROWS)
	frame.BackgroundTransparency = if dug then 0.85 else 0.55
	frame.BackgroundColor3 = if blinking[key] then RUST else NAVY
	local text = frame:FindFirstChild("Label") :: TextLabel?
	if text then
		text.Text = label
		text.Visible = label ~= "" and (to - from + 1) >= 1
	end
	frame.Parent = cellsFrame
	blocks[key] = frame
end

local function redraw()
	dirty = false
	local holder = cellsFrame
	if not holder or not template then
		return
	end
	for _, child in holder:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	table.clear(blocks)
	local grid = Grid.Tuning()
	local here = playerCell or { 1, 0 }
	local c0, f0 = Hud.MapWindow(here[1], here[2], grid, COLUMNS, ROWS)
	local first = { c0, f0 }
	window = first
	local seenRooms: { [string]: boolean } = {}
	local deepest = 0
	for key, cell in replica:All("Cells") do
		local floor, column = Grid.Parse(key)
		if floor and column then
			deepest = math.max(deepest, floor)
			if floor >= f0 and floor < f0 + ROWS and column >= c0 and column < c0 + COLUMNS then
				local roomId = if type(cell) == "table" then cell.Room else nil
				if roomId then
					if not seenRooms[roomId] then
						seenRooms[roomId] = true
						local room = replica:Get("Rooms", roomId)
						if room then
							block(roomId, room.Floor, room.Column, room.Span or 1, first, shortName(room.Type), false)
						end
					end
				else
					block(key, floor, column, 1, first, "", true)
				end
			end
		end
	end
	if you then
		you.Visible = playerCell ~= nil
		if playerCell then
			you.Position = UDim2.fromScale((playerCell[2] - c0 + 0.5) / COLUMNS, (playerCell[1] - f0 + 0.5) / ROWS)
		end
	end
	if depthLabel then
		if deepest > 0 then
			local band = Grid.BandOf(deepest)
			depthLabel.Text = `{string.upper(band.Name)}  ·  DEPTH {deepest}`
		else
			depthLabel.Text = ""
		end
	end
end

local function poll()
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local floor, column = nil, nil
	if root and root:IsA("BasePart") then
		floor, column = Grid.CellAt(root.Position)
	end
	local cell = if floor and column then { floor, column } else nil
	local changed = (cell == nil) ~= (playerCell == nil)
		or (cell ~= nil and playerCell ~= nil and (cell[1] ~= playerCell[1] or cell[2] ~= playerCell[2]))
	if changed then
		playerCell = cell
		dirty = true
	end
	if dirty then
		redraw()
	end
	placePings()
end

-- Shows a pin on a cell for Tuning.Ping.Seconds (PingService's CellPinged).
function MiniMapController:Ping(floor: number, column: number)
	if not cellsFrame or not pingTemplate then
		return
	end
	local mark = pingTemplate:Clone() :: any
	mark.Visible = true
	mark.Parent = cellsFrame.Parent
	table.insert(pingMarks, { Frame = mark, Floor = floor, Column = column, Until = os.clock() + Config.Get("Tuning", "Ping").Seconds })
	placePings()
end

-- Lights a room's block (or a dug cell's, by "floor,column") rust red while on.
function MiniMapController:Blink(key: string, on: boolean)
	blinking[key] = if on then true else nil
	local frame = blocks[key]
	if frame then
		frame.BackgroundColor3 = if on then RUST else NAVY
	end
end

function MiniMapController:Init(registry)
	replica = registry.ReplicaController
	hud = registry.HUDController
end

function MiniMapController:Start()
	if Constants.PlaceKind() ~= "Run" then
		return
	end
	local gui = hud:Gui()
	local waited = 0
	while not gui and waited < 20 do -- HUDController finds the HUD in its own Start
		waited += task.wait(0.25)
		gui = hud:Gui()
	end
	if not gui then
		return
	end
	local paper = gui:FindFirstChild("MiniMap") and gui.MiniMap:FindFirstChild("Paper")
	cellsFrame = paper and paper:FindFirstChild("Cells")
	you = paper and paper:FindFirstChild("You")
	depthLabel = gui.MiniMap:FindFirstChild("Depth")
	template = gui:FindFirstChild("Templates") and gui.Templates:FindFirstChild("MapCell")
	if not cellsFrame or not template then
		log:Warn("the HUD has no mini-map")
		return
	end
	pingTemplate = gui.Templates:FindFirstChild("MapPing")
	if Remotes.InPlace("CellPinged") then
		Remotes.OnClient("CellPinged", function(floor: any, column: any)
			if type(floor) == "number" and type(column) == "number" then
				MiniMapController:Ping(floor, column)
			end
		end)
	end
	local function mark()
		dirty = true
	end
	replica:Changed("Cells"):Connect(mark)
	replica:Changed("Rooms"):Connect(mark)
	task.spawn(function()
		while true do
			poll()
			task.wait(POLL_SECONDS)
		end
	end)
	log:Debug("mini-map ready")
end

return MiniMapController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C4"><Properties><string name="Name">ReplicaController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ReplicaController: the client end of the delta channel. It mirrors the server's
	collections (ReplicationService) and tells controllers what changed.

		local Rooms = registry.ReplicaController
		Rooms:Changed("Rooms"):Connect(function(key, value, old) ... end)  -- value nil = removed
		local room = Rooms:Get("Rooms", "R12")                              -- frozen; never edit
		Rooms:Ready():Wait()                                                -- first snapshot in

	A snapshot replaces the whole mirror: keys that disappeared fire a removal.
	A collection cleared on the server fires one change with key nil.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Delta = require(Shared.Utilities.Delta)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("ReplicaController")

export type ChangedSignal = Signal.Signal<string?, any, any>

local ReplicaController = {
	Name = "ReplicaController",
	Dependencies = {},
}

local store: Delta.Store = {}
local changedSignals: { [string]: ChangedSignal } = {}
local readySignal = Signal.new() :: Signal.Signal<()>
local isReady = false
local counters = { Events = 0, Ops = 0, Snapshots = 0 }

local function onDelta(ops: any, snapshot: any)
	if type(ops) ~= "table" then
		return
	end
	counters.Events += 1
	counters.Ops += #ops
	local changes: { Delta.Change }
	if snapshot == true then
		counters.Snapshots += 1
		local previous = store
		store = {}
		changes = Delta.Apply(store, ops)
		for _, change in changes do
			local before = previous[change.Collection]
			change.Old = if before and change.Key then before[change.Key] else nil
		end
		for collectionName, values in previous do
			local now = store[collectionName]
			for key, value in values do
				if not now or now[key] == nil then
					table.insert(changes, { Collection = collectionName, Key = key, Value = nil, Old = value })
				end
			end
		end
	else
		changes = Delta.Apply(store, ops)
	end
	for _, change in changes do
		local signal = changedSignals[change.Collection]
		if signal then
			signal:Fire(change.Key, change.Value, change.Old)
		end
	end
	if snapshot == true and not isReady then
		isReady = true
		log:Debug("snapshot: %d values", #ops)
		readySignal:Fire()
	end
end

function ReplicaController:Init(_registry)
	Remotes.OnClient("Delta", onDelta)
end

function ReplicaController:Get(collection: string, key: string): any
	local values = store[collection]
	return if values then values[key] else nil
end

-- A shallow copy of a collection (the values are frozen).
function ReplicaController:All(collection: string): { [string]: any }
	local values = store[collection]
	return if values then table.clone(values) else {}
end

function ReplicaController:Changed(collection: string): ChangedSignal
	local signal = changedSignals[collection]
	if not signal then
		signal = Signal.new() :: ChangedSignal
		changedSignals[collection] = signal
	end
	return signal :: ChangedSignal
end

function ReplicaController:IsReady(): boolean
	return isReady
end

-- Fires once, after the first snapshot. Check IsReady first: it won't fire again.
function ReplicaController:Ready(): Signal.Signal<()>
	return readySignal
end

function ReplicaController:Stats(): { Events: number, Ops: number, Snapshots: number }
	return table.clone(counters)
end

return ReplicaController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C5"><Properties><string name="Name">UIController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	UIController: The Frame (bible Section 18), the one layout every menu screen uses.

	The layout is StarterGui.Frame, built in Studio (studio/ui/Frame.lua) and given the
	AutoScale Lite pass; this controller only shows pages, clones templates and sets text and
	images. A screen registers once and opens by name:

		UIController:Register("Residents", {
			Title = "RESIDENTS",
			Subtitle = "STEADFAST SHELTER CO.  ·  PERSONNEL FILE",
			Tabs = { { Id = "All", Label = "ALL", Icon = "Icon_Grid" }, ... },  -- zone B, up to 7
			Layout = "Grid",       -- zone C: "Grid" (cards, always 1:1.25) or "List" (rows)
			Page = nil,            -- a page built for this screen under Cabinet.Pages; default: a clone of Templates.Page
			Docked = false,        -- the Command View: zone C shows the live bunker
			Hint = "...",          -- zone E
			OnOpen = function(page, args) end,
			OnTab = function(tabId, page) end,
			OnClose = function() end,
		})
		UIController:Open("Residents", args)

	Zone A shows the title and SetChips; zone D's main action is SetMainAction (the same place
	on every screen); zone E is SetHint and SetFooterActions. Code fills zones B to D with
	Clone("Card"), Clone("Row"), Clone("Section") and the Fill helpers.

	While a screen is open the mouse cursor is free, gameplay input is held off, and the HUD
	hides (HUDController listens to Opened and Closed). Keys: Backspace or the gamepad's B
	closes; Enter or Y presses the main action; L1 and R1 switch tabs.
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local UIContract = require(Shared.UIContract)
local Lib = script.Parent.Parent:WaitForChild("Lib")
local KitRuntime = require(Lib:WaitForChild("KitRuntime"))

local log = Log.new("UIController")

export type Tab = { Id: string, Label: string, Icon: string? }
export type Screen = {
	Title: string,
	Subtitle: string?,
	Tabs: { Tab }?,
	Layout: string?,
	Page: string?,
	Docked: boolean?,
	Hint: string?,
	GamepadSelect: boolean?, -- false: no gamepad selection (the screen uses A itself)
	OnOpen: ((page: Frame, args: any) -> ())?,
	OnTab: ((tabId: string, page: Frame) -> ())?,
	OnClose: (() -> ())?,
}
export type MainAction = { Label: string, Price: string?, Icon: string?, Enabled: boolean?, OnPress: (() -> ())? }
export type Chip = { Icon: string, Text: string }
export type FooterAction = { Label: string, OnPress: () -> () }

local CLOSE_ACTION = "100Y_UIClose"
local MAIN_ACTION = "100Y_UIMain"
local TAB_ACTION = "100Y_UITab"
local PRIORITY = Enum.ContextActionPriority.High.Value + 20
local RARITIES = { Common = true, Rare = true, Epic = true, Legendary = true }

local UIController = {
	Name = "UIController",
	Dependencies = { "InputController", "CameraController" },
	Opened = Signal.new() :: Signal.Signal<string>,
	Closed = Signal.new() :: Signal.Signal<string>,
	TabChanged = Signal.new() :: Signal.Signal<string>,
}

local input: any = nil
local camera: any = nil
local gui: ScreenGui? = nil
local screens: { [string]: Screen } = {}
local pages: { [string]: Frame } = {}
local current: string? = nil
local currentTab: string? = nil
local mainPress: (() -> ())? = nil
local tabButtons: { [string]: ImageButton } = {}
local footerConnections: { RBXScriptConnection } = {}
local tabConnections: { RBXScriptConnection } = {}

local function part(path: string): any
	assert(gui, "UIController: StarterGui.Frame is missing")
	local found = UIContract.Find(gui, path)
	assert(found, `UIController: Frame.{path} is missing (see Shared.UIContract)`)
	return found
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function disconnectAll(list: { RBXScriptConnection })
	for _, connection in list do
		connection:Disconnect()
	end
	table.clear(list)
end

local function keysText(screen: Screen): string
	local device = input:Device()
	local action = if mainPress then string.upper(part("Cabinet.MainAction.Content.Label").Text) else nil
	if device == "Gamepad" then
		local tabs = if screen.Tabs and #screen.Tabs > 1 then "     LB  RB  TABS" else ""
		return "B  CLOSE" .. (if action then `     Y  {action}` else "") .. tabs
	elseif device == "Keyboard" then
		return "BACKSPACE  CLOSE" .. (if action then `     ENTER  {action}` else "")
	end
	return ""
end

local function refreshKeys()
	if current then
		part("Cabinet.Footer.Keys").Text = keysText(screens[current])
	end
end

local function selectTab(id: string)
	if not current then
		return
	end
	local screen = screens[current]
	for tabId, button in tabButtons do
		local on = tabId == id
		KitRuntime.SetSprite(button, if on then "Tab_On" else "Tab_Off")
		local content = button:FindFirstChild("Content")
		if content then
			local icon = content:FindFirstChild("Icon") :: ImageLabel?
			local label = content:FindFirstChild("Label") :: TextLabel?
			local color = if on then Color3.fromHex("#F2E6C9") else Color3.fromHex("#1B2A3A")
			if icon then
				icon.ImageColor3 = color
			end
			if label then
				label.TextColor3 = color
			end
		end
	end
	currentTab = id
	UIController.TabChanged:Fire(id)
	local page = pages[current]
	if screen.OnTab and page then
		task.spawn(screen.OnTab, id, page)
	end
end

local function stepTab(step: number)
	local screen = if current then screens[current] else nil
	if not screen or not screen.Tabs or #screen.Tabs < 2 then
		return
	end
	local index = 1
	for i, tab in screen.Tabs do
		if tab.Id == currentTab then
			index = i
		end
	end
	index = (index - 1 + step) % #screen.Tabs + 1
	selectTab(screen.Tabs[index].Id)
end

local function pageFor(name: string, screen: Screen): Frame
	local existing = pages[name]
	if existing and existing.Parent then
		return existing
	end
	local holder = part("Cabinet.Pages")
	local built = holder:FindFirstChild(screen.Page or name)
	local page: Frame
	if built and built:IsA("Frame") then
		page = built
	else
		page = UIController:Clone("Page") :: any
		page.Name = name
		page.Parent = holder
	end
	page.Visible = false
	pages[name] = page
	return page
end

local function bindKeys(on: boolean)
	if not on then
		ContextActionService:UnbindAction(CLOSE_ACTION)
		ContextActionService:UnbindAction(MAIN_ACTION)
		ContextActionService:UnbindAction(TAB_ACTION)
		return
	end
	ContextActionService:BindActionAtPriority(CLOSE_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then
			UIController:Close()
		end
		return Enum.ContextActionResult.Sink
	end, false, PRIORITY, Enum.KeyCode.Backspace, Enum.KeyCode.ButtonB)
	ContextActionService:BindActionAtPriority(MAIN_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then
			UIController:PressMainAction()
		end
		return Enum.ContextActionResult.Sink
	end, false, PRIORITY, Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter, Enum.KeyCode.ButtonY)
	ContextActionService:BindActionAtPriority(TAB_ACTION, function(_, state, inputObject)
		if state == Enum.UserInputState.Begin then
			stepTab(if inputObject.KeyCode == Enum.KeyCode.ButtonL1 then -1 else 1)
		end
		return Enum.ContextActionResult.Sink
	end, false, PRIORITY, Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1)
end

-- API -----------------------------------------------------------------------------------------

function UIController:Register(name: string, screen: Screen)
	assert(not screens[name], `UIController: {name} is registered twice`)
	assert(screen.Title, `UIController: {name} has no title`)
	assert(not screen.Tabs or #screen.Tabs <= 7, `UIController: {name} has more than 7 tabs`)
	screens[name] = screen
end

function UIController:IsRegistered(name: string): boolean
	return screens[name] ~= nil
end

function UIController:Open(name: string, args: any?): boolean
	local screen = screens[name]
	if not screen or not gui then
		log:Warn("can't open %s: %s", name, if gui then "not registered" else "no Frame")
		return false
	end
	if current == name then
		return true
	end
	if current then
		UIController:Close()
	end
	local page = pageFor(name, screen)
	current = name
	gui.Enabled = true
	local docked = screen.Docked == true
	part("Dim").Visible = not docked
	part("Cabinet.Backplate").Visible = not docked
	part("Cabinet.DockPlates").Visible = docked
	part("Cabinet.TopBar.Title.Text").Text = string.upper(screen.Title)
	part("Cabinet.TopBar.Subtitle").Text = screen.Subtitle or "STEADFAST SHELTER CO."
	UIController:SetChips({})
	UIController:SetHint(screen.Hint or "")
	UIController:SetFooterActions({})
	UIController:SetMainAction(nil)
	local content = page:FindFirstChild("Content")
	if content then
		local layout = screen.Layout or "Grid"
		local grid = content:FindFirstChild("Grid")
		local rows = content:FindFirstChild("List")
		if grid and grid:IsA("GuiObject") then
			grid.Visible = layout == "Grid"
		end
		if rows and rows:IsA("GuiObject") then
			rows.Visible = layout == "List"
		end
	end
	-- zone B
	disconnectAll(tabConnections)
	table.clear(tabButtons)
	local rail = page:FindFirstChild("Tabs")
	if rail then
		clear(rail)
		for i, tab in screen.Tabs or {} do
			local button = UIController:Clone("Tab") :: ImageButton
			button.Name = tab.Id
			button.LayoutOrder = i
			local tabContent = button:FindFirstChild("Content") :: Frame
			local label = tabContent:FindFirstChild("Label") :: TextLabel
			local icon = tabContent:FindFirstChild("Icon") :: ImageLabel
			label.Text = string.upper(tab.Label)
			if tab.Icon then
				KitRuntime.SetSprite(icon, tab.Icon)
			else
				icon.Visible = false
			end
			button.Parent = rail
			tabButtons[tab.Id] = button
			table.insert(tabConnections, button.Activated:Connect(function()
				selectTab(tab.Id)
			end))
		end
	end
	page.Visible = true
	input:Block("Frame", true)
	camera:FreeCursor("Frame", true)
	camera:SetAiming(false)
	bindKeys(true)
	if screen.OnOpen then
		local ok, err = pcall(screen.OnOpen, page, args)
		if not ok then
			log:Warn("%s OnOpen failed: %s", name, tostring(err))
		end
	end
	if screen.Tabs and #screen.Tabs > 0 then
		selectTab(screen.Tabs[1].Id)
	end
	refreshKeys()
	if input:Device() == "Gamepad" and screen.GamepadSelect ~= false then
		GuiService.SelectedObject = (if screen.Tabs and #screen.Tabs > 0 then tabButtons[screen.Tabs[1].Id] else nil)
			or part("Cabinet.TopBar.Close")
	end
	log:Debug("opened %s", name)
	UIController.Opened:Fire(name)
	return true
end

function UIController:Close()
	local name = current
	if not name or not gui then
		return
	end
	local screen = screens[name]
	local page = pages[name]
	if page then
		page.Visible = false
	end
	current = nil
	currentTab = nil
	mainPress = nil
	disconnectAll(tabConnections)
	disconnectAll(footerConnections)
	gui.Enabled = false
	bindKeys(false)
	input:Block("Frame", false)
	camera:FreeCursor("Frame", false)
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then
		GuiService.SelectedObject = nil
	end
	if screen and screen.OnClose then
		task.spawn(screen.OnClose)
	end
	log:Debug("closed %s", name)
	UIController.Closed:Fire(name)
end

function UIController:IsOpen(): boolean
	return current ~= nil
end

function UIController:Current(): string?
	return current
end

function UIController:CurrentTab(): string?
	return currentTab
end

function UIController:Page(): Frame?
	return if current then pages[current] else nil
end

function UIController:SelectTab(id: string)
	if tabButtons[id] then
		selectTab(id)
	end
end

-- Zone D's main action (nil hides it). Enabled = false greys it out.
function UIController:SetMainAction(action: MainAction?)
	local button = part("Cabinet.MainAction") :: ImageButton
	if not action then
		button.Visible = false
		mainPress = nil
		refreshKeys()
		return
	end
	button.Visible = true
	part("Cabinet.MainAction.Content.Label").Text = string.upper(action.Label)
	local icon = part("Cabinet.MainAction.Content.Icon") :: ImageLabel
	local price = part("Cabinet.MainAction.Content.Price") :: TextLabel
	icon.Visible = action.Icon ~= nil
	if action.Icon then
		KitRuntime.SetSprite(icon, action.Icon)
	end
	price.Text = action.Price or ""
	price.Visible = action.Price ~= nil
	KitRuntime.SetEnabled(button, action.Enabled ~= false)
	mainPress = if action.Enabled ~= false then action.OnPress else nil
	refreshKeys()
end

function UIController:PressMainAction()
	local press = mainPress
	if press and current then
		task.spawn(press)
	end
end

-- Zone A's chips (currencies or resources), right to left as listed.
function UIController:SetChips(chips: { Chip })
	local holder = part("Cabinet.TopBar.Chips")
	clear(holder)
	for i, chip in chips do
		local item = UIController:Clone("Chip")
		item.LayoutOrder = i
		KitRuntime.SetSprite(item:FindFirstChild("Icon") :: ImageLabel, chip.Icon)
		local amount = item:FindFirstChild("Amount") :: TextLabel
		amount.Text = chip.Text
		item.Parent = holder
	end
end

function UIController:SetHint(text: string)
	part("Cabinet.Footer.Hint").Text = text
end

-- Zone E's secondary actions (filters, sort, back).
function UIController:SetFooterActions(actions: { FooterAction })
	disconnectAll(footerConnections)
	local holder = part("Cabinet.Footer.Actions")
	clear(holder)
	for i, action in actions do
		local button = UIController:Clone("FooterButton") :: ImageButton
		button.LayoutOrder = i
		local label = (button:FindFirstChild("Content") :: Frame):FindFirstChild("Label") :: TextLabel
		label.Text = string.upper(action.Label)
		table.insert(footerConnections, button.Activated:Connect(function()
			task.spawn(action.OnPress)
		end))
		button.Parent = holder
	end
end

-- A visible copy of one of Frame.Templates (Page, Tab, Chip, Card, Row, Section, FooterButton).
function UIController:Clone(template: string): GuiObject
	local source = part("Templates." .. template)
	local copy = source:Clone() :: GuiObject
	copy.Visible = true
	return copy
end

function UIController:SetSprite(image: ImageLabel | ImageButton, name: string)
	KitRuntime.SetSprite(image, name)
end

-- A card, or a page's detail panel, in a rarity's colours (Common, Rare, Epic, Legendary).
function UIController:SetRarity(item: Instance, rarity: string)
	assert(RARITIES[rarity], `UIController: unknown rarity {rarity}`)
	local sprite = "Card_" .. rarity
	if item:IsA("ImageButton") or item:IsA("ImageLabel") then
		if item:GetAttribute("Sprite") and string.find(item:GetAttribute("Sprite") :: string, "^Card_") then
			KitRuntime.SetSprite(item, sprite)
		end
	end
	for _, name in { "Tag", "Hero" } do
		local child = item:FindFirstChild(name)
		if child and (child:IsA("ImageLabel") or child:IsA("ImageButton")) then
			KitRuntime.SetSprite(child, sprite)
		end
	end
end

-- Empties a container (zone B, C or D's Body) and returns it, for filling with clones.
function UIController:Clear(container: Instance): Instance
	clear(container)
	return container
end

function UIController:Gui(): ScreenGui?
	return gui
end

-- Lifecycle -----------------------------------------------------------------------------------

function UIController:Init(registry)
	input = registry.InputController
	camera = registry.CameraController
end

function UIController:Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local found = playerGui:WaitForChild("Frame", 20)
	if not found or not found:IsA("ScreenGui") then
		log:Warn("no Frame ScreenGui in this place; menu screens can't open")
		return
	end
	gui = found
	found.Enabled = false
	KitRuntime.Watch(found)
	local close = part("Cabinet.TopBar.Close") :: ImageButton
	close.Activated:Connect(function()
		UIController:Close()
	end)
	local main = part("Cabinet.MainAction") :: ImageButton
	main.Activated:Connect(function()
		UIController:PressMainAction()
	end)
	input.DeviceChanged:Connect(function(device: string)
		refreshKeys()
		-- a gamepad selection would swallow Enter on a keyboard (it clicks the selected button)
		local selected = GuiService.SelectedObject
		if device ~= "Gamepad" and selected and selected:IsDescendantOf(found) then
			GuiService.SelectedObject = nil
		elseif device == "Gamepad" and current and not selected and screens[current].GamepadSelect ~= false then
			local first = next(tabButtons)
			GuiService.SelectedObject = if first then tabButtons[first] else part("Cabinet.TopBar.Close")
		end
	end)
	log:Debug("the Frame is ready")
end

return UIController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C6"><Properties><string name="Name">VoteController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	VoteController: what a vote looks like (bible Section 8): "a slim banner under the year clock
	shows who proposed what, the cost, the tally and a timer, with large yes and no buttons. It
	never blocks the screen. The proposed room appears as a ghost outline in the Command View. One
	chime plays when a vote opens, another when it passes." Run place only.

	* The telegram (StarterGui.Votes.VoteBanner, above The Frame, so a vote can be answered from
	  the Command View or any other screen) shows the live vote from the Votes collection
	  (VoteService):
	  * "LANDON PROPOSES: KITCHEN  ·  120 SCRAP";
	  * "YES 2  ·  NO 1  ·  12 S  ·  MORE YES THAN NO  ·  1 WAITING";
	  * the timer strip running down;
	  * YES and NO. Your vote stays pressed in, and you can change it until the vote closes.
	  When a vote closes the telegram shows PASSED or FAILED and why, then the next vote.
	* On PC the mouse belongs to the camera: hold Left Alt to click the buttons (the HUD's rule).
	* Ghost outlines in the Command View for open proposals ("KITCHEN?") and for construction
	  sites ("KITCHEN 45%"), from the Votes and Sites collections.
	* The Command View's Propose (SetHandler for Build, Upgrade, Merge and TearDown) sends the
	  Propose remote. BuildService answers on the telegram, or with an alert when it refuses.
	* Chimes: SoundService.VoteOpen and SoundService.VotePassed, when they exist (Prompt 32's
	  audio).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Lib = script.Parent.Parent:WaitForChild("Lib")
local KitRuntime = require(Lib:WaitForChild("KitRuntime"))

local log = Log.new("VoteController")

local ACTIONS = { "Build", "Upgrade", "Merge", "TearDown" }
local RESULT_WITH_NEXT = 1.5 -- seconds a result stays when another vote is already live
local LEAF = Color3.fromHex("#6F9B4C")
local RUST = Color3.fromHex("#B5412B")
local INK = Color3.fromHex("#2A3B4C")

local VoteController = {
	Name = "VoteController",
	Dependencies = { "ReplicaController", "CommandViewController" },
}

local replica: any = nil
local commandView: any = nil
local gui: ScreenGui? = nil
local banner: any = nil
local shownId: string? = nil -- the vote on the telegram
local shownStatus: string? = nil
local resultUntil = 0
local ghosts: { [string]: boolean } = {} -- the ghost ids this controller made
local missingChimes: { [string]: boolean } = {}

local function chime(name: string)
	local sound = SoundService:FindFirstChild(name)
	if sound and sound:IsA("Sound") then
		SoundService:PlayLocalSound(sound)
	elseif not missingChimes[name] then
		missingChimes[name] = true
		log:Debug("no SoundService.%s yet (the audio prompt adds it)", name)
	end
end

local function myBallot(vote: any): string?
	local ballots = vote.Ballots
	return if type(ballots) == "table" then ballots[tostring(Players.LocalPlayer.UserId)] else nil
end

-- The vote the telegram shows: a result just in, else the live vote.
local function pick(): (string?, any)
	local votes = replica:All("Votes")
	local shown = if shownId then votes[shownId] else nil
	if shown and (shown.Status == "Passed" or shown.Status == "Failed") and os.clock() < resultUntil then
		return shownId, shown
	end
	for id, vote in votes do
		if type(vote) == "table" and vote.Status == "Live" then
			return id, vote
		end
	end
	return nil, nil
end

local function waitingCount(): number
	local n = 0
	for _, vote in replica:All("Votes") do
		if type(vote) == "table" and vote.Status == "Queued" then
			n += 1
		end
	end
	return n
end

local function anotherLive(except: string?): boolean
	for id, vote in replica:All("Votes") do
		if id ~= except and type(vote) == "table" and vote.Status == "Live" then
			return true
		end
	end
	return false
end

local function render()
	if not banner then
		return
	end
	-- a vote that just closed: note when its result stops showing, and chime a pass
	if shownId then
		local current = replica:Get("Votes", shownId)
		local status = if type(current) == "table" then current.Status else nil
		if status ~= shownStatus and (status == "Passed" or status == "Failed") then
			resultUntil = os.clock() + (if anotherLive(shownId) then RESULT_WITH_NEXT else Config.Get("Tuning", "Votes").ResultSeconds)
			if status == "Passed" then
				chime("VotePassed")
			end
		end
		shownStatus = status
	end
	local id, vote = pick()
	if not id or not vote then
		banner.Visible = false
		shownId, shownStatus = nil, nil
		return
	end
	if id ~= shownId then
		shownId, shownStatus = id, vote.Status
		if vote.Status == "Live" then
			chime("VoteOpen")
		end
	end
	banner.Visible = true
	local cost = if type(vote.Cost) == "string" and vote.Cost ~= "" and vote.Cost ~= "FREE" then `  ·  {vote.Cost}` else ""
	banner.Proposal.Text = `{vote.ProposerName} PROPOSES: {vote.Title}{cost}`
	local yes, no = banner.Yes, banner.No
	local fill = banner.Timer.Fill
	if vote.Status == "Live" then
		local left = math.max(0, (vote.EndsAt or 0) - workspace:GetServerTimeNow())
		local waiting = waitingCount()
		banner.Tally.Text = `YES {vote.Yes}  ·  NO {vote.No}  ·  {math.ceil(left)} S  ·  {vote.Need}`
			.. (if waiting > 0 then `  ·  {waiting} WAITING` else "")
		banner.Tally.TextColor3 = INK
		fill.Size = UDim2.fromScale(math.clamp(left / math.max(vote.Seconds or 1, 1), 0, 1), 1)
		local ballot = myBallot(vote)
		KitRuntime.SetEnabled(yes, true)
		KitRuntime.SetEnabled(no, true)
		KitRuntime.SetLatched(yes, ballot == "Yes")
		KitRuntime.SetLatched(no, ballot == "No")
	else
		banner.Tally.Text = tostring(vote.Result or vote.Status)
		banner.Tally.TextColor3 = if vote.Status == "Passed" then LEAF else RUST
		fill.Size = UDim2.fromScale(0, 1)
		KitRuntime.SetLatched(yes, false)
		KitRuntime.SetLatched(no, false)
		KitRuntime.SetEnabled(yes, false)
		KitRuntime.SetEnabled(no, false)
	end
end

local function cast(ballot: string)
	local id, vote = pick()
	if id and vote and vote.Status == "Live" then
		Remotes.FireServer("CastVote", id, ballot)
	end
end

-- Ghost outlines in the Command View: open proposals and construction sites.
local function syncGhosts()
	local want: { [string]: { any } } = {}
	for id, vote in replica:All("Votes") do
		local subject = if type(vote) == "table" then vote.Subject else nil
		if type(subject) == "table" and (vote.Status == "Live" or vote.Status == "Queued") then
			want["vote:" .. id] = { subject.Floor, subject.Column, subject.Span, subject.Label }
		end
	end
	for id, site in replica:All("Sites") do
		if type(site) == "table" then
			local info = Config.Find("Rooms", site.Type)
			local name = if info then string.upper(info.Name) else tostring(site.Type)
			want["site:" .. id] = { site.Floor, site.Column, site.Span, `{name} {math.floor((site.Progress or 0) * 100)}%` }
		end
	end
	for key, g in want do
		if ghosts[key] then
			commandView:SetGhostLabel(key, g[4])
		else
			commandView:ShowGhost(key, g[1], g[2], g[3], g[4])
			ghosts[key] = true
		end
	end
	for key in ghosts do
		if not want[key] then
			commandView:HideGhost(key)
			ghosts[key] = nil
		end
	end
end

function VoteController:State(): { [string]: any }
	local id, vote = pick()
	return {
		Shown = id,
		Visible = banner ~= nil and banner.Visible,
		Proposal = if banner then banner.Proposal.Text else nil,
		Tally = if banner then banner.Tally.Text else nil,
		Mine = if vote then myBallot(vote) else nil,
		Ghosts = (function()
			local keys = {}
			for key in ghosts do
				table.insert(keys, key)
			end
			table.sort(keys)
			return table.concat(keys, ",")
		end)(),
	}
end

function VoteController:Init(registry)
	replica = registry.ReplicaController
	commandView = registry.CommandViewController
end

function VoteController:Start()
	if Constants.PlaceKind() ~= "Run" then
		return
	end
	for _, action in ACTIONS do
		commandView:SetHandler(action, function(choice: any)
			local detail = if action == "Build" then (choice.RoomType or "") elseif action == "Merge" then (choice.Other or "") else ""
			Remotes.FireServer("Propose", action, choice.Floor, choice.Column, detail)
		end)
	end
	replica:Changed("Votes"):Connect(syncGhosts)
	replica:Changed("Sites"):Connect(syncGhosts)
	syncGhosts()

	local found = Players.LocalPlayer:WaitForChild("PlayerGui"):WaitForChild("Votes", 20)
	if not found or not found:IsA("ScreenGui") then
		log:Warn("no Votes ScreenGui in this place: the vote telegram can't show")
		return
	end
	gui = found
	KitRuntime.Watch(found)
	banner = found:FindFirstChild("VoteBanner")
	if not banner then
		log:Warn("the Votes ScreenGui has no VoteBanner")
		return
	end
	banner.Yes.Activated:Connect(function()
		cast("Yes")
	end)
	banner.No.Activated:Connect(function()
		cast("No")
	end)
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt: number)
		elapsed += dt
		if elapsed >= 0.1 then
			elapsed = 0
			render()
		end
	end)
	render()
	log:Debug("vote telegram ready")
end

return VoteController
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX000000CB"><Properties><string name="Name">Lib</string></Properties><Item class="ModuleScript" referent="RBX000000C8"><Properties><string name="Name">Fade</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Fade: see-through world parts on this client only, shared by the camera (walls and
	furniture between the camera and the character) and the Command View (front walls).

	Each source asks for an amount per part (0 opaque, 1 hidden); a part shows the largest ask,
	eased over `seconds`, through BasePart.LocalTransparencyModifier, which is local to this
	client and never replicates. Parts that leave the game drop out by themselves.

		Fade.Set(part, "Camera", 0.8)
		Fade.Clear(part, "Camera")
		Fade.ClearSource("Camera")
]]

local RunService = game:GetService("RunService")

local Fade = {}

local DEFAULT_SECONDS = 0.12

local asks: { [BasePart]: { [string]: number } } = {}
local shown: { [BasePart]: number } = {}
local seconds = DEFAULT_SECONDS
local connection: RBXScriptConnection? = nil

local function target(part: BasePart): number
	local best = 0
	for _, amount in asks[part] or {} do
		best = math.max(best, amount)
	end
	return best
end

local function step(dt: number)
	local rate = if seconds > 0 then dt / seconds else 1
	local busy = false
	for part, current in shown do
		if part.Parent == nil then
			shown[part] = nil
			asks[part] = nil
			continue
		end
		local goal = target(part)
		local nextValue = if current < goal then math.min(current + rate, goal) else math.max(current - rate, goal)
		if nextValue ~= current then
			part.LocalTransparencyModifier = nextValue
		end
		if nextValue <= 0 and goal <= 0 then
			shown[part] = nil
			asks[part] = nil
		else
			shown[part] = nextValue
			busy = true
		end
	end
	if not busy and connection then
		connection:Disconnect()
		connection = nil
	end
end

local function wake()
	if not connection then
		connection = RunService.RenderStepped:Connect(step)
	end
end

-- How long a fade in or out takes (the camera sets this from Tuning.Camera.FadeSeconds).
function Fade.SetSeconds(value: number)
	seconds = math.max(0, value)
end

function Fade.Set(part: BasePart, source: string, amount: number)
	local list = asks[part]
	if not list then
		list = {}
		asks[part] = list
	end
	list[source] = math.clamp(amount, 0, 1)
	if shown[part] == nil then
		shown[part] = part.LocalTransparencyModifier
	end
	wake()
end

function Fade.Clear(part: BasePart, source: string)
	local list = asks[part]
	if list then
		list[source] = nil
	end
	if shown[part] ~= nil then
		wake()
	end
end

-- Drops every ask a source made (when the camera stops, or the Command View closes).
function Fade.ClearSource(source: string)
	for part, list in asks do
		if list[source] ~= nil then
			list[source] = nil
			wake()
		end
	end
end

-- The parts a source is fading now (DevTools).
function Fade.Count(source: string?): number
	local count = 0
	for _, list in asks do
		if source == nil or list[source] ~= nil then
			count += 1
		end
	end
	return count
end

return Fade
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C9"><Properties><string name="Name">KitRuntime</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Lib.KitRuntime: keeps the UI kit right on every screen (bible Section 18).

	* 9-slice corners: kit sprites are drawn at twice their 1080p size, so a sliced image's
	  SliceScale is 0.5 x height / 1080 (times its SliceMul attribute, if any).
	* Strokes and scroll bars are pixels, so their 1080p sizes (BaseThickness, BaseScrollBar
	  attributes) follow the screen height too: the StrokeScaler of the AutoScale Lite rules.
	* Push-buttons: the builder writes RectUp, RectDown and optionally RectHover and
	  RectDisabled. The pressed sprite shows while the button is held, and its Content frame
	  sinks a little, like a real cap.

	Watch(gui) does all of this for a ScreenGui now, for anything cloned into it later, and
	again whenever its size changes. SetSprite points an image at a kit sprite and keeps a
	builder's crop. SetEnabled greys a button out.
]]

local UIKit = require(script.Parent.UIKit)

local KitRuntime = {}

local SINK = 0.06 -- how far a pressed button's Content moves down (of its height)

local hooked: { [Instance]: boolean } = setmetatable({}, { __mode = "k" }) :: any

local function heightOf(gui: Instance): number
	local h = 0
	if gui:IsA("LayerCollector") then
		local layer: any = gui
		h = layer.AbsoluteSize.Y
	end
	if h <= 0 then
		local camera = workspace.CurrentCamera
		h = if camera then camera.ViewportSize.Y else 1080
	end
	return math.max(h, 1)
end

local function scaleOne(o: Instance, k: number)
	local item: any = o
	if (o:IsA("ImageLabel") or o:IsA("ImageButton")) and item.ScaleType == Enum.ScaleType.Slice then
		local mul = o:GetAttribute("SliceMul")
		item.SliceScale = 0.5 * k * (if type(mul) == "number" then mul else 1)
	elseif o:IsA("UIStroke") then
		local base = o:GetAttribute("BaseThickness")
		if type(base) == "number" then
			item.Thickness = base * k
		end
	elseif o:IsA("ScrollingFrame") then
		local base = o:GetAttribute("BaseScrollBar")
		if type(base) == "number" then
			item.ScrollBarThickness = math.max(2, math.round(base * k))
		end
	end
end

local function rect(button: Instance, state: string): Vector2?
	local value = button:GetAttribute("Rect" .. state)
	return if typeof(value) == "Vector2" then value else nil
end

local function show(button: ImageButton, state: string)
	local r = rect(button, state) or rect(button, "Up")
	if r then
		button.ImageRectOffset = r
	end
	local content = button:FindFirstChild("Content")
	if content and content:IsA("GuiObject") then
		local home = content:GetAttribute("Home")
		if typeof(home) ~= "UDim2" then
			home = content.Position
			content:SetAttribute("Home", home)
		end
		local rest: UDim2 = home :: any
		content.Position = if state == "Down" then rest + UDim2.fromScale(0, SINK) else rest
	end
end

local function hook(button: ImageButton)
	if hooked[button] or not rect(button, "Up") or not rect(button, "Down") then
		return
	end
	hooked[button] = true
	local over = false
	local function settle()
		if button:GetAttribute("Disabled") == true then
			show(button, "Disabled")
		elseif button:GetAttribute("Latched") == true then
			show(button, "Down") -- held in: a vote cast, a toggle on
		else
			show(button, if over and rect(button, "Hover") then "Hover" else "Up")
		end
	end
	button.MouseButton1Down:Connect(function()
		if button:GetAttribute("Disabled") ~= true then
			show(button, "Down")
		end
	end)
	button.MouseButton1Up:Connect(settle)
	button.MouseEnter:Connect(function()
		over = true
		settle()
	end)
	button.MouseLeave:Connect(function()
		over = false
		settle()
	end)
	button:GetAttributeChangedSignal("Disabled"):Connect(settle)
	button:GetAttributeChangedSignal("Latched"):Connect(settle)
	settle()
end

-- Applies the kit's runtime rules to a ScreenGui. Returns a function that stops watching.
function KitRuntime.Watch(gui: Instance): () -> ()
	local function factor(): number
		return heightOf(gui) / 1080
	end
	local function applyAll()
		local k = factor()
		for _, o in gui:GetDescendants() do
			scaleOne(o, k)
		end
	end
	for _, o in gui:GetDescendants() do
		if o:IsA("ImageButton") then
			hook(o)
		end
	end
	applyAll()
	local connections = {
		gui:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyAll),
		gui.DescendantAdded:Connect(function(o: Instance)
			scaleOne(o, factor())
			if o:IsA("ImageButton") then
				hook(o)
			end
		end),
	}
	return function()
		for _, connection in connections do
			connection:Disconnect()
		end
	end
end

-- Points an image at a kit sprite. An image the builder cropped (a card's rarity tag, say)
-- keeps its crop inside the new sprite.
function KitRuntime.SetSprite(image: ImageLabel | ImageButton, name: string)
	local sprite = UIKit.Sprites[name]
	assert(sprite, `KitRuntime: no sprite {name}`)
	local item: any = image
	item.Image = sprite.image
	local crop = image:GetAttribute("Crop")
	if typeof(crop) == "Vector2" then
		item.ImageRectOffset = sprite.offset + crop
	else
		item.ImageRectOffset = sprite.offset
		item.ImageRectSize = sprite.size
		if sprite.slice then
			item.ScaleType = Enum.ScaleType.Slice
			item.SliceCenter = sprite.slice
		else
			item.ScaleType = Enum.ScaleType.Stretch
		end
	end
	image:SetAttribute("Sprite", name)
	local gui = image:FindFirstAncestorWhichIsA("LayerCollector")
	scaleOne(image, heightOf(gui or image) / 1080)
end

-- Greys a push-button out (its Disabled sprite when it has one) or brings it back.
function KitRuntime.SetEnabled(button: ImageButton, on: boolean)
	button:SetAttribute("Disabled", if on then nil else true)
	if not hooked[button] then
		show(button, if on then "Up" else "Disabled")
	end
end

-- Holds a push-button in (a vote cast, a toggle that is on) until released.
function KitRuntime.SetLatched(button: ImageButton, on: boolean)
	button:SetAttribute("Latched", if on then true else nil)
end

function KitRuntime.IsEnabled(button: Instance): boolean
	return button:GetAttribute("Disabled") ~= true
end

return KitRuntime
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CA"><Properties><string name="Name">UIKit</string><ProtectedString name="Source"><![CDATA[--!strict
