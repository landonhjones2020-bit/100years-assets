	RadioLog = {
		To = "Client",
		Place = "Run",
		Doc = "A radio log to play for this player (Section 12; Prompt 17): its title, who it is from, its text, and where a Lost Crew was last heard from (or nil) (DeepService; Prompt 18: distress calls and the Radio Room's crew calls, ExpeditionService).",
	},
	Elevator = {
		To = "Client",
		Place = "Run",
		Doc = "The elevator behind the Blast Door is moving this player (Section 12): the way (Up or Down) and the fade's seconds; the server moves the character once the screen is dark (SurfaceService, Prompt 16).",
	},
}

local log = Log.new("Remotes")
local IS_SERVER = RunService:IsServer()
local WAIT_SECONDS = 15
local REJECTION_LOG_SECONDS = 10

export type Stats = { Received: number, Rejected: number, Limited: number, Failed: number }

local stats: { [string]: Stats } = {}
local limiters: { [string]: RateLimit.Limiter } = {}
local handled: { [string]: boolean } = {}
local lastRejectionLog: { [Player]: number } = {}

for name, definition in DEFINITIONS do
	assert(definition.To == "Server" or definition.To == "Client", `Remote {name}: To must be Server or Client`)
	assert(definition.Place == nil or definition.Place == "Lobby" or definition.Place == "Run", `Remote {name}: Place must be Lobby or Run`)
	if definition.To == "Server" then
		assert(definition.Args, `Remote {name}: a client -> server remote needs Args`)
		assert(definition.Rate, `Remote {name}: a client -> server remote needs a Rate`)
	end
	stats[name] = { Received = 0, Rejected = 0, Limited = 0, Failed = 0 }
	table.freeze(definition)
end
table.freeze(DEFINITIONS)

local Remotes = {}

Remotes.Definitions = DEFINITIONS

-- Does this remote exist in this place?
function Remotes.InPlace(name: string): boolean
	local definition = DEFINITIONS[name]
	return definition ~= nil and (definition.Place == nil or definition.Place == Constants.PlaceKind())
end

local function definitionOf(name: string, direction: "Server" | "Client"): Definition
	local definition = DEFINITIONS[name]
	if not definition then
		error(`Unknown remote {tostring(name)}`, 3)
	end
	if definition.To ~= direction then
		error(`Remote {name} goes to the {definition.To:lower()}, not the {direction:lower()}`, 3)
	end
	if definition.Place ~= nil and definition.Place ~= Constants.PlaceKind() then
		error(`Remote {name} only exists in the {definition.Place} place`, 3)
	end
	return definition
end

local function instanceOf(name: string): RemoteEvent
	local found = script:FindFirstChild(name)
	if not found then
		if IS_SERVER then
			error(`Remote {name} doesn't exist yet: call Remotes.Setup() first`, 3)
		end
		found = script:WaitForChild(name, WAIT_SECONDS)
		if not found then
			error(`Remote {name} didn't arrive within {WAIT_SECONDS} s`, 3)
		end
	end
	return found :: any
end

-- Server: create every RemoteEvent. Idempotent.
function Remotes.Setup()
	assert(IS_SERVER, "Remotes.Setup runs on the server")
	local place = Constants.PlaceKind()
	for name, definition in DEFINITIONS do
		local className = if definition.Unreliable then "UnreliableRemoteEvent" else "RemoteEvent"
		local existing = script:FindFirstChild(name)
		if definition.Place ~= nil and definition.Place ~= place then
			if existing then
				existing:Destroy()
			end
			continue
		end
		if existing and existing.ClassName ~= className then
			existing:Destroy()
			existing = nil
		end
		if not existing then
			local remote = Instance.new(className)
			remote.Name = name
			remote.Parent = script
		end
		if definition.Rate then
			limiters[name] = RateLimit.new(definition.Rate.Burst, definition.Rate.PerSecond)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		for _, limiter in limiters do
			limiter:Forget(player)
		end
		lastRejectionLog[player] = nil
	end)
end

local function noteRejection(player: Player, name: string, why: string)
	local now = os.clock()
	local last = lastRejectionLog[player]
	if last and now - last < REJECTION_LOG_SECONDS then
		return
	end
	lastRejectionLog[player] = now
	log:Warn("rejected %s from %s (%d): %s", name, player.Name, player.UserId, why)
end

-- Server: the handler for a client -> server remote. One handler per remote.
function Remotes.OnServer(name: string, handler: (player: Player, ...any) -> ())
	assert(IS_SERVER, "Remotes.OnServer runs on the server")
	local definition = definitionOf(name, "Server")
	assert(not handled[name], `Remote {name} already has a handler`)
	handled[name] = true
	local checks = definition.Args :: { Check.Checker }
	local limiter = limiters[name]
	local counters = stats[name]
	instanceOf(name).OnServerEvent:Connect(function(player: Player, ...: any)
		counters.Received += 1
		if limiter and not limiter:Take(player) then
			counters.Limited += 1
			noteRejection(player, name, "rate limit")
			return
		end
		local count = select("#", ...)
		if count > #checks then
			counters.Rejected += 1
			noteRejection(player, name, `{count} arguments, expected at most {#checks}`)
			return
		end
		local args = { ... }
		for index, check in checks do
			local ok, why = check(args[index])
			if not ok then
				counters.Rejected += 1
				noteRejection(player, name, `argument {index}: {why}`)
				return
			end
		end
		local ok, err = xpcall(handler, debug.traceback, player, table.unpack(args, 1, count))
		if not ok then
			counters.Failed += 1
			log:Error("%s handler failed for %s: %s", name, player.Name, tostring(err))
		end
	end)
end

function Remotes.FireClient(name: string, player: Player, ...: any)
	definitionOf(name, "Client")
	instanceOf(name):FireClient(player, ...)
end

function Remotes.FireClients(name: string, players: { Player }, ...: any)
	definitionOf(name, "Client")
	local remote = instanceOf(name)
	for _, player in players do
		remote:FireClient(player, ...)
	end
end

function Remotes.FireAllClients(name: string, ...: any)
	definitionOf(name, "Client")
	instanceOf(name):FireAllClients(...)
end

-- Client: the handler for a server -> client remote.
function Remotes.OnClient(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER, "Remotes.OnClient runs on the client")
	definitionOf(name, "Client")
	return instanceOf(name).OnClientEvent:Connect(handler)
end

function Remotes.FireServer(name: string, ...: any)
	assert(not IS_SERVER, "Remotes.FireServer runs on the client")
	definitionOf(name, "Server")
	instanceOf(name):FireServer(...)
end

-- Server: counters per remote, for DevTools.
function Remotes.Stats(): { [string]: Stats }
	return stats
end

return table.freeze(Remotes)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000000D7"><Properties><string name="Name">Rules</string></Properties><Item class="ModuleScript" referent="RBX000000BE"><Properties><string name="Name">Boss</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Boss: boss fights as arithmetic (bible Sections 10 and 22; Prompt 15). Pure, so BossService,
	BossController, WeaponService and the data tests agree. The numbers are Config.Bosses (health,
	phases), Tuning.Bosses (every boss) and Tuning.<BossId> (one boss's fight), provisional.

	* Health: Config.Bosses' Health times Threat.PlayerScale for the team (Section 5: the threat
	  scales with player count), times FirstRunHealth on an account's first run for an Era I boss
	  (Section 22: the Brood Mother is weaker).
	* Phases: a boss with N phases moves to the next at each Nth of its health lost.
	* The arena (Section 10: the Brood Mother bursts up through the deepest tunnel): on the deepest
	  floor, the longest run of side-by-side dug cells (a tunnel: nothing walls them apart); with
	  none, the widest room there that isn't the Reactor Core or a Shaft; with none, any open cell.
	  A boss can't fit through a doorway, so it fights in its arena.
	* Hits: armour takes ArmourMultiplier, a weak point WeakPointMultiplier (or a class's own).
	* Staggers: enough weak-point damage inside a short window staggers the boss.
	* The Source (Prompt 25; Section 10: "tendrils in many rooms at once, then the core, so the team
	  has to split up and regroup"): its fight is a list of stages (Tuning.Source.Stages), each
	  Tendrils or Core. SourceTendrils is how many stand in a Tendrils stage (and how many of those
	  in its own chamber when it is fought there), SourceRooms where in the bunker, SourceWound what
	  each one cut down takes off the Source so the last ends the stage, SourceCoreOver when a Core
	  stage is.
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

local Boss = {}

export type Arena = {
	Floor: number,
	From: number, -- first column
	To: number, -- last column
	Kind: "Tunnel" | "Room" | "Cell",
	RoomId: string?,
}

function Boss.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Bosses")
end

-- A boss's own fight numbers (Tuning.<BossId>), or nil before its fight exists.
function Boss.Fight(bossId: string): { [string]: any }?
	return Config.Find("Tuning", bossId)
end

-- A boss's name for an alert: capitals, with one THE ("THE BROOD MOTHER", "THE DELUGE").
function Boss.Title(name: string): string
	local upper = string.upper(name)
	return if string.sub(upper, 1, 4) == "THE " then upper else `THE {upper}`
end

-- The value for this phase from a by-phase list (the last one carries on).
function Boss.ByPhase(list: { any }, phase: number): any
	return list[math.clamp(phase, 1, #list)]
end

function Boss.Health(bossId: string, players: number, firstRun: boolean): number
	local entry = Config.Get("Bosses", bossId)
	local scale = Config.Get("Tuning", "Threat").PlayerScale
	local n = math.clamp(math.floor(players), 1, #scale)
	local health = entry.Health * scale[n]
	if firstRun and entry.Year <= 25 then
		health *= Boss.Tuning().FirstRunHealth
	end
	return math.floor(health + 0.5)
end

-- The phase at this share of health left (1 at full health, Phases near the end).
function Boss.Phase(bossId: string, fraction: number): number
	local phases = Config.Get("Bosses", bossId).Phases
	local lost = 1 - math.clamp(fraction, 0, 1)
	return math.clamp(math.floor(lost * phases + 1e-9) + 1, 1, phases)
end

-- Where a boss breaks in: see the header. `bunker` is a Rules.Bunker.
function Boss.Arena(bunker: any): Arena?
	local floor = bunker:DeepestFloor()
	if floor < 1 then
		return nil
	end
	local t = Grid.Tuning()
	-- runs of dug cells side by side
	local best: Arena? = nil
	local column = t.ColumnMin
	while column <= t.ColumnMax do
		if bunker:State(floor, column) == "Dug" then
			local from = column
			while column + 1 <= t.ColumnMax and bunker:State(floor, column + 1) == "Dug" do
				column += 1
			end
			if not best or column - from > best.To - best.From then
				best = { Floor = floor, From = from, To = column, Kind = "Tunnel" }
			end
		end
		column += 1
	end
	if best then
		return best
	end
	-- the widest room on the floor that isn't the Reactor Core or a Shaft
	local room: any = nil
	for _, r in bunker:AllRooms() do
		if r.Floor == floor and r.Type ~= "ReactorCore" and r.Type ~= "Shaft" then
			if not room or r.Span > room.Span or (r.Span == room.Span and r.Column < room.Column) then
				room = r
			end
		end
	end
	if room then
		return { Floor = floor, From = room.Column, To = room.Column + room.Span - 1, Kind = "Room", RoomId = room.Id }
	end
	for c = t.ColumnMin, t.ColumnMax do
		if bunker:IsOpen(floor, c) then
			return { Floor = floor, From = c, To = c, Kind = "Cell" }
		end
	end
	return nil
end

-- The middle column of an arena (where the boss breaks in).
function Boss.ArenaMiddle(arena: Arena): number
	return math.floor((arena.From + arena.To) / 2)
end

-- How far along X the boss's centre may go: `margin` studs inside the arena's end walls.
function Boss.ArenaSpan(arena: Arena, margin: number): (number, number)
	local half = Grid.Tuning().CellWidth / 2
	local left = Grid.CellPosition(arena.Floor, arena.From).X - half + margin
	local right = Grid.CellPosition(arena.Floor, arena.To).X + half - margin
	if left > right then
		local mid = (left + right) / 2
		return mid, mid
	end
	return left, right
end

-- A hit's multiplier: the weak point's (a class's own if it has one), else the armour's.
function Boss.HitMultiplier(weak: boolean, classWeakPoint: number?): number
	local t = Boss.Tuning()
	if weak then
		return classWeakPoint or t.WeakPointMultiplier
	end
	return t.ArmourMultiplier
end

-- Is `point` on a weak point part? (`size` and `cframe` are the part's; tolerance in studs.)
function Boss.OnPart(point: Vector3, cframe: CFrame, size: Vector3, tolerance: number): boolean
	local p = cframe:PointToObjectSpace(point)
	local h = size / 2 + Vector3.one * tolerance
	return math.abs(p.X) <= h.X and math.abs(p.Y) <= h.Y and math.abs(p.Z) <= h.Z
end

-- Weak-point damage inside the window (hits are { At, Amount }) reaching `threshold` staggers.
function Boss.Staggers(hits: { { At: number, Amount: number } }, now: number, window: number, threshold: number): boolean
	local sum = 0
	for _, hit in hits do
		if now - hit.At <= window then
			sum += hit.Amount
		end
	end
	return sum >= threshold
end

-- The Source (Prompt 25) ---------------------------------------------------------------------------

export type TendrilSpot = { Floor: number, Column: number, RoomId: string? }

-- What a stage of the Source's fight is: "Tendrils" (its eye is shut) or "Core" (its eye is open).
function Boss.SourceStage(stage: number): string
	local stages = Config.Get("Tuning", "Source").Stages
	return stages[math.clamp(math.floor(stage), 1, #stages)]
end

-- How many tendrils stand in this stage for a team of `players`, and how many of them rise in its
-- own chamber when it is fought there (the rest are in the bunker's rooms).
function Boss.SourceTendrils(stage: number, players: number, chamber: boolean): (number, number)
	local t = Config.Get("Tuning", "Source")
	local base = Boss.ByPhase(t.Tendrils, stage)
	if Boss.SourceStage(stage) ~= "Tendrils" or base <= 0 then
		return 0, 0
	end
	local total = math.min(base + t.TendrilsPerPlayer * (math.max(math.floor(players), 1) - 1), t.TendrilsMax)
	local inChamber = if chamber then math.min(Boss.ByPhase(t.ChamberTendrils, stage), total) else 0
	return total, inChamber
end

-- A tendril's health for the team (scaled like a boss's).
function Boss.TendrilHealth(players: number): number
	local scale = Config.Get("Tuning", "Threat").PlayerScale
	local n = math.clamp(math.floor(players), 1, #scale)
	return math.floor(Config.Get("Tuning", "Source").TendrilHealth * scale[n] + 0.5)
end

-- What a tendril cut down takes off the Source: an even share of the health still between it and
-- the stage's end, over the tendrils left (this one counted), so the last one ends the stage.
function Boss.SourceWound(health: number, max: number, stage: number, left: number): number
	local untilFraction = Boss.ByPhase(Config.Get("Tuning", "Source").StageUntil, stage)
	return math.max(health - untilFraction * max, 0) / math.max(left, 1)
end

-- Is a Core stage over at this health? The last stage ends only with its death.
function Boss.SourceCoreOver(health: number, max: number, stage: number): boolean
	local t = Config.Get("Tuning", "Source")
	if stage >= #t.Stages then
		return false
	end
	return health <= Boss.ByPhase(t.StageUntil, stage) * max
end

--[[
	Where `count` tendrils stand in the bunker: one to a room (a cell of it picked by `pick`), never
	a Shaft or the Reactor Core (a tendril there would be a meltdown nobody could answer in time),
	never a cell in `avoid` ("floor,column" keys: the Source's own arena). Spread: rooms on floors
	that have none yet come first, so the team has to split up; `deepest` (the chamber fight) takes
	the deepest floors first instead, the rooms nearest the chamber. With fewer rooms than tendrils
	the rest stand in dug cells; with none of those either, fewer come. `pick(n)` returns 1 to n.
]]
function Boss.SourceRooms(bunker: any, count: number, pick: (number) -> number, avoid: { [string]: boolean }?, deepest: boolean?): { TendrilSpot }
	local out: { TendrilSpot } = {}
	if count <= 0 then
		return out
	end
	local candidates: { TendrilSpot } = {}
	for _, room in bunker:AllRooms() do
		if room.Type ~= "Shaft" and room.Type ~= "ReactorCore" then
			local cells = {}
			for c = room.Column, room.Column + room.Span - 1 do
				if not (avoid and avoid[Grid.Key(room.Floor, c)]) then
					table.insert(cells, c)
				end
			end
			if #cells > 0 then
				table.insert(candidates, { Floor = room.Floor, Column = cells[pick(#cells)], RoomId = room.Id })
			end
		end
	end
	-- a shuffle (Fisher-Yates with the caller's pick), then the order the rule asks for
	table.sort(candidates, function(a, b)
		return if a.Floor ~= b.Floor then a.Floor < b.Floor else a.Column < b.Column
	end)
	for i = #candidates, 2, -1 do
		local j = pick(i)
		candidates[i], candidates[j] = candidates[j], candidates[i]
	end
	local used: { [number]: number } = {}
	while #out < count and #candidates > 0 do
		local best, bestScore = 1, math.huge
		for i, spot in candidates do
			local score = if deepest then -spot.Floor else (used[spot.Floor] or 0)
			if score < bestScore then
				best, bestScore = i, score
			end
		end
		local spot = table.remove(candidates, best) :: TendrilSpot
		used[spot.Floor] = (used[spot.Floor] or 0) + 1
		table.insert(out, spot)
	end
	if #out < count then
		local t = Grid.Tuning()
		local dug: { TendrilSpot } = {}
		for floor = 1, bunker:DeepestFloor() do
			for column = t.ColumnMin, t.ColumnMax do
				if bunker:State(floor, column) == "Dug" and not (avoid and avoid[Grid.Key(floor, column)]) then
					table.insert(dug, { Floor = floor, Column = column })
				end
			end
		end
		while #out < count and #dug > 0 do
			table.insert(out, table.remove(dug, pick(#dug)) :: TendrilSpot)
		end
	end
	return out
end

return table.freeze(Boss)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000BF"><Properties><string name="Name">Bunker</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Bunker: the bunker as data, with the grid's rules (bible Section 6). Pure (no
	Instances), so BunkerGrid on the server, the Command View on the client (ghost outlines,
	what can be dug) and the data tests share it.

	Every cell on the grid is Rock, Dug (empty) or part of a room. `Cells` holds the open ones:
	"" for a Dug cell, the room's id for a room cell; a cell that isn't there is Rock.

	The rules:
	* Dig: a Rock cell to the left of, right of or below an open cell.
	* Place: a room on Dug cells side by side on one floor, at most its MaxCells, in a band
	  that can be built on (not the Source Chamber), on its own Floor if it has one, and only
	  one of a Unique room.
	* Merge: two rooms of one type and level side by side, at most MaxCells together (rooms at
	  different levels never merge; Landon, Nov 8, 2026). Fixed rooms (the Blast Door, the
	  Reactor Core) never merge, move or go. The merged room keeps both rooms' HP.
	* HP is per cell (Landon, Nov 8, 2026): a room's maximum is Tuning.Rooms.HP for its level
	  times its cells, so a 3-cell room at level 1 has 1,500. RoomHP and BlastDoorHealth
	  modifiers scale it (SetHPScale; Prompt 13).
	* Wrecked (Section 6: at 0 HP a room is wrecked and stops until repaired): a room is
	  Wrecked from the moment its HP reaches 0 until repairs bring it back to Tuning.Repairs
	  .RepairedAt of its maximum (Prompt 13). Wrecked rooms make nothing and draw nothing.
	* SetLevel: 1 to 3; HP keeps its share of the new maximum.
	* The room graph: a node per room ("R3") and per Dug cell ("D:2,3"), with an edge between
	  side-by-side open cells of different units (a doorway) and between stacked Shafts. A dug
	  cell is a step like a room when power counts steps from a Reactor Core or a Generator
	  (Section 6; Landon, Nov 8, 2026).

	Votes, costs and build time (BuildService, Prompt 8), dig time and Push Deeper (DigService,
	Prompt 14) are not here.
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

export type CellState = "Rock" | "Dug" | "Room"
export type Room = {
	Id: string,
	Type: string,
	Floor: number,
	Column: number, -- the leftmost cell
	Span: number, -- cells, side by side
	Level: number,
	HP: number,
	MaxHP: number,
	Wrecked: boolean, -- from 0 HP until repaired to RepairedAt of MaxHP (Prompt 13)
}

type Data = {
	Cells: { [string]: string },
	Rooms: { [string]: Room },
	NextId: number,
	HPScale: { [string]: number }, -- "All" or a room type -> HP multiplier (RoomHP, BlastDoorHealth)
}

local Bunker = {}
Bunker.__index = Bunker

export type Bunker = typeof(setmetatable({} :: Data, Bunker))

local DUG_PREFIX = "D:"

-- A room's maximum HP: per cell, by level.
local function maxHP(level: number, span: number): number
	return Config.Get("Tuning", "Rooms").HP[level] * span
end

Bunker.MaxHP = maxHP

-- HP a wrecked room needs before it works again.
local function repairedAt(maxHPValue: number): number
	return math.ceil(maxHPValue * Config.Get("Tuning", "Repairs").RepairedAt)
end

Bunker.RepairedAt = repairedAt

local function idNumber(id: string): number
	return tonumber(string.sub(id, 2)) or 0
end

function Bunker.new(): Bunker
	return setmetatable({ Cells = {}, Rooms = {}, NextId = 1, HPScale = {} } :: Data, Bunker)
end

-- The starting bunker (Tuning.StartingBunker), built by the same rules.
function Bunker.FromStart(): Bunker
	local bunker = Bunker.new()
	local start = Config.Get("Tuning", "StartingBunker")
	for _, cell in start.Cells do
		for column = cell.Column, cell.Column + (cell.Span or 1) - 1 do
			bunker:Open(cell.Floor, column)
		end
	end
	for _, cell in start.Cells do
		if cell.Room then
			local id, why = bunker:Place(cell.Room, cell.Floor, cell.Column, cell.Span or 1)
			if not id then
				error(`Tuning.StartingBunker: {cell.Room} at {Grid.Key(cell.Floor, cell.Column)}: {why}`)
			end
		end
	end
	return bunker
end

-- A copy of the bunker from the replicated collections, for client previews (the Command
-- View's build menu): Cells maps "floor,column" to { Room = id } or {}, Rooms maps an id to
-- { Type, Floor, Column, Span, Level, HP, MaxHP }.
function Bunker.FromSnapshot(cells: { [string]: any }, rooms: { [string]: any }): Bunker
	local bunker = Bunker.new()
	for key, cell in cells do
		local roomId = if type(cell) == "table" then cell.Room else nil
		bunker.Cells[key] = if type(roomId) == "string" then roomId else ""
	end
	for id, room in rooms do
		bunker.Rooms[id] = {
			Id = id,
			Type = room.Type,
			Floor = room.Floor,
			Column = room.Column,
			Span = room.Span,
			Level = room.Level,
			HP = room.HP,
			MaxHP = room.MaxHP,
			Wrecked = if room.Wrecked ~= nil then room.Wrecked == true else room.HP <= 0,
		}
		bunker.NextId = math.max(bunker.NextId, idNumber(id) + 1)
	end
	return bunker
end

-- Cells ---------------------------------------------------------------------------------

-- Rock, Dug or Room (and the room's id); nil off the grid.
function Bunker.State(self: Bunker, floor: number, column: number): (CellState?, string?)
	if not Grid.OnGrid(floor, column) then
		return nil, nil
	end
	local value = self.Cells[Grid.Key(floor, column)]
	if value == nil then
		return "Rock", nil
	elseif value == "" then
		return "Dug", nil
	end
	return "Room", value
end

function Bunker.IsOpen(self: Bunker, floor: number, column: number): boolean
	local state = self:State(floor, column)
	return state == "Dug" or state == "Room"
end

-- Opens a cell with no questions asked: for the starting bunker and tests only.
function Bunker.Open(self: Bunker, floor: number, column: number)
	assert(Grid.OnGrid(floor, column), `Rules.Bunker: {Grid.Key(floor, column)} is off the grid`)
	local key = Grid.Key(floor, column)
	if self.Cells[key] == nil then
		self.Cells[key] = ""
	end
end

function Bunker.CanDig(self: Bunker, floor: number, column: number): (boolean, string?)
	if not Grid.OnGrid(floor, column) then
		return false, "off the grid"
	elseif self:IsOpen(floor, column) then
		return false, "already open"
	elseif self:IsOpen(floor, column - 1) or self:IsOpen(floor, column + 1) or self:IsOpen(floor - 1, column) then
		return true, nil
	end
	return false, "nothing dug beside or above it (dig left, right or down from a dug cell or room)"
end

function Bunker.Dig(self: Bunker, floor: number, column: number): (boolean, string?)
	local ok, why = self:CanDig(floor, column)
	if ok then
		self.Cells[Grid.Key(floor, column)] = ""
	end
	return ok, why
end

-- The deepest floor with an open cell.
function Bunker.DeepestFloor(self: Bunker): number
	local deepest = 0
	for key in self.Cells do
		local floor = Grid.Parse(key)
		if floor and floor > deepest then
			deepest = floor
		end
	end
	return deepest
end

-- Rooms ---------------------------------------------------------------------------------

-- A room's maximum HP here: per cell by level, times this bunker's RoomHP scale and its type's.
function Bunker.MaxHPOf(self: Bunker, roomType: string, level: number, span: number): number
	local scale = (self.HPScale.All or 1) * (self.HPScale[roomType] or 1)
	return math.floor(maxHP(level, span) * scale + 0.5)
end

-- Sets an HP multiplier ("All" rooms, or one room type) and rescales every room it touches,
-- each keeping its share of its maximum (RoomHP: Reinforced Walls; BlastDoorHealth).
function Bunker.SetHPScale(self: Bunker, key: string, value: number)
	self.HPScale[key] = if value == 1 then nil else value
	for _, room in self.Rooms do
		local newMax = self:MaxHPOf(room.Type, room.Level, room.Span)
		if newMax ~= room.MaxHP then
			room.HP = math.floor(room.HP / math.max(room.MaxHP, 1) * newMax + 0.5)
			room.MaxHP = newMax
		end
	end
end

-- Is the room wrecked? (Section 6: it stops until repaired.)
function Bunker.IsWrecked(room: Room?): boolean
	return room ~= nil and room.Wrecked == true
end

-- The live record: read it, never edit it (use the methods).
function Bunker.Room(self: Bunker, id: string): Room?
	return self.Rooms[id]
end

function Bunker.RoomAt(self: Bunker, floor: number, column: number): Room?
	local state, id = self:State(floor, column)
	return if state == "Room" and id then self.Rooms[id] else nil
end

function Bunker.IsShaft(self: Bunker, floor: number, column: number): boolean
	local room = self:RoomAt(floor, column)
	return room ~= nil and room.Type == "Shaft"
end

-- Every room, oldest first.
function Bunker.AllRooms(self: Bunker): { Room }
	local list = {}
	for _, room in self.Rooms do
		table.insert(list, room)
	end
	table.sort(list, function(a, b)
		return idNumber(a.Id) < idNumber(b.Id)
	end)
	return list
end

function Bunker.RoomsOfType(self: Bunker, roomType: string): { Room }
	local list = {}
	for _, room in self:AllRooms() do
		if room.Type == roomType then
			table.insert(list, room)
		end
	end
	return list
end

function Bunker.CanPlace(self: Bunker, roomType: string, floor: number, column: number, span: number): (boolean, string?)
	local info = Config.Find("Rooms", roomType)
	if not info then
		return false, `no room type {tostring(roomType)}`
	elseif span ~= math.floor(span) or span < 1 or span > info.MaxCells then
		return false, `{info.Name} takes 1 to {info.MaxCells} cells`
	end
	for offset = 0, span - 1 do
		local state = self:State(floor, column + offset)
		if state == nil then
			return false, "off the grid"
		elseif state ~= "Dug" then
			return false, `cell {Grid.Key(floor, column + offset)} isn't dug and empty`
		end
	end
	if not Grid.Buildable(floor) then
		return false, "nothing is built in the Source Chamber"
	elseif info.Floor and info.Floor ~= floor then
		return false, `{info.Name} only goes on floor {info.Floor}`
	elseif info.Unique and #self:RoomsOfType(roomType) > 0 then
		return false, `there is already a {info.Name}`
	end
	return true, nil
end

function Bunker.Place(self: Bunker, roomType: string, floor: number, column: number, span: number, level: number?): (string?, string?)
	local ok, why = self:CanPlace(roomType, floor, column, span)
	if not ok then
		return nil, why
	end
	local startLevel = level or 1
	if startLevel ~= 1 and startLevel ~= 2 and startLevel ~= 3 then
		return nil, "levels go from 1 to 3"
	end
	local id = `R{self.NextId}`
	self.NextId += 1
	local hp = self:MaxHPOf(roomType, startLevel, span)
	self.Rooms[id] = {
		Id = id,
		Type = roomType,
		Floor = floor,
		Column = column,
		Span = span,
		Level = startLevel,
		HP = hp,
		MaxHP = hp,
		Wrecked = false,
	}
	for offset = 0, span - 1 do
		self.Cells[Grid.Key(floor, column + offset)] = id
	end
	return id, nil
end

function Bunker.CanRemove(self: Bunker, id: string): (boolean, string?)
	local room = self.Rooms[id]
	if not room then
		return false, `no room {tostring(id)}`
	elseif Config.Get("Rooms", room.Type).Fixed then
		return false, `the {Config.Get("Rooms", room.Type).Name} can't be torn down`
	end
	return true, nil
end

-- Tears a room down; its cells become Dug again.
function Bunker.Remove(self: Bunker, id: string): (boolean, string?)
	local ok, why = self:CanRemove(id)
	if not ok then
		return false, why
	end
	local room = self.Rooms[id]
	for offset = 0, room.Span - 1 do
		self.Cells[Grid.Key(room.Floor, room.Column + offset)] = ""
	end
	self.Rooms[id] = nil
	return true, nil
end

function Bunker.CanMerge(self: Bunker, a: string, b: string): (boolean, string?)
	local first, second = self.Rooms[a], self.Rooms[b]
	if not first or not second then
		return false, "no such room"
	elseif a == b then
		return false, "a room can't merge with itself"
	end
	local info = Config.Get("Rooms", first.Type)
	if first.Type ~= second.Type then
		return false, "only matching rooms merge"
	elseif info.Fixed then
		return false, `the {info.Name} can't be merged`
	elseif first.Floor ~= second.Floor
		or (first.Column + first.Span ~= second.Column and second.Column + second.Span ~= first.Column)
	then
		return false, "the rooms aren't side by side"
	elseif first.Level ~= second.Level then
		return false, "the rooms are at different levels"
	elseif first.Span + second.Span > info.MaxCells then
		return false, `{info.Name} takes at most {info.MaxCells} cells`
	end
	return true, nil
end

-- Merges two rooms into one (the left room's id survives). Returns that id.
function Bunker.Merge(self: Bunker, a: string, b: string): (string?, string?)
	local ok, why = self:CanMerge(a, b)
	if not ok then
		return nil, why
	end
	local left, right = self.Rooms[a], self.Rooms[b]
	if right.Column < left.Column then
		left, right = right, left
	end
	for offset = 0, right.Span - 1 do
		self.Cells[Grid.Key(right.Floor, right.Column + offset)] = left.Id
	end
	left.Span += right.Span
	left.HP += right.HP -- HP is per cell: each part keeps what it had
	left.MaxHP = self:MaxHPOf(left.Type, left.Level, left.Span)
	left.HP = math.min(left.HP, left.MaxHP)
	left.Wrecked = (left.Wrecked or right.Wrecked) and left.HP < repairedAt(left.MaxHP)
	self.Rooms[right.Id] = nil
	return left.Id, nil
end

function Bunker.SetLevel(self: Bunker, id: string, level: number): (boolean, string?)
	local room = self.Rooms[id]
	if not room then
		return false, `no room {tostring(id)}`
	elseif level ~= 1 and level ~= 2 and level ~= 3 then
		return false, "levels go from 1 to 3"
	end
	local newMax = self:MaxHPOf(room.Type, level, room.Span)
	room.HP = math.floor(room.HP / room.MaxHP * newMax + 0.5)
	room.MaxHP = newMax
	room.Level = level
	if room.Wrecked and room.HP >= repairedAt(room.MaxHP) then
		room.Wrecked = false
	end
	return true, nil
end

-- Sets a room's HP. At 0 it is Wrecked; a wrecked room works again once repairs bring it back
-- to RepairedAt of its maximum (Prompt 13). Returns the HP it now has.
function Bunker.SetHP(self: Bunker, id: string, hp: number): number?
	local room = self.Rooms[id]
	if not room then
		return nil
	end
	room.HP = math.clamp(math.floor(hp + 0.5), 0, room.MaxHP)
	if room.HP <= 0 then
		room.Wrecked = true
	elseif room.Wrecked and room.HP >= repairedAt(room.MaxHP) then
		room.Wrecked = false
	end
	return room.HP
end

-- The room graph ------------------------------------------------------------------------

-- The graph node a cell belongs to: a room id, "D:<key>" for a Dug cell, nil for Rock.
function Bunker.UnitAt(self: Bunker, floor: number, column: number): string?
	local state, id = self:State(floor, column)
	if state == "Room" then
		return id
	elseif state == "Dug" then
		return DUG_PREFIX .. Grid.Key(floor, column)
	end
	return nil
end

-- The cells of a node, as { floor, column } pairs.
function Bunker.CellsOf(self: Bunker, unit: string): { { number } }
	if string.sub(unit, 1, #DUG_PREFIX) == DUG_PREFIX then
		local floor, column = Grid.Parse(string.sub(unit, #DUG_PREFIX + 1))
		if floor and column and self:State(floor, column) == "Dug" then
			return { { floor, column } }
		end
		return {}
	end
	local room = self.Rooms[unit]
	local cells = {}
	if room then
		for offset = 0, room.Span - 1 do
			table.insert(cells, { room.Floor, room.Column + offset })
		end
	end
	return cells
end

-- Every node: rooms oldest first, then Dug cells by key.
function Bunker.Units(self: Bunker): { string }
	local units = {}
	for _, room in self:AllRooms() do
		table.insert(units, room.Id)
	end
	local dug = {}
	for key, value in self.Cells do
		if value == "" then
			table.insert(dug, DUG_PREFIX .. key)
		end
	end
	table.sort(dug)
	table.move(dug, 1, #dug, #units + 1, units)
	return units
end

function Bunker.Neighbors(self: Bunker, unit: string): { string }
	local found: { [string]: boolean } = {}
	local list = {}
	local function add(other: string?)
		if other and other ~= unit and not found[other] then
			found[other] = true
			table.insert(list, other)
		end
	end
	for _, cell in self:CellsOf(unit) do
		local floor, column = cell[1], cell[2]
		add(self:UnitAt(floor, column - 1))
		add(self:UnitAt(floor, column + 1))
		if self:IsShaft(floor, column) then
			if self:IsShaft(floor - 1, column) then
				add(self:UnitAt(floor - 1, column))
			end
			if self:IsShaft(floor + 1, column) then
				add(self:UnitAt(floor + 1, column))
			end
		end
	end
	table.sort(list)
	return list
end

function Bunker.Graph(self: Bunker): { [string]: { string } }
	local graph = {}
	for _, unit in self:Units() do
		graph[unit] = self:Neighbors(unit)
	end
	return graph
end

-- The shortest way from one open cell to another, cell by cell, as { floor, column } pairs (both
-- ends included): sideways between open cells, up and down between Shaft cells (the same rule as
-- Neighbors). nil when there is none. Prompt 23: The Deluge swims it.
function Bunker.CellPath(self: Bunker, fromFloor: number, fromColumn: number, toFloor: number, toColumn: number): { { number } }?
	if not self:IsOpen(fromFloor, fromColumn) or not self:IsOpen(toFloor, toColumn) then
		return nil
	end
	local start, goal = Grid.Key(fromFloor, fromColumn), Grid.Key(toFloor, toColumn)
	local cameFrom: { [string]: string } = { [start] = start }
	local queue = { { fromFloor, fromColumn } }
	local index = 1
	while index <= #queue and cameFrom[goal] == nil do
		local floor, column = queue[index][1], queue[index][2]
		local here = Grid.Key(floor, column)
		local function visit(f: number, c: number)
			local key = Grid.Key(f, c)
			if cameFrom[key] == nil and self:IsOpen(f, c) then
				cameFrom[key] = here
				table.insert(queue, { f, c })
			end
		end
		visit(floor, column - 1)
		visit(floor, column + 1)
		if self:IsShaft(floor, column) then
			if self:IsShaft(floor - 1, column) then
				visit(floor - 1, column)
			end
			if self:IsShaft(floor + 1, column) then
				visit(floor + 1, column)
			end
		end
		index += 1
	end
	if cameFrom[goal] == nil then
		return nil
	end
	local path = {}
	local key = goal
	while true do
		local floor, column = Grid.Parse(key)
		table.insert(path, 1, { floor :: number, column :: number })
		if key == start then
			break
		end
		key = cameFrom[key]
	end
	return path
end

-- Every node reachable from `from` (including it).
function Bunker.Reachable(self: Bunker, from: string): { [string]: boolean }
	local seen: { [string]: boolean } = { [from] = true }
	local queue = { from }
	local index = 1
	while index <= #queue do
		for _, other in self:Neighbors(queue[index]) do
			if not seen[other] then
				seen[other] = true
				table.insert(queue, other)
			end
		end
		index += 1
	end
	return seen
end

return Bunker
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C0"><Properties><string name="Name">CameraRig</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.CameraRig: the over-the-shoulder camera's geometry (bible Section 9), shared so the
	CameraController and the data tests agree. Pure functions, no instances.

	Angles are radians. Yaw turns about +Y; pitch tilts the view up (+) or down (-). The rig
	looks along its -Z, so at yaw 0 the camera looks toward -Z and its right is +X. `side` is
	1 for the right shoulder and -1 for the left (values between blend a swap).
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

local CameraRig = {}

function CameraRig.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Camera")
end

-- The camera's rotation for a yaw and a pitch.
function CameraRig.Rotation(yaw: number, pitch: number): CFrame
	return CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

function CameraRig.ClampPitch(pitch: number): number
	local t = CameraRig.Tuning()
	return math.clamp(pitch, math.rad(t.PitchMin), math.rad(t.PitchMax))
end

-- The point the camera orbits: beside the pivot (the character's head height), on the
-- camera's side, turned with the yaw only so looking up or down never swings it.
function CameraRig.Focus(pivot: Vector3, yaw: number, side: number, shoulder: number, raise: number): Vector3
	return pivot + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(Vector3.new(side * shoulder, raise, 0))
end

-- Where the camera sits `distance` behind the focus.
function CameraRig.Position(focus: Vector3, yaw: number, pitch: number, distance: number): Vector3
	return focus - CameraRig.Rotation(yaw, pitch).LookVector * distance
end

-- A stick reading after a radial dead zone, with a squared response (0 to 1).
function CameraRig.Stick(input: Vector2, deadzone: number): Vector2
	local size = input.Magnitude
	if size <= deadzone or size == 0 then
		return Vector2.zero
	end
	local scaled = math.min((size - deadzone) / (1 - deadzone), 1)
	return input.Unit * scaled * scaled
end

-- The zoom range: the far end is capped indoors (in a bunker cell) so the camera stays in
-- the room.
function CameraRig.ZoomRange(indoors: boolean): (number, number)
	local t = CameraRig.Tuning()
	return t.Distance.Min, if indoors then math.min(t.Distance.Max, t.IndoorMax) else t.Distance.Max
end

-- The lowest and highest the camera may sit while its subject is in a bunker cell: above the
-- floor and under the ceiling panels. Nil outside the grid.
function CameraRig.CellHeights(pivot: Vector3): (number?, number?)
	local floor, column = Grid.CellAt(pivot)
	if not floor or not column then
		return nil, nil
	end
	local t = CameraRig.Tuning()
	local y = Grid.CellPosition(floor, column).Y
	return y + t.FloorMargin, y + Grid.Tuning().CellHeight - t.CeilingMargin
end

-- The farthest the camera can go back along its view from `focus` and stay between `low` and
-- `high` (it slides in along the view rather than leaving the aim point).
function CameraRig.HeightLimit(focus: Vector3, look: Vector3, low: number, high: number): number
	local limit = math.huge
	if look.Y < -1e-3 then -- looking down: the camera is above the focus
		limit = math.max(0, (high - focus.Y) / -look.Y)
	elseif look.Y > 1e-3 then -- looking up: the camera is below the focus
		limit = math.max(0, (focus.Y - low) / look.Y)
	end
	return limit
end

-- Eases `current` toward `target` at `rate` per second, frame-rate independent.
function CameraRig.Approach(current: number, target: number, rate: number, dt: number): number
	return target + (current - target) * math.exp(-rate * dt)
end

-- Moves `current` toward `target` by at most `step`.
function CameraRig.MoveToward(current: number, target: number, step: number): number
	if current < target then
		return math.min(current + step, target)
	end
	return math.max(current - step, target)
end

return table.freeze(CameraRig)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C1"><Properties><string name="Name">ClassShop</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.ClassShop: the Daily Class Shop, the wishlist and the free trial (bible Section 14).
	Pure, so ClassShopService, the Class Shop screen and the data tests share it. The numbers are
	Tuning.ClassShop; the shop itself is the profile's ClassShop record:

		{ Day, Slots = { class ids }, RerollsUsed, Wishlist?, WishDay?, Trial?, TrialUsed? }

	* "4 classes you don't own, refreshed daily at 00:00 UTC": Day(now) is the shop day; Refresh
	  rolls new slots when the record's day is an older one. A player who owns all but a few
	  classes gets fewer slots.
	* "One free reroll a day (two with VIP), then 99 Robux per reroll": Reroll draws again, away
	  from the classes it replaces where it can. FreeLeft says how many free ones are left today.
	* "A class you wishlist turns up in your shop within 3 days": a wish not seen for WishlistDays
	  shop days is put in the slots (WishDue), and stays through that day's rerolls. Seeing it in
	  the shop, by luck or not, restarts the count, so a wish the player couldn't afford comes back.
	* "Free trial: one run a day with a random class from your shop that you don't own yet": each
	  day's roll picks the trial class among the slots; TrialUsed is set when a run leaves with it.
	* Only today's slots can be bought (CanBuy); owned classes and the trial can be played (CanPlay).
	* Settle puts the profile's loadout back on a class that can be played, after anything that may
	  have taken the trial away (a new day, a reroll that moved it, the trial run leaving).
]]

local Config = require(script.Parent.Parent.Config)

local ClassShop = {}

export type Shop = {
	Day: number,
	Slots: { string },
	RerollsUsed: number,
	Wishlist: string?,
	WishDay: number?,
	Trial: string?,
	TrialUsed: boolean?,
}

local DAY = 86400

local function tuning(): any
	return Config.Get("Tuning", "ClassShop")
end

-- The shop day: whole days since the epoch, counted from the reset hour (00:00 UTC).
function ClassShop.Day(now: number): number
	return math.floor((now - tuning().ResetHourUTC * 3600) / DAY)
end

function ClassShop.SecondsToReset(now: number): number
	local offset = tuning().ResetHourUTC * 3600
	return math.max(0, (ClassShop.Day(now) + 1) * DAY + offset - now)
end

-- The classes this player could still buy, in catalogue order.
function ClassShop.Unowned(owned: { [string]: any }): { string }
	local out = {}
	for _, id in Config.Ids("Classes") do
		local class = Config.Get("Classes", id)
		if class.Price > 0 and not owned[id] then
			table.insert(out, id)
		end
	end
	return out
end

-- The wish has waited long enough: it must be in today's shop.
function ClassShop.WishDue(shop: Shop, owned: { [string]: any }, day: number): boolean
	local wish = shop.Wishlist
	if not wish or owned[wish] or not Config.Find("Classes", wish) then
		return false
	end
	return day - (shop.WishDay or day) >= tuning().WishlistDays
end

--[[
	Up to Slots classes the player doesn't own. `must` (a due wish) is always in; classes in
	`avoid` (the slots a reroll replaces) come back only when there aren't enough others.
]]
function ClassShop.Roll(owned: { [string]: any }, must: string?, avoid: { string }?, rng: Random): { string }
	local slots = tuning().Slots
	local fresh, stale = {}, {}
	for _, id in ClassShop.Unowned(owned) do
		if id ~= must then
			table.insert(if avoid and table.find(avoid, id) then stale else fresh, id)
		end
	end
	local out: { string } = {}
	if must and not owned[must] and Config.Find("Classes", must) then
		table.insert(out, must)
	end
	for _, pool in { fresh, stale } do
		while #out < slots and #pool > 0 do
			table.insert(out, table.remove(pool, rng:NextInteger(1, #pool)) :: string)
		end
	end
	-- show them in catalogue order, so the shop doesn't look shuffled
	local order = Config.Ids("Classes")
	table.sort(out, function(a, b)
		return (table.find(order, a) or 0) < (table.find(order, b) or 0)
	end)
	return out
end

local function pickTrial(shop: Shop, rng: Random)
	shop.Trial = if #shop.Slots > 0 then shop.Slots[rng:NextInteger(1, #shop.Slots)] else nil
end

local function sawWish(shop: Shop, day: number)
	if shop.Wishlist and table.find(shop.Slots, shop.Wishlist) then
		shop.WishDay = day
	end
end

-- A new day's shop when the record is an older day's. True when it changed.
function ClassShop.Refresh(shop: Shop, owned: { [string]: any }, day: number, rng: Random): boolean
	if shop.Day == day then
		return false
	end
	local must = if ClassShop.WishDue(shop, owned, day) then shop.Wishlist else nil
	shop.Slots = ClassShop.Roll(owned, must, nil, rng)
	shop.Day = day
	shop.RerollsUsed = 0
	shop.TrialUsed = nil
	pickTrial(shop, rng)
	sawWish(shop, day)
	return true
end

function ClassShop.FreeRerolls(vip: boolean): number
	local t = tuning()
	return if vip then t.VIPFreeRerolls else t.FreeRerolls
end

function ClassShop.FreeLeft(shop: Shop, vip: boolean): number
	return math.max(0, ClassShop.FreeRerolls(vip) - shop.RerollsUsed)
end

--[[
	Draws today's slots again (the caller has checked it is free or paid for). A wish that was due
	today stays; an unused trial moves to one of the new slots, a used one stays used.
]]
function ClassShop.Reroll(shop: Shop, owned: { [string]: any }, day: number, rng: Random)
	local wish = shop.Wishlist
	local keep = if wish and not owned[wish] and table.find(shop.Slots, wish) and shop.WishDay == day then wish else nil
	shop.Slots = ClassShop.Roll(owned, keep, shop.Slots, rng)
	shop.RerollsUsed += 1
	if not shop.TrialUsed then
		pickTrial(shop, rng)
	end
	sawWish(shop, day)
end

-- Sets or clears the wish. A wish already in today's shop counts as seen today.
function ClassShop.Wish(shop: Shop, owned: { [string]: any }, classId: string?, day: number): (boolean, string?)
	if classId == nil then
		shop.Wishlist, shop.WishDay = nil, nil
		return true, nil
	end
	local class = Config.Find("Classes", classId)
	if not class or class.Price <= 0 then
		return false, "THAT CLASS CAN'T BE WISHED FOR"
	end
	if owned[classId] then
		return false, "YOU OWN THAT CLASS"
	end
	shop.Wishlist, shop.WishDay = classId, day
	return true, nil
end

-- Whether this profile can buy the class now, and why not.
function ClassShop.CanBuy(profile: any, classId: string, day: number): (boolean, string?)
	local class = Config.Find("Classes", classId)
	if not class or class.Price <= 0 then
		return false, "THAT CLASS ISN'T FOR SALE"
	end
	if profile.Classes[classId] then
		return false, "YOU OWN THAT CLASS"
	end
	local shop: Shop = profile.ClassShop
	if shop.Day ~= day or not table.find(shop.Slots, classId) then
		return false, "IT ISN'T IN TODAY'S SHOP: WISHLIST IT"
	end
	if profile.Glowshards < class.Price then
		return false, `{class.Price - profile.Glowshards} MORE GLOWSHARDS NEEDED`
	end
	return true, nil
end

-- Today's free-trial class, while the trial run hasn't left and the class is still not owned.
function ClassShop.Trial(shop: Shop, owned: { [string]: any }, day: number): string?
	local trial = shop.Trial
	if shop.Day ~= day or shop.TrialUsed or not trial or owned[trial] or not table.find(shop.Slots, trial) then
		return nil
	end
	return trial
end

-- Whether the player can take this class into a run: (allowed, as a trial).
function ClassShop.CanPlay(profile: any, classId: string, day: number): (boolean, boolean)
	if not Config.Find("Classes", classId) then
		return false, false
	end
	if profile.Classes[classId] then
		return true, false
	end
	return ClassShop.Trial(profile.ClassShop, profile.Classes, day) == classId, true
end

-- The class a profile brings: its loadout's, if it can still be played; else the Survivor.
function ClassShop.Loadout(profile: any, day: number): (string, boolean)
	local wanted = profile.Loadout and profile.Loadout.Class
	if type(wanted) == "string" then
		local ok, trial = ClassShop.CanPlay(profile, wanted, day)
		if ok then
			return wanted, trial
		end
	end
	return "Survivor", false
end

-- Puts the loadout on a class the profile can play now. True when it had to change.
function ClassShop.Settle(profile: any, day: number): boolean
	local class = ClassShop.Loadout(profile, day)
	if type(profile.Loadout) ~= "table" then
		profile.Loadout = { Class = class }
		return true
	elseif profile.Loadout.Class ~= class then
		profile.Loadout.Class = class
		return true
	end
	return false
end

return table.freeze(ClassShop)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C2"><Properties><string name="Name">Classes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Classes: class abilities and class levels (bible Section 14; Section 9: Q is the class
	ability). Pure, so ClassService, the client and the data tests share it. The numbers are
	Config.Classes (each ability's cooldown, uses, options) and Tuning.Classes (provisional).

	Abilities
	* Ability(classId): the class's Ability row. Options(classId): its option names ({} when it has
	  none). A tap of the ability key uses the selected option; a hold picks the next one.
	* An ability waits on a cooldown in seconds (CooldownSeconds), a cooldown in cycles
	  (CooldownCycles: the Cook's Hearty Meal), or uses that come back each Surge, cycle or era
	  (Uses). UsesFor(classId, level) is how many: the Radio Operator's level 2 makes Supply Call
	  twice an era (SupplyCallsPerEra). The Mad Scientist's gadgets each keep their own cooldown
	  (Config.Classes' note: "40 s each"): OwnCooldowns(classId).
	* Duration(classId, level): how long an ability's effect lasts (Hold the Line, Rally Call,
	  Drone Mode...), times TurretDuration for the Engineer's turret.

	Class levels (Section 14: levels 1 to 3 with experience earned while playing the class, about 3
	runs for level 2 and 10 for level 3; Tuning.ClassShop.ClassLevelRuns)
	* A run with a class earns Tuning.Classes.XPPerYear for each year it reached, paid when the run
	  ends (ResultsService, with the run's Glowshards). A level takes ClassLevelRuns runs of
	  TypicalRunYears years: LevelXP(2) and LevelXP(3). LevelFor(xp) is the level that experience
	  reaches; only owned classes keep experience.
]]

local Config = require(script.Parent.Parent.Config)
local Modifiers = require(script.Parent.Modifiers)

local Classes = {}

export type Ability = {
	Name: string,
	Text: string,
	CooldownSeconds: number?,
	CooldownCycles: number?,
	DurationSeconds: number?,
	Uses: { Per: string, Count: number }?,
	Options: { string }?,
	Modifiers: { any }?,
}

function Classes.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Classes")
end

function Classes.Ability(classId: string?): Ability?
	local class = Config.Find("Classes", classId or "")
	return if class then class.Ability else nil
end

function Classes.Options(classId: string?): { string }
	local ability = Classes.Ability(classId)
	return if ability and ability.Options then ability.Options else {}
end

-- The option at an index, wrapped (1 when the ability has none).
function Classes.OptionIndex(classId: string?, index: number?): number
	local count = #Classes.Options(classId)
	if count == 0 then
		return 1
	end
	local i = math.floor(index or 1)
	return ((i - 1) % count) + 1
end

function Classes.OptionName(classId: string?, index: number?): string?
	local options = Classes.Options(classId)
	if #options == 0 then
		return nil
	end
	return options[Classes.OptionIndex(classId, index)]
end

-- The Mad Scientist's gadgets keep a cooldown each; other options share one.
function Classes.OwnCooldowns(classId: string?): boolean
	return classId ~= nil and Classes.Tuning().OwnCooldownClasses[classId] == true
end

-- Uses each period (nil: the ability waits on a cooldown instead).
function Classes.UsesFor(classId: string?, level: number?): number?
	local ability = Classes.Ability(classId)
	local uses = ability and ability.Uses
	if not uses then
		return nil
	end
	local calls = Modifiers.ClassValue(classId, "SupplyCallsPerEra", level)
	if type(calls) == "number" and calls > uses.Count then
		return calls
	end
	return uses.Count
end

function Classes.UsesPer(classId: string?): string?
	local ability = Classes.Ability(classId)
	return if ability and ability.Uses then ability.Uses.Per else nil
end

-- How long the ability's effect lasts, in seconds (0 when it is instant).
function Classes.Duration(classId: string?, level: number?): number
	local ability = Classes.Ability(classId)
	local seconds = if ability and ability.DurationSeconds then ability.DurationSeconds else 0
	if classId == "Engineer" then
		seconds *= Modifiers.ClassValue(classId, "TurretDuration", level) or 1
	end
	return seconds
end

-- The experience a level needs, in total (level 1: 0).
function Classes.LevelXP(level: number): number
	if level <= 1 then
		return 0
	end
	local t = Classes.Tuning()
	local runs = Config.Get("Tuning", "ClassShop").ClassLevelRuns
	local count = runs[math.clamp(level - 1, 1, #runs)]
	return count * t.TypicalRunYears * t.XPPerYear
end

function Classes.LevelFor(xp: number): number
	local level = 1
	for l = 2, Classes.Tuning().LevelMax do
		if xp >= Classes.LevelXP(l) then
			level = l
		end
	end
	return level
end

-- The experience a run pays for the years it reached (beyond those already paid).
function Classes.RunXP(years: number, paidYears: number?): number
	return math.max(0, math.floor(years) - math.floor(paidYears or 0)) * Classes.Tuning().XPPerYear
end

-- "READY", "12 S", "2 CYCLES": what the HUD shows under the ability.
function Classes.WaitText(seconds: number?, cycles: number?): string
	if cycles and cycles > 0 then
		return if cycles == 1 then "1 CYCLE" else `{cycles} CYCLES`
	end
	if seconds and seconds > 0.05 then
		return `{math.ceil(seconds)} S`
	end
	return "READY"
end

return table.freeze(Classes)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C3"><Properties><string name="Name">Clock</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Clock: the century's arithmetic (bible Section 5). Pure functions over a State
	table, so CycleClock, the client and the data tests share one copy. CycleClock owns the
	timers; these functions only decide numbers and kinds.

	* A cycle is a day phase, then a Surge. At the end of each cycle the year counter jumps by
	  Years per Cycle: Tuning.Clock.YearsPerCycleStart (1) plus the YearsPerCycle of every
	  objective done (Config.Objectives: each Lost Crew rescued +2, each era boss beaten +1),
	  at most Tuning.Clock.YearsPerCycleMax (12).
	* When the counter reaches or passes the last year of era I, II or III (25, 50, 75), the
	  next Surge is that era's boss, unless it is already beaten. The boss Surge comes once.
	* When the counter reaches Tuning.Clock.FinalYear (100) it stops there, and the next
	  Surge is the final one (the Source rises into the bunker).
	* A boss Surge (an era boss, or the final Surge's Source) has no timer: it lasts until
	  its boss is beaten (Landon, Nov 8, 2026). Other Surges end on the timer, or earlier when
	  cleared.
	* The first cycle's Surge is a small tutorial wave.
	* Endless (Keep Going after a victory): no cap, no era bosses, every Surge an Endless one.

	In cycle order:
		local state = Clock.NewState()               -- Cycle 1, Year 1
		local coming = Clock.SurgeKind(state)        -- during the day: what the Surge will be
		local kind, boss = Clock.StartSurge(state)   -- the Surge begins (uses up a due boss)
		local before, due = Clock.EndCycle(state)    -- Year += Years per Cycle, Cycle += 1
]]

local Config = require(script.Parent.Parent.Config)

export type SurgeKind = "Tutorial" | "Normal" | "Boss" | "Final" | "Endless"

export type State = {
	Cycle: number, -- from 1
	Year: number, -- from 1
	Completed: { [string]: boolean }, -- objective ids done (Config.Objectives)
	PendingBoss: string?, -- an era boss due at the next Surge (Config.Bosses)
	Endless: boolean,
}

local Clock = {}

function Clock.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Clock")
end

function Clock.NewState(): State
	return { Cycle = 1, Year = 1, Completed = {}, PendingBoss = nil, Endless = false }
end

-- Years per Cycle when these objectives are done.
function Clock.YearsPerCycle(completed: { [string]: boolean }): number
	local tuning = Clock.Tuning()
	local years = tuning.YearsPerCycleStart
	for id, done in completed do
		local objective = Config.Find("Objectives", id)
		if done and objective then
			years += objective.YearsPerCycle
		end
	end
	return math.min(years, tuning.YearsPerCycleMax)
end

-- Has this era boss been beaten (its objective done)?
function Clock.BossBeaten(completed: { [string]: boolean }, bossId: string): boolean
	for _, objective in Config.All("Objectives") do
		if objective.Kind == "Boss" and objective.Boss == bossId and completed[objective.Id] then
			return true
		end
	end
	return false
end

-- The era a year belongs to; past Year 100 (Endless), the last era.
function Clock.EraOf(year: number): string
	local eras = Config.All("Eras")
	for _, era in eras do
		if year <= era.Years.To then
			return era.Id
		end
	end
	return eras[#eras].Id
end

-- The boss of the final Surge: the boss of the era that ends in the final year.
function Clock.FinalBoss(): string?
	local finalYear = Clock.Tuning().FinalYear
	for _, era in Config.All("Eras") do
		if era.Years.To == finalYear then
			return era.Boss
		end
	end
	return nil
end

-- What the coming Surge is, and its boss (an era boss, or the final boss).
function Clock.SurgeKind(state: State): (SurgeKind, string?)
	local tuning = Clock.Tuning()
	if state.Endless then
		return "Endless", nil
	elseif state.PendingBoss ~= nil then
		return "Boss", state.PendingBoss
	elseif state.Year >= tuning.FinalYear then
		return "Final", Clock.FinalBoss()
	elseif state.Cycle == 1 and tuning.TutorialFirstSurge then
		return "Tutorial", nil
	end
	return "Normal", nil
end

-- Does a Surge of this kind run until its boss is beaten, with no timer?
function Clock.IsOpenEnded(kind: SurgeKind): boolean
	return kind == "Boss" or kind == "Final"
end

-- The Surge begins: its kind and boss. A due era boss is used up (its Surge comes once).
function Clock.StartSurge(state: State): (SurgeKind, string?)
	local kind, boss = Clock.SurgeKind(state)
	if kind == "Boss" then
		state.PendingBoss = nil
	end
	return kind, boss
end

--[[
	The end of a cycle: the year counter jumps by Years per Cycle (stopping at the final year
	outside Endless) and the cycle number goes up. Returns the year before the jump, and the
	era boss that became due because the jump reached or passed the end of its era.
]]
function Clock.EndCycle(state: State): (number, string?)
	local tuning = Clock.Tuning()
	local before = state.Year
	local after = before + Clock.YearsPerCycle(state.Completed)
	if not state.Endless then
		after = math.min(after, tuning.FinalYear)
	end
	state.Year = after
	state.Cycle += 1
	if state.Endless then
		return before, nil
	end
	local due: string? = nil
	for _, era in Config.All("Eras") do
		local last = era.Years.To
		if last < tuning.FinalYear and before < last and after >= last and not Clock.BossBeaten(state.Completed, era.Boss) then
			due = era.Boss
		end
	end
	if due then
		state.PendingBoss = due
	end
	return before, due
end

return table.freeze(Clock)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C4"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Combat: the rules of fighting (bible Section 9, and Section 23's server checks). Pure:
	CombatService and WeaponService run them on the server, CombatController on the client, so
	both sides agree on spread, timing and reach; DataTests hold them to the bible.

	* Items: Gun(itemId) and Melee(itemId) read Config.Items; Damage(itemId, rarity, heavy?)
	  scales by Config.ItemRarities (Standard is 1).
	* Guns: Interval(itemId) between shots (1 / FireRate). ShotSeed(salt, shot) and
	  Spread(seed, direction, itemId) give every pellet's direction, the same on both sides, so a
	  client can't choose its own spread. Reload(magazine, carried, itemId) moves whole shots
	  from the player's carried ammo into the magazine, AmmoPerShot each (Section 9).
	* Hits (Section 23): a claimed hit must sit near the shot's ray, within the gun's range, and
	  near where the target was over the last LagSeconds (PathDistance over its position
	  history). The server checks the line of sight itself.
	* Melee: InArc (reach and arc in front of the attacker); the light combo's next step
	  (ComboSteps hits, each within ComboWindowSeconds of the last); Swing(itemId, heavy) gives
	  the windup (MeleeWindupFraction of the swing, when the hit lands) and the length (a heavy
	  swing takes HeavySwingMultiplier times as long and costs HeavySwingStamina).
	* Cones (the flamethrower's flame, aim assist): InCone, AssistTarget.
	* Stamina(current, max, dt, sprinting, sinceSpent): sprinting drains it; it grows back after
	  StaminaRegenDelay without spending.
	* Nearest(from, places): the closest place (the respawn Medbay).
]]

local Config = require(script.Parent.Parent.Config)

export type Sample = { T: number, P: Vector3 }
export type Place = { Id: string, Position: Vector3 }

local Combat = {}

Combat.UNARMED = "Unarmed"

local function tuning(): { [string]: any }
	return Config.Get("Tuning", "Combat")
end
Combat.Tuning = tuning

-- Items ------------------------------------------------------------------------------------

function Combat.Gun(itemId: string?): { [string]: any }?
	local item = Config.Find("Items", itemId)
	return if item and item.Kind == "Gun" then item.Gun else nil
end

-- A melee weapon's numbers; "Unarmed" is a punch, for kits with no melee weapon.
function Combat.Melee(itemId: string?): { [string]: any }?
	if itemId == Combat.UNARMED then
		return tuning().Unarmed
	end
	local item = Config.Find("Items", itemId)
	return if item and item.Kind == "Melee" then item.Melee else nil
end

function Combat.RarityMultiplier(rarity: string?): number
	local found = Config.Find("ItemRarities", rarity or "Standard")
	return if found then found.DamageMultiplier else 1
end

-- Damage of one hit (one pellet, one flame tick, one swing).
function Combat.Damage(itemId: string, rarity: string?, heavy: boolean?): number
	local gun = Combat.Gun(itemId)
	if gun then
		return gun.Damage * Combat.RarityMultiplier(rarity)
	end
	local melee = Combat.Melee(itemId)
	if melee then
		return (if heavy then melee.HeavyDamage else melee.Damage) * Combat.RarityMultiplier(rarity)
	end
	return 0
end

-- Guns -------------------------------------------------------------------------------------

function Combat.Interval(itemId: string): number
	local gun = Combat.Gun(itemId)
	return if gun and gun.FireRate > 0 then 1 / gun.FireRate else math.huge
end

function Combat.Pellets(itemId: string): number
	local gun = Combat.Gun(itemId)
	return if gun then gun.Pellets or 1 else 0
end

-- A shot's seed from the player's salt (given by the server when the gun is handed out) and the
-- shot's number, so the spread is fixed before the client fires.
function Combat.ShotSeed(salt: number, shot: number): number
	local mixed = bit32.bxor(salt % 2 ^ 31, (shot * 2654435761) % 2 ^ 32)
	return mixed % 2 ^ 31
end

-- A direction turned by `degrees` around an axis at `roll` radians about it.
local function deflect(direction: Vector3, degrees: number, roll: number): Vector3
	if degrees <= 0 then
		return direction
	end
	local d = direction.Unit
	local helper = if math.abs(d.Y) < 0.95 then Vector3.yAxis else Vector3.xAxis
	local right = d:Cross(helper).Unit
	local up = right:Cross(d).Unit
	local axis = right * math.cos(roll) + up * math.sin(roll)
	local angle = math.rad(degrees)
	-- Rodrigues: rotate d about the axis (perpendicular to d)
	return (d * math.cos(angle) + axis:Cross(d) * math.sin(angle)).Unit
end

-- Each pellet's direction: spread evenly over a disc of SpreadDegrees around the aim.
function Combat.Spread(seed: number, direction: Vector3, itemId: string): { Vector3 }
	local gun = Combat.Gun(itemId)
	if not gun then
		return {}
	end
	local rng = Random.new(seed)
	local out = {}
	for _ = 1, gun.Pellets or 1 do
		local degrees = gun.SpreadDegrees * math.sqrt(rng:NextNumber())
		local roll = rng:NextNumber() * 2 * math.pi
		table.insert(out, deflect(direction, degrees, roll))
	end
	return out
end

-- Whole shots loaded from carried ammo: the new magazine and what is left carried.
-- A reload: the magazine filled from carried ammo, AmmoPerShot a shot (times `use`: the
-- Exterminator's FuelUse on a flame gun, Prompt 20; whole ammo, rounded up).
function Combat.Reload(magazine: number, carried: number, itemId: string, use: number?): (number, number)
	local gun = Combat.Gun(itemId)
	if not gun then
		return magazine, carried
	end
	local per = math.max(gun.AmmoPerShot, 1) * math.max(use or 1, 0.01)
	local room = math.max(gun.Magazine - magazine, 0)
	local shots = math.min(room, math.floor(carried / per + 1e-6))
	return magazine + shots, carried - math.min(carried, math.ceil(shots * per - 1e-6))
end

-- Hits -------------------------------------------------------------------------------------

-- How far a point is from a ray (perpendicular), and how far along the ray it is.
function Combat.RayDistance(origin: Vector3, direction: Vector3, point: Vector3): (number, number)
	local d = direction.Unit
	local offset = point - origin
	local along = offset:Dot(d)
	local closest = origin + d * math.max(along, 0)
	return (point - closest).Magnitude, along
end

-- Where a combatant was at time `t`, from its history (oldest first).
function Combat.PositionAt(history: { Sample }, t: number): Vector3?
	local count = #history
	if count == 0 then
		return nil
	end
	if t <= history[1].T then
		return history[1].P
	end
	if t >= history[count].T then
		return history[count].P
	end
	for i = 2, count do
		local b = history[i]
		if b.T >= t then
			local a = history[i - 1]
			local span = b.T - a.T
			local alpha = if span > 0 then (t - a.T) / span else 1
			return a.P:Lerp(b.P, alpha)
		end
	end
	return history[count].P
end

-- The nearest a point came to a combatant between `from` and `to` (its path over that time).
function Combat.PathDistance(history: { Sample }, from: number, to: number, point: Vector3): number
	local best = math.huge
	local start = Combat.PositionAt(history, from)
	if start then
		best = (start - point).Magnitude
	end
	local finish = Combat.PositionAt(history, to)
	if finish then
		best = math.min(best, (finish - point).Magnitude)
	end
	for _, sample in history do
		if sample.T >= from and sample.T <= to then
			best = math.min(best, (sample.P - point).Magnitude)
		end
	end
	return best
end

-- Is a claimed hit believable? `reach` is how far the target's body goes from its centre.
-- Returns false and why when it isn't.
function Combat.CheckHit(
	origin: Vector3,
	direction: Vector3,
	point: Vector3,
	range: number,
	history: { Sample },
	from: number,
	to: number,
	reach: number
): (boolean, string?)
	local t = tuning()
	local off, along = Combat.RayDistance(origin, direction, point)
	if along < -t.RayTolerance then
		return false, "behind the shot"
	elseif along > range + t.RayTolerance then
		return false, "out of range"
	elseif off > t.RayTolerance then
		return false, "off the shot's line"
	end
	if #history > 0 and Combat.PathDistance(history, from, to, point) > reach + t.HitTolerance then
		return false, "not where the target was"
	end
	return true, nil
end

-- Cones and arcs ---------------------------------------------------------------------------

-- Is a point (with a body of `radius`) in a cone of `halfDegrees` around the direction, within
-- `range`?
function Combat.InCone(origin: Vector3, direction: Vector3, point: Vector3, range: number, halfDegrees: number, radius: number?): boolean
	local offset = point - origin
	local distance = offset.Magnitude
	local r = radius or 0
	if distance - r > range then
		return false
	end
	if distance <= r or distance < 1e-6 then
		return true
	end
	local cos = offset.Unit:Dot(direction.Unit)
	local angle = math.deg(math.acos(math.clamp(cos, -1, 1)))
	local widen = math.deg(math.atan2(r, distance)) -- the body's own width
	return angle <= halfDegrees + widen
end

-- Is a point (with a body of `radius`) inside a swing: within reach of the attacker and inside
-- the arc in front of it (judged flat, and no higher or lower than the reach)?
function Combat.InArc(attacker: CFrame, point: Vector3, reach: number, arcDegrees: number, radius: number?): boolean
	local r = radius or 0
	local offset = point - attacker.Position
	if math.abs(offset.Y) > reach + r then
		return false
	end
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local distance = flat.Magnitude
	if distance - r > reach then
		return false
	end
	if distance <= r or distance < 1e-6 then
		return true
	end
	local look = Vector3.new(attacker.LookVector.X, 0, attacker.LookVector.Z)
	if look.Magnitude < 1e-6 then
		return true
	end
	local cos = flat.Unit:Dot(look.Unit)
	local angle = math.deg(math.acos(math.clamp(cos, -1, 1)))
	local widen = math.deg(math.atan2(r, distance))
	return angle <= arcDegrees / 2 + widen
end

-- The target aim assist pulls toward: the one closest to the aim within `maxDegrees`.
-- Returns its index and how far off the aim it is (degrees), or nil.
function Combat.AssistTarget(origin: Vector3, look: Vector3, points: { Vector3 }, maxDegrees: number, range: number): (number?, number)
	local best, bestAngle = nil, math.huge
	for i, point in points do
		local offset = point - origin
		local distance = offset.Magnitude
		if distance > 1e-3 and distance <= range then
			local angle = math.deg(math.acos(math.clamp(offset.Unit:Dot(look.Unit), -1, 1)))
			if angle <= maxDegrees and angle < bestAngle then
				best, bestAngle = i, angle
			end
		end
	end
	return best, bestAngle
end

-- Melee --------------------------------------------------------------------------------------

-- The light combo's next step: the next hit if the last one landed within the window,
-- otherwise the first again.
function Combat.NextCombo(lastStep: number, sinceLast: number): number
	local t = tuning()
	if lastStep >= 1 and lastStep < t.ComboSteps and sinceLast <= t.ComboWindowSeconds then
		return lastStep + 1
	end
	return 1
end

-- A swing's windup (when its hit lands) and its whole length, in seconds.
function Combat.Swing(itemId: string, heavy: boolean?): (number, number)
	local melee = Combat.Melee(itemId)
	if not melee then
		return 0, 0
	end
	local t = tuning()
	local length = melee.SwingSeconds * (if heavy then t.HeavySwingMultiplier else 1)
	return length * t.MeleeWindupFraction, length
end

-- Stamina ------------------------------------------------------------------------------------

-- Stamina after `dt` seconds: sprinting drains SprintStaminaPerSecond; otherwise it grows back
-- at StaminaRegenPerSecond once StaminaRegenDelay has passed since it was last spent.
function Combat.Stamina(current: number, max: number, dt: number, sprinting: boolean, sinceSpent: number): number
	local player = Config.Get("Tuning", "Player")
	if sprinting then
		return math.max(current - player.SprintStaminaPerSecond * dt, 0)
	end
	local t = tuning()
	if sinceSpent < t.StaminaRegenDelay then
		return current
	end
	return math.min(current + player.StaminaRegenPerSecond * dt, max)
end

-- Respawn ------------------------------------------------------------------------------------

function Combat.Nearest(from: Vector3, places: { Place }): Place?
	local best, bestDistance = nil, math.huge
	for _, place in places do
		local distance = (place.Position - from).Magnitude
		if distance < bestDistance or (distance == bestDistance and best and place.Id < best.Id) then
			best, bestDistance = place, distance
		end
	end
	return best
end

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C5"><Properties><string name="Name">CommandView</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.CommandView: the Command View's arithmetic and build-menu rules (bible Section 7),
	pure so the data tests can check them.

	* The view is a far camera with a narrow field of view, so the bunker looks nearly flat.
	  VisibleHeight and DistanceFor convert between the camera's distance and how many studs
	  fit on screen; Lens caps the distance (the lowest graphics level draws about 500 studs)
	  and widens the field of view past it; CellBox is a cell's interior; Bounds and Clamp keep
	  the view over the grid.
	* RoomChoice says whether a room type can be proposed on an open cell, and why not: its
	  unlock (Rules.Construction.Unlock: start, a blueprint draft, a draft or a depth, an era,
	  the first cryo pod), then the placement rules (Rules.Bunker.CanPlace).
	* CostText: "120 SCRAP · 20 IRON", in Config.Resources order (Rules.Construction).
]]

local Config = require(script.Parent.Parent.Config)
local Construction = require(script.Parent.Construction)
local Grid = require(script.Parent.Grid)

export type Bounds = { Left: number, Right: number, Top: number, Bottom: number }
export type Context = {
	Era: number, -- the current era's place in Config.Eras (1 to 4)
	Deepest: number, -- the deepest open floor
	Unlocked: { [string]: boolean }?, -- room types won from drafts or cryo pods
}

local CommandView = {}

function CommandView.Tuning(): { [string]: any }
	return Config.Get("Tuning", "CommandView")
end

function CommandView.VisibleHeight(distance: number, fieldOfView: number): number
	return 2 * distance * math.tan(math.rad(fieldOfView) / 2)
end

function CommandView.DistanceFor(height: number, fieldOfView: number): number
	return height / (2 * math.tan(math.rad(fieldOfView) / 2))
end

-- The camera for a visible height (studs at the cells' plane): the narrow field of view while
-- that fits within MaxDistance, then MaxDistance with a wider field of view. Roblox stops drawing
-- parts about 500 studs away at the lowest graphics level, so a farther camera shows nothing on
-- phones set to low graphics.
function CommandView.Lens(height: number): (number, number)
	local t = CommandView.Tuning()
	local distance = CommandView.DistanceFor(height, t.FieldOfView)
	if distance <= t.MaxDistance then
		return distance, t.FieldOfView
	end
	return t.MaxDistance, 2 * math.deg(math.atan(height / 2 / t.MaxDistance))
end

-- A cell's box in world studs: Grid.CellPosition is the centre of its interior floor, so the
-- interior runs from that floor up to the ceiling (CellHeight).
function CommandView.CellBox(floor: number, column: number, span: number?): (Vector2, Vector2)
	local pitch = Grid.Pitch()
	local first = Grid.CellPosition(floor, column)
	local last = Grid.CellPosition(floor, column + (span or 1) - 1)
	return Vector2.new(first.X - pitch.X / 2, first.Y), Vector2.new(last.X + pitch.X / 2, first.Y + Grid.Tuning().CellHeight)
end

-- The grid's outer edges in world studs: the top floor's ceiling to the slab under the bottom floor.
function CommandView.Bounds(): Bounds
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local topLeft = Grid.CellPosition(t.FloorMin, t.ColumnMin)
	local bottomRight = Grid.CellPosition(t.FloorMax, t.ColumnMax)
	return {
		Left = topLeft.X - pitch.X / 2,
		Right = bottomRight.X + pitch.X / 2,
		Top = topLeft.Y + t.CellHeight,
		Bottom = bottomRight.Y - t.SlabThickness,
	}
end

-- Keeps the view's centre (world X and Y) over the grid.
function CommandView.Clamp(center: Vector2, bounds: Bounds): Vector2
	return Vector2.new(math.clamp(center.X, bounds.Left, bounds.Right), math.clamp(center.Y, bounds.Bottom, bounds.Top))
end

-- Can `roomType` be proposed on an open cell? Its unlock (Rules.Construction.Unlock), then the
-- placement rules (Rules.Bunker.CanPlace). The server checks the same with Construction.Plan.
function CommandView.RoomChoice(bunker: any, roomType: string, floor: number, column: number, context: Context): (boolean, string?)
	local ok, why = Construction.Unlock(roomType, context)
	if not ok then
		return false, why
	end
	return bunker:CanPlace(roomType, floor, column, 1)
end

CommandView.CostText = Construction.CostText

return CommandView
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C6"><Properties><string name="Name">Construction</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Construction: what a construction proposal needs and how long a build takes (bible
	Sections 6 and 8). Pure, so BuildService, the Command View and the data tests share it.

	* Actions:
	  * Build: a room on an open cell, paying its level-1 costs.
	  * Upgrade: the next level's costs for every cell of the room; level 3 also needs Lab
	    research (a threshold the Lab reaches, not spent).
	  * Merge: a room with a matching neighbour (free).
	  * TearDown: a room goes and its cells become open cells (free). Part of what the room cost
	    comes back (Landon, Nov 8, 2026): Tuning.Rooms.TearDownRefund of every level's cost so
	    far, per cell (Refund). Lab research doesn't come back.
	* Unlocks (Section 6), for Build: Start; a blueprint draft; a draft or reaching depth N; an
	  era; the first cryo pod. Rooms won from drafts or cryo pods come in `Context.Unlocked`.
	* Reserved cells: a cell in an open vote or under construction can't be in another
	  proposal.
	* Construction time: BuildSecondsPerCell (20) for each cell. Each helper nearby adds
	  HelperBuildSpeed (25%) to the speed (players now, residents with Prompt 10).
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)
local Hud = require(script.Parent.Hud)

export type Action = "Build" | "Upgrade" | "Merge" | "TearDown"
export type Proposal = {
	Action: Action,
	Floor: number,
	Column: number,
	RoomType: string?, -- Build
	Other: string?, -- Merge: the room it joins
}
export type Context = {
	Era: number, -- the current era's place in Config.Eras (1 to 4)
	Deepest: number, -- the deepest open floor
	Unlocked: { [string]: boolean }?, -- room types won from drafts or cryo pods
	Stock: { [string]: number }?, -- the stockpile; nil skips the cost check
	Research: number?, -- Lab research so far; nil skips the research check
	Reserved: { [string]: boolean }?, -- cell keys in open votes or under construction
	CostMultiplier: number?, -- build and upgrade costs times this (the Quartermaster, Prompt 20)
}
export type Plan = {
	Action: Action,
	Floor: number,
	Column: number,
	Span: number, -- the cells it covers (a merge: both rooms)
	RoomType: string, -- what it builds or changes
	RoomId: string?, -- the room it changes
	Other: string?, -- Merge: the other room
	Level: number?, -- Upgrade: the new level
	Costs: { [string]: number },
	Research: number?, -- Upgrade to level 3: the research it needs
	Refund: { [string]: number }?, -- TearDown: what comes back
	Label: string, -- "KITCHEN", "QUARTERS TO LEVEL 2", "MERGE STORAGE", "TEAR DOWN MEDBAY"
}

local Construction = {}

local function rooms(): { [string]: any }
	return Config.Get("Tuning", "Rooms")
end

local function nameOf(roomType: string): string
	local info = Config.Find("Rooms", roomType)
	return if info then info.Name else roomType
end

function Construction.Seconds(span: number): number
	return rooms().BuildSecondsPerCell * span
end

-- How fast a site builds with `helpers` nearby (1 alone, 1.25 with one helper...).
function Construction.Rate(helpers: number): number
	return 1 + rooms().HelperBuildSpeed * math.max(0, helpers)
end

-- A room type's costs at `level` (1 to 3) for `span` cells (Config.Rooms costs are per cell,
-- like HP and power, so a merged room pays for every cell it upgrades), times `multiplier` (the
-- Quartermaster's BuildCost, Prompt 20; rounded up, never below 1 of anything it costs).
function Construction.CostsAt(roomType: string, level: number, span: number?, multiplier: number?): { [string]: number }
	local costs = {}
	local m = multiplier or 1
	for id, amount in Config.Get("Rooms", roomType).Costs[level] or {} do
		local cost = amount * (span or 1)
		costs[id] = if m ~= 1 and cost > 0 then math.max(1, math.ceil(cost * m - 1e-6)) else cost
	end
	return costs
end

-- What tearing a room down gives back: a share (Tuning.Rooms.TearDownRefund) of every level's
-- cost so far (at today's BuildCost, `multiplier`), per cell, rounded down. Lab research isn't
-- given back.
function Construction.Refund(roomType: string, level: number, span: number, multiplier: number?): { [string]: number }
	local total: { [string]: number } = {}
	for l = 1, level do
		for id, amount in Construction.CostsAt(roomType, l, span, multiplier) do
			total[id] = (total[id] or 0) + amount
		end
	end
	local share = rooms().TearDownRefund
	local refund: { [string]: number } = {}
	for id, amount in total do
		local back = math.floor(amount * share)
		if back > 0 then
			refund[id] = back
		end
	end
	return refund
end

-- Research needed to upgrade a room type to `level`: its Research for level 3, else none.
function Construction.ResearchFor(roomType: string, level: number): number
	if level >= 3 then
		return Config.Get("Rooms", roomType).Research or 0
	end
	return 0
end

-- Can `stock` pay `costs`? If not, the first short resource and how much is missing.
function Construction.CanAfford(costs: { [string]: number }, stock: { [string]: number }): (boolean, string?, number?)
	for _, id in Config.Ids("Resources") do
		local amount = costs[id]
		if amount and amount > 0 and (stock[id] or 0) < amount then
			return false, id, amount - (stock[id] or 0)
		end
	end
	return true, nil, nil
end

-- "120 SCRAP · 20 IRON" in Config.Resources order, or "FREE".
function Construction.CostText(costs: { [string]: number }?): string
	local parts = {}
	for _, id in Config.Ids("Resources") do
		local amount = if costs then costs[id] else nil
		if amount and amount > 0 then
			table.insert(parts, `{amount} {string.upper(Config.Get("Resources", id).Name)}`)
		end
	end
	return if #parts > 0 then table.concat(parts, " · ") else "FREE"
end

-- Is a room type unlocked for building? If not, what unlocks it.
function Construction.Unlock(roomType: string, context: Context): (boolean, string?)
	local unlock = Config.Get("Rooms", roomType).Unlock
	local won = context.Unlocked ~= nil and context.Unlocked[roomType] == true
	if unlock.Kind == "Draft" and not won then
		return false, "Unlock: a blueprint draft"
	elseif unlock.Kind == "DraftOrDepth" and not won and context.Deepest < (unlock.Depth or 10) then
		return false, `Unlock: a blueprint draft, or reach depth {unlock.Depth}`
	elseif unlock.Kind == "Era" and context.Era < (unlock.Era or 1) then
		return false, `Unlock: Era {Hud.Numeral(unlock.Era or 1)}`
	elseif unlock.Kind == "CryoPod" and not won then
		return false, "Unlock: find the first cryo pod"
	end
	return true, nil
end

local function reservedRoom(bunker: any, roomId: string, reserved: { [string]: boolean }?): boolean
	if not reserved then
		return false
	end
	local room = bunker:Room(roomId)
	if room then
		for offset = 0, room.Span - 1 do
			if reserved[Grid.Key(room.Floor, room.Column + offset)] then
				return true
			end
		end
	end
	return false
end

-- Checks a proposal against the bunker and the context. Returns the plan, or nil and why not
-- (a sentence for the player).
function Construction.Plan(bunker: any, proposal: Proposal, context: Context): (Plan?, string?)
	local floor, column = proposal.Floor, proposal.Column
	if not Grid.OnGrid(floor, column) then
		return nil, "That cell is off the grid."
	end
	local plan: Plan
	if proposal.Action == "Build" then
		local roomType = proposal.RoomType
		if not roomType or not Config.Find("Rooms", roomType) then
			return nil, "That isn't a room type."
		end
		local info = Config.Get("Rooms", roomType)
		if info.Fixed then
			return nil, `The {info.Name} comes with the bunker.`
		end
		if context.Reserved and context.Reserved[Grid.Key(floor, column)] then
			return nil, "Something is already proposed or being built there."
		end
		local unlocked, why = Construction.Unlock(roomType, context)
		if not unlocked then
			return nil, `{info.Name}: {why}.`
		end
		local ok, reason = bunker:CanPlace(roomType, floor, column, 1)
		if not ok then
			return nil, `Can't build a {info.Name} there: {reason}.`
		end
		plan = {
			Action = "Build", Floor = floor, Column = column, Span = 1, RoomType = roomType,
			Costs = Construction.CostsAt(roomType, 1, 1, context.CostMultiplier), Label = string.upper(info.Name),
		}
	else
		local room = bunker:RoomAt(floor, column)
		if not room then
			return nil, "There's no room there."
		end
		if reservedRoom(bunker, room.Id, context.Reserved) then
			return nil, `The {nameOf(room.Type)} already has a proposal open.`
		end
		local name = nameOf(room.Type)
		if proposal.Action == "Upgrade" then
			if room.Level >= 3 then
				return nil, `The {name} is at level 3 already.`
			end
			local level = room.Level + 1
			plan = {
				Action = "Upgrade", Floor = room.Floor, Column = room.Column, Span = room.Span, RoomType = room.Type,
				RoomId = room.Id, Level = level, Costs = Construction.CostsAt(room.Type, level, room.Span, context.CostMultiplier),
				Research = Construction.ResearchFor(room.Type, level), Label = `{string.upper(name)} TO LEVEL {level}`,
			}
			local needs = plan.Research or 0
			if needs > 0 and context.Research ~= nil and context.Research < needs then
				return nil, `Level 3 needs {needs} Lab research ({math.floor(context.Research)} so far).`
			end
		elseif proposal.Action == "Merge" then
			local other = if proposal.Other then bunker:Room(proposal.Other) else nil
			if not other then
				return nil, "There's no room to merge with."
			end
			if reservedRoom(bunker, other.Id, context.Reserved) then
				return nil, `The other {nameOf(other.Type)} already has a proposal open.`
			end
			local ok, why = bunker:CanMerge(room.Id, other.Id)
			if not ok then
				return nil, `Can't merge: {why}.`
			end
			plan = {
				Action = "Merge", Floor = room.Floor, Column = math.min(room.Column, other.Column),
				Span = room.Span + other.Span, RoomType = room.Type, RoomId = room.Id, Other = other.Id,
				Costs = {}, Label = `MERGE {string.upper(name)}`,
			}
		elseif proposal.Action == "TearDown" then
			local ok, why = bunker:CanRemove(room.Id)
			if not ok then
				return nil, `Can't tear down the {name}: {why}.`
			end
			plan = {
				Action = "TearDown", Floor = room.Floor, Column = room.Column, Span = room.Span, RoomType = room.Type,
				RoomId = room.Id, Costs = {}, Refund = Construction.Refund(room.Type, room.Level, room.Span, context.CostMultiplier),
				Label = `TEAR DOWN {string.upper(name)}`,
			}
		else
			return nil, "That isn't something to propose."
		end
	end
	if context.Stock then
		local ok, short, missing = Construction.CanAfford(plan.Costs, context.Stock)
		if not ok and short then
			return nil, `The stockpile is {missing} {Config.Get("Resources", short).Name} short.`
		end
	end
	return plan, nil
end

-- The cells a plan covers, as keys.
function Construction.Cells(plan: Plan): { string }
	local keys = {}
	for offset = 0, plan.Span - 1 do
		table.insert(keys, Grid.Key(plan.Floor, plan.Column + offset))
	end
	return keys
end

return Construction
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C7"><Properties><string name="Name">Cutscene</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Cutscene: the intro cutscene's arithmetic (bible Section 4), pure so the data tests can
	check it and so the whole cutscene is a function of one number: the seconds since it began.
	The client's CutsceneController asks these every frame, which is what lets a player who arrives
	late join it at the right moment, and a dev command stop it at any moment for a capture.

	The data is Config.CutscenePaths (the camera's keys, the set and the beats, made in Blender)
	and Config.Cutscenes (the words and the looks).

	* Elapsed, CanSkip: where the cutscene is from the run's clock, and who may skip (an account's
	  first run plays it in full; after that, after IntroSkipAfterSeconds).
	* ShotAt, CameraAt: the shot playing at t and the camera in that shot's own space, with smooth
	  interpolation between the keys (Catmull-Rom on the position, the shortest turn on the
	  rotation). Shots never blend into each other: a new shot is a cut.
	* PathLength, PathAt, Runner: the line the party and the founders sprint and where one of them
	  is at t.
	* Beat, Progress, Smooth and the named moves built on them: DoorShut, Bomb, WaveRadius,
	  WaveArrival, CloudAt, EyesOpen.
]]

export type Shot = {
	Name: string,
	From: number,
	To: number,
	Space: string,
	Rate: number,
	Handover: boolean,
	Text: string,
	Keys: { { number } },
}
export type Runner = { Delay: number, Side: number }
export type Path = {
	Seconds: number,
	Shots: { Shot },
	Set: { any },
	Ground: { any },
	RunPath: { { number } },
	Runners: { Runner },
	RunSpeed: number,
	Anchors: { [string]: { number } },
	Beats: { [string]: number },
	WaveReach: number,
	Cloud: { StemRadius: number, CapRadius: number, Top: number },
}
export type Cloud = { Rise: number, Top: number, CapRadius: number, StemRadius: number }

local Cutscene = {}

Cutscene.SPREAD_STUDS = 60 -- the pack starts scattered and has closed up after this far
Cutscene.SPREAD = 1.6 -- how much wider than their files they stand at the start

-- Seconds into a cutscene `seconds` long with `timeLeft` to go (RunState.TimeLeft in the Intro phase).
function Cutscene.Elapsed(seconds: number, timeLeft: number): number
	return math.clamp(seconds - timeLeft, 0, seconds)
end

-- Bible Section 4: "An account's first run plays it in full. After that, each player can skip it
-- after 2 seconds."
function Cutscene.CanSkip(firstRun: boolean, elapsed: number, skipAfter: number): boolean
	return not firstRun and elapsed >= skipAfter
end

function Cutscene.Smooth(x: number): number
	local c = math.clamp(x, 0, 1)
	return c * c * (3 - 2 * c)
end

function Cutscene.Beat(path: Path, name: string): number
	local at = path.Beats[name]
	assert(at ~= nil, `no beat named {name}`)
	return at
end

-- How far t is between two beats, from 0 to 1.
function Cutscene.Progress(path: Path, from: string, to: string, t: number): number
	local a, b = Cutscene.Beat(path, from), Cutscene.Beat(path, to)
	if b <= a then
		return if t >= b then 1 else 0
	end
	return math.clamp((t - a) / (b - a), 0, 1)
end

-- The camera ---------------------------------------------------------------------------------

-- The shot playing at t, and its place in the list. Past the end it is the last one.
function Cutscene.ShotAt(path: Path, t: number): (Shot, number)
	local shots = path.Shots
	for i, shot in shots do
		if t < shot.To then
			return shot, i
		end
	end
	return shots[#shots], #shots
end

local function keyCFrame(key: { number }): CFrame
	return CFrame.new(key[1], key[2], key[3], key[4], key[5], key[6], key[7])
end

local function catmull(p0: Vector3, p1: Vector3, p2: Vector3, p3: Vector3, f: number): Vector3
	local f2, f3 = f * f, f * f * f
	return 0.5 * ((2 * p1) + (p2 - p0) * f + (2 * p0 - 5 * p1 + 4 * p2 - p3) * f2 + (3 * p1 - p0 - 3 * p2 + p3) * f3)
end

-- The camera at t in one shot: its CFrame in the shot's own space and its field of view.
function Cutscene.ShotCamera(shot: Shot, t: number): (CFrame, number)
	local keys = shot.Keys
	local count = #keys
	local u = math.clamp((t - shot.From) * shot.Rate, 0, count - 1)
	local i = math.min(math.floor(u), count - 2)
	local f = u - i
	local k0, k1, k2, k3 = keys[math.max(i, 1)], keys[i + 1], keys[i + 2], keys[math.min(i + 3, count)]
	local position = catmull(
		Vector3.new(k0[1], k0[2], k0[3]),
		Vector3.new(k1[1], k1[2], k1[3]),
		Vector3.new(k2[1], k2[2], k2[3]),
		Vector3.new(k3[1], k3[2], k3[3]),
		f
	)
	local rotation = keyCFrame(k1).Rotation:Lerp(keyCFrame(k2).Rotation, f)
	return CFrame.new(position) * rotation, k1[8] + (k2[8] - k1[8]) * f
end

-- The camera at t: its CFrame in the shot's space, its field of view, and the shot.
function Cutscene.CameraAt(path: Path, t: number): (CFrame, number, Shot)
	local shot = Cutscene.ShotAt(path, t)
	local cframe, fieldOfView = Cutscene.ShotCamera(shot, t)
	return cframe, fieldOfView, shot
end

-- The runners --------------------------------------------------------------------------------

local function point(p: { number }): Vector3
	return Vector3.new(p[1], p[2], p[3])
end

function Cutscene.PathLength(points: { { number } }): number
	local length = 0
	for i = 2, #points do
		length += (point(points[i]) - point(points[i - 1])).Magnitude
	end
	return length
end

-- The point `distance` studs along the line and the way the line heads there.
function Cutscene.PathAt(points: { { number } }, distance: number): (Vector3, Vector3)
	local left = math.max(distance, 0)
	local count = #points
	for i = 2, count do
		local a, b = point(points[i - 1]), point(points[i])
		local span = (b - a).Magnitude
		if left <= span or i == count then
			local direction = if span > 0 then (b - a) / span else Vector3.xAxis
			return a + direction * math.min(left, span), direction
		end
		left -= span
	end
	return point(points[count]), Vector3.xAxis
end

-- Runner `index` at t: where its feet are (set space), the way it heads, how far it has run, and
-- whether it has gone inside (the end of the line, in the hall behind the door).
function Cutscene.Runner(path: Path, index: number, t: number): (Vector3, Vector3, number, boolean)
	local runner = path.Runners[index]
	assert(runner, `no runner {index}`)
	local length = Cutscene.PathLength(path.RunPath)
	local run = math.clamp((t - Cutscene.Beat(path, "RunStart") - runner.Delay) * path.RunSpeed, 0, length)
	local position, direction = Cutscene.PathAt(path.RunPath, run)
	local flat = Vector3.new(direction.X, 0, direction.Z)
	local heading = if flat.Magnitude > 0.001 then flat.Unit else Vector3.xAxis
	local right = heading:Cross(Vector3.yAxis)
	local spread = 1 + Cutscene.SPREAD * math.max(0, 1 - run / Cutscene.SPREAD_STUDS)
	return position + right * runner.Side * spread, direction, run, run >= length - 1
end

-- The named moves -----------------------------------------------------------------------------

-- The blast door: 0 standing open, 1 shut.
function Cutscene.DoorShut(path: Path, t: number): number
	return Cutscene.Smooth(Cutscene.Progress(path, "DoorFrom", "DoorTo", t))
end

-- The bomb in flight: where it is (set space) and the way it flies; nil before and after.
function Cutscene.Bomb(path: Path, t: number): (Vector3?, Vector3)
	local from, to = point(path.Anchors.BombFrom), point(path.Anchors.BombTo)
	local direction = (to - from).Unit
	if t < Cutscene.Beat(path, "BombFrom") or t >= Cutscene.Beat(path, "BombTo") then
		return nil, direction
	end
	return from:Lerp(to, Cutscene.Progress(path, "BombFrom", "BombTo", t)), direction
end

-- The shockwave's ring: how far from the blast it has spread; nil before it starts.
function Cutscene.WaveRadius(path: Path, t: number): number?
	if t < Cutscene.Beat(path, "WaveFrom") then
		return nil
	end
	return path.WaveReach * (t - Cutscene.Beat(path, "WaveFrom")) / (Cutscene.Beat(path, "WaveTo") - Cutscene.Beat(path, "WaveFrom"))
end

-- The second the ring reaches something `distance` studs from the blast.
function Cutscene.WaveArrival(path: Path, distance: number): number
	local from, to = Cutscene.Beat(path, "WaveFrom"), Cutscene.Beat(path, "WaveTo")
	return from + (to - from) * distance / path.WaveReach
end

-- The mushroom cloud: Rise 0 to 1, its top's height, its cap's and stem's radius.
function Cutscene.CloudAt(path: Path, t: number): Cloud
	local rise = Cutscene.Progress(path, "CloudFrom", "CloudTo", t)
	local eased = 1 - (1 - rise) * (1 - rise) -- fast at first, slowing as it climbs
	return {
		Rise = rise,
		Top = path.Cloud.Top * (0.22 + 0.78 * eased),
		CapRadius = path.Cloud.CapRadius * (0.34 + 0.66 * eased),
		StemRadius = path.Cloud.StemRadius * (0.75 + 0.35 * eased),
	}
end

-- The Source's eyes: 0 shut, 1 open.
function Cutscene.EyesOpen(path: Path, t: number): number
	return Cutscene.Smooth(Cutscene.Progress(path, "EyesFrom", "EyesTo", t))
end

return Cutscene
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C8"><Properties><string name="Name">Deep</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Deep: the Deep's arithmetic (bible Sections 6, 12 and 14; Prompt 17). Pure, so the data
	tests, the server and the client share it. The numbers are Tuning.Deep (provisional), the pieces
	Config.CavePieces (made with the A6 art).

	* Caves (Section 12: "When a dug cell breaks into a cave, a cave area opens behind it. Caves are
	  put together from hand-made pieces for that band, so no two runs match"): a cave grows from its
	  mouth, the dug cell's back wall (MouthCFrame), into the rock behind the grid (-Z). Plan places
	  the band's Entry there, then grows piece by piece from open exits (PieceAt: a piece's pivot sits
	  on the exit, facing on), never into the grid, below LowestY or into another piece (Overlaps,
	  with the boxes of every cave already open; a piece shares RIM studs of wall with the one it
	  hangs off), until it has its pieces; exits left over are plugged with rubble. A cave with a
	  Lost Crew ends in its band's CrewPocket. When another cave already fills the rock behind the
	  cell there is no mouth at all (an empty plan).
	* Finds (Section 12: ore veins, caches, radio logs, cryo pods, trapped miners, Glowshard chests):
	  RollFind picks what a Find spot holds (cryo pods from Era II; the Spelunker's FindChance makes
	  cryo pods and caches likelier).
	* Lost Crews (Section 12: one in each band of the Deep, their spots change each run): CrewCell
	  picks the rock cell whose cave holds a band's crew, CrewMinDepth cells from anything open.
	* Hints (Section 12: radio logs hint where each crew is): Hint(floor, column) in words.
	* Guards (Section 12: monsters, each crew guarded by a nest below): Roster(band, usable) is the
	  band's own monsters (Where), or the Mines' until the band's have their models (A8).
	* Drops and darkness (Section 12): FallDamage(drop, immune) past FallDamageFrom studs (the
	  Spelunker's NoFallDamage), LightRange(multiplier) for a player's own light (LightRadius).

		Deep.Plan("Mines", Deep.MouthCFrame(3, 4), Random.new(7), {}, { Crew = true })
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

local Deep = {}

-- A piece's box takes in its walls, 4 studs past its openings (A6: generators/Caves/cavelib.py's
-- box_of), so a piece and the one at its exit share that much wall: the planner lets them.
local RIM = 4

export type Box = { Min: Vector3, Max: Vector3 }
export type Placement = { Piece: string, CFrame: CFrame, Depth: number, Box: Box, Parent: Box? } -- Parent: the piece it hangs off
export type Plan = { Pieces: { Placement }, Plugs: { CFrame }, Crew: boolean }

function Deep.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Deep")
end

-- The band a floor's caves belong to (DepthBands id).
function Deep.Band(floor: number): string
	return Grid.BandOf(floor).Id
end

-- Where a cell's cave starts: the floor centre of its back wall's inner face, facing into the rock.
function Deep.MouthCFrame(floor: number, column: number): CFrame
	local cell = Grid.CellPosition(floor, column)
	local depth = Grid.Tuning().CellDepth
	return CFrame.new(cell.X, cell.Y, cell.Z - depth / 2)
end

-- A cave's way out into the bunker: a spot in the dug cell in front of its mouth (monsters and
-- followers walk there, then the bunker's paths take over).
function Deep.MouthPoint(floor: number, column: number): Vector3
	local cell = Grid.CellPosition(floor, column)
	return cell + Vector3.new(0, 0.5, -6)
end

local function vec(t: { number }): Vector3
	return Vector3.new(t[1], t[2], t[3])
end

-- An exit's frame in the world: on its opening's floor, looking out of the piece.
function Deep.ExitCFrame(pieceCFrame: CFrame, exit: { P: { number }, Yaw: number }): CFrame
	return pieceCFrame * CFrame.new(vec(exit.P)) * CFrame.Angles(0, math.rad(exit.Yaw), 0)
end

-- The piece that comes next at an exit: its pivot on the exit, its -Z going on the same way.
function Deep.PieceAt(exitCFrame: CFrame): CFrame
	return exitCFrame
end

-- A piece's box in the world (its turns are quarter turns, so the box stays tight).
function Deep.WorldBox(pieceCFrame: CFrame, box: { Min: { number }, Max: { number } }): Box
	local lo, hi = vec(box.Min), vec(box.Max)
	local min = Vector3.new(math.huge, math.huge, math.huge)
	local max = Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, x in { lo.X, hi.X } do
		for _, y in { lo.Y, hi.Y } do
			for _, z in { lo.Z, hi.Z } do
				local p = pieceCFrame * Vector3.new(x, y, z)
				min = min:Min(p)
				max = max:Max(p)
			end
		end
	end
	return { Min = min, Max = max }
end

-- Two boxes overlap by more than margin on every axis.
function Deep.Overlaps(a: Box, b: Box, margin: number): boolean
	return a.Min.X < b.Max.X - margin and b.Min.X < a.Max.X - margin
		and a.Min.Y < b.Max.Y - margin and b.Min.Y < a.Max.Y - margin
		and a.Min.Z < b.Max.Z - margin and b.Min.Z < a.Max.Z - margin
end

function Deep.Inside(box: Box, position: Vector3): boolean
	return position.X >= box.Min.X and position.X <= box.Max.X and position.Y >= box.Min.Y and position.Y <= box.Max.Y
		and position.Z >= box.Min.Z and position.Z <= box.Max.Z
end

-- The band's pieces of a kind ("Entry", "CrewPocket"), or the planner's own (Weight > 0).
function Deep.Pieces(band: string, kind: string?): { any }
	local list = {}
	for _, piece in Config.All("CavePieces") do
		if piece.Band == band and (if kind then piece.Kind == kind else piece.Weight > 0) then
			table.insert(list, piece)
		end
	end
	table.sort(list, function(a, b)
		return a.Id < b.Id
	end)
	return list
end

local function pick(list: { any }, rng: Random): any?
	local total = 0
	for _, piece in list do
		total += piece.Weight
	end
	if total <= 0 then
		return list[1]
	end
	local roll = rng:NextNumber() * total
	for _, piece in list do
		roll -= piece.Weight
		if roll <= 0 then
			return piece
		end
	end
	return list[#list]
end

-- Can a piece stand here: behind the grid, above the lowest floor, clear of every other piece
-- (but for the wall it shares with the piece whose exit it hangs off, `parent`)?
local function fits(box: Box, occupied: { Box }, t: { [string]: any }, parent: Box?): boolean
	if box.Max.Z > t.GridBack or box.Min.Y < t.LowestY then
		return false
	end
	for _, other in occupied do
		if Deep.Overlaps(box, other, if other == parent then t.Margin + RIM else t.Margin) then
			return false
		end
	end
	return true
end

--[[
	Grow a cave. occupied: the boxes of every piece already in the Deep (this cave's are added).
	options.Crew: end in the CrewPocket. options.Pieces: how many pieces after the mouth (default:
	a roll in CavePieces). Returns the placements (the Entry first), the exits plugged with rubble,
	and whether the CrewPocket found a place.
]]
function Deep.Plan(band: string, mouth: CFrame, rng: Random, occupied: { Box }, options: { Crew: boolean?, Pieces: number? }?): Plan
	local t = Deep.Tuning()
	local o = options or {}
	local placed: { Placement } = {}
	local plugs: { CFrame } = {}
	local entry = Deep.Pieces(band, "Entry")[1]
	if not entry then
		return { Pieces = placed, Plugs = plugs, Crew = false }
	end
	local entryBox = Deep.WorldBox(mouth, entry.Box)
	for _, other in occupied do
		if Deep.Overlaps(entryBox, other, t.Margin + RIM) then
			-- another cave already fills the rock behind this cell: no room for a mouth
			return { Pieces = placed, Plugs = plugs, Crew = false }
		end
	end
	table.insert(placed, { Piece = entry.Id, CFrame = mouth, Depth = 0, Box = entryBox })
	table.insert(occupied, entryBox)
	local open: { { CFrame: CFrame, Depth: number, Parent: Box } } = {}
	for _, exit in entry.Exits do
		table.insert(open, { CFrame = Deep.ExitCFrame(mouth, exit), Depth = 1, Parent = entryBox })
	end
	local target = o.Pieces or rng:NextInteger(t.CavePieces.Min, t.CavePieces.Max)
	local crewPiece = if o.Crew then Deep.Pieces(band, "CrewPocket")[1] else nil
	local crewPlaced = false
	local pieces = Deep.Pieces(band)
	local deadEnds, through = {}, {}
	for _, piece in pieces do
		table.insert(if #piece.Exits == 0 then deadEnds else through, piece)
	end
	local count = 0
	while #open > 0 do
		local slot = table.remove(open, 1) :: { CFrame: CFrame, Depth: number, Parent: Box }
		local at = Deep.PieceAt(slot.CFrame)
		local left = target - count
		local lastWay = #open == 0 -- the only way on: a dead end here ends the cave
		local candidates: { any } = {}
		if crewPiece and not crewPlaced and left <= 1 + #open then
			table.insert(candidates, crewPiece) -- near the end: the crew's pocket first
		end
		if left > 0 then
			-- with as many exits waiting as pieces left, close them off with dead ends; on the last way
			-- on with more to come, keep going
			local pool = if left <= #open then deadEnds elseif lastWay and left > 1 then through else pieces
			for _ = 1, t.PlannerTries do
				local choice = pick(pool, rng)
				if choice and not table.find(candidates, choice) then
					table.insert(candidates, choice)
				end
			end
		end
		if crewPiece and not crewPlaced and lastWay and not table.find(candidates, crewPiece) then
			table.insert(candidates, crewPiece) -- nothing else fits on the last way on: the crew here
		end
		local done = false
		for _, piece in candidates do
			local box = Deep.WorldBox(at, piece.Box)
			if fits(box, occupied, t, slot.Parent) then
				table.insert(placed, { Piece = piece.Id, CFrame = at, Depth = slot.Depth, Box = box, Parent = slot.Parent })
				table.insert(occupied, box)
				count += 1
				if piece == crewPiece then
					crewPlaced = true
				end
				for _, exit in piece.Exits do
					table.insert(open, { CFrame = Deep.ExitCFrame(at, exit), Depth = slot.Depth + 1, Parent = box })
				end
				done = true
				break
			end
		end
		if not done then
			table.insert(plugs, slot.CFrame)
		end
	end
	if crewPiece and not crewPlaced then
		-- no room met it on the way: swap the deepest dead end for it, if it fits there
		for i = #placed, 2, -1 do
			local p = placed[i]
			local piece = Config.Get("CavePieces", p.Piece)
			if #piece.Exits == 0 then
				local box = Deep.WorldBox(p.CFrame, crewPiece.Box)
				local index = table.find(occupied, p.Box)
				if index then
					table.remove(occupied, index)
				end
				if fits(box, occupied, t, p.Parent) then
					placed[i] = { Piece = crewPiece.Id, CFrame = p.CFrame, Depth = p.Depth, Box = box, Parent = p.Parent }
					table.insert(occupied, box)
					crewPlaced = true
					break
				end
				table.insert(occupied, p.Box)
			end
		end
	end
	return { Pieces = placed, Plugs = plugs, Crew = crewPlaced }
end

-- What a Find spot holds: a FindOdds key ("Nothing" too). Cryo pods from their DigResults era;
-- findChance (the Spelunker's FindChance) scales cryo pods and caches.
function Deep.RollFind(roll: number, era: number, findChance: number?): string
	local t = Deep.Tuning()
	local scale = findChance or 1
	local cryoEra = Config.Get("DigResults", "CryoPod").MinEra or 2
	local weights: { [string]: number } = {}
	local total = 0
	local order = { "OreVein", "Cache", "RadioLog", "TrappedMiner", "CryoPod", "GlowshardChest", "Nothing" }
	for _, id in order do
		local w = t.FindOdds[id] or 0
		if id == "CryoPod" and era < cryoEra then
			w = 0
		elseif id == "CryoPod" or id == "Cache" then
			w *= scale
		end
		weights[id] = w
		total += w
	end
	local pickAt = roll * total
	for _, id in order do
		pickAt -= weights[id]
		if pickAt <= 0 and weights[id] > 0 then
			return id
		end
	end
	return "Nothing"
end

-- A cryo pod thaws into a Rare or a Legendary resident (Section 6).
function Deep.CryoTier(roll: number): string
	return if roll < Deep.Tuning().LegendaryChance then "Legendary" else "Rare"
end

--[[
	The rock cell whose cave holds a band's Lost Crew: a Rock cell on the band's CrewFloors, at
	least CrewMinDepth cells from anything open (so it takes some digging), chosen by the seed.
	isOpen(floor, column) says whether a cell is open now.
]]
function Deep.CrewCell(seed: number, band: string, isOpen: (number, number) -> boolean): (number?, number?)
	local t = Deep.Tuning()
	local floors = t.CrewFloors[band]
	if not floors then
		return nil, nil
	end
	local g = Grid.Tuning()
	local candidates: { { number } } = {}
	for floor = floors.Min, floors.Max do
		for column = g.ColumnMin, g.ColumnMax do
			if not isOpen(floor, column) then
				local near = false
				for df = -t.CrewMinDepth + 1, t.CrewMinDepth - 1 do
					for dc = -t.CrewMinDepth + 1, t.CrewMinDepth - 1 do
						if math.abs(df) + math.abs(dc) < t.CrewMinDepth and isOpen(floor + df, column + dc) then
							near = true
						end
					end
				end
				if not near then
					table.insert(candidates, { floor, column })
				end
			end
		end
	end
	if #candidates == 0 then
		return nil, nil
	end
	local rng = Random.new(seed + #band * 7919)
	local choice = candidates[rng:NextInteger(1, #candidates)]
	return choice[1], choice[2]
end

-- Where a crew was last heard from, in words ("the Mines, floor 3, two cells west of the shaft").
local COUNT = { "one cell", "two cells", "three cells", "four cells", "five cells", "six cells" }
function Deep.Hint(floor: number, column: number): string
	local band = Grid.BandOf(floor)
	local n = math.abs(column)
	local cells = COUNT[n] or `{n} cells`
	local side = if column < 0 then `{cells} west of the shaft` elseif column > 0 then `{cells} east of the shaft` else "under the shaft"
	return `the {band.Name}, floor {floor}, {side}`
end

-- Damage from a fall of `drop` studs (0 below FallDamageFrom, or for the immune).
function Deep.FallDamage(drop: number, immune: boolean?): number
	local t = Deep.Tuning()
	if immune or drop <= t.FallDamageFrom then
		return 0
	end
	return math.min(math.floor((drop - t.FallDamageFrom) * t.FallDamagePerStud + 0.5), t.FallDamageMax)
end

-- A player's own light in the Deep (studs); multiplier is LightRadius (the Spelunker's 2).
function Deep.LightRange(multiplier: number?): number
	return Deep.Tuning().LightRange * math.max(multiplier or 1, 0)
end

-- Section 12: "radiation in the Crystal Hollows". How fast a player's radiation climbs in a cave of
-- this band (0 in the others), before their class's RadiationGain.
function Deep.CaveRadiation(band: string): number
	return Deep.Tuning().CaveRadiationPerSecond[band] or 0
end


-- The monsters that guard a band's caves: its own (Config.Monsters Where), those `usable` says can
-- come out now (their model is in); the Mines' when none of the band's can. Sorted.
function Deep.Roster(band: string, usable: (string) -> boolean): { string }
	local function of(b: string): { string }
		local list = {}
		for _, monster in Config.All("Monsters") do
			if table.find(monster.Where, b) and usable(monster.Id) then
				table.insert(list, monster.Id)
			end
		end
		table.sort(list)
		return list
	end
	local list = of(band)
	if #list == 0 and band ~= "Mines" then
		list = of("Mines")
	end
	return list
end

return Deep
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000C9"><Properties><string name="Name">Dig</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Dig: digging, the dug cell's roll, Push Deeper and Disturbance as arithmetic (bible
	Sections 6 and 10). Pure, so DigService, the Command View, the HUD and the data tests agree.
	The numbers are Tuning.Digging, Tuning.Disturbance, Config.DepthBands (dig seconds per band)
	and Config.DigResults (the roll); provisional ones are marked there.

	* Digging (Section 6): a Rock cell left of, right of or below an open cell can be dug
	  (Rules.Bunker.CanDig) from that cell: Faces. Players hold Interact with a Drill or a
	  Pickaxe (CanDigWith); a cell takes its band's DigSeconds; the Driller digs twice as fast
	  (DigSpeed) and players on one cell stack (Rate). A Drill Bay digs its queue at
	  ResidentDigMultiplier of a player for each unit of its crew's output (DrillBaySpeed).
	* Push Deeper (Section 6): the first cell of a new band (floors 4, 7 and 10) needs a vote.
	  Cells down to Limit can be dug without one: the last floor of the Mines at the start, the
	  last floor of each band the team has voted into after that (LimitAfter).
	* The roll (Section 6: rolled when it opens): Roll is the same for a cell every time in one
	  run (seeded by the run and the cell), so the Driller can see ore and caves before they are
	  dug (Hint). Results whose systems aren't built yet, and those of a later era, count as
	  Empty, so the others keep the bible's odds. A few cells hold a fixed result this run
	  (overrides, Prompt 17: the Lost Crews' caves); RunState.DigOverrides carries them
	  (EncodeOverrides), so the Driller's hints match.
	* Disturbance (Section 10): 0 to Max; Add clamps; Crossed says whether a change set off the
	  extra breach (crossing ExtraBreachAt upward) or a Tremor (reaching TremorAt, after which it
	  drops to AfterTremor). Level names the reading for the seismograph.
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

local Dig = {}

export type Face = { Side: "Left" | "Right" | "Above", Floor: number, Column: number } -- the open cell it's dug from
export type Overrides = { [string]: string } -- "<floor>,<column>" -> a DigResults id

function Dig.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Digging")
end

function Dig.DisturbanceTuning(): { [string]: any }
	return Config.Get("Tuning", "Disturbance")
end

-- Digging ------------------------------------------------------------------------------------

-- Seconds for one player to dig a cell on this floor (Config.DepthBands).
function Dig.Seconds(floor: number): number
	return Grid.BandOf(floor).DigSeconds or 45
end

-- Does what a player carries dig? (a Drill or a Pickaxe)
function Dig.CanDigWith(items: { string }): boolean
	local tools = Dig.Tuning().Tools
	for _, id in items do
		if table.find(tools, id) then
			return true
		end
	end
	return false
end

-- Progress a second (0 to 1 is the whole cell) for diggers with these speeds (1 = a player, the
-- Driller 2): stacked, or the fastest alone when StackPlayers is off.
function Dig.Rate(speeds: { number }, floor: number): number
	local total = 0
	for _, speed in speeds do
		if Dig.Tuning().StackPlayers then
			total += speed
		else
			total = math.max(total, speed)
		end
	end
	return total / Dig.Seconds(floor)
end

-- A Drill Bay's digging speed in players, from its output rate (Rules.Economy) and its Base.
function Dig.DrillBaySpeed(rate: number, base: number): number
	if rate <= 0 or base <= 0 then
		return 0
	end
	return Dig.Tuning().ResidentDigMultiplier * rate / base
end

-- The open cells a rock cell can be dug from: beside it on its floor, or above it.
function Dig.Faces(bunker: any, floor: number, column: number): { Face }
	local faces: { Face } = {}
	if bunker:State(floor, column) ~= "Rock" then
		return faces
	end
	if bunker:IsOpen(floor, column - 1) then
		table.insert(faces, { Side = "Left", Floor = floor, Column = column - 1 })
	end
	if bunker:IsOpen(floor, column + 1) then
		table.insert(faces, { Side = "Right", Floor = floor, Column = column + 1 })
	end
	if bunker:IsOpen(floor - 1, column) then
		table.insert(faces, { Side = "Above", Floor = floor - 1, Column = column })
	end
	return faces
end

-- Where a face's dig prompt stands: on the wall line at chest height for a side, on the floor of
-- the cell above (towards the front) for digging down.
function Dig.FacePoint(face: Face, floor: number, column: number): Vector3
	local from = Grid.CellPosition(face.Floor, face.Column)
	if face.Side == "Above" then
		return from + Vector3.new(0, 1, Grid.Tuning().CellDepth / 4)
	end
	local rock = Grid.CellPosition(floor, column)
	return Vector3.new((from.X + rock.X) / 2, from.Y + 3.5, from.Z)
end

-- Push Deeper -----------------------------------------------------------------------------------

-- The deepest floor the team may dig to without a vote at the start: the first band's last.
function Dig.StartLimit(): number
	return Grid.BandOf(Grid.Tuning().FloorMin).Floors.To
end

-- After a Push Deeper vote into this floor's band: its last floor.
function Dig.LimitAfter(floor: number): number
	return Grid.BandOf(floor).Floors.To
end

function Dig.NeedsVote(floor: number, limit: number): boolean
	return floor > limit
end

-- The roll -----------------------------------------------------------------------------------------

-- The same Random for a cell every time in one run.
function Dig.CellRandom(seed: number, floor: number, column: number): Random
	local n = (math.floor(seed) * 92821 + floor * 1000003 + (column + 64) * 7919) % 2147483647
	return Random.new(n)
end

-- What opening this cell finds. `available` names the results that can happen now (systems
-- built; the rest count as Empty). `overrides` fixes a cell's result for the run (Prompt 17).
function Dig.Roll(seed: number, floor: number, column: number, era: number, available: { [string]: boolean }, overrides: Overrides?): string
	local fixed = if overrides then overrides[Grid.Key(floor, column)] else nil
	if fixed and available[fixed] then
		return fixed
	end
	local rng = Dig.CellRandom(seed, floor, column)
	local total = 0
	for _, entry in Config.All("DigResults") do
		total += entry.Chance
	end
	local pick = rng:NextNumber() * total
	for _, id in Config.Ids("DigResults") do
		local entry = Config.Get("DigResults", id)
		pick -= entry.Chance
		if pick <= 0 then
			if available[id] and era >= (entry.MinEra or 1) then
				return id
			end
			return "Empty"
		end
	end
	return "Empty"
end

-- What the Driller sees in rock before it is dug (Section 14: ore and caves): the roll when it is
-- an ore pocket or a cave opening, else nil.
function Dig.Hint(seed: number, floor: number, column: number, era: number, available: { [string]: boolean }, overrides: Overrides?): string?
	local result = Dig.Roll(seed, floor, column, era, available, overrides)
	return if result == "OrePocket" or result == "CaveOpening" then result else nil
end

-- Overrides as one string for RunState ("3,-2=CaveOpening;5,4=CaveOpening"), and back.
function Dig.EncodeOverrides(overrides: Overrides): string
	local parts = {}
	for key, result in overrides do
		table.insert(parts, `{key}={result}`)
	end
	table.sort(parts)
	return table.concat(parts, ";")
end

function Dig.DecodeOverrides(text: any): Overrides
	local overrides: Overrides = {}
	if type(text) ~= "string" then
		return overrides
	end
	for key, result in string.gmatch(text, "([%-%d]+,[%-%d]+)=(%w+)") do
		overrides[key] = result
	end
	return overrides
end

-- How far into rock a cell is: steps from the nearest open cell (left, right, up, down), up to max.
function Dig.Depth(bunker: any, floor: number, column: number, max: number): number?
	for d = 1, max do
		for df = -d, d do
			local dc = d - math.abs(df)
			for _, c in { column - dc, column + dc } do
				if bunker:IsOpen(floor + df, c) then
					return d
				end
			end
		end
	end
	return nil
end

-- Disturbance -------------------------------------------------------------------------------------

function Dig.AddDisturbance(value: number, amount: number): number
	return math.clamp(value + amount, 0, Dig.DisturbanceTuning().Max)
end

-- What a change from `before` to `after` sets off.
function Dig.Crossed(before: number, after: number): (boolean, boolean)
	local t = Dig.DisturbanceTuning()
	local extra = before < t.ExtraBreachAt and after >= t.ExtraBreachAt and after < t.TremorAt
	local tremor = after >= t.TremorAt
	return extra, tremor
end

function Dig.AfterTremor(): number
	return Dig.DisturbanceTuning().AfterTremor
end

-- The seismograph's reading: CALM, RISING, UNSETTLED or DANGER, by quarters of the meter.
function Dig.Level(value: number): string
	local t = Dig.DisturbanceTuning()
	local fraction = value / t.Max
	if fraction < 0.25 then
		return "CALM"
	elseif fraction < t.ExtraBreachAt / t.Max then
		return "RISING"
	elseif fraction < 0.75 then
		return "UNSETTLED"
	end
	return "DANGER"
end

return table.freeze(Dig)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CA"><Properties><string name="Name">Disasters</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Disasters: the arithmetic of disasters and repairs (bible Sections 6 and 10). Pure, so
	DisasterService and BuildService on the server, the HUD and the Command View on the client
	and the data tests share it. Prompt 13. Numbers: Config.Disasters (each disaster's own) and
	Tuning.Disasters / Tuning.Repairs (the rules), all provisional.

	* Fire: a room burns with a strength from 0 to 100. It grows on its own; residents in the
	  room beat it down; an Extinguisher sprays it down faster; at 0 it is out. Room damage,
	  and the harm to residents and players inside, scale with strength. Every SpreadSeconds
	  (15; FireSpread multipliers slow it) a fire strong enough spreads to a room next door
	  through a doorway; the Shaft doesn't burn, so fires stay on their floor.
	* The Surge's one disaster (Section 5): a weighted pick among the disasters a Surge causes
	  (Config.Disasters SurgeWeight), of this era and before, that the budget can pay for.
	* Blackout: a floor, or the whole grid, dark for DurationSeconds (BlackoutDuration
	  multipliers), unless the fuse box in the Reactor Core is reset first.
	* The meltdown (Section 10's Reactor overload; Landon): three valves turned together stop
	  it. A turned valve counts while its player holds it; with SoloPlayers or fewer in the run,
	  a turned valve stays turned SoloValveSeconds.
	* Cave-in: rubble blocks a doorway (the passage between two units side by side) or fills a
	  dug cell (a tunnel: every passage into it). Melee smashes it, more with weapons that break
	  rubble; a Drill or a Pickaxe digs through it.
	* Repairs (Section 6): the Welder repairs WelderPerSecond (RepairSpeed: the Engineer twice
	  as fast); a worker in the room ResidentRepairPerSecond times Smarts over
	  ResidentSmartsBase (Section 11: Smarts is repair speed).
]]

local Config = require(script.Parent.Parent.Config)

local Disasters = {}

export type Shape = "Doorway" | "Tunnel"

-- A valve held by a player right now (a turned valve otherwise stores until when, server time).
Disasters.HELD = -1

function Disasters.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Disasters")
end

function Disasters.Repairs(): { [string]: any }
	return Config.Get("Tuning", "Repairs")
end

-- Fire ----------------------------------------------------------------------------------------

-- A fire's strength after dt seconds: it grows, `residents` beat it down, `extinguish` (strength a
-- second from Extinguishers) sprays it down. 0 is out.
function Disasters.FireStep(strength: number, dt: number, residents: number, extinguish: number?): number
	local f = Disasters.Tuning().Fire
	local change = f.GrowPerSecond - residents * f.ResidentPerSecond - (extinguish or 0)
	return math.clamp(strength + change * dt, 0, 100)
end

-- HP a burning room loses in dt seconds.
function Disasters.FireRoomDamage(strength: number, dt: number): number
	return (Config.Get("Disasters", "Fire").RoomDamagePerSecond or 0) * strength / 100 * dt
end

-- Health a player inside loses in dt seconds; `taken` is their FireFloodDamageTaken (the
-- Firefighter's 0.25).
function Disasters.FirePlayerDamage(strength: number, dt: number, taken: number?): number
	return Disasters.Tuning().Fire.PlayerDamagePerSecond * strength / 100 * dt * (taken or 1)
end

function Disasters.FireResidentDamage(strength: number, dt: number): number
	return Disasters.Tuning().Fire.ResidentDamagePerSecond * strength / 100 * dt
end

-- Seconds between a fire's spreads (Section 10: every 15 s). FireSpread multipliers below 1
-- slow it: 0.5 is "50% slower", 30 s.
function Disasters.SpreadSeconds(spread: number?): number
	return (Config.Get("Disasters", "Fire").SpreadSeconds or 15) / math.max(spread or 1, 0.05)
end

function Disasters.CanSpread(strength: number): boolean
	return strength >= Disasters.Tuning().Fire.SpreadMinStrength
end

function Disasters.Burns(roomType: string): boolean
	return table.find(Disasters.Tuning().Fire.Fireproof, roomType) == nil
end

-- The rooms a fire in `roomId` can spread to: rooms through a doorway (never dug cells, never
-- up or down: the Shaft doesn't burn) that burn and aren't burning yet. Sorted.
function Disasters.SpreadTargets(bunker: any, roomId: string, burning: { [string]: any }): { string }
	local list = {}
	for _, other in bunker:Neighbors(roomId) do
		local room = bunker:Room(other)
		if room and burning[other] == nil and Disasters.Burns(room.Type) then
			table.insert(list, other)
		end
	end
	table.sort(list)
	return list
end

-- Floods (Prompt 23) --------------------------------------------------------------------------

-- A flood's level after dt seconds. `pipe`: its burst pipe still runs. `fed`: the level of the
-- highest water that pours into it (nil: none). `drain`: the bunker's FloodDrainSpeed.
function Disasters.FloodStep(level: number, dt: number, pipe: boolean, fed: number?, drain: number?): number
	local f = Disasters.Tuning().Flood
	if pipe then
		return math.clamp(level + f.RisePerSecond * dt, 0, 100)
	elseif fed and fed > level then
		return math.min(level + f.OverflowPerSecond * dt, fed)
	end
	return math.max(level - f.DrainPerSecond * math.max(drain or 1, 0.05) * dt, 0)
end

-- How deep in it people are: 0 up to WadeLevel (ankle deep), rising to 1 at level 100.
function Disasters.FloodDepth(level: number): number
	local wade = Disasters.Tuning().Flood.WadeLevel
	return math.clamp((level - wade) / (100 - wade), 0, 1)
end

-- What wading does to walking speed (1: nothing).
function Disasters.WadeSpeed(level: number?): number
	local f = Disasters.Tuning().Flood
	if not level or level < f.WadeLevel then
		return 1
	end
	return f.WadeSpeed + (f.DeepSpeed - f.WadeSpeed) * Disasters.FloodDepth(level)
end

function Disasters.FloodRoomDamage(level: number, dt: number): number
	return (Config.Get("Disasters", "Flood").RoomDamagePerSecond or 0) * level / 100 * dt
end

-- `taken` is the player's FireFloodDamageTaken (the Firefighter's 0.25).
function Disasters.FloodPlayerDamage(level: number, dt: number, taken: number?): number
	return Disasters.Tuning().Flood.PlayerDamagePerSecond * Disasters.FloodDepth(level) * dt * (taken or 1)
end

function Disasters.FloodResidentDamage(level: number, dt: number): number
	return Disasters.Tuning().Flood.ResidentDamagePerSecond * Disasters.FloodDepth(level) * dt
end

function Disasters.FloodSpreadSeconds(): number
	return Config.Get("Disasters", "Flood").SpreadSeconds or 20
end

function Disasters.FloodCanSpread(level: number): boolean
	return level >= Disasters.Tuning().Flood.SpreadMinLevel
end

-- Where the water in `unit` pours next: rooms beside it on its floor and the Shaft below it
-- (Section 10: "pours down the Shaft"; never up, never into bare tunnels), not yet flooded.
-- The way down comes first: water falls before it spreads.
function Disasters.FloodSpreadTargets(bunker: any, unit: string, flooded: { [string]: any }): { string }
	local from = bunker:Room(unit)
	local down, level = {}, {}
	if not from then
		return down
	end
	for _, other in bunker:Neighbors(unit) do
		local room = bunker:Room(other)
		if room and flooded[other] == nil and room.Floor >= from.Floor then
			table.insert(if room.Floor > from.Floor then down else level, other)
		end
	end
	table.sort(down)
	table.sort(level)
	return if #down > 0 then down else level
end

-- The highest water that pours into `unit`: a neighbour on its floor or above it whose level can
-- spread and is higher than its own. nil: nothing feeds it.
function Disasters.FloodFed(bunker: any, unit: string, levels: { [string]: number }): number?
	local room = bunker:Room(unit)
	if not room then
		return nil
	end
	local own = levels[unit] or 0
	local best: number? = nil
	for _, other in bunker:Neighbors(unit) do
		local from = bunker:Room(other)
		local level = levels[other]
		if from and level and from.Floor <= room.Floor and level > own and Disasters.FloodCanSpread(level) then
			best = math.max(best or 0, level)
		end
	end
	return best
end

-- Gas leaks (Prompt 23) -----------------------------------------------------------------------

-- A leak's strength after dt seconds: it fills while the vent leaks, then the room airs out.
function Disasters.GasStep(strength: number, dt: number, leaking: boolean): number
	local g = Disasters.Tuning().Gas
	return math.clamp(strength + (if leaking then g.FillPerSecond else -g.ClearPerSecond) * dt, 0, 100)
end

function Disasters.GasSeconds(): number
	return Config.Get("Disasters", "GasLeak").DurationSeconds or 90
end

-- `bunker` is the GasStrength modifier (Gas Filters: 0.5); `immune` the player's GasImmune;
-- `taken` their GasDamageTaken.
function Disasters.GasPlayerDamage(strength: number, dt: number, bunker: number?, immune: boolean?, taken: number?): number
	if immune then
		return 0
	end
	return Disasters.Tuning().Gas.PlayerDamagePerSecond * strength / 100 * dt * (bunker or 1) * (taken or 1)
end

function Disasters.GasResidentDamage(strength: number, dt: number, bunker: number?, taken: number?): number
	return Disasters.Tuning().Gas.ResidentDamagePerSecond * strength / 100 * dt * (bunker or 1) * (taken or 1)
end

-- What bursts out of a hazard pocket (Section 7: "Gas or water bursts out"), from the band's
-- Hazards: "GasLeak", "Flood", or nil when the band has neither.
function Disasters.HazardKind(hazards: { string }, rng: Random): string?
	local gas = table.find(hazards, "GasLeak") ~= nil
	local water = table.find(hazards, "Flood") ~= nil
	if gas and water then
		return if rng:NextNumber() < Disasters.Tuning().HazardPocket.GasChance then "GasLeak" else "Flood"
	end
	if gas or water then
		return if gas then "GasLeak" else "Flood"
	end
	-- the Crystal Hollows (Prompt 24; Section 12: "radiation in the Crystal Hollows")
	return if table.find(hazards, "RadiationLeak") ~= nil then "RadiationLeak" else nil
end

-- Radiation leaks (Prompt 24) --------------------------------------------------------------------

-- A leak's strength after dt: filling while it leaks (`slow` is DeconSlow while a Decon Room
-- works), fading once it is sealed.
function Disasters.RadiationStep(strength: number, dt: number, leaking: boolean, slow: number?): number
	local r = Disasters.Tuning().Radiation
	return math.clamp(strength + (if leaking then r.FillPerSecond * (slow or 1) else -r.FadePerSecond) * dt, 0, 100)
end

function Disasters.RadiationSeconds(): number
	return Config.Get("Disasters", "RadiationLeak").DurationSeconds or 120
end

-- Radiation a player standing in it takes per second (`gain` is their RadiationGain).
function Disasters.RadiationPlayerRate(strength: number, gain: number?): number
	return Disasters.Tuning().Radiation.PlayerPerSecond * math.clamp(strength, 0, 100) / 100 * math.max(gain or 1, 0)
end

function Disasters.RadiationResidentDamage(strength: number, dt: number, taken: number?): number
	return Disasters.Tuning().Radiation.ResidentDamagePerSecond * math.clamp(strength, 0, 100) / 100 * dt * (taken or 1)
end

-- The odds that a Surge's storm gets through the Blast Door (Section 10: "a weak Blast Door"):
-- by its level, more the more HP it has lost; a wrecked door always leaks; never before FromEra.
function Disasters.DoorLeakChance(era: number, level: number, hpFraction: number, wrecked: boolean): number
	local r = Disasters.Tuning().Radiation
	if era < r.FromEra then
		return 0
	end
	if wrecked then
		return 1
	end
	local base = r.DoorLeakChance[math.clamp(math.floor(level), 1, #r.DoorLeakChance)]
	return math.clamp(base + r.DoorDamagedChance * (1 - math.clamp(hpFraction, 0, 1)), 0, 1)
end

-- Outbreaks (Prompt 24) --------------------------------------------------------------------------

-- Does someone coming in from the Deep carry the sickness? (`roll` is 0 to 1.)
function Disasters.CarriesSickness(era: number, roll: number): boolean
	local o = Disasters.Tuning().Outbreak
	return era >= o.FromEra and roll < o.CarrierChance
end

-- Who a sick resident can pass it to: the others in their room who are well and haven't had it.
-- `people` is { { Id, Room, Sick, Immune, Quarantined } }; the quarantined pass nothing on.
function Disasters.OutbreakTargets(people: { { [string]: any } }, carrier: { [string]: any }): { string }
	local out = {}
	if carrier.Quarantined or not carrier.Sick or not carrier.Room then
		return out
	end
	for _, other in people do
		if other.Id ~= carrier.Id and other.Room == carrier.Room and not other.Sick and not other.Immune then
			table.insert(out, other.Id)
		end
	end
	table.sort(out)
	return out
end

-- Seconds a working Medbay takes over one patient (`speed` is the team's best OutbreakCureSpeed).
function Disasters.CureSeconds(speed: number?): number
	return Disasters.Tuning().Outbreak.CureSeconds / math.max(speed or 1, 0.1)
end

-- The Surge's disaster -------------------------------------------------------------------------

-- Section 5: every Surge brings one disaster. A weighted pick among the disasters with a
-- SurgeWeight, of era `era` and before, whose ThreatCost `budget` covers; nil when none fits.
-- `startable` (optional) narrows it to the disasters whose systems exist (floods and gas leaks:
-- Prompt 23; Landon, Prompt 13: Surges bring cave-ins from Era I, floods and gas leaks from Era II).
function Disasters.SurgePick(era: number, budget: number, rng: Random, startable: { [string]: boolean }?): string?
	local options: { string } = {}
	local total = 0
	for _, id in Config.Ids("Disasters") do
		local d = Config.Get("Disasters", id)
		if (d.SurgeWeight or 0) > 0 and d.Era <= era and d.ThreatCost <= budget and (not startable or startable[id]) then
			table.insert(options, id)
			total += d.SurgeWeight
		end
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, id in options do
		roll -= Config.Get("Disasters", id).SurgeWeight
		if roll <= 0 then
			return id
		end
	end
	return options[#options]
end

-- Blackouts ------------------------------------------------------------------------------------

-- How long a blackout lasts (BlackoutDuration multipliers: Insulated Grid's 0.5 halves it).
function Disasters.BlackoutSeconds(duration: number?): number
	return (Config.Get("Disasters", "Blackout").DurationSeconds or 60) * math.max(duration or 1, 0.05)
end

-- Which floor goes dark: nil for the whole grid (WholeGridChance), else one of `floors`.
function Disasters.BlackoutFloor(floors: { number }, rng: Random): number?
	if #floors == 0 or rng:NextNumber() < Disasters.Tuning().Blackout.WholeGridChance then
		return nil
	end
	return floors[rng:NextInteger(1, #floors)]
end

-- The units (rooms and dug cells) a blackout darkens: those on `floor`, or all of them.
function Disasters.BlackoutUnits(bunker: any, floor: number?): { [string]: boolean }
	local units: { [string]: boolean } = {}
	for _, unit in bunker:Units() do
		local cell = bunker:CellsOf(unit)[1]
		if cell and (floor == nil or cell[1] == floor) then
			units[unit] = true
		end
	end
	return units
end

-- The meltdown -----------------------------------------------------------------------------------

-- A valve a player has just turned: until when it counts (server time), or HELD (while held).
function Disasters.ValveTurned(players: number, now: number): number
	local m = Disasters.Tuning().Meltdown
	if players <= m.SoloPlayers then
		return now + m.SoloValveSeconds
	end
	return Disasters.HELD
end

-- A valve let go of: alone or in two, it keeps its SoloValveSeconds; in a team, a held valve
-- counts a moment longer (network slack), then it is open again.
function Disasters.ValveReleased(value: number, players: number, now: number): number
	local m = Disasters.Tuning().Meltdown
	if value ~= Disasters.HELD then
		return value
	end
	return now + (if players <= m.SoloPlayers then m.SoloValveSeconds else m.HeldGraceSeconds)
end

function Disasters.ValveOn(value: number, now: number): boolean
	return value == Disasters.HELD or value > now
end

function Disasters.ValvesOn(valves: { number }, now: number): number
	local n = 0
	for _, value in valves do
		if Disasters.ValveOn(value, now) then
			n += 1
		end
	end
	return n
end

-- All three valves turned at once: the meltdown stops (Section 10).
function Disasters.MeltdownStopped(valves: { number }, now: number): boolean
	return #valves >= 3 and Disasters.ValvesOn(valves, now) == #valves
end

-- Cave-ins --------------------------------------------------------------------------------------

function Disasters.RubbleHP(shape: Shape): number
	local c = Disasters.Tuning().CaveIn
	return if shape == "Tunnel" then c.TunnelHP else c.DoorwayHP
end

-- Seconds of digging that clear rubble (DigSpeed multipliers: the Driller's 2 halves it).
function Disasters.DigSeconds(shape: Shape, digSpeed: number?): number
	local c = Disasters.Tuning().CaveIn
	return (if shape == "Tunnel" then c.TunnelDigSeconds else c.DigSeconds) / math.max(digSpeed or 1, 0.05)
end

-- What a melee hit does to rubble: weapons that break rubble (the Fire Axe, the Sledgehammer)
-- do BreakerMultiplier times their damage; others their damage.
function Disasters.RubbleDamage(itemId: string, damage: number): number
	local item = Config.Find("Items", itemId)
	local breaks = item ~= nil and item.Melee ~= nil and item.Melee.BreaksRubble == true
	return damage * (if breaks then Disasters.Tuning().CaveIn.BreakerMultiplier else 1)
end

-- Can someone carrying `items` dig through rubble? (A Drill or a Pickaxe.)
function Disasters.CanDig(items: { string }): boolean
	for _, id in items do
		if table.find(Disasters.Tuning().CaveIn.DigItems, id) then
			return true
		end
	end
	return false
end

-- The passages rubble blocks, as pairs of graph units. A doorway: between (floor, column) and
-- its neighbour to the Left or Right, two open cells of different units. A tunnel: a dug cell,
-- every passage into it. Empty when there is nothing to block.
function Disasters.RubbleEdges(bunker: any, shape: Shape, floor: number, column: number, side: string?): { { string } }
	local here = bunker:UnitAt(floor, column)
	if not here then
		return {}
	end
	if shape == "Tunnel" then
		if bunker:State(floor, column) ~= "Dug" then
			return {}
		end
		local edges = {}
		for _, other in bunker:Neighbors(here) do
			table.insert(edges, { here, other })
		end
		return edges
	end
	local otherColumn = if side == "Left" then column - 1 else column + 1
	local other = bunker:UnitAt(floor, otherColumn)
	if not other or other == here then
		return {}
	end
	return { { here, other } }
end

-- Every doorway in the bunker, for cave-ins to fall in (Prompt 14's Tremors): { Floor, Column,
-- Side = "Right" } for each pair of open cells side by side in different units.
function Disasters.Doorways(bunker: any): { { Floor: number, Column: number, Side: string } }
	local list = {}
	for _, unit in bunker:Units() do
		for _, cell in bunker:CellsOf(unit) do
			local right = bunker:UnitAt(cell[1], cell[2] + 1)
			if right and right ~= unit then
				table.insert(list, { Floor = cell[1], Column = cell[2], Side = "Right" })
			end
		end
	end
	table.sort(list, function(a, b)
		return if a.Floor ~= b.Floor then a.Floor < b.Floor else a.Column < b.Column
	end)
	return list
end

-- Electrical surges ------------------------------------------------------------------------------

-- The chance a day brings an electrical surge (Section 10: random, more often in Era III).
function Disasters.ElectricalChance(era: number): number
	local chances = Disasters.Tuning().ElectricalSurge.EraChance
	return chances[math.clamp(math.floor(era), 1, #chances)] or 0
end

-- What an unwelded surge leaves behind when it ends (Section 10: they cause fires and
-- blackouts): "Fire", "Blackout" or nil.
function Disasters.SurgeAftermath(rng: Random): string?
	local e = Disasters.Tuning().ElectricalSurge
	local roll = rng:NextNumber()
	if roll < e.FireChance then
		return "Fire"
	elseif roll < e.FireChance + e.BlackoutChance then
		return "Blackout"
	end
	return nil
end

-- Repairs -----------------------------------------------------------------------------------------

-- HP a second from a Welder (RepairSpeed: the Engineer's 2).
function Disasters.WelderPerSecond(repairSpeed: number?): number
	return Disasters.Repairs().WelderPerSecond * (repairSpeed or 1)
end

-- HP a second from one resident working in the room, by their Smarts.
function Disasters.ResidentRepairPerSecond(smarts: number): number
	return Config.Get("Tuning", "Rooms").ResidentRepairPerSecond * math.max(smarts, 0) / Disasters.Repairs().ResidentSmartsBase
end

-- HP a wrecked room needs before it works again.
function Disasters.RepairedAt(maxHP: number): number
	return math.ceil(maxHP * Disasters.Repairs().RepairedAt)
end

return table.freeze(Disasters)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CB"><Properties><string name="Name">Draft</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Draft: the blueprint draft (bible Section 8 and the Appendix's card pool). Pure, so
	DraftService, the vote telegram and the data tests share it.

	* After every Surge, Tuning.Draft.Cards (3) cards are drawn from the pool and the team votes
	  for one (Config.Votes.Draft: most votes after 20 s, ties picked at random). A card taken
	  leaves the pool for the run.
	* Draws are weighted by each card's Weight; in Era I a card's EarlyWeight is used instead, so
	  room cards come up more early and every run gets its key rooms.
	* Found blueprints (Landon, Prompt 19): a blueprint found in loot or brought home by an
	  expedition is one card, drawn the same way. Once it's home it joins the next draft as an
	  extra choice (FoundPerDraft a draft); the team still votes. Cards waiting like that are held
	  out of the normal draw.
	* Only cards the run can use are offered (DraftService passes `usable`): every modifier the
	  card carries has a system that applies it, a room card's room isn't unlocked already, and
	  so on.
]]

local Config = require(script.Parent.Parent.Config)

export type Face = { Id: string, Name: string, Kind: string, Label: string, Text: string, Room: string? }

local Draft = {}

-- The words on a card's kind tag.
Draft.KIND_LABEL = table.freeze({
	Room = "ROOM",
	BunkerPerk = "BUNKER PERK",
	ResidentBoon = "RESIDENT BOON",
	PlayerBoon = "PLAYER BOON",
	RiskDeal = "RISK DEAL",
})

function Draft.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Draft")
end

-- A card's draw weight in era number `era` (EarlyWeight applies in Era I).
function Draft.Weight(card: { [string]: any }, era: number): number
	if era <= 1 and type(card.EarlyWeight) == "number" then
		return card.EarlyWeight
	end
	return card.Weight
end

-- The cards that can come up: in the pool (not taken, not held back) and usable, in Config order.
function Draft.Pool(
	taken: { [string]: boolean },
	held: { [string]: boolean }?,
	usable: ((card: { [string]: any }) -> boolean)?
): { string }
	local out = {}
	for _, id in Config.Ids("DraftCards") do
		if not taken[id] and not (held and held[id]) then
			local card = Config.Get("DraftCards", id)
			if not usable or usable(card) then
				table.insert(out, id)
			end
		end
	end
	return out
end

-- Up to n cards from `pool`, no repeats, each drawn by its weight in era number `era`.
function Draft.Draw(pool: { string }, n: number, era: number, random: Random): { string }
	local left = table.clone(pool)
	local out = {}
	while #out < n and #left > 0 do
		local total = 0
		for _, id in left do
			total += Draft.Weight(Config.Get("DraftCards", id), era)
		end
		local pick = random:NextInteger(1, #left)
		if total > 0 then
			local roll = random:NextNumber() * total
			for i, id in left do
				roll -= Draft.Weight(Config.Get("DraftCards", id), era)
				if roll < 0 then
					pick = i
					break
				end
			end
		end
		table.insert(out, table.remove(left, pick) :: string)
	end
	return out
end

-- What a card's face shows.
function Draft.Face(id: string): Face
	local card = Config.Get("DraftCards", id)
	return {
		Id = id,
		Name = card.Name,
		Kind = card.Kind,
		Label = Draft.KIND_LABEL[card.Kind] or string.upper(card.Kind),
		Text = card.Short or card.Text,
		Room = card.Room,
	}
end

-- Votes for each option from ballots (voter -> option id); ballots for anything else don't count.
function Draft.Tally(ballots: { [any]: string }, options: { string }): { [string]: number }
	local counts: { [string]: number } = {}
	for _, option in options do
		counts[option] = 0
	end
	for _, choice in ballots do
		if counts[choice] ~= nil then
			counts[choice] += 1
		end
	end
	return counts
end

-- A controller's Y steps a draft vote along the cards (Prompt 19): the option after `current`
-- (the first when there is none), wrapping round.
function Draft.NextPick(options: { string }, current: string?): string?
	if #options == 0 then
		return nil
	end
	local at = if current then table.find(options, current) else nil
	return options[if at then at % #options + 1 else 1]
end

return table.freeze(Draft)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CC"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Economy: the arithmetic of production, power and food (bible Sections 5, 6 and 13).
	EconomyService and PowerService run it on the server; the HUD and the Command View show
	its numbers. Nothing here touches the world, so DataTests can check every rule.

	Production (Section 13, provisional):
		Output per cycle = B x (sum of worker stat / 10) x L x M x R x P
	B is the room's Output.Base (what one cell's worth of workers with stats summing to 10
	makes), L Tuning.Rooms.LevelMultiplier, M Tuning.Rooms.MergeMultiplier by span, R the crew's
	average morale effect (Config.MoraleStates) and P 1 when lit, 0 when dark. The crew's own
	multiplier (traits, from ResidentService) and bunker-wide ones (a draft card, a class, the
	difficulty) come on top. A room with no crew, a dark room and a wrecked room (0 HP) make
	nothing. Rooms make it all the time (Section 5): the output per cycle is spread over a full
	cycle (Tuning.Clock.CycleSeconds), so a skipped day makes less.

	Power (Section 6): the Reactor Core and Generators (rooms with PowerOutput) need residents
	working in them, like every other room (Landon, Nov 8, 2026), and make PowerOutput[level]
	(the level is already in it) x (crew stat / 10) x M x R. Every room
	draws Power[level] per cell. When the draw passes what is made, rooms go dark farthest
	first: steps along the room graph from the nearest Reactor Core or Generator, dug cells
	counting as steps (Landon, Nov 7, 2026). A room nothing can reach is farthest of all; at the
	same distance the room drawing the most goes dark first (Landon, Nov 8, 2026), then the newest.
	Rooms that draw nothing (Shafts, Storage at level 1) never go dark, and a wrecked room (0 HP)
	draws nothing until it is repaired (Landon, Nov 8, 2026).

	Food and water (Section 5): every resident eats FoodPerCycle and drinks WaterPerCycle at the
	start of each cycle (food times their FoodUse). Whole units come off the stockpile and the
	rest carries to the next cycle, so someone who eats half takes 1 every other cycle.
]]

local Config = require(script.Parent.Parent.Config)

export type Crew = {
	Workers: number, -- residents working in the room
	StatSum: number, -- the sum of their stat for the room's job (Strength in the Reactor Core)
	Morale: number, -- their average morale effect: 0.85 to 1.2 (Config.MoraleStates)
	Multiplier: number?, -- their traits and the like (Green Thumb, Lazy), from ResidentService
}

export type Consumer = { Id: string, Draw: number, Steps: number?, Order: number }

export type Balance = {
	Made: number, -- power made
	Needed: number, -- power every room would draw
	Used: number, -- power the lit rooms draw
	Dark: { [string]: boolean }, -- dark room ids
	Draw: { [string]: number }, -- room id -> its draw (rooms that draw something)
	MadeBy: { [string]: number }, -- room id -> power it makes (the Reactor Core, Generators)
	Steps: { [string]: number }, -- graph node -> steps from the nearest power room (absent: unreachable)
}

local Economy = {}

local EPSILON = 1e-6

local function rooms(): { [string]: any }
	return Config.Get("Tuning", "Rooms")
end

function Economy.CycleSeconds(): number
	return Config.Get("Tuning", "Clock").CycleSeconds
end

-- The ore of the depth band a floor is in (Iron in the Mines), or nil.
function Economy.BandOre(floor: number): string?
	for _, band in Config.All("DepthBands") do
		if floor >= band.Floors.From and floor <= band.Floors.To then
			return band.Ore
		end
	end
	return nil
end

--[[
	What a room makes: "Resource" with the stocked resource ("Food"; a Drill Bay makes its band's
	ore), or its Output kind ("Research", "Morale", "Recruits"...) with no resource. nil for rooms
	that make nothing (Quarters, Storage, the Shaft) and for the power rooms (see PowerMade).
]]
function Economy.Makes(roomType: string, floor: number): (string?, string?)
	local output = Config.Get("Rooms", roomType).Output
	if not output then
		return nil, nil
	end
	if output.Kind == "Resource" then
		return "Resource", output.Resource
	elseif output.Kind == "BandOre" then
		local ore = Economy.BandOre(floor)
		return if ore then "Resource" else nil, ore
	end
	return output.Kind, nil
end

-- The crew's part of the formula: (stat sum / 10) x morale x their multiplier; 0 with no crew.
function Economy.CrewFactor(crew: Crew?): number
	if not crew or crew.Workers <= 0 or crew.StatSum <= 0 then
		return 0
	end
	return (crew.StatSum / 10) * crew.Morale * (crew.Multiplier or 1)
end

-- A room's output per cycle (Section 13). `multiplier` is everything bunker-wide on top.
function Economy.Output(roomType: string, level: number, span: number, crew: Crew?, lit: boolean, multiplier: number?): number
	local output = Config.Get("Rooms", roomType).Output
	if not output or not lit then
		return 0
	end
	local t = rooms()
	return output.Base * Economy.CrewFactor(crew) * t.LevelMultiplier[level] * t.MergeMultiplier[span] * (multiplier or 1)
end

-- Power a Reactor Core or Generator makes; 0 for any other room.
function Economy.PowerMade(roomType: string, level: number, span: number, crew: Crew?, multiplier: number?): number
	local made = Config.Get("Rooms", roomType).PowerOutput
	if not made then
		return 0
	end
	return made[level] * Economy.CrewFactor(crew) * rooms().MergeMultiplier[span] * (multiplier or 1)
end

-- Power a room draws: Power[level] for each of its cells.
function Economy.Draw(roomType: string, level: number, span: number): number
	return Config.Get("Rooms", roomType).Power[level] * span
end

function Economy.IsPowerRoom(roomType: string): boolean
	return Config.Get("Rooms", roomType).PowerOutput ~= nil
end

-- Steps from the nearest power room along the room graph (dug cells count), for every node
-- that can be reached from one.
function Economy.Steps(bunker: any): { [string]: number }
	local steps: { [string]: number } = {}
	local queue: { string } = {}
	for _, room in bunker:AllRooms() do
		if Economy.IsPowerRoom(room.Type) then
			steps[room.Id] = 0
			table.insert(queue, room.Id)
		end
	end
	local index = 1
	while index <= #queue do
		local unit = queue[index]
		for _, other in bunker:Neighbors(unit) do
			if steps[other] == nil then
				steps[other] = steps[unit] + 1
				table.insert(queue, other)
			end
		end
		index += 1
	end
	return steps
end

-- A room id's place in build order (R12 -> 12), for ties: the newest goes dark first.
function Economy.Order(roomId: string): number
	return tonumber(string.match(roomId, "%d+")) or 0
end

-- The rooms that go dark: farthest first (unreachable first of all), then the biggest draw, then
-- the newest, until what the rest draw fits in `made`.
function Economy.Shed(consumers: { Consumer }, made: number): { [string]: boolean }
	local needed = 0
	for _, consumer in consumers do
		needed += consumer.Draw
	end
	local dark: { [string]: boolean } = {}
	if needed <= made + EPSILON then
		return dark
	end
	local order = table.clone(consumers)
	table.sort(order, function(a: Consumer, b: Consumer): boolean
		local sa, sb = a.Steps or math.huge, b.Steps or math.huge
		if sa ~= sb then
			return sa > sb
		end
		if a.Draw ~= b.Draw then
			return a.Draw > b.Draw
		end
		return a.Order > b.Order
	end)
	for _, consumer in order do
		if needed <= made + EPSILON then
			break
		end
		dark[consumer.Id] = true
		needed -= consumer.Draw
	end
	return dark
end

--[[
	The whole power balance of a bunker. `crewOf(roomId)` gives a power room's crew;
	`multiplierOf(roomType)` bunker-wide power on top (the Overclock card). A wrecked power room
	(Rules.Bunker: from 0 HP until repaired) makes nothing and a wrecked room draws nothing.
]]
-- Wrecked (Prompt 13: from 0 HP until repaired); a record without the flag is wrecked at 0 HP.
local function wrecked(room: any): boolean
	if room.Wrecked ~= nil then
		return room.Wrecked == true
	end
	return room.HP <= 0
end

function Economy.Balance(bunker: any, crewOf: (string) -> Crew?, multiplierOf: ((string) -> number)?): Balance
	local steps = Economy.Steps(bunker)
	local made = 0
	local consumers: { Consumer } = {}
	local draw: { [string]: number } = {}
	local madeBy: { [string]: number } = {}
	for _, room in bunker:AllRooms() do
		if Economy.IsPowerRoom(room.Type) then
			local amount = 0
			if not wrecked(room) then
				amount = Economy.PowerMade(room.Type, room.Level, room.Span, crewOf(room.Id),
					if multiplierOf then multiplierOf(room.Type) else 1)
			end
			madeBy[room.Id] = amount
			made += amount
		end
		local d = if not wrecked(room) then Economy.Draw(room.Type, room.Level, room.Span) else 0 -- wrecked: none
		if d > 0 then
			draw[room.Id] = d
			table.insert(consumers, { Id = room.Id, Draw = d, Steps = steps[room.Id], Order = Economy.Order(room.Id) })
		end
	end
	local dark = Economy.Shed(consumers, made)
	local needed, used = 0, 0
	for id, d in draw do
		needed += d
		if not dark[id] then
			used += d
		end
	end
	return { Made = made, Needed = needed, Used = used, Dark = dark, Draw = draw, MadeBy = madeBy, Steps = steps }
end

-- Whole units eaten this cycle and the carry to the next: `uses` is each resident's use (1
-- normally; FoodUse changes it), `per` FoodPerCycle or WaterPerCycle.
function Economy.Eat(uses: { number }, per: number, carry: number): (number, number)
	local need = carry
	for _, use in uses do
		need += per * use
	end
	local take = math.floor(need + EPSILON)
	return take, math.max(0, need - take)
end

-- Progress toward whole units: `rate` per cycle for `seconds` of a cycle `cycle` seconds long.
-- Returns the whole units made and the fraction left over.
function Economy.Accrue(progress: number, rate: number, seconds: number, cycle: number): (number, number)
	local total = progress + rate * seconds / cycle
	local whole = math.floor(total + EPSILON)
	return whole, math.max(0, total - whole)
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CD"><Properties><string name="Name">Expeditions</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Expeditions: resident expeditions and the radio (bible Sections 11 and 12; Prompt 18).
	Pure, so ExpeditionService, the Expeditions screen and the data tests share it. Numbers are
	Tuning.Expeditions (provisional); log lines are Config.ExpeditionLogs.

	* Who goes: 1 to 3 residents (Size), alive, in the bunker and not trapped by rubble. How long:
	  1, 2 or 3 cycles (Cycles), the players' choice (Section 12).
	* Supplies (Section 12: "with gear and supplies"): Food and Water for every member for every
	  cycle away (they eat away what they would eat at home: Tuning.Residents FoodPerCycle and
	  WaterPerCycle), taken from the stockpile when they set out, plus up to MedkitsMax Medkits.
	  What they don't use comes home with them.
	* Danger, once a cycle away (Section 12: "length and danger depend on Speed, Grit, gear and
	  supplies"): the chance someone is hurt (HurtChance), the team radios a distress call
	  (DistressChance) or someone is lost (BaseLossChance), each times the destination's Danger
	  and the team's Risk. Risk comes from the team's average of Grit and Speed (Section 11: Grit
	  resists harm, Speed is fleeing): StatStep less per point above StatPivot, more per point
	  below, kept within RiskMin..RiskMax. Gear (Prompt 26) will lower it further.
	* Medkits (supplies): a packed Medkit is used when someone is hurt (they keep MedkitHurtKept of
	  the harm) or would be lost (hurt instead: badly, the full harm).
	* Finds, once a cycle away (Section 12: Scrap, ore, gear, blueprints and sometimes a recruit):
	  the destination's loot table rolled once, its resources times the team's Carry. A member
	  carries CarryBase + Strength x CarryPerStrength (Section 11: Strength is carrying on
	  expeditions) times their ExpeditionCarry; Scrap also takes the team's ExpeditionScrap and
	  everything its ExpeditionLoot (a member's own effects: traits from Prompt 26, a Legend's
	  signature from Prompt 27).
	* Speed and length (Landon, Prompt 18): a team whose average Speed is FastSpeed or more comes
	  home a cycle sooner than the length picked (never under 1 cycle), with the full trip's finds
	  (Trip).
	* A distress call (Section 12): players have until the end of the next day phase to reach
	  them: the day of the cycle after the one the call came in (Deadline). Only a working Radio
	  Room hears it (Landon, Prompt 18); unheard, the team and its finds are lost.
]]

local Config = require(script.Parent.Parent.Config)
local Loot = require(script.Parent.Loot)
local Modifiers = require(script.Parent.Modifiers)

local Expeditions = {}

export type Stats = { [string]: number }
export type Event = "Quiet" | "Hurt" | "Distress" | "Lost"
export type Odds = { Hurt: number, Distress: number, Lost: number }
export type Candidate = { State: string, Trapped: boolean? }

local DESTINATIONS = { "Surface", "Deep" }

function Expeditions.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Expeditions")
end

function Expeditions.Destinations(): { string }
	return table.clone(DESTINATIONS)
end

function Expeditions.IsDestination(destination: any): boolean
	return type(destination) == "string" and table.find(DESTINATIONS, destination) ~= nil
end

-- The loot table a destination rolls each cycle.
function Expeditions.LootTable(destination: string): string
	local t = Expeditions.Tuning()
	return if destination == "Deep" then t.DeepLoot else t.SurfaceLoot
end

-- Food and Water for the whole trip.
function Expeditions.Supplies(members: number, cycles: number): { Food: number, Water: number }
	local r = Config.Get("Tuning", "Residents")
	return { Food = math.ceil(members * cycles * r.FoodPerCycle), Water = math.ceil(members * cycles * r.WaterPerCycle) }
end

--[[
	Whether a team can set out: (true) or (false, why). `members` are the chosen residents' records
	(State, Trapped), in order; ids must not repeat (the caller checks).
]]
function Expeditions.Check(destination: any, members: { Candidate }, cycles: any, medkits: any): (boolean, string?)
	local t = Expeditions.Tuning()
	if not Expeditions.IsDestination(destination) then
		return false, "Pick the surface or the Deep."
	end
	if #members < t.Size.Min then
		return false, "Pick who goes: 1 to 3 residents."
	end
	if #members > t.Size.Max then
		return false, `{t.Size.Max} residents at most.`
	end
	if type(cycles) ~= "number" or cycles ~= math.floor(cycles) or cycles < t.Cycles.Min or cycles > t.Cycles.Max then
		return false, `An expedition lasts {t.Cycles.Min} to {t.Cycles.Max} cycles.`
	end
	if type(medkits) ~= "number" or medkits ~= math.floor(medkits) or medkits < 0 or medkits > t.MedkitsMax then
		return false, `{t.MedkitsMax} Medkits at most.`
	end
	for _, member in members do
		if member.State == "Away" then
			return false, "Someone in the team is already away."
		elseif member.State ~= "Alive" then
			return false, "Someone in the team is down or gone."
		elseif member.Trapped then
			return false, "Someone in the team is cut off by rubble."
		end
	end
	return true, nil
end

-- The team's Risk: 1 at an average Grit and Speed of StatPivot, lower for tougher, faster teams.
function Expeditions.Risk(team: { Stats }): number
	local t = Expeditions.Tuning()
	if #team == 0 then
		return 1
	end
	local sum = 0
	for _, stats in team do
		sum += ((stats.Grit or 0) + (stats.Speed or 0)) / 2
	end
	local average = sum / #team
	return math.clamp(1 - (average - t.StatPivot) * t.StatStep, t.RiskMin, t.RiskMax)
end

-- Each cycle's chances of trouble.
function Expeditions.Odds(destination: string, team: { Stats }): Odds
	local t = Expeditions.Tuning()
	local scale = (t.Danger[destination] or 1) * Expeditions.Risk(team)
	return {
		Hurt = math.clamp(t.HurtChance * scale, 0, 0.9),
		Distress = math.clamp(t.DistressChance * scale, 0, 0.9),
		Lost = math.clamp(t.BaseLossChance * scale, 0, 0.9),
	}
end

-- What happened this cycle, for a roll x in [0, 1): someone lost, a distress call, someone hurt, or nothing.
function Expeditions.Event(odds: Odds, x: number): Event
	if x < odds.Lost then
		return "Lost"
	elseif x < odds.Lost + odds.Distress then
		return "Distress"
	elseif x < odds.Lost + odds.Distress + odds.Hurt then
		return "Hurt"
	end
	return "Quiet"
end

-- "LOW", "MEDIUM" or "HIGH": the chance a cycle goes wrong at all.
function Expeditions.RiskLabel(odds: Odds): string
	local any = odds.Hurt + odds.Distress + odds.Lost
	return if any < 0.3 then "LOW" elseif any < 0.5 then "MEDIUM" else "HIGH"
end

-- One member's share of the carrying.
function Expeditions.Carry(stats: Stats, effects: { any }?): number
	local t = Expeditions.Tuning()
	return (t.CarryBase + (stats.Strength or 0) * t.CarryPerStrength) * (Modifiers.Fold(effects, "ExpeditionCarry") or 1)
end

--[[
	The team's multipliers from its members: Carry (the sum of their shares), Loot and Scrap (the best
	member's ExpeditionLoot and ExpeditionScrap: a Lucky member's luck is the team's).
]]
function Expeditions.Team(team: { Stats }, effects: { { any } }?): { Carry: number, Loot: number, Scrap: number }
	local carry, loot, scrap = 0, 1, 1
	for i, stats in team do
		local own = if effects then effects[i] else nil
		carry += Expeditions.Carry(stats, own)
		loot = math.max(loot, Modifiers.Fold(own, "ExpeditionLoot") or 1)
		scrap = math.max(scrap, Modifiers.Fold(own, "ExpeditionScrap") or 1)
	end
	return { Carry = carry, Loot = loot, Scrap = scrap }
end

-- A cycle's finds scaled for the team: resources times Carry and Loot (Scrap also times Scrap); specials as rolled.
function Expeditions.Scale(drops: { Loot.Drop }, team: { Carry: number, Loot: number, Scrap: number }): { Loot.Drop }
	local out = {}
	for _, drop in drops do
		if drop.Resource then
			local multiplier = team.Carry * team.Loot * (if drop.Resource == "Scrap" then team.Scrap else 1)
			local count = math.floor(drop.Count * multiplier + 0.5)
			if count > 0 then
				table.insert(out, { Resource = drop.Resource, Count = count })
			end
		else
			table.insert(out, table.clone(drop))
		end
	end
	return out
end

-- What a cycle finds on average, resources only (the Expeditions screen): resource -> amount.
function Expeditions.Expected(destination: string, team: { Carry: number, Loot: number, Scrap: number },
	bandOre: string?, skip: { [string]: boolean }?): { [string]: number }
	local tableId = Expeditions.LootTable(destination)
	local lines = Loot.Lines(tableId, { BandOre = bandOre, Skip = skip })
	local total = 0
	for _, line in lines do
		total += line.Weight
	end
	local out: { [string]: number } = {}
	if total <= 0 then
		return out
	end
	local rolls = Config.Get("LootTables", tableId).Rolls
	for _, line in lines do
		local resource = if line.Special == "BandOre" then bandOre else line.Resource
		if resource then
			local each = (line.Min + math.max(line.Min, line.Max)) / 2
			local multiplier = team.Carry * team.Loot * (if resource == "Scrap" then team.Scrap else 1)
			out[resource] = (out[resource] or 0) + rolls * (line.Weight / total) * each * multiplier
		end
	end
	return out
end

-- The harm when someone is hurt: a share of their max health (HurtShare), less with a Medkit.
function Expeditions.Harm(maxHealth: number, x: number, medkit: boolean): number
	local t = Expeditions.Tuning()
	local share = t.HurtShare.Min + (t.HurtShare.Max - t.HurtShare.Min) * math.clamp(x, 0, 1)
	local harm = maxHealth * share * (if medkit then t.MedkitHurtKept else 1)
	return math.max(1, math.floor(harm + 0.5))
end

-- Whether a team is fast: its average Speed is FastSpeed or more (Landon, Prompt 18).
function Expeditions.Fast(team: { Stats }): boolean
	if #team == 0 then
		return false
	end
	local sum = 0
	for _, stats in team do
		sum += stats.Speed or 0
	end
	return sum / #team >= Expeditions.Tuning().FastSpeed
end

-- How many cycles a trip of `cycles` keeps the team away: a fast team comes home one sooner, never under 1.
function Expeditions.Trip(cycles: number, team: { Stats }): number
	return if Expeditions.Fast(team) then math.max(1, cycles - 1) else cycles
end

-- The cycle whose day phase is the last chance to reach a team that radioed in `cycle`.
function Expeditions.Deadline(cycle: number): number
	return cycle + 1
end

-- A recruit's tier for a roll x in [0, 1): Rare at `chance`, else Common.
function Expeditions.RecruitTier(x: number, chance: number): string
	return if x < math.clamp(chance, 0, 1) then "Rare" else "Common"
end

-- "Mara", "Mara and Jude", "Mara, Jude and Ana".
function Expeditions.Names(names: { string }): string
	if #names <= 1 then
		return names[1] or "nobody"
	end
	return `{table.concat(names, ", ", 1, #names - 1)} and {names[#names]}`
end

-- A place's name as it reads mid-sentence: "the motel", "the Main Street diner", "the Mines".
function Expeditions.Place(name: string): string
	local lower = string.lower(name)
	lower = string.gsub(lower, "main street", "Main Street")
	lower = string.gsub(lower, "steadfast", "Steadfast")
	lower = string.gsub(lower, "^mines$", "Mines")
	lower = string.gsub(lower, "flooded caverns", "Flooded Caverns")
	lower = string.gsub(lower, "crystal hollows", "Crystal Hollows")
	lower = string.gsub(lower, "source chamber", "Source Chamber")
	return "the " .. lower
end

-- A log line with its blanks filled: {name}, {names}, {place}.
function Expeditions.Fill(text: string, fields: { [string]: string }): string
	return (string.gsub(text, "{(%a+)}", function(key: string): string?
		return fields[key]
	end))
end

-- The lines Config.ExpeditionLogs has for a destination and event (its own, then those for Any).
function Expeditions.Lines(destination: string, event: string): { string }
	local list = {}
	for _, id in Config.Ids("ExpeditionLogs") do
		local entry = Config.Get("ExpeditionLogs", id)
		if entry.Event == event and (entry.Destination == destination or entry.Destination == "Any") then
			table.insert(list, entry.Text)
		end
	end
	return list
end

return table.freeze(Expeditions)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CE"><Properties><string name="Name">Grid</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Grid: the bunker grid's geometry (bible Section 6), shared so BunkerGrid, the
	Command View (Prompt 7) and the data tests agree on where every cell is.

	* Columns Tuning.Grid.ColumnMin..ColumnMax (-6 to 6), left to right as seen from the
	  front; floors 1 to 10, where the floor number is the depth. Floor 10 is the Source
	  Chamber.
	* A cell is 32 wide, 16 tall and 32 deep inside. Walls are WallThickness (1) on each side
	  and slabs SlabThickness (2) between floors, so cells repeat every 34 studs across and
	  18 down.
	* In the world, Tuning.Grid.Origin is the interior floor centre of floor 1, column 0.
	  Columns grow along +X, floors go down -Y, and the front (the Command View camera's
	  side) faces +Z. Models from the art pipeline face -Z, so CellCFrame turns them half a
	  turn.
]]

local Config = require(script.Parent.Parent.Config)

local Grid = {}

function Grid.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Grid")
end

-- "floor,column", the key cells go by everywhere (collections, models, the delta channel).
function Grid.Key(floor: number, column: number): string
	return `{floor},{column}`
end

function Grid.Parse(key: string): (number?, number?)
	local floor, column = string.match(key, "^(%-?%d+),(%-?%d+)$")
	if not floor then
		return nil, nil
	end
	return tonumber(floor), tonumber(column)
end

function Grid.OnGrid(floor: number, column: number): boolean
	local t = Grid.Tuning()
	return floor == math.floor(floor)
		and column == math.floor(column)
		and floor >= t.FloorMin
		and floor <= t.FloorMax
		and column >= t.ColumnMin
		and column <= t.ColumnMax
end

-- How far apart cells are: across (X), down (Y), and a cell's full depth (Z).
function Grid.Pitch(): Vector3
	local t = Grid.Tuning()
	return Vector3.new(t.CellWidth + 2 * t.WallThickness, t.CellHeight + t.SlabThickness, t.CellDepth + 2 * t.WallThickness)
end

-- The centre of a cell's interior floor, in the world.
function Grid.CellPosition(floor: number, column: number): Vector3
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	return Vector3.new(t.Origin.X + column * pitch.X, t.Origin.Y - (floor - 1) * pitch.Y, t.Origin.Z)
end

-- A cell's interior floor centre, turned so a model that faces -Z faces the front (+Z).
function Grid.CellCFrame(floor: number, column: number): CFrame
	return CFrame.new(Grid.CellPosition(floor, column)) * CFrame.Angles(0, math.pi, 0)
end

-- The cell a world position is in (its interior, or the slab under it), or nil off the grid.
function Grid.CellAt(position: Vector3): (number?, number?)
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local floor = math.floor((t.Origin.Y + t.CellHeight - position.Y) / pitch.Y) + 1
	local column = math.floor((position.X - t.Origin.X) / pitch.X + 0.5)
	if math.abs(position.Z - t.Origin.Z) > pitch.Z / 2 or not Grid.OnGrid(floor, column) then
		return nil, nil
	end
	return floor, column
end

-- The depth band a floor is in (Config.DepthBands).
function Grid.BandOf(floor: number): { [string]: any }
	for _, band in Config.All("DepthBands") do
		if floor >= band.Floors.From and floor <= band.Floors.To then
			return band
		end
	end
	error(`Rules.Grid: no depth band holds floor {floor}`)
end

-- The first floor of a band below the first one (4, 7, 10): opening it needs Push Deeper.
function Grid.IsBandStart(floor: number): boolean
	local band = Grid.BandOf(floor)
	return band.Floors.From == floor and floor > Grid.Tuning().FloorMin
end

-- Can rooms be built on this floor? (Not in the Source Chamber.)
function Grid.Buildable(floor: number): boolean
	return Grid.BandOf(floor).Buildable == true
end

return table.freeze(Grid)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000CF"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Hud: the HUD's arithmetic (bible Section 18), pure so the data tests can check it.

	* Clock(seconds): "m:ss", rounded up, so "0:01" shows until the very end.
	* YearDigits(year): the three tiles of the year flip counter.
	* DialPosition(...): where the cycle dial's pointer sits across the face. The day fills the
	  first DaySeconds / CycleSeconds of the scale and the Surge the rest, as the dial is printed.
	  A Surge with no timer (a boss Surge) parks at the start of its part.
	* NeedleRotation(fraction): a gauge needle's rotation (the sweep runs -135 to +135 degrees).
	* Numeral(n): Roman numerals for the eras.
	* MapWindow(...): which cells the side-view mini-map shows around the player.
]]

local Hud = {}

-- The printed face of the cycle dial spans this much of the sprite's width.
Hud.DialFace = table.freeze({ From = 0.023, To = 0.977 })

function Hud.Clock(seconds: number?): string
	if seconds == nil then
		return "--:--"
	end
	local whole = math.max(0, math.ceil(seconds - 1e-6))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

function Hud.YearDigits(year: number): { string }
	local text = string.format("%03d", math.clamp(math.floor(year), 0, 999))
	return { string.sub(text, 1, 1), string.sub(text, 2, 2), string.sub(text, 3, 3) }
end

-- phase: "Day", "Surge" or nil (before the first day); timeLeft in seconds (nil if unknown);
-- open: the phase has no timer.
function Hud.DialPosition(
	phase: string?,
	phaseLength: number?,
	timeLeft: number?,
	open: boolean?,
	daySeconds: number,
	surgeSeconds: number
): number
	local split = daySeconds / (daySeconds + surgeSeconds)
	local done = 0
	if phaseLength and phaseLength > 0 and timeLeft then
		done = math.clamp(1 - timeLeft / phaseLength, 0, 1)
	end
	local value = 0
	if phase == "Day" then
		value = done * split
	elseif phase == "Surge" then
		value = if open then split else split + done * (1 - split)
	end
	return Hud.DialFace.From + (Hud.DialFace.To - Hud.DialFace.From) * value
end

function Hud.NeedleRotation(fraction: number): number
	return -135 + 270 * math.clamp(fraction, 0, 1)
end

local ROMAN = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X" }

function Hud.Numeral(n: number): string
	return ROMAN[n] or tostring(n)
end

-- The window of `columns` columns centred on the player's column and `rows` floors starting
-- one above the player's floor, kept on the grid. Returns the first column and first floor.
function Hud.MapWindow(
	floor: number,
	column: number,
	grid: { ColumnMin: number, ColumnMax: number, FloorMin: number, FloorMax: number },
	columns: number,
	rows: number
): (number, number)
	local half = (columns - 1) // 2
	local firstColumn = math.clamp(column - half, grid.ColumnMin, math.max(grid.ColumnMin, grid.ColumnMax - columns + 1))
	local firstFloor = math.clamp(floor - 1, grid.FloorMin, math.max(grid.FloorMin, grid.FloorMax - rows + 1))
	return firstColumn, firstFloor
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D0"><Properties><string name="Name">Lobby</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Lobby: the elevator pads' rules (bible Section 21; difficulty unlocks: Section 5). Pure,
	so PadService, the pad's panel and the data tests share it. Numbers are Tuning.Lobby; the pads
	are Config.Pads.

	* Difficulty: Normal from the start; Hard after a victory (the profile's Stats.Wins); Nightmare
	  after a Hard win (Stats.HardWins). Unlocked(stats, id); a pad's riders must all have its
	  difficulty unlocked.
	* A public pad counts down PadCountdownSeconds from its first rider and leaves when the time is
	  up or it is full. A private pad leaves when its leader says so. A solo pad leaves
	  SoloCountdownSeconds after its rider steps on.
	* MayBoard(pad, spec, rider) says whether a player may step on, and why not.
]]

local Config = require(script.Parent.Parent.Config)

local Lobby = {}

export type Pad = {
	Id: string,
	Kind: string, -- Public, Private, Solo
	Difficulty: string,
	Riders: { number }, -- user ids in the order they stepped on; the first leads a private pad
	Invited: { [number]: boolean }?, -- a private pad's guests
	Phase: string, -- Idle, Waiting (a private pad with its party), Counting, Launching
	LeavesAt: number?, -- server time the countdown ends
}

function Lobby.Unlocked(stats: { [string]: number }?, difficulty: string): boolean
	if difficulty == "Normal" then
		return true
	elseif difficulty == "Hard" then
		return stats ~= nil and (stats.Wins or 0) >= 1
	elseif difficulty == "Nightmare" then
		return stats ~= nil and (stats.HardWins or 0) >= 1
	end
	return false
end

-- The difficulties a profile can pick, easiest first.
function Lobby.Difficulties(stats: { [string]: number }?): { string }
	local out = {}
	for _, id in Config.Ids("Difficulties") do
		if Lobby.Unlocked(stats, id) then
			table.insert(out, id)
		end
	end
	return out
end

-- The difficulty after `current` among those every listed player has unlocked (wraps round).
function Lobby.NextDifficulty(current: string, statsList: { { [string]: number }? }): string
	local all = Config.Ids("Difficulties")
	local start = table.find(all, current) or 1
	for step = 1, #all do
		local id = all[(start - 1 + step) % #all + 1]
		local ok = true
		for _, stats in statsList do
			ok = ok and Lobby.Unlocked(stats, id)
		end
		if ok then
			return id
		end
	end
	return "Normal"
end

function Lobby.Capacity(kind: string): number
	return if kind == "Solo" then 1 else Config.Get("Tuning", "Lobby").PartyMax
end

-- Whether a player may step onto the pad now, and why not.
function Lobby.MayBoard(pad: Pad, userId: number, stats: { [string]: number }?): (boolean, string?)
	if table.find(pad.Riders, userId) then
		return true, nil
	end
	if pad.Phase == "Launching" then
		return false, "THIS PAD IS LEAVING"
	end
	if #pad.Riders >= Lobby.Capacity(pad.Kind) then
		return false, "THIS PAD IS FULL"
	end
	if pad.Kind == "Private" and #pad.Riders > 0 and not (pad.Invited and pad.Invited[userId]) then
		return false, "A PRIVATE PAD: ITS LEADER HAS TO INVITE YOU"
	end
	if not Lobby.Unlocked(stats, pad.Difficulty) then
		local spec = Config.Get("Difficulties", pad.Difficulty)
		return false, string.upper(`{spec.Name} UNLOCKS {spec.Unlock}`)
	end
	return true, nil
end

-- How long a pad counts down once it starts to.
function Lobby.CountdownSeconds(kind: string): number
	local t = Config.Get("Tuning", "Lobby")
	return if kind == "Solo" then t.SoloCountdownSeconds else t.PadCountdownSeconds
end

-- The words on a pad's sign: its kind and difficulty.
function Lobby.Title(pad: Pad): string
	local spec = Config.Find("Pads", pad.Id)
	local name = if spec then spec.Name else pad.Kind
	return string.upper(`{name} · {pad.Difficulty}`)
end

return table.freeze(Lobby)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D1"><Properties><string name="Name">Loot</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Loot: rolling Config.LootTables (bible Sections 6, 10, 12 and 13). Pure, so the data
	tests and every service that hands out loot share it.

	Roll(tableId, rng, context) draws the table's Rolls lines by Weight; each gives Min..Max.
	Drops with the same resource, item or special add up:

		Loot.Roll("Cache", rng, { BandOre = "Iron" })
		-- { { Resource = "Scrap", Count = 62 }, { Item = "Flare", Count = 1 } }

	* context.BandOre is the ore a BandOre line gives (the band the loot is in). With none (the
	  Source Chamber) BandOre lines are left out of the draw.
	* context.Skip names Specials (or item ids) that nothing hands out yet (Gear before Prompt 26,
	  RadioLog before the Codex, the Lamp before placeables): their lines are left out of the draw
	  too, so the rest keep their odds between them.
	* context.OreMultiplier scales the ore a BandOre line gives (the Driller's DugOre).
	* context.ExtraRolls adds draws (the Scavenger's ExtraLootRolls on surface containers).
]]

local Config = require(script.Parent.Parent.Config)

local Loot = {}

export type Drop = { Resource: string?, Item: string?, Special: string?, Count: number }
export type Context = { BandOre: string?, Skip: { [string]: boolean }?, OreMultiplier: number?, ExtraRolls: number? }

-- The lines a table can give here, with their weights.
function Loot.Lines(tableId: string, context: Context?): { any }
	local entry = Config.Get("LootTables", tableId)
	local skip = if context then context.Skip else nil
	local list = {}
	for _, line in entry.Lines do
		local usable = line.Weight > 0
		if line.Special == "BandOre" and not (context and context.BandOre) then
			usable = false
		elseif line.Special and line.Special ~= "BandOre" and skip and skip[line.Special] then
			usable = false
		elseif line.Item and skip and skip[line.Item] then
			usable = false -- an item nothing hands out yet (a Lamp before placeables)
		end
		if usable then
			table.insert(list, line)
		end
	end
	return list
end

local function keyOf(drop: Drop): string
	return `{drop.Resource or ""}|{drop.Item or ""}|{drop.Special or ""}`
end

function Loot.Roll(tableId: string, rng: Random, context: Context?): { Drop }
	local entry = Config.Get("LootTables", tableId)
	local lines = Loot.Lines(tableId, context)
	local total = 0
	for _, line in lines do
		total += line.Weight
	end
	local byKey: { [string]: Drop } = {}
	local order: { string } = {}
	if total <= 0 then
		return {}
	end
	local rolls = entry.Rolls + math.max(math.floor((context and context.ExtraRolls) or 0), 0)
	for _ = 1, rolls do
		local pick = rng:NextNumber() * total
		local chosen = lines[#lines]
		for _, line in lines do
			pick -= line.Weight
			if pick <= 0 then
				chosen = line
				break
			end
		end
		local count = rng:NextInteger(chosen.Min, math.max(chosen.Min, chosen.Max))
		local drop: Drop
		if chosen.Special == "BandOre" then
			local ore = (context :: Context).BandOre
			count = math.floor(count * ((context :: Context).OreMultiplier or 1) + 0.5)
			drop = { Resource = ore, Count = count }
		elseif chosen.Resource then
			drop = { Resource = chosen.Resource, Count = count }
		elseif chosen.Item then
			drop = { Item = chosen.Item, Count = count }
		else
			drop = { Special = chosen.Special, Count = count }
		end
		if count > 0 then
			local key = keyOf(drop)
			local have = byKey[key]
			if have then
				have.Count += count
			else
				byKey[key] = drop
				table.insert(order, key)
			end
		end
	end
	local drops = {}
	for _, key in order do
		table.insert(drops, byKey[key])
	end
	return drops
end

-- "62 SCRAP · 1 FLARE" for alerts.
local SPECIAL_NAMES: { [string]: string } = {
	Blueprint = "blueprint", RadioLog = "radio log", Glowshards = "Glowshards", Gear = "gear", Recruit = "recruit",
	BandOre = "ore",
}

function Loot.Text(drops: { Drop }): string
	local parts = {}
	for _, drop in drops do
		local name = if drop.Resource then Config.Get("Resources", drop.Resource).Name
			elseif drop.Item then Config.Get("Items", drop.Item).Name
			else SPECIAL_NAMES[drop.Special or ""] or drop.Special or "?"
		table.insert(parts, `{drop.Count} {string.upper(name)}`)
	end
	return table.concat(parts, " · ")
end

return table.freeze(Loot)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D2"><Properties><string name="Name">Modifiers</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Modifiers: reading the effects a player carries (bible Sections 14 and 23: effects are
	data, Config.Modifiers is the vocabulary). Pure, so both sides and the data tests share it.

	A class's Passive and its level 2 and 3 effects (Prompt 20; talents come with Prompt 27) list
	modifiers. ClassValue folds the ones with a key into one number by the key's unit:
	Multiplier and Chance multiply (1 when none), Add adds (0), Set and Flag take the last (nil
	when none). A level's modifier with the same key (and room) as an earlier part replaces it
	rather than stacking: the Quartermaster's level 3 build costs -20% replace the passive's -10%
	(Config.Classes' note).

		Modifiers.ClassValue("Firefighter", "ExtinguishSpeed") -- 3
		Modifiers.ClassValue("Engineer", "RepairSpeed")        -- 2
		Modifiers.ClassValue("Survivor", "RepairSpeed")        -- 1
		Modifiers.ClassValue("Quartermaster", "BuildCost", 3)  -- 0.8

	PlayerValue(player, key) reads the player's Class and ClassLevel attributes (ClassService sets
	them, Prompt 20), so every system honours level 2 and 3 the same way on both sides.
]]

local Config = require(script.Parent.Parent.Config)

local Modifiers = {}

-- The starting value of a key with nothing applied.
function Modifiers.Neutral(key: string): number?
	local info = Config.Find("Modifiers", key)
	if not info then
		return nil
	end
	if info.Unit == "Multiplier" or info.Unit == "Chance" then
		return 1
	elseif info.Unit == "Add" then
		return 0
	end
	return nil
end

-- Folds a list of { Key, Value } modifiers for one key.
function Modifiers.Fold(list: { any }?, key: string): number?
	local info = Config.Find("Modifiers", key)
	local value = Modifiers.Neutral(key)
	if not info then
		return nil
	end
	for _, modifier in list or {} do
		if modifier.Key == key then
			if info.Unit == "Multiplier" or info.Unit == "Chance" then
				value = (value or 1) * modifier.Value
			elseif info.Unit == "Add" then
				value = (value or 0) + modifier.Value
			else
				value = modifier.Value
			end
		end
	end
	return value
end

-- The modifiers a class carries at a level: its Passive, plus Level2 and Level3 at those levels.
-- A later part's modifier with the same Key and Room replaces the earlier one.
function Modifiers.ClassModifiers(classId: string?, level: number?): { any }
	local class = Config.Find("Classes", classId or "")
	local list = {}
	if not class then
		return list
	end
	local parts = { class.Passive }
	if (level or 1) >= 2 then
		table.insert(parts, class.Level2)
	end
	if (level or 1) >= 3 then
		table.insert(parts, class.Level3)
	end
	for _, part in parts do
		local fromThisPart: { [string]: boolean } = {}
		for _, modifier in (part and part.Modifiers) or {} do
			local key = `{modifier.Key}|{modifier.Room or ""}`
			if not fromThisPart[key] then
				for i = #list, 1, -1 do
					if `{list[i].Key}|{list[i].Room or ""}` == key then
						table.remove(list, i)
					end
				end
			end
			fromThisPart[key] = true
			table.insert(list, modifier)
		end
	end
	return list
end

-- A class's value for a key at a level (1 when not given).
function Modifiers.ClassValue(classId: string?, key: string, level: number?): number?
	return Modifiers.Fold(Modifiers.ClassModifiers(classId, level), key)
end

-- A player's value for a key: their class at their class level (the Class and ClassLevel
-- attributes). Talents (Prompt 27) will add theirs here.
function Modifiers.PlayerValue(player: Instance?, key: string): number?
	if not player then
		return Modifiers.Neutral(key)
	end
	local class = player:GetAttribute("Class")
	local level = player:GetAttribute("ClassLevel")
	return Modifiers.ClassValue(if type(class) == "string" then class else nil, key, if type(level) == "number" then level else nil)
end

return table.freeze(Modifiers)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D3"><Properties><string name="Name">Residents</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Residents: the rules of residents, phase 1 (bible Section 11: identity, stats, jobs, levels,
	needs, routine and death). ResidentService runs them on the server; the Residents screen and
	the Command View show their numbers; DataTests hold them to the bible.

	* Identity: a first and last name from Config.ResidentNames (no repeats in a run while the
	  pool lasts), an age from Tuning.Aging.StartAge, a tier (the six founders are Common).
	* Stats: Strength, Smarts, Grit, Speed and Charm, StatMin to StatMax when they arrive (Rares
	  add RareStatBonus to their best two), never past StatCap. Max health grows with Grit
	  (HealthBase + Grit x HealthPerGrit, provisional).
	* Levels 1 to LevelMax: XPToLevelBase + XPToLevelStep x (level - 1) to the next; each level
	  adds 1 to the stat their job uses (Section 11). Founders above level 1 put theirs into
	  their best stat.
	* Jobs: one room each, if the room has a worker stat and a free slot
	  (Tuning.Rooms.WorkerSlotsPerCell x span). AutoAssign picks the empty slots to fill in
	  Tuning.Residents.AutoAssignOrder (power first, so the lights stay on), then fills them with
	  the best matches by stat.
	* A room's crew for Section 13's formula: workers, the sum of their job stat (an Exhausted
	  resident counts half), and their average morale effect (Config.MoraleStates).
	* Needs once a cycle: rest drains with work and refills in a Quarters bed (less without
	  one); food and water come from the stockpile, and the hungry lose health and morale;
	  morale moves with job fit, meals, dark rooms and beds (Tuning.Morale).
	* Death: at 0 health a resident is down for DeathReviveSeconds; then gone for the run.
]]

local Config = require(script.Parent.Parent.Config)

export type Stats = { [string]: number }
export type State = "Alive" | "Down" | "Dead" | "Away" -- Away: on an expedition, off the map (Prompt 18)
export type Resident = {
	Id: string,
	First: string,
	Last: string,
	Age: number,
	Tier: string,
	Level: number,
	XP: number,
	Stats: Stats,
	Job: string?, -- a room id
	Health: number,
	MaxHealth: number,
	Rest: number, -- 0 to 100
	Morale: number, -- 0 to 100
	State: State,
	Hungry: boolean, -- missed the last meal
	Trapped: boolean?, -- cave-in rubble cuts them off from where they need to be (Prompt 13)
	Weapon: string?, -- the weapon they carry (Section 11's gear, Prompt 26): armed residents answer rally calls
	Sick: boolean?, -- an Outbreak's sickness (Prompt 24; Config.Conditions.Sick: contagious until treated)
	Irradiated: boolean?, -- caught in a radiation leak (Prompt 24; Config.Conditions.Irradiated: loses health until cleared)
	-- Phase 2 (Prompt 26)
	Traits: { string }, -- Config.Traits ids: two each (Section 11)
	Outfit: string?, -- a gear piece ("LabCoat:Reinforced"; Piece and PieceKey below)
	Tool: string?, -- a gear piece ("Ladle")
	Injured: boolean?, -- hurt badly: works slowly until treated (Config.Conditions.Injured)
	Panicked: boolean?, -- fleeing danger: no work until they calm down (Config.Conditions.Panicked)
	Refusing: boolean?, -- Miserable: won't work this cycle
	Lucky: boolean?, -- the Lucky trait's roll came up: double output this cycle
	Low: number?, -- cycles in a row spent Miserable
	Log: { string }, -- the run log (Section 11)
}
export type Crew = { Workers: number, StatSum: number, Morale: number, Multiplier: number? }
export type Morale = { Workers: { Resident }, Floor: number?, Lounge: boolean } -- what a cycle's morale needs to know of a resident's room
export type Rng = { NextInteger: (self: any, number, number) -> number, NextNumber: (self: any) -> number }

local Modifiers = require(script.Parent.Modifiers)

local Residents = {}

local function tuning(): { [string]: any }
	return Config.Get("Tuning", "Residents")
end

-- Armed residents defend their room and answer rally calls (Section 11; the Warden's Rally Call).
function Residents.Armed(resident: Resident): boolean
	return resident.Weapon ~= nil
end

function Residents.StatIds(): { string }
	return Config.Ids("Stats")
end

-- Traits (Prompt 26) ---------------------------------------------------------------------------------

-- Every modifier a resident's traits carry.
local function traitModifiers(resident: Resident): { any }
	local list = {}
	for _, id in resident.Traits or {} do
		local trait = Config.Find("Traits", id)
		if trait then
			for _, modifier in trait.Modifiers do
				table.insert(list, modifier)
			end
		end
	end
	return list
end

-- A resident's own value for a modifier key from their traits (nil: none of their traits has it).
-- `room`: for keys that name a room type (RoomOutput), only that room's. `scope` "Room": the
-- modifiers that reach everyone in their room (a Natural Leader's); otherwise their own.
function Residents.Trait(resident: Resident, key: string, room: string?, scope: string?): number?
	local picked = {}
	for _, modifier in traitModifiers(resident) do
		local reach = modifier.Scope or "Self"
		if modifier.Key == key and (modifier.Room == nil or modifier.Room == room)
			and (if scope == "Room" then reach == "Room" else reach ~= "Room" or scope == "Any") then
			table.insert(picked, modifier)
		end
	end
	if #picked == 0 then
		return nil
	end
	return Modifiers.Fold(picked, key)
end

function Residents.Has(resident: Resident, key: string): boolean
	local value = Residents.Trait(resident, key, nil, "Any")
	return value ~= nil and value ~= 0
end

-- Section 11: "Commons roll one good and one bad trait. Rares roll two good". A Legendary's
-- signature trait comes with its Legend (Prompt 27); until then it rolls two good ones too.
function Residents.RollTraits(rng: Rng, tier: string): { string }
	local good, bad = {}, {}
	for _, id in Config.Ids("Traits") do
		table.insert(if Config.Get("Traits", id).Type == "Good" then good else bad, id)
	end
	local first = good[rng:NextInteger(1, #good)]
	if tier == "Common" or tier == "Free" then
		return { first, bad[rng:NextInteger(1, #bad)] }
	end
	local second = first
	for _ = 1, 20 do
		second = good[rng:NextInteger(1, #good)]
		if second ~= first then
			break
		end
	end
	return { first, second }
end

-- Gear (Prompt 26) -----------------------------------------------------------------------------------

-- A gear piece is an item and its rarity, written "Item:Rarity" ("Ladle" alone is Standard).
function Residents.Piece(key: string?): (string?, string)
	if not key or key == "" then
		return nil, "Standard"
	end
	local item, rarity = string.match(key, "^([%w_]+):([%w_]+)$")
	if item and Config.Find("ItemRarities", rarity) then
		return item, rarity
	end
	return key, "Standard"
end

function Residents.PieceKey(itemId: string, rarity: string?): string
	return if rarity and rarity ~= "Standard" then `{itemId}:{rarity}` else itemId
end

-- Which of a resident's three slots an item goes in (Section 11: Weapon, Outfit, Tool).
function Residents.Slot(itemId: string?): string?
	local item = if itemId then Config.Find("Items", itemId) else nil
	if not item then
		return nil
	end
	if item.Kind == "Outfit" then
		return "Outfit"
	elseif item.Kind == "ResidentTool" or table.find(tuning().RepairTools, itemId :: string) then
		return "Tool" -- the Wrench is a tool in a resident's hands ("Wrench (repairs)")
	elseif item.Kind == "Gun" or item.Kind == "Melee" then
		return "Weapon"
	end
	return nil
end

-- "Lab Coat (Reinforced)", "Ladle".
function Residents.PieceName(key: string?): string
	local itemId, rarity = Residents.Piece(key)
	local item = if itemId then Config.Find("Items", itemId) else nil
	if not item then
		return "none"
	end
	return if rarity ~= "Standard" then `{item.Name} ({Config.Get("ItemRarities", rarity).Name})` else item.Name
end

-- What an outfit adds: +1 to +3 to its stat by its rarity (Config.ItemRarities' OutfitBonus).
function Residents.OutfitBonus(key: string?): (string?, number, number, boolean)
	local itemId, rarity = Residents.Piece(key)
	local item = if itemId then Config.Find("Items", itemId) else nil
	if not item or not item.Outfit then
		return nil, 0, 0, false
	end
	return item.Outfit.Stat, Config.Get("ItemRarities", rarity).OutfitBonus, item.Outfit.Health or 0, item.Outfit.IgnoresGas == true
end

-- A resident's stats with their outfit on (never over StatCap).
function Residents.EffectiveStats(resident: Resident): Stats
	local stat, bonus = Residents.OutfitBonus(resident.Outfit)
	if not stat or bonus <= 0 then
		return resident.Stats
	end
	local stats = table.clone(resident.Stats)
	stats[stat] = math.min(tuning().StatCap, (stats[stat] or 0) + bonus)
	return stats
end

-- The room types a tool helps in, and by how much (Tuning.Residents.ToolOutput).
function Residents.ToolBonus(key: string?, roomType: string): number
	local itemId = Residents.Piece(key)
	local rooms = if itemId then tuning().ToolRooms[itemId] else nil
	if rooms and table.find(rooms, roomType) then
		return tuning().ToolOutput
	end
	return 1
end

-- Do they mend their room each cycle (a repair tool in hand, or the Tinkerer's trait)?
function Residents.Repairs(resident: Resident): boolean
	local itemId = Residents.Piece(resident.Tool)
	return (itemId ~= nil and table.find(tuning().RepairTools, itemId) ~= nil) or Residents.Has(resident, "RepairsRooms")
end

-- Hurt badly enough to be Injured? Healed enough to be over it?
function Residents.InjuredAt(health: number, maxHealth: number): boolean
	return health > 0 and health < maxHealth * tuning().InjuredBelow
end

function Residents.Recovered(health: number, maxHealth: number): boolean
	return health >= maxHealth * tuning().InjuredClearAt
end

-- How long a resident stays Panicked once the danger is gone (never, for the Brave and Cool Heads).
function Residents.PanicSeconds(resident: Resident, calmed: boolean): number
	if Residents.Has(resident, "NeverPanics") then
		return 0
	end
	return tuning().PanicSeconds * (Residents.Trait(resident, "PanicChance") or 1) * (if calmed then tuning().CalmedMultiplier else 1)
end

-- Found gear: an item from the pool at a weighted rarity, as a piece's key. `a` and `b`: 0 to 1.
function Residents.RollGear(a: number, b: number): string
	local t = tuning()
	local item = t.GearPool[math.clamp(math.floor(a * #t.GearPool) + 1, 1, #t.GearPool)]
	local total = 0
	for _, weight in t.GearRarity do
		total += weight
	end
	local roll = b * total
	local rarity = "Standard"
	for _, id in Config.Ids("ItemRarities") do
		local weight = t.GearRarity[id]
		if weight then
			roll -= weight
			if roll < 0 then
				rarity = id
				break
			end
		end
	end
	-- only an outfit's rarity changes what it does for a resident
	return Residents.PieceKey(item, if Residents.Slot(item) == "Outfit" then rarity else nil)
end

-- A resident's max health: their Grit (with their outfit), their Tough or Frail, their vest.
function Residents.MaxHealthOf(resident: Resident): number
	local _, _, vest = Residents.OutfitBonus(resident.Outfit)
	local base = Residents.MaxHealth(Residents.EffectiveStats(resident))
	return math.floor(base * (Residents.Trait(resident, "MaxHealthMult") or 1) + vest + 0.5)
end

-- How much of a meal they eat (Iron Stomach half, Glutton twice).
function Residents.FoodUse(resident: Resident): number
	return Residents.Trait(resident, "FoodUse") or 1
end

-- Does gas hurt them (a Hazmat Suit ignores it), and how much of it (Hardy halves it)?
function Residents.GasTaken(resident: Resident): number
	local _, _, _, ignores = Residents.OutfitBonus(resident.Outfit)
	if ignores then
		return 0
	end
	return Residents.Trait(resident, "GasDamageTaken") or 1
end

-- Can they work right now? Not while Panicked (Config.Conditions.Panicked stops work) or refusing.
function Residents.Working(resident: Resident): boolean
	return resident.State == "Alive" and not resident.Panicked and not resident.Refusing
end

function Residents.MaxHealth(stats: Stats): number
	local t = tuning()
	return t.HealthBase + (stats.Grit or 0) * t.HealthPerGrit
end

function Residents.XPToLevel(level: number): number
	local t = tuning()
	return t.XPToLevelBase + t.XPToLevelStep * (level - 1)
end

-- Their best stat (ties: the order of Config.Stats) and their worst.
function Residents.Best(stats: Stats): string
	local best, value = "Strength", -1
	for _, id in Residents.StatIds() do
		if (stats[id] or 0) > value then
			best, value = id, stats[id] or 0
		end
	end
	return best
end

function Residents.Worst(stats: Stats): string
	local worst, value = "Strength", math.huge
	for _, id in Residents.StatIds() do
		if (stats[id] or 0) < value then
			worst, value = id, stats[id] or 0
		end
	end
	return worst
end

-- The stat a room's job uses (nil: nobody works there).
function Residents.JobStat(roomType: string): string?
	return Config.Get("Rooms", roomType).WorkerStat
end

function Residents.Slots(roomType: string, level: number, span: number): number
	if not Residents.JobStat(roomType) then
		return 0
	end
	return Config.Get("Tuning", "Rooms").WorkerSlotsPerCell[level] * span
end

local function bump(stats: Stats, stat: string)
	stats[stat] = math.min(tuning().StatCap, (stats[stat] or 0) + 1)
end

--[[
	A new resident. `used` holds the full names taken this run (it is updated). Founders above
	level 1 have put each level into their best stat.
]]
function Residents.Roll(rng: Rng, id: string, tier: string, level: number, used: { [string]: boolean }): Resident
	local t = tuning()
	local names = Config.Get("ResidentNames", "First").Names
	local lasts = Config.Get("ResidentNames", "Last").Names
	local first, last = "", ""
	for _ = 1, 40 do
		first, last = names[rng:NextInteger(1, #names)], lasts[rng:NextInteger(1, #lasts)]
		if not used[`{first} {last}`] then
			break
		end
	end
	used[`{first} {last}`] = true
	local stats: Stats = {}
	for _, stat in Residents.StatIds() do
		stats[stat] = rng:NextInteger(t.StatMin, t.StatMax)
	end
	if tier ~= "Common" and tier ~= "Free" then -- Rares and above: their best two get a bonus
		local order = table.clone(Residents.StatIds())
		table.sort(order, function(a: string, b: string): boolean
			return stats[a] > stats[b]
		end)
		for i = 1, 2 do
			stats[order[i]] = math.min(t.StatCap, stats[order[i]] + t.RareStatBonus)
		end
	end
	for _ = 2, level do
		bump(stats, Residents.Best(stats))
	end
	local aging = Config.Get("Tuning", "Aging")
	local traits = Residents.RollTraits(rng, tier)
	local maxHealth = Residents.MaxHealthOf({ Stats = stats, Traits = traits } :: any)
	return {
		Id = id,
		First = first,
		Last = last,
		Age = rng:NextInteger(aging.StartAge.Min, aging.StartAge.Max),
		Tier = tier,
		Level = level,
		XP = 0,
		Stats = stats,
		Job = nil,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Rest = 100,
		Morale = t.MoraleStart,
		State = "Alive",
		Hungry = false,
		Traits = traits,
		Log = {},
	}
end

-- Experience: returns the levels gained; each adds 1 to `jobStat` (their best stat if nil).
function Residents.AddXP(resident: Resident, xp: number, jobStat: string?): number
	local t = tuning()
	local gained = 0
	resident.XP += xp * (Residents.Trait(resident, "ResidentXP") or 1) -- a Fast Learner's
	while resident.Level < t.LevelMax and resident.XP >= Residents.XPToLevel(resident.Level) do
		resident.XP -= Residents.XPToLevel(resident.Level)
		resident.Level += 1
		gained += 1
		bump(resident.Stats, jobStat or Residents.Best(resident.Stats))
	end
	if resident.Level >= t.LevelMax then
		resident.XP = 0
	end
	resident.MaxHealth = Residents.MaxHealthOf(resident)
	return gained
end

-- Morale's state (Config.MoraleStates) and its output effect (R in Section 13).
function Residents.MoraleState(morale: number): (string, number)
	for _, id in Config.Ids("MoraleStates") do
		local state = Config.Get("MoraleStates", id)
		if morale >= state.From and morale <= state.To + 0.999 then
			return id, state.OutputMultiplier
		end
	end
	return "Settled", 1
end

function Residents.IsExhausted(resident: Resident): boolean
	return resident.Rest <= 0
end

-- The health a resident's conditions cost them each cycle (Prompt 24: Sick and Irradiated;
-- Config.Conditions' HealthPerCycle). Zero or less.
function Residents.ConditionHealth(resident: Resident): number
	local sum = 0
	if resident.Sick then
		sum += Config.Get("Conditions", "Sick").HealthPerCycle or 0
	end
	if resident.Irradiated then
		sum += Config.Get("Conditions", "Irradiated").HealthPerCycle or 0
	end
	return sum
end

-- Quarantine (Section 10: "quarantine in Quarters"): a sick resident with no job keeps to a bed.
function Residents.Quarantined(resident: Resident): boolean
	return resident.Sick == true and resident.Job == nil and resident.State == "Alive"
end

-- A room's crew: who works there, alive and working, with their job stat. Each worker counts
-- their stat (with their outfit on) times what slows or speeds them: Exhausted half, the Sick and
-- the Injured less, their traits (Hard Worker, Lazy, Green Thumb in a Kitchen), their tool in its
-- room, a Lucky cycle twice. The Panicked and those refusing work don't count. What reaches the
-- whole room (a Natural Leader) is the crew's Multiplier.
function Residents.Crew(workers: { Resident }, roomType: string): Crew?
	local stat = Residents.JobStat(roomType)
	if not stat then
		return nil
	end
	local count, sum, morale, room = 0, 0, 0, 1
	local conditions = Config.Get("Conditions", "Exhausted").OutputMultiplier
	local sick = Config.Get("Conditions", "Sick").OutputMultiplier or 1
	local injured = Config.Get("Conditions", "Injured").OutputMultiplier or 1
	for _, resident in workers do
		if Residents.Working(resident) then
			count += 1
			local own = (if Residents.IsExhausted(resident) then conditions else 1)
				* (if resident.Sick then sick else 1) -- Prompt 24: the sick work slowly
				* (if resident.Injured then injured else 1)
				* (Residents.Trait(resident, "AllOutput") or 1)
				* (Residents.Trait(resident, "RoomOutput", roomType) or 1)
				* Residents.ToolBonus(resident.Tool, roomType)
				* (if resident.Lucky then 2 else 1)
			sum += (Residents.EffectiveStats(resident)[stat] or 0) * own
			room *= Residents.Trait(resident, "AllOutput", nil, "Room") or 1
			local _, effect = Residents.MoraleState(resident.Morale)
			morale += effect
		end
	end
	if count == 0 then
		return nil
	end
	return { Workers = count, StatSum = sum, Morale = morale / count, Multiplier = if room ~= 1 then room else nil }
end

export type Room = { Id: string, Type: string, Level: number, Span: number }

--[[
	Auto-Assign (Section 7: "fills empty slots by best stat"). Which slots get filled: the empty
	ones in Tuning.Residents.AutoAssignOrder (power first, so the lights stay on), then any other
	working room, as many as there are free residents. Who fills them: the best matches first
	across all of those slots (the highest stat for a slot's job wins it), so a fast cook ends up
	in the Kitchen rather than at the reactor. `free` is changed in place: assigned residents leave
	it. Returns { residentId = roomId }.
]]
function Residents.AutoAssign(rooms: { Room }, taken: { [string]: number }, free: { Resident }): { [string]: string }
	local order = tuning().AutoAssignOrder
	local sorted = table.clone(rooms)
	table.sort(sorted, function(a: Room, b: Room): boolean
		local ia, ib = table.find(order, a.Type) or #order + 1, table.find(order, b.Type) or #order + 1
		if ia ~= ib then
			return ia < ib
		end
		return a.Id < b.Id
	end)
	local alive = {}
	for _, resident in free do
		if resident.State == "Alive" then
			table.insert(alive, resident)
		end
	end
	-- the slots to fill, in priority order
	local slots: { { Room: string, Stat: string, Rank: number } } = {}
	for _, room in sorted do
		local stat = Residents.JobStat(room.Type)
		if stat then
			for _ = 1, Residents.Slots(room.Type, room.Level, room.Span) - (taken[room.Id] or 0) do
				if #slots < #alive then
					table.insert(slots, { Room = room.Id, Stat = stat, Rank = #slots + 1 })
				end
			end
		end
	end
	-- the best matches first
	local pairs_ = {}
	for i, resident in alive do
		for j, slot in slots do
			table.insert(pairs_, { R = i, S = j, Value = resident.Stats[slot.Stat] or 0 })
		end
	end
	table.sort(pairs_, function(a: any, b: any): boolean
		if a.Value ~= b.Value then
			return a.Value > b.Value
		end
		if a.S ~= b.S then
			return a.S < b.S
		end
		return a.R < b.R
	end)
	local result: { [string]: string } = {}
	local usedResident, usedSlot = {}, {}
	for _, pair in pairs_ do
		if not usedResident[pair.R] and not usedSlot[pair.S] then
			usedResident[pair.R] = true
			usedSlot[pair.S] = true
			local resident, slot = alive[pair.R], slots[pair.S]
			result[resident.Id] = slot.Room
			taken[slot.Room] = (taken[slot.Room] or 0) + 1
		end
	end
	for i = #free, 1, -1 do
		if result[free[i].Id] then
			table.remove(free, i)
		end
	end
	return result
end

--[[
	One cycle of needs for a resident (Section 11), at the cycle's start:
	* rest: -RestDrainPerShift for a worker, +RestRefillPerCycle in a bed (x NoBedRestMultiplier
	  without one), 0 to 100;
	* food and water: `fed` false means they missed the meal: -ShortfallHealth health and
	  Tuning.Morale.Hungry morale;
	* morale: JobFit or PoorFit for their job, FedCycle, DarkRoom for a dark job room (not with
	  Night Vision; AfraidOfDark instead for those afraid of it), NoBed, Injured, their roommates'
	  RoommateMorale, Claustrophobic from floor ClaustrophobicFloor down, Homesick without a Lounge
	  (`where`: who shares their room, its floor, whether they have a Lounge to sit in).
	Returns what changed for the run log.
]]
function Residents.Cycle(resident: Resident, worked: boolean, jobStat: string?, bed: boolean, fed: boolean, darkJob: boolean,
	where: Morale?): { string }
	local t = tuning()
	local m = Config.Get("Tuning", "Morale")
	local notes = {}
	local rest = resident.Rest
	if worked then
		rest -= t.RestDrainPerShift * (Residents.Trait(resident, "RestNeed") or 1) -- a Sleepyhead tires faster
	end
	rest += t.RestRefillPerCycle * (if bed then 1 else t.NoBedRestMultiplier)
	resident.Rest = math.clamp(rest, 0, 100)
	local morale = resident.Morale
	if jobStat then
		if jobStat == Residents.Best(resident.Stats) then
			morale += m.JobFit
		elseif jobStat == Residents.Worst(resident.Stats) then
			morale += m.PoorFit
		end
	end
	if fed then
		morale += m.FedCycle
		resident.Hungry = false
	else
		morale += m.Hungry
		resident.Health = math.max(0, resident.Health - t.ShortfallHealth)
		resident.Hungry = true
		table.insert(notes, "went hungry")
	end
	if darkJob and Residents.Has(resident, "AfraidOfDark") then
		morale += m.AfraidOfDark -- "Morale crashes in dark rooms"
		table.insert(notes, "was afraid in the dark")
	elseif darkJob and not Residents.Has(resident, "NoDarkPenalty") then
		morale += m.DarkRoom
	end
	if not bed then
		morale += m.NoBed
		table.insert(notes, "had no bed")
	end
	-- Phase 2 (Prompt 26): injuries, and what their own traits and their roommates' do to them
	if resident.Injured then
		morale += m.Injured
	end
	if where then
		for _, other in where.Workers do
			if other ~= resident and other.State == "Alive" then
				morale += Residents.Trait(other, "RoommateMorale", nil, "Any") or 0 -- a Chatterbox, a Grumpy one
			end
		end
		if Residents.Has(resident, "Claustrophobic") and where.Floor and where.Floor >= m.ClaustrophobicFloor then
			morale += m.Claustrophobic
		end
		if Residents.Has(resident, "Homesick") and not where.Lounge then
			morale += m.Homesick
		end
	end
	resident.Morale = math.clamp(morale, 0, 100)
	return notes
end

--[[
	Morale's bottom (Section 11: a Miserable resident "May refuse work, start fights or leave the
	bunker for good"). Called once a cycle with the cycles they have now spent Miserable in a row
	(resident.Low) and two rolls from 0 to 1. Returns "Leave" (after LeaveAfterCycles, LeaveChance),
	"Fight" (FightChance, with someone to fight), "Refuse" (RefuseChance) or nil.
]]
function Residents.Miserable(resident: Resident, company: boolean, roll: number, second: number): string?
	local m = Config.Get("Tuning", "Morale").Miserable
	if Residents.MoraleState(resident.Morale) ~= "Miserable" then
		return nil
	end
	if (resident.Low or 0) >= m.LeaveAfterCycles and roll < m.LeaveChance then
		return "Leave"
	end
	if company and second < m.FightChance then
		return "Fight"
	end
	if second < m.FightChance + m.RefuseChance then
		return "Refuse"
	end
	return nil
end

-- The full name, as the HUD and the run log write it.
function Residents.Name(resident: Resident): string
	return `{resident.First} {resident.Last}`
end

return Residents
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D4"><Properties><string name="Name">Results</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Results: what a run pays and who was its MVP (bible Sections 16 and 18; Prompt 15). Pure,
	so ResultsService, the results screen and the data tests agree. The amounts are
	Config.GlowshardRewards, Config.Difficulties' PayoutMultiplier and Tuning.Account (account
	experience); the MVP weights are Tuning.Results.

	* Payout(run, paid, facts): the lines a player is owed and the new ledger. `paid` is what this
	  run has already paid them, so a run that ends twice (a victory, then Keep Going and a later
	  end in Endless) only pays what is new: more years, deeper bands, a victory, bosses.
	    - Years survived: Amount per Every years (1 per 4).
	    - Depth bands reached: Amount each (a band counts once its first floor is open).
	    - A Century or a Deep Victory.
	    - Each boss killed.
	    - The difficulty's PayoutMultiplier, then the first win of the day doubles it all.
	* Account experience: XPPerYear for each new year survived; levels from XPToLevelBase plus
	  XPToLevelStep a level, up to LevelMax.
	* Score and MVP: a player's stats times Tuning.Results.MVP's weights; the highest wins (ties:
	  the lower user id, so every server agrees).
]]

local Config = require(script.Parent.Parent.Config)

local Results = {}

export type Run = {
	Year: number,
	DeepestFloor: number,
	Victory: string?, -- "Century" | "Deep"
	Bosses: { string }, -- bosses beaten this run
	Difficulty: string,
}
export type Ledger = { Years: number, Bands: number, Victory: boolean, Bosses: { [string]: boolean } }
export type Line = { Text: string, Amount: number }
export type Payout = { Lines: { Line }, Total: number, Ledger: Ledger }

function Results.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Results")
end

function Results.EmptyLedger(): Ledger
	return { Years = 0, Bands = 0, Victory = false, Bosses = {} }
end

-- Bands whose first floor is open (the Mines count from the start).
function Results.BandsReached(deepestFloor: number): number
	local n = 0
	for _, band in Config.All("DepthBands") do
		if deepestFloor >= band.Floors.From then
			n += 1
		end
	end
	return n
end

local function reward(id: string): any
	return Config.Get("GlowshardRewards", id)
end

function Results.Payout(run: Run, paid: Ledger, facts: { FirstWinToday: boolean }): Payout
	local lines: { Line } = {}
	local ledger: Ledger = { Years = paid.Years, Bands = paid.Bands, Victory = paid.Victory, Bosses = table.clone(paid.Bosses) }
	local subtotal = 0
	local function add(text: string, amount: number)
		if amount > 0 then
			table.insert(lines, { Text = text, Amount = amount })
			subtotal += amount
		end
	end
	-- years survived
	local years = reward("Years")
	local yearsOwed = math.floor(math.max(run.Year, 0) / years.Every)
	local paidYears = math.floor(paid.Years / years.Every)
	if yearsOwed > paidYears then
		add(`Years survived: {run.Year}`, (yearsOwed - paidYears) * years.Amount)
	end
	ledger.Years = math.max(paid.Years, run.Year)
	-- depth bands
	local bands = Results.BandsReached(run.DeepestFloor)
	if bands > paid.Bands then
		add(`Depth bands reached: {bands}`, (bands - paid.Bands) * reward("Bands").Amount)
	end
	ledger.Bands = math.max(paid.Bands, bands)
	-- a victory
	if run.Victory and not paid.Victory then
		local id = if run.Victory == "Deep" then "DeepVictory" else "CenturyVictory"
		add(reward(id).Text, reward(id).Amount)
		ledger.Victory = true
	end
	-- bosses
	for _, bossId in run.Bosses do
		if not ledger.Bosses[bossId] then
			ledger.Bosses[bossId] = true
			add(`{Config.Get("Bosses", bossId).Name} killed`, reward("Bosses").Amount)
		end
	end
	local total = subtotal
	local difficulty = Config.Find("Difficulties", run.Difficulty)
	local multiplier = if difficulty then difficulty.PayoutMultiplier else 1
	if subtotal > 0 and multiplier ~= 1 then
		local extra = math.floor(subtotal * multiplier + 0.5) - subtotal
		table.insert(lines, { Text = `{difficulty.Name} difficulty x{multiplier}`, Amount = extra })
		total += extra
	end
	if total > 0 and facts.FirstWinToday and run.Victory then
		local double = reward("FirstWinOfDay").Multiplier or 2
		local extra = math.floor(total * double + 0.5) - total
		table.insert(lines, { Text = "First win of the day", Amount = extra })
		total += extra
	end
	return { Lines = lines, Total = math.floor(total + 0.5), Ledger = ledger }
end

-- Account experience for years survived since `paidYears`.
function Results.AccountXP(year: number, paidYears: number): number
	return math.max(0, year - paidYears) * Config.Get("Tuning", "Account").XPPerYear
end

-- Experience to go from `level` to the next.
function Results.XPToNext(level: number): number
	local t = Config.Get("Tuning", "Account")
	return t.XPToLevelBase + t.XPToLevelStep * (level - 1)
end

-- An account's level and experience after gaining `gained`.
function Results.LevelUp(level: number, xp: number, gained: number): (number, number)
	local t = Config.Get("Tuning", "Account")
	xp += gained
	while level < t.LevelMax and xp >= Results.XPToNext(level) do
		xp -= Results.XPToNext(level)
		level += 1
	end
	if level >= t.LevelMax then
		xp = math.min(xp, Results.XPToNext(level))
	end
	return level, xp
end

function Results.Score(stats: { [string]: number }): number
	local score = 0
	for key, weight in Results.Tuning().MVP do
		score += (stats[key] or 0) * weight
	end
	return math.floor(score + 0.5)
end

-- The MVP's user id (players: user id -> stats), or nil with nobody scoring.
function Results.MVP(players: { [number]: { [string]: number } }): number?
	local best: number? = nil
	local bestScore = 0
	for userId, stats in players do
		local score = Results.Score(stats)
		if score > bestScore or (score == bestScore and best ~= nil and score > 0 and userId < best) then
			best, bestScore = userId, score
		end
	end
	return best
end

-- The UTC day a moment falls on (for the first win of the day).
function Results.Day(unixSeconds: number): number
	return math.floor(unixSeconds / 86400)
end

return table.freeze(Results)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D5"><Properties><string name="Name">Surface</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Surface: the surface's arithmetic (bible Sections 9, 12 and 13; Prompt 16). Pure, so the
	data tests, the server and the client share it. The numbers are Tuning.Surface (provisional).

	* Zones: Zone(position) is "Surface" above Tuning.Surface.ZoneY (the town is high above the
	  bunker, Section 23), "Deep" behind the grid (the caves, Prompt 17: z past Tuning.Deep.GridBack),
	  else "Bunker". Realm(zone) joins the Bunker and the Deep ("Underground"): they touch through
	  the cave mouths, so people follow and monsters hunt across them.
	* Radiation (Section 9: 0 to 100, builds on the surface, faster in a storm; at 100 it drains
	  health): RadiationRate(zone, storm, gain) per second.
	* Backpacks (Section 12: 10 slots, Scavenger +8, Big Backpack +5): a pack is a list of stacks
	  { Id, Count }, an Id being a resource (Config.Resources) or an item; each stack fills one slot
	  up to Stack(id). Fit adds as much as fits; Merge pours one pack into another; Unload hands the
	  stockpile what it has room for and keeps the rest; Used and Summary describe a pack.
	* Carrying (Section 12: big finds are carried with both hands, slowly; two carriers move
	  faster): CarrySpeed(carriers).
	* Spawns: SpawnSpot picks a marker at the right distance from the players.

		Surface.Fit({}, 10, "Scrap", 120) -- { { Id = "Scrap", Count = 50 }, { Id = "Scrap", Count = 50 }, { Id = "Scrap", Count = 20 } }, 120
]]

local Config = require(script.Parent.Parent.Config)

local Surface = {}

export type Zone = "Surface" | "Bunker" | "Deep"
export type Stack = { Id: string, Count: number }
export type Pack = { Stack }

function Surface.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Surface")
end

-- Zones -------------------------------------------------------------------------------------------

function Surface.Zone(position: Vector3): Zone
	if position.Y > Surface.Tuning().ZoneY then
		return "Surface"
	end
	return if position.Z < Config.Get("Tuning", "Deep").GridBack then "Deep" else "Bunker"
end

-- The Bunker and the Deep are one realm ("Underground"): a cave mouth is a walk away.
function Surface.Realm(zone: string): string
	return if zone == "Surface" then "Surface" else "Underground"
end

function Surface.SameRealm(a: Vector3, b: Vector3): boolean
	return Surface.Realm(Surface.Zone(a)) == Surface.Realm(Surface.Zone(b))
end

-- Radiation ----------------------------------------------------------------------------------------

-- Per second: only on the surface; a storm's rate during a Surge; gain is the RadiationGain modifier.
function Surface.RadiationRate(zone: string, storm: boolean, gain: number?): number
	if zone ~= "Surface" then
		return 0
	end
	local t = Surface.Tuning()
	return (if storm then t.StormRadiationPerSecond else t.RadiationPerSecond) * math.max(gain or 1, 0)
end

-- Backpacks ----------------------------------------------------------------------------------------

-- How many of one thing fill a slot.
function Surface.Stack(id: string): number
	local t = Surface.Tuning()
	return t.Stacks[id] or t.ItemStack
end

-- The pack's slots: the bible's 10 plus the BackpackSlots modifier (Scavenger +8, Scout's level 2 +5).
function Surface.Slots(extra: number?): number
	return Config.Get("Tuning", "Player").BackpackSlots + math.max(math.floor(extra or 0), 0)
end

function Surface.Used(pack: Pack): number
	return #pack
end

local function copy(pack: Pack): Pack
	local out: Pack = {}
	for _, stack in pack do
		table.insert(out, { Id = stack.Id, Count = stack.Count })
	end
	return out
end

-- Adds up to count of id: tops up its stacks, then opens new slots while there are free ones.
-- Returns the new pack and how many it took.
function Surface.Fit(pack: Pack, slots: number, id: string, count: number): (Pack, number)
	local out = copy(pack)
	local size = Surface.Stack(id)
	local left = math.max(math.floor(count), 0)
	for _, stack in out do
		if left <= 0 then
			break
		end
		if stack.Id == id and stack.Count < size then
			local add = math.min(size - stack.Count, left)
			stack.Count += add
			left -= add
		end
	end
	while left > 0 and #out < slots do
		local add = math.min(size, left)
		table.insert(out, { Id = id, Count = add })
		left -= add
	end
	return out, math.max(math.floor(count), 0) - left
end

-- Pours `from` into `into` (a dropped pack picked up): returns the new pack and what didn't fit.
function Surface.Merge(into: Pack, from: Pack, slots: number): (Pack, Pack)
	local out = copy(into)
	local leftover: Pack = {}
	for _, stack in from do
		local took
		out, took = Surface.Fit(out, slots, stack.Id, stack.Count)
		if took < stack.Count then
			table.insert(leftover, { Id = stack.Id, Count = stack.Count - took })
		end
	end
	return out, leftover
end

-- Unloading at the Blast Door hall or Storage (Section 12: loot only counts once dropped there):
-- room[id] is how much more of a resource the stockpile can hold. Returns what was delivered
-- (id -> count) and the pack that's left (what the stockpile had no room for, and anything that
-- isn't a stockpile resource).
function Surface.Unload(pack: Pack, room: { [string]: number }): ({ [string]: number }, Pack)
	local space: { [string]: number } = {}
	for id, n in room do
		space[id] = math.max(math.floor(n), 0)
	end
	local delivered: { [string]: number } = {}
	local leftover: Pack = {}
	for _, stack in pack do
		local can = math.min(stack.Count, space[stack.Id] or 0)
		if can > 0 then
			delivered[stack.Id] = (delivered[stack.Id] or 0) + can
			space[stack.Id] -= can
		end
		if stack.Count - can > 0 then
			table.insert(leftover, { Id = stack.Id, Count = stack.Count - can })
		end
	end
	return delivered, leftover
end

-- Totals by id, in first-seen order: { { Id, Count } } with one entry per id.
function Surface.Totals(pack: Pack): Pack
	local byId: { [string]: Stack } = {}
	local order: Pack = {}
	for _, stack in pack do
		local have = byId[stack.Id]
		if have then
			have.Count += stack.Count
		else
			local entry = { Id = stack.Id, Count = stack.Count }
			byId[stack.Id] = entry
			table.insert(order, entry)
		end
	end
	return order
end

local function nameOf(id: string): string
	local resource = Config.Find("Resources", id)
	if resource then
		return resource.Name
	end
	local card = Config.Find("DraftCards", id) -- a blueprint (Prompt 19)
	if card then
		return `blueprint: {card.Name}`
	end
	local item = Config.Find("Items", id)
	return if item then item.Name else id
end

-- "50 SCRAP · 8 FOOD" (totals), or "EMPTY".
function Surface.Summary(pack: Pack): string
	local parts = {}
	for _, stack in Surface.Totals(pack) do
		table.insert(parts, `{stack.Count} {string.upper(nameOf(stack.Id))}`)
	end
	return if #parts > 0 then table.concat(parts, " · ") else "EMPTY"
end

-- The compact form the server puts in the Pack attribute: "Scrap:50,Food:8" (totals).
function Surface.Encode(pack: Pack): string
	local parts = {}
	for _, stack in Surface.Totals(pack) do
		table.insert(parts, `{stack.Id}:{stack.Count}`)
	end
	return table.concat(parts, ",")
end

function Surface.Decode(text: string?): Pack
	local out: Pack = {}
	for id, n in string.gmatch(text or "", "([%w_]+):(%d+)") do
		table.insert(out, { Id = id, Count = tonumber(n) or 0 })
	end
	return out
end

-- Carrying -----------------------------------------------------------------------------------------

-- The walk-speed multiplier for a big find with this many carriers (0: not carrying).
function Surface.CarrySpeed(carriers: number): number
	if carriers <= 0 then
		return 1
	end
	local t = Surface.Tuning()
	return if carriers >= 2 then t.TeamCarryWalkMultiplier else t.CarryWalkMultiplier
end

-- Spawns -------------------------------------------------------------------------------------------

local function nearest(point: Vector3, players: { Vector3 }): number
	local best = math.huge
	for _, at in players do
		best = math.min(best, (Vector3.new(at.X, 0, at.Z) - Vector3.new(point.X, 0, point.Z)).Magnitude)
	end
	return best
end

-- A spawn marker between range.Min and range.Max (flat studs) from the nearest player, picked at
-- random; failing that, the one closest to that band that is at least range.Min / 2 away. Nil
-- with no players or no markers far enough.
function Surface.SpawnSpot(points: { Vector3 }, players: { Vector3 }, range: { Min: number, Max: number }, rng: Random): Vector3?
	if #players == 0 or #points == 0 then
		return nil
	end
	local inBand: { Vector3 } = {}
	local fallback, fallbackGap = nil, math.huge
	for _, point in points do
		local d = nearest(point, players)
		if d >= range.Min and d <= range.Max then
			table.insert(inBand, point)
		elseif d >= range.Min / 2 then
			local gap = if d < range.Min then range.Min - d else d - range.Max
			if gap < fallbackGap then
				fallback, fallbackGap = point, gap
			end
		end
	end
	if #inBand > 0 then
		return inBand[rng:NextInteger(1, #inBand)]
	end
	return fallback
end

-- A survivor's tier: Rare RareSurvivorChance of the time (Section 12: "sometimes a Rare one").
function Surface.SurvivorTier(roll: number): string
	return if roll < Surface.Tuning().RareSurvivorChance then "Rare" else "Common"
end

return table.freeze(Surface)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D6"><Properties><string name="Name">Threat</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Threat: the Threat Director's arithmetic (bible Section 10), pure so DataTests can hold
	it to the bible. Prompt 12.

	* Level: threat rises with the year, the deepest floor reached, Disturbance, bunker size and
	  player count (Tuning.Threat, provisional).
	* SurgeBudget: what a Surge spends on monster groups; the first cycle's Surge is a small
	  tutorial wave (Section 5), and a player's first run is 30% easier in Era I (Section 22).
	* Roster: the monsters an era sends (Section 5's eras: each brings its band's creatures, Era
	  IV everything before). Surface monsters come with storms and raids (Prompt 16), not breaches.
	* Groups: a budget spent on groups of monsters (each type's Group size and ThreatCost), with
	  variety; Pick: one breach point, weighted.
	* Shell: what a hit on a shelled monster does, by where it comes from (Prompt 23).
]]

local Config = require(script.Parent.Parent.Config)

local Threat = {}

export type Inputs = {
	Year: number,
	DeepestFloor: number,
	Disturbance: number,
	Rooms: number,
	Players: number,
}

export type Group = { Type: string, Count: number }

local function tuning(): { [string]: any }
	return Config.Get("Tuning", "Threat")
end

function Threat.Level(inputs: Inputs): number
	local t = tuning()
	local players = math.clamp(math.floor(inputs.Players), 1, #t.PlayerScale)
	local base = t.Base + t.PerYear * inputs.Year + t.PerDeepestFloor * inputs.DeepestFloor
		+ t.PerDisturbance * inputs.Disturbance + t.PerRoom * inputs.Rooms
	return base * t.PlayerScale[players]
end

-- What a Surge spends. kind is the CycleClock's Surge kind; boss Surges bring their boss
-- instead (Prompt 15), so they spend nothing here.
function Threat.SurgeBudget(level: number, kind: string, firstRunEraI: boolean): number
	local t = tuning()
	if kind == "Tutorial" then
		return t.TutorialSurgeBudget
	elseif kind == "Boss" or kind == "Final" then
		return 0
	end
	return level * (if firstRunEraI then t.FirstRunEraIMultiplier else 1)
end

-- Between Surges: a small amount each cycle (spread over the day).
function Threat.TrickleBudget(level: number, firstRunEraI: boolean): number
	local t = tuning()
	return level * t.BetweenSurgesFraction * (if firstRunEraI then t.FirstRunEraIMultiplier else 1)
end

function Threat.EraNumber(era: string | number): number
	if type(era) == "number" then
		return math.clamp(math.floor(era), 1, 4)
	end
	local entry = Config.Find("Eras", era)
	return if entry then entry.Number else 1
end

-- The monsters that come through breaches by an era: every era's NewMonsters up to it (Section
-- 5's era table; Era IV brings "everything before, stronger"). Sorted, so picks repeat with a seed.
-- Surface monsters come with storms and raids (Prompt 16), not breaches.
function Threat.Roster(era: string | number): { string }
	local n = Threat.EraNumber(era)
	local list = {}
	for _, entry in Config.All("Eras") do
		if entry.Number <= n then
			for _, id in entry.NewMonsters or {} do
				local monster = Config.Find("Monsters", id)
				local surfaceOnly = monster ~= nil and #monster.Where == 1 and monster.Where[1] == "Surface"
				if monster and not surfaceOnly and not table.find(list, id) then
					table.insert(list, id)
				end
			end
		end
	end
	table.sort(list)
	return list
end

-- Spends a budget on groups: each pick is a type whose cost fits what is left, the types used
-- least so far first (variety), then a group size from its Group range that the budget covers.
-- Leftovers smaller than the cheapest monster are dropped. rng: a Random.
function Threat.Groups(budget: number, roster: { string }, rng: Random): { Group }
	local groups: { Group } = {}
	local left = budget
	local used: { [string]: number } = {}
	local guard = 0
	while guard < 40 do
		guard += 1
		local fits = {}
		for _, id in roster do
			local monster = Config.Get("Monsters", id)
			if monster.ThreatCost <= left then
				table.insert(fits, id)
			end
		end
		if #fits == 0 then
			break
		end
		local fewest = math.huge
		for _, id in fits do
			fewest = math.min(fewest, used[id] or 0)
		end
		local least = {}
		for _, id in fits do
			if (used[id] or 0) == fewest then
				table.insert(least, id)
			end
		end
		local id = least[rng:NextInteger(1, #least)]
		local monster = Config.Get("Monsters", id)
		local most = math.min(monster.Group.Max, math.floor(left / monster.ThreatCost))
		local least_ = math.min(monster.Group.Min, most)
		local count = rng:NextInteger(least_, most)
		table.insert(groups, { Type = id, Count = count })
		used[id] = (used[id] or 0) + 1
		left -= count * monster.ThreatCost
	end
	return groups
end

-- The total cost of some groups.
function Threat.Cost(groups: { Group }): number
	local total = 0
	for _, group in groups do
		total += Config.Get("Monsters", group.Type).ThreatCost * group.Count
	end
	return total
end

export type Point = { Id: string, Weight: number }

-- One point, by weight (dark rooms count double, barricaded points less: BreachService).
function Threat.Pick(points: { Point }, rng: Random): Point?
	local total = 0
	for _, point in points do
		total += math.max(point.Weight, 0)
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, point in points do
		roll -= math.max(point.Weight, 0)
		if roll <= 0 then
			return point
		end
	end
	return points[#points]
end

-- Target priority: which of a monster's Targets it goes for, given what is available. Targets
-- is the type's own order (Section 10: residents first, then machines, then players who hit
-- them; each type its own); available says which kinds have a reachable target now.
function Threat.Choose(targets: { string }, available: { [string]: boolean }): string?
	for _, kind in targets do
		if available[kind] then
			return kind
		end
	end
	return nil
end

-- A shelled monster's hit (the Tide Crab: "Armoured front, weak point on its back"; Tuning.MonsterAI).
-- `dot` is how far in front the attacker stands (1: dead ahead, -1: straight behind). Returns the
-- damage multiplier and what was hit: "Shell", "Weak" or nil.
function Threat.Shell(dot: number, armoredFront: boolean, weakBack: boolean): (number, string?)
	local t = Config.Get("Tuning", "MonsterAI")
	if armoredFront and dot >= math.cos(math.rad(t.ArmorArcDegrees / 2)) then
		return t.ArmorFront, "Shell"
	elseif weakBack and dot <= -math.cos(math.rad(t.WeakArcDegrees / 2)) then
		return t.WeakBack, "Weak"
	end
	return 1, nil
end

-- The Crystal Hollows' monsters (Prompt 24) ---------------------------------------------------------

-- Is `position` lit by a flare or a lamp? `lights` are { Position, Radius }; a light reaches its
-- Radius along the floor and LightHeight up and down (so one a floor away shows nothing).
function Threat.Lit(position: Vector3, lights: { { Position: Vector3, Radius: number } }): boolean
	local height = Config.Get("Tuning", "MonsterAI").LightHeight
	for _, light in lights do
		local offset = position - light.Position
		if math.abs(offset.Y) <= height and Vector3.new(offset.X, 0, offset.Z).Magnitude <= light.Radius then
			return true
		end
	end
	return false
end

-- A Prism Stalker is seen while a light is on it and for StalkerRevealSeconds after it strikes or
-- is hit (`shownUntil`).
function Threat.StalkerSeen(lit: boolean, now: number, shownUntil: number?): boolean
	return lit or (shownUntil ~= nil and now < shownUntil)
end

-- What a Geode Golem takes of a shot from `itemId` ("shrugs off small guns"): SmallGunMultiplier
-- from a small gun (Config.Items: Gun.Small), all of it from anything else.
function Threat.SmallGunMultiplier(itemId: string?): number
	local item = if itemId then Config.Find("Items", itemId) else nil
	if item and item.Gun and item.Gun.Small then
		return Config.Get("Tuning", "MonsterAI").SmallGunMultiplier
	end
	return 1
end

-- A Resonator's hum on a monster with `health` of `max`: what it heals.
function Threat.HumHeal(health: number, max: number): number
	if health <= 0 or health >= max then
		return 0
	end
	return math.min(max - health, max * Config.Get("Tuning", "MonsterAI").HumHealFraction)
end

-- A dead Shardling's shards: what they do to someone `distance` studs away.
function Threat.ShatterDamage(distance: number): number
	local t = Config.Get("Tuning", "MonsterAI")
	return if distance <= t.ShatterRadius then t.ShatterDamage else 0
end

return Threat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D7"><Properties><string name="Name">Votes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Votes: how a vote is decided (bible Section 8). Pure, so VoteService, the vote banner
	and the data tests share it.

	* Each kind of vote has a rule (Config.Votes):
	  * MoreYes: more yes than no when time is up.
	  * WholeTeamMajority: more than half of the whole team says yes.
	  * TwoThirdsOfOthers: a kick needs two thirds of the other players.
	  * MostVotes: a draft goes to the most votes, ties picked at random (Winner).
	* Not voting is abstaining. Ties fail, unless a tie-breaker (the Warden, Prompt 20) says yes;
	  a draft's tie goes to the Warden's pick when it is one of the tied.
	  A whole-team vote ties when the team splits evenly (2 yes and 2 no of 4).
	* Everyone saying yes passes a vote at once (Tuning.Votes.PassEarlyWhenAllYes).
	* Spending more than BigSpendFraction (40%) of any stock needs a majority of the whole team.
]]

local Config = require(script.Parent.Parent.Config)

export type Rule = "MoreYes" | "WholeTeamMajority" | "TwoThirdsOfOthers" | "MostVotes"
export type Result = "Pass" | "Fail" | "Tie"

local Votes = {}

function Votes.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Votes")
end

-- The yes votes a majority of `team` needs: more than half.
function Votes.Majority(team: number): number
	return math.floor(team / 2) + 1
end

-- Two thirds of `others`, rounded up.
function Votes.TwoThirds(others: number): number
	return math.ceil(others * 2 / 3 - 1e-9)
end

-- The result when time is up. `team` is everyone who can vote, abstainers included (for a
-- kick, the players other than the one it's against).
function Votes.Outcome(rule: Rule, yes: number, no: number, team: number): Result
	if rule == "MoreYes" then
		return if yes > no then "Pass" elseif yes < no then "Fail" else "Tie"
	elseif rule == "WholeTeamMajority" then
		if yes * 2 > team then
			return "Pass"
		elseif yes == no and yes * 2 == team then
			return "Tie"
		end
		return "Fail"
	elseif rule == "TwoThirdsOfOthers" then
		return if team > 0 and yes >= Votes.TwoThirds(team) then "Pass" else "Fail"
	end
	error(`Rules.Votes.Outcome: a {rule} vote is decided by Winner`)
end

-- Everyone has said yes: the vote passes at once.
function Votes.AllYes(yes: number, team: number): boolean
	return team > 0 and yes >= team and Votes.Tuning().PassEarlyWhenAllYes == true
end

-- Does spending `costs` take more than BigSpendFraction of any stock?
function Votes.BigSpend(costs: { [string]: number }?, stock: { [string]: number }): boolean
	local fraction = Votes.Tuning().BigSpendFraction
	for id, amount in costs or {} do
		if amount > 0 and amount > fraction * (stock[id] or 0) then
			return true
		end
	end
	return false
end

-- The rule a vote of `kind` follows; a big spend turns "more yes than no" into a whole-team majority.
function Votes.RuleFor(kind: string, bigSpend: boolean): Rule
	local rule: Rule = Config.Get("Votes", kind).Rule
	if bigSpend and rule == "MoreYes" then
		return "WholeTeamMajority"
	end
	return rule
end

-- What the banner says a vote needs.
function Votes.NeedText(rule: Rule, team: number): string
	if rule == "MoreYes" then
		return "MORE YES THAN NO"
	elseif rule == "WholeTeamMajority" then
		return `{Votes.Majority(team)} OF {team} MUST SAY YES`
	elseif rule == "TwoThirdsOfOthers" then
		return `{Votes.TwoThirds(team)} OF {team} MUST SAY YES`
	end
	return "MOST VOTES WINS"
end

-- A MostVotes vote's leaders: the options with the most votes, in `order`.
function Votes.Tied(counts: { [string]: number }, order: { string }): { string }
	local best, tied = -1, {}
	for _, option in order do
		local n = counts[option] or 0
		if n > best then
			best, tied = n, { option }
		elseif n == best then
			table.insert(tied, option)
		end
	end
	return tied
end

-- A MostVotes vote: the option with the most votes, ties picked at random, unless `breaker` (a
-- Warden's pick, Prompt 20) is one of the tied. `order` lists the options (so ties break the same
-- way for the same Random); nil when there are none.
function Votes.Winner(counts: { [string]: number }, order: { string }, random: Random, breaker: string?): string?
	local tied = Votes.Tied(counts, order)
	if #tied == 0 then
		return nil
	end
	if breaker and #tied > 1 and table.find(tied, breaker) then
		return breaker
	end
	return tied[random:NextInteger(1, #tied)]
end

return Votes
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000000D8"><Properties><string name="Name">RunState</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RunState: the run's small values, replicated as attributes on this ModuleScript (bible
	Section 23: small values such as the year and the cycle phase replicate as attributes;
	collections go through the delta channel).

	One list of names, types, meanings and owners, like Remotes for events. Each value has
	one writer: the service that owns it gets a setter with RunState.Writer("CycleClock") and
	can only set its own values. Anything on either side reads with RunState.Get and
	RunState.Changed. In the Lobby nothing is set.

	Times are server time (workspace:GetServerTimeNow()), so every client counts down to the
	same moment; RunState.TimeLeft() does the sum.

	Players also carry two attributes the clock reads for skips (CycleClock writes them):
	Ready (pressed Ready this day) and Resting (lying in a Quarters bed).

	The stockpile (EconomyService): one value per stocked resource in Config.Resources (Food,
	Water, Scrap, Iron, Copper, Crystal, Medkits, Ammo), plus Research.
	Power (PowerService): PowerMade, PowerUsed, PowerNeeded and DarkRooms.
	Threat (ThreatDirector): Threat and Monsters.
	Disasters (DisasterService, Prompt 13): Fires, BlackoutRooms, Rubble, Floods, GasLeaks, Meltdown, MeltdownEndsAt
	and ValvesTurned.
	Digging (DigService, Prompt 14): Disturbance, DigLimit, DigSeed, DigOverrides, TremorAt and Nests.
	The surface (SurfaceService, Prompt 16): Storm and StormAt. Players also carry Zone (Surface,
	Bunker or Deep), Radiation, ClearRad, PackUsed, PackSlots, Pack, Carrying and Riding attributes
	(SurfaceService and InventoryService).
	The Deep (DeepService, Prompt 17): Caves and CryoPods.
	Expeditions (ExpeditionService, Prompt 18): RadioWorks.
	Classes (Prompt 20): BuildCost (BuildService), LevelStat, BeaconUntil and BeaconBy (ClassService).
	Players also carry Class, ClassLevel and the ability's AbilityReadyAt, AbilityReadyCycle,
	AbilityUses, AbilityMax, AbilityOption, AbilityOptionReadyAt, AbilityActiveUntil and
	SteadyShots (ClassService).
]]

local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)

export type RunPhase = "Waiting" | "Intro" | "Playing" | "Ended"
export type CyclePhase = "Day" | "Surge"
export type Outcome = "CenturyVictory" | "DeepVictory" | "Defeat"
export type Writer = "RunDirector" | "CycleClock" | "ObjectiveService" | "EconomyService" | "PowerService" | "ThreatDirector"
	| "DisasterService" | "DigService" | "SurfaceService" | "DeepService" | "ExpeditionService" | "BuildService" | "ClassService"

type Field = {
	Type: "string" | "number" | "boolean",
	By: Writer,
	Values: { string }?,
	Doc: string,
}

local FIELDS: { [string]: Field } = {
	-- RunDirector: the run's lifecycle
	RunPhase = { Type = "string", By = "RunDirector", Values = { "Waiting", "Intro", "Playing", "Ended" }, Doc = "where the run is" },
	IntroEndsAt = { Type = "number", By = "RunDirector", Doc = "server time the intro ends and the run clock starts (Intro only)" },
	Difficulty = { Type = "string", By = "RunDirector", Doc = "Normal, Hard or Nightmare (Config.Difficulties)" },
	Outcome = { Type = "string", By = "RunDirector", Values = { "CenturyVictory", "DeepVictory", "Defeat" }, Doc = "how the run ended (Ended only)" },
	DefeatReason = { Type = "string", By = "RunDirector", Values = { "ReactorDestroyed", "ResidentsLost" }, Doc = "why the bunker fell (Defeat only): the Reactor Core melted down, or the last resident died" },
	Victory = { Type = "string", By = "RunDirector", Values = { "Century", "Deep" }, Doc = "the victory this run won; kept through Endless" },
	Endless = { Type = "boolean", By = "RunDirector", Doc = "Keep Going passed: the run carries on past Year 100 with stronger Surges" },

	-- CycleClock: cycles, phases and the year counter
	Cycle = { Type = "number", By = "CycleClock", Doc = "the cycle number, from 1" },
	Year = { Type = "number", By = "CycleClock", Doc = "the year counter, from 1" },
	Era = { Type = "string", By = "CycleClock", Doc = "the era the year is in (Config.Eras)" },
	YearsPerCycle = { Type = "number", By = "CycleClock", Doc = "how far the year jumps at the end of this cycle" },
	CyclePhase = { Type = "string", By = "CycleClock", Values = { "Day", "Surge" }, Doc = "the phase of the cycle (from the first day on)" },
	PhaseLength = { Type = "number", By = "CycleClock", Doc = "seconds the current phase lasts in all" },
	PhaseEndsAt = { Type = "number", By = "CycleClock", Doc = "server time the phase ends; nil while the clock is stopped or the phase has no timer" },
	PhaseLeft = { Type = "number", By = "CycleClock", Doc = "seconds left, only while the clock is stopped" },
	PhaseOpen = { Type = "boolean", By = "CycleClock", Doc = "the phase has no timer: a boss Surge lasts until its boss is beaten" },
	Siren = { Type = "boolean", By = "CycleClock", Doc = "the Surge siren is sounding: the last 20 seconds of a day" },
	SurgeKind = { Type = "string", By = "CycleClock", Values = { "Tutorial", "Normal", "Boss", "Final", "Endless" }, Doc = "the coming Surge (during a day) or the current one" },
	SurgeBoss = { Type = "string", By = "CycleClock", Doc = "the boss of a Boss or Final Surge (Config.Bosses)" },
	ReadyCount = { Type = "number", By = "CycleClock", Doc = "players ready to skip: Ready pressed, or resting in a Quarters bed" },
	ReadyNeeded = { Type = "number", By = "CycleClock", Doc = "players in the run; when all are ready, the day skips to the siren" },
	Paused = { Type = "boolean", By = "CycleClock", Doc = "DevTools paused the clock" },
	TimeScale = { Type = "number", By = "CycleClock", Doc = "DevTools time scale (nil means 1)" },

	-- ObjectiveService: what makes more years pass per cycle
	LostCrews = { Type = "number", By = "ObjectiveService", Doc = "Lost Crews rescued" },
	BossesBeaten = { Type = "number", By = "ObjectiveService", Doc = "era bosses beaten" },

	-- EconomyService: Lab research so far (the stock amounts are added below from Config.Resources)
	Research = { Type = "number", By = "EconomyService", Doc = "Lab research so far (level 3 upgrades need it)" },

	-- PowerService: the live power balance (Power is not a stock)
	PowerMade = { Type = "number", By = "PowerService", Doc = "power the Reactor Core and Generators make now" },
	PowerUsed = { Type = "number", By = "PowerService", Doc = "power the lit rooms draw" },
	PowerNeeded = { Type = "number", By = "PowerService", Doc = "power every room would draw" },
	DarkRooms = { Type = "number", By = "PowerService", Doc = "rooms dark for want of power" },
	-- ThreatDirector (Prompt 12): the danger now
	Threat = { Type = "number", By = "ThreatDirector", Doc = "the threat level (Section 10), rounded" },
	Monsters = { Type = "number", By = "ThreatDirector", Doc = "monsters on the map plus those queued at the cap" },

	-- DisasterService (Prompt 13): disasters now (the details are the Disasters collection)
	Fires = { Type = "number", By = "DisasterService", Doc = "rooms on fire" },
	BlackoutRooms = { Type = "number", By = "DisasterService", Doc = "rooms and tunnels dark in a blackout (0: none)" },
	Rubble = { Type = "number", By = "DisasterService", Doc = "piles of rubble blocking the way" },
	Floods = { Type = "number", By = "DisasterService", Doc = "rooms with water in them (Prompt 23)" },
	GasLeaks = { Type = "number", By = "DisasterService", Doc = "rooms with gas in them (Prompt 23)" },
	RadiationLeaks = { Type = "number", By = "DisasterService", Doc = "radiation leaks on (Prompt 24)" },
	Sick = { Type = "number", By = "DisasterService", Doc = "residents sick in an outbreak (Prompt 24)" },
	Meltdown = { Type = "boolean", By = "DisasterService", Doc = "the Reactor Core is melting down (Section 10)" },
	MeltdownEndsAt = { Type = "number", By = "DisasterService", Doc = "server time the meltdown loses the run (Meltdown only)" },
	ValvesTurned = { Type = "number", By = "DisasterService", Doc = "the meltdown valves turned now, 0 to 3 (Meltdown only)" },

	-- DigService (Prompt 14): Disturbance and digging
	Disturbance = { Type = "number", By = "DigService", Doc = "the Disturbance meter, 0 to 100 (Section 10): the HUD's seismograph" },
	DigLimit = { Type = "number", By = "DigService", Doc = "the deepest floor the team may dig without a Push Deeper vote (3, then 6, 9, 10)" },
	DigSeed = { Type = "number", By = "DigService", Doc = "the run's seed for what dug cells hold (Rules.Dig.Roll), so the Driller's hints match" },
	DigOverrides = { Type = "string", By = "DigService", Doc = "cells whose roll is fixed this run, \"3,-2=CaveOpening;...\" (Rules.Dig.DecodeOverrides; Prompt 17: the Lost Crews' caves)" },
	TremorAt = { Type = "number", By = "DigService", Doc = "server time of the last Tremor (clients shake the camera)" },
	Nests = { Type = "number", By = "DigService", Doc = "nests alive in the bunker" },

	-- SurfaceService (Prompt 16): the storm over Brightwater Ruins
	Storm = { Type = "boolean", By = "SurfaceService", Doc = "the storm is over the surface (every Surge, Section 12): radiation climbs fast, visibility drops, Ash Wraiths hunt" },
	StormAt = { Type = "number", By = "SurfaceService", Doc = "server time the next storm hits (the Surge siren's end), or the current one began" },

	-- DeepService (Prompt 17): the caves behind the grid and cryo pods
	Caves = { Type = "number", By = "DeepService", Doc = "caves open behind dug cells (Section 12)" },
	CryoPods = { Type = "number", By = "DeepService", Doc = "cryo pods hauled home and waiting for a Cryo Bay to thaw them (Section 6)" },

	-- ExpeditionService (Prompt 18): whether the bunker can hear a distress call
	RadioWorks = { Type = "boolean", By = "ExpeditionService", Doc = "a Radio Room is staffed and powered, so an expedition's distress call is heard (Landon, Prompt 18: unheard, the team is lost)" },

	-- Classes (Prompt 20)
	BuildCost = { Type = "number", By = "BuildService", Doc = "build and upgrade costs times this (the Quartermaster); nil is 1" },
	LevelStat = { Type = "string", By = "ClassService", Doc = "the stat residents raise when they level, a level 2 Warden's choice (Section 11); nil: their job's" },
	BeaconUntil = { Type = "number", By = "ClassService", Doc = "server time the Mad Scientist's Teleport Beacon stands until; nil: none" },
	BeaconBy = { Type = "string", By = "ClassService", Doc = "who placed the Teleport Beacon (their display name)" },
}

-- EconomyService: one value per stocked resource (Config.Resources, Kind "Stock"), its amount
-- in the team's stockpile. Power is a live balance, not a stock.
for _, id in Config.Ids("Resources") do
	local resource = Config.Get("Resources", id)
	if resource.Kind == "Stock" then
		assert(FIELDS[id] == nil, `RunState: the resource {id} clashes with a RunState value`)
		FIELDS[id] = { Type = "number", By = "EconomyService", Doc = `{resource.Name} in the stockpile` }
	end
end

for name, field in FIELDS do
	local values = field.Values
	if values then
		table.freeze(values)
	end
	table.freeze(field)
	assert(string.find(name, "^%u%w*$"), `RunState: {name} must be PascalCase`)
end
table.freeze(FIELDS)

local IS_SERVER = RunService:IsServer()

local RunState = {}

RunState.Fields = FIELDS

-- Is `value` allowed for `name`? (nil always is: it clears the value.)
function RunState.Check(name: string, value: any): (boolean, string?)
	local field = FIELDS[name]
	if not field then
		return false, `no RunState value {tostring(name)}`
	end
	if value == nil then
		return true
	end
	if type(value) ~= field.Type then
		return false, `{name} is a {field.Type}, got a {typeof(value)}`
	end
	if field.Type == "number" and (value ~= value or math.abs(value) == math.huge) then
		return false, `{name} must be a finite number`
	end
	if field.Values and not table.find(field.Values, value) then
		return false, `{name} can't be {tostring(value)}`
	end
	return true
end

-- Server: a setter for the values `writer` owns. Setting anything else is an error.
function RunState.Writer(writer: Writer): (name: string, value: any) -> ()
	return function(name: string, value: any)
		local field = FIELDS[name]
		if not field then
			error(`RunState: no value {tostring(name)}`, 2)
		end
		if field.By ~= writer then
			error(`RunState: {name} belongs to {field.By}, not {writer}`, 2)
		end
		local ok, why = RunState.Check(name, value)
		if not ok then
			error(`RunState: {why}`, 2)
		end
		if not IS_SERVER then
			error("RunState: values are set on the server", 2)
		end
		script:SetAttribute(name, value)
	end
end

function RunState.Get(name: string): any
	assert(FIELDS[name], `RunState: no value {tostring(name)}`)
	return script:GetAttribute(name)
end

function RunState.Changed(name: string): RBXScriptSignal
	assert(FIELDS[name], `RunState: no value {tostring(name)}`)
	return script:GetAttributeChangedSignal(name)
end

-- Every value that is set.
function RunState.All(): { [string]: any }
	local values = {}
	for name in FIELDS do
		values[name] = script:GetAttribute(name)
	end
	return values
end

-- Seconds left in the intro or the current cycle phase (nil when nothing is counting down).
function RunState.TimeLeft(): number?
	if script:GetAttribute("RunPhase") == "Intro" then
		local introEndsAt = script:GetAttribute("IntroEndsAt")
		if type(introEndsAt) == "number" then
			return math.max(0, introEndsAt - workspace:GetServerTimeNow())
		end
		return nil
	end
	local endsAt = script:GetAttribute("PhaseEndsAt")
	if type(endsAt) == "number" then
		return math.max(0, endsAt - workspace:GetServerTimeNow())
	end
	local left = script:GetAttribute("PhaseLeft")
	return if type(left) == "number" then left else nil
end

return table.freeze(RunState)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000D9"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Types: definitions that cross module or network boundaries.

	Require this module for its types only (`local Types = require(Shared.Types)`, then
	`Types.Module`). Content entry types arrive with Prompt 1 (Config schemas).
]]

export type PlaceKind = "Lobby" | "Run"

-- The registry a service or controller receives in Init: only its declared dependencies
-- can be read from it (Loader enforces this).
export type Registry = { [string]: any }

-- A service (server) or controller (client). Every ModuleScript in Services/ or
-- Controllers/ returns one of these, with Name equal to the ModuleScript's name.
export type Module = {
	Name: string,
	Dependencies: { string }?,
	Init: ((self: any, registry: Registry) -> ())?,
	Start: ((self: any) -> ())?,
	[string]: any,
}

-- One change on the delta channel: { op, collection, key, value } (see Utilities.Delta).
export type DeltaOp = { any }

-- A DevTools command (DevService:Register).
export type DevCommand = {
	Description: string,
	Usage: string?,
	Run: (player: Player?, args: { any }) -> string?,
}

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000DA"><Properties><string name="Name">UIContract</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	UIContract: what the UI layout must provide for the code (bible Section 18).

	The layout is real instances in StarterGui, built through the Studio connector
	(studio/ui/Frame.lua, HUD.lua and Lobby.lua) and then given Landon's AutoScale Lite pass; code only
	clones templates and sets text and images. This list is the contract between the two: the
	controllers find these paths, and StructureCheck fails if one is missing, so a rebuilt or
	hand-edited screen can't drift away from the code.

	Paths are relative to the ScreenGui, with "." between names.
]]

export type Screen = {
	Places: { string }, -- "Lobby", "Run"
	DisplayOrder: number,
	Paths: { string },
	Insets: string?, -- "None": the ScreenGui covers the whole screen (letterbox bars, a flash); else the safe area (Section 18, rule 7)
}

local UIContract: { [string]: Screen } = {
	Frame = {
		Places = { "Lobby", "Run" },
		DisplayOrder = 5,
		Paths = {
			"Dim",
			"Cabinet.Backplate",
			"Cabinet.DockPlates",
			"Cabinet.TopBar.Title.Text",
			"Cabinet.TopBar.Subtitle",
			"Cabinet.TopBar.Chips",
			"Cabinet.TopBar.Close",
			"Cabinet.Pages",
			"Cabinet.MainAction.Content.Label",
			"Cabinet.MainAction.Content.Icon",
			"Cabinet.MainAction.Content.Price",
			"Cabinet.Footer.Actions",
			"Cabinet.Footer.Hint",
			"Cabinet.Footer.Keys",
			"Templates.Page.Tabs",
			"Templates.Page.Content.Grid",
			"Templates.Page.Content.List",
			"Templates.Page.Content.Empty",
			"Templates.Page.Detail.Hero.Image",
			"Templates.Page.Detail.Tag",
			"Templates.Page.Detail.Name",
			"Templates.Page.Detail.Sub",
			"Templates.Page.Detail.Body",
			"Templates.Tab.Content.Icon",
			"Templates.Tab.Content.Label",
			"Templates.Chip.Icon",
			"Templates.Chip.Amount",
			"Templates.Card.Portrait",
			"Templates.Card.Tag",
			"Templates.Card.Name",
			"Templates.Card.Sub",
			"Templates.Card.Lamp",
			"Templates.Card.Price.Amount",
			"Templates.Card.Stamp",
			"Templates.Row.Icon",
			"Templates.Row.Name",
			"Templates.Row.Value",
			"Templates.Section.Label",
			"Templates.Section.Body",
			"Templates.FooterButton.Content.Label",
			-- the Command View (Prompt 7)
			"DamageEdge",
			"Cabinet.Pages.CommandView.Tabs",
			"Cabinet.Pages.CommandView.View.Marks",
			"Cabinet.Pages.CommandView.View.Labels",
			"Cabinet.Pages.CommandView.View.Cursor",
			"Cabinet.Pages.CommandView.View.Help.Text",
			"Cabinet.Pages.CommandView.Detail.Name",
			"Cabinet.Pages.CommandView.Detail.Sub",
			"Cabinet.Pages.CommandView.Detail.Body",
			"Cabinet.Pages.CommandView.Detail.Options",
			"Templates.RoomLabel.Name",
			"Templates.RoomLabel.Lamp",
			"Templates.RoomLabel.Reading", -- Prompt 9: the overlay reading under a room label
			"Templates.RoomLabel.Reading.Text",
			"Templates.CellMark.Label",
			"Templates.PingMark",
			"Templates.OptionRow.Name",
			"Templates.OptionRow.Value",
			"Templates.OptionRow.Lamp",
		},
	},
	Votes = { -- the vote telegram (Prompt 8), above The Frame so a vote can be answered from any screen
		Places = { "Run" },
		DisplayOrder = 6,
		Paths = {
			"VoteBanner",
			"VoteBanner.Proposal",
			"VoteBanner.Tally",
			"VoteBanner.Timer",
			"VoteBanner.Timer.Fill",
			"VoteBanner.Yes",
			"VoteBanner.Yes.Content.Label",
			"VoteBanner.Yes.Key", -- Prompt 9: the controller's key chips (tap Y, hold Y)
			"VoteBanner.Yes.Key.Text",
			"VoteBanner.No",
			"VoteBanner.No.Content.Label",
			"VoteBanner.No.Key",
			"VoteBanner.No.Key.Text",
			"VoteBanner.Reroll", -- Prompt 19: the free blueprint reroll,
			"VoteBanner.Reroll.Content.Label",
			"Draft", -- Prompt 19: the blueprint draft's cards,
			"Draft.Cards",
			"Draft.Cards.Card1",
			"Draft.Cards.Card1.Title",
			"Draft.Cards.Card1.Text",
			"Draft.Cards.Card1.Votes",
			"Draft.Cards.Card1.Votes.Count",
			"Draft.Cards.Card1.Pick",
			"Draft.Cards.Card1.Pick.Ribbon.Label",
			"Draft.Cards.Card1.Won",
			"Draft.Cards.Card1.Found",
			"Draft.Cards.Card1.FoundBy",
			"Draft.Cards.Card2",
			"Draft.Cards.Card2.Title",
			"Draft.Cards.Card2.Text",
			"Draft.Cards.Card2.Votes",
			"Draft.Cards.Card2.Votes.Count",
			"Draft.Cards.Card2.Pick",
			"Draft.Cards.Card2.Pick.Ribbon.Label",
