]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX00000089"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000073"><Properties><string name="Name">ClientBootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ClientBootstrap: the only LocalScript (bible Section 23). It loads every controller in
	the Controllers folder beside it, runs every Init in dependency order and then every
	Start, waits for the server to be ready and tells it the client is ready (ClientReady),
	which makes the server send the replication snapshot.

	Never add another LocalScript: write a controller (see Documentation.ARCHITECTURE).
]]

local began = os.clock()

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Utilities = Shared:WaitForChild("Utilities")
local Loader = require(Utilities:WaitForChild("Loader"))
local Log = require(Utilities:WaitForChild("Log"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local SERVER_WAIT_SECONDS = 30

local log = Log.new("ClientBootstrap")

local controllers = Loader.Collect(script.Parent:WaitForChild("Controllers"), "Controller")
local report = Loader.Run(controllers, log)

local waited = 0
while ReplicatedStorage:GetAttribute("ServerReady") ~= true and waited < SERVER_WAIT_SECONDS do
	waited += task.wait(0.1)
end
if ReplicatedStorage:GetAttribute("ServerReady") ~= true then
	log:Warn("the server isn't ready after %d s; continuing", SERVER_WAIT_SECONDS)
end

Remotes.FireServer("ClientReady")
log:Info(
	"client ready: %d controllers (%s) in %.1f ms",
	#report.Order,
	table.concat(report.Order, ", "),
	(os.clock() - began) * 1000
)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000082"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX00000075"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CameraController: the over-the-shoulder camera (bible Sections 9 and 26: "wall fade and zoom
	caps built and tested in prompt 5, before anything depends on them").

	* Over the right shoulder by default; SwapShoulder (V, the right stick click, the HUD's
	  Shoulder button) moves it to the other side in ShoulderSwapSeconds.
	* Aim (right mouse, the left trigger, the HUD's Aim button; Run place only) narrows the
	  field of view from 70 to 50 (Tuning.Player.AimFieldOfView), brings the camera in to
	  AimDistance, slows walking to AimWalkSpeed (Lib.Movement) and turns the character to where
	  the camera looks. Face(reason, on) turns it the same way without aiming (firing from the
	  hip, a swing; Prompt 11), and Nudge(yaw, pitch) turns the camera a little (recoil, aim
	  assist). Shake(seconds, degrees) shakes it (Prompt 14: a Tremor).
	* Zoom (the wheel, a pinch) between Distance.Min and Distance.Max, capped at IndoorMax while
	  the character is in a bunker cell.
	* Zoom caps: a spherecast from the shoulder keeps the camera out of walls, slabs and rock: it
	  pulls in at once and eases back out. In a bunker cell the camera also stays between the
	  floor and the ceiling panels, sliding in along its view (Shafts are open overhead).
	* Wall fade: front walls (FrontWall tag) and furniture (CameraFade tag) never stop the
	  camera; when they stand between the camera and the character, or touch the camera, they
	  fade (Lib.Fade, this client only). So the camera can stand outside a room's open front.
	  Characters and anything tagged CameraIgnore are passed through.
	* The local character fades as the camera comes within CharacterFadeDistance of the head.
	* PC: the mouse is locked to the centre with the cursor hidden and the Reticle shown; any
	  controller frees the cursor with FreeCursor(reason, true) (menus, the Command View).
	* Other views take the camera with Suspend(reason) and give it back with Resume(reason).
	* Fallback: if the update errors ErrorsBeforeFallback times in a row, the controller stops
	  and hands the camera to Roblox's default camera, which the places set to Invisicam
	  (StarterPlayer.DevCameraOcclusionMode).
]]

local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CameraRig = require(Shared.Rules.CameraRig)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local Fade = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Fade"))
local Movement = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Movement"))

local log = Log.new("CameraController")

local FRONT_WALL_TAG = "FrontWall"
local FADE_TAG = "CameraFade"
local IGNORE_TAG = "CameraIgnore"
local FADE_SOURCE = "Camera"
local RENDER_NAME = "100Y_Camera"
local RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 1
local MAX_FADE_HITS = 4
local PIVOT_LAG = 2 -- the smoothed pivot never trails the head by more than this (studs)

local CameraController = {
	Name = "CameraController",
	Dependencies = { "InputController", "ReplicaController" },
	ShoulderChanged = Signal.new() :: Signal.Signal<number>,
	AimChanged = Signal.new() :: Signal.Signal<boolean>,
}

local input: any = nil
local replica: any = nil
local t: { [string]: any } = {}
local aimFieldOfView = 50
local aimZoom = 1 -- the Marksman's level 2 (AimZoom, Prompt 20): aiming zooms this much further
local inRun = false

local yaw = 0
local pitch = 0
local side = 1 -- 1: right shoulder, -1: left
local sideBlend = 1
local aiming = false
local aimBlend = 0
local wanted = 9 -- the zoom the player chose
local distance = 9 -- the camera's distance this frame
local pivotY: number? = nil
local sensitivity = 1
local suspended: { [string]: boolean } = {}
local cursorFree: { [string]: boolean } = {}
local errors = 0
local stopped = false
local wasActive = false
local faded: { [BasePart]: boolean } = {}
local characterFade = 0
local fadedCharacter: Model? = nil
local walkHumanoid: Humanoid? = nil
local slowed = false
local turned = false
local facers: { [string]: boolean } = {}
local reticle: { Gui: ScreenGui, Hip: GuiObject?, Aim: GuiObject? }? = nil
local lastFrame = { Distance = 0, Blocked = false, Indoors = false, Fading = 0, Position = Vector3.zero }

local blockParams = RaycastParams.new()
blockParams.FilterType = Enum.RaycastFilterType.Exclude
blockParams.IgnoreWater = true
local fadeParams = RaycastParams.new()
fadeParams.FilterType = Enum.RaycastFilterType.Include
fadeParams.IgnoreWater = true
local nearParams = OverlapParams.new()
nearParams.FilterType = Enum.RaycastFilterType.Include
local filtersDirty = true

-- Filters ------------------------------------------------------------------------------------

-- The camera passes through characters, CameraIgnore, CameraFade and front walls; it fades
-- the last two.
local function rebuildFilters()
	filtersDirty = false
	local passThrough: { Instance } = {}
	local fadeable: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(passThrough, player.Character)
		end
	end
	for _, item in CollectionService:GetTagged(IGNORE_TAG) do
		table.insert(passThrough, item)
	end
	for _, tag in { FADE_TAG, FRONT_WALL_TAG } do
		for _, item in CollectionService:GetTagged(tag) do
			table.insert(passThrough, item)
			table.insert(fadeable, item)
		end
	end
	blockParams.FilterDescendantsInstances = passThrough
	fadeParams.FilterDescendantsInstances = fadeable
	nearParams.FilterDescendantsInstances = fadeable
end

local function markDirty()
	filtersDirty = true
end

-- Fading -------------------------------------------------------------------------------------

-- A front wall fades as a whole piece; anything else fades alone.
local function fadeGroup(part: BasePart, into: { [BasePart]: number }, amount: number)
	if CollectionService:HasTag(part, FRONT_WALL_TAG) then
		local parent = part.Parent
		if parent and parent:IsA("Model") then
			for _, sibling in parent:GetChildren() do
				if sibling:IsA("BasePart") and CollectionService:HasTag(sibling, FRONT_WALL_TAG) then
					into[sibling] = math.max(into[sibling] or 0, t.FrontWallTransparency)
				end
			end
		end
		into[part] = math.max(into[part] or 0, t.FrontWallTransparency)
		return
	end
	into[part] = math.max(into[part] or 0, amount)
end

-- Fadeable parts on the lines from the camera to points on the character.
local function occluders(from: Vector3, targets: { Vector3 }, into: { [BasePart]: number })
	for _, target in targets do
		local origin = from
		for _ = 1, MAX_FADE_HITS do
			local delta = target - origin
			if delta.Magnitude < 0.05 then
				break
			end
			local hit = workspace:Raycast(origin, delta, fadeParams)
			if not hit then
				break
			end
			local part = hit.Instance
			if part:IsA("BasePart") then
				fadeGroup(part, into, t.FadeTransparency)
			end
			origin = hit.Position + delta.Unit * 0.05
		end
	end
end

local function applyFades(now: { [BasePart]: number })
	for part in faded do
		if now[part] == nil then
			Fade.Clear(part, FADE_SOURCE)
			faded[part] = nil
		end
	end
	for part, amount in now do
		Fade.Set(part, FADE_SOURCE, amount)
		faded[part] = true
	end
end

local function clearFades()
	Fade.ClearSource(FADE_SOURCE)
	table.clear(faded)
end

local function fadeCharacter(character: Model?, amount: number)
	if character ~= fadedCharacter then
		characterFade = -1
		fadedCharacter = character
	end
	if not character or math.abs(amount - characterFade) < 0.01 then
		return
	end
	characterFade = amount
	for _, item in character:GetDescendants() do
		if item:IsA("BasePart") or item:IsA("Decal") then
			local target: any = item
			target.LocalTransparencyModifier = amount
		end
	end
end

-- Mouse, reticle, walking --------------------------------------------------------------------

local function active(): boolean
	return not stopped and next(suspended) == nil
end

-- Shake (Prompt 14: a Tremor): a small turn that fades over the seconds given.
local shakeUntil, shakeSeconds, shakeDegrees = 0, 0, 0

local function shakeOffset(): CFrame
	local left = shakeUntil - os.clock()
	if left <= 0 then
		return CFrame.identity
	end
	local k = shakeDegrees * (left / math.max(shakeSeconds, 0.01))
	local t = os.clock() * 31
	return CFrame.Angles(math.rad(math.noise(t, 0.5) * k * 2), math.rad(math.noise(t, 7.5) * k * 2), 0)
end

local function updateMouse()
	local locked = active() and next(cursorFree) == nil and input:Device() ~= "Touch" and not GuiService.MenuIsOpen
	local behavior = if locked then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	if UserInputService.MouseBehavior ~= behavior then
		UserInputService.MouseBehavior = behavior
	end
	if UserInputService.MouseIconEnabled == locked then
		UserInputService.MouseIconEnabled = not locked
	end
end

local function findReticle()
	local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local gui = playerGui and playerGui:FindFirstChild("Reticle")
	if gui and gui:IsA("ScreenGui") then
		local hip = gui:FindFirstChild("Hip", true)
		local aim = gui:FindFirstChild("Aim", true)
		reticle = {
			Gui = gui,
			Hip = if hip and hip:IsA("GuiObject") then hip else nil,
			Aim = if aim and aim:IsA("GuiObject") then aim else nil,
		}
	else
		reticle = nil
	end
end

local function updateReticle()
	local current = reticle
	if not current or current.Gui.Parent == nil then
		findReticle()
		current = reticle
	end
	if not current then
		return
	end
	local show = active() and next(cursorFree) == nil
	if current.Gui.Enabled ~= show then
		current.Gui.Enabled = show
	end
	local aimed = aimBlend >= 0.5
	if current.Hip and current.Hip.Visible ~= (inRun and not aimed) then
		current.Hip.Visible = inRun and not aimed
	end
	if current.Aim and current.Aim.Visible ~= (inRun and aimed) then
		current.Aim.Visible = inRun and aimed
	end
end

-- Aiming slows walking (Lib.Movement); aiming and Face() turn the character with the camera.
local function updateWalking(humanoid: Humanoid, root: BasePart)
	if humanoid ~= walkHumanoid then
		walkHumanoid = humanoid
		slowed = false
		turned = false
		Movement.Apply()
	end
	if aiming ~= slowed then
		slowed = aiming
		Movement.Set("Aim", if aiming then t.AimWalkSpeed else nil)
	end
	local facing = aiming or next(facers) ~= nil
	if facing ~= turned then
		turned = facing
		humanoid.AutoRotate = not facing
	end
	if facing then
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	end
end

local function releaseWalking()
	local humanoid = walkHumanoid
	if humanoid and turned and humanoid.Parent then
		humanoid.AutoRotate = true
	end
	Movement.Set("Aim", nil)
	slowed = false
	turned = false
end

-- Is the cell at this point a Shaft (open overhead for the stair)?
local function inShaft(point: Vector3): boolean
	local floor, column = Grid.CellAt(point)
	if not floor or not column then
		return false
	end
	local cell = replica:Get("Cells", Grid.Key(floor, column))
	local roomId = if type(cell) == "table" then cell.Room else nil
	local room = if type(roomId) == "string" then replica:Get("Rooms", roomId) else nil
	return type(room) == "table" and room.Type == "Shaft"
end

-- The frame ----------------------------------------------------------------------------------

local function step(dt: number)
	updateMouse()
	updateReticle()
	if not active() then
		if wasActive then
			wasActive = false
			clearFades()
			releaseWalking()
			fadeCharacter(fadedCharacter, 0)
		end
		input:TakeLook(dt)
		input:TakeZoom()
		return
	end
	wasActive = true
	local camera = workspace.CurrentCamera
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = humanoid and humanoid.RootPart
	if not camera or not character or not humanoid or not root then
		input:TakeLook(dt)
		input:TakeZoom()
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	if filtersDirty then
		rebuildFilters()
	end

	-- Look, shoulder and aim
	local turn = input:TakeLook(dt) * sensitivity * (1 + (t.AimSensitivity - 1) * aimBlend)
	yaw -= math.rad(turn.X)
	pitch = CameraRig.ClampPitch(pitch - math.rad(turn.Y))
	sideBlend = CameraRig.MoveToward(sideBlend, side, dt * 2 / math.max(t.ShoulderSwapSeconds, 1e-3))
	aimBlend = CameraRig.MoveToward(aimBlend, if aiming then 1 else 0, dt / math.max(t.AimBlendSeconds, 1e-3))

	-- The pivot: head height, its height smoothed a little (stairs)
	local head = root.Position + Vector3.new(0, t.PivotHeight, 0)
	local smoothY = if pivotY then CameraRig.Approach(pivotY, head.Y, t.PivotFollowPerSecond, dt) else head.Y
	pivotY = math.clamp(smoothY, head.Y - PIVOT_LAG, head.Y + PIVOT_LAG)
	local pivot = Vector3.new(head.X, pivotY :: number, head.Z)

	-- Indoors: the bunker cell the character is in
	local low: number?, high: number? = nil, nil
	if inRun then
		low, high = CameraRig.CellHeights(pivot)
	end
	local indoors = low ~= nil
	if indoors and inShaft(pivot) then
		high = nil -- the Shaft is open overhead (the stair goes up through it)
	end

	-- Zoom
	local nearest, farthest = CameraRig.ZoomRange(indoors)
	local zoomInput = input:TakeZoom()
	if zoomInput ~= 0 then
		wanted = math.clamp(math.min(wanted, farthest) + zoomInput, nearest, if indoors then farthest else t.Distance.Max)
	end
	local zoomGoal = math.clamp(wanted, nearest, farthest)
	local goal = zoomGoal + (math.min(t.AimDistance, zoomGoal) - zoomGoal) * aimBlend

	-- The focus beside the head, kept out of a wall the character stands against
	local shoulder = t.ShoulderOffset * (1 + (t.AimShoulder - 1) * aimBlend)
	local focus = CameraRig.Focus(pivot, yaw, sideBlend, shoulder, t.ShoulderRaise)
	local toFocus = focus - pivot
	if toFocus.Magnitude > 1e-3 then
		local hit = workspace:Spherecast(pivot, t.CollisionRadius * 0.75, toFocus, blockParams)
		if hit then
			focus = pivot + toFocus.Unit * math.max(0, hit.Distance - t.WallMargin)
		end
	end

	-- How far back the camera can go: walls and rock, then the cell's floor and ceiling
	local rotation = CameraRig.Rotation(yaw, pitch)
	local look = rotation.LookVector
	local allowed = goal
	local blocked = false
	local hit = workspace:Spherecast(focus, t.CollisionRadius, -look * goal, blockParams)
	if hit then
		allowed = math.max(t.NearestDistance, hit.Distance - t.WallMargin)
		blocked = true
	end
	if indoors then
		local limit = CameraRig.HeightLimit(focus, look, low :: number, high or math.huge)
		if limit < allowed then
			allowed = math.max(t.NearestDistance, limit)
			blocked = true
		end
	end
	if allowed < distance then
		distance = allowed -- pull in at once
	else
		distance = CameraRig.Approach(distance, allowed, t.EaseOutPerSecond, dt)
	end

	local position = focus - look * distance
	camera.CFrame = CFrame.new(position) * rotation * shakeOffset()
	camera.Focus = CFrame.new(focus)
	local aimFov = if aimZoom ~= 1
		then math.deg(2 * math.atan(math.tan(math.rad(aimFieldOfView) / 2) / aimZoom))
		else aimFieldOfView
	camera.FieldOfView = t.FieldOfView + (aimFov - t.FieldOfView) * aimBlend

	-- Wall fade: between the camera and the character, and touching the camera
	local fades: { [BasePart]: number } = {}
	occluders(position, { head, root.Position, focus }, fades)
	for _, part in workspace:GetPartBoundsInRadius(position, t.NearFadeRadius, nearParams) do
		fadeGroup(part, fades, 1)
	end
	applyFades(fades)

	-- The character fades when the camera is at its head
	local gap = (position - head).Magnitude
	local closeness = math.clamp((t.CharacterFadeDistance - gap) / (t.CharacterFadeDistance * 0.5), 0, 1)
	fadeCharacter(character, closeness)

	updateWalking(humanoid, root)

	lastFrame.Distance = distance
	lastFrame.Blocked = blocked
	lastFrame.Indoors = indoors
	lastFrame.Fading = Fade.Count(FADE_SOURCE)
	lastFrame.Position = position
end

local function onRender(dt: number)
	if stopped then
		return
	end
	local ok, err = pcall(step, dt)
	if ok then
		errors = 0
		return
	end
	errors += 1
	log:Warn("camera update failed (%d): %s", errors, tostring(err))
	if errors >= t.ErrorsBeforeFallback then
		stopped = true
		clearFades()
		releaseWalking()
		local camera = workspace.CurrentCamera
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = t.FieldOfView
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		log:Error("the over-the-shoulder camera stopped; Roblox's camera (Invisicam) takes over")
	end
end

-- API ----------------------------------------------------------------------------------------

function CameraController:SwapShoulder()
	side = -side
	CameraController.ShoulderChanged:Fire(side)
end

function CameraController:SetShoulder(value: number)
	local wantedSide = if value < 0 then -1 else 1
	if wantedSide ~= side then
		CameraController:SwapShoulder()
	end
end

function CameraController:SetAiming(on: boolean)
	local value = on and inRun and active() and next(cursorFree) == nil
	if value == aiming then
		return
	end
	aiming = value
	CameraController.AimChanged:Fire(value)
end

function CameraController:IsAiming(): boolean
	return aiming
end

-- Turn the character to where the camera looks while `reason` holds (firing from the hip, a
-- melee swing), without aiming's zoom.
function CameraController:Face(reason: string, on: boolean)
	facers[reason] = if on then true else nil
end

-- Turn the camera by a few degrees (recoil kicks it up; aim assist pulls it toward a target).
-- Shake the over-the-shoulder camera for `seconds`, up to `degrees` (Prompt 14: Tremors).
function CameraController:Shake(seconds: number, degrees: number)
	shakeUntil = os.clock() + seconds
	shakeSeconds = seconds
	shakeDegrees = degrees
end

function CameraController:Nudge(yawDegrees: number, pitchDegrees: number)
	yaw += math.rad(yawDegrees)
	pitch = CameraRig.ClampPitch(pitch + math.rad(pitchDegrees))
end

-- Where the camera looks, as a ray from the camera (what the reticle covers).
function CameraController:AimRay(): Ray?
	local camera = workspace.CurrentCamera
	if not camera then
		return nil
	end
	local size = camera.ViewportSize
	return camera:ViewportPointToRay(size.X / 2, size.Y / 2)
end

-- Point the camera (degrees): yaw 0 looks toward -Z, pitch below 0 looks down.
function CameraController:SetLook(yawDegrees: number, pitchDegrees: number)
	yaw = math.rad(yawDegrees)
	pitch = CameraRig.ClampPitch(math.rad(pitchDegrees))
end

-- Prompt 20: the Marksman's level 2 zooms further when aiming (1 is the usual zoom).
function CameraController:SetAimZoom(multiplier: number)
	aimZoom = math.clamp(multiplier, 0.25, 4)
end

function CameraController:SetZoom(studs: number)
	wanted = math.clamp(studs, t.Distance.Min, t.Distance.Max)
end

-- A sensitivity multiplier from the player's settings (Settings screen, later).
function CameraController:SetSensitivity(value: number)
	sensitivity = math.clamp(value, 0.1, 4)
end

-- Another view takes the camera (the Command View, a cutscene) until Resume(reason).
function CameraController:Suspend(reason: string)
	suspended[reason] = true
end

function CameraController:Resume(reason: string)
	suspended[reason] = nil
end

-- A menu frees the mouse cursor while it is open.
function CameraController:FreeCursor(reason: string, on: boolean)
	cursorFree[reason] = if on then true else nil
end

function CameraController:State(): { [string]: any }
	return {
		Active = active(),
		Stopped = stopped,
		Yaw = math.deg(yaw) % 360,
		Pitch = math.deg(pitch),
		Shoulder = if side > 0 then "right" else "left",
		Aiming = aiming,
		Wanted = wanted,
		Distance = lastFrame.Distance,
		Blocked = lastFrame.Blocked,
		Indoors = lastFrame.Indoors,
		Fading = lastFrame.Fading,
		Position = lastFrame.Position,
		FieldOfView = if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView else 0,
		Device = input:Device(),
		Suspended = next(suspended) ~= nil,
		CursorFree = next(cursorFree) ~= nil,
	}
end

-- Lifecycle ----------------------------------------------------------------------------------

function CameraController:Init(registry)
	input = registry.InputController
	replica = registry.ReplicaController
	t = CameraRig.Tuning()
	aimFieldOfView = Config.Get("Tuning", "Player").AimFieldOfView[2]
	inRun = Constants.PlaceKind() == "Run"
	pitch = math.rad(t.StartPitch)
	wanted = t.Distance.Default
	distance = wanted
	Fade.SetSeconds(t.FadeSeconds)
end

function CameraController:Start()
	input:On("SwapShoulder", function()
		CameraController:SwapShoulder()
	end)
	input:On("Aim", function()
		CameraController:SetAiming(true)
	end, function()
		CameraController:SetAiming(false)
	end)

	for _, tag in { FADE_TAG, FRONT_WALL_TAG, IGNORE_TAG } do
		CollectionService:GetInstanceAddedSignal(tag):Connect(markDirty)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(markDirty)
	end
	local function watch(player: Player)
		player.CharacterAdded:Connect(markDirty)
		player.CharacterRemoving:Connect(markDirty)
	end
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(markDirty)

	-- A new character looks the way it spawned facing
	local function faceSpawn(character: Model)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and root:IsA("BasePart") then
			local lookVector = root.CFrame.LookVector
			yaw = math.atan2(-lookVector.X, -lookVector.Z)
			pitch = math.rad(t.StartPitch)
			pivotY = nil
			distance = math.min(wanted, select(2, CameraRig.ZoomRange(inRun)))
		end
		aiming = false
		aimBlend = 0
	end
	Players.LocalPlayer.CharacterAdded:Connect(faceSpawn)
	if Players.LocalPlayer.Character then
		task.spawn(faceSpawn, Players.LocalPlayer.Character)
	end

	RunService:BindToRenderStep(RENDER_NAME, RENDER_PRIORITY, onRender)
	log:Debug("over-the-shoulder camera on (%s)", if inRun then "Run" else "Lobby")
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000076"><Properties><string name="Name">ClassShopController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ClassShopController: the Class Shop and Loadout screens (bible Section 18: "Class Shop | Today's
	shop, owned, all | Class cards | Kit, levels, price; Buy" and "Loadout | Class, talents, Legend,
	cosmetics | Owned items | Selected item; Equip"; the rules are Section 14's). Lobby only; Prompt
	21. Both are pages of The Frame (UIController); the server decides everything (ClassShopService).

	Class Shop
	* TODAY: today's four classes. A card shows its price; one the player bought since is stamped
	  OWNED, today's free trial FREE TRIAL, the wish WISHLIST. The main action buys (greyed out with
	  the Glowshards still needed), or TRY IT FREE equips the trial.
	* OWNED: every class the player owns, with its level. The main action equips.
	* ALL: the whole catalogue. A class not in today's shop can be wishlisted (the main action).
	* Chips: Glowshards, and the time to the daily reset. Footer (two buttons at most: the Frame's
	  footer has room for no more beside its hint): TRY IT FREE TODAY on the day's trial class, else
	  WISHLIST on a class in the shop the player can't or won't buy yet; then REROLL on the TODAY
	  tab (free while one is left, then the Robux price), else LOADOUT.

	Loadout (class only until talents, Legends and cosmetics arrive with their prompts)
	* The classes the player can bring: owned ones, and today's free trial. EQUIP sets it
	  (SetLoadoutClass); the equipped one's lamp is lit.

	Everything shown comes from the player's own profile (the Profiles collection: Classes,
	ClassShop, Loadout, Glowshards) and the Player's ShopDay and VIP attributes; the screens refill
	whenever the profile changes.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ClassShop = require(Shared.Rules.ClassShop)
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)
local Lib = script.Parent.Parent:WaitForChild("Lib")
local ClassArt = require(Lib:WaitForChild("ClassArt"))

local player = Players.LocalPlayer

local ClassShopController = {
	Name = "ClassShopController",
	Dependencies = { "UIController", "ReplicaController" },
}

local ui: any = nil
local replica: any = nil

local selected: { [string]: string? } = {} -- per screen: the class whose detail shows

local function profile(): any
	local found = replica:Get("Profiles", tostring(player.UserId))
	return if type(found) == "table" and type(found.Classes) == "table" and type(found.ClassShop) == "table" then found else nil
end

local function shopDay(): number
	local day = player:GetAttribute("ShopDay")
	return if type(day) == "number" then day else ClassShop.Day(workspace:GetServerTimeNow())
end

local function clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d:%02d", seconds // 3600, seconds // 60 % 60, seconds % 60)
end

local function resetIn(): number
	local at = ReplicatedStorage:GetAttribute("ShopResetAt")
	return if type(at) == "number" then at - workspace:GetServerTimeNow() else ClassShop.SecondsToReset(workspace:GetServerTimeNow())
end

local function chips()
	local data = profile()
	ui:SetChips({
		{ Icon = "Icon_Glowshard", Text = if data then tostring(data.Glowshards) else "—" },
		{ Icon = "Icon_Route", Text = clock(resetIn()) }, -- to the daily reset
	})
end

local function showDetail(page: Frame, classId: string, level: number?, sub: string)
	local class = Config.Get("Classes", classId)
	local detail: any = page:FindFirstChild("Detail")
	local hero = ClassArt.Portrait(classId, true)
	local heroImage: any = detail.Hero:FindFirstChild("Image")
	heroImage.Visible = true
	ui:SetSprite(heroImage, hero or ClassArt.Icon(classId))
	heroImage.ScaleType = if hero then Enum.ScaleType.Stretch else Enum.ScaleType.Fit
	ui:SetRarity(detail, ClassArt.Rarity(classId))
	detail:FindFirstChild("Name").Text = string.upper(class.Name)
	detail.Sub.Text = sub
	local body = ui:Clear(detail.Body)
	for i, section in ClassArt.Sections(classId, level) do
		local s = ui:Clone("Section")
		s.LayoutOrder = i
		s.Label.Text = string.upper(section.Label)
		s.Body.Text = section.Text
		s.Parent = body
	end
end

local function makeCard(grid: Instance, classId: string, order: number, stamp: string?, price: number?, sub: string): any
	local class = Config.Get("Classes", classId)
	local card: any = ui:Clone("Card")
	card.Name = classId
	card.LayoutOrder = order
	ui:SetRarity(card, ClassArt.Rarity(classId))
	local face = ClassArt.Portrait(classId, false)
	card.Portrait.Visible = true
	ui:SetSprite(card.Portrait, face or ClassArt.Icon(classId))
	card.Portrait.ScaleType = if face then Enum.ScaleType.Stretch else Enum.ScaleType.Fit -- an icon until its look is made
	card:FindFirstChild("Name").Text = string.upper(class.Name)
	card.Sub.Text = sub
	card.Price.Visible = price ~= nil
	if price then
		card.Price.Amount.Text = tostring(price)
	end
	card.Stamp.Visible = stamp ~= nil
	if stamp then
		ui:SetSprite(card.Stamp, stamp)
	end
	card.Parent = grid
	return card
end

-- The Class Shop ------------------------------------------------------------------------------------

local function shopAction(page: Frame, classId: string, tabId: string)
	local data = profile()
	if not data then
		return
	end
	local class = Config.Get("Classes", classId)
	local day = shopDay()
	local shop = data.ClassShop
	local owned = data.Classes[classId]
	local trial = ClassShop.Trial(shop, data.Classes, day)
	local inShop = shop.Day == day and table.find(shop.Slots, classId) ~= nil
	local equipped = data.Loadout and data.Loadout.Class == classId
	local sub = string.format("%s  ·  %s", string.upper(class.Tier), if owned then `LEVEL {owned.Level}`
		elseif trial == classId then (if equipped then "FREE TRIAL · EQUIPPED" else "TODAY'S FREE TRIAL")
		elseif class.Price > 0 then `{class.Price} GLOWSHARDS` else "FREE")
	showDetail(page, classId, if owned then owned.Level else nil, sub)
	if owned then
		ui:SetMainAction({
			Label = if equipped then "Equipped" else "Equip",
			Enabled = not equipped,
			OnPress = function()
				Remotes.FireServer("SetLoadoutClass", classId)
			end,
		})
	elseif inShop then
		local short = class.Price - data.Glowshards
		ui:SetMainAction({
			Label = if short > 0 then `{short} more` else "Buy",
			Icon = "Icon_Glowshard",
			Price = tostring(class.Price),
			Enabled = short <= 0,
			OnPress = function()
				Remotes.FireServer("ShopBuy", classId)
			end,
		})
	else
		local wished = shop.Wishlist == classId
		ui:SetMainAction({
			Label = if wished then "Wishlisted" else "Wishlist",
			Enabled = class.Price > 0,
			OnPress = function()
				Remotes.FireServer("ShopWish", if wished then "" else classId)
			end,
		})
	end
	local footer = {} -- two at most: the footer has room for no more beside its hint
	if trial == classId and not equipped then
		table.insert(footer, { Label = "TRY IT FREE TODAY", OnPress = function()
			Remotes.FireServer("SetLoadoutClass", classId)
		end })
	elseif inShop and not owned and shop.Wishlist ~= classId then
		table.insert(footer, { Label = "WISHLIST", OnPress = function()
			Remotes.FireServer("ShopWish", classId)
		end })
	end
	if tabId == "Today" then
		local free = ClassShop.FreeLeft(shop, player:GetAttribute("VIP") == true)
		table.insert(footer, {
			Label = if free > 0 then `REROLL · {free} FREE` else `REROLL · R$ {Config.Get("Tuning", "ClassShop").RerollRobux}`,
			OnPress = function()
				Remotes.FireServer("ShopReroll")
			end,
		})
	end
	if #footer < 2 then
		table.insert(footer, { Label = "LOADOUT", OnPress = function()
			ui:Open("Loadout")
		end })
	end
	ui:SetFooterActions(footer)
end

local function fillShop(page: Frame, tabId: string)
	local data = profile()
	local content: any = page:FindFirstChild("Content")
	local grid = ui:Clear(content.Grid)
	if not data then
		content.Empty.Visible = true
		return
	end
	local day = shopDay()
	local shop = data.ClassShop
	local trial = ClassShop.Trial(shop, data.Classes, day)
	local ids: { string } = {}
	if tabId == "Today" then
		ids = if shop.Day == day then table.clone(shop.Slots) else {}
	elseif tabId == "Owned" then
		for _, id in Config.Ids("Classes") do
			if data.Classes[id] then
				table.insert(ids, id)
			end
		end
	else
		ids = table.clone(Config.Ids("Classes"))
	end
	local cards: { [string]: any } = {}
	for i, classId in ids do
		local class = Config.Get("Classes", classId)
		local owned = data.Classes[classId]
		local stamp = if owned then "Stamp_Owned" elseif trial == classId then "Stamp_FreeTrial"
			elseif shop.Wishlist == classId then "Stamp_Wishlist" else nil
		local sub = if owned then `LEVEL {owned.Level}  ·  {class.Ability.Name}` else class.Ability.Name
		local card = makeCard(grid, classId, i, stamp, if owned or class.Price <= 0 then nil else class.Price, sub)
		cards[classId] = card
		card.Activated:Connect(function()
			selected.ClassShop = classId
			for id, other in cards do
				ui:SetSprite(other.Lamp, if id == classId then "Lamp_Orange" else "Lamp_Off")
			end
			shopAction(page, classId, tabId)
		end)
	end
	content.Empty.Visible = #ids == 0
	local pick = selected.ClassShop
	if not pick or not cards[pick] then
		pick = ids[1]
	end
	selected.ClassShop = pick
	if pick then
		ui:SetSprite(cards[pick].Lamp, "Lamp_Orange")
		shopAction(page, pick, tabId)
	else
		ui:SetMainAction({ Label = "Buy", Enabled = false })
		ui:SetFooterActions({ { Label = "LOADOUT", OnPress = function()
			ui:Open("Loadout")
		end } })
	end
end

-- The Loadout ---------------------------------------------------------------------------------------

local function loadoutAction(page: Frame, classId: string)
	local data = profile()
	if not data then
		return
	end
	local class = Config.Get("Classes", classId)
	local owned = data.Classes[classId]
	local equipped = data.Loadout and data.Loadout.Class == classId
	showDetail(page, classId, if owned then owned.Level else 1, if owned then `LEVEL {owned.Level}  ·  {string.upper(class.Tier)}`
		else "TODAY'S FREE TRIAL  ·  LEVEL 1")
	ui:SetMainAction({
		Label = if equipped then "Equipped" else "Equip",
		Enabled = not equipped,
		OnPress = function()
			Remotes.FireServer("SetLoadoutClass", classId)
		end,
	})
end

local function fillLoadout(page: Frame)
	local data = profile()
	local content: any = page:FindFirstChild("Content")
	local grid = ui:Clear(content.Grid)
	if not data then
		content.Empty.Visible = true
		return
	end
	local trial = ClassShop.Trial(data.ClassShop, data.Classes, shopDay())
	local ids: { string } = {}
	for _, id in Config.Ids("Classes") do
		if data.Classes[id] or id == trial then
			table.insert(ids, id)
		end
	end
	local equippedId = data.Loadout and data.Loadout.Class
	local cards: { [string]: any } = {}
	for i, classId in ids do
		local owned = data.Classes[classId]
		local class = Config.Get("Classes", classId)
		local card = makeCard(grid, classId, i, if owned then nil else "Stamp_FreeTrial", nil,
			if owned then `LEVEL {owned.Level}  ·  {class.Ability.Name}` else class.Ability.Name)
		cards[classId] = card
		ui:SetSprite(card.Lamp, if classId == equippedId then "Lamp_Green" else "Lamp_Off")
		card.Activated:Connect(function()
			selected.Loadout = classId
			loadoutAction(page, classId)
		end)
	end
	content.Empty.Visible = #ids == 0
	local pick = selected.Loadout
	if not pick or not cards[pick] then
		pick = if equippedId and cards[equippedId] then equippedId else ids[1]
	end
	selected.Loadout = pick
	if pick then
		loadoutAction(page, pick)
	end
	ui:SetFooterActions({ { Label = "CLASS SHOP", OnPress = function()
		ui:Open("ClassShop")
	end } })
end

local function refill()
	local current = ui:Current()
	local page = ui:Page()
	if not page then
		return
	end
	if current == "ClassShop" then
		chips()
		fillShop(page, ui:CurrentTab() or "Today")
	elseif current == "Loadout" then
		chips()
		fillLoadout(page)
	end
end

function ClassShopController:Init(registry)
	ui = registry.UIController
	replica = registry.ReplicaController
end

function ClassShopController:Start()
	ui:Register("ClassShop", {
		Title = "Class Shop",
		Subtitle = "STEADFAST SHELTER CO.  ·  TODAY'S SPECIALISTS",
		Tabs = {
			{ Id = "Today", Label = "Today", Icon = "Icon_Tag" },
			{ Id = "Owned", Label = "Owned", Icon = "Icon_Check" },
			{ Id = "All", Label = "All", Icon = "Icon_Grid" },
		},
		Layout = "Grid",
		Hint = "Four classes you don't own, new every day at 00:00 UTC. Wishlist one and it turns up within 3 days.",
		OnOpen = function()
			chips()
		end,
		OnTab = function(tabId: string, page: Frame)
			fillShop(page, tabId)
		end,
	})
	ui:Register("Loadout", {
		Title = "Loadout",
		Subtitle = "STEADFAST SHELTER CO.  ·  WHO GOES DOWN TODAY",
		Tabs = { { Id = "Class", Label = "Class", Icon = "Icon_Crew" } },
		Layout = "Grid",
		Hint = "Your class comes with its kit. Talents, Legends and outfits join the loadout later.",
		OnOpen = function()
			chips()
		end,
		OnTab = function(_tabId: string, page: Frame)
			fillLoadout(page)
		end,
	})
	replica:Changed("Profiles"):Connect(function()
		refill()
	end)
	player:GetAttributeChangedSignal("ShopDay"):Connect(refill)
	task.spawn(function()
		while true do
			task.wait(1)
			local current = ui:Current()
			if current == "ClassShop" or current == "Loadout" then
				chips()
			end
		end
	end)
end

return ClassShopController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000077"><Properties><string name="Name">CommandViewController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CommandViewController: the Command View (bible Section 7), a flat side view of the whole
	bunker that any player opens with one button, anywhere, while the character stays in the
	world and can be hit. Run place only.

	* Open and close: the CommandView action (Tab, the console's View button, the HUD button).
	  It is The Frame in docked mode (Section 18): top bar, tab rail and detail panel, with the
	  live bunker in zone C (the page Cabinet.Pages.CommandView, built in Studio).
	* Camera: far away with a narrow field of view, looking at the bunker's front, so it reads
	  nearly flat. It opens centred on the character with a 0.3 s move and moves back over the
	  shoulder on close. Front walls fade out (Lib.Fade, source "CommandView") and the lighting
	  lifts a little so the rock reads. The character's controls are off while it's open.
	* Moving the view: drag (mouse or one finger), WASD or the arrow keys, the left stick; zoom
	  with the wheel, a pinch or the right stick.
	* Picking: click or tap a cell; on a gamepad, A picks the cell under the centre mark. The
	  detail panel shows a room (level, cells, condition, power, output; actions: upgrade, merge,
	  tear down), an open cell (the build menu: every room type with its cost, or why it's
	  locked) or rock (whether it can be dug, its band and ore).
	* Proposals go through handlers the votes set (SetHandler: "Build", "Upgrade", "Merge",
	  "TearDown"; Prompt 8). Without a handler the main action stays greyed out.
	* Overlays (tabs Power, Morale, Threat, Production) colour the room labels' lamps from
	  providers later systems register (SetOverlay); without one they read "no readings yet".
	* Ping: the footer's Ping button or the Ping key (G, the D-pad's up) pings the selected cell
	  (the PingCell remote); every player sees it here and on the mini-map.
	* Taking damage while the view is open flashes the screen edge red.

	* Status (Section 7: every room shows status icons: dark, wrecked, burning, flooded):
	  providers later systems register (SetStatus) give a room's lamp and reading ("ON FIRE")
	  whenever the overlay tab has nothing to say about it; a condition note (SetConditionNote)
	  adds to the room panel's Condition (Prompt 13).

	API for later prompts: SetHandler(action, fn(choice)), SetOverlay(name, provider),
	SetStatus(name, provider), SetConditionNote(fn), SetCellNotes(fn), SetRockOptions(fn) and
	Refresh() (Prompt 14: digging), ShowGhost(id, floor, column, span, label)
	and HideGhost(id) for open votes, Blink(key, on) for alerts, Select(floor, column), IsOpen(),
	State().
]]

local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local CollectionService = game:GetService("CollectionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Bunker = require(Shared.Rules.Bunker)
local CV = require(Shared.Rules.CommandView)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Construction = require(Shared.Rules.Construction)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local UIContract = require(Shared.UIContract)
local Lib = script.Parent.Parent:WaitForChild("Lib")
local Fade = require(Lib:WaitForChild("Fade"))
local KitRuntime = require(Lib:WaitForChild("KitRuntime"))

local log = Log.new("CommandViewController")

export type Choice = {
	Action: string, -- "Build", "Upgrade", "Merge", "TearDown"; "Assign", "Unassign", "AutoAssign", "MarkDig", "UnmarkDig" (no vote)
	Floor: number,
	Column: number,
	RoomType: string?, -- Build
	RoomId: string?, -- Upgrade, Merge, TearDown, Assign
	Other: string?, -- Merge: the room it joins
	Level: number?, -- Upgrade: the new level
	ResidentId: string?, -- Assign, Unassign
	Label: string?, -- Assign, Unassign: the main action's words
}
export type Overlay = (roomId: string, room: any) -> (string?, string?) -- lamp sprite, legend text

local SCREEN = "CommandView"
local FADE_SOURCE = "CommandView"
local FRONT_WALL_TAG = "FrontWall"
local RENDER_NAME = "100Y_CommandView"
local RENDER_PRIORITY = Enum.RenderPriority.Camera.Value - 1 -- before CameraController drains zoom input
local PING_ACTION = "100Y_CVPing"
local PICK_ACTION = "100Y_CVPick"
local HOLD_ACTION = "100Y_CVHold"
local TABS = {
	{ Id = "Build", Label = "Build", Icon = "Icon_Grid" },
	{ Id = "Power", Label = "Power", Icon = "Icon_Power" },
	{ Id = "Morale", Label = "Morale", Icon = "Icon_Check" },
	{ Id = "Threat", Label = "Threat", Icon = "Icon_Shield" },
	{ Id = "Production", Label = "Production", Icon = "Icon_Scrap" },
}
local OVERLAY_TEXT: { [string]: string } = { -- bible Section 7's overlays
	Power = "Green: lit. Red: dark for want of power. Rooms go dark farthest from the Reactor Core or a Generator first.",
	Morale = "Each room's workers' average morale. Green: Happy or better. Amber: Settled. Red: Unhappy or worse.",
	Threat = "Likely breach points.",
	Production = "What each room makes a cycle. Amber: no one works there. Red: dark or wrecked.",
}
local PAN_KEYS: { [Enum.KeyCode]: Vector2 } = {
	[Enum.KeyCode.W] = Vector2.new(0, 1),
	[Enum.KeyCode.Up] = Vector2.new(0, 1),
	[Enum.KeyCode.S] = Vector2.new(0, -1),
	[Enum.KeyCode.Down] = Vector2.new(0, -1),
	[Enum.KeyCode.A] = Vector2.new(-1, 0),
	[Enum.KeyCode.Left] = Vector2.new(-1, 0),
	[Enum.KeyCode.D] = Vector2.new(1, 0),
	[Enum.KeyCode.Right] = Vector2.new(1, 0),
}
local CREAM = Color3.fromHex("#F2E6C9")
local RUST = Color3.fromHex("#B5412B")

local CommandViewController = {
	Name = "CommandViewController",
	Dependencies = { "InputController", "CameraController", "UIController", "ReplicaController", "HUDController" },
	Opened = Signal.new() :: Signal.Signal<()>,
	Closed = Signal.new() :: Signal.Signal<()>,
	Selected = Signal.new() :: Signal.Signal<number?, number?>,
}

local input: any = nil
local cameraController: any = nil
local ui: any = nil
local replica: any = nil
local inRun = false

local t: { [string]: any } = {}
local open = false
local center = Vector2.zero -- the view's centre: world X and Y
local height = 60 -- studs of the bunker that fit the view's height
local gridZ = 0
local bounds: CV.Bounds = { Left = 0, Right = 0, Top = 0, Bottom = 0 }
local moving: { Alpha: number, From: CFrame, FromFov: number, To: (() -> (CFrame, number))?, Back: boolean, Done: (() -> ())? }? = nil
local before: { CFrame: CFrame, FieldOfView: number }? = nil
local lightingBefore: { [string]: any }? = nil
local selected: { number }? = nil
local choice: Choice? = nil
local tab = "Build"
local bunker: any = nil
local bunkerDirty = true
local labels: { [string]: any } = {}
local labelsDirty = true
local ghosts: { [string]: { Frame: any, Floor: number, Column: number, Span: number } } = {}
local pings: { { Frame: any, Floor: number, Column: number, Until: number } } = {}
local blinking: { [string]: boolean } = {}
local handlers: { [string]: (Choice) -> () } = {}
local overlays: { [string]: Overlay } = {}
local statuses: { [string]: Overlay } = {} -- Prompt 13: a room's status lamp when the overlay is silent
local conditionNote: ((string) -> string?)? = nil
-- Prompt 14: what digging says about a cell, and the dig queue's actions on rock
export type CellNote = { Title: string, Text: string }
export type CellOption = { Name: string, Value: string, Choice: Choice? }
local cellNotes: ((floor: number, column: number, state: string) -> { CellNote })? = nil
local rockOptions: ((floor: number, column: number) -> { CellOption })? = nil
local selectionMark: any = nil
local drag: { Start: Vector2, Last: Vector2, Moved: boolean, Touch: InputObject? }? = nil
local pinch: { [InputObject]: Vector2 } = {}
local lastHealth: number? = nil
local frontWalls: { [BasePart]: boolean } = {}
local connections: { RBXScriptConnection } = {}

-- Layout --------------------------------------------------------------------------------------

local function gui(): ScreenGui?
	return ui:Gui()
end

local function part(path: string): any
	local root = gui()
	assert(root, "CommandViewController: no Frame")
	local found = UIContract.Find(root, path)
	assert(found, `CommandViewController: Frame.{path} is missing (see Shared.UIContract)`)
	return found
end

local function page(): any
	return part("Cabinet.Pages.CommandView")
end

local function clone(template: string): any
	local copy = part("Templates." .. template):Clone()
	copy.Visible = true
	return copy
end

local function clear(container: Instance)
	for _, child in container:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

-- Screen and world ---------------------------------------------------------------------------

-- Zone C's rectangle in viewport pixels (GUI coordinates plus the top inset).
local function viewRect(): (Vector2, Vector2)
	local view = part("Cabinet.Pages.CommandView.View")
	local inset = GuiService:GetGuiInset()
	return view.AbsolutePosition + inset, view.AbsoluteSize
end

local function inView(point: Vector2): boolean
	local origin, size = viewRect()
	return point.X >= origin.X and point.Y >= origin.Y and point.X <= origin.X + size.X and point.Y <= origin.Y + size.Y
end

-- The camera for the current centre and zoom: far away along +Z, looking at the bunker's front,
-- shifted so the centre shows in the middle of zone C rather than the middle of the screen.
local function viewCFrame(): (CFrame, number)
	local camera = workspace.CurrentCamera
	local distance, fieldOfView = CV.Lens(height)
	local viewport = camera.ViewportSize
	local origin, size = viewRect()
	local zoneCentre = origin + size / 2
	local offset = zoneCentre - viewport / 2
	local perPixel = height / math.max(viewport.Y, 1)
	local position = Vector3.new(center.X - offset.X * perPixel, center.Y + offset.Y * perPixel, gridZ + distance)
	return CFrame.lookAt(position, position - Vector3.zAxis), fieldOfView
end

-- The cell under a viewport point: the ray meets the plane of the cells' centres.
local function cellAt(point: Vector2): (number?, number?)
	local ray = workspace.CurrentCamera:ViewportPointToRay(point.X, point.Y)
	if math.abs(ray.Direction.Z) < 1e-6 then
		return nil, nil
	end
	local along = (gridZ - ray.Origin.Z) / ray.Direction.Z
	if along <= 0 then
		return nil, nil
	end
	local floor, column = Grid.CellAt(ray.Origin + ray.Direction * along)
	if floor and column and Grid.OnGrid(floor, column) then
		return floor, column
	end
	return nil, nil
end

-- Cells from column to column + span - 1 on a floor (their interiors, floor to ceiling) in
-- zone C's scale.
local function cellRect(floor: number, column: number, span: number): (UDim2, UDim2, boolean)
	local camera = workspace.CurrentCamera
	local low, high = CV.CellBox(floor, column, span)
	local a = camera:WorldToViewportPoint(Vector3.new(low.X, high.Y, gridZ))
	local b = camera:WorldToViewportPoint(Vector3.new(high.X, low.Y, gridZ))
	local origin, size = viewRect()
	local x0, y0 = (math.min(a.X, b.X) - origin.X) / size.X, (math.min(a.Y, b.Y) - origin.Y) / size.Y
	local x1, y1 = (math.max(a.X, b.X) - origin.X) / size.X, (math.max(a.Y, b.Y) - origin.Y) / size.Y
	local visible = x1 > 0 and y1 > 0 and x0 < 1 and y0 < 1
	return UDim2.fromScale(x0, y0), UDim2.fromScale(x1 - x0, y1 - y0), visible
end

-- A world point in zone C's scale.
local function pointIn(world: Vector3): (UDim2, boolean)
	local p = workspace.CurrentCamera:WorldToViewportPoint(world)
	local origin, size = viewRect()
	local x, y = (p.X - origin.X) / size.X, (p.Y - origin.Y) / size.Y
	return UDim2.fromScale(x, y), x >= 0 and y >= 0 and x <= 1 and y <= 1
end

-- The bunker -----------------------------------------------------------------------------------

local function currentBunker(): any
	if bunkerDirty or not bunker then
		bunker = Bunker.FromSnapshot(replica:All("Cells"), replica:All("Rooms"))
		bunkerDirty = false
	end
	return bunker
end

local function context(): CV.Context
	local era = table.find(Config.Ids("Eras"), RunState.Get("Era") or "") or 1
	local unlocked = {}
	for roomType in replica:All("Unlocked") do
		unlocked[roomType] = true
	end
	return { Era = era, Deepest = currentBunker():DeepestFloor(), Unlocked = unlocked }
end

-- The stockpile as EconomyService replicates it (RunState, one value per resource).
local function stockNow(): { [string]: number }
	local stock = {}
	for _, id in Config.Ids("Resources") do
		if RunState.Fields[id] then
			local value = RunState.Get(id)
			if type(value) == "number" then
				stock[id] = value
			end
		end
	end
	return stock
end

local function covers(thing: any, floor: number, column: number): boolean
	return type(thing) == "table" and thing.Floor == floor and type(thing.Column) == "number"
		and column >= thing.Column and column < thing.Column + (thing.Span or 1)
end

-- The construction site on a cell (BuildService's Sites collection), if any.
local function siteAt(floor: number, column: number): any
	for _, site in replica:All("Sites") do
		if covers(site, floor, column) then
			return site
		end
	end
	return nil
end

-- The open vote (live or waiting) whose proposal covers a cell, if any.
local function voteAt(floor: number, column: number): any
	for _, vote in replica:All("Votes") do
		if type(vote) == "table" and (vote.Status == "Live" or vote.Status == "Queued") and covers(vote.Subject, floor, column) then
			return vote
		end
	end
	return nil
end

-- "120 SCRAP" when the stockpile can pay, else "120 SCRAP · 40 SHORT", and whether it can.
local function costLine(costs: { [string]: number }): (string, boolean)
	local ok, short, missing = Construction.CanAfford(costs, stockNow())
	if ok or not short then
		return CV.CostText(costs), true
	end
	return `{CV.CostText(costs)}  ·  {missing} {string.upper(Config.Get("Resources", short).Name)} SHORT`, false
end

local function roomName(roomType: string): string
	local info = Config.Find("Rooms", roomType)
	return if info then info.Name else roomType
end

-- Labels, marks and pings ---------------------------------------------------------------------

-- The overlay's lamp and reading for a room ("+8 FOOD", "DARK"), when an overlay tab is on.
local function overlayLamp(roomId: string, room: any): (string?, string?)
	if tab == "Build" then
		return nil, nil
	end
	local provider = overlays[tab]
	if not provider then
		return nil, nil
	end
	local ok, lamp, reading = pcall(provider, roomId, room)
	if ok then
		return lamp, reading
	end
	return nil, nil
end

local function rebuildLabels()
	labelsDirty = false
	local holder = part("Cabinet.Pages.CommandView.View.Labels")
	clear(holder)
	table.clear(labels)
	for id, room in replica:All("Rooms") do
		local label = clone("RoomLabel")
		label.Name = id
		label:FindFirstChild("Name").Text = `{string.upper(roomName(room.Type))}  ·  L{room.Level}`
		label.Parent = holder
		labels[id] = label
	end
end

local function placeLabels()
	for id, label in labels do
		local room = replica:Get("Rooms", id)
		if room then
			-- just under the room's ceiling (the label hangs from its top edge)
			local low, high = CV.CellBox(room.Floor, room.Column, room.Span)
			local top = Vector3.new((low.X + high.X) / 2, high.Y - 1, gridZ)
			local position, visible = pointIn(top)
			label.Position = position
			label.Visible = visible
			label.ImageColor3 = if blinking[id] then RUST else Color3.new(1, 1, 1)
			local lamp = label:FindFirstChild("Lamp")
			local sprite, reading = overlayLamp(id, room)
			if sprite == nil and reading == nil then
				for _, provider in statuses do
					local ok, s, r = pcall(provider, id, room)
					if ok and (s or r) then
						sprite, reading = s, r
						break
					end
				end
			end
			lamp.Visible = sprite ~= nil
			if sprite then
				KitRuntime.SetSprite(lamp, sprite)
			end
			local chip = label:FindFirstChild("Reading") -- Prompt 9's patch adds it
			if chip then
				chip.Visible = reading ~= nil and visible
				if reading then
					chip.Text.Text = reading
				end
			end
		end
	end
end

local function placeMarks()
	if selectionMark then
		local floor, column, span = selected and selected[1], selected and selected[2], 1
		if selected and floor and column then
			local roomId = currentBunker():UnitAt(floor, column)
			local room = roomId and currentBunker():Room(roomId)
			if room then
				column, span = room.Column, room.Span
			end
			local position, size, visible = cellRect(floor, column, span)
			selectionMark.Position = position
			selectionMark.Size = size
			selectionMark.Visible = visible
		else
			selectionMark.Visible = false
		end
	end
	for _, ghost in ghosts do
		local position, size, visible = cellRect(ghost.Floor, ghost.Column, ghost.Span)
		ghost.Frame.Position = position
		ghost.Frame.Size = size
		ghost.Frame.Visible = visible
	end
	local now = os.clock()
	for i = #pings, 1, -1 do
		local ping = pings[i]
		if now > ping.Until then
			ping.Frame:Destroy()
			table.remove(pings, i)
		else
			-- the pin's tip at the middle of the cell's interior
			local low, high = CV.CellBox(ping.Floor, ping.Column, 1)
			local position, visible = pointIn(Vector3.new((low.X + high.X) / 2, (low.Y + high.Y) / 2, gridZ))
			ping.Frame.Position = position
			ping.Frame.Visible = visible
		end
	end
end

-- The detail panel ------------------------------------------------------------------------------

-- "there is already one" -> "There is already one" (Rules.Bunker's reasons are lower case)
local function sentence(text: string): string
	return (string.gsub(text, "^%l", string.upper))
end

local function section(order: number, label: string, body: string)
	local s = ui:Clone("Section")
	s.LayoutOrder = order
	s:FindFirstChild("Label").Text = string.upper(label)
	s:FindFirstChild("Body").Text = body
	s.Parent = part("Cabinet.Pages.CommandView.Detail.Body")
end

local rowConnections: { RBXScriptConnection } = {}
local refreshDetail: () -> ()

local function optionRow(order: number, name: string, value: string, enabled: boolean, pick: Choice?)
	local row = clone("OptionRow")
	row.LayoutOrder = order
	row:FindFirstChild("Name").Text = string.upper(name)
	row:FindFirstChild("Value").Text = value
	row.ImageTransparency = if enabled then 0 else 0.35
	local lamp = row:FindFirstChild("Lamp")
	local isChosen = pick ~= nil and choice ~= nil and choice.Action == pick.Action and choice.RoomType == pick.RoomType
		and choice.Other == pick.Other and choice.RoomId == pick.RoomId and choice.ResidentId == pick.ResidentId
	KitRuntime.SetSprite(lamp, if isChosen then "Lamp_Orange" else "Lamp_Off")
	lamp.Visible = pick ~= nil
	if pick and enabled then
		table.insert(rowConnections, row.Activated:Connect(function()
			choice = pick
			refreshDetail()
		end))
	end
	row.Parent = part("Cabinet.Pages.CommandView.Detail.Options")
end

local function setMainAction()
	local current = choice
	if not current then
		ui:SetMainAction(nil)
		return
	end
	-- jobs are never voted on (Section 8): the choice applies at once
	if current.Action == "Assign" or current.Action == "Unassign" or current.Action == "AutoAssign" then
		ui:SetMainAction({
			Label = current.Label or "Assign",
			Enabled = true,
			OnPress = function()
				if current.Action == "AutoAssign" then
					Remotes.FireServer("AutoAssign")
				else
					Remotes.FireServer("AssignResident", current.ResidentId or "", if current.Action == "Assign" then current.RoomId or "" else "")
				end
				choice = nil
				refreshDetail()
			end,
		})
		return
	end
	-- the Drill Bay's dig queue is never voted on (Section 7; Prompt 14)
	if current.Action == "MarkDig" or current.Action == "UnmarkDig" then
		local handler = handlers[current.Action]
		ui:SetMainAction({
			Label = current.Label or (if current.Action == "MarkDig" then "Queue for the Drill Bay" else "Take off the queue"),
			Enabled = handler ~= nil,
			OnPress = function()
				local h = handlers[current.Action]
				if h then
					h(current)
				end
				choice = nil
				refreshDetail()
			end,
		})
		return
	end
	-- solo runs have no votes (Section 8, rule 6): the choice applies at once
	local verb = if (RunState.Get("ReadyNeeded") or 1) <= 1 then
		(if current.Action == "Build" then "Build" elseif current.Action == "Upgrade" then "Upgrade to" elseif current.Action == "Merge" then "Merge" else "Tear down")
		else "Propose"
	local label = if current.Action == "Build" then `{verb} {roomName(current.RoomType or "")}`
		elseif current.Action == "Upgrade" then (if verb == "Propose" then `Propose level {current.Level}` else `Upgrade to level {current.Level}`)
		elseif current.Action == "Merge" then (if verb == "Propose" then "Propose merge" else "Merge")
		else (if verb == "Propose" then "Propose teardown" else "Tear down")
	local handler = handlers[current.Action]
	ui:SetMainAction({
		Label = label,
		Enabled = handler ~= nil,
		OnPress = function()
			local h = handlers[current.Action]
			if h then
				h(current)
				-- proposed: the panel shows the proposal once the vote replicates
				choice = nil
				refreshDetail()
			end
		end,
	})
end

-- What a room's power reading says (PowerService's Power collection).
local function powerLine(roomId: string, room: any, info: any): string
	local power = replica:Get("Power", roomId)
	if info.PowerOutput then
		local made = if power then power.Made or 0 else 0
		return if made > 0 then `Makes {math.floor(made + 0.5)} with its crew. Every room draws from it.`
			else "Makes nothing: no one works here. Without power the rooms farthest from it go dark first."
	end
	local draw = info.Power[room.Level] * room.Span
	if draw <= 0 then
		return "Draws none."
	end
	if power and power.Dark then
		return `Dark: draws {draw}, but there isn't enough power. Dark rooms make nothing.`
	end
	return `Draws {draw}. Lit.`
end

local OUTPUT_WORDS: { [string]: string } = {
	Research = "Lab research", Morale = "morale", Recruits = "recruits", Training = "training",
	Crafting = "crafting", Thawing = "thawing", Decon = "decon", Digging = "digging",
}

-- What a room's output reading says (EconomyService's Production collection), or nil.
local function outputLine(roomId: string): string?
	local made = replica:Get("Production", roomId)
	if type(made) ~= "table" then
		return nil
	end
	local resource = Config.Find("Resources", made.Makes or "")
	local what = if resource then resource.Name else (OUTPUT_WORDS[made.Makes] or tostring(made.Makes))
	if made.Idle == "Wrecked" then
		return `Makes {what}; nothing until it is repaired.`
	elseif made.Idle == "Dark" then
		return `Makes {what}; nothing while it is dark.`
	elseif made.Idle == "NoCrew" then
		return `Makes {what} once residents work here.`
	end
	return `{made.Rate} {what} a cycle, {made.Workers} working.`
end

local function showRoom(roomId: string)
	local b = currentBunker()
	local room = b:Room(roomId) :: any
	local info = Config.Get("Rooms", room.Type)
	local detail = part("Cabinet.Pages.CommandView.Detail")
	detail:FindFirstChild("Name").Text = string.upper(info.Name)
	detail:FindFirstChild("Sub").Text = `LEVEL {room.Level}  ·  {room.Span} CELL{if room.Span > 1 then "S" else ""}  ·  FLOOR {room.Floor}`
	local condition = if room.Wrecked
		then `Wrecked: {room.HP} of {room.MaxHP} HP. Works again at {Bunker.RepairedAt(room.MaxHP)}.`
		else `{room.HP} of {room.MaxHP} HP`
	if conditionNote then
		local ok, note = pcall(conditionNote, roomId)
		if ok and note then
			condition ..= `\n{note}`
		end
	end
	section(1, "Condition", condition)
	section(2, "Power", powerLine(roomId, room, info))
	local output = outputLine(roomId)
	if output then
		section(3, "Output", output)
	end
	section(4, "What it does", info.Text)
	-- an upgrade being built (Nightmare): the room works at its old level until it's done
	local site = siteAt(room.Floor, room.Column)
	if site and site.Kind == "Upgrade" then
		section(5, "Upgrading", `To level {site.Level}: {math.floor((site.Progress or 0) * 100)}% done. `
			.. (if (site.Helpers or 0) > 0 then `{site.Helpers} helping.` else "Stand in it to build faster."))
	end
	-- a proposal already open on this room: no second one until it closes (Section 8)
	local openVote = voteAt(room.Floor, room.Column) or (if site and site.Kind == "Upgrade" then site else nil)
	if openVote and openVote ~= site then
		section(6, "Proposal open", `{openVote.ProposerName}: {openVote.Title}. Vote on the banner.`)
	end
	local order = 1
	if room.Level < 3 then
		local nextLevel = room.Level + 1
		local costs = Construction.CostsAt(room.Type, nextLevel, room.Span, RunState.Get("BuildCost")) -- the Quartermaster (Prompt 20)
		local value, affordable = costLine(costs)
		local research = Construction.ResearchFor(room.Type, nextLevel)
		local have = RunState.Get("Research") or 0
		local enabled = affordable and have >= research and not openVote
		if research > 0 then
			value = if affordable and have < research then `Needs {research} Lab research ({math.floor(have)} so far)`
				else `{value}  ·  {research} LAB RESEARCH`
		end
		optionRow(order, `Upgrade to level {nextLevel}`, value, enabled,
			if enabled then { Action = "Upgrade", Floor = room.Floor, Column = room.Column, RoomId = roomId, Level = nextLevel } else nil)
		order += 1
	end
	for _, column in { room.Column - 1, room.Column + room.Span } do
		local otherId = b:UnitAt(room.Floor, column)
		local other = otherId and b:Room(otherId)
		if other and other.Id ~= roomId then
			local ok, why = b:CanMerge(roomId, other.Id)
			if ok or other.Type == room.Type then
				local can = ok and not openVote and not voteAt(other.Floor, other.Column)
				optionRow(order, `Merge with the {roomName(other.Type)}`, if ok then `{room.Span + other.Span} cells together` else sentence(why or ""), can,
					if can then { Action = "Merge", Floor = room.Floor, Column = room.Column, RoomId = roomId, Other = other.Id } else nil)
				order += 1
			end
		end
	end
	local canRemove, why = b:CanRemove(roomId)
	local can = canRemove and not openVote
	local refund = Construction.Refund(room.Type, room.Level, room.Span, RunState.Get("BuildCost"))
	local gives = if next(refund) then `{Construction.CostText(refund)} BACK` else "Its cells become open cells again"
	optionRow(order, "Tear down", if canRemove then gives else sentence(why or ""), can,
		if can then { Action = "TearDown", Floor = room.Floor, Column = room.Column, RoomId = roomId } else nil)
	order += 1
	-- jobs (Prompt 10): who works here, and who could
	local stat = info.WorkerStat
	if stat then
		local slots = Config.Get("Tuning", "Rooms").WorkerSlotsPerCell[room.Level] * room.Span
		local workers, idle = {}, {}
		for id, resident in replica:All("Residents") do
			if type(resident) == "table" and resident.State == "Alive" then
				if resident.Job == roomId then
					table.insert(workers, { Id = id, R = resident })
				elseif resident.Job == nil then
					table.insert(idle, { Id = id, R = resident })
				end
			end
		end
		local function byStat(a: any, b: any): boolean
			local sa, sb = a.R.Stats[stat] or 0, b.R.Stats[stat] or 0
			if sa ~= sb then
				return sa > sb
			end
			return a.Id < b.Id
		end
		table.sort(workers, byStat)
		table.sort(idle, byStat)
		local names = {}
		for _, w in workers do
			table.insert(names, `{w.R.Name} ({stat} {w.R.Stats[stat]}, {w.R.Mood})`)
		end
		section(7, `Workers  ·  {#workers} of {slots}`, if #names > 0 then table.concat(names, "; ") .. "."
			else `Nobody works here yet. The job uses {stat}.`)
		local full = #workers >= slots
		for i, entry in idle do
			if i > 6 then
				break
			end
			local first = entry.R.First or entry.R.Name
			optionRow(order, `Assign {entry.R.Name}`, if full then "The room is full" else `{stat} {entry.R.Stats[stat]}  ·  {entry.R.Mood}`,
				not full, if not full then { Action = "Assign", Floor = room.Floor, Column = room.Column, RoomId = roomId,
					ResidentId = entry.Id, Label = `Assign {first}` } else nil)
			order += 1
		end
		for _, w in workers do
			local first = w.R.First or w.R.Name
			optionRow(order, `Take {w.R.Name} off the job`, "They go idle until you assign them again", true,
				{ Action = "Unassign", Floor = room.Floor, Column = room.Column, RoomId = roomId, ResidentId = w.Id,
					Label = `Take {first} off` })
			order += 1
		end
		if #idle > 0 then
			optionRow(order, "Auto-Assign", `{#idle} idle: fill empty jobs by best stat`, true,
				{ Action = "AutoAssign", Floor = room.Floor, Column = room.Column, RoomId = roomId, Label = "Auto-Assign" })
		end
	end
end

local function showOpenCell(floor: number, column: number)
	local detail = part("Cabinet.Pages.CommandView.Detail")
	detail:FindFirstChild("Sub").Text = `FLOOR {floor}  ·  COLUMN {column}  ·  {string.upper(Grid.BandOf(floor).Name)}`
	local site = siteAt(floor, column)
	if site then
		detail:FindFirstChild("Name").Text = "UNDER CONSTRUCTION"
		section(1, "Building", `A {roomName(site.Type)}: {math.floor((site.Progress or 0) * 100)}% built.`)
		section(2, "Help", if (site.Helpers or 0) > 0
			then `{site.Helpers} helping; each one builds it 25% faster.`
			else "Stand in the cell to build it faster.")
		return
	end
	local vote = voteAt(floor, column)
	if vote then
		detail:FindFirstChild("Name").Text = "PROPOSED"
		section(1, "Vote", `{vote.ProposerName}: {vote.Title}. Vote on the banner.`)
		return
	end
	detail:FindFirstChild("Name").Text = "OPEN CELL"
	section(1, "Build here", "Pick a room type, then propose it to the team.")
	local notes = if cellNotes then cellNotes(floor, column, "Dug") else {}
	for i, note in notes do
		section(1 + i, note.Title, note.Text)
	end
	local b = currentBunker()
	local ctx = context()
	local available, locked = {}, {}
	for _, roomType in Config.Ids("Rooms") do
		-- Fixed rooms (the Blast Door, the Reactor Core) come with the bunker and are never built
		if not Config.Get("Rooms", roomType).Fixed then
			local ok, why = CV.RoomChoice(b, roomType, floor, column, ctx)
			table.insert(if ok then available else locked, { Type = roomType, Why = why })
		end
	end
	local order = 1
	for _, entry in available do
		local info = Config.Get("Rooms", entry.Type)
		local value, affordable = costLine(Construction.CostsAt(entry.Type, 1, 1, RunState.Get("BuildCost")))
		optionRow(order, info.Name, value, affordable,
			if affordable then { Action = "Build", Floor = floor, Column = column, RoomType = entry.Type } else nil)
		order += 1
	end
	for _, entry in locked do
		optionRow(order, Config.Get("Rooms", entry.Type).Name, sentence(entry.Why or ""), false, nil)
		order += 1
	end
end

local function showRock(floor: number, column: number)
	local detail = part("Cabinet.Pages.CommandView.Detail")
	local band = Grid.BandOf(floor)
	detail:FindFirstChild("Name").Text = "ROCK"
	detail:FindFirstChild("Sub").Text = `FLOOR {floor}  ·  COLUMN {column}  ·  {string.upper(band.Name)}`
	local b = currentBunker()
	local ok, why = b:CanDig(floor, column)
	section(1, "Digging", if ok then "Can be dug: it is beside or under a dug cell or room." else `Can't be dug yet: {why}.`)
	if band.Ore then
		section(2, "Ore", `{Config.Get("Resources", band.Ore).Name} in the {band.Name}.`)
	end
	if Grid.IsBandStart(floor) and floor > b:DeepestFloor() then
		section(3, "Next band", `The first cell of the {band.Name}: opening it needs a Push Deeper vote.`)
	end
	local notes = if cellNotes then cellNotes(floor, column, "Rock") else {}
	for i, note in notes do
		section(3 + i, note.Title, note.Text)
	end
	local options = if rockOptions then rockOptions(floor, column) else {}
	for i, option in options do
		optionRow(i, option.Name, option.Value, option.Choice ~= nil, option.Choice)
	end
end

local function showNothing()
	local detail = part("Cabinet.Pages.CommandView.Detail")
	local b = currentBunker()
	local rooms, open = 0, 0
	for _ in replica:All("Rooms") do
		rooms += 1
	end
	for _, cell in replica:All("Cells") do
		if type(cell) == "table" and cell.Room == nil then
			open += 1
		end
	end
	detail:FindFirstChild("Name").Text = "BUNKER SECTION"
	detail:FindFirstChild("Sub").Text = `{rooms} ROOMS  ·  {open} OPEN CELL{if open == 1 then "" else "S"}  ·  DEPTH {b:DeepestFloor()}`
	section(1, "Pick a cell", "A room to upgrade, merge or tear down, an open cell to build on, or rock to dig.")
end

local function showOverlayLegend()
	local text = OVERLAY_TEXT[tab]
	if not text then
		return
	end
	-- at the top of the detail panel, above whatever is selected
	section(0, `{tab} overlay`, if overlays[tab] then text else `{text} No readings yet.`)
end

local lastRefreshed: string? = nil -- the selection the panel last showed

refreshDetail = function()
	if not open then
		return
	end
	-- a refresh of the same selection (a vote's tally, a site's progress) keeps the menu's scroll
	local options = part("Cabinet.Pages.CommandView.Detail.Options")
	local key = if selected then Grid.Key(selected[1], selected[2]) else ""
	local scroll = if key == lastRefreshed then options.CanvasPosition else Vector2.zero
	lastRefreshed = key
	for _, connection in rowConnections do
		connection:Disconnect()
	end
	table.clear(rowConnections)
	clear(part("Cabinet.Pages.CommandView.Detail.Body"))
	clear(options)
	local cell = selected
	if not cell then
		choice = nil
		showNothing()
	else
		local state, roomId = currentBunker():State(cell[1], cell[2])
		if state == "Room" and roomId then
			showRoom(roomId)
		elseif state == "Dug" then
			showOpenCell(cell[1], cell[2])
		else
			-- a rock cell's only choices are the dig queue's (Prompt 14); keep one picked for this cell
			local keep = choice ~= nil and (choice.Action == "MarkDig" or choice.Action == "UnmarkDig")
				and choice.Floor == cell[1] and choice.Column == cell[2]
			if not keep then
				choice = nil
			end
			showRock(cell[1], cell[2])
		end
	end
	showOverlayLegend()
	setMainAction()
	if scroll ~= Vector2.zero then
		task.defer(function()
			options.CanvasPosition = scroll -- after the list layout has sized the canvas again
		end)
	end
end

-- Selecting and pinging -------------------------------------------------------------------------

function CommandViewController:Select(floor: number?, column: number?)
	if floor and column and Grid.OnGrid(floor, column) then
		local same = selected ~= nil and selected[1] == floor and selected[2] == column
		selected = { floor, column }
		if not same then
			choice = nil
		end
	else
		selected = nil
		choice = nil
	end
	refreshDetail()
	CommandViewController.Selected:Fire(floor, column)
end

local function pingSelected()
	if selected and Remotes.InPlace("PingCell") then
		Remotes.FireServer("PingCell", selected[1], selected[2])
	end
end

local function onPinged(floor: number, column: number)
	if not open or type(floor) ~= "number" or type(column) ~= "number" then
		return
	end
	local mark = clone("PingMark")
	mark.Parent = part("Cabinet.Pages.CommandView.View.Marks")
	table.insert(pings, { Frame = mark, Floor = floor, Column = column, Until = os.clock() + Config.Get("Tuning", "Ping").Seconds })
end

-- Moving the camera -----------------------------------------------------------------------------

local function panBy(world: Vector2)
	center = CV.Clamp(center + world, bounds)
end

local function zoomBy(factor: number)
	local pitch = Grid.Pitch()
	height = math.clamp(height * factor, t.MinFloors * pitch.Y, t.MaxFloors * pitch.Y)
end

local function readInput(dt: number)
	-- wheel and pinch (InputController gathers both; we take them before CameraController)
	local zoom = input:TakeZoom()
	if zoom ~= 0 then
		local step = Config.Get("Tuning", "Camera").ZoomStep
		zoomBy(1 + t.ZoomStep * zoom / step)
	end
	input:TakeLook(dt) -- one-finger drags arrive here too; the view pans from its own touch tracking
	local perSecond = height * t.PanFloorsPerSecond / t.StartFloors
	local move = Vector2.zero
	if not UserInputService:GetFocusedTextBox() then
		for key, direction in PAN_KEYS do
			if UserInputService:IsKeyDown(key) then
				move += direction
			end
		end
	end
	for _, state in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if state.KeyCode == Enum.KeyCode.Thumbstick1 and state.Position.Magnitude > t.StickDeadzone then
			move += Vector2.new(state.Position.X, state.Position.Y)
		elseif state.KeyCode == Enum.KeyCode.Thumbstick2 and math.abs(state.Position.Y) > t.StickDeadzone then
			zoomBy(1 - state.Position.Y * dt * 1.5)
		end
	end
	if move.Magnitude > 0 then
		panBy(move.Unit * math.min(move.Magnitude, 1) * perSecond * dt)
	end
end

local function render(dt: number)
	if not open and not moving then
		return
	end
	local camera = workspace.CurrentCamera
	if open and not (moving and moving.Back) then
		readInput(dt)
	end
	local current = moving
	if current then
		current.Alpha = math.min(1, current.Alpha + dt / math.max(t.MoveSeconds, 0.01))
		local eased = TweenService:GetValue(current.Alpha, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
		local toCFrame, toFov = (current.To :: any)()
		camera.CFrame = current.From:Lerp(toCFrame, eased)
		camera.FieldOfView = current.FromFov + (toFov - current.FromFov) * eased
		if current.Alpha >= 1 then
			moving = nil
			if current.Done then
				current.Done()
			end
		end
	else
		local cframe, fov = viewCFrame()
		camera.CFrame = cframe
		camera.FieldOfView = fov
	end
	if open then
		if labelsDirty then
			rebuildLabels()
		end
		placeLabels()
		placeMarks()
		local cursor = part("Cabinet.Pages.CommandView.View.Cursor")
		cursor.Visible = input:Device() == "Gamepad"
	end
end

-- Input handlers ---------------------------------------------------------------------------------

local function onInputBegan(io: InputObject)
	if not open then
		return
	end
	if io.UserInputType == Enum.UserInputType.MouseButton1 then
		local point = UserInputService:GetMouseLocation()
		if inView(point) then
			drag = { Start = point, Last = point, Moved = false, Touch = nil }
		end
	elseif io.UserInputType == Enum.UserInputType.Touch then
		local point = Vector2.new(io.Position.X, io.Position.Y) + GuiService:GetGuiInset()
		if inView(point) then
			pinch[io] = point
			local count = 0
			for _ in pinch do
				count += 1
			end
			drag = if count == 1 then { Start = point, Last = point, Moved = false, Touch = io } else nil
		end
	end
end

local function onInputChanged(io: InputObject)
	if not open then
		return
	end
	local current = drag
	if io.UserInputType == Enum.UserInputType.MouseMovement and current and not current.Touch then
		local point = UserInputService:GetMouseLocation()
		local delta = point - current.Last
		current.Last = point
		if (point - current.Start).Magnitude > t.DragPixels then
			current.Moved = true
		end
		if current.Moved then
			local perPixel = height / math.max(workspace.CurrentCamera.ViewportSize.Y, 1)
			panBy(Vector2.new(-delta.X, delta.Y) * perPixel)
		end
	elseif io.UserInputType == Enum.UserInputType.Touch and pinch[io] then
		local point = Vector2.new(io.Position.X, io.Position.Y) + GuiService:GetGuiInset()
		pinch[io] = point
		if current and current.Touch == io then
			local delta = point - current.Last
			current.Last = point
			if (point - current.Start).Magnitude > t.DragPixels then
				current.Moved = true
			end
			if current.Moved then
				local perPixel = height / math.max(workspace.CurrentCamera.ViewportSize.Y, 1)
				panBy(Vector2.new(-delta.X, delta.Y) * perPixel)
			end
		end
	end
end

local function onInputEnded(io: InputObject)
	local current = drag
	if io.UserInputType == Enum.UserInputType.MouseButton1 and current and not current.Touch then
		drag = nil
		if open and not current.Moved then
			CommandViewController:Select(cellAt(current.Start))
		end
	elseif io.UserInputType == Enum.UserInputType.Touch then
		pinch[io] = nil
		if current and current.Touch == io then
			drag = nil
			if open and not current.Moved then
				CommandViewController:Select(cellAt(current.Start))
			end
		end
	end
end

-- Open and close ---------------------------------------------------------------------------------

-- The character stays where it was left: its movement keys and sticks are sunk while the view is
-- open (Roblox's PlayerModule isn't an instance in every place, so this goes through
-- ContextActionService rather than its controls object).
-- Roblox's touch thumbstick and jump button: hidden while the view is open, or a drag in zone C
-- could walk the character away (it stays where it was left, Section 7).
local touchControlsBefore: boolean? = nil

local function holdCharacter(on: boolean)
	if not on then
		ContextActionService:UnbindAction(HOLD_ACTION)
		if touchControlsBefore ~= nil then
			GuiService.TouchControlsEnabled = touchControlsBefore
			touchControlsBefore = nil
		end
		return
	end
	if touchControlsBefore == nil then
		touchControlsBefore = GuiService.TouchControlsEnabled
	end
	GuiService.TouchControlsEnabled = false
	ContextActionService:BindActionAtPriority(HOLD_ACTION, function()
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 20,
		Enum.PlayerActions.CharacterForward, Enum.PlayerActions.CharacterBackward,
		Enum.PlayerActions.CharacterLeft, Enum.PlayerActions.CharacterRight, Enum.PlayerActions.CharacterJump,
		Enum.KeyCode.Thumbstick1, Enum.KeyCode.Space)
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:Move(Vector3.zero)
	end
end

local function fadeFrontWalls(on: boolean)
	if on then
		for _, item in CollectionService:GetTagged(FRONT_WALL_TAG) do
			if item:IsA("BasePart") then
				Fade.Set(item, FADE_SOURCE, 1)
				frontWalls[item] = true
			end
		end
	else
		Fade.ClearSource(FADE_SOURCE)
		table.clear(frontWalls)
	end
end

local function liftLighting(on: boolean)
	if on then
		lightingBefore = {
			Ambient = Lighting.Ambient,
			OutdoorAmbient = Lighting.OutdoorAmbient,
			ExposureCompensation = Lighting.ExposureCompensation,
		}
		Lighting.Ambient = Color3.fromHex(t.Ambient)
		Lighting.OutdoorAmbient = Color3.fromHex(t.OutdoorAmbient)
		Lighting.ExposureCompensation = t.ExposureCompensation
	elseif lightingBefore then
		Lighting.Ambient = lightingBefore.Ambient
		Lighting.OutdoorAmbient = lightingBefore.OutdoorAmbient
		Lighting.ExposureCompensation = lightingBefore.ExposureCompensation
		lightingBefore = nil
	end
end

-- The view's look without the view: the front walls faded and the lighting lifted, for as long as
-- any reason holds it. The view itself holds it while it is open; the intro cutscene holds it
-- while its camera passes the bunker and settles into the view's pose (Prompt 22).
local presenting: { [string]: boolean } = {}

local function present(reason: string, on: boolean)
	local was = next(presenting) ~= nil
	presenting[reason] = if on then true else nil
	local now = next(presenting) ~= nil
	if now ~= was then
		fadeFrontWalls(now)
		liftLighting(now)
	end
end

local function flashEdge()
	local edge = part("DamageEdge")
	edge.Visible = true
	for _, strip in edge:GetChildren() do
		if strip:IsA("Frame") then
			strip.BackgroundTransparency = 0
			TweenService:Create(strip, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundTransparency = 1,
			}):Play()
		end
	end
	task.delay(0.65, function()
		if edge.Parent then
			edge.Visible = false
		end
	end)
end

local function helpText(): string
	local device = input:Device()
	if device == "Gamepad" then
		return "LEFT STICK MOVE  ·  RIGHT STICK ZOOM  ·  A PICK  ·  D-PAD UP PING"
	elseif device == "Touch" then
		return "DRAG TO MOVE  ·  PINCH TO ZOOM  ·  TAP A CELL"
	end
	return "DRAG OR WASD TO MOVE  ·  SCROLL TO ZOOM  ·  CLICK A CELL  ·  G PING"
end

local function bindKeys(on: boolean)
	if not on then
		ContextActionService:UnbindAction(PING_ACTION)
		ContextActionService:UnbindAction(PICK_ACTION)
		return
	end
	ContextActionService:BindActionAtPriority(PING_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then
			pingSelected()
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 20, Enum.KeyCode.G, Enum.KeyCode.DPadUp)
	ContextActionService:BindActionAtPriority(PICK_ACTION, function(_, state)
		if state == Enum.UserInputState.Begin then
			local origin, size = viewRect()
			CommandViewController:Select(cellAt(origin + size / 2))
		end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 30, Enum.KeyCode.ButtonA)
end

local function onOpen(_page: Frame)
	open = true
	local camera = workspace.CurrentCamera
	before = { CFrame = camera.CFrame, FieldOfView = camera.FieldOfView }
	cameraController:Suspend(SCREEN)
	camera.CameraType = Enum.CameraType.Scriptable
	holdCharacter(true)
	bounds = CV.Bounds()
	gridZ = Grid.CellPosition(1, 0).Z
	height = t.StartFloors * Grid.Pitch().Y
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	center = CV.Clamp(if root and root:IsA("BasePart") then Vector2.new(root.Position.X, root.Position.Y) else Vector2.zero, bounds)
	selected = nil
	choice = nil
	labelsDirty = true
	present(SCREEN, true)
	selectionMark = clone("CellMark")
	selectionMark.Visible = false
	selectionMark.Parent = part("Cabinet.Pages.CommandView.View.Marks")
	part("Cabinet.Pages.CommandView.View.Help.Text").Text = helpText()
	ui:SetFooterActions({
		{ Label = "Ping", OnPress = pingSelected },
		{ Label = "Residents", OnPress = function()
			-- the roster (ResidentsController, Prompt 10); closing it comes back here
			if ui:IsRegistered("Residents") then
				ui:Open("Residents")
			end
		end },
	})
	bindKeys(true)
	GuiService.SelectedObject = nil
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	lastHealth = if humanoid then humanoid.Health else nil
	moving = { Alpha = 0, From = camera.CFrame, FromFov = camera.FieldOfView, To = viewCFrame, Back = false, Done = nil }
	refreshDetail()
	CommandViewController.Opened:Fire()
end

local function onClose()
	if not open then
		return
	end
	open = false
	bindKeys(false)
	drag = nil
	table.clear(pinch)
	for _, ping in pings do
		ping.Frame:Destroy()
	end
	table.clear(pings)
	if selectionMark then
		selectionMark:Destroy()
		selectionMark = nil
	end
	for _, connection in rowConnections do
		connection:Disconnect()
	end
	table.clear(rowConnections)
	present(SCREEN, false)
	holdCharacter(false)
	local camera = workspace.CurrentCamera
	local back = before
	before = nil
	if back then
		local target = back
		moving = {
			Alpha = 0,
			From = camera.CFrame,
			FromFov = camera.FieldOfView,
			To = function()
				return target.CFrame, target.FieldOfView
			end,
			Back = true,
			Done = function()
				cameraController:Resume(SCREEN)
			end,
		}
	else
		cameraController:Resume(SCREEN)
	end
	CommandViewController.Closed:Fire()
end

-- API ----------------------------------------------------------------------------------------------

function CommandViewController:Toggle()
	if not inRun or not ui:Gui() then
		return
	end
	if ui:Current() == SCREEN then
		ui:Close()
	elseif not ui:IsOpen() then
		ui:Open(SCREEN)
	end
end

function CommandViewController:IsOpen(): boolean
	return open
end

-- Shows the bunker as the view does (front walls faded, lighting lifted) without opening it.
function CommandViewController:Present(reason: string, on: boolean)
	present(reason, on)
end

-- The view's camera over a point of the bunker's front (world X and Y) showing `floors` floors,
-- with the point in the middle of the whole screen: the pose the view opens in, less its zone.
function CommandViewController:Pose(at: Vector2, floors: number?): (CFrame, number)
	local tall = (floors or t.StartFloors) * Grid.Pitch().Y
	local distance, fieldOfView = CV.Lens(tall)
	local position = Vector3.new(at.X, at.Y, Grid.CellPosition(1, 0).Z + distance)
	return CFrame.lookAt(position, position - Vector3.zAxis), fieldOfView
end

-- A proposal's handler: "Build", "Upgrade", "Merge" or "TearDown" (the votes, Prompt 8).
function CommandViewController:SetHandler(action: string, handler: ((Choice) -> ())?)
	handlers[action] = handler
	if open then
		setMainAction()
	end
end

-- An overlay's provider: (roomId, room) -> lamp sprite (Lamp_Green, Lamp_Amber, Lamp_Red...).
function CommandViewController:SetOverlay(name: string, provider: Overlay?)
	assert(OVERLAY_TEXT[name], `CommandViewController: no overlay {name}`)
	overlays[name] = provider
	if open then
		refreshDetail()
	end
end

-- A room status's provider (Prompt 13: burning, blackout, rubble...): (roomId, room) -> lamp
-- sprite and a short reading, shown when the overlay tab has nothing for the room.
function CommandViewController:SetStatus(name: string, provider: Overlay?)
	statuses[name] = provider
end

-- A line added under a room's Condition in the detail panel (Prompt 13: "On fire, 64%").
function CommandViewController:SetConditionNote(fn: ((string) -> string?)?)
	conditionNote = fn
	if open then
		refreshDetail()
	end
end

-- Prompt 14: notes on a rock or dug cell (dig time, progress, the queue, what a dug cell holds,
-- the Driller's hints) and the dig queue's options on rock.
function CommandViewController:SetCellNotes(fn: ((floor: number, column: number, state: string) -> { CellNote })?)
	cellNotes = fn
	if open then
		refreshDetail()
	end
end

function CommandViewController:SetRockOptions(fn: ((floor: number, column: number) -> { CellOption })?)
	rockOptions = fn
	if open then
		refreshDetail()
	end
end

-- Refresh the detail panel (a dig site's progress, a queue change).
function CommandViewController:Refresh()
	if open then
		refreshDetail()
	end
end

-- A ghost outline for an open vote (Section 7), until HideGhost.
function CommandViewController:ShowGhost(id: string, floor: number, column: number, span: number, label: string?)
	CommandViewController:HideGhost(id)
	if not gui() then
		return
	end
	local mark = clone("CellMark")
	mark.BackgroundColor3 = CREAM
	local stroke = mark:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = CREAM
	end
	local text = mark:FindFirstChild("Label")
	if text and label then
		text.Text = string.upper(label)
		text.Visible = true
	end
	mark.Parent = part("Cabinet.Pages.CommandView.View.Marks")
	ghosts[id] = { Frame = mark, Floor = floor, Column = column, Span = span }
end

-- Changes a ghost's label (a site's progress: "KITCHEN 45%").
function CommandViewController:SetGhostLabel(id: string, label: string)
	local ghost = ghosts[id]
	local text = ghost and ghost.Frame:FindFirstChild("Label")
	if text then
		text.Text = string.upper(label)
		text.Visible = true
	end
end

function CommandViewController:HideGhost(id: string)
	local ghost = ghosts[id]
	if ghost then
		ghost.Frame:Destroy()
		ghosts[id] = nil
	end
end

-- Lights a room's label (by room id) rust red while on.
function CommandViewController:Blink(key: string, on: boolean)
	blinking[key] = if on then true else nil
end

function CommandViewController:State(): { [string]: any }
	local pitch = Grid.Pitch()
	return {
		Open = open,
		Center = center,
		Floors = height / pitch.Y,
		Distance = (CV.Lens(height)),
		Selected = if selected then Grid.Key(selected[1], selected[2]) else nil,
		Choice = if choice then `{choice.Action} {choice.RoomType or choice.RoomId or ""}` else nil,
		Tab = tab,
		Labels = (function()
			local n = 0
			for _ in labels do
				n += 1
			end
			return n
		end)(),
		Pings = #pings,
		Ghosts = (function()
			local n = 0
			for _ in ghosts do
				n += 1
			end
			return n
		end)(),
		Blinking = (function()
			local keys = {}
			for key in blinking do
				table.insert(keys, key)
			end
			table.sort(keys)
			return table.concat(keys, ",")
		end)(),
		FieldOfView = workspace.CurrentCamera.FieldOfView,
	}
end

-- Lifecycle ------------------------------------------------------------------------------------------

function CommandViewController:Init(registry)
	input = registry.InputController
	cameraController = registry.CameraController
	ui = registry.UIController
	replica = registry.ReplicaController
	inRun = Constants.PlaceKind() == "Run"
	t = CV.Tuning()
end

function CommandViewController:Start()
	if not inRun then
		return
	end
	local waited = 0
	while not ui:Gui() and waited < 20 do
		waited += task.wait(0.25)
	end
	local root = ui:Gui()
	if not root or not UIContract.Find(root, "Cabinet.Pages.CommandView") then
		log:Warn("the Frame has no Command View page; it can't open")
		return
	end
	ui:Register(SCREEN, {
		Title = "Command View",
		Subtitle = "STEADFAST SHELTER CO.  ·  BUNKER IN SECTION",
		Tabs = TABS,
		Page = SCREEN,
		Docked = true,
		GamepadSelect = false,
		Hint = "Your character stays where you left it, and can be hit.",
		OnOpen = function(p: Frame)
			onOpen(p)
		end,
		OnTab = function(id: string)
			tab = id
			if open then
				refreshDetail()
			end
		end,
		OnClose = onClose,
	})
	input:On("CommandView", function()
		CommandViewController:Toggle()
	end)
	replica:Changed("Cells"):Connect(function()
		bunkerDirty = true
		if open then
			refreshDetail()
		end
	end)
	replica:Changed("Rooms"):Connect(function()
		bunkerDirty = true
		labelsDirty = true
		if open then
			refreshDetail()
		end
	end)
	-- sites, votes, unlocks and the stockpile change what the panel offers: refresh it, at most
	-- twice a second
	local pending = false
	local function soon()
		if open and not pending then
			pending = true
			task.delay(0.5, function()
				pending = false
				if open then
					refreshDetail()
				end
			end)
		end
	end
	for _, name in { "Sites", "Votes", "Unlocked", "Power", "Production", "Residents" } do
		replica:Changed(name):Connect(soon)
	end
	-- Prompt 10's Morale overlay: a room's workers' average morale
	CommandViewController:SetOverlay("Morale", function(roomId: string, _room: any): (string?, string?)
		local sum, n = 0, 0
		for _, resident in replica:All("Residents") do
			if type(resident) == "table" and resident.Job == roomId and resident.State == "Alive" then
				sum += resident.Morale or 0
				n += 1
			end
		end
		if n == 0 then
			return nil, nil
		end
		local average = math.floor(sum / n + 0.5)
		return if average >= 75 then "Lamp_Green" elseif average >= 40 then "Lamp_Amber" else "Lamp_Red", `MORALE {average}`
	end)
	-- Prompt 9's overlays: power (PowerService) and production (EconomyService)
	CommandViewController:SetOverlay("Power", function(roomId: string, room: any): (string?, string?)
		local power = replica:Get("Power", roomId)
		if type(power) ~= "table" then
			return nil, nil
		end
		if Config.Get("Rooms", room.Type).PowerOutput then
			local made = power.Made or 0
			return if made > 0 then "Lamp_Green" else "Lamp_Red", `MAKES {math.floor(made + 0.5)}`
		end
		if power.Dark then
			return "Lamp_Red", "DARK"
		end
		return "Lamp_Green", `DRAWS {power.Draw}`
	end)
	CommandViewController:SetOverlay("Production", function(roomId: string, _room: any): (string?, string?)
		local made = replica:Get("Production", roomId)
		if type(made) ~= "table" then
			return nil, nil
		end
		if made.Idle == "Dark" then
			return "Lamp_Red", "DARK"
		elseif made.Idle == "Wrecked" then
			return "Lamp_Red", "WRECKED"
		elseif made.Idle == "NoCrew" then
			return "Lamp_Amber", "NO CREW"
		end
		local resource = Config.Find("Resources", made.Makes or "")
		local what = if resource then string.upper(resource.Name) else string.upper(tostring(made.Makes))
		return "Lamp_Green", `+{made.Rate} {what}`
	end)
	for _, id in Config.Ids("Resources") do
		if RunState.Fields[id] then
			RunState.Changed(id):Connect(soon)
		end
	end
	RunState.Changed("Research"):Connect(soon)
	RunState.Changed("ReadyNeeded"):Connect(soon)
	Remotes.OnClient("CellPinged", onPinged)
	CollectionService:GetInstanceAddedSignal(FRONT_WALL_TAG):Connect(function(item: Instance)
		if next(presenting) ~= nil and item:IsA("BasePart") then
			Fade.Set(item, FADE_SOURCE, 1)
			frontWalls[item] = true
		end
	end)
	input.DeviceChanged:Connect(function()
		if open then
			part("Cabinet.Pages.CommandView.View.Help.Text").Text = helpText()
		end
	end)
	table.insert(connections, UserInputService.InputBegan:Connect(onInputBegan))
	table.insert(connections, UserInputService.InputChanged:Connect(onInputChanged))
	table.insert(connections, UserInputService.InputEnded:Connect(onInputEnded))
	local function watchHealth(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if humanoid and humanoid:IsA("Humanoid") then
			lastHealth = humanoid.Health -- so the first hit after spawning flashes too
			humanoid.HealthChanged:Connect(function(health: number)
				if open and lastHealth and health < lastHealth then
					flashEdge()
				end
				lastHealth = health
			end)
		end
	end
	Players.LocalPlayer.CharacterAdded:Connect(watchHealth)
	if Players.LocalPlayer.Character then
		task.spawn(watchHealth, Players.LocalPlayer.Character)
	end
	RunService:BindToRenderStep(RENDER_NAME, RENDER_PRIORITY, render)
	log:Debug("Command View ready")
end

return CommandViewController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000078"><Properties><string name="Name">DevController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DevController: the client side of DevTools.

	For players the server marked DevAllowed (everyone in Studio, admins in a live game) it
	adds a chat command: `/dev <command> [args]` (or `/d`). Commands run on the server
	(DevService checks permission again); the answer comes back as a Notice, shown in the
	chat and the output. Four commands run on the client:
	* `/dev replica <collection>` prints this client's mirror of a collection;
	* `/dev client` prints the client's replication counters;
	* `/dev clock` prints the run state as this client sees it (Run place), with the time
	  left counted on this client from the replicated server time;
	* `/dev ready [true|false]` fires the SetReady remote, as the HUD's Ready button will,
	  and reports what the server did;
	* `/dev camera` prints the over-the-shoulder camera's state; `camera.shoulder`,
	  `camera.aim [true|false]`, `camera.look <yaw> <pitch>` (degrees), `camera.zoom <studs>`
	  and `camera.cursor` (frees or locks the mouse) drive it for tests.
	* `/dev ui` prints The Frame's state; `ui.sample`, `ui.list` and `ui.dock` open the dev sample screens
	  (Lib.UISamples), `ui.open <screen>` any registered screen, `ui.close` closes, `ui.tab <id>`
	  switches tabs, `ui.main` presses the main action.
	* `/dev hud` prints the HUD's state; `hud.alert <Danger|Warning|Info> <text>`,
	  `hud.banner <text>`, `hud.slot <1-5>` and `hud.touch [true|false]` (shows the touch
	  buttons on any device, for screenshots) drive it.
	* `/dev vote` prints the vote telegram (what it shows, your vote) and the Command View's
	  ghosts; the server's `votes`, `vote.yes|no [n]`, `vote.end` and `vote.bots` run votes.
	* `/dev cv` prints the Command View's state (with the detail panel's options); `cv.open`,
	  `cv.close`, `cv.select <floor> <column>` and `cv.ping` drive it; `cv.ghost <floor> <column>
	  <span> [label]` / `cv.unghost` show a vote's ghost outline, `cv.blink <roomId> [false]` blinks
	  a room's label, `cv.overlay <Power|Morale|Threat|Production> [false]` sets a sample reading.

	In Studio it also makes PlayerScripts.DevInvoke (a BindableFunction) so tools can run the
	same commands from the Client datamodel: DevInvoke:Invoke("replica _SelfTest").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Log = require(Shared.Utilities.Log)
local UISamples = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("UISamples"))
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local TableUtil = require(Shared.Utilities.TableUtil)

local log = Log.new("DevController")
local CHAT_LINES = 12

local DevController = {
	Name = "DevController",
	Dependencies = {
		"ReplicaController",
		"InputController",
		"CameraController",
		"UIController",
		"HUDController",
		"CommandViewController",
		"VoteController",
	},
}

local replica: any = nil
local camera: any = nil
local ui: any = nil
local hud: any = nil
local registryInput: any = nil
local commandView: any = nil
local voteView: any = nil
local devCursorFree = false
local extra: { [string]: (args: { any }) -> string? } = {} -- client commands other controllers add (DevController:Register)
local lastNotice: string? = nil
local commandMade = false

local function dump(value: any, depth: number?): string
	local level = depth or 0
	if type(value) == "string" then
		return if value == "\0none" then "NONE" else string.format("%q", value)
	elseif typeof(value) == "Vector3" then
		return string.format("(%g, %g, %g)", value.X, value.Y, value.Z)
	elseif type(value) ~= "table" then
		return tostring(value)
	elseif level > 4 then
		return "{...}"
	end
	local parts = {}
	for _, key in TableUtil.SortedKeys(value) do
		table.insert(parts, `{tostring(key)}={dump(value[key], level + 1)}`)
	end
	return "{" .. table.concat(parts, ", ") .. "}"
end

local function escape(text: string): string
	return (string.gsub(string.gsub(string.gsub(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

local function show(text: string)
	print(`[100Y dev] {text}`)
	local channels = TextChatService:FindFirstChild("TextChannels")
	local system = channels and channels:FindFirstChild("RBXSystem")
	if system and system:IsA("TextChannel") then
		local lines = string.split(text, "\n")
		for index = 1, math.min(#lines, CHAT_LINES) do
			pcall(system.DisplaySystemMessage, system, escape(lines[index]))
		end
		if #lines > CHAT_LINES then
			pcall(system.DisplaySystemMessage, system, `... {#lines - CHAT_LINES} more lines in the output (F9)`)
		end
	end
end

local function parse(text: string): (string, { any })
	local words = {}
	for word in string.gmatch(text, "%S+") do
		local number = tonumber(word)
		if word == "true" or word == "false" then
			table.insert(words, word == "true")
		elseif number ~= nil and number == number and math.abs(number) ~= math.huge then
			table.insert(words, number)
		else
			table.insert(words, string.sub(word, 1, 120))
		end
	end
	local name = table.remove(words, 1)
	return if type(name) == "string" then name else "help", words
end

local function describeClock(): string
	local runPhase = RunState.Get("RunPhase")
	if runPhase == nil then
		return "no run state in this place"
	end
	local left = RunState.TimeLeft()
	local leftText = if RunState.Get("PhaseOpen") then "no timer (until its boss is beaten)"
		elseif left then string.format("%.1f s left", left)
		else "stopped"
	local boss = RunState.Get("SurgeBoss")
	local bossText = if boss then ` ({boss})` else ""
	return `client sees: {runPhase}, cycle {RunState.Get("Cycle")}, Year {RunState.Get("Year")} ({RunState.Get("Era")}), `
		.. `{RunState.Get("CyclePhase") or "-"} {leftText}, siren {tostring(RunState.Get("Siren") == true)}, `
		.. `Surge {RunState.Get("SurgeKind") or "-"}{bossText}, {RunState.Get("YearsPerCycle")} years per cycle, `
		.. `ready {RunState.Get("ReadyCount") or 0}/{RunState.Get("ReadyNeeded") or 0}`
end

local function pressReady(on: boolean): string
	if not Remotes.InPlace("SetReady") then
		return "there is no run clock in this place"
	end
	local player = Players.LocalPlayer
	Remotes.FireServer("SetReady", on)
	local waited = 0
	while waited < 2 and player:GetAttribute("Ready") ~= on and not (on and RunState.Get("Siren") == true) do
		waited += task.wait()
	end
	return `SetReady {on}: my Ready is {tostring(player:GetAttribute("Ready"))}\n{describeClock()}`
end

local function describeUI(): string
	task.wait()
	local gui = ui:Gui()
	if not gui then
		return "ui: no Frame in this place"
	end
	local page = ui:Page()
	local items = 0
	if page then
		local content = page:FindFirstChild("Content")
		for _, name in { "Grid", "List" } do
			local holder = content and content:FindFirstChild(name)
			if holder and holder:IsA("GuiObject") and holder.Visible then
				for _, child in holder:GetChildren() do
					if child:IsA("GuiObject") then
						items += 1
					end
				end
			end
		end
	end
	return string.format(
		"ui: %s, screen %s, tab %s, %d items, cursor free %s, input blocked %s",
		if gui.Enabled then "open" else "closed",
		tostring(ui:Current()),
		tostring(ui:CurrentTab()),
		items,
		tostring(camera:State().CursorFree),
		tostring(registryInput:IsBlocked())
	)
end

local function describeHUD(): string
	task.wait()
	local state = hud:State()
	if not state.Present then
		return "hud: no HUD in this place"
	end
	return string.format(
		"hud: %s, year %s, phase %s, time %s, ready button %s, slot %d, touch %s, class %s",
		if state.Enabled then "shown" elseif state.Hidden then "hidden (a menu is open)" else "hidden",
		tostring(state.Year),
		tostring(state.Phase),
		tostring(state.TimeLeft),
		tostring(state.Ready),
		state.Slot,
		tostring(state.Touch),
		tostring(state.Class)
	)
end

local function describeCommandView(): string
	task.wait()
	task.wait()
	local state = commandView:State()
	local main = ""
	local gui = ui:Gui()
	local button = gui and gui:FindFirstChild("Cabinet") and gui.Cabinet:FindFirstChild("MainAction")
	if button and button.Visible then
		main = `, main action "{button.Content.Label.Text}" ({if button:GetAttribute("Disabled") then "greyed out" else "live"})`
	end
	local detail = ""
	local page = gui and gui:FindFirstChild("Cabinet") and gui.Cabinet.Pages:FindFirstChild("CommandView")
	if page then
		local options = {}
		for _, row in page.Detail.Options:GetChildren() do
			if row:IsA("GuiObject") then
				table.insert(options, { row.LayoutOrder, `{row:FindFirstChild("Name").Text} ({row:FindFirstChild("Value").Text})` })
			end
		end
		table.sort(options, function(a, b)
			return a[1] < b[1]
		end)
		local names = {}
		for i, option in options do
			if i <= 24 then
				table.insert(names, `{i}. {option[2]}`)
			end
		end
		detail = `\n  detail: {page.Detail:FindFirstChild("Name").Text} / {page.Detail.Sub.Text}`
			.. (if #names > 0 then "\n  options: " .. table.concat(names, "; ") else "")
	end
	return string.format(
		"command view: %s, centre (%.0f, %.0f), %.1f floors high, camera %.0f studs away, FOV %.1f, selected %s, choice %s, tab %s, %d labels, %d pings",
		if state.Open then "open" else "closed",
		state.Center.X,
		state.Center.Y,
		state.Floors,
		state.Distance,
		state.FieldOfView,
		tostring(state.Selected),
		tostring(state.Choice),
		state.Tab,
		state.Labels,
		state.Pings
	) .. (if state.Ghosts > 0 then `, {state.Ghosts} ghost(s)` else "")
		.. (if state.Blinking ~= "" then `, blinking {state.Blinking}` else "") .. main .. detail
end

local function describeCamera(): string
	task.wait() -- let a frame apply what the command changed
	task.wait()
	local state = camera:State()
	local p = state.Position
	return string.format(
		"camera: %s, %s shoulder, yaw %.0f, pitch %.0f, zoom %.1f (wanted %.1f), %s%s, FOV %.0f, %s%s, %d faded, device %s%s at (%.1f, %.1f, %.1f)",
		if state.Stopped then "STOPPED (Roblox camera)" elseif state.Active then "on" else "suspended",
		state.Shoulder,
		state.Yaw,
		state.Pitch,
		state.Distance,
		state.Wanted,
		if state.Indoors then "indoors" else "outdoors",
		if state.Blocked then ", held in by a wall" else "",
		state.FieldOfView,
		if state.Aiming then "aiming" else "not aiming",
		if state.CursorFree then ", cursor free" else "",
		state.Fading,
		state.Device,
		if state.Suspended then ", suspended" else "",
		p.X,
		p.Y,
		p.Z
	)
end

-- Runs a command line; client-side commands answer here, the rest go to the server.
local function run(text: string): string?
	local name, args = parse(text)
	local handler = extra[name]
	if handler then
		return handler(args)
	end
	if name == "replica" then
		local collection = tostring(args[1] or "")
		local values = replica:All(collection)
		local keys = TableUtil.SortedKeys(values)
		if #keys == 0 then
			return `{collection}: empty on this client`
		end
		local lines = { `{collection}: {#keys} values` }
		for _, key in keys do
			table.insert(lines, `  {key} = {dump(values[key])}`)
		end
		return table.concat(lines, "\n")
	elseif name == "client" then
		local stats = replica:Stats()
		return `client: ready={tostring(replica:IsReady())}, delta events {stats.Events}, ops {stats.Ops}, snapshots {stats.Snapshots}`
	elseif name == "clock" then
		return describeClock()
	elseif name == "ready" then
		return pressReady(args[1] ~= false)
	elseif name == "camera" then
		return describeCamera()
	elseif name == "camera.shoulder" then
		camera:SwapShoulder()
		return describeCamera()
	elseif name == "camera.aim" then
		camera:SetAiming(args[1] ~= false)
		return describeCamera()
	elseif name == "camera.look" then
		camera:SetLook(tonumber(args[1]) or 0, tonumber(args[2]) or 0)
		return describeCamera()
	elseif name == "camera.zoom" then
		camera:SetZoom(tonumber(args[1]) or 9)
		return describeCamera()
	elseif name == "camera.cursor" then
		devCursorFree = not devCursorFree
		camera:FreeCursor("DevTools", devCursorFree)
		return describeCamera()
	elseif name == "ui" then
		return describeUI()
	elseif name == "ui.sample" or name == "ui.list" or name == "ui.dock" then
		UISamples.Register(ui, replica)
		ui:Open(if name == "ui.sample" then "Sample" elseif name == "ui.list" then "SampleList" else "SampleDocked")
		return describeUI()
	elseif name == "ui.open" then
		UISamples.Register(ui, replica)
		ui:Open(tostring(args[1] or "Sample"))
		return describeUI()
	elseif name == "ui.close" then
		ui:Close()
		return describeUI()
	elseif name == "ui.tab" then
		ui:SelectTab(tostring(args[1] or ""))
		return describeUI()
	elseif name == "ui.main" then
		ui:PressMainAction()
		return describeUI()
	elseif name == "hud" then
		return describeHUD()
	elseif name == "hud.alert" then
		local kind = tostring(args[1] or "Warning")
		local words = {}
		for i = 2, #args do
			table.insert(words, tostring(args[i]))
		end
		hud:Alert(if kind == "Danger" or kind == "Info" then kind else "Warning", table.concat(words, " "))
		return describeHUD()
	elseif name == "hud.banner" then
		local words = {}
		for _, word in args do
			table.insert(words, tostring(word))
		end
		hud:Banner(table.concat(words, " "), "Warning", 6)
		return describeHUD()
	elseif name == "hud.slot" then
		hud:SelectSlot(tonumber(args[1]) or 1)
		return describeHUD()
	elseif name == "hud.touch" then
		hud:SetForceTouch(args[1] ~= false)
		return describeHUD()
	elseif name == "vote" then
		local state = voteView:State()
		return `vote telegram: {if state.Visible then "showing " .. tostring(state.Shown) else "hidden"}`
			.. (if state.Visible then `\n  {state.Proposal}\n  {state.Tally}\n  your vote: {tostring(state.Mine)}` else "")
			.. `\n  ghosts: {if state.Ghosts ~= "" then state.Ghosts else "none"}`
	elseif name == "cv" then
		return describeCommandView()
	elseif name == "cv.open" or name == "cv.close" then
		if commandView:IsOpen() ~= (name == "cv.open") then
			commandView:Toggle()
		end
		task.wait(0.5)
		return describeCommandView()
	elseif name == "cv.select" then
		commandView:Select(tonumber(args[1]), tonumber(args[2]))
		return describeCommandView()
	elseif name == "cv.ping" then
		local state = commandView:State()
		if not state.Selected then
			return "cv.ping: select a cell first (cv.select <floor> <column>)"
		end
		local floor, column = string.match(state.Selected, "^(%-?%d+),(%-?%d+)$")
		Remotes.FireServer("PingCell", tonumber(floor), tonumber(column))
		task.wait(0.5)
		return describeCommandView()
	elseif name == "cv.ghost" then
		-- the outline a vote will show for a proposed room (Prompt 8 calls ShowGhost)
		commandView:ShowGhost("dev", tonumber(args[1]) or 2, tonumber(args[2]) or 3, tonumber(args[3]) or 1,
			if args[4] ~= nil then tostring(args[4]) else "Proposed")
		return describeCommandView()
	elseif name == "cv.unghost" then
		commandView:HideGhost("dev")
		return describeCommandView()
	elseif name == "cv.blink" then
		commandView:Blink(tostring(args[1] or "R1"), args[2] ~= false)
		return describeCommandView()
	elseif name == "cv.overlay" then
		-- a sample reading for screenshots (green, amber, red by room number), until the systems
		-- that own each overlay register real ones
		local overlay = tostring(args[1] or "Power")
		if args[2] == false then
			commandView:SetOverlay(overlay, nil)
		else
			local lamps = { "Lamp_Green", "Lamp_Amber", "Lamp_Red" }
			commandView:SetOverlay(overlay, function(roomId: string): string?
				return lamps[(tonumber(string.match(roomId, "%d+")) or 0) % 3 + 1]
			end)
		end
		return describeCommandView()
	end
	if #args > 8 then
		return "at most 8 arguments"
	end
	Remotes.FireServer("DevCommand", string.sub(name, 1, 48), args)
	return nil
end

local function makeChatCommand()
	if commandMade or Players.LocalPlayer:GetAttribute("DevAllowed") ~= true then
		return
	end
	commandMade = true
	local command = Instance.new("TextChatCommand")
	command.Name = "DevCommand"
	command.PrimaryAlias = "/dev"
	command.SecondaryAlias = "/d"
	command.Triggered:Connect(function(_source: TextSource, message: string)
		local rest = string.match(message, "^%S+%s*(.*)$") or ""
		local answer = run(if rest == "" then "help" else rest)
		if answer then
			show(answer)
		end
	end)
	command.Parent = TextChatService
	log:Debug("/dev ready")
end

-- Adds a command that runs on this client: a place's own controllers use it (the Run place's
-- CutsceneController: `cutscene.play`). The handler returns the answer.
function DevController:Register(name: string, handler: (args: { any }) -> string?)
	extra[name] = handler
end

function DevController:Init(registry)
	replica = registry.ReplicaController
	camera = registry.CameraController
	ui = registry.UIController
	hud = registry.HUDController
	registryInput = registry.InputController
	commandView = registry.CommandViewController
	voteView = registry.VoteController
	Remotes.OnClient("Notice", function(text: any)
		if type(text) == "string" then
			lastNotice = text
			show(text)
		end
	end)
end

function DevController:Start()
	local player = Players.LocalPlayer
	player:GetAttributeChangedSignal("DevAllowed"):Connect(makeChatCommand)
	makeChatCommand()

	if RunService:IsStudio() then
		local invoke = Instance.new("BindableFunction")
		invoke.Name = "DevInvoke"
		invoke.OnInvoke = function(line: any): string
			if type(line) ~= "string" then
				return "usage: DevInvoke:Invoke(\"replica Rooms\")"
			end
			lastNotice = nil
			local answer = run(line)
			if answer then
				return answer
			end
			local waited = 0
			while lastNotice == nil and waited < 5 do
				waited += task.wait()
			end
			return lastNotice or "no answer from the server within 5 s"
		end
		invoke.Parent = script.Parent.Parent
	end
end

return DevController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000079"><Properties><string name="Name">HUDController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	HUDController: the run HUD (bible Section 18), StarterGui.HUD in the Run place. Fixed
	positions, separate from The Frame; this controller only fills the layout in.

	Live now:
	* Top centre: the year flip counter (the tiles flip when the year changes), the era, the
	  cycle dial (day, then Surge) with the phase and the time left, and the Ready button with
	  the team's count (the SetReady remote). A boss Surge has no timer.
	* Banners under the vote telegram: the siren and the start of each Surge.
	* Top left: health from the character; the class and its ability (the Survivor until the
	  loadout arrives); stamina and radiation rest until combat.
	* Top right: the stockpile chips (values come with the economy, Prompt 9), the seismograph
	  (Disturbance, Prompt 14: the trace swings wider as it rises, a Tremor throws it wide, and the
	  reading says CALM, RISING, UNSETTLED or DANGER) and the Command View button.
	* Bottom centre: the hotbar's selection (1 to 5, the D-pad, a tap).
	* Bottom right on touch: Fire, Aim, Melee, Ability, Interact, Jump, Dodge, Sprint (a
	  toggle), Ping and Shoulder, bound through InputController. Roblox's own jump button is
	  hidden while ours shows.

	On PC the camera locks the mouse; a click of the mouse wheel frees the cursor to click HUD
	buttons, and another click locks it again. Ready has its own key (Z, D-pad down).

	For later systems: Alert(kind, text) for the alert feed, Banner(text, kind) for
	announcements, HoldBanner(reason, on) while something else owns the banner's place (Prompt
	13: the meltdown telegram), SetVital, SetClass, SetResource, SetSlot and the HotbarSelected
	signal.

	The HUD hides during the intro and while a Frame screen is open.
]]

local Players = game:GetService("Players")
