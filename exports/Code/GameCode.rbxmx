--[[
	Conditions on residents (bible Section 11). Amounts are provisional, for Prompts 10 and 26.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Text = F.Text,
		OutputMultiplier = Check.optional(F.NonNegative),
		HealthPerCycle = Check.optional(F.Number),
		MoraleNow = Check.optional(F.Number),
		Cycles = Check.optional(F.PositiveInt), -- how long it lasts on its own
		Contagious = F.Flag,
		StopsWork = F.Flag,
		Phase = Check.integer(1, 3), -- resident build phase (Section 11)
	}),
	Order = { "Injured", "Irradiated", "Panicked", "Inspired", "Sick", "Grieving", "Exhausted" },
	Entries = {
		Injured = { Name = "Injured", Text = "Works slowly until treated.", OutputMultiplier = 0.6, Phase = 2 },
		Irradiated = { Name = "Irradiated", Text = "Loses health until cleared.", HealthPerCycle = -10, Phase = 2 },
		Panicked = {
			Name = "Panicked",
			Text = "Flees danger and stops working. Brave and Cool Head residents never panic.",
			StopsWork = true,
			Phase = 2,
		},
		Inspired = { Name = "Inspired", Text = "Morale 90 or more: +20% output.", OutputMultiplier = 1.2, Phase = 2 },
		Sick = { Name = "Sick", Text = "Contagious until treated.", OutputMultiplier = 0.7, HealthPerCycle = -5, Contagious = true, Phase = 2 },
		Grieving = { Name = "Grieving", Text = "A friend died: -20 morale for 2 cycles.", MoraleNow = -20, Cycles = 2, Phase = 3 },
		Exhausted = { Name = "Exhausted", Text = "Rest at 0: works at half speed.", OutputMultiplier = 0.5, Phase = 1 },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">DepthBands</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DepthBands: the Deep in bands of floors (bible Sections 6 and 12). Opening a band's first
	floor needs a Push Deeper vote. DigSeconds is per cell for a player with a Drill or Pickaxe.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Floors = Check.shape({ From = Check.integer(1, 10), To = Check.integer(1, 10) }),
		Look = F.Text,
		Ore = Check.optional(Check.ref("Resources")),
		DigSeconds = Check.optional(F.Seconds),
		CavePieces = F.Count,
		Monsters = Check.array(Check.ref("Monsters"), 8),
		Hazards = Check.array(Check.ref("Disasters"), 6),
		LostCrew = F.Flag,
		Buildable = Check.boolean(),
	}),
	Order = { "Mines", "FloodedCaverns", "CrystalHollows", "SourceChamber" },
	Entries = {
		Mines = {
			Name = "Mines",
			Floors = { From = 1, To = 3 },
			Look = "Timber props, lanterns, old carts",
			Ore = "Iron",
			DigSeconds = 20,
			CavePieces = 8,
			Monsters = { "BurrowTick", "TunnelHound", "HollowMiner", "SpitterGrub" },
			Hazards = { "GasLeak", "CaveIn" },
			LostCrew = true,
			Buildable = true,
		},
		FloodedCaverns = {
			Name = "Flooded Caverns",
			Floors = { From = 4, To = 6 },
			Look = "Dripping rock, standing water, burst pipes",
			Ore = "Copper",
			DigSeconds = 30,
			CavePieces = 8,
			Monsters = { "Murkling", "BloatToad", "Lurker", "TideCrab" },
			Hazards = { "Flood", "GasLeak", "CaveIn" },
			LostCrew = true,
			Buildable = true,
		},
		CrystalHollows = {
			Name = "Crystal Hollows",
			Floors = { From = 7, To = 9 },
			Look = "Glowing crystal, radiation",
			Ore = "Crystal",
			DigSeconds = 45,
			CavePieces = 8,
			Monsters = { "Shardling", "PrismStalker", "GeodeGolem", "Resonator" },
			Hazards = { "RadiationLeak", "CaveIn" },
			LostCrew = true,
			Buildable = true,
		},
		SourceChamber = {
			Name = "Source Chamber",
			Floors = { From = 10, To = 10 },
			Look = "A living cavern around the Source",
			DigSeconds = 45,
			CavePieces = 1,
			Monsters = {},
			Hazards = {},
			Buildable = false,
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">Difficulties</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Difficulties (bible Sections 5 and 16): Normal at first; Hard unlocks after a Century
	Victory, Nightmare after a Hard win. Threat and resource multipliers are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Unlock = F.Short,
		ThreatMultiplier = F.NonNegative,
		ResourceMultiplier = F.NonNegative,
		PayoutMultiplier = F.NonNegative,
		Badge = Check.optional(Check.ref("Badges")),
	}),
	Order = { "Normal", "Hard", "Nightmare" },
	Entries = {
		Normal = { Name = "Normal", Unlock = "From the start", ThreatMultiplier = 1, ResourceMultiplier = 1, PayoutMultiplier = 1 },
		Hard = { Name = "Hard", Unlock = "After a Century Victory", ThreatMultiplier = 1.35, ResourceMultiplier = 0.8, PayoutMultiplier = 1.5, Badge = "HardVictory" },
		Nightmare = { Name = "Nightmare", Unlock = "After a Hard win", ThreatMultiplier = 1.75, ResourceMultiplier = 0.65, PayoutMultiplier = 2, Badge = "NightmareVictory" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">DigResults</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DigResults: what a newly dug cell holds, rolled when it opens (bible Section 6). Chances
	are weights out of 100 (provisional). MinEra keeps cryo pods to Era II onward.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Chance = F.NonNegative,
		MinEra = Check.optional(Check.integer(1, 4)),
		Effect = F.Text,
		Loot = Check.optional(Check.ref("LootTables")),
	}),
	Order = { "Empty", "OrePocket", "CaveOpening", "HazardPocket", "Cache", "CryoPod", "Nest" },
	Entries = {
		Empty = { Name = "Empty", Chance = 60, Effect = "Ready to build on" },
		OrePocket = { Name = "Ore pocket", Chance = 20, Effect = "Bonus ore", Loot = "OrePocket" },
		CaveOpening = { Name = "Cave opening", Chance = 8, Effect = "Opens a 3D cave area" },
		HazardPocket = { Name = "Hazard pocket", Chance = 6, Effect = "Gas or water bursts out" },
		Cache = { Name = "Cache", Chance = 4, Effect = "Scrap, gear or a radio log", Loot = "Cache" },
		CryoPod = { Name = "Cryo pod", Chance = 1, MinEra = 2, Effect = "A frozen survivor" },
		Nest = { Name = "Nest", Chance = 1, Effect = "Monsters pour out at once; destroying it pays well", Loot = "Nest" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Disasters</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Disasters: one comes with every Surge (bible Section 10). Numbers are provisional, for
	Prompts 13, 23 and 24. BestClass names the class built to stop it.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		CausedBy = F.Short,
		Effect = F.Text,
		Fix = F.Text,
		BestClass = Check.ref("Classes"),
		Era = Check.integer(1, 4),
		ThreatCost = F.PositiveInt,
		RoomDamagePerSecond = Check.optional(F.NonNegative),
		SpreadSeconds = Check.optional(F.Seconds),
		TimerSeconds = Check.optional(F.Seconds),
		DurationSeconds = Check.optional(F.Seconds),
	}),
	Order = { "Fire", "Flood", "Blackout", "CaveIn", "GasLeak", "ReactorOverload", "RadiationLeak", "Outbreak", "ElectricalSurge" },
	Entries = {
		Fire = {
			Name = "Fire",
			CausedBy = "Surges, Reactor overload, Clumsy residents, electrical surges",
			Effect = "Spreads to the next room every 15 seconds, burning room HP and residents.",
			Fix = "Extinguisher, Foam Grenade, residents in the room.",
			BestClass = "Firefighter",
			Era = 1, ThreatCost = 10, RoomDamagePerSecond = 6, SpreadSeconds = 15,
		},
		Flood = {
			Name = "Flood",
			CausedBy = "Flooded Caverns hazards, Bloat Toads, The Deluge",
			Effect = "Water rises in a room and pours down the Shaft.",
			Fix = "Patch the burst pipe, then the room drains.",
			BestClass = "Firefighter",
			Era = 2, ThreatCost = 10, RoomDamagePerSecond = 3, SpreadSeconds = 20,
		},
		Blackout = {
			Name = "Blackout",
			CausedBy = "Surges, electrical surges",
			Effect = "A floor or the whole grid goes dark.",
			Fix = "Reset the fuse box in the Reactor Core.",
			BestClass = "Engineer",
			Era = 1, ThreatCost = 8, DurationSeconds = 60,
		},
		CaveIn = {
			Name = "Cave-in",
			CausedBy = "Digging, Tremors",
			Effect = "Rubble blocks a doorway or cell and can trap residents.",
			Fix = "Dig or smash through the rubble.",
			BestClass = "Driller",
			Era = 1, ThreatCost = 8,
		},
		GasLeak = {
			Name = "Gas leak",
			CausedBy = "Hazard pockets in the Mines",
			Effect = "Poison gas fills a room, hurting everyone inside.",
			Fix = "Seal the vent or air the room out.",
			BestClass = "HazmatTech",
			Era = 2, ThreatCost = 10, DurationSeconds = 90,
		},
		ReactorOverload = {
			Name = "Reactor overload",
			CausedBy = "A damaged or overclocked Reactor Core",
			Effect = "A 60-second meltdown timer.",
			Fix = "Three valves turned at the same time, so it takes teamwork.",
			BestClass = "Engineer",
			Era = 1, ThreatCost = 14, TimerSeconds = 60,
		},
		RadiationLeak = {
			Name = "Radiation leak",
			CausedBy = "Surface storms against a weak Blast Door",
			Effect = "Floor 1 fills with radiation.",
			Fix = "Seal or upgrade the door; Decon Room.",
			BestClass = "HazmatTech",
			Era = 3, ThreatCost = 12, DurationSeconds = 120,
		},
		Outbreak = {
			Name = "Outbreak",
			CausedBy = "Wanderers, the Deep",
			Effect = "A sickness spreads between residents.",
			Fix = "Medbay treatment and quarantine in Quarters.",
			BestClass = "Medic",
			Era = 3, ThreatCost = 12,
		},
		ElectricalSurge = {
			Name = "Electrical surge",
			CausedBy = "Random, more often in Era III",
			Effect = "Sparks damage the machines in one room.",
			Fix = "Repair with the Welder.",
			BestClass = "Engineer",
			Era = 1, ThreatCost = 6, RoomDamagePerSecond = 10, DurationSeconds = 20,
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">DraftCards</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DraftCards: the blueprint card pool (bible Section 8 and the Appendix). After every Surge
	three cards are drawn and the team votes for one; a card taken leaves the pool for the run.
	Room cards weigh more early (EarlyWeight applies in Era I), so every run gets its key rooms.
	Weights are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function mod(key: string, value: number, extra: { [string]: any }?): { [string]: any }
	local t: { [string]: any } = { Key = key, Value = value }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

local function roomCard(room: string, name: string): { [string]: any }
	return { Name = name, Kind = "Room", Room = room, Text = `Unlocks the {name} for the run.`, Weight = 10, EarlyWeight = 20 }
end

local function card(kind: string, name: string, text: string, modifiers: { any }, weight: number?): { [string]: any }
	return { Name = name, Kind = kind, Text = text, Modifiers = modifiers, Weight = weight or 8 }
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "Room", "BunkerPerk", "ResidentBoon", "PlayerBoon", "RiskDeal" }),
		Text = F.Text,
		Room = Check.optional(Check.ref("Rooms")),
		Modifiers = Check.optional(F.Modifiers),
		Weight = F.NonNegative,
		EarlyWeight = Check.optional(F.NonNegative),
	}),
	Entries = {
		ArmoryCard = roomCard("Armory", "Armory"),
		RadioRoomCard = roomCard("RadioRoom", "Radio Room"),
		LoungeCard = roomCard("Lounge", "Lounge"),
		LabCard = roomCard("Lab", "Lab"),
		DrillBayCard = roomCard("DrillBay", "Drill Bay"),
		GreenhouseCard = roomCard("Greenhouse", "Greenhouse"),
		TrainingRoomCard = roomCard("TrainingRoom", "Training Room"),
		TradingPostCard = roomCard("TradingPost", "Trading Post"),
		MemorialCard = roomCard("Memorial", "Memorial"),

		ReinforcedWalls = card("BunkerPerk", "Reinforced Walls", "+25% room HP.", { mod("RoomHP", 1.25) }),
		Sprinklers = card("BunkerPerk", "Sprinklers", "Fire spreads 50% slower.", { mod("FireSpread", 0.5) }),
		SumpPumps = card("BunkerPerk", "Sump Pumps", "Floods drain twice as fast.", { mod("FloodDrainSpeed", 2) }),
		InsulatedGrid = card("BunkerPerk", "Insulated Grid", "Blackouts last half as long.", { mod("BlackoutDuration", 0.5) }),
		DeepLamps = card("BunkerPerk", "Deep Lamps", "Halves the extra monster spawns in dark rooms.", { mod("DarkSpawnBonus", 0.5) }),
		SteelBlastDoor = card("BunkerPerk", "Steel Blast Door", "Blast Door +1 level.", { mod("BlastDoorLevel", 1) }),
		GasFilters = card("BunkerPerk", "Gas Filters", "Gas leaks 50% weaker.", { mod("GasStrength", 0.5) }),

		FieldTraining = card("ResidentBoon", "Field Training", "Every resident +1 level.", { mod("ResidentLevels", 1) }),
		MoraleBroadcast = card("ResidentBoon", "Morale Broadcast", "+15 morale for everyone.", { mod("MoraleNow", 15) }),
		RadioBooster = card("ResidentBoon", "Radio Booster", "Two recruits arrive now.", { mod("RecruitsNow", 2) }),
		VeteranRecruit = card("ResidentBoon", "Veteran Recruit", "A Rare resident joins.", { mod("RareRecruitNow", 1) }),

		ArmoryShipment = card("PlayerBoon", "Armory Shipment", "Every player's weapons +1 rarity.", { mod("WeaponRarityUp", 1) }),
		MedCache = card("PlayerBoon", "Med Cache", "+2 Medkits for every player.", { mod("MedkitsPerPlayer", 2) }),
		AmmoPress = card("PlayerBoon", "Ammo Press", "Ammo crafting costs 30% less.", { mod("AmmoCraftCost", 0.7) }),
		FieldRations = card("PlayerBoon", "Field Rations", "+20% stamina for the rest of the run.", { mod("StaminaMult", 1.2) }),

		DeepCharges = card("RiskDeal", "Deep Charges", "Digging twice as fast, but +50% Disturbance.", {
			mod("DigSpeed", 2, { Scope = "Team" }),
			mod("DigDisturbance", 1.5, { Scope = "Team" }),
		}, 5),
		Overclock = card("RiskDeal", "Overclock", "Reactor Core +50% power, with a chance of overload.", {
			mod("RoomOutput", 1.5, { Room = "ReactorCore" }),
			mod("ReactorOverloadChance", 0.15),
		}, 5),
		BlackMarket = card("RiskDeal", "Black Market", "The trader arrives now with rare stock at +50% prices.", {
			mod("TraderNow", 1),
			mod("TraderRareStock", 1),
			mod("TraderPrices", 1.5),
		}, 5),
		BountyContract = card("RiskDeal", "Bounty Contract", "Kill 30 monsters before the next Surge for 500 Scrap.", {
			mod("BountyKills", 30),
			mod("BountyScrap", 500),
		}, 5),
		SalvageRights = card("RiskDeal", "Salvage Rights", "Double loot on the next surface trip, but the next storm hits 30 seconds early.", {
			mod("NextTripLoot", 2),
			mod("NextStormEarlySeconds", 30),
		}, 5),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">Eras</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Eras: the century in quarters, each ended by a boss (bible Section 5). When the year
	counter passes an era's last year, the next Surge is that era's boss.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Number = Check.integer(1, 4),
		Name = F.Name,
		Years = Check.shape({ From = Check.integer(1, 100), To = Check.integer(1, 100) }),
		Band = Check.ref("DepthBands"),
		NewMonsters = Check.array(Check.ref("Monsters"), 8),
		NewDisasters = Check.array(Check.ref("Disasters"), 8),
		Raids = F.Flag,
		Boss = Check.ref("Bosses"),
		Text = F.Short,
	}),
	Order = { "SettlingIn", "Expansion", "Upheaval", "Reckoning" },
	Entries = {
		SettlingIn = {
			Number = 1,
			Name = "Settling In",
			Years = { From = 1, To = 25 },
			Band = "Mines",
			NewMonsters = { "BurrowTick", "TunnelHound", "HollowMiner", "SpitterGrub" },
			NewDisasters = { "Fire", "Blackout", "CaveIn" },
			Boss = "BroodMother",
			Text = "Mines, depth 1 to 3",
		},
		Expansion = {
			Number = 2,
			Name = "Expansion",
			Years = { From = 26, To = 50 },
			Band = "FloodedCaverns",
			NewMonsters = { "Murkling", "BloatToad", "Lurker", "TideCrab", "AshRaider" },
			NewDisasters = { "Flood", "GasLeak" },
			Raids = true,
			Boss = "Deluge",
			Text = "Flooded Caverns, depth 4 to 6; raids on the blast door",
		},
		Upheaval = {
			Number = 3,
			Name = "Upheaval",
			Years = { From = 51, To = 75 },
			Band = "CrystalHollows",
			NewMonsters = { "Shardling", "PrismStalker", "GeodeGolem", "Resonator" },
			NewDisasters = { "RadiationLeak", "Outbreak" },
			Raids = true,
			Boss = "CrystalColossus",
			Text = "Crystal Hollows, depth 7 to 9",
		},
		Reckoning = {
			Number = 4,
			Name = "Reckoning",
			Years = { From = 76, To = 100 },
			Band = "SourceChamber",
			NewMonsters = {},
			NewDisasters = {},
			Raids = true,
			Boss = "Source",
			Text = "Source Chamber, depth 10: everything before, stronger",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">GamePasses</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	GamePasses: bought once (bible Section 17). PassId is set when the passes are created
	(Prompt 28). Prices provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function mod(key: string, value: number): { [string]: any }
	return { Key = key, Value = value }
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Robux = F.PositiveInt,
		Text = F.Text,
		Modifiers = Check.optional(F.Modifiers),
		NewPlayersOnly = F.Flag,
		PassId = Check.optional(F.PositiveInt),
	}),
	Order = { "VIP", "BigBackpack", "HelperDrone", "ExtraTalentSlot", "QuickRevive", "StarterPack" },
	Entries = {
		VIP = {
			Name = "VIP",
			Robux = 399,
			Text = "+25% Glowshards from runs, a second free class shop reroll each day, VIP lounge and tag in the lobby.",
		},
		BigBackpack = { Name = "Big Backpack", Robux = 199, Text = "+5 backpack slots.", Modifiers = { mod("BackpackSlots", 5) } },
		HelperDrone = {
			Name = "Helper Drone",
			Robux = 299,
			Text = "A personal drone that picks up loot and lights dark rooms; it doesn't fight.",
		},
		ExtraTalentSlot = { Name = "Extra Talent Slot", Robux = 249, Text = "Talent slot 2 without spending Glowshards." },
		QuickRevive = { Name = "Quick Revive", Robux = 249, Text = "Downed timer +50% and one free self-revive per run." },
		StarterPack = {
			Name = "Starter Pack",
			Robux = 199,
			Text = "New players only: 150 Glowshards, a Rare class of your choice, a Steadfast outfit.",
			NewPlayersOnly = true,
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">GlowshardPacks</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	GlowshardPacks: the premium currency for Robux (bible Section 17). ProductId is set when the
	developer products are created (Prompt 28); prices are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Glowshards = F.PositiveInt,
		Robux = F.PositiveInt,
		ProductId = Check.optional(F.PositiveInt),
	}),
	Order = { "Pack25", "Pack140", "Pack300", "Pack650", "Pack1800" },
	Entries = {
		Pack25 = { Glowshards = 25, Robux = 99 },
		Pack140 = { Glowshards = 140, Robux = 499 },
		Pack300 = { Glowshards = 300, Robux = 999 },
		Pack650 = { Glowshards = 650, Robux = 1999 },
		Pack1800 = { Glowshards = 1800, Robux = 4999 },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">GlowshardRewards</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	GlowshardRewards: what a run and the meta pay (bible Section 16). A Normal Century Victory
	pays about 50 before quests. Badges, quests and chests carry their own amounts.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Text = F.Short,
		Per = Check.enum({ "YearsSurvived", "BandReached", "Win", "Boss", "Run" }),
		Amount = F.NonNegative,
		Every = Check.optional(F.PositiveInt), -- e.g. 1 per 4 years
		Victory = Check.optional(Check.enum({ "Century", "Deep" })),
		Multiplier = Check.optional(F.NonNegative),
	}),
	Entries = {
		Years = { Text = "1 per 4 years survived (25 for a full century)", Per = "YearsSurvived", Amount = 1, Every = 4 },
		Bands = { Text = "3 per depth band reached (12 for the Source Chamber)", Per = "BandReached", Amount = 3 },
		CenturyVictory = { Text = "Century Victory", Per = "Win", Amount = 15, Victory = "Century" },
		DeepVictory = { Text = "Deep Victory", Per = "Win", Amount = 30, Victory = "Deep" },
		Bosses = { Text = "2 per boss killed", Per = "Boss", Amount = 2 },
		FirstWinOfDay = { Text = "First win of the day doubles that run's payout", Per = "Run", Amount = 0, Multiplier = 2 },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">ItemRarities</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ItemRarities: weapon and gear rarities (bible Section 9: Rusty, Standard, Reinforced,
	Prototype, Legendary; higher rarity adds damage and one extra perk). Resident outfits give
	+1 to +3 by rarity (Section 11). Multipliers are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Rank = Check.integer(1, 5),
		DamageMultiplier = F.NonNegative,
		Perks = Check.integer(0, 4),
		OutfitBonus = Check.integer(0, 3),
		Color = F.Hex,
	}),
	Order = { "Rusty", "Standard", "Reinforced", "Prototype", "Legendary" },
	Entries = {
		Rusty = { Name = "Rusty", Rank = 1, DamageMultiplier = 0.85, Perks = 0, OutfitBonus = 0, Color = "#8C5B3B" },
		Standard = { Name = "Standard", Rank = 2, DamageMultiplier = 1, Perks = 0, OutfitBonus = 1, Color = "#8E8C88" },
		Reinforced = { Name = "Reinforced", Rank = 3, DamageMultiplier = 1.15, Perks = 1, OutfitBonus = 2, Color = "#3F79B5" },
		Prototype = { Name = "Prototype", Rank = 4, DamageMultiplier = 1.3, Perks = 2, OutfitBonus = 3, Color = "#7D4C9E" },
		Legendary = { Name = "Legendary", Rank = 5, DamageMultiplier = 1.5, Perks = 3, OutfitBonus = 3, Color = "#D9A93A" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Items: weapons, throwables, tools, consumables and resident gear (bible Sections 9, 11 and
	the Appendix). Combat numbers are provisional starting points for the combat prompts
	(11 and 20); rarity scales damage (ItemRarities). AmmoPerShot follows bible Section 9.
	ClassKit marks items that only come in a class kit (Arc Rifle: or as a rare drop).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Melee = Check.shape({
	Damage = F.NonNegative,
	HeavyDamage = F.NonNegative,
	SwingSeconds = F.Seconds,
	Knockback = Check.optional(F.NonNegative),
	StunSeconds = Check.optional(F.Seconds),
	BreaksRubble = F.Flag,
	Digs = F.Flag,
})

local Gun = Check.shape({
	Damage = F.NonNegative,
	Pellets = Check.optional(F.PositiveInt),
	FireRate = F.NonNegative, -- shots (or flame ticks) per second
	Range = F.NonNegative,
	Magazine = F.PositiveInt,
	ReloadSeconds = F.Seconds,
	AmmoPerShot = F.Count,
	SpreadDegrees = F.NonNegative,
	Cone = F.Flag, -- flamethrower: a short cone, not a ray
	Projectile = F.Flag, -- grenade launcher: a real projectile
	BlastRadius = Check.optional(F.NonNegative),
	ChainTargets = Check.optional(F.Count),
	Automatic = F.Flag,
})

local Throwable = Check.shape({
	Radius = F.NonNegative,
	Damage = Check.optional(F.NonNegative),
	StunSeconds = Check.optional(F.Seconds),
	LightSeconds = Check.optional(F.Seconds),
	Extinguishes = F.Flag,
	RevealsHidden = F.Flag,
	Trap = F.Flag,
})

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "Melee", "Gun", "Throwable", "Tool", "Consumable", "Outfit", "ResidentTool", "Placeable" }),
		Text = F.Short,
		Melee = Check.optional(Melee),
		Gun = Check.optional(Gun),
		Throwable = Check.optional(Throwable),
		Outfit = Check.optional(Check.shape({ Stat = Check.ref("Stats"), Health = Check.optional(F.Count), IgnoresGas = F.Flag })),
		ResidentUse = Check.optional(F.Short), -- what a resident does with it as gear
		UsesResource = Check.optional(Check.ref("Resources")),
		HasRarity = F.Flag,
		ClassKit = F.Flag,
		Asset = F.Asset,
	}),
	Entries = {
		-- Melee
		Wrench = {
			Name = "Wrench",
			Kind = "Melee",
			Text = "Fast and light.",
			Melee = { Damage = 14, HeavyDamage = 26, SwingSeconds = 0.35 },
			ResidentUse = "Repairs their room faster",
			HasRarity = true,
			Asset = "Weapon_Wrench",
		},
		LeadPipe = {
			Name = "Lead Pipe",
			Kind = "Melee",
			Text = "Balanced.",
			Melee = { Damage = 20, HeavyDamage = 36, SwingSeconds = 0.5 },
			HasRarity = true,
			Asset = "Weapon_LeadPipe",
		},
		FireAxe = {
			Name = "Fire Axe",
			Kind = "Melee",
			Text = "Heavy; breaks rubble.",
			Melee = { Damage = 32, HeavyDamage = 58, SwingSeconds = 0.8, BreaksRubble = true },
			HasRarity = true,
			Asset = "Weapon_FireAxe",
		},
		Sledgehammer = {
			Name = "Sledgehammer",
			Kind = "Melee",
			Text = "Slow, big knockback.",
			Melee = { Damage = 45, HeavyDamage = 80, SwingSeconds = 1.1, Knockback = 30, BreaksRubble = true },
			HasRarity = true,
			Asset = "Weapon_Sledgehammer",
		},
		ShockBaton = {
			Name = "Shock Baton",
			Kind = "Melee",
			Text = "Stuns.",
			Melee = { Damage = 16, HeavyDamage = 28, SwingSeconds = 0.5, StunSeconds = 1.2 },
			HasRarity = true,
			Asset = "Weapon_ShockBaton",
		},
		Pickaxe = {
			Name = "Pickaxe",
			Kind = "Melee",
			Text = "Also digs.",
			Melee = { Damage = 22, HeavyDamage = 40, SwingSeconds = 0.7, Digs = true },
			HasRarity = true,
			Asset = "Weapon_Pickaxe",
		},

		-- Guns
		PocketPistol = {
			Name = "Pocket Pistol",
			Kind = "Gun",
			Text = "Light ammo, quick.",
			Gun = { Damage = 12, FireRate = 4, Range = 120, Magazine = 10, ReloadSeconds = 1.2, AmmoPerShot = 1, SpreadDegrees = 1.5 },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_PocketPistol",
		},
		ServiceRevolver = {
			Name = "Service Revolver",
			Kind = "Gun",
			Text = "Heavy single shots.",
			Gun = { Damage = 34, FireRate = 1.4, Range = 160, Magazine = 6, ReloadSeconds = 2.2, AmmoPerShot = 1, SpreadDegrees = 0.8 },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_ServiceRevolver",
		},
		PumpShotgun = {
			Name = "Pump Shotgun",
			Kind = "Gun",
			Text = "Close range.",
			Gun = { Damage = 9, Pellets = 8, FireRate = 1, Range = 40, Magazine = 6, ReloadSeconds = 3, AmmoPerShot = 2, SpreadDegrees = 7 },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_PumpShotgun",
		},
		LeverRifle = {
			Name = "Lever Rifle",
			Kind = "Gun",
			Text = "Long range.",
			Gun = { Damage = 45, FireRate = 1.2, Range = 300, Magazine = 7, ReloadSeconds = 2.5, AmmoPerShot = 2, SpreadDegrees = 0.3 },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_LeverRifle",
		},
		RivetSMG = {
			Name = "Rivet SMG",
			Kind = "Gun",
			Text = "Fast fire, light ammo.",
			Gun = { Damage = 9, FireRate = 10, Range = 90, Magazine = 30, ReloadSeconds = 1.8, AmmoPerShot = 1, SpreadDegrees = 3, Automatic = true },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_RivetSMG",
		},
		Flamethrower = {
			Name = "Flamethrower",
			Kind = "Gun",
			Text = "Exterminator's kit; short cone.",
			Gun = { Damage = 6, FireRate = 10, Range = 18, Magazine = 100, ReloadSeconds = 3, AmmoPerShot = 1, SpreadDegrees = 20, Cone = true, Automatic = true },
			UsesResource = "Ammo",
			HasRarity = true,
			ClassKit = true,
			Asset = "Weapon_Flamethrower",
		},
		GrenadeLauncher = {
			Name = "Grenade Launcher",
			Kind = "Gun",
			Text = "Demolitionist's kit; explosive rounds.",
			Gun = { Damage = 80, FireRate = 0.8, Range = 150, Magazine = 4, ReloadSeconds = 3, AmmoPerShot = 3, SpreadDegrees = 0, Projectile = true, BlastRadius = 10 },
			UsesResource = "Ammo",
			HasRarity = true,
			ClassKit = true,
			Asset = "Weapon_GrenadeLauncher",
		},
		ArcRifle = {
			Name = "Arc Rifle",
			Kind = "Gun",
			Text = "Mad Scientist's kit; rare drop otherwise. Arcs jump between enemies.",
			Gun = { Damage = 28, FireRate = 2, Range = 100, Magazine = 12, ReloadSeconds = 2.4, AmmoPerShot = 2, SpreadDegrees = 0.5, ChainTargets = 1 },
			UsesResource = "Ammo",
			HasRarity = true,
			ClassKit = true,
			Asset = "Weapon_ArcRifle",
		},

		-- Throwables
		FragGrenade = {
			Name = "Frag Grenade",
			Kind = "Throwable",
			Text = "Area damage.",
			Throwable = { Radius = 12, Damage = 90 },
			Asset = "Throwable_FragGrenade",
		},
		Flare = {
			Name = "Flare",
			Kind = "Throwable",
			Text = "Lights an area and reveals Prism Stalkers.",
			Throwable = { Radius = 40, LightSeconds = 20, RevealsHidden = true },
			Asset = "Throwable_Flare",
		},
		FoamGrenade = {
			Name = "Foam Grenade",
			Kind = "Throwable",
			Text = "Puts out fires.",
			Throwable = { Radius = 14, Extinguishes = true },
			Asset = "Throwable_FoamGrenade",
		},
		ShockMine = {
			Name = "Shock Mine",
			Kind = "Throwable",
			Text = "Stuns whatever steps on it.",
			Throwable = { Radius = 6, StunSeconds = 3, Trap = true },
			Asset = "Throwable_ShockMine",
		},

		-- Tools
		Drill = { Name = "Drill", Kind = "Tool", Text = "Digs rock.", HasRarity = true, Asset = "Tool_Drill" },
		Welder = { Name = "Welder", Kind = "Tool", Text = "Repairs rooms.", HasRarity = true, Asset = "Tool_Welder" },
		Extinguisher = { Name = "Extinguisher", Kind = "Tool", Text = "Puts out fires.", Asset = "Tool_Extinguisher" },
		GeigerCounter = { Name = "Geiger Counter", Kind = "Tool", Text = "Shows radiation and hazards nearby.", Asset = "Tool_GeigerCounter" },
		Grapple = { Name = "Grapple", Kind = "Tool", Text = "Spelunker's kit; zip lines.", ClassKit = true, Asset = "Tool_Grapple" },

		-- Consumables
		Medkit = {
			Name = "Medkit",
			Kind = "Consumable",
			Text = "Heals a player or revives a resident.",
			UsesResource = "Medkits",
			Asset = "Item_Medkit",
		},
		ClearRadPills = { Name = "Clear-Rad pills", Kind = "Consumable", Text = "Clear radiation.", Asset = "Item_ClearRadPills" },

		-- Placeables (crafted at the Workshop)
		Lamp = { Name = "Lamp", Kind = "Placeable", Text = "A placeable lamp for dark rooms and caves.", Asset = "Prop_Lamp" },
		Barricade = { Name = "Barricade", Kind = "Placeable", Text = "Seals a breach point, making it less likely to open again.", Asset = "Prop_Barricade" },
		Turret = { Name = "Turret", Kind = "Placeable", Text = "An auto-turret; the Engineer deploys one with Deploy Turret.", Asset = "Prop_Turret" },

		-- Resident outfits (+1 to +3 by rarity)
		WorkOveralls = { Name = "Work Overalls", Kind = "Outfit", Text = "Strength.", Outfit = { Stat = "Strength" } },
		LabCoat = { Name = "Lab Coat", Kind = "Outfit", Text = "Smarts.", Outfit = { Stat = "Smarts" } },
		SecurityVest = { Name = "Security Vest", Kind = "Outfit", Text = "Grit and health.", Outfit = { Stat = "Grit", Health = 20 } },
		TrackJacket = { Name = "Track Jacket", Kind = "Outfit", Text = "Speed.", Outfit = { Stat = "Speed" } },
		SundayBest = { Name = "Sunday Best", Kind = "Outfit", Text = "Charm.", Outfit = { Stat = "Charm" } },
		HazmatSuit = {
			Name = "Hazmat Suit",
			Kind = "Outfit",
			Text = "Grit; ignores gas. Part of the Hazmat Tech's kit.",
			Outfit = { Stat = "Grit", IgnoresGas = true },
		},

		-- Resident tools
		Stethoscope = { Name = "Stethoscope", Kind = "ResidentTool", Text = "Medbay.", ResidentUse = "Better Medbay output" },
		HandDrill = { Name = "Hand Drill", Kind = "ResidentTool", Text = "Digging.", ResidentUse = "Digs faster in the Drill Bay queue" },
		RadioHeadset = {
			Name = "Radio Headset",
			Kind = "ResidentTool",
			Text = "Recruiting. Part of the Radio Operator's kit.",
			ResidentUse = "Better recruiting in the Radio Room",
		},
		Ladle = { Name = "Ladle", Kind = "ResidentTool", Text = "Kitchen.", ResidentUse = "Better Kitchen output" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">Leaderboards</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Leaderboards on lobby billboards (bible Section 16), weekly and all-time.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Stat = Check.enum({ "DeepVictorySeconds", "EndlessYears", "ResidentsAtYear100" }),
		LowerIsBetter = F.Flag,
		Periods = Check.array(Check.enum({ "Weekly", "AllTime" }), 2),
	}),
	Order = { "FastestDeepVictory", "MostYearsEndless", "MostResidentsAtYear100" },
	Entries = {
		FastestDeepVictory = { Name = "Fastest Deep Victory", Stat = "DeepVictorySeconds", LowerIsBetter = true, Periods = { "Weekly", "AllTime" } },
		MostYearsEndless = { Name = "Most years in Endless", Stat = "EndlessYears", Periods = { "Weekly", "AllTime" } },
		MostResidentsAtYear100 = { Name = "Most residents alive at Year 100", Stat = "ResidentsAtYear100", Periods = { "Weekly", "AllTime" } },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Legends</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Legends: permanent legendary residents players collect and bring into runs (bible Section
	15). A Legend starts at level 5 with its signature trait, one good trait (rolled from
	Traits, Good) and signature gear; never ages; Renown 1 to 5 (Tuning.Legends). The first
	twelve of 24 are here; the rest arrive with Prompt 27. Each is one of a kind in looks too
	(Tiers.Legendary).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function mod(key: string, value: number, extra: { [string]: any }?): { [string]: any }
	local t: { [string]: any } = { Key = key, Value = value }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Signature = Check.shape({ Name = F.Name, Text = F.Text, Modifiers = Check.optional(F.Modifiers) }),
		Gear = Check.optional(F.ItemStacks),
		Get = Check.shape({
			Kind = Check.enum({ "Starter", "Badge", "Glowshards", "Event" }),
			Glowshards = F.Glowshards,
			Badge = Check.optional(Check.ref("Badges")),
		}),
		BestStat = Check.ref("Stats"),
	}),
	Order = {
		"RosieKowalski", "AbnerPrice", "EarlHutch", "MabelFitz", "JuneOkafor", "IngridVale",
		"LouMarchetti", "TexDelgado", "WrenHolloway", "OldManHiggins", "IvyAlvarez", "DutchVanDorn",
	},
	Entries = {
		RosieKowalski = {
			Name = "Rosie 'Rivets' Kowalski",
			Signature = { Name = "Rivet Queen", Text = "Slowly repairs every room on her floor.", Modifiers = { mod("RepairsRooms", 1, { Scope = "Floor" }) } },
			Gear = { { Item = "Wrench" }, { Item = "WorkOveralls" } },
			Get = { Kind = "Starter" },
			BestStat = "Strength",
		},
		AbnerPrice = {
			Name = "Doc Abner Price",
			Signature = { Name = "House Calls", Text = "Residents he treats heal twice as fast.", Modifiers = { mod("TreatedHealSpeed", 2) } },
			Gear = { { Item = "Stethoscope" }, { Item = "LabCoat" } },
			Get = { Kind = "Badge", Badge = "Rescue50" },
			BestStat = "Smarts",
		},
		EarlHutch = {
			Name = "Big Earl Hutch",
			Signature = { Name = "Doorman", Text = "The Blast Door takes 50% less damage while he guards it.", Modifiers = { mod("BlastDoorDamageTaken", 0.5) } },
			Gear = { { Item = "Sledgehammer" }, { Item = "SecurityVest" } },
			Get = { Kind = "Glowshards", Glowshards = 200 },
			BestStat = "Grit",
		},
		MabelFitz = {
			Name = "Mabel Fitz",
			Signature = { Name = "Sunday Pies", Text = "+10 morale for everyone after each Surge survived.", Modifiers = { mod("SurgeSurvivedMorale", 10) } },
			Gear = { { Item = "Ladle" }, { Item = "SundayBest" } },
			Get = { Kind = "Glowshards", Glowshards = 150 },
			BestStat = "Speed",
		},
		JuneOkafor = {
			Name = "Captain June Okafor",
			Signature = { Name = "Steady Orders", Text = "Armed residents deal +20% damage.", Modifiers = { mod("ArmedResidentDamage", 1.2) } },
			Gear = { { Item = "ServiceRevolver" }, { Item = "SecurityVest" } },
			Get = { Kind = "Badge", Badge = "CenturyVictory" },
			BestStat = "Grit",
		},
		IngridVale = {
			Name = "Professor Ingrid Vale",
			Signature = { Name = "Breakthrough", Text = "Lab research twice as fast.", Modifiers = { mod("ResearchSpeed", 2) } },
			Gear = { { Item = "LabCoat" } },
			Get = { Kind = "Glowshards", Glowshards = 300 },
			BestStat = "Smarts",
		},
		LouMarchetti = {
			Name = "Lucky Lou Marchetti",
			Signature = { Name = "Lucky Streak", Text = "Double loot from expeditions.", Modifiers = { mod("ExpeditionLoot", 2) } },
			Gear = { { Item = "TrackJacket" } },
			Get = { Kind = "Glowshards", Glowshards = 250 },
			BestStat = "Speed",
		},
		TexDelgado = {
			Name = "Tex Delgado",
			Signature = {
				Name = "Quick Draw",
				Text = "Fires twice as fast and defends any room he stands in.",
				Modifiers = { mod("FireRate", 2), mod("DefendsAnyRoom", 1) },
			},
			Gear = { { Item = "ServiceRevolver" } },
			Get = { Kind = "Glowshards", Glowshards = 300 },
			BestStat = "Grit",
		},
		WrenHolloway = {
			Name = "Wren Holloway",
			Signature = { Name = "Silver Tongue", Text = "Radio recruits arrive twice as often.", Modifiers = { mod("RecruitRate", 2) } },
			Gear = { { Item = "RadioHeadset" }, { Item = "SundayBest" } },
			Get = { Kind = "Badge", Badge = "LetIn10Wanderers" },
			BestStat = "Charm",
		},
		OldManHiggins = {
			Name = "Old Man Higgins",
			Signature = { Name = "Mentor", Text = "Residents in his room gain double experience.", Modifiers = { mod("ResidentXP", 2, { Scope = "Room" }) } },
			Get = { Kind = "Badge", Badge = "Year100With30" },
			BestStat = "Charm",
		},
		IvyAlvarez = {
			Name = "Ivy 'Torch' Alvarez",
			Signature = { Name = "Firewall", Text = "Fires can't spread out of the room she is in.", Modifiers = { mod("FireContained", 1) } },
			Gear = { { Item = "Extinguisher" }, { Item = "WorkOveralls" } },
			Get = { Kind = "Glowshards", Glowshards = 200 },
			BestStat = "Grit",
		},
		DutchVanDorn = {
			Name = "Dutch van Dorn",
			Signature = { Name = "Deep Nose", Text = "Every cell he digs holds at least an ore pocket.", Modifiers = { mod("OrePocketGuaranteed", 1) } },
			Gear = { { Item = "HandDrill" }, { Item = "WorkOveralls" } },
			Get = { Kind = "Badge", Badge = "Depth10" },
			BestStat = "Strength",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">LootTables</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LootTables: what containers, caches, nests, monsters, expeditions and crates give (bible
	Sections 6, 10, 12, 13, 17). Each roll picks one line by Weight and gives Min..Max of it.
	A line gives a Resource, an Item, or a Special: BandOre (the ore of the band it's in), Gear
	(a random weapon or outfit, rarity rolled), Blueprint (a draft card), RadioLog, Glowshards,
	Recruit. Every number is provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Line = Check.shape({
	Resource = Check.optional(Check.ref("Resources")),
	Item = Check.optional(Check.ref("Items")),
	Special = Check.optional(Check.enum({ "BandOre", "Gear", "Blueprint", "RadioLog", "Glowshards", "Recruit" })),
	Min = F.Count,
	Max = F.Count,
	Weight = F.NonNegative,
})

local function r(resource: string, min: number, max: number, weight: number)
	return { Resource = resource, Min = min, Max = max, Weight = weight }
end
local function i(item: string, min: number, max: number, weight: number)
	return { Item = item, Min = min, Max = max, Weight = weight }
end
local function s(special: string, min: number, max: number, weight: number)
	return { Special = special, Min = min, Max = max, Weight = weight }
end

return {
	Schema = Check.shape({
		Text = F.Short,
		Rolls = F.PositiveInt,
		Lines = Check.array(Line, 16),
	}),
	Entries = {
		-- Digging and the Deep
		OrePocket = { Text = "A dug cell with an ore pocket", Rolls = 1, Lines = { s("BandOre", 8, 15, 1) } },
		Cache = {
			Text = "A cache in a dug cell or a cave",
			Rolls = 2,
			Lines = { r("Scrap", 40, 90, 5), s("Gear", 1, 1, 2), s("RadioLog", 1, 1, 2), r("Ammo", 20, 40, 2), r("Medkits", 1, 2, 1) },
		},
		Nest = {
			Text = "A destroyed nest",
			Rolls = 2,
			Lines = { r("Scrap", 80, 150, 3), s("BandOre", 10, 20, 3) },
		},
		GlowshardChest = { Text = "A Glowshard chest in the Deep (rare)", Rolls = 1, Lines = { s("Glowshards", 1, 3, 1) } },

		-- Monster drops
		MinesMonster = { Text = "A Mines monster", Rolls = 1, Lines = { r("Scrap", 2, 6, 6), r("Iron", 1, 3, 3), r("Ammo", 2, 6, 1) } },
		FloodedMonster = { Text = "A Flooded Caverns monster", Rolls = 1, Lines = { r("Scrap", 3, 8, 6), r("Copper", 1, 3, 3), r("Ammo", 3, 8, 1) } },
		CrystalMonster = { Text = "A Crystal Hollows monster", Rolls = 1, Lines = { r("Scrap", 4, 10, 6), r("Crystal", 1, 2, 3), r("Ammo", 4, 10, 1) } },
		SurfaceMonster = { Text = "A surface creature", Rolls = 1, Lines = { r("Scrap", 2, 5, 6), r("Food", 1, 2, 2) } },
		Raider = { Text = "A beaten Ash Raider", Rolls = 1, Lines = { r("Scrap", 5, 12, 5), r("Ammo", 5, 15, 4), s("Gear", 1, 1, 1) } },

		-- Surface containers (refill every era)
		Diner = { Text = "Main Street diner", Rolls = 2, Lines = { r("Food", 3, 8, 6), r("Water", 2, 6, 4), r("Scrap", 5, 15, 2) } },
		HardwareStore = {
			Text = "Hardware store",
			Rolls = 2,
			Lines = { r("Scrap", 15, 40, 6), s("Gear", 1, 1, 2), i("Lamp", 1, 1, 1), s("Blueprint", 1, 1, 1) },
		},
		Grocery = { Text = "Grocery", Rolls = 2, Lines = { r("Food", 5, 12, 6), r("Water", 4, 10, 4) } },
		GasStation = { Text = "Gas station", Rolls = 2, Lines = { r("Scrap", 10, 25, 5), r("Water", 2, 6, 3), i("Flare", 1, 2, 2) } },
		Motel = { Text = "Motel", Rolls = 2, Lines = { r("Medkits", 1, 2, 3), r("Food", 2, 6, 3), s("RadioLog", 1, 1, 1), r("Scrap", 5, 15, 3) } },
		RadioTower = { Text = "Radio tower", Rolls = 2, Lines = { s("RadioLog", 1, 1, 3), r("Scrap", 10, 25, 4), s("Blueprint", 1, 1, 1) } },
		WaterTower = { Text = "Water tower", Rolls = 2, Lines = { r("Water", 8, 16, 7), r("Scrap", 5, 10, 2) } },
		RailYard = { Text = "Rail yard and wrecked train", Rolls = 3, Lines = { r("Scrap", 20, 50, 6), s("Gear", 1, 1, 2), r("Iron", 3, 8, 2) } },
		Showroom = {
			Text = "The ruined Steadfast showroom",
			Rolls = 3,
			Lines = { s("Blueprint", 1, 1, 3), s("RadioLog", 1, 1, 3), s("Gear", 1, 1, 2), r("Scrap", 15, 35, 3) },
		},
		Checkpoint = {
			Text = "Military checkpoint (Era III)",
			Rolls = 3,
			Lines = { r("Ammo", 30, 70, 5), s("Gear", 1, 1, 4), r("Medkits", 2, 4, 3), i("FragGrenade", 1, 2, 2) },
		},

		-- Expeditions (per cycle away)
		ExpeditionSurface = {
			Text = "A resident expedition to the surface, per cycle",
			Rolls = 2,
			Lines = { r("Scrap", 20, 50, 6), r("Food", 3, 8, 3), r("Water", 3, 8, 3), s("Gear", 1, 1, 1), s("Blueprint", 1, 1, 1), s("Recruit", 1, 1, 1) },
		},
		ExpeditionDeep = {
			Text = "A resident expedition into the Deep, per cycle",
			Rolls = 2,
			Lines = { r("Scrap", 15, 40, 4), s("BandOre", 5, 12, 5), s("Gear", 1, 1, 1), s("Recruit", 1, 1, 1) },
		},

		-- Crates
		SupplyDrop = {
			Text = "Supply Drop team boost: Food, Water, Ammo and Medkits at the Blast Door",
			Rolls = 4,
			Lines = { r("Food", 20, 20, 1), r("Water", 20, 20, 1), r("Ammo", 100, 100, 1), r("Medkits", 3, 3, 1) },
		},
		SupplyCall = {
			Text = "The Radio Operator's Supply Call crate",
			Rolls = 3,
			Lines = { r("Food", 10, 15, 2), r("Water", 10, 15, 2), r("Ammo", 50, 80, 2), r("Medkits", 2, 3, 1), r("Scrap", 60, 100, 2) },
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">Modifiers</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Modifiers: the vocabulary of effects. Classes, traits, Legends, draft cards and passes
	describe what they do as a list of { Key, Value, Scope?, Room? }; the system that owns a
	key applies it. Prompt says which build prompt (bible Section 24) implements the key, so
	every effect in the data has a home.

	Unit: Multiplier (x Value), Add (+ Value), Set (becomes Value), Flag (1 = on),
	Chance (0 to 1). Scope (default here, can be overridden): Self (the holder), Presence
	(while the holder is in the room), Room (everyone in the holder's room), Nearby (around
	the holder), Floor, Team (all players), Bunker (the whole run).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function m(unit: string, scope: string, prompt: number, text: string)
	return { Unit = unit, Scope = scope, Prompt = prompt, Text = text }
end

return {
	Schema = Check.shape({
		Unit = Check.enum({ "Multiplier", "Add", "Set", "Flag", "Chance" }),
		Scope = F.Scope,
		Prompt = Check.integer(0, 40),
		Text = F.Short,
	}),
	Entries = {
		-- Player combat and survival (Prompts 11, 20)
		MaxHealth = m("Add", "Self", 11, "Max health"),
		MaxHealthMult = m("Multiplier", "Self", 11, "Max health"),
		StaminaMult = m("Multiplier", "Team", 11, "Max stamina"),
		SurfaceMoveSpeed = m("Multiplier", "Self", 16, "Move speed on the surface"),
		ReviveSeconds = m("Set", "Self", 11, "Seconds to revive a downed player"),
		TouchHeal = m("Flag", "Self", 20, "Heals residents by touch"),
		FireFloodDamageTaken = m("Multiplier", "Self", 13, "Damage taken from fire and floods"),
		NearbyResidentDamage = m("Multiplier", "Nearby", 20, "Damage dealt by residents near the holder"),
		ArmedResidentDamage = m("Multiplier", "Bunker", 20, "Damage dealt by armed residents"),
		CreatureDamage = m("Multiplier", "Self", 11, "Damage to monsters"),
		GunDamage = m("Multiplier", "Self", 11, "Gun damage"),
		FireRate = m("Multiplier", "Self", 11, "Gun fire rate"),
		WeakPointMultiplier = m("Set", "Self", 20, "Damage multiplier on weak-point hits"),
		AimZoom = m("Multiplier", "Self", 20, "Aim zoom"),
		CritsStaggerBosses = m("Flag", "Self", 20, "Critical hits stagger bosses"),
		BurnSpreadsBetweenMonsters = m("Flag", "Self", 20, "Burning spreads between monsters, never to rooms"),
		FuelUse = m("Multiplier", "Self", 20, "Flamethrower fuel use"),
		ExplosiveDamage = m("Multiplier", "Self", 20, "Explosive damage"),
		ExplosiveRadius = m("Multiplier", "Self", 20, "Explosive radius"),
		ExtraFragGrenades = m("Add", "Self", 20, "Extra Frag Grenades in the loadout"),
		ExplosionsStunBosses = m("Flag", "Self", 20, "Explosions stun bosses"),
		ArcChainTargets = m("Set", "Self", 20, "Enemies the Arc Rifle chains to"),
		DroneGuns = m("Set", "Self", 20, "Guns on the combat drone"),
		DroneRevivesPerSurge = m("Add", "Self", 20, "Times per Surge the drone revives its owner"),
		TurretDuration = m("Multiplier", "Self", 20, "How long turrets last"),
		TurretShock = m("Flag", "Self", 20, "Turrets shock"),
		BarricadeCost = m("Multiplier", "Self", 20, "Barricade cost"),
		TriagePulseClears = m("Flag", "Self", 20, "Triage Pulse also clears conditions"),
		InstantRally = m("Flag", "Self", 20, "Armed residents answer the holder's rally at once"),
		DefendsAnyRoom = m("Flag", "Self", 27, "Defends whatever room they stand in"),
		LightRadius = m("Multiplier", "Self", 17, "Light radius"),
		NoFallDamage = m("Flag", "Self", 17, "No fall damage"),
		RadiationGain = m("Multiplier", "Self", 16, "How fast radiation builds"),
		GasImmune = m("Flag", "Self", 23, "Immune to gas"),
		GasDamageTaken = m("Multiplier", "Self", 23, "Damage taken from gas"),
		StormWarningSeconds = m("Add", "Self", 16, "Seconds of extra warning before the storm siren"),
		KillsLowerDisturbance = m("Flag", "Self", 20, "Kills lower Disturbance"),
		MedkitsPerPlayer = m("Add", "Team", 19, "Medkits given to every player now"),
		WeaponRarityUp = m("Add", "Team", 19, "Every player's weapons go up this many rarities now"),

		-- Loot and backpack (Prompts 16, 20)
		BackpackSlots = m("Add", "Self", 16, "Backpack slots"),
		LootOutline = m("Flag", "Self", 16, "Loot is outlined"),
		ExtraLootRolls = m("Add", "Self", 16, "Extra loot rolls on containers"),
		RareGearOdds = m("Multiplier", "Self", 16, "Odds of rare gear"),
		KeepBackpackWhenDowned = m("Flag", "Self", 16, "Keeps the backpack when downed"),

		-- Building, rooms and economy (Prompts 8, 9)
		RoomOutput = m("Multiplier", "Bunker", 9, "Output of one room type (set Room)"),
		AllOutput = m("Multiplier", "Self", 9, "Output in any job"),
		DoubleOutputChance = m("Chance", "Self", 26, "Chance each cycle of double output"),
		StockpileCaps = m("Multiplier", "Bunker", 9, "Every stockpile cap"),
		BuildCost = m("Multiplier", "Bunker", 8, "Build and upgrade costs"),
		BuildSpeed = m("Multiplier", "Bunker", 8, "Construction speed"),
		RepairSpeed = m("Multiplier", "Self", 13, "Repair speed"),
		RepairsRooms = m("Flag", "Room", 26, "Slowly repairs rooms in scope"),
		FoodUse = m("Multiplier", "Self", 9, "Food eaten each cycle"),
		MealsHeal = m("Flag", "Self", 20, "Hearty Meal also heals"),
		RoomHP = m("Multiplier", "Bunker", 13, "Room HP"),
		BlastDoorHealth = m("Multiplier", "Bunker", 13, "Blast Door health"),
		BlastDoorDamageTaken = m("Multiplier", "Self", 27, "Damage the Blast Door takes while the holder guards it"),
		BlastDoorLevel = m("Add", "Bunker", 19, "Blast Door levels"),
		ReactorOverloadChance = m("Chance", "Bunker", 19, "Chance per Surge of a Reactor overload"),
		ResearchSpeed = m("Multiplier", "Self", 26, "Lab research speed"),
		CraftSpeed = m("Multiplier", "Self", 30, "Workshop crafting speed"),
		AmmoCraftCost = m("Multiplier", "Bunker", 30, "Cost of crafting ammo"),
		ScrapPerCycle = m("Add", "Self", 26, "Scrap found each cycle"),
		TraderPrices = m("Multiplier", "Bunker", 30, "Trader prices"),
		TraderNow = m("Flag", "Bunker", 30, "The trader arrives now"),
		TraderRareStock = m("Flag", "Bunker", 30, "The trader brings rare stock"),
		BreaksVoteTies = m("Flag", "Self", 8, "Breaks tied votes"),
		FreeDraftRerollsPerEra = m("Add", "Self", 19, "Free blueprint rerolls per era"),

		-- Disasters (Prompts 13, 23, 24)
		FireSpread = m("Multiplier", "Bunker", 13, "How fast fire spreads"),
		ExtinguishSpeed = m("Multiplier", "Self", 13, "How fast fires are put out"),
		FireContained = m("Flag", "Room", 27, "Fires can't spread out of the holder's room"),
		RubbleClearInstant = m("Flag", "Self", 20, "The Fire Axe clears rubble instantly"),
		FloodDrainSpeed = m("Multiplier", "Bunker", 23, "How fast floods drain"),
		BlackoutDuration = m("Multiplier", "Bunker", 13, "How long blackouts last"),
		GasStrength = m("Multiplier", "Bunker", 23, "Gas leak strength"),
		OutbreakCureSpeed = m("Multiplier", "Self", 24, "How fast outbreaks are cured"),
		DarkSpawnBonus = m("Multiplier", "Bunker", 12, "Extra monster spawns in dark rooms"),
		AccidentChance = m("Chance", "Self", 26, "Chance each cycle of a minor fire or flood in their room"),

		-- Digging (Prompt 14)
		DigSpeed = m("Multiplier", "Self", 14, "Digging speed"),
		DigDisturbance = m("Multiplier", "Self", 14, "Disturbance added by digging"),
		OreSightCells = m("Set", "Self", 14, "Cells into the rock where ore and caves show"),
		DugOre = m("Multiplier", "Self", 14, "Ore from dug cells"),
		OrePocketGuaranteed = m("Flag", "Self", 27, "Every cell dug holds at least an ore pocket"),

		-- Exploration, recruits and expeditions (Prompts 16, 17, 18)
		RevealCaveLayouts = m("Flag", "Self", 17, "Reveals cave layouts"),
		FindChance = m("Multiplier", "Self", 17, "Chance of finding cryo pods and caches"),
		RescuedFollowSpeed = m("Multiplier", "Self", 16, "Speed of rescued people following the holder"),
		RescuedDamageTaken = m("Multiplier", "Self", 16, "Damage rescued people take while following"),
		ExpeditionLoot = m("Multiplier", "Self", 18, "Expedition loot"),
		ExpeditionScrap = m("Multiplier", "Self", 18, "Scrap from expeditions"),
		ExpeditionCarry = m("Multiplier", "Self", 18, "How much they carry on expeditions"),
		NextTripLoot = m("Multiplier", "Team", 19, "Loot on the next surface trip"),
		NextStormEarlySeconds = m("Add", "Bunker", 19, "The next storm hits this many seconds early"),
		RecruitRate = m("Multiplier", "Bunker", 18, "How often radio recruits arrive"),
		RareRecruitChance = m("Multiplier", "Bunker", 18, "Odds a recruit is Rare"),
		DistressCallLeadSeconds = m("Add", "Bunker", 18, "Distress calls arrive this many seconds sooner"),
		SupplyCallsPerEra = m("Set", "Self", 20, "Supply Calls per era"),
		RecruitsNow = m("Add", "Bunker", 19, "Recruits who arrive now"),
		RareRecruitNow = m("Add", "Bunker", 19, "Rare residents who join now"),
		BountyKills = m("Set", "Team", 19, "Monsters to kill before the next Surge"),
		BountyScrap = m("Set", "Team", 19, "Scrap paid when the bounty is met"),

		-- Residents (Prompts 10, 26, 36)
		ResidentXP = m("Multiplier", "Self", 10, "Resident experience"),
		ChoosesLevelStat = m("Flag", "Self", 20, "Chooses the stat residents raise when they level"),
		ResidentLevels = m("Add", "Bunker", 19, "Levels every resident gains now"),
		MoraleNow = m("Add", "Bunker", 19, "Morale every resident gains now"),
		SurgeSurvivedMorale = m("Add", "Bunker", 27, "Morale for everyone after each Surge survived"),
		RoommateMorale = m("Add", "Room", 26, "Roommates' morale each cycle"),
		TreatedHealSpeed = m("Multiplier", "Self", 27, "Healing speed of residents the holder treats"),
		NeverPanics = m("Flag", "Self", 26, "Never panics"),
		DefendsUnarmed = m("Flag", "Self", 26, "Defends their room even without a weapon"),
		CalmsRoommates = m("Flag", "Room", 26, "Calms panicked roommates"),
		PanicChance = m("Multiplier", "Self", 26, "Chance to panic"),
		FleesBreaches = m("Flag", "Self", 26, "Flees breaches"),
		RunsIntoHazards = m("Flag", "Self", 26, "May run into hazards when panicked"),
		RestNeed = m("Multiplier", "Self", 10, "Rest needed"),
		NoDarkPenalty = m("Flag", "Self", 26, "No penalty in dark rooms"),
		Claustrophobic = m("Flag", "Self", 26, "Morale drops at depth 4 and below"),
		AfraidOfDark = m("Flag", "Self", 26, "Morale crashes in dark rooms and refuses to work there"),
		Hothead = m("Flag", "Self", 36, "Starts fights with rivals"),
		Homesick = m("Flag", "Self", 26, "Morale slowly drains unless they spend time in the Lounge"),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">Monsters</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Monsters: the creatures (bible Section 10 and the Appendix; bosses are Config.Bosses).
	Monsters go for residents first, then machines, then players who hit them; Targets is each
	type's own order. ThreatCost is what the Threat Director pays to spawn one. Every number is
	provisional, for Prompts 12, 16, 17, 23 and 24.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Target = Check.enum({ "Residents", "Machines", "Players", "BlastDoor" })

return {
	Schema = Check.shape({
		Name = F.Name,
		Where = Check.array(Check.enum({ "Mines", "FloodedCaverns", "CrystalHollows", "Surface" }), 4),
		Role = Check.enum({ "Swarmer", "Runner", "Brute", "Ranged", "Exploder", "Ambusher", "Tank", "Support", "Fighter", "PackRunner", "Stalker" }),
		Text = F.Short,
		Health = F.PositiveInt,
		Damage = F.NonNegative,
		AttackSeconds = F.Seconds,
		Range = F.NonNegative,
		MoveSpeed = F.NonNegative,
		Targets = Check.array(Target, 4),
		ThreatCost = F.PositiveInt,
		Group = Check.shape({ Min = F.PositiveInt, Max = F.PositiveInt }),
		Traits = Check.optional(Check.array(Check.enum({
			"Latches", "Slows", "Explodes", "Floods", "Hides", "Grabs", "ArmoredFront", "WeakPointBack",
			"Shatters", "Invisible", "ShrugsSmallGuns", "Heals", "Hastes", "Fades", "StormOnly", "Radiates", "SmashesMachines",
		}), 6)),
		Drops = Check.optional(Check.ref("LootTables")),
		Era = Check.integer(1, 4),
		Asset = F.Asset,
	}),
	Entries = {
		BurrowTick = {
			Name = "Burrow Tick",
			Where = { "Mines" },
			Role = "Swarmer",
			Text = "Fast and weak, comes in packs, latches onto residents.",
			Health = 20, Damage = 4, AttackSeconds = 0.6, Range = 3, MoveSpeed = 20,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 1, Group = { Min = 4, Max = 8 },
			Traits = { "Latches" },
			Drops = "MinesMonster", Era = 1, Asset = "Monster_BurrowTick",
		},
		TunnelHound = {
			Name = "Tunnel Hound",
			Where = { "Mines" },
			Role = "Runner",
			Text = "Sprints past defenders to reach residents.",
			Health = 60, Damage = 10, AttackSeconds = 0.9, Range = 4, MoveSpeed = 26,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 3, Group = { Min = 1, Max = 3 },
			Drops = "MinesMonster", Era = 1, Asset = "Monster_TunnelHound",
		},
		HollowMiner = {
			Name = "Hollow Miner",
			Where = { "Mines" },
			Role = "Brute",
			Text = "Slow and tough; smashes machines and doors.",
			Health = 320, Damage = 30, AttackSeconds = 1.47, Range = 6, MoveSpeed = 9,
			Targets = { "Machines", "Residents", "Players" },
			ThreatCost = 8, Group = { Min = 1, Max = 1 },
			Traits = { "SmashesMachines" },
			Drops = "MinesMonster", Era = 1, Asset = "Monster_HollowMiner",
		},
		SpitterGrub = {
			Name = "Spitter Grub",
			Where = { "Mines" },
			Role = "Ranged",
			Text = "Spits glowing goo that slows from range.",
			Health = 70, Damage = 8, AttackSeconds = 1.6, Range = 45, MoveSpeed = 8,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 4, Group = { Min = 1, Max = 2 },
			Traits = { "Slows" },
			Drops = "MinesMonster", Era = 1, Asset = "Monster_SpitterGrub",
		},
		Murkling = {
			Name = "Murkling",
			Where = { "FloodedCaverns" },
			Role = "Swarmer",
			Text = "Pours out of water; weak alone.",
			Health = 30, Damage = 6, AttackSeconds = 0.7, Range = 3, MoveSpeed = 18,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 1, Group = { Min = 5, Max = 10 },
			Drops = "FloodedMonster", Era = 2, Asset = "Monster_Murkling",
		},
		BloatToad = {
			Name = "Bloat Toad",
			Where = { "FloodedCaverns" },
			Role = "Exploder",
			Text = "Bursts on death or contact and floods the room.",
			Health = 90, Damage = 40, AttackSeconds = 0, Range = 5, MoveSpeed = 12,
			Targets = { "Machines", "Residents", "Players" },
			ThreatCost = 5, Group = { Min = 1, Max = 2 },
			Traits = { "Explodes", "Floods" },
			Drops = "FloodedMonster", Era = 2, Asset = "Monster_BloatToad",
		},
		Lurker = {
			Name = "Lurker",
			Where = { "FloodedCaverns" },
			Role = "Ambusher",
			Text = "Hides in water or dark rooms and grabs residents.",
			Health = 180, Damage = 18, AttackSeconds = 1.2, Range = 7, MoveSpeed = 16,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 7, Group = { Min = 1, Max = 1 },
			Traits = { "Hides", "Grabs" },
			Drops = "FloodedMonster", Era = 2, Asset = "Monster_Lurker",
		},
		TideCrab = {
			Name = "Tide Crab",
			Where = { "FloodedCaverns" },
			Role = "Tank",
			Text = "Armoured front, weak point on its back.",
			Health = 420, Damage = 24, AttackSeconds = 1.4, Range = 6, MoveSpeed = 8,
			Targets = { "Machines", "Players", "Residents" },
			ThreatCost = 9, Group = { Min = 1, Max = 1 },
			Traits = { "ArmoredFront", "WeakPointBack" },
			Drops = "FloodedMonster", Era = 2, Asset = "Monster_TideCrab",
		},
		Shardling = {
			Name = "Shardling",
			Where = { "CrystalHollows" },
			Role = "Swarmer",
			Text = "Crystal bugs that shatter into stinging shards.",
			Health = 40, Damage = 8, AttackSeconds = 0.7, Range = 3, MoveSpeed = 20,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 2, Group = { Min = 5, Max = 9 },
			Traits = { "Shatters" },
			Drops = "CrystalMonster", Era = 3, Asset = "Monster_Shardling",
		},
		PrismStalker = {
			Name = "Prism Stalker",
			Where = { "CrystalHollows" },
			Role = "Ambusher",
			Text = "Invisible until lit by a flare or lamp.",
			Health = 220, Damage = 26, AttackSeconds = 1, Range = 5, MoveSpeed = 22,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 9, Group = { Min = 1, Max = 2 },
			Traits = { "Invisible" },
			Drops = "CrystalMonster", Era = 3, Asset = "Monster_PrismStalker",
		},
		GeodeGolem = {
			Name = "Geode Golem",
			Where = { "CrystalHollows" },
			Role = "Tank",
			Text = "Very slow with huge health; shrugs off small guns.",
			Health = 900, Damage = 45, AttackSeconds = 2, Range = 7, MoveSpeed = 6,
			Targets = { "Machines", "Players", "Residents" },
			ThreatCost = 14, Group = { Min = 1, Max = 1 },
			Traits = { "ShrugsSmallGuns", "SmashesMachines" },
			Drops = "CrystalMonster", Era = 3, Asset = "Monster_GeodeGolem",
		},
		Resonator = {
			Name = "Resonator",
			Where = { "CrystalHollows" },
			Role = "Support",
			Text = "Hums to heal and speed up nearby monsters; kill it first.",
			Health = 150, Damage = 0, AttackSeconds = 1, Range = 30, MoveSpeed = 10,
			Targets = { "Players", "Residents", "Machines" },
			ThreatCost = 8, Group = { Min = 1, Max = 1 },
			Traits = { "Heals", "Hastes" },
			Drops = "CrystalMonster", Era = 3, Asset = "Monster_Resonator",
		},
		AshRaider = {
			Name = "Ash Raider",
			Where = { "Surface" },
			Role = "Fighter",
			Text = "Melee or rifles; collapses and fades when beaten. Raids the Blast Door from Era II.",
			Health = 120, Damage = 14, AttackSeconds = 1, Range = 60, MoveSpeed = 16,
			Targets = { "BlastDoor", "Residents", "Players", "Machines" },
			ThreatCost = 5, Group = { Min = 2, Max = 5 },
			Traits = { "Fades" },
			Drops = "Raider", Era = 2, Asset = "Monster_AshRaider",
		},
		AshJackal = {
			Name = "Ash Jackal",
			Where = { "Surface" },
			Role = "PackRunner",
			Text = "Mutated animals that circle and dart in.",
			Health = 50, Damage = 9, AttackSeconds = 0.8, Range = 4, MoveSpeed = 24,
			Targets = { "Players", "Residents", "Machines" },
			ThreatCost = 2, Group = { Min = 3, Max = 6 },
			Drops = "SurfaceMonster", Era = 1, Asset = "Monster_AshJackal",
		},
		AshWraith = {
			Name = "Ash Wraith",
			Where = { "Surface" },
			Role = "Stalker",
			Text = "Appears only in storms; each hit adds radiation.",
			Health = 160, Damage = 12, AttackSeconds = 1.1, Range = 6, MoveSpeed = 18,
			Targets = { "Players", "Residents", "Machines" },
			ThreatCost = 7, Group = { Min = 1, Max = 2 },
			Traits = { "StormOnly", "Radiates" },
			Drops = "SurfaceMonster", Era = 1, Asset = "Monster_AshWraith",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">MoraleStates</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MoraleStates: what a resident's morale (0 to 100, starting at 60) does (bible Section 11).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		From = Check.integer(0, 100),
		To = Check.integer(0, 100),
		OutputMultiplier = F.NonNegative,
		Text = F.Short,
	}),
	Order = { "Miserable", "Unhappy", "Settled", "Happy", "Inspired" },
	Entries = {
		Miserable = { Name = "Miserable", From = 0, To = 19, OutputMultiplier = 0.85, Text = "May refuse work, start fights or leave the bunker for good" },
		Unhappy = { Name = "Unhappy", From = 20, To = 39, OutputMultiplier = 0.85, Text = "-15% output" },
		Settled = { Name = "Settled", From = 40, To = 74, OutputMultiplier = 1, Text = "Normal" },
		Happy = { Name = "Happy", From = 75, To = 89, OutputMultiplier = 1.1, Text = "+10% output" },
		Inspired = { Name = "Inspired", From = 90, To = 100, OutputMultiplier = 1.2, Text = "+20% output" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001B"><Properties><string name="Name">Objectives</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Objectives: what makes more years pass per cycle (bible Sections 5 and 12). Each Lost Crew
	rescued adds 2 to Years per Cycle and brings 3 residents, one of them Rare; each era boss
	beaten adds 1 (the cap is in Tuning.Clock).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "LostCrew", "Boss" }),
		Where = Check.enum({ "Surface", "Mines", "FloodedCaverns", "CrystalHollows", "Era" }),
		Guard = Check.optional(F.Short),
		Boss = Check.optional(Check.ref("Bosses")),
		YearsPerCycle = F.Count,
		Residents = F.Count,
		RareResidents = F.Count,
		Text = F.Text,
	}),
	Order = { "CrewSurface", "CrewMines", "CrewFlooded", "CrewCrystal", "BossBroodMother", "BossDeluge", "BossColossus" },
	Entries = {
		CrewSurface = {
			Name = "Lost Crew: the surface",
			Kind = "LostCrew",
			Where = "Surface",
			Guard = "A raider camp",
			YearsPerCycle = 2, Residents = 3, RareResidents = 1,
			Text = "A trapped Steadfast work crew in Brightwater Ruins. Free them and escort them home.",
		},
		CrewMines = {
			Name = "Lost Crew: the Mines",
			Kind = "LostCrew",
			Where = "Mines",
			Guard = "A nest or a mini-boss",
			YearsPerCycle = 2, Residents = 3, RareResidents = 1,
			Text = "A trapped Steadfast work crew somewhere in the Mines.",
		},
		CrewFlooded = {
			Name = "Lost Crew: the Flooded Caverns",
			Kind = "LostCrew",
			Where = "FloodedCaverns",
			Guard = "A nest or a mini-boss",
			YearsPerCycle = 2, Residents = 3, RareResidents = 1,
			Text = "A trapped Steadfast work crew somewhere in the Flooded Caverns.",
		},
		CrewCrystal = {
			Name = "Lost Crew: the Crystal Hollows",
			Kind = "LostCrew",
			Where = "CrystalHollows",
			Guard = "A nest or a mini-boss",
			YearsPerCycle = 2, Residents = 3, RareResidents = 1,
			Text = "A trapped Steadfast work crew somewhere in the Crystal Hollows.",
		},
		BossBroodMother = { Name = "Beat the Brood Mother", Kind = "Boss", Where = "Era", Boss = "BroodMother", YearsPerCycle = 1, Residents = 0, RareResidents = 0, Text = "Year 25." },
		BossDeluge = { Name = "Beat The Deluge", Kind = "Boss", Where = "Era", Boss = "Deluge", YearsPerCycle = 1, Residents = 0, RareResidents = 0, Text = "Year 50." },
		BossColossus = { Name = "Beat the Crystal Colossus", Kind = "Boss", Where = "Era", Boss = "CrystalColossus", YearsPerCycle = 1, Residents = 0, RareResidents = 0, Text = "Year 75." },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001C"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Quests (bible Section 16): 3 daily (3 to 5 Glowshards each) and 3 weekly (15 each) are drawn
	from these; both reset at 00:00 UTC. Goal.Event names the run event that counts toward it
	(Prompt 29 wires them); Class narrows it to playing one class.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function q(period: string, text: string, event: string, count: number, reward: number, class: string?): { [string]: any }
	return { Period = period, Text = text, Goal = { Event = event, Count = count, Class = class }, Glowshards = reward }
end

return {
	Schema = Check.shape({
		Period = Check.enum({ "Daily", "Weekly" }),
		Text = F.Short,
		Goal = Check.shape({
			Event = Check.enum({ "RescueSurvivor", "PassVote", "DigCell", "SurviveSurge", "DefeatMonster", "BuildRoom", "FinishExpedition", "ReachYear", "BeatBoss", "FreeLostCrew" }),
			Count = F.PositiveInt,
			Class = Check.optional(Check.ref("Classes")),
		}),
		Glowshards = Check.integer(3, 15),
	}),
	Entries = {
		Rescue2 = q("Daily", "Rescue 2 survivors", "RescueSurvivor", 2, 4),
		PassVotes3 = q("Daily", "Pass 3 votes", "PassVote", 3, 3),
		Dig15 = q("Daily", "Dig 15 cells", "DigCell", 15, 4),
		SurgesAsMedic = q("Daily", "Survive 3 Surges as a Medic", "SurviveSurge", 3, 5, "Medic"),
		Defeat50 = q("Daily", "Defeat 50 monsters", "DefeatMonster", 50, 4),
		Build5 = q("Daily", "Build 5 rooms", "BuildRoom", 5, 3),
		Expeditions2 = q("Daily", "Finish 2 resident expeditions", "FinishExpedition", 2, 4),
		Year25 = q("Daily", "Reach Year 25", "ReachYear", 25, 5),
		Rescue10 = q("Weekly", "Rescue 10 survivors", "RescueSurvivor", 10, 15),
		Dig100 = q("Weekly", "Dig 100 cells", "DigCell", 100, 15),
		BeatBoss = q("Weekly", "Beat an era boss", "BeatBoss", 1, 15),
		Surges20 = q("Weekly", "Survive 20 Surges", "SurviveSurge", 20, 15),
		FreeCrews = q("Weekly", "Free 2 Lost Crews", "FreeLostCrew", 2, 15),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">Recipes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Recipes: Workshop crafting (bible Section 13): weapon upgrades one rarity at a time (Scrap
	and ore), ammo (Scrap), throwables, tools, and the Engineer's turrets, barricades and traps.
	Residents working in the Workshop speed crafting and cut costs. Costs are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "Upgrade", "Ammo", "Throwable", "Tool", "Placeable", "Consumable" }),
		Costs = F.Costs,
		Seconds = F.Seconds,
		Gives = Check.optional(F.ItemStack),
		GivesResource = Check.optional(Check.shape({ Resource = Check.ref("Resources"), Count = F.PositiveInt })),
		ToRarity = Check.optional(Check.ref("ItemRarities")),
		EngineerOnly = F.Flag,
	}),
	Order = {
		"UpgradeStandard", "UpgradeReinforced", "UpgradePrototype", "UpgradeLegendary", "Ammo",
		"FragGrenade", "Flare", "FoamGrenade", "ShockMine", "Drill", "Welder", "Lamp", "Medkit",
		"Barricade", "Turret", "Trap",
	},
	Entries = {
		UpgradeStandard = { Name = "Upgrade to Standard", Kind = "Upgrade", ToRarity = "Standard", Costs = { Scrap = 60 }, Seconds = 15 },
		UpgradeReinforced = { Name = "Upgrade to Reinforced", Kind = "Upgrade", ToRarity = "Reinforced", Costs = { Scrap = 150, Iron = 15 }, Seconds = 25 },
		UpgradePrototype = { Name = "Upgrade to Prototype", Kind = "Upgrade", ToRarity = "Prototype", Costs = { Scrap = 300, Copper = 20 }, Seconds = 40 },
		UpgradeLegendary = { Name = "Upgrade to Legendary", Kind = "Upgrade", ToRarity = "Legendary", Costs = { Scrap = 500, Crystal = 20 }, Seconds = 60 },
		Ammo = { Name = "Ammo", Kind = "Ammo", Costs = { Scrap = 20 }, Seconds = 5, GivesResource = { Resource = "Ammo", Count = 30 } },
		FragGrenade = { Name = "Frag Grenade", Kind = "Throwable", Costs = { Scrap = 40, Iron = 2 }, Seconds = 8, Gives = { Item = "FragGrenade", Count = 1 } },
		Flare = { Name = "Flare", Kind = "Throwable", Costs = { Scrap = 15 }, Seconds = 4, Gives = { Item = "Flare", Count = 2 } },
		FoamGrenade = { Name = "Foam Grenade", Kind = "Throwable", Costs = { Scrap = 30 }, Seconds = 6, Gives = { Item = "FoamGrenade", Count = 1 } },
		ShockMine = { Name = "Shock Mine", Kind = "Throwable", Costs = { Scrap = 45, Copper = 2 }, Seconds = 8, Gives = { Item = "ShockMine", Count = 1 } },
		Drill = { Name = "Drill", Kind = "Tool", Costs = { Scrap = 120, Iron = 10 }, Seconds = 20, Gives = { Item = "Drill", Count = 1 } },
		Welder = { Name = "Welder", Kind = "Tool", Costs = { Scrap = 100, Iron = 8 }, Seconds = 20, Gives = { Item = "Welder", Count = 1 } },
		Lamp = { Name = "Lamp", Kind = "Placeable", Costs = { Scrap = 25 }, Seconds = 6, Gives = { Item = "Lamp", Count = 1 } },
		Medkit = { Name = "Medkit", Kind = "Consumable", Costs = { Scrap = 50 }, Seconds = 10, GivesResource = { Resource = "Medkits", Count = 1 } },
		Barricade = { Name = "Barricade", Kind = "Placeable", Costs = { Scrap = 80, Iron = 5 }, Seconds = 10, Gives = { Item = "Barricade", Count = 1 }, EngineerOnly = true },
		Turret = { Name = "Turret", Kind = "Placeable", Costs = { Scrap = 200, Iron = 15 }, Seconds = 30, Gives = { Item = "Turret", Count = 1 }, EngineerOnly = true },
		Trap = { Name = "Shock Trap", Kind = "Placeable", Costs = { Scrap = 60, Copper = 3 }, Seconds = 10, Gives = { Item = "ShockMine", Count = 2 }, EngineerOnly = true },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">ResidentNames</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ResidentNames: name pools for residents (bible Section 11: named people). Brightwater is an
	original 1950s American small town, so the names are period ones from many backgrounds.
	Nicknames are for Rare and Legendary residents ("Rosie 'Rivets' Kowalski"). A name is
	First + Last, never repeated within a run while the pool lasts.
]]

local Check = require(script.Parent.Parent.Utilities.Check)

local Names = Check.array(Check.string(24, { min = 2, pattern = "^[%a][%a' %-%.]*$" }), 300)

return {
	Schema = Check.shape({ Names = Names }),
	Order = { "First", "Last", "Nickname" },
	Entries = {
		First = {
			Names = {
				"Abe", "Ada", "Agnes", "Al", "Alice", "Alma", "Amos", "Angelo", "Annie", "Archie", "Arlene", "Arthur",
				"Audrey", "Bea", "Benny", "Bernice", "Bert", "Betty", "Bill", "Billie", "Bobbie", "Bud", "Buster",
				"Carl", "Carmen", "Cecil", "Charlotte", "Chester", "Clara", "Clarence", "Cliff", "Connie", "Cora",
				"Dale", "Dolores", "Donna", "Dot", "Doug", "Earl", "Edith", "Eddie", "Edna", "Elena", "Eli", "Ella",
				"Elmer", "Elsie", "Ernie", "Esther", "Ethel", "Eugene", "Faye", "Frank", "Freddie", "Gene", "Georgia",
				"Gertie", "Gil", "Gloria", "Gus", "Hank", "Harold", "Harriet", "Hazel", "Helen", "Herb", "Hiro",
				"Homer", "Howard", "Ida", "Irene", "Irving", "Jack", "Jean", "Jimmy", "Joan", "Joe", "Josie", "June",
				"Kay", "Kenji", "Lena", "Leon", "Leroy", "Lillian", "Lou", "Louise", "Luis", "Mabel", "Mae", "Marge",
				"Marvin", "Maxine", "Mel", "Mickey", "Mildred", "Milt", "Minnie", "Nadine", "Nell", "Norma", "Ollie",
				"Opal", "Oscar", "Otis", "Pat", "Pearl", "Pete", "Phyllis", "Ray", "Rita", "Roscoe", "Ruby", "Rudy",
				"Ruth", "Sal", "Sam", "Shirley", "Sid", "Stan", "Stella", "Sue", "Teddy", "Thelma", "Tomas", "Velma",
				"Vera", "Vern", "Viola", "Virgil", "Wally", "Walt", "Wanda", "Wendell", "Wilma", "Winnie", "Woody",
				"Yuki", "Zelda",
			},
		},
		Last = {
			Names = {
				"Abbott", "Alvarez", "Anders", "Baker", "Banks", "Barlow", "Becker", "Bell", "Bishop", "Brennan",
				"Brooks", "Bui", "Caldwell", "Carver", "Castillo", "Chen", "Clark", "Cobb", "Coleman", "Costa",
				"Crane", "Cruz", "Delgado", "Dixon", "Doyle", "Duffy", "Dunn", "Ellis", "Engel", "Esposito", "Farrell",
				"Fischer", "Fitz", "Flores", "Foster", "Fujita", "Gallo", "Garza", "Gibbs", "Gomez", "Grady", "Graves",
				"Haas", "Hale", "Harlan", "Hayes", "Hicks", "Holloway", "Hooper", "Hughes", "Hutch", "Ibarra", "Jansen",
				"Jennings", "Kaplan", "Keller", "Kim", "Kowalski", "Kramer", "Lambert", "Lang", "Larsen", "Lee", "Lowry",
				"Lund", "Maddox", "Malone", "Marchetti", "Marsh", "Mendez", "Meyer", "Miller", "Moreau", "Morales",
				"Murphy", "Nakamura", "Nash", "Novak", "Nowak", "O'Brien", "Okafor", "Olsen", "Ortiz", "Owens", "Park",
				"Patel", "Pike", "Price", "Quinn", "Ramos", "Reyes", "Rhodes", "Riley", "Rossi", "Russo", "Sato",
				"Schmidt", "Shaw", "Silva", "Sloane", "Sorensen", "Stone", "Sullivan", "Tanaka", "Torres", "Tucker",
				"Vale", "Vargas", "Vaughn", "Walsh", "Ward", "Webb", "Whitaker", "Wilder", "Wong", "Yates", "Zielinski",
			},
		},
		Nickname = {
			Names = {
				"Ace", "Bolts", "Buttons", "Chipper", "Copper", "Doc", "Dynamite", "Fizz", "Flash", "Gadget", "Gears",
				"Hammer", "Hotshot", "Lucky", "Moxie", "Patches", "Pepper", "Rivets", "Rocket", "Sarge", "Scoop",
				"Slim", "Smokey", "Socket", "Sparky", "Sprocket", "Sunny", "Tiny", "Torch", "Tumbler", "Whistle",
			},
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Resources</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Resources: the team's shared stockpile (bible Section 13). Power is a live balance, not a
	stock. Starting stock is bible Section 6; caps are provisional (each Storage cell raises
	every cap; the Quartermaster adds 25%).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "Live", "Stock" }),
		Start = F.Count,
		Cap = F.Count,
		CapPerStorageCell = F.Count,
		From = F.Text,
		SpentOn = F.Text,
	}),
	Order = { "Power", "Food", "Water", "Scrap", "Iron", "Copper", "Crystal", "Medkits", "Ammo" },
	Entries = {
		Power = {
			Name = "Power",
			Kind = "Live",
			Start = 0,
			Cap = 0,
			CapPerStorageCell = 0,
			From = "Reactor Core and Generators, as a live balance",
			SpentOn = "Every room, by level",
		},
		Food = {
			Name = "Food",
			Kind = "Stock",
			Start = 30,
			Cap = 100,
			CapPerStorageCell = 50,
			From = "Kitchen, Greenhouse, surface loot, expeditions",
			SpentOn = "1 per resident per cycle",
		},
		Water = {
			Name = "Water",
			Kind = "Stock",
			Start = 30,
			Cap = 100,
			CapPerStorageCell = 50,
			From = "Water Purifier, surface loot",
			SpentOn = "1 per resident per cycle",
		},
		Scrap = {
			Name = "Scrap",
			Kind = "Stock",
			Start = 300,
			Cap = 1000,
			CapPerStorageCell = 500,
			From = "Surface loot, monster drops, caches, expeditions, the trader",
			SpentOn = "Building, upgrades, repairs, crafting, the trader",
		},
		Iron = {
			Name = "Iron",
			Kind = "Stock",
			Start = 0,
			Cap = 100,
			CapPerStorageCell = 60,
			From = "Digging in the Mines, cave veins, the Drill Bay, Mines monsters",
			SpentOn = "Level 2 upgrades, crafting",
		},
		Copper = {
			Name = "Copper",
			Kind = "Stock",
			Start = 0,
			Cap = 60,
			CapPerStorageCell = 40,
			From = "Digging in the Flooded Caverns, cave veins, the Drill Bay, Flooded monsters",
			SpentOn = "Level 3 upgrades, crafting",
		},
		Crystal = {
			Name = "Crystal",
			Kind = "Stock",
			Start = 0,
			Cap = 40,
			CapPerStorageCell = 25,
			From = "Digging in the Crystal Hollows, cave veins, the Drill Bay, Crystal monsters",
			SpentOn = "Level 3 upgrades, crafting",
		},
		Medkits = {
			Name = "Medkits",
			Kind = "Stock",
			Start = 4,
			Cap = 20,
			CapPerStorageCell = 10,
			From = "Medbay, surface loot",
			SpentOn = "Healing players and residents",
		},
		Ammo = {
			Name = "Ammo",
			Kind = "Stock",
			Start = 200,
			Cap = 500,
			CapPerStorageCell = 250,
			From = "Armory, Workshop (from Scrap), surface loot",
			SpentOn = "Guns, for players and armed residents",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Rooms</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rooms: every room type (bible Section 6, rules in Tuning.Rooms).

	Output is per cell per cycle at level 1 with workers whose stats sum to 10 (the B in
	bible Section 13's formula); Power is what the room draws per cell at each level
	(Reactor Core and Generators give PowerOutput instead). Costs are per cell for each level:
	level 1 Scrap, level 2 adds Iron, level 3 adds Copper or Crystal plus Lab research.
	Every number here is provisional. Art: Asset .. "_L" .. level.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Levels = function(item: Check.Checker): Check.Checker
	return Check.array(item, 3)
end

local function room(t: { [string]: any }): { [string]: any }
	t.MaxCells = t.MaxCells or 3
	return t
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Text = F.Text,
		WorkerStat = Check.optional(Check.ref("Stats")),
		TrainsChosenStat = F.Flag,
		Unlock = Check.shape({
			Kind = Check.enum({ "Start", "Draft", "DraftOrDepth", "Era", "CryoPod" }),
			Era = Check.optional(Check.integer(1, 4)),
			Depth = Check.optional(Check.integer(1, 10)),
		}),
		Unique = F.Flag,
		Fixed = F.Flag, -- can't be moved, merged further or torn down
		Floor = Check.optional(Check.integer(1, 9)), -- only on this floor
		MaxCells = Check.integer(1, 3),
		Output = Check.optional(Check.shape({
			Kind = Check.enum({ "Resource", "BandOre", "Research", "Morale", "Recruits", "Training", "Digging", "Crafting", "Thawing", "Decon" }),
			Resource = Check.optional(Check.ref("Resources")),
			Base = F.NonNegative,
		})),
		PowerOutput = Check.optional(Levels(F.Count)),
		Power = Levels(F.Count),
		Beds = Check.optional(Levels(F.Count)),
		Costs = Levels(F.Costs),
		Research = Check.optional(F.Count), -- Lab research needed for level 3
		Asset = F.Asset,
	}),
	Order = {
		"BlastDoor", "Shaft", "ReactorCore", "Generator", "Kitchen", "WaterPurifier", "Quarters", "Medbay",
		"Storage", "Workshop", "Armory", "RadioRoom", "Lounge", "Lab", "DrillBay", "Greenhouse",
		"TrainingRoom", "DeconRoom", "CryoBay", "TradingPost", "Memorial",
	},
	Entries = {
		BlastDoor = room({
			Name = "Blast Door",
			Text = "Entrance from the surface; holds off raids and storms. Guards stand watch here.",
			WorkerStat = "Grit",
			Unlock = { Kind = "Start" },
			Unique = true,
			Fixed = true,
			Floor = 1,
			MaxCells = 2,
			Power = { 1, 2, 3 },
			Costs = { {}, { Scrap = 300, Iron = 40 }, { Scrap = 600, Copper = 30 } },
			Research = 40,
			Asset = "Room_BlastDoor",
		}),
		Shaft = room({
			Name = "Shaft",
			Text = "Stairs, resident lift and drop chute between floors.",
			Unlock = { Kind = "Start" },
			MaxCells = 1,
			Power = { 0, 0, 0 },
			Costs = { { Scrap = 60 }, { Scrap = 120, Iron = 10 }, { Scrap = 240, Copper = 10 } },
			Research = 10,
			Asset = "Room_Shaft",
		}),
		ReactorCore = room({
			Name = "Reactor Core",
			Text = "Power. If it is destroyed the run is lost; it can't be moved or torn down.",
			WorkerStat = "Strength",
			Unlock = { Kind = "Start" },
			Unique = true,
			Fixed = true,
			MaxCells = 1,
			PowerOutput = { 24, 36, 48 },
			Power = { 0, 0, 0 },
			Costs = { {}, { Scrap = 400, Iron = 50 }, { Scrap = 800, Copper = 40 } },
			Research = 50,
			Asset = "Room_ReactorCore",
		}),
		Generator = room({
			Name = "Generator",
			Text = "Extra power.",
			WorkerStat = "Strength",
			Unlock = { Kind = "Start" },
			PowerOutput = { 10, 15, 20 },
			Power = { 0, 0, 0 },
			Costs = { { Scrap = 150 }, { Scrap = 250, Iron = 25 }, { Scrap = 450, Copper = 20 } },
			Research = 25,
			Asset = "Room_Generator",
		}),
		Kitchen = room({
			Name = "Kitchen",
			Text = "Food.",
			WorkerStat = "Speed",
			Unlock = { Kind = "Start" },
			Output = { Kind = "Resource", Resource = "Food", Base = 8 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 120 }, { Scrap = 220, Iron = 20 }, { Scrap = 400, Copper = 15 } },
			Research = 25,
			Asset = "Room_Kitchen",
		}),
		WaterPurifier = room({
			Name = "Water Purifier",
			Text = "Water.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "Start" },
			Output = { Kind = "Resource", Resource = "Water", Base = 8 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 120 }, { Scrap = 220, Iron = 20 }, { Scrap = 400, Copper = 15 } },
			Research = 25,
			Asset = "Room_WaterPurifier",
		}),
		Quarters = room({
			Name = "Quarters",
			Text = "Beds: residents rest here. A rest stop for players to skip the day.",
			Unlock = { Kind = "Start" },
			Beds = { 4, 6, 8 },
			Power = { 1, 1, 2 },
			Costs = { { Scrap = 100 }, { Scrap = 180, Iron = 15 }, { Scrap = 320, Copper = 10 } },
			Research = 20,
			Asset = "Room_Quarters",
		}),
		Medbay = room({
			Name = "Medbay",
			Text = "Medkits; player respawn point; revives residents.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "Start" },
			Output = { Kind = "Resource", Resource = "Medkits", Base = 1 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 150 }, { Scrap = 260, Iron = 25 }, { Scrap = 450, Copper = 20 } },
			Research = 30,
			Asset = "Room_Medbay",
		}),
		Storage = room({
			Name = "Storage",
			Text = "Raises every stockpile cap.",
			Unlock = { Kind = "Start" },
			Power = { 0, 1, 1 },
			Costs = { { Scrap = 100 }, { Scrap = 180, Iron = 20 }, { Scrap = 320, Copper = 15 } },
			Research = 20,
			Asset = "Room_Storage",
		}),
		Workshop = room({
			Name = "Workshop",
			Text = "Crafting station for gear, ammo, turrets and tools.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "Start" },
			Output = { Kind = "Crafting", Base = 1 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 150 }, { Scrap = 260, Iron = 30 }, { Scrap = 450, Copper = 20 } },
			Research = 30,
			Asset = "Room_Workshop",
		}),
		Armory = room({
			Name = "Armory",
			Text = "Ammo; armed residents gather here during Surges.",
			WorkerStat = "Grit",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Resource", Resource = "Ammo", Base = 40 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 180 }, { Scrap = 300, Iron = 30 }, { Scrap = 500, Copper = 25 } },
			Research = 30,
			Asset = "Room_Armory",
		}),
		RadioRoom = room({
			Name = "Radio Room",
			Text = "Recruits survivors, places supply calls, hears distress calls; sends expeditions.",
			WorkerStat = "Charm",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Recruits", Base = 0.15 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 200 }, { Scrap = 320, Iron = 30 }, { Scrap = 550, Copper = 25 } },
			Research = 35,
			Asset = "Room_RadioRoom",
		}),
		Lounge = room({
			Name = "Lounge",
			Text = "Morale for the whole bunker.",
			WorkerStat = "Charm",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Morale", Base = 3 },
			Power = { 1, 2, 3 },
			Costs = { { Scrap = 180 }, { Scrap = 300, Iron = 25 }, { Scrap = 500, Copper = 20 } },
			Research = 30,
			Asset = "Room_Lounge",
		}),
		Lab = room({
			Name = "Lab",
			Text = "Research that unlocks level 3 upgrades and tech cards.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Research", Base = 10 },
			Power = { 3, 4, 5 },
			Costs = { { Scrap = 220 }, { Scrap = 360, Iron = 35 }, { Scrap = 600, Crystal = 20 } },
			Research = 40,
			Asset = "Room_Lab",
		}),
		DrillBay = room({
			Name = "Drill Bay",
			Text = "Digs queued cells slowly and mines ore from nearby rock.",
			WorkerStat = "Strength",
			Unlock = { Kind = "DraftOrDepth", Depth = 2 },
			Output = { Kind = "BandOre", Base = 3 },
			Power = { 3, 4, 5 },
			Costs = { { Scrap = 220 }, { Scrap = 360, Iron = 40 }, { Scrap = 600, Copper = 30 } },
			Research = 40,
			Asset = "Room_DrillBay",
		}),
		Greenhouse = room({
			Name = "Greenhouse",
			Text = "Food plus morale.",
			WorkerStat = "Speed",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Resource", Resource = "Food", Base = 6 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 180 }, { Scrap = 300, Iron = 25 }, { Scrap = 500, Copper = 20 } },
			Research = 30,
			Asset = "Room_Greenhouse",
		}),
		TrainingRoom = room({
			Name = "Training Room",
			Text = "Residents train one chosen stat.",
			TrainsChosenStat = true,
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Training", Base = 1 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 200 }, { Scrap = 320, Iron = 30 }, { Scrap = 550, Copper = 25 } },
			Research = 35,
			Asset = "Room_TrainingRoom",
		}),
		DeconRoom = room({
			Name = "Decon Room",
			Text = "Clears radiation from players and residents; slows leaks.",
			WorkerStat = "Grit",
			Unlock = { Kind = "Era", Era = 2 },
			Output = { Kind = "Decon", Base = 10 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 220 }, { Scrap = 360, Iron = 30 }, { Scrap = 600, Copper = 30 } },
			Research = 40,
			Asset = "Room_DeconRoom",
		}),
		CryoBay = room({
			Name = "Cryo Bay",
			Text = "Thaws cryo pods into Rare or Legendary residents.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "CryoPod" },
			Output = { Kind = "Thawing", Base = 1 },
			Power = { 3, 4, 5 },
			Costs = { { Scrap = 250 }, { Scrap = 400, Iron = 40 }, { Scrap = 650, Crystal = 25 } },
			Research = 45,
			Asset = "Room_CryoBay",
		}),
		TradingPost = room({
			Name = "Trading Post",
			Text = "The trader visits more often and charges less.",
			WorkerStat = "Charm",
			Unlock = { Kind = "Draft" },
			Power = { 1, 2, 3 },
			Costs = { { Scrap = 200 }, { Scrap = 320, Iron = 25 }, { Scrap = 550, Copper = 20 } },
			Research = 30,
			Asset = "Room_TradingPost",
		}),
		Memorial = room({
			Name = "Memorial",
			Text = "Faster morale recovery after deaths; one per bunker. Names of the fallen.",
			Unlock = { Kind = "Draft" },
			Unique = true,
			MaxCells = 1,
			Power = { 0, 1, 1 },
			Costs = { { Scrap = 150 }, { Scrap = 250, Iron = 20 }, { Scrap = 400, Copper = 15 } },
			Research = 20,
			Asset = "Room_Memorial",
		}),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Stats</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Stats: the five resident stats (bible Section 11). 1 to 10 on arrival; gear and training
	can push a stat to 15. Which rooms use a stat is on each room (Rooms.WorkerStat).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({ Name = F.Name, AlsoAffects = F.Text }),
	Order = { "Strength", "Smarts", "Grit", "Speed", "Charm" },
	Entries = {
		Strength = { Name = "Strength", AlsoAffects = "Melee damage, building speed, carrying on expeditions" },
		Smarts = { Name = "Smarts", AlsoAffects = "Repair speed, crafting" },
		Grit = { Name = "Grit", AlsoAffects = "Max health, resisting radiation and gas" },
		Speed = { Name = "Speed", AlsoAffects = "Moving, fleeing, expedition length" },
		Charm = { Name = "Charm", AlsoAffects = "Roommates' morale, recruiting, trade prices" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">SurfaceLocations</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SurfaceLocations: places to search in Brightwater Ruins, the launch region (bible Section
	12). The map is the lobby's town after the bomb. Containers refill every era.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Loot = Check.ref("LootTables"),
		Containers = F.PositiveInt,
		MinEra = Check.integer(1, 4),
		Text = F.Short,
	}),
	Order = { "Diner", "HardwareStore", "Grocery", "GasStation", "Motel", "RadioTower", "WaterTower", "RailYard", "Showroom", "Checkpoint" },
	Entries = {
		Diner = { Name = "Main Street diner", Loot = "Diner", Containers = 4, MinEra = 1, Text = "Soda fountain, booths, a kitchen out back." },
		HardwareStore = { Name = "Hardware store", Loot = "HardwareStore", Containers = 5, MinEra = 1, Text = "Tools, lamps and spare parts." },
		Grocery = { Name = "Grocery", Loot = "Grocery", Containers = 5, MinEra = 1, Text = "Canned food and bottled water." },
		GasStation = { Name = "Gas station", Loot = "GasStation", Containers = 3, MinEra = 1, Text = "Scrap and flares." },
		Motel = { Name = "Motel", Loot = "Motel", Containers = 6, MinEra = 1, Text = "Rooms to search; sometimes a survivor." },
		RadioTower = { Name = "Radio tower", Loot = "RadioTower", Containers = 3, MinEra = 1, Text = "Radio logs and a view of the town." },
		WaterTower = { Name = "Water tower", Loot = "WaterTower", Containers = 2, MinEra = 1, Text = "Water, if you can reach it." },
		RailYard = { Name = "Rail yard", Loot = "RailYard", Containers = 6, MinEra = 1, Text = "A wrecked train full of salvage." },
		Showroom = { Name = "Steadfast showroom", Loot = "Showroom", Containers = 4, MinEra = 1, Text = "The ruined showroom: blueprints and the company's secrets." },
		Checkpoint = { Name = "Military checkpoint", Loot = "Checkpoint", Containers = 5, MinEra = 3, Text = "Opens in Era III: ammo and military gear." },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">TalentSlots</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TalentSlots: a slot adds the passive of another owned class to the current one (bible
	Section 14). Talents are passives only (Classes.Talentable, Classes.TalentExclude).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Slot = Check.integer(1, 3),
		AccountLevel = Check.optional(F.PositiveInt),
		Glowshards = F.Glowshards,
		Pass = Check.optional(Check.ref("GamePasses")),
		Text = F.Short,
	}),
	Order = { "Slot1", "Slot2", "Slot3" },
	Entries = {
		Slot1 = { Slot = 1, AccountLevel = 5, Text = "Unlocks at account level 5" },
		Slot2 = { Slot = 2, Glowshards = 150, Pass = "ExtraTalentSlot", Text = "150 Glowshards or the Extra Talent Slot pass" },
		Slot3 = { Slot = 3, Glowshards = 300, Text = "300 Glowshards" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">TeamBoosts</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TeamBoosts: developer products bought during a run (bible Section 17). Every one helps the
	whole team and is announced with the buyer's name. Never a way around the team vote.
	ProductId is set in Prompt 28; prices provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Robux = F.PositiveInt,
		Text = F.Text,
		Banner = F.Short, -- "{player} called a Supply Drop!"
		Loot = Check.optional(Check.ref("LootTables")),
		ProductId = Check.optional(F.PositiveInt),
	}),
	Order = { "Revive", "RushConstruction", "BlueprintReroll", "StormShield", "SupplyDrop", "InstantRecruit", "EmergencyRepair" },
	Entries = {
		Revive = { Name = "Revive", Robux = 49, Text = "Brings a downed player back at once, yourself or a teammate.", Banner = "{player} revived {target}!" },
		RushConstruction = { Name = "Rush Construction", Robux = 49, Text = "Finishes every build in progress.", Banner = "{player} rushed construction!" },
		BlueprintReroll = { Name = "Blueprint Reroll", Robux = 49, Text = "Redraws the three draft cards.", Banner = "{player} rerolled the blueprints!" },
		StormShield = { Name = "Storm Shield", Robux = 79, Text = "Calms the surface storm during the next Surge.", Banner = "{player} raised a Storm Shield!" },
		SupplyDrop = {
			Name = "Supply Drop",
			Robux = 99,
			Text = "A crate of Food, Water, Ammo and Medkits at the Blast Door.",
			Banner = "{player} called a Supply Drop!",
			Loot = "SupplyDrop",
		},
		InstantRecruit = { Name = "Instant Recruit", Robux = 99, Text = "A Rare resident arrives now.", Banner = "{player} brought in a recruit!" },
		EmergencyRepair = {
			Name = "Emergency Repair",
			Robux = 149,
			Text = "Repairs every room and ends every fire and flood.",
			Banner = "{player} called an Emergency Repair!",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">Tiers</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Tiers: the rarity tiers of classes, residents, Legends and cosmetics (bible Sections 11,
	14, 15, 19). The colours are UI enamels (STYLE.md), never model swatches. Rarity shows in
	the look (Section 19): the Look line says how far a character's design goes.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Rank = Check.integer(0, 4),
		Color = Check.optional(F.Hex),
		Look = F.Text,
	}),
	Order = { "Free", "Common", "Rare", "Epic", "Legendary" },
	Entries = {
		Free = { Name = "Free", Rank = 0, Color = "#8E8C88", Look = "The Survivor: whatever they ran in with." },
		Common = { Name = "Common", Rank = 1, Color = "#8E8C88", Look = "A clean work outfit." },
		Rare = {
			Name = "Rare",
			Rank = 2,
			Color = "#3F79B5",
			Look = "Its own outfit, one signature piece (a hat, tool or pack) and an accent colour.",
		},
		Epic = {
			Name = "Epic",
			Rank = 3,
			Color = "#7D4C9E",
			Look = "A new silhouette (a coat, armour or harness), two or more signature pieces, brass or chrome detailing and a small effect.",
		},
		Legendary = {
			Name = "Legendary",
			Rank = 4,
			Color = "#D9A93A",
			Look = "One of a kind: a silhouette nothing else has, a hand-made head or hair, glowing or moving parts and its own idle.",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">Traits</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Traits: two per resident (bible Section 11 and the Appendix). Commons roll one good and one
	bad; Rares two good, or one good with higher stats; Legendaries a signature trait plus one
	good. Amounts the bible leaves open are provisional (Notes).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function mod(key: string, value: number, extra: { [string]: any }?): { [string]: any }
	local t: { [string]: any } = { Key = key, Value = value }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

local function good(text: string, modifiers: { any }, notes: string?): { [string]: any }
	return { Type = "Good", Text = text, Modifiers = modifiers, Notes = notes }
end

local function bad(text: string, modifiers: { any }, notes: string?): { [string]: any }
	return { Type = "Bad", Text = text, Modifiers = modifiers, Notes = notes }
end

local entries = {
	Brave = good("Never panics; defends their room even without a weapon.", { mod("NeverPanics", 1), mod("DefendsUnarmed", 1) }),
	Tough = good("+25% max health.", { mod("MaxHealthMult", 1.25) }),
	FastLearner = good("+25% experience.", { mod("ResidentXP", 1.25) }),
	GreenThumb = good("+20% output in the Kitchen and Greenhouse.", {
		mod("RoomOutput", 1.2, { Room = "Kitchen", Scope = "Self" }),
		mod("RoomOutput", 1.2, { Room = "Greenhouse", Scope = "Self" }),
	}),
	Tinkerer = good("+20% Workshop speed; slowly repairs their room.", { mod("CraftSpeed", 1.2), mod("RepairsRooms", 1, { Scope = "Room" }) }),
	SteadyHands = good("+20% output in the Medbay and Lab.", {
		mod("RoomOutput", 1.2, { Room = "Medbay", Scope = "Self" }),
		mod("RoomOutput", 1.2, { Room = "Lab", Scope = "Self" }),
	}),
	StrongBack = good("+20% output in the Reactor Core, Generators and Drill Bay; carries more on expeditions.", {
		mod("RoomOutput", 1.2, { Room = "ReactorCore", Scope = "Self" }),
		mod("RoomOutput", 1.2, { Room = "Generator", Scope = "Self" }),
		mod("RoomOutput", 1.2, { Room = "DrillBay", Scope = "Self" }),
		mod("ExpeditionCarry", 1.25),
	}, "Expedition carry x1.25 is provisional"),
	Firefighter = good("Puts out fires 3x faster; fire spreads slower from their room.", {
		mod("ExtinguishSpeed", 3),
		mod("FireSpread", 0.5, { Scope = "Room" }),
	}, "Spread x0.5 from their room is provisional"),
	Lucky = good("Chance of double output each cycle; better expedition loot.", {
		mod("DoubleOutputChance", 0.1),
		mod("ExpeditionLoot", 1.25),
	}, "10% double output and x1.25 loot are provisional"),
	Chatterbox = good("Raises roommates' morale.", { mod("RoommateMorale", 3) }, "+3 a cycle is provisional"),
	NaturalLeader = good("+10% output for everyone in their room.", { mod("AllOutput", 1.1, { Scope = "Room" }) }),
	Hardy = good("Resists radiation and gas.", { mod("RadiationGain", 0.5), mod("GasDamageTaken", 0.5) }, "Halved is provisional"),
	NightVision = good("No penalty in dark rooms.", { mod("NoDarkPenalty", 1) }),
	IronStomach = good("Eats half as much.", { mod("FoodUse", 0.5) }),
	Scrounger = good("Extra Scrap from expeditions and a small Scrap find each cycle.", {
		mod("ExpeditionScrap", 1.5),
		mod("ScrapPerCycle", 5),
	}, "x1.5 and +5 a cycle are provisional"),
	Sharpshooter = good("+30% gun damage.", { mod("GunDamage", 1.3) }),
	CoolHead = good("Never panics and calms panicked roommates.", { mod("NeverPanics", 1), mod("CalmsRoommates", 1) }),
	HardWorker = good("+10% output in any job.", { mod("AllOutput", 1.1) }),
	Coward = bad("Panics easily and flees breaches.", { mod("PanicChance", 2), mod("FleesBreaches", 1) }, "Panic x2 is provisional"),
	Clumsy = bad("Small chance each cycle of a minor fire or flood in their room.", { mod("AccidentChance", 0.04) }, "4% is provisional"),
	Glutton = bad("Eats twice as much.", { mod("FoodUse", 2) }),
	Lazy = bad("-15% output.", { mod("AllOutput", 0.85) }),
	Grumpy = bad("Lowers roommates' morale.", { mod("RoommateMorale", -3) }, "-3 a cycle is provisional"),
	Jumpy = bad("Panics at the first sign of danger and may run into hazards.", { mod("PanicChance", 3), mod("RunsIntoHazards", 1) }, "Panic x3 is provisional"),
	Sleepyhead = bad("Needs 50% more rest.", { mod("RestNeed", 1.5) }),
	Frail = bad("-25% max health.", { mod("MaxHealthMult", 0.75) }),
	Claustrophobic = bad("Morale drops at depth 4 and below.", { mod("Claustrophobic", 1) }),
	AfraidOfTheDark = bad("Morale crashes in dark rooms and refuses to work there.", { mod("AfraidOfDark", 1) }),
	Hothead = bad("Starts fights with rivals.", { mod("Hothead", 1) }),
	Homesick = bad("Morale slowly drains unless they spend time in the Lounge.", { mod("Homesick", 1) }),
}

local names = {
	Brave = "Brave", Tough = "Tough", FastLearner = "Fast Learner", GreenThumb = "Green Thumb", Tinkerer = "Tinkerer",
	SteadyHands = "Steady Hands", StrongBack = "Strong Back", Firefighter = "Firefighter", Lucky = "Lucky",
	Chatterbox = "Chatterbox", NaturalLeader = "Natural Leader", Hardy = "Hardy", NightVision = "Night Vision",
	IronStomach = "Iron Stomach", Scrounger = "Scrounger", Sharpshooter = "Sharpshooter", CoolHead = "Cool Head",
	HardWorker = "Hard Worker", Coward = "Coward", Clumsy = "Clumsy", Glutton = "Glutton", Lazy = "Lazy",
	Grumpy = "Grumpy", Jumpy = "Jumpy", Sleepyhead = "Sleepyhead", Frail = "Frail", Claustrophobic = "Claustrophobic",
	AfraidOfTheDark = "Afraid of the Dark", Hothead = "Hothead", Homesick = "Homesick",
}
for id, entry in entries do
	entry.Name = names[id]
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Type = Check.enum({ "Good", "Bad" }),
		Text = F.Text,
		Modifiers = F.Modifiers,
		Notes = Check.optional(F.Short),
	}),
	Order = {
		"Brave", "Tough", "FastLearner", "GreenThumb", "Tinkerer", "SteadyHands", "StrongBack", "Firefighter",
		"Lucky", "Chatterbox", "NaturalLeader", "Hardy", "NightVision", "IronStomach", "Scrounger", "Sharpshooter",
		"CoolHead", "HardWorker", "Coward", "Clumsy", "Glutton", "Lazy", "Grumpy", "Jumpy", "Sleepyhead", "Frail",
		"Claustrophobic", "AfraidOfTheDark", "Hothead", "Homesick",
	},
	Entries = entries,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">Tuning</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Tuning: the rule numbers of every system, one entry per system, each with its own schema
	(Config.Schemas). Values come from the bible where it gives them (section noted); the rest
	are provisional starting points for playtests, marked "prov." in comments.

		local Clock = Config.Get("Tuning", "Clock")
		Clock.DaySeconds -- 180
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local N, I, S, Fr = F.NonNegative, F.Count, F.Seconds, F.Fraction
local function list(item: Check.Checker, max: number): Check.Checker
	return Check.array(item, max)
end
local function shape(fields: { [string]: Check.Checker }): Check.Checker
	return Check.shape(fields)
end

local Cell = Check.shape({
	Floor = Check.integer(1, 10),
	Column = Check.integer(-6, 6),
	Room = Check.optional(Check.ref("Rooms")),
	Span = Check.optional(Check.integer(1, 3)),
	Dug = F.Flag,
})

local Schemas: { [string]: Check.Checker } = {
	Clock = shape({
		CycleSeconds = S, DaySeconds = S, SurgeSeconds = S,
		YearsPerCycleStart = I, YearsPerCycleMax = I, -- the bonuses are Config.Objectives' YearsPerCycle
		FinalYear = I, IntroSeconds = S, IntroSkipAfterSeconds = S,
		SurgeSirenSeconds = S, TutorialFirstSurge = Check.boolean(),
	}),
	Grid = shape({
		ColumnMin = Check.integer(-20, 0), ColumnMax = Check.integer(0, 20), FloorMin = I, FloorMax = I,
		CellWidth = N, CellHeight = N, CellDepth = N, SlabThickness = N, WallThickness = N, SourceFloor = I,
		Origin = shape({ X = F.Number, Y = F.Number, Z = F.Number }),
	}),
	StartingBunker = shape({
		Cells = list(Cell, 20),
		Residents = I,
		ResidentLevels = F.Range,
		ResidentTier = Check.ref("Tiers"),
	}),
	Rooms = shape({
		WorkerSlotsPerCell = list(I, 3), HP = list(I, 3), LevelMultiplier = list(N, 3), MergeMultiplier = list(N, 3),
		BuildSecondsPerCell = S, HelperBuildSpeed = N, ResidentRepairPerSecond = N,
		DarkSpawnMultiplier = N, DarkMoralePerCycle = F.Number,
	}),
	Votes = shape({
		TiesFail = Check.boolean(), BigSpendFraction = Fr, OpenProposalsPerPlayer = I, FailedCooldownSeconds = S,
		PassEarlyWhenAllYes = Check.boolean(), SoloSkipsVotes = Check.boolean(), RecheckCostsOnPass = Check.boolean(),
	}),
	Player = shape({
		Health = I, Stamina = I, SprintStaminaPerSecond = N, DodgeStamina = N, HeavySwingStamina = N,
		StaminaRegenPerSecond = N, RadiationMax = I, RadiationHealthDrainPerSecond = N,
		Loadout = shape({ Guns = I, Melee = I, Tool = I, Throwables = I, Medkits = I }),
		BackpackSlots = I, AimFieldOfView = list(N, 2), DownedSeconds = S, ReviveSeconds = S,
		RespawnSeconds = S, AimAssistDegrees = N, MedkitHeal = N,
	}),
	Camera = shape({
		FieldOfView = N, PivotHeight = N, ShoulderOffset = N, ShoulderRaise = F.Number,
		Distance = shape({ Min = N, Max = N, Default = N }), IndoorMax = N, AimDistance = N, AimShoulder = N,
		PitchMin = F.Number, PitchMax = F.Number, StartPitch = F.Number,
		MouseDegreesPerPixel = N, TouchDegreesPerPixel = N, GamepadDegreesPerSecond = N, StickDeadzone = Fr,
		AimSensitivity = Fr, AimWalkSpeed = Fr, ZoomStep = N, PinchStudsPerPixel = N,
		CollisionRadius = N, WallMargin = N, FloorMargin = N, CeilingMargin = N, NearestDistance = N,
		EaseOutPerSecond = N, PivotFollowPerSecond = N, ShoulderSwapSeconds = S, AimBlendSeconds = S,
		FadeTransparency = Fr, FrontWallTransparency = Fr, FadeSeconds = S, NearFadeRadius = N,
		CharacterFadeDistance = N, ErrorsBeforeFallback = I,
	}),
	Digging = shape({
		DisturbancePerCell = N, StackPlayers = Check.boolean(), PushDeeperFloors = list(I, 3),
		ResidentDigMultiplier = N,
	}),
	Disturbance = shape({
		Max = N, DecayPerCycle = N, NestDestroyed = N, Explosive = N, ExtraBreachAt = N, TremorAt = N, AfterTremor = N,
	}),
	Threat = shape({
		Base = N, PerYear = N, PerDeepestFloor = N, PerDisturbance = N, PerRoom = N,
		PlayerScale = list(N, 6), BetweenSurgesFraction = N, BreachWarningSeconds = S,
		TutorialSurgeBudget = N, FirstRunEraIMultiplier = N,
	}),
	Residents = shape({
		StatMin = I, StatMax = I, StatCap = I, LevelMax = I, MoraleStart = N, FoodPerCycle = N, WaterPerCycle = N,
		ShortfallHealth = N, ShortfallMorale = N, RestDrainPerShift = N, RestRefillPerCycle = N,
		NoBedRestMultiplier = N, FriendsMax = I, FriendThreshold = N, GrievingMorale = N, GrievingCycles = I,
		SurgeSurvivedMorale = N, DeathReviveSeconds = S, XPPerWorkCycle = N, XPPerKill = N,
		XPPerExpeditionCycle = N, XPToLevelBase = N, XPToLevelStep = N,
		RareStatBonus = I,
	}),
	Aging = shape({
		StartAge = F.Range, YoungUntil = I, YoungXP = N, VeteranFrom = I, VeteranSpeed = N,
		ElderFrom = I, ElderKeptOutput = N, DeathAge = F.Range,
	}),
	Morale = shape({
		JobFit = F.Number, PoorFit = F.Number, FriendInRoom = F.Number, FedCycle = F.Number, Hungry = F.Number,
		DarkRoom = F.Number, NoBed = F.Number, Injured = F.Number,
	}),
	Trader = shape({
		EveryCycles = I, EveryCyclesWithPost = I, PostDiscount = N,
		Buys = Check.map(Check.ref("Resources"), N, 9),
	}),
	Wanderers = shape({ EveryCycles = F.Range, InspectCharm = I }),
	Expeditions = shape({
		Size = F.Range, Cycles = F.Range, DistressChance = Fr, BaseLossChance = Fr,
		SurfaceLoot = Check.ref("LootTables"), DeepLoot = Check.ref("LootTables"),
	}),
	Surface = shape({
		StormSirenSeconds = S, RadiationPerSecond = N, StormRadiationPerSecond = N, RefillEvery = Check.enum({ "Era" }),
	}),
	Legends = shape({ StartLevel = I, RenownMax = I, RenownStatBonus = I, StarterLegend = Check.ref("Legends") }),
	ClassShop = shape({
		Slots = I, ResetHourUTC = I, FreeRerolls = I, VIPFreeRerolls = I, RerollRobux = I, WishlistDays = I,
		FreeTrialRunsPerDay = I, ClassLevelRuns = list(I, 2),
	}),
	Account = shape({ LevelMax = I, XPPerYear = N, XPToLevelBase = N, XPToLevelStep = N, VIPGlowshardBonus = N }),
	Lobby = shape({ PadCountdownSeconds = S, PartyMax = I }),
}

return {
	Schemas = Schemas,
	Entries = {
		Clock = { -- Section 5
			CycleSeconds = 270, DaySeconds = 180, SurgeSeconds = 90,
			YearsPerCycleStart = 1, YearsPerCycleMax = 12, -- +2 per Lost Crew, +1 per era boss: Config.Objectives
			FinalYear = 100, IntroSeconds = 30, IntroSkipAfterSeconds = 2, -- era ends: Config.Eras
			SurgeSirenSeconds = 20, TutorialFirstSurge = true,
		},
		Grid = { -- Section 6; walls (the A0 kit's) and where the grid sits in the Run place are ours
			ColumnMin = -6, ColumnMax = 6, FloorMin = 1, FloorMax = 10,
			CellWidth = 32, CellHeight = 16, CellDepth = 32, SlabThickness = 2, WallThickness = 1, SourceFloor = 10,
			Origin = { X = 0, Y = -120, Z = 0 }, -- the interior floor centre of floor 1, column 0
		},
		StartingBunker = { -- Section 6 and its diagram: the shafts in the middle column (0), rock at -3
			Cells = {
				{ Floor = 1, Column = -2, Room = "BlastDoor", Span = 2 },
				{ Floor = 1, Column = 0, Room = "Shaft" },
				{ Floor = 1, Column = 1, Room = "Quarters", Span = 2 },
				{ Floor = 1, Column = 3, Dug = true },
				{ Floor = 2, Column = -2, Room = "Kitchen" },
				{ Floor = 2, Column = -1, Room = "WaterPurifier" },
				{ Floor = 2, Column = 0, Room = "Shaft" },
				{ Floor = 2, Column = 1, Room = "ReactorCore" },
				{ Floor = 2, Column = 2, Room = "Medbay" },
				{ Floor = 2, Column = 3, Dug = true },
			},
			Residents = 6,
			ResidentLevels = { Min = 1, Max = 3 },
			ResidentTier = "Common",
		},
		Rooms = { -- Section 6; build helpers, repair and dark-room morale prov.
			WorkerSlotsPerCell = { 2, 3, 4 }, HP = { 500, 800, 1200 }, LevelMultiplier = { 1, 1.5, 2 },
			MergeMultiplier = { 1, 1.1, 1.2 }, BuildSecondsPerCell = 20, HelperBuildSpeed = 0.25,
			ResidentRepairPerSecond = 2, DarkSpawnMultiplier = 2, DarkMoralePerCycle = -5,
		},
		Votes = { -- Section 8
			TiesFail = true, BigSpendFraction = 0.4, OpenProposalsPerPlayer = 1, FailedCooldownSeconds = 20,
			PassEarlyWhenAllYes = true, SoloSkipsVotes = true, RecheckCostsOnPass = true,
		},
		Player = { -- Section 9; stamina costs, radiation drain, aim assist and Medkit heal prov.
			Health = 100, Stamina = 100, SprintStaminaPerSecond = 12, DodgeStamina = 20, HeavySwingStamina = 20,
			StaminaRegenPerSecond = 18, RadiationMax = 100, RadiationHealthDrainPerSecond = 2,
			Loadout = { Guns = 2, Melee = 1, Tool = 1, Throwables = 2, Medkits = 3 },
			BackpackSlots = 10, AimFieldOfView = { 70, 50 }, DownedSeconds = 20, ReviveSeconds = 3,
			RespawnSeconds = 15, AimAssistDegrees = 6, MedkitHeal = 60,
		},
		Camera = { -- Section 9 (right shoulder, aim narrows Player.AimFieldOfView, wall fade, zoom capped indoors); numbers prov.
			FieldOfView = 70, PivotHeight = 1.6, ShoulderOffset = 2.2, ShoulderRaise = 0.3,
			Distance = { Min = 4, Max = 16, Default = 9 }, IndoorMax = 11, AimDistance = 6, AimShoulder = 1.25,
			PitchMin = -70, PitchMax = 60, StartPitch = -12,
			MouseDegreesPerPixel = 0.22, TouchDegreesPerPixel = 0.3, GamepadDegreesPerSecond = 220, StickDeadzone = 0.15,
			AimSensitivity = 0.6, AimWalkSpeed = 0.6, ZoomStep = 1.5, PinchStudsPerPixel = 0.04,
			CollisionRadius = 0.6, WallMargin = 0.25, FloorMargin = 1.2, CeilingMargin = 1.9, NearestDistance = 0.8,
			EaseOutPerSecond = 6, PivotFollowPerSecond = 18, ShoulderSwapSeconds = 0.18, AimBlendSeconds = 0.15,
			FadeTransparency = 0.8, FrontWallTransparency = 1, FadeSeconds = 0.12, NearFadeRadius = 1.4,
			CharacterFadeDistance = 2.2, ErrorsBeforeFallback = 5,
		},
		Digging = { DisturbancePerCell = 5, StackPlayers = true, PushDeeperFloors = { 4, 7, 10 }, ResidentDigMultiplier = 0.25 },
		Disturbance = { -- Section 10
			Max = 100, DecayPerCycle = 10, NestDestroyed = 20, Explosive = 10, ExtraBreachAt = 50, TremorAt = 100, AfterTremor = 40,
		},
		Threat = { -- Section 10 lists the inputs; weights prov. First-run Era I is 30% easier (Section 22)
			Base = 12, PerYear = 1.2, PerDeepestFloor = 4, PerDisturbance = 0.25, PerRoom = 1,
			PlayerScale = { 1, 1.6, 2.1, 2.5, 2.8, 3 }, BetweenSurgesFraction = 0.1, BreachWarningSeconds = 10,
			TutorialSurgeBudget = 6, FirstRunEraIMultiplier = 0.7,
		},
		Residents = { -- Section 11; needs and experience prov.
			StatMin = 1, StatMax = 10, StatCap = 15, LevelMax = 20, MoraleStart = 60, FoodPerCycle = 1, WaterPerCycle = 1,
			ShortfallHealth = 10, ShortfallMorale = 10, RestDrainPerShift = 60, RestRefillPerCycle = 100,
			NoBedRestMultiplier = 0.4, FriendsMax = 3, FriendThreshold = 100, GrievingMorale = 20, GrievingCycles = 2,
			SurgeSurvivedMorale = 5, DeathReviveSeconds = 20, XPPerWorkCycle = 30, XPPerKill = 5,
			XPPerExpeditionCycle = 40, XPToLevelBase = 100, XPToLevelStep = 40, RareStatBonus = 2,
		},
		Aging = { -- Section 11
			StartAge = { Min = 18, Max = 50 }, YoungUntil = 29, YoungXP = 1.1, VeteranFrom = 55, VeteranSpeed = 0.9,
			ElderFrom = 70, ElderKeptOutput = 0.7, DeathAge = { Min = 80, Max = 100 },
		},
		Morale = { -- Section 11 lists the causes; amounts prov. (Grieving is a Condition)
			JobFit = 2, PoorFit = -2, FriendInRoom = 2, FedCycle = 1, Hungry = -10, DarkRoom = -5, NoBed = -5, Injured = -5,
		},
		Trader = { -- Section 13; what he pays in Scrap per unit prov.
			EveryCycles = 3, EveryCyclesWithPost = 2, PostDiscount = 0.85,
			Buys = { Food = 2, Water = 2, Iron = 6, Copper = 10, Crystal = 16 },
		},
		Wanderers = { EveryCycles = { Min = 2, Max = 3 }, InspectCharm = 7 }, -- Section 10
		Expeditions = { -- Section 12; distress and loss odds prov.
			Size = { Min = 1, Max = 3 }, Cycles = { Min = 1, Max = 3 }, DistressChance = 0.15, BaseLossChance = 0.05,
			SurfaceLoot = "ExpeditionSurface", DeepLoot = "ExpeditionDeep",
		},
		Surface = { StormSirenSeconds = 20, RadiationPerSecond = 0.2, StormRadiationPerSecond = 2, RefillEvery = "Era" }, -- Section 12; rates prov.
		Legends = { StartLevel = 5, RenownMax = 5, RenownStatBonus = 1, StarterLegend = "RosieKowalski" }, -- Section 15
		ClassShop = { -- Section 14
			Slots = 4, ResetHourUTC = 0, FreeRerolls = 1, VIPFreeRerolls = 2, RerollRobux = 99, WishlistDays = 3,
			FreeTrialRunsPerDay = 1, ClassLevelRuns = { 3, 10 },
		},
		Account = { LevelMax = 100, XPPerYear = 10, XPToLevelBase = 200, XPToLevelStep = 50, VIPGlowshardBonus = 0.25 }, -- Section 16; XP prov.
		Lobby = { PadCountdownSeconds = 20, PartyMax = 6 }, -- Section 21
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">Votes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Votes: what the team votes on and how each passes (bible Section 8). General rules
	(abstaining, ties, the 40% rule, cooldowns, solo runs, the Warden) are in Tuning.Votes.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		StartsWhen = F.Short,
		Seconds = F.Seconds,
		Rule = Check.enum({ "MoreYes", "WholeTeamMajority", "MostVotes", "TwoThirdsOfOthers" }),
		Text = F.Short,
	}),
	Order = { "Build", "PushDeeper", "Draft", "LetThemIn", "KeepGoing", "Kick" },
	Entries = {
		Build = {
			Name = "Build, upgrade, merge or tear down",
			StartsWhen = "A player proposes it in the Command View",
			Seconds = 15,
			Rule = "MoreYes",
			Text = "More yes than no after 15 seconds",
		},
		PushDeeper = {
			Name = "Push Deeper",
			StartsWhen = "Someone tries to open the first cell of floor 4, 7 or 10",
			Seconds = 20,
			Rule = "WholeTeamMajority",
			Text = "A majority of the whole team says yes",
		},
		Draft = {
			Name = "Blueprint draft",
			StartsWhen = "After every Surge",
			Seconds = 20,
			Rule = "MostVotes",
			Text = "Most votes after 20 seconds; ties are picked at random",
		},
		LetThemIn = {
			Name = "Let them in?",
			StartsWhen = "A wanderer knocks at the blast door",
			Seconds = 15,
			Rule = "MoreYes",
			Text = "More yes than no after 15 seconds",
		},
		KeepGoing = {
			Name = "Keep Going",
			StartsWhen = "After a victory",
			Seconds = 20,
			Rule = "WholeTeamMajority",
			Text = "A majority of the whole team",
		},
		Kick = {
			Name = "Kick a player",
			StartsWhen = "Any player starts it against one person",
			Seconds = 20,
			Rule = "TwoThirdsOfOthers",
			Text = "Two thirds of the other players",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000029"><Properties><string name="Name">WandererOutcomes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	WandererOutcomes: who is really knocking (bible Section 10). Every 2 to 3 cycles someone
	knocks and the team votes Let them in? The Warden, or a resident with Charm 7 or more, can
	inspect newcomers (Tuning.Wanderers). Odds provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({ Name = F.Name, Chance = F.Fraction, Text = F.Text }),
	Order = { "Survivor", "Raider", "Carrier" },
	Entries = {
		Survivor = { Name = "Survivor", Chance = 0.7, Text = "A real survivor who becomes a resident, sometimes a Rare one." },
		Raider = {
			Name = "Raider in disguise",
			Chance = 0.2,
			Text = "Later steals supplies or opens the door during a raid, unless unmasked first.",
		},
		Carrier = { Name = "Carrier", Chance = 0.1, Text = "Starts an Outbreak." },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002A"><Properties><string name="Name">_Fields</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	_Fields: checkers shared by the content modules (a helper, not a content type: Config
	skips child modules whose names start with _).
]]

local Check = require(script.Parent.Parent.Utilities.Check)

local Fields = {}

Fields.Name = Check.string(60, { min = 1 })
Fields.Short = Check.string(160)
Fields.Text = Check.string(600)
Fields.Count = Check.integer(0)
Fields.PositiveInt = Check.integer(1)
Fields.Number = Check.number()
Fields.NonNegative = Check.number({ min = 0 })
Fields.Fraction = Check.number({ min = 0, max = 1 })
Fields.Seconds = Check.number({ min = 0, max = 36000 })
Fields.Hex = Check.string(7, { pattern = "^#%x%x%x%x%x%x$" })
Fields.Flag = Check.optional(Check.boolean())

-- An art asset name from the pipeline (Category_Name or Category_Name_Variant).
Fields.Asset = Check.optional(Check.string(64, { pattern = "^%u%w*_%u[%w_]*$" }))

-- Where something comes from or how it unlocks.
Fields.Robux = Check.optional(Check.integer(0, 100000))
Fields.Glowshards = Check.optional(Check.integer(0, 100000))

-- A price or cost in stockpile resources: { Scrap = 100, Iron = 20 }
Fields.Costs = Check.map(Check.ref("Resources"), Check.integer(0), 9)

-- A low..high range of whole numbers.
Fields.Range = Check.shape({ Min = Check.number(), Max = Check.number() })

-- What an effect changes. Key names the modifier (Config.Modifiers says what it means, its
-- unit and which system applies it); Scope says who it reaches; Room narrows RoomOutput-style
-- keys to one room type.
Fields.Scope = Check.enum({ "Self", "Presence", "Room", "Nearby", "Floor", "Team", "Bunker" })
Fields.Modifier = Check.shape({
	Key = Check.ref("Modifiers"),
	Value = Check.number(),
	Room = Check.optional(Check.ref("Rooms")),
	Scope = Check.optional(Fields.Scope),
})
Fields.Modifiers = Check.array(Fields.Modifier, 12)

-- A described effect: the text players read and the modifiers systems apply.
Fields.Effect = Check.shape({
	Text = Fields.Text,
	Modifiers = Check.optional(Fields.Modifiers),
})

-- A list of item ids with counts (starting kits, loot, rewards).
Fields.ItemStack = Check.shape({ Item = Check.ref("Items"), Count = Check.optional(Check.integer(1, 999)) })
Fields.ItemStacks = Check.array(Fields.ItemStack, 12)

return table.freeze(Fields)
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX0000002B"><Properties><string name="Name">Constants</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Constants: identity and engine limits that every module may need.

	Gameplay numbers (costs, timings, stats) are content and live in Config, never here.
	These are the facts about the game itself and the provisional limits from bible
	Section 23 that size the simulation.
]]

export type PlaceKind = "Lobby" | "Run"

local Constants = {}

Constants.GAME_NAME = "100 Years Of Fallout"
Constants.UNIVERSE_ID = 10775267993
Constants.OWNER_USER_ID = 9768530298

-- Place ids (bible Section 23: two places, Lobby is the start place)
Constants.PLACE_IDS = table.freeze({
	Lobby = 135073046693952,
	Run = 72892455946761,
})

Constants.MAX_PLAYERS = table.freeze({
	Lobby = 30,
	Run = 6,
})

-- Simulation caps (provisional, bible Section 23)
Constants.CAPS = table.freeze({
	Residents = 40,
	Monsters = 25,
	Players = 6,
})

Constants.RESIDENT_TICK_HZ = 5 -- residents are simulated at 5 Hz along the room graph
Constants.SHOT_HISTORY_SECONDS = 0.25 -- gun checks look this far back for the target
Constants.AUTOSAVE_SECONDS = 120 -- profiles autosave this often (plus on leave and shutdown)
Constants.DELTA_HZ = 10 -- the delta channel flushes this often

-- Who may run DevTools commands outside Studio (Studio allows everyone in a playtest)
Constants.ADMIN_USER_IDS = table.freeze({
	[9768530298] = true,
})

--[[
	Which place this is. The PlaceId decides; a copied or local place falls back on the
	`PlaceKind` attribute the installer sets on Workspace.
]]
function Constants.PlaceKind(): PlaceKind
	local placeId = game.PlaceId
	if placeId == Constants.PLACE_IDS.Lobby then
		return "Lobby"
	elseif placeId == Constants.PLACE_IDS.Run then
		return "Run"
	end
	local attribute = workspace:GetAttribute("PlaceKind")
	if attribute == "Lobby" then
		return "Lobby"
	elseif attribute == "Run" then
		return "Run"
	end
	error(`Unknown place: PlaceId {placeId} and no PlaceKind attribute on Workspace`)
end

return table.freeze(Constants)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002C"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Remotes: the one list of network events, and the only way code touches them
	(bible Section 23: a small set of typed RemoteEvents, each checked on the server and
	rate-limited per player; clients send intentions, never results).

	Adding a remote is one entry in DEFINITIONS:
	* To = "Server" (client -> server): Args holds one checker per argument (extra arguments
	  are rejected), Rate limits each player. The handler only runs for calls that pass.
	* To = "Client" (server -> client): the server is trusted; no checks.
	* Unreliable = true makes an UnreliableRemoteEvent (cosmetic, high-frequency traffic).
	* Place = "Run" or "Lobby" makes it exist in that place only (default: both).

	Server: Remotes.Setup() once (Bootstrap), then Remotes.OnServer(name, handler) and
	Remotes.FireClient / FireClients / FireAllClients. Client: Remotes.OnClient(name, handler)
	and Remotes.FireServer(name, ...). The RemoteEvents live under this ModuleScript.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Check = require(script.Parent.Utilities.Check)
local Constants = require(script.Parent.Constants)
local Log = require(script.Parent.Utilities.Log)
local RateLimit = require(script.Parent.Utilities.RateLimit)

export type Definition = {
	To: "Server" | "Client",
	Args: { Check.Checker }?,
	Rate: { Burst: number, PerSecond: number }?,
	Unreliable: boolean?,
	Place: Constants.PlaceKind?,
	Doc: string,
}

local DEFINITIONS: { [string]: Definition } = {
	-- client -> server
	ClientReady = {
		To = "Server",
		Args = {},
		Rate = { Burst = 2, PerSecond = 0.05 },
		Doc = "The client finished bootstrapping; the server sends it the replication snapshot.",
	},
	DevCommand = {
		To = "Server",
		Args = {
			Check.string(48, { pattern = "^[%w_%.%-]+$", min = 1 }),
			Check.array(Check.primitive(120), 8),
		},
		Rate = { Burst = 6, PerSecond = 2 },
		Doc = "A DevTools command (name, arguments) from a player; DevService checks permission.",
	},
	SetReady = {
		To = "Server",
		Place = "Run",
		Args = { Check.boolean() },
		Rate = { Burst = 4, PerSecond = 1 },
		Doc = "Ready (true) or not (false) to skip the rest of the day phase to the Surge siren (CycleClock).",
	},

	-- server -> client
	Delta = {
		To = "Client",
		Doc = "The delta channel: batched collection ops (see Utilities.Delta), plus a snapshot flag.",
	},
	Notice = {
		To = "Client",
		Doc = "A text message for one player (DevTools output for now).",
	},
}

local log = Log.new("Remotes")
local IS_SERVER = RunService:IsServer()
local WAIT_SECONDS = 15
local REJECTION_LOG_SECONDS = 10

export type Stats = { Received: number, Rejected: number, Limited: number, Failed: number }

local stats: { [string]: Stats } = {}
local limiters: { [string]: RateLimit.Limiter } = {}
local handled: { [string]: boolean } = {}
local lastRejectionLog: { [Player]: number } = {}

for name, definition in DEFINITIONS do
	assert(definition.To == "Server" or definition.To == "Client", `Remote {name}: To must be Server or Client`)
	assert(definition.Place == nil or definition.Place == "Lobby" or definition.Place == "Run", `Remote {name}: Place must be Lobby or Run`)
	if definition.To == "Server" then
		assert(definition.Args, `Remote {name}: a client -> server remote needs Args`)
		assert(definition.Rate, `Remote {name}: a client -> server remote needs a Rate`)
	end
	stats[name] = { Received = 0, Rejected = 0, Limited = 0, Failed = 0 }
	table.freeze(definition)
end
table.freeze(DEFINITIONS)

local Remotes = {}

Remotes.Definitions = DEFINITIONS

-- Does this remote exist in this place?
function Remotes.InPlace(name: string): boolean
	local definition = DEFINITIONS[name]
	return definition ~= nil and (definition.Place == nil or definition.Place == Constants.PlaceKind())
end

local function definitionOf(name: string, direction: "Server" | "Client"): Definition
	local definition = DEFINITIONS[name]
	if not definition then
		error(`Unknown remote {tostring(name)}`, 3)
	end
	if definition.To ~= direction then
		error(`Remote {name} goes to the {definition.To:lower()}, not the {direction:lower()}`, 3)
	end
	if definition.Place ~= nil and definition.Place ~= Constants.PlaceKind() then
		error(`Remote {name} only exists in the {definition.Place} place`, 3)
	end
	return definition
end

local function instanceOf(name: string): RemoteEvent
	local found = script:FindFirstChild(name)
	if not found then
		if IS_SERVER then
			error(`Remote {name} doesn't exist yet: call Remotes.Setup() first`, 3)
		end
		found = script:WaitForChild(name, WAIT_SECONDS)
		if not found then
			error(`Remote {name} didn't arrive within {WAIT_SECONDS} s`, 3)
		end
	end
	return found :: any
end

-- Server: create every RemoteEvent. Idempotent.
function Remotes.Setup()
	assert(IS_SERVER, "Remotes.Setup runs on the server")
	local place = Constants.PlaceKind()
	for name, definition in DEFINITIONS do
		local className = if definition.Unreliable then "UnreliableRemoteEvent" else "RemoteEvent"
		local existing = script:FindFirstChild(name)
		if definition.Place ~= nil and definition.Place ~= place then
			if existing then
				existing:Destroy()
			end
			continue
		end
		if existing and existing.ClassName ~= className then
			existing:Destroy()
			existing = nil
		end
		if not existing then
			local remote = Instance.new(className)
			remote.Name = name
			remote.Parent = script
		end
		if definition.Rate then
			limiters[name] = RateLimit.new(definition.Rate.Burst, definition.Rate.PerSecond)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		for _, limiter in limiters do
			limiter:Forget(player)
		end
		lastRejectionLog[player] = nil
	end)
end

local function noteRejection(player: Player, name: string, why: string)
	local now = os.clock()
	local last = lastRejectionLog[player]
	if last and now - last < REJECTION_LOG_SECONDS then
		return
	end
	lastRejectionLog[player] = now
	log:Warn("rejected %s from %s (%d): %s", name, player.Name, player.UserId, why)
end

-- Server: the handler for a client -> server remote. One handler per remote.
function Remotes.OnServer(name: string, handler: (player: Player, ...any) -> ())
	assert(IS_SERVER, "Remotes.OnServer runs on the server")
	local definition = definitionOf(name, "Server")
	assert(not handled[name], `Remote {name} already has a handler`)
	handled[name] = true
	local checks = definition.Args :: { Check.Checker }
	local limiter = limiters[name]
	local counters = stats[name]
	instanceOf(name).OnServerEvent:Connect(function(player: Player, ...: any)
		counters.Received += 1
		if limiter and not limiter:Take(player) then
			counters.Limited += 1
			noteRejection(player, name, "rate limit")
			return
		end
		local count = select("#", ...)
		if count > #checks then
			counters.Rejected += 1
			noteRejection(player, name, `{count} arguments, expected at most {#checks}`)
			return
		end
		local args = { ... }
		for index, check in checks do
			local ok, why = check(args[index])
			if not ok then
				counters.Rejected += 1
				noteRejection(player, name, `argument {index}: {why}`)
				return
			end
		end
		local ok, err = xpcall(handler, debug.traceback, player, table.unpack(args, 1, count))
		if not ok then
			counters.Failed += 1
			log:Error("%s handler failed for %s: %s", name, player.Name, tostring(err))
		end
	end)
end

function Remotes.FireClient(name: string, player: Player, ...: any)
	definitionOf(name, "Client")
	instanceOf(name):FireClient(player, ...)
end

function Remotes.FireClients(name: string, players: { Player }, ...: any)
	definitionOf(name, "Client")
	local remote = instanceOf(name)
	for _, player in players do
		remote:FireClient(player, ...)
	end
end

function Remotes.FireAllClients(name: string, ...: any)
	definitionOf(name, "Client")
	instanceOf(name):FireAllClients(...)
end

-- Client: the handler for a server -> client remote.
function Remotes.OnClient(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER, "Remotes.OnClient runs on the client")
	definitionOf(name, "Client")
	return instanceOf(name).OnClientEvent:Connect(handler)
end

function Remotes.FireServer(name: string, ...: any)
	assert(not IS_SERVER, "Remotes.FireServer runs on the client")
	definitionOf(name, "Server")
	instanceOf(name):FireServer(...)
end

-- Server: counters per remote, for DevTools.
function Remotes.Stats(): { [string]: Stats }
	return stats
end

return table.freeze(Remotes)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000031"><Properties><string name="Name">Rules</string></Properties><Item class="ModuleScript" referent="RBX0000002E"><Properties><string name="Name">Bunker</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Bunker: the bunker as data, with the grid's rules (bible Section 6). Pure (no
	Instances), so BunkerGrid on the server, the Command View on the client (ghost outlines,
	what can be dug) and the data tests share it.

	Every cell on the grid is Rock, Dug (empty) or part of a room. `Cells` holds the open ones:
	"" for a Dug cell, the room's id for a room cell; a cell that isn't there is Rock.

	The rules:
	* Dig: a Rock cell to the left of, right of or below an open cell.
	* Place: a room on Dug cells side by side on one floor, at most its MaxCells, in a band
	  that can be built on (not the Source Chamber), on its own Floor if it has one, and only
	  one of a Unique room.
	* Merge: two rooms of one type and level side by side, at most MaxCells together (rooms at
	  different levels never merge; Landon, Nov 8, 2026). Fixed rooms (the Blast Door, the
	  Reactor Core) never merge, move or go. The merged room keeps both rooms' HP.
	* HP is per cell (Landon, Nov 8, 2026): a room's maximum is Tuning.Rooms.HP for its level
	  times its cells, so a 3-cell room at level 1 has 1,500.
	* SetLevel: 1 to 3; HP keeps its share of the new maximum.
	* The room graph: a node per room ("R3") and per Dug cell ("D:2,3"), with an edge between
	  side-by-side open cells of different units (a doorway) and between stacked Shafts. A dug
	  cell is a step like a room when power counts steps from a Reactor Core or a Generator
	  (Section 6; Landon, Nov 8, 2026).

	Votes, costs and build time (BuildService, Prompt 8), dig time and Push Deeper (DigService,
	Prompt 14) are not here.
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

export type CellState = "Rock" | "Dug" | "Room"
export type Room = {
	Id: string,
	Type: string,
	Floor: number,
	Column: number, -- the leftmost cell
	Span: number, -- cells, side by side
	Level: number,
	HP: number,
	MaxHP: number,
}

type Data = {
	Cells: { [string]: string },
	Rooms: { [string]: Room },
	NextId: number,
}

local Bunker = {}
Bunker.__index = Bunker

export type Bunker = typeof(setmetatable({} :: Data, Bunker))

local DUG_PREFIX = "D:"

-- A room's maximum HP: per cell, by level.
local function maxHP(level: number, span: number): number
	return Config.Get("Tuning", "Rooms").HP[level] * span
end

Bunker.MaxHP = maxHP

local function idNumber(id: string): number
	return tonumber(string.sub(id, 2)) or 0
end

function Bunker.new(): Bunker
	return setmetatable({ Cells = {}, Rooms = {}, NextId = 1 } :: Data, Bunker)
end

-- The starting bunker (Tuning.StartingBunker), built by the same rules.
function Bunker.FromStart(): Bunker
	local bunker = Bunker.new()
	local start = Config.Get("Tuning", "StartingBunker")
	for _, cell in start.Cells do
		for column = cell.Column, cell.Column + (cell.Span or 1) - 1 do
			bunker:Open(cell.Floor, column)
		end
	end
	for _, cell in start.Cells do
		if cell.Room then
			local id, why = bunker:Place(cell.Room, cell.Floor, cell.Column, cell.Span or 1)
			if not id then
				error(`Tuning.StartingBunker: {cell.Room} at {Grid.Key(cell.Floor, cell.Column)}: {why}`)
			end
		end
	end
	return bunker
end

-- Cells ---------------------------------------------------------------------------------

-- Rock, Dug or Room (and the room's id); nil off the grid.
function Bunker.State(self: Bunker, floor: number, column: number): (CellState?, string?)
	if not Grid.OnGrid(floor, column) then
		return nil, nil
	end
	local value = self.Cells[Grid.Key(floor, column)]
	if value == nil then
		return "Rock", nil
	elseif value == "" then
		return "Dug", nil
	end
	return "Room", value
end

function Bunker.IsOpen(self: Bunker, floor: number, column: number): boolean
	local state = self:State(floor, column)
	return state == "Dug" or state == "Room"
end

-- Opens a cell with no questions asked: for the starting bunker and tests only.
function Bunker.Open(self: Bunker, floor: number, column: number)
	assert(Grid.OnGrid(floor, column), `Rules.Bunker: {Grid.Key(floor, column)} is off the grid`)
	local key = Grid.Key(floor, column)
	if self.Cells[key] == nil then
		self.Cells[key] = ""
	end
end

function Bunker.CanDig(self: Bunker, floor: number, column: number): (boolean, string?)
	if not Grid.OnGrid(floor, column) then
		return false, "off the grid"
	elseif self:IsOpen(floor, column) then
		return false, "already open"
	elseif self:IsOpen(floor, column - 1) or self:IsOpen(floor, column + 1) or self:IsOpen(floor - 1, column) then
		return true, nil
	end
	return false, "not next to an open cell (dig left, right or down from one)"
end

function Bunker.Dig(self: Bunker, floor: number, column: number): (boolean, string?)
	local ok, why = self:CanDig(floor, column)
	if ok then
		self.Cells[Grid.Key(floor, column)] = ""
	end
	return ok, why
end

-- The deepest floor with an open cell.
function Bunker.DeepestFloor(self: Bunker): number
	local deepest = 0
	for key in self.Cells do
		local floor = Grid.Parse(key)
		if floor and floor > deepest then
			deepest = floor
		end
	end
	return deepest
end

-- Rooms ---------------------------------------------------------------------------------

-- The live record: read it, never edit it (use the methods).
function Bunker.Room(self: Bunker, id: string): Room?
	return self.Rooms[id]
end

function Bunker.RoomAt(self: Bunker, floor: number, column: number): Room?
	local state, id = self:State(floor, column)
	return if state == "Room" and id then self.Rooms[id] else nil
end

function Bunker.IsShaft(self: Bunker, floor: number, column: number): boolean
	local room = self:RoomAt(floor, column)
	return room ~= nil and room.Type == "Shaft"
end

-- Every room, oldest first.
function Bunker.AllRooms(self: Bunker): { Room }
	local list = {}
	for _, room in self.Rooms do
		table.insert(list, room)
	end
	table.sort(list, function(a, b)
		return idNumber(a.Id) < idNumber(b.Id)
	end)
	return list
end

function Bunker.RoomsOfType(self: Bunker, roomType: string): { Room }
	local list = {}
	for _, room in self:AllRooms() do
		if room.Type == roomType then
			table.insert(list, room)
		end
	end
	return list
end

function Bunker.CanPlace(self: Bunker, roomType: string, floor: number, column: number, span: number): (boolean, string?)
	local info = Config.Find("Rooms", roomType)
	if not info then
		return false, `no room type {tostring(roomType)}`
	elseif span ~= math.floor(span) or span < 1 or span > info.MaxCells then
		return false, `{info.Name} takes 1 to {info.MaxCells} cells`
	end
	for offset = 0, span - 1 do
		local state = self:State(floor, column + offset)
		if state == nil then
			return false, "off the grid"
		elseif state ~= "Dug" then
			return false, `cell {Grid.Key(floor, column + offset)} isn't dug and empty`
		end
	end
	if not Grid.Buildable(floor) then
		return false, "nothing is built in the Source Chamber"
	elseif info.Floor and info.Floor ~= floor then
		return false, `{info.Name} only goes on floor {info.Floor}`
	elseif info.Unique and #self:RoomsOfType(roomType) > 0 then
		return false, `there is already a {info.Name}`
	end
	return true, nil
end

function Bunker.Place(self: Bunker, roomType: string, floor: number, column: number, span: number, level: number?): (string?, string?)
	local ok, why = self:CanPlace(roomType, floor, column, span)
	if not ok then
		return nil, why
	end
	local startLevel = level or 1
	if startLevel ~= 1 and startLevel ~= 2 and startLevel ~= 3 then
		return nil, "levels go from 1 to 3"
	end
	local id = `R{self.NextId}`
	self.NextId += 1
	local hp = maxHP(startLevel, span)
	self.Rooms[id] = {
		Id = id,
		Type = roomType,
		Floor = floor,
		Column = column,
		Span = span,
		Level = startLevel,
		HP = hp,
		MaxHP = hp,
	}
	for offset = 0, span - 1 do
		self.Cells[Grid.Key(floor, column + offset)] = id
	end
	return id, nil
end

function Bunker.CanRemove(self: Bunker, id: string): (boolean, string?)
	local room = self.Rooms[id]
	if not room then
		return false, `no room {tostring(id)}`
	elseif Config.Get("Rooms", room.Type).Fixed then
		return false, `the {Config.Get("Rooms", room.Type).Name} can't be torn down`
	end
	return true, nil
end

-- Tears a room down; its cells become Dug again.
function Bunker.Remove(self: Bunker, id: string): (boolean, string?)
	local ok, why = self:CanRemove(id)
	if not ok then
		return false, why
	end
	local room = self.Rooms[id]
	for offset = 0, room.Span - 1 do
		self.Cells[Grid.Key(room.Floor, room.Column + offset)] = ""
	end
	self.Rooms[id] = nil
	return true, nil
end

function Bunker.CanMerge(self: Bunker, a: string, b: string): (boolean, string?)
	local first, second = self.Rooms[a], self.Rooms[b]
	if not first or not second then
		return false, "no such room"
	elseif a == b then
		return false, "a room can't merge with itself"
	end
	local info = Config.Get("Rooms", first.Type)
	if first.Type ~= second.Type then
		return false, "only matching rooms merge"
	elseif info.Fixed then
		return false, `the {info.Name} can't be merged`
	elseif first.Floor ~= second.Floor
		or (first.Column + first.Span ~= second.Column and second.Column + second.Span ~= first.Column)
	then
		return false, "the rooms aren't side by side"
	elseif first.Level ~= second.Level then
		return false, "the rooms are at different levels"
	elseif first.Span + second.Span > info.MaxCells then
		return false, `{info.Name} takes at most {info.MaxCells} cells`
	end
	return true, nil
end

-- Merges two rooms into one (the left room's id survives). Returns that id.
function Bunker.Merge(self: Bunker, a: string, b: string): (string?, string?)
	local ok, why = self:CanMerge(a, b)
	if not ok then
		return nil, why
	end
	local left, right = self.Rooms[a], self.Rooms[b]
	if right.Column < left.Column then
		left, right = right, left
	end
	for offset = 0, right.Span - 1 do
		self.Cells[Grid.Key(right.Floor, right.Column + offset)] = left.Id
	end
	left.Span += right.Span
	left.HP += right.HP -- HP is per cell: each part keeps what it had
	left.MaxHP = maxHP(left.Level, left.Span)
	self.Rooms[right.Id] = nil
	return left.Id, nil
end

function Bunker.SetLevel(self: Bunker, id: string, level: number): (boolean, string?)
	local room = self.Rooms[id]
	if not room then
		return false, `no room {tostring(id)}`
	elseif level ~= 1 and level ~= 2 and level ~= 3 then
		return false, "levels go from 1 to 3"
	end
	local newMax = maxHP(level, room.Span)
	room.HP = math.floor(room.HP / room.MaxHP * newMax + 0.5)
	room.MaxHP = newMax
	room.Level = level
	return true, nil
end

-- Sets a room's HP (0 is Wrecked). Returns the HP it now has.
function Bunker.SetHP(self: Bunker, id: string, hp: number): number?
	local room = self.Rooms[id]
	if not room then
		return nil
	end
	room.HP = math.clamp(math.floor(hp + 0.5), 0, room.MaxHP)
	return room.HP
end

-- The room graph ------------------------------------------------------------------------

-- The graph node a cell belongs to: a room id, "D:<key>" for a Dug cell, nil for Rock.
function Bunker.UnitAt(self: Bunker, floor: number, column: number): string?
	local state, id = self:State(floor, column)
	if state == "Room" then
		return id
	elseif state == "Dug" then
		return DUG_PREFIX .. Grid.Key(floor, column)
	end
	return nil
end

-- The cells of a node, as { floor, column } pairs.
function Bunker.CellsOf(self: Bunker, unit: string): { { number } }
	if string.sub(unit, 1, #DUG_PREFIX) == DUG_PREFIX then
		local floor, column = Grid.Parse(string.sub(unit, #DUG_PREFIX + 1))
		if floor and column and self:State(floor, column) == "Dug" then
			return { { floor, column } }
		end
		return {}
	end
	local room = self.Rooms[unit]
	local cells = {}
	if room then
		for offset = 0, room.Span - 1 do
			table.insert(cells, { room.Floor, room.Column + offset })
		end
	end
	return cells
end

-- Every node: rooms oldest first, then Dug cells by key.
function Bunker.Units(self: Bunker): { string }
	local units = {}
	for _, room in self:AllRooms() do
		table.insert(units, room.Id)
	end
	local dug = {}
	for key, value in self.Cells do
		if value == "" then
			table.insert(dug, DUG_PREFIX .. key)
		end
	end
	table.sort(dug)
	table.move(dug, 1, #dug, #units + 1, units)
	return units
end

function Bunker.Neighbors(self: Bunker, unit: string): { string }
	local found: { [string]: boolean } = {}
	local list = {}
	local function add(other: string?)
		if other and other ~= unit and not found[other] then
			found[other] = true
			table.insert(list, other)
		end
	end
	for _, cell in self:CellsOf(unit) do
		local floor, column = cell[1], cell[2]
		add(self:UnitAt(floor, column - 1))
		add(self:UnitAt(floor, column + 1))
		if self:IsShaft(floor, column) then
			if self:IsShaft(floor - 1, column) then
				add(self:UnitAt(floor - 1, column))
			end
			if self:IsShaft(floor + 1, column) then
				add(self:UnitAt(floor + 1, column))
			end
		end
	end
	table.sort(list)
	return list
end

function Bunker.Graph(self: Bunker): { [string]: { string } }
	local graph = {}
	for _, unit in self:Units() do
		graph[unit] = self:Neighbors(unit)
	end
	return graph
end

-- Every node reachable from `from` (including it).
function Bunker.Reachable(self: Bunker, from: string): { [string]: boolean }
	local seen: { [string]: boolean } = { [from] = true }
	local queue = { from }
	local index = 1
	while index <= #queue do
		for _, other in self:Neighbors(queue[index]) do
			if not seen[other] then
				seen[other] = true
				table.insert(queue, other)
			end
		end
		index += 1
	end
	return seen
end

return Bunker
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000002F"><Properties><string name="Name">CameraRig</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.CameraRig: the over-the-shoulder camera's geometry (bible Section 9), shared so the
	CameraController and the data tests agree. Pure functions, no instances.

	Angles are radians. Yaw turns about +Y; pitch tilts the view up (+) or down (-). The rig
	looks along its -Z, so at yaw 0 the camera looks toward -Z and its right is +X. `side` is
	1 for the right shoulder and -1 for the left (values between blend a swap).
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

local CameraRig = {}

function CameraRig.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Camera")
end

-- The camera's rotation for a yaw and a pitch.
function CameraRig.Rotation(yaw: number, pitch: number): CFrame
	return CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

function CameraRig.ClampPitch(pitch: number): number
	local t = CameraRig.Tuning()
	return math.clamp(pitch, math.rad(t.PitchMin), math.rad(t.PitchMax))
end

-- The point the camera orbits: beside the pivot (the character's head height), on the
-- camera's side, turned with the yaw only so looking up or down never swings it.
function CameraRig.Focus(pivot: Vector3, yaw: number, side: number, shoulder: number, raise: number): Vector3
	return pivot + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(Vector3.new(side * shoulder, raise, 0))
end

-- Where the camera sits `distance` behind the focus.
function CameraRig.Position(focus: Vector3, yaw: number, pitch: number, distance: number): Vector3
	return focus - CameraRig.Rotation(yaw, pitch).LookVector * distance
end

-- A stick reading after a radial dead zone, with a squared response (0 to 1).
function CameraRig.Stick(input: Vector2, deadzone: number): Vector2
	local size = input.Magnitude
	if size <= deadzone or size == 0 then
		return Vector2.zero
	end
	local scaled = math.min((size - deadzone) / (1 - deadzone), 1)
	return input.Unit * scaled * scaled
end

-- The zoom range: the far end is capped indoors (in a bunker cell) so the camera stays in
-- the room.
function CameraRig.ZoomRange(indoors: boolean): (number, number)
	local t = CameraRig.Tuning()
	return t.Distance.Min, if indoors then math.min(t.Distance.Max, t.IndoorMax) else t.Distance.Max
end

-- The lowest and highest the camera may sit while its subject is in a bunker cell: above the
-- floor and under the ceiling panels. Nil outside the grid.
function CameraRig.CellHeights(pivot: Vector3): (number?, number?)
	local floor, column = Grid.CellAt(pivot)
	if not floor or not column then
		return nil, nil
	end
	local t = CameraRig.Tuning()
	local y = Grid.CellPosition(floor, column).Y
	return y + t.FloorMargin, y + Grid.Tuning().CellHeight - t.CeilingMargin
end

-- The farthest the camera can go back along its view from `focus` and stay between `low` and
-- `high` (it slides in along the view rather than leaving the aim point).
function CameraRig.HeightLimit(focus: Vector3, look: Vector3, low: number, high: number): number
	local limit = math.huge
	if look.Y < -1e-3 then -- looking down: the camera is above the focus
		limit = math.max(0, (high - focus.Y) / -look.Y)
	elseif look.Y > 1e-3 then -- looking up: the camera is below the focus
		limit = math.max(0, (focus.Y - low) / look.Y)
	end
	return limit
end

-- Eases `current` toward `target` at `rate` per second, frame-rate independent.
function CameraRig.Approach(current: number, target: number, rate: number, dt: number): number
	return target + (current - target) * math.exp(-rate * dt)
end

-- Moves `current` toward `target` by at most `step`.
function CameraRig.MoveToward(current: number, target: number, step: number): number
	if current < target then
		return math.min(current + step, target)
	end
	return math.max(current - step, target)
end

return table.freeze(CameraRig)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000030"><Properties><string name="Name">Clock</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Clock: the century's arithmetic (bible Section 5). Pure functions over a State
	table, so CycleClock, the client and the data tests share one copy. CycleClock owns the
	timers; these functions only decide numbers and kinds.

	* A cycle is a day phase, then a Surge. At the end of each cycle the year counter jumps by
	  Years per Cycle: Tuning.Clock.YearsPerCycleStart (1) plus the YearsPerCycle of every
	  objective done (Config.Objectives: each Lost Crew rescued +2, each era boss beaten +1),
	  at most Tuning.Clock.YearsPerCycleMax (12).
	* When the counter reaches or passes the last year of era I, II or III (25, 50, 75), the
	  next Surge is that era's boss, unless it is already beaten. The boss Surge comes once.
	* When the counter reaches Tuning.Clock.FinalYear (100) it stops there, and the next
	  Surge is the final one (the Source rises into the bunker).
	* A boss Surge (an era boss, or the final Surge's Source) has no timer: it lasts until
	  its boss is beaten (Landon, Nov 8, 2026). Other Surges end on the timer, or earlier when
	  cleared.
	* The first cycle's Surge is a small tutorial wave.
	* Endless (Keep Going after a victory): no cap, no era bosses, every Surge an Endless one.

	In cycle order:
		local state = Clock.NewState()               -- Cycle 1, Year 1
		local coming = Clock.SurgeKind(state)        -- during the day: what the Surge will be
		local kind, boss = Clock.StartSurge(state)   -- the Surge begins (uses up a due boss)
		local before, due = Clock.EndCycle(state)    -- Year += Years per Cycle, Cycle += 1
]]

local Config = require(script.Parent.Parent.Config)

export type SurgeKind = "Tutorial" | "Normal" | "Boss" | "Final" | "Endless"

export type State = {
	Cycle: number, -- from 1
	Year: number, -- from 1
	Completed: { [string]: boolean }, -- objective ids done (Config.Objectives)
	PendingBoss: string?, -- an era boss due at the next Surge (Config.Bosses)
	Endless: boolean,
}

local Clock = {}

function Clock.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Clock")
end

function Clock.NewState(): State
	return { Cycle = 1, Year = 1, Completed = {}, PendingBoss = nil, Endless = false }
end

-- Years per Cycle when these objectives are done.
function Clock.YearsPerCycle(completed: { [string]: boolean }): number
	local tuning = Clock.Tuning()
	local years = tuning.YearsPerCycleStart
	for id, done in completed do
		local objective = Config.Find("Objectives", id)
		if done and objective then
			years += objective.YearsPerCycle
		end
	end
	return math.min(years, tuning.YearsPerCycleMax)
end

-- Has this era boss been beaten (its objective done)?
function Clock.BossBeaten(completed: { [string]: boolean }, bossId: string): boolean
	for _, objective in Config.All("Objectives") do
		if objective.Kind == "Boss" and objective.Boss == bossId and completed[objective.Id] then
			return true
		end
	end
	return false
end

-- The era a year belongs to; past Year 100 (Endless), the last era.
function Clock.EraOf(year: number): string
	local eras = Config.All("Eras")
	for _, era in eras do
		if year <= era.Years.To then
			return era.Id
		end
	end
	return eras[#eras].Id
end

-- The boss of the final Surge: the boss of the era that ends in the final year.
function Clock.FinalBoss(): string?
	local finalYear = Clock.Tuning().FinalYear
	for _, era in Config.All("Eras") do
		if era.Years.To == finalYear then
			return era.Boss
		end
	end
	return nil
end

-- What the coming Surge is, and its boss (an era boss, or the final boss).
function Clock.SurgeKind(state: State): (SurgeKind, string?)
	local tuning = Clock.Tuning()
	if state.Endless then
		return "Endless", nil
	elseif state.PendingBoss ~= nil then
		return "Boss", state.PendingBoss
	elseif state.Year >= tuning.FinalYear then
		return "Final", Clock.FinalBoss()
	elseif state.Cycle == 1 and tuning.TutorialFirstSurge then
		return "Tutorial", nil
	end
	return "Normal", nil
end

-- Does a Surge of this kind run until its boss is beaten, with no timer?
function Clock.IsOpenEnded(kind: SurgeKind): boolean
	return kind == "Boss" or kind == "Final"
end

-- The Surge begins: its kind and boss. A due era boss is used up (its Surge comes once).
function Clock.StartSurge(state: State): (SurgeKind, string?)
	local kind, boss = Clock.SurgeKind(state)
	if kind == "Boss" then
		state.PendingBoss = nil
	end
	return kind, boss
end

--[[
	The end of a cycle: the year counter jumps by Years per Cycle (stopping at the final year
	outside Endless) and the cycle number goes up. Returns the year before the jump, and the
	era boss that became due because the jump reached or passed the end of its era.
]]
function Clock.EndCycle(state: State): (number, string?)
	local tuning = Clock.Tuning()
	local before = state.Year
	local after = before + Clock.YearsPerCycle(state.Completed)
	if not state.Endless then
		after = math.min(after, tuning.FinalYear)
	end
	state.Year = after
	state.Cycle += 1
	if state.Endless then
		return before, nil
	end
	local due: string? = nil
	for _, era in Config.All("Eras") do
		local last = era.Years.To
		if last < tuning.FinalYear and before < last and after >= last and not Clock.BossBeaten(state.Completed, era.Boss) then
			due = era.Boss
		end
	end
	if due then
		state.PendingBoss = due
	end
	return before, due
end

return table.freeze(Clock)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000031"><Properties><string name="Name">Grid</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Grid: the bunker grid's geometry (bible Section 6), shared so BunkerGrid, the
	Command View (Prompt 7) and the data tests agree on where every cell is.

	* Columns Tuning.Grid.ColumnMin..ColumnMax (-6 to 6), left to right as seen from the
	  front; floors 1 to 10, where the floor number is the depth. Floor 10 is the Source
	  Chamber.
	* A cell is 32 wide, 16 tall and 32 deep inside. Walls are WallThickness (1) on each side
	  and slabs SlabThickness (2) between floors, so cells repeat every 34 studs across and
	  18 down.
	* In the world, Tuning.Grid.Origin is the interior floor centre of floor 1, column 0.
	  Columns grow along +X, floors go down -Y, and the front (the Command View camera's
	  side) faces +Z. Models from the art pipeline face -Z, so CellCFrame turns them half a
	  turn.
]]

local Config = require(script.Parent.Parent.Config)

local Grid = {}

function Grid.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Grid")
end

-- "floor,column", the key cells go by everywhere (collections, models, the delta channel).
function Grid.Key(floor: number, column: number): string
	return `{floor},{column}`
end

function Grid.Parse(key: string): (number?, number?)
	local floor, column = string.match(key, "^(%-?%d+),(%-?%d+)$")
	if not floor then
		return nil, nil
	end
	return tonumber(floor), tonumber(column)
end

function Grid.OnGrid(floor: number, column: number): boolean
	local t = Grid.Tuning()
	return floor == math.floor(floor)
		and column == math.floor(column)
		and floor >= t.FloorMin
		and floor <= t.FloorMax
		and column >= t.ColumnMin
		and column <= t.ColumnMax
end

-- How far apart cells are: across (X), down (Y), and a cell's full depth (Z).
function Grid.Pitch(): Vector3
	local t = Grid.Tuning()
	return Vector3.new(t.CellWidth + 2 * t.WallThickness, t.CellHeight + t.SlabThickness, t.CellDepth + 2 * t.WallThickness)
end

-- The centre of a cell's interior floor, in the world.
function Grid.CellPosition(floor: number, column: number): Vector3
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	return Vector3.new(t.Origin.X + column * pitch.X, t.Origin.Y - (floor - 1) * pitch.Y, t.Origin.Z)
end

-- A cell's interior floor centre, turned so a model that faces -Z faces the front (+Z).
function Grid.CellCFrame(floor: number, column: number): CFrame
	return CFrame.new(Grid.CellPosition(floor, column)) * CFrame.Angles(0, math.pi, 0)
end

-- The cell a world position is in (its interior, or the slab under it), or nil off the grid.
function Grid.CellAt(position: Vector3): (number?, number?)
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local floor = math.floor((t.Origin.Y + t.CellHeight - position.Y) / pitch.Y) + 1
	local column = math.floor((position.X - t.Origin.X) / pitch.X + 0.5)
	if math.abs(position.Z - t.Origin.Z) > pitch.Z / 2 or not Grid.OnGrid(floor, column) then
		return nil, nil
	end
	return floor, column
end

-- The depth band a floor is in (Config.DepthBands).
function Grid.BandOf(floor: number): { [string]: any }
	for _, band in Config.All("DepthBands") do
		if floor >= band.Floors.From and floor <= band.Floors.To then
			return band
		end
	end
	error(`Rules.Grid: no depth band holds floor {floor}`)
end

-- The first floor of a band below the first one (4, 7, 10): opening it needs Push Deeper.
function Grid.IsBandStart(floor: number): boolean
	local band = Grid.BandOf(floor)
	return band.Floors.From == floor and floor > Grid.Tuning().FloorMin
end

-- Can rooms be built on this floor? (Not in the Source Chamber.)
function Grid.Buildable(floor: number): boolean
	return Grid.BandOf(floor).Buildable == true
end

return table.freeze(Grid)
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX00000032"><Properties><string name="Name">RunState</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RunState: the run's small values, replicated as attributes on this ModuleScript (bible
	Section 23: small values such as the year and the cycle phase replicate as attributes;
	collections go through the delta channel).

	One list of names, types, meanings and owners, like Remotes for events. Each value has
	one writer: the service that owns it gets a setter with RunState.Writer("CycleClock") and
	can only set its own values. Anything on either side reads with RunState.Get and
	RunState.Changed. In the Lobby nothing is set.

	Times are server time (workspace:GetServerTimeNow()), so every client counts down to the
	same moment; RunState.TimeLeft() does the sum.

	Players also carry two attributes the clock reads for skips (CycleClock writes them):
	Ready (pressed Ready this day) and Resting (lying in a Quarters bed).
]]

local RunService = game:GetService("RunService")

export type RunPhase = "Waiting" | "Intro" | "Playing" | "Ended"
export type CyclePhase = "Day" | "Surge"
export type Outcome = "CenturyVictory" | "DeepVictory" | "Defeat"
export type Writer = "RunDirector" | "CycleClock" | "ObjectiveService"

type Field = {
	Type: "string" | "number" | "boolean",
	By: Writer,
	Values: { string }?,
	Doc: string,
}

local FIELDS: { [string]: Field } = {
	-- RunDirector: the run's lifecycle
	RunPhase = { Type = "string", By = "RunDirector", Values = { "Waiting", "Intro", "Playing", "Ended" }, Doc = "where the run is" },
	IntroEndsAt = { Type = "number", By = "RunDirector", Doc = "server time the intro ends and the run clock starts (Intro only)" },
	Difficulty = { Type = "string", By = "RunDirector", Doc = "Normal, Hard or Nightmare (Config.Difficulties)" },
	Outcome = { Type = "string", By = "RunDirector", Values = { "CenturyVictory", "DeepVictory", "Defeat" }, Doc = "how the run ended (Ended only)" },
	DefeatReason = { Type = "string", By = "RunDirector", Values = { "ReactorDestroyed", "ResidentsLost" }, Doc = "why the bunker fell (Defeat only)" },
	Victory = { Type = "string", By = "RunDirector", Values = { "Century", "Deep" }, Doc = "the victory this run won; kept through Endless" },
	Endless = { Type = "boolean", By = "RunDirector", Doc = "Keep Going passed: the run carries on past Year 100 with stronger Surges" },

	-- CycleClock: cycles, phases and the year counter
	Cycle = { Type = "number", By = "CycleClock", Doc = "the cycle number, from 1" },
	Year = { Type = "number", By = "CycleClock", Doc = "the year counter, from 1" },
	Era = { Type = "string", By = "CycleClock", Doc = "the era the year is in (Config.Eras)" },
	YearsPerCycle = { Type = "number", By = "CycleClock", Doc = "how far the year jumps at the end of this cycle" },
	CyclePhase = { Type = "string", By = "CycleClock", Values = { "Day", "Surge" }, Doc = "the phase of the cycle (from the first day on)" },
	PhaseLength = { Type = "number", By = "CycleClock", Doc = "seconds the current phase lasts in all" },
	PhaseEndsAt = { Type = "number", By = "CycleClock", Doc = "server time the phase ends; nil while the clock is stopped or the phase has no timer" },
	PhaseLeft = { Type = "number", By = "CycleClock", Doc = "seconds left, only while the clock is stopped" },
	PhaseOpen = { Type = "boolean", By = "CycleClock", Doc = "the phase has no timer: a boss Surge lasts until its boss is beaten" },
	Siren = { Type = "boolean", By = "CycleClock", Doc = "the Surge siren is sounding: the last 20 seconds of a day" },
	SurgeKind = { Type = "string", By = "CycleClock", Values = { "Tutorial", "Normal", "Boss", "Final", "Endless" }, Doc = "the coming Surge (during a day) or the current one" },
	SurgeBoss = { Type = "string", By = "CycleClock", Doc = "the boss of a Boss or Final Surge (Config.Bosses)" },
	ReadyCount = { Type = "number", By = "CycleClock", Doc = "players ready to skip: Ready pressed, or resting in a Quarters bed" },
	ReadyNeeded = { Type = "number", By = "CycleClock", Doc = "players in the run; when all are ready, the day skips to the siren" },
	Paused = { Type = "boolean", By = "CycleClock", Doc = "DevTools paused the clock" },
	TimeScale = { Type = "number", By = "CycleClock", Doc = "DevTools time scale (nil means 1)" },

	-- ObjectiveService: what makes more years pass per cycle
	LostCrews = { Type = "number", By = "ObjectiveService", Doc = "Lost Crews rescued" },
	BossesBeaten = { Type = "number", By = "ObjectiveService", Doc = "era bosses beaten" },
}

for name, field in FIELDS do
	local values = field.Values
	if values then
		table.freeze(values)
	end
	table.freeze(field)
	assert(string.find(name, "^%u%w*$"), `RunState: {name} must be PascalCase`)
end
table.freeze(FIELDS)

local IS_SERVER = RunService:IsServer()

local RunState = {}

RunState.Fields = FIELDS

-- Is `value` allowed for `name`? (nil always is: it clears the value.)
function RunState.Check(name: string, value: any): (boolean, string?)
	local field = FIELDS[name]
	if not field then
		return false, `no RunState value {tostring(name)}`
	end
	if value == nil then
		return true
	end
	if type(value) ~= field.Type then
		return false, `{name} is a {field.Type}, got a {typeof(value)}`
	end
	if field.Type == "number" and (value ~= value or math.abs(value) == math.huge) then
		return false, `{name} must be a finite number`
	end
	if field.Values and not table.find(field.Values, value) then
		return false, `{name} can't be {tostring(value)}`
	end
	return true
end

-- Server: a setter for the values `writer` owns. Setting anything else is an error.
function RunState.Writer(writer: Writer): (name: string, value: any) -> ()
	return function(name: string, value: any)
		local field = FIELDS[name]
		if not field then
			error(`RunState: no value {tostring(name)}`, 2)
		end
		if field.By ~= writer then
			error(`RunState: {name} belongs to {field.By}, not {writer}`, 2)
		end
		local ok, why = RunState.Check(name, value)
		if not ok then
			error(`RunState: {why}`, 2)
		end
		if not IS_SERVER then
			error("RunState: values are set on the server", 2)
		end
		script:SetAttribute(name, value)
	end
end

function RunState.Get(name: string): any
	assert(FIELDS[name], `RunState: no value {tostring(name)}`)
	return script:GetAttribute(name)
end

function RunState.Changed(name: string): RBXScriptSignal
	assert(FIELDS[name], `RunState: no value {tostring(name)}`)
	return script:GetAttributeChangedSignal(name)
end

-- Every value that is set.
function RunState.All(): { [string]: any }
	local values = {}
	for name in FIELDS do
		values[name] = script:GetAttribute(name)
	end
	return values
end

-- Seconds left in the intro or the current cycle phase (nil when nothing is counting down).
function RunState.TimeLeft(): number?
	if script:GetAttribute("RunPhase") == "Intro" then
		local introEndsAt = script:GetAttribute("IntroEndsAt")
		if type(introEndsAt) == "number" then
			return math.max(0, introEndsAt - workspace:GetServerTimeNow())
		end
		return nil
	end
	local endsAt = script:GetAttribute("PhaseEndsAt")
	if type(endsAt) == "number" then
		return math.max(0, endsAt - workspace:GetServerTimeNow())
	end
	local left = script:GetAttribute("PhaseLeft")
	return if type(left) == "number" then left else nil
end

return table.freeze(RunState)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000033"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Types: definitions that cross module or network boundaries.

	Require this module for its types only (`local Types = require(Shared.Types)`, then
	`Types.Module`). Content entry types arrive with Prompt 1 (Config schemas).
]]

export type PlaceKind = "Lobby" | "Run"

-- The registry a service or controller receives in Init: only its declared dependencies
-- can be read from it (Loader enforces this).
export type Registry = { [string]: any }

-- A service (server) or controller (client). Every ModuleScript in Services/ or
-- Controllers/ returns one of these, with Name equal to the ModuleScript's name.
export type Module = {
	Name: string,
	Dependencies: { string }?,
	Init: ((self: any, registry: Registry) -> ())?,
	Start: ((self: any) -> ())?,
	[string]: any,
}

-- One change on the delta channel: { op, collection, key, value } (see Utilities.Delta).
export type DeltaOp = { any }

-- A DevTools command (DevService:Register).
export type DevCommand = {
	Description: string,
	Usage: string?,
	Run: (player: Player?, args: { any }) -> string?,
}

return {}
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX0000003C"><Properties><string name="Name">Utilities</string></Properties><Item class="ModuleScript" referent="RBX00000035"><Properties><string name="Name">Check</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Check: runtime validators for anything that crosses a trust boundary (remote arguments)
	or comes from data (Config entries).

	A checker is a function `(value) -> (ok, why?)`:

		local shape = Check.shape({
			Name = Check.string(40),
			Cost = Check.number({ min = 0, integer = true }),
			Tags = Check.optional(Check.array(Check.string(20), 8)),
		})
		local ok, why = shape(value)   -- why = "Cost: expected an integer, got 2.5"

	Numbers are always finite (NaN and infinity fail), strings are valid UTF-8, arrays have
	no holes, and shapes reject unknown fields unless `{ open = true }`.
]]

export type Checker = (value: any) -> (boolean, string?)

local Check = {}

-- The Config aggregator collects references while it validates (see Check.ref).
local refSink: ((typeName: string, id: string) -> ())? = nil

local function describe(value: any): string
	local kind = typeof(value)
	if kind == "string" then
		return if #value > 24 then `a string of {#value} bytes` else `"{value}"`
	elseif kind == "number" then
		return tostring(value)
	elseif kind == "nil" then
		return "nothing"
	end
	return `a {kind}`
end

local function isFinite(value: any): boolean
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

export type NumberOptions = { min: number?, max: number?, integer: boolean? }

function Check.number(options: NumberOptions?): Checker
	local min = options and options.min
	local max = options and options.max
	local integer = options and options.integer
	return function(value: any): (boolean, string?)
		if not isFinite(value) then
			return false, `expected a number, got {describe(value)}`
		end
		if integer and value % 1 ~= 0 then
			return false, `expected an integer, got {value}`
		end
		if min and value < min then
			return false, `{value} is below the minimum {min}`
		end
		if max and value > max then
			return false, `{value} is above the maximum {max}`
		end
		return true
	end
end

function Check.integer(min: number?, max: number?): Checker
	return Check.number({ min = min, max = max, integer = true })
end

export type StringOptions = { pattern: string?, min: number? }

function Check.string(maxLength: number, options: StringOptions?): Checker
	local pattern = options and options.pattern
	local minLength = options and options.min or 0
	return function(value: any): (boolean, string?)
		if type(value) ~= "string" then
			return false, `expected a string, got {describe(value)}`
		end
		if #value > maxLength then
			return false, `string longer than {maxLength} bytes`
		end
		if #value < minLength then
			return false, `string shorter than {minLength} bytes`
		end
		if utf8.len(value) == nil then
			return false, "string is not valid UTF-8"
		end
		if pattern and not string.find(value, pattern) then
			return false, `"{value}" doesn't match {pattern}`
		end
		return true
	end
end

function Check.boolean(): Checker
	return function(value: any): (boolean, string?)
		if type(value) ~= "boolean" then
			return false, `expected true or false, got {describe(value)}`
		end
		return true
	end
end

-- One of the given values (strings, numbers or booleans).
function Check.literal(...: any): Checker
	local allowed = {}
	local names = {}
	for _, item in { ... } do
		allowed[item] = true
		table.insert(names, tostring(item))
	end
	local list = table.concat(names, ", ")
	return function(value: any): (boolean, string?)
		if value == nil or not allowed[value] then
			return false, `expected one of {list}, got {describe(value)}`
		end
		return true
	end
end

function Check.enum(values: { string }): Checker
	return Check.literal(table.unpack(values))
end

function Check.optional(check: Checker): Checker
	return function(value: any): (boolean, string?)
		if value == nil then
			return true
		end
		return check(value)
	end
end

-- Passes if any of the checkers passes.
function Check.union(...: Checker): Checker
	local checks = { ... }
	return function(value: any): (boolean, string?)
		local reasons = {}
		for _, check in checks do
			local ok, why = check(value)
			if ok then
				return true
			end
			table.insert(reasons, why or "?")
		end
		return false, table.concat(reasons, "; or ")
	end
end

-- A sequence 1..n with no holes and no other keys.
function Check.array(check: Checker, maxLength: number): Checker
	return function(value: any): (boolean, string?)
		if type(value) ~= "table" then
			return false, `expected a list, got {describe(value)}`
		end
		local count = 0
		for key in value do
			if type(key) ~= "number" or key % 1 ~= 0 or key < 1 then
				return false, "list has a key that isn't an index"
			end
			count += 1
		end
		if count ~= #value then
			return false, "list has holes"
		end
		if count > maxLength then
			return false, `list longer than {maxLength}`
		end
		for index, item in ipairs(value) do
			local ok, why = check(item)
			if not ok then
				return false, `[{index}]: {why}`
			end
		end
		return true
	end
end

-- A dictionary whose keys and values pass the checkers.
function Check.map(keyCheck: Checker, valueCheck: Checker, maxCount: number): Checker
	return function(value: any): (boolean, string?)
		if type(value) ~= "table" then
			return false, `expected a table, got {describe(value)}`
		end
		local count = 0
		for key, item in value do
			count += 1
			if count > maxCount then
				return false, `more than {maxCount} entries`
			end
			local ok, why = keyCheck(key)
			if not ok then
				return false, `key {describe(key)}: {why}`
			end
			ok, why = valueCheck(item)
			if not ok then
				return false, `{tostring(key)}: {why}`
			end
		end
		return true
	end
end

export type ShapeOptions = { open: boolean? }

-- A table with these fields. Unknown fields fail unless `open`.
function Check.shape(fields: { [string]: Checker }, options: ShapeOptions?): Checker
	local open = options and options.open
	local names = {}
	for name in fields do
		table.insert(names, name)
	end
	table.sort(names)
	return function(value: any): (boolean, string?)
		if type(value) ~= "table" then
			return false, `expected a table, got {describe(value)}`
		end
		for _, name in names do
			local ok, why = fields[name](value[name])
			if not ok then
				return false, `{name}: {why}`
			end
		end
		if not open then
			for key in value do
				if type(key) ~= "string" or fields[key] == nil then
					return false, `unknown field {describe(key)}`
				end
			end
		end
		return true
	end
end

function Check.vector3(maxMagnitude: number?): Checker
	return function(value: any): (boolean, string?)
		if typeof(value) ~= "Vector3" then
			return false, `expected a Vector3, got {describe(value)}`
		end
		if not (isFinite(value.X) and isFinite(value.Y) and isFinite(value.Z)) then
			return false, "Vector3 isn't finite"
		end
		if maxMagnitude and value.Magnitude > maxMagnitude then
			return false, `Vector3 longer than {maxMagnitude}`
		end
		return true
	end
end

function Check.cframe(): Checker
	return function(value: any): (boolean, string?)
		if typeof(value) ~= "CFrame" then
			return false, `expected a CFrame, got {describe(value)}`
		end
		for _, component in { value:GetComponents() } do
			if not isFinite(component) then
				return false, "CFrame isn't finite"
			end
		end
		return true
	end
end

function Check.color3(): Checker
	return function(value: any): (boolean, string?)
		if typeof(value) ~= "Color3" then
			return false, `expected a Color3, got {describe(value)}`
		end
		return true
	end
end

-- An Instance, optionally of a class (IsA). Remote arguments can't be trusted to still
-- exist or to be where the client says: services check ownership themselves.
function Check.instance(className: string?): Checker
	return function(value: any): (boolean, string?)
		if typeof(value) ~= "Instance" then
			return false, `expected an Instance, got {describe(value)}`
		end
		if className and not value:IsA(className) then
			return false, `expected a {className}, got a {value.ClassName}`
		end
		return true
	end
end

-- A string, finite number or boolean (DevTools arguments).
function Check.primitive(maxStringLength: number): Checker
	local text = Check.string(maxStringLength)
	return function(value: any): (boolean, string?)
		local kind = type(value)
		if kind == "boolean" then
			return true
		elseif kind == "number" then
			if isFinite(value) then
				return true
			end
			return false, "number isn't finite"
		elseif kind == "string" then
			return text(value)
		end
		return false, `expected text, a number or true/false, got {describe(value)}`
	end
end

-- Anything at all: only for data the server itself produces.
function Check.any(): Checker
	return function(_value: any): (boolean, string?)
		return true
	end
end

--[[
	The id of an entry of another Config type, e.g. `Check.ref("Weapons")`. It checks the
	value is an id-shaped string; the Config aggregator then checks that the entry exists,
	once every type has loaded.
]]
function Check.ref(typeName: string): Checker
	local idCheck = Check.string(64, { pattern = "^[%a][%w_]*$" })
	return function(value: any): (boolean, string?)
		local ok, why = idCheck(value)
		if not ok then
			return false, `{typeName} id: {why}`
		end
		local sink = refSink
		if sink then
			sink(typeName, value)
		end
		return true
	end
end

-- Used by the Config aggregator only.
function Check._setRefSink(sink: ((typeName: string, id: string) -> ())?)
	refSink = sink
end

return table.freeze(Check)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000036"><Properties><string name="Name">Delta</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Delta: the wire format and the pure logic of the delta channel (bible Section 23:
	"collections (rooms, residents, votes) go through one delta channel").

	The server keeps named collections of keyed values (ReplicationService); clients keep a
	mirror (ReplicaController). Changes travel as ops, batched into one Delta event per
	flush:

		{ Delta.SET,    "Rooms", "R12", { Kind = "Kitchen", Level = 1 } }
		{ Delta.PATCH,  "Rooms", "R12", { Level = 2, Damaged = Delta.NONE } }  -- NONE clears a field
		{ Delta.REMOVE, "Rooms", "R12" }
		{ Delta.CLEAR,  "Rooms" }

	Values must survive a RemoteEvent: nil, booleans, finite numbers, strings, Vector3,
	CFrame, Color3, and tables that are either a list 1..n or a dictionary with string keys
	(Roblox drops data from mixed or sparse tables). IsRemoteSafe checks this.
]]

local TableUtil = require(script.Parent.TableUtil)

local Delta = {}

Delta.SET = 1
Delta.PATCH = 2
Delta.REMOVE = 3
Delta.CLEAR = 4

-- In a patch, this value removes the field.
Delta.NONE = "\0none"

export type Op = { any }
export type Store = { [string]: { [string]: any } }
export type Change = {
	Collection: string,
	Key: string?, -- nil when a whole collection was cleared
	Value: any, -- the new value (nil when removed)
	Old: any, -- the previous value
}

local SAFE_TYPES = {
	boolean = true,
	string = true,
	Vector3 = true,
	CFrame = true,
	Color3 = true,
	EnumItem = true,
}

local function remoteSafe(value: any, depth: number, path: string): (boolean, string?)
	local kind = typeof(value)
	if kind == "nil" or SAFE_TYPES[kind] then
		return true
	elseif kind == "number" then
		if value ~= value or value == math.huge or value == -math.huge then
			return false, `{path}: number isn't finite`
		end
		return true
	elseif kind ~= "table" then
		return false, `{path}: a {kind} can't be replicated`
	end
	if depth > 16 then
		return false, `{path}: nested too deep`
	end
	local count = 0
	local stringKeys = 0
	for key, item in value do
		count += 1
		if type(key) == "string" then
			stringKeys += 1
		elseif type(key) ~= "number" or key % 1 ~= 0 or key < 1 then
			return false, `{path}: key {tostring(key)} must be a string or a list index`
		end
		local ok, why = remoteSafe(item, depth + 1, `{path}.{tostring(key)}`)
		if not ok then
			return false, why
		end
	end
	if stringKeys > 0 and stringKeys < count then
		return false, `{path}: mixes list items and named fields`
	end
	if stringKeys == 0 and count ~= #value then
		return false, `{path}: list has holes`
	end
	return true
end

function Delta.IsRemoteSafe(value: any): (boolean, string?)
	return remoteSafe(value, 0, "value")
end

--[[
	The fields of `new` that differ from `old`, with NONE for fields `old` had and `new`
	doesn't. Nil when nothing changed. Both must be string-keyed tables.
]]
function Delta.Diff(old: { [string]: any }, new: { [string]: any }): { [string]: any }?
	local patch: { [string]: any } = {}
	local changed = false
	for field, value in new do
		if not TableUtil.DeepEqual(old[field], value) then
			patch[field] = value
			changed = true
		end
	end
	for field in old do
		if new[field] == nil then
			patch[field] = Delta.NONE
			changed = true
		end
	end
	return if changed then patch else nil
end

-- `value` with `patch` applied, as a new table (the old one is left untouched).
function Delta.Merge(value: { [string]: any }, patch: { [string]: any }): { [string]: any }
	local merged = table.clone(value)
	for field, item in patch do
		if item == Delta.NONE then
			merged[field] = nil
		else
			merged[field] = item
		end
	end
	return merged
end

--[[
	Applies ops to a mirror and returns what changed. Applied values are frozen, so readers
	can hold on to them; a patch makes a new table instead of editing the old one.
]]
function Delta.Apply(store: Store, ops: { Op }): { Change }
	local changes: { Change } = {}
	for _, op in ops do
		local code, collectionName, key, value = op[1], op[2], op[3], op[4]
		if type(collectionName) ~= "string" then
			continue
		end
		local collection = store[collectionName]
		if not collection then
			collection = {}
			store[collectionName] = collection
		end
		if code == Delta.SET and type(key) == "string" then
			local old = collection[key]
			local new = TableUtil.DeepFreeze(value)
			collection[key] = new
			table.insert(changes, { Collection = collectionName, Key = key, Value = new, Old = old })
		elseif code == Delta.PATCH and type(key) == "string" and type(value) == "table" then
			local old = collection[key]
			local base = if type(old) == "table" then old else {}
			local new = TableUtil.DeepFreeze(Delta.Merge(base, value))
			collection[key] = new
			table.insert(changes, { Collection = collectionName, Key = key, Value = new, Old = old })
		elseif code == Delta.REMOVE and type(key) == "string" then
			local old = collection[key]
			if old ~= nil then
				collection[key] = nil
				table.insert(changes, { Collection = collectionName, Key = key, Value = nil, Old = old })
			end
		elseif code == Delta.CLEAR then
			if next(collection) ~= nil then
				store[collectionName] = {}
				table.insert(changes, { Collection = collectionName, Key = nil, Value = nil, Old = collection })
			end
		end
	end
	return changes
end

return table.freeze(Delta)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000037"><Properties><string name="Name">Loader</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Loader: the declared-dependency lifecycle both bootstraps use (bible Section 23).

	Every ModuleScript in a folder returns a module table:

		local BunkerGrid = {
			Name = "BunkerGrid",                       -- must match the ModuleScript
			Dependencies = { "CycleClock", "DevService" },
		}
		function BunkerGrid:Init(registry)          -- wire up; don't start loops here
			self.Clock = registry.CycleClock         -- only declared dependencies resolve
		end
		function BunkerGrid:Start()                  -- runs once every Init has finished
		end
		return BunkerGrid

	Run orders modules so dependencies come first (ties alphabetical, so the order never
	changes between runs), calls every Init in that order, then starts every Start on its
	own thread. A module whose Init fails is reported, and anything depending on it is
	skipped rather than started half-wired.
]]

local Log = require(script.Parent.Log)

export type Module = {
	Name: string,
	Dependencies: { string }?,
	Init: ((self: any, registry: { [string]: any }) -> ())?,
	Start: ((self: any) -> ())?,
	[string]: any,
}

export type Report = {
	Order: { string },
	Failed: { [string]: string },
	Skipped: { [string]: string },
	InitMs: { [string]: number },
}

local SLOW_INIT_SECONDS = 0.5

local Loader = {}

-- Requires every ModuleScript directly inside `folder` and checks its shape.
function Loader.Collect(folder: Instance, kind: string): { [string]: Module }
	local modules: { [string]: Module } = {}
	for _, child in folder:GetChildren() do
		if not child:IsA("ModuleScript") then
			continue
		end
		local ok, result = pcall(require, child)
		if not ok then
			error(`{kind} {child.Name} failed to load: {result}`, 0)
		end
		if type(result) ~= "table" then
			error(`{kind} {child.Name} must return a table`, 0)
		end
		local module = result :: Module
		if module.Name ~= child.Name then
			error(`{kind} {child.Name} must have Name = "{child.Name}" (has {tostring(module.Name)})`, 0)
		end
		if module.Dependencies ~= nil then
			if type(module.Dependencies) ~= "table" then
				error(`{kind} {child.Name}: Dependencies must be a list of names`, 0)
			end
			for _, dependency in module.Dependencies :: { any } do
				if type(dependency) ~= "string" then
					error(`{kind} {child.Name}: Dependencies must be a list of names`, 0)
				end
			end
		end
		for _, method in { "Init", "Start" } do
			local value = module[method]
			if value ~= nil and type(value) ~= "function" then
				error(`{kind} {child.Name}: {method} must be a function`, 0)
			end
		end
		modules[child.Name] = module
	end
	return modules
end

-- Dependency order, or nil and the reason (a missing dependency or a cycle).
function Loader.Order(modules: { [string]: Module }): ({ string }?, string?)
	local names = {}
	for name in modules do
		table.insert(names, name)
	end
	table.sort(names)

	local waitingOn: { [string]: number } = {}
	local dependents: { [string]: { string } } = {}
	for _, name in names do
		waitingOn[name] = 0
		dependents[name] = {}
	end
	for _, name in names do
		for _, dependency in modules[name].Dependencies or {} do
			if modules[dependency] == nil then
				return nil, `{name} depends on {dependency}, which doesn't exist`
			end
			if dependency == name then
				return nil, `{name} depends on itself`
			end
			waitingOn[name] += 1
			table.insert(dependents[dependency], name)
		end
	end

	local ready = {}
	for _, name in names do
		if waitingOn[name] == 0 then
			table.insert(ready, name)
		end
	end
	local order = {}
	while #ready > 0 do
		table.sort(ready)
		local name = table.remove(ready, 1) :: string
		table.insert(order, name)
		for _, dependent in dependents[name] do
			waitingOn[dependent] -= 1
			if waitingOn[dependent] == 0 then
				table.insert(ready, dependent)
			end
		end
	end
	if #order == #names then
		return order, nil
	end

	-- Name a cycle: walk dependencies from any module still waiting until one repeats.
	local start: string? = nil
	for _, name in names do
		if waitingOn[name] > 0 then
			start = name
			break
		end
	end
	local path = {}
	local seen: { [string]: number } = {}
	local current = start :: string
	while seen[current] == nil do
		seen[current] = #path + 1
		table.insert(path, current)
		for _, dependency in modules[current].Dependencies or {} do
			if waitingOn[dependency] > 0 then
				current = dependency
				break
			end
		end
	end
	local cycle = table.move(path, seen[current], #path, 1, {})
	table.insert(cycle, current)
	return nil, `dependency cycle: {table.concat(cycle, " -> ")}`
end

-- A view of the modules that only resolves the ones `module` declared.
local function registryFor(module: Module, modules: { [string]: Module }): { [string]: any }
	local allowed: { [string]: boolean } = {}
	for _, dependency in module.Dependencies or {} do
		allowed[dependency] = true
	end
	return setmetatable({}, {
		__index = function(_, name: string)
			if allowed[name] then
				return modules[name]
			end
			error(`{module.Name}: {tostring(name)} is not in its Dependencies`, 2)
		end,
		__newindex = function()
			error(`{module.Name}: the registry is read-only`, 2)
		end,
	}) :: any
end

function Loader.Run(modules: { [string]: Module }, log: Log.Logger): Report
	local order, problem = Loader.Order(modules)
	if not order then
		error(`Loader: {problem}`, 0)
	end
	local report: Report = { Order = order, Failed = {}, Skipped = {}, InitMs = {} }

	local function blockedBy(module: Module): string?
		for _, dependency in module.Dependencies or {} do
			if report.Failed[dependency] or report.Skipped[dependency] then
				return dependency
			end
		end
		return nil
	end

	for _, name in order do
		local module = modules[name]
		local blocker = blockedBy(module)
		if blocker then
			report.Skipped[name] = `needs {blocker}`
			log:Error("%s skipped: it needs %s, which didn't start", name, blocker)
			continue
		end
		local init = module.Init
		if init then
			local began = os.clock()
			local ok, err = xpcall(init, debug.traceback, module, registryFor(module, modules))
			local seconds = os.clock() - began
			report.InitMs[name] = seconds * 1000
			if not ok then
				report.Failed[name] = tostring(err)
				log:Error("%s.Init failed: %s", name, tostring(err))
				continue
			end
			if seconds > SLOW_INIT_SECONDS then
				log:Warn("%s.Init took %.2f s; Init should only wire things up", name, seconds)
			end
		end
	end

	for _, name in order do
		if report.Failed[name] or report.Skipped[name] then
			continue
		end
		local module = modules[name]
		local start = module.Start
		if start then
			task.spawn(function()
				local ok, err = xpcall(start, debug.traceback, module)
				if not ok then
					log:Error("%s.Start failed: %s", name, tostring(err))
				end
			end)
		end
	end
	return report
end

return table.freeze(Loader)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000038"><Properties><string name="Name">Log</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Log: tagged output with levels and a ring buffer of recent lines.

		local log = Log.new("BunkerGrid")
		log:Info("built %s at %d,%d", roomId, x, y)
		log:Warn("...")      -- shows as a warning
		log:Error("...")     -- a warning marked ERROR; never throws

	Lines look like `[100Y S BunkerGrid] built Kitchen at 2,3` (S = server, C = client).
	The level starts at Debug in Studio and Info in live servers; DevTools can change it
	(`/dev log Debug`). Log.Recent() returns the last lines for `/dev logs`.
]]

local RunService = game:GetService("RunService")

export type Level = "Debug" | "Info" | "Warn" | "Error"

export type Logger = {
	Tag: string,
	Debug: (self: Logger, format: string, ...any) -> (),
	Info: (self: Logger, format: string, ...any) -> (),
	Warn: (self: Logger, format: string, ...any) -> (),
	Error: (self: Logger, format: string, ...any) -> (),
}

local RANK: { [Level]: number } = { Debug = 1, Info = 2, Warn = 3, Error = 4 }
local RECENT_MAX = 200
local SIDE = if RunService:IsServer() then "S" else "C"

local threshold: Level = if RunService:IsStudio() then "Debug" else "Info"
local recent: { string } = {}
local recentNext = 1

local function remember(line: string)
	recent[recentNext] = line
	recentNext = recentNext % RECENT_MAX + 1
end

local function emit(level: Level, tag: string, format: string, ...: any)
	if RANK[level] < RANK[threshold] then
		return
	end
	local ok, message = pcall(string.format, format, ...)
	if not ok then
		message = `{format} (bad log format: {message})`
	end
	local line = if level == "Error"
		then `[100Y {SIDE} {tag}] ERROR {message}`
		else `[100Y {SIDE} {tag}] {message}`
	remember(`{string.format("%.2f", os.clock())} {level} {line}`)
	if level == "Warn" or level == "Error" then
		warn(line)
	else
		print(line)
	end
end

local LoggerClass = {}
LoggerClass.__index = LoggerClass

function LoggerClass.Debug(self: Logger, format: string, ...: any)
	emit("Debug", self.Tag, format, ...)
end

function LoggerClass.Info(self: Logger, format: string, ...: any)
	emit("Info", self.Tag, format, ...)
end

function LoggerClass.Warn(self: Logger, format: string, ...: any)
	emit("Warn", self.Tag, format, ...)
end

function LoggerClass.Error(self: Logger, format: string, ...: any)
	emit("Error", self.Tag, format, ...)
end

local Log = {}

function Log.new(tag: string): Logger
	return setmetatable({ Tag = tag }, LoggerClass) :: any
end

function Log.SetLevel(level: Level)
	assert(RANK[level], "Log.SetLevel: level must be Debug, Info, Warn or Error")
	threshold = level
end

function Log.GetLevel(): Level
	return threshold
end

function Log.IsLevel(value: any): boolean
	return type(value) == "string" and RANK[value :: Level] ~= nil
end

-- The last `count` lines (default 30), oldest first.
function Log.Recent(count: number?): { string }
	local wanted = math.clamp(count or 30, 1, RECENT_MAX)
	local lines = {}
	for offset = 0, RECENT_MAX - 1 do
		local line = recent[(recentNext - 1 + offset) % RECENT_MAX + 1]
		if line then
			table.insert(lines, line)
		end
	end
	return table.move(lines, math.max(1, #lines - wanted + 1), #lines, 1, {})
end

return table.freeze(Log)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000039"><Properties><string name="Name">RateLimit</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RateLimit: a token bucket per key (usually a Player).

		local limiter = RateLimit.new(5, 2)   -- bursts of 5, then 2 per second
		if not limiter:Take(player) then return end
		...
		limiter:Forget(player)                -- on PlayerRemoving

	`clock` can be replaced for tests; it defaults to os.clock.
]]

export type Limiter = {
	Take: (self: Limiter, key: any, cost: number?) -> boolean,
	Forget: (self: Limiter, key: any) -> (),
	Reset: (self: Limiter) -> (),
}

type Bucket = { tokens: number, at: number }

local LimiterClass = {}
LimiterClass.__index = LimiterClass

function LimiterClass.Take(self: any, key: any, cost: number?): boolean
	local price = cost or 1
	local now = self._clock()
	local bucket: Bucket? = self._buckets[key]
	if not bucket then
		local fresh: Bucket = { tokens = self._burst, at = now }
		self._buckets[key] = fresh
		bucket = fresh
	end
	local b = bucket :: Bucket
	b.tokens = math.min(self._burst, b.tokens + (now - b.at) * self._rate)
	b.at = now
	if b.tokens >= price then
		b.tokens -= price
		return true
	end
	return false
end

function LimiterClass.Forget(self: any, key: any)
	self._buckets[key] = nil
end

function LimiterClass.Reset(self: any)
	table.clear(self._buckets)
end

local RateLimit = {}

function RateLimit.new(burst: number, perSecond: number, clock: (() -> number)?): Limiter
	assert(burst > 0 and perSecond >= 0, "RateLimit.new: burst must be positive and perSecond not negative")
	return setmetatable({
		_burst = burst,
		_rate = perSecond,
		_clock = clock or os.clock,
		_buckets = {},
	}, LimiterClass) :: any
end

return table.freeze(RateLimit)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003A"><Properties><string name="Name">Signal</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Signal: a typed event without an Instance.

		local Changed: Signal.Signal<string, number> = Signal.new()
		local connection = Changed:Connect(function(key, value) ... end)
		Changed:Fire("Year", 12)
		connection:Disconnect()

	Handlers run on a recycled thread, so a handler may yield without holding up the others
	or the caller. Handlers connected during a Fire wait for the next Fire. The order in which
	handlers run is not guaranteed.
]]

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

export type Signal<T...> = {
	Connect: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Once: (self: Signal<T...>, handler: (T...) -> ()) -> Connection,
	Wait: (self: Signal<T...>) -> T...,
	Fire: (self: Signal<T...>, T...) -> (),
	DisconnectAll: (self: Signal<T...>) -> (),
	Destroy: (self: Signal<T...>) -> (),
}

type Node = {
	Connected: boolean,
	_signal: any,
	_handler: (...any) -> (),
	_next: Node?,
}

-- A thread kept for running handlers; it is handed out again once a handler returns
-- without yielding, so firing a signal rarely creates a thread.
local freeRunner: thread? = nil

local function runHandler(handler: (...any) -> (), ...: any)
	local runner = freeRunner
	freeRunner = nil
	handler(...)
	freeRunner = runner
end

local function runnerLoop(...: any)
	runHandler(...)
	while true do
		runHandler(coroutine.yield())
	end
end

local ConnectionClass = {}
ConnectionClass.__index = ConnectionClass

function ConnectionClass.Disconnect(self: Node)
	if not self.Connected then
		return
	end
	self.Connected = false
	local signal = self._signal
	if signal._head == self then
		signal._head = self._next
	else
		local previous = signal._head
		while previous and previous._next ~= self do
			previous = previous._next
		end
		if previous then
			previous._next = self._next
		end
	end
end

local SignalClass = {}
SignalClass.__index = SignalClass

function SignalClass.Connect(self: any, handler: (...any) -> ()): Connection
	local node: Node = setmetatable({
		Connected = true,
		_signal = self,
		_handler = handler,
		_next = self._head,
	}, ConnectionClass) :: any
	self._head = node
	return node :: any
end

function SignalClass.Once(self: any, handler: (...any) -> ()): Connection
	local connection: Connection
	connection = SignalClass.Connect(self, function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function SignalClass.Fire(self: any, ...: any)
	local node: Node? = self._head
	while node do
		if node.Connected then
			if not freeRunner then
				freeRunner = coroutine.create(runnerLoop)
			end
			task.spawn(freeRunner :: thread, node._handler, ...)
		end
		node = node._next
	end
end

function SignalClass.Wait(self: any): ...any
	local thread = coroutine.running()
	SignalClass.Once(self, function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function SignalClass.DisconnectAll(self: any)
	local node: Node? = self._head
	while node do
		node.Connected = false
		node = node._next
	end
	self._head = nil
end

SignalClass.Destroy = SignalClass.DisconnectAll

local Signal = {}

function Signal.new<T...>(): Signal<T...>
	return setmetatable({ _head = nil }, SignalClass) :: any
end

return table.freeze(Signal)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003B"><Properties><string name="Name">TableUtil</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TableUtil: copies, freezing and comparison for plain data (Config entries, replicated
	values). Data is tree-shaped; a cycle or nesting deeper than MAX_DEPTH is an error.
]]

local MAX_DEPTH = 32

local TableUtil = {}

local function deepCopy(value: any, depth: number): any
	if type(value) ~= "table" then
		return value
	end
	if depth > MAX_DEPTH then
		error("TableUtil.DeepCopy: nesting too deep (a cycle?)", depth + 2)
	end
	local copy = {}
	for key, item in value do
		copy[key] = deepCopy(item, depth + 1)
	end
	return copy
end

-- A copy with no shared tables. The copy is never frozen.
function TableUtil.DeepCopy<T>(value: T): T
	return deepCopy(value, 0)
end

local function deepFreeze(value: any, depth: number)
	if type(value) ~= "table" then
		return
	end
	if depth > MAX_DEPTH then
		error("TableUtil.DeepFreeze: nesting too deep (a cycle?)", depth + 2)
	end
	for _, item in value do
		deepFreeze(item, depth + 1)
	end
	if not table.isfrozen(value) then
		table.freeze(value)
	end
end

-- Freezes the table and every table inside it; returns it for chaining.
function TableUtil.DeepFreeze<T>(value: T): T
	deepFreeze(value, 0)
	return value
end

local function deepEqual(a: any, b: any, depth: number): boolean
	if a == b then
		return true
	end
	if type(a) ~= "table" or type(b) ~= "table" then
		-- NaN is never equal to itself; treat two NaNs as equal data
		return type(a) == "number" and type(b) == "number" and a ~= a and b ~= b
	end
	if depth > MAX_DEPTH then
		error("TableUtil.DeepEqual: nesting too deep (a cycle?)", depth + 2)
	end
	for key, item in a do
		if not deepEqual(item, b[key], depth + 1) then
			return false
		end
	end
	for key in b do
		if a[key] == nil then
			return false
		end
	end
	return true
end

function TableUtil.DeepEqual(a: any, b: any): boolean
	return deepEqual(a, b, 0)
end

function TableUtil.Count(t: { [any]: any }): number
	local count = 0
	for _ in t do
		count += 1
	end
	return count
end

-- Keys in a stable order: numbers ascending, then strings ascending, then the rest by tostring.
function TableUtil.SortedKeys(t: { [any]: any }): { any }
	local keys = {}
	for key in t do
		table.insert(keys, key)
	end
	table.sort(keys, function(a: any, b: any): boolean
		local ta, tb = type(a), type(b)
		if ta ~= tb then
			if ta == "number" then
				return true
			elseif tb == "number" then
				return false
			end
			return ta < tb
		end
		if ta == "number" or ta == "string" then
			return a < b
		end
		return tostring(a) < tostring(b)
	end)
	return keys
end

return table.freeze(TableUtil)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000003C"><Properties><string name="Name">Trove</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Trove: collects things to clean up and cleans them all at once, newest first.

		local trove = Trove.new()
		trove:Connect(part.Touched, onTouched)
		trove:Add(effect)                 -- an Instance: destroyed
		trove:Add(function() ... end)     -- a function: called
		trove:Clean()

	Accepts RBXScriptConnections, Instances, functions, threads (cancelled), and tables with a
	Destroy or Disconnect method (Signals, connections, other troves).
]]

export type Trove = {
	Add: <T>(self: Trove, item: T) -> T,
	Connect: (self: Trove, signal: any, handler: (...any) -> ()) -> any,
	Clean: (self: Trove) -> (),
	Destroy: (self: Trove) -> (),
}

local function cleanUp(item: any)
	local kind = typeof(item)
	if kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "function" then
		item()
	elseif kind == "thread" then
		pcall(task.cancel, item)
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

local TroveClass = {}
TroveClass.__index = TroveClass

function TroveClass.Add(self: any, item: any): any
	local kind = typeof(item)
	if kind ~= "RBXScriptConnection" and kind ~= "Instance" and kind ~= "function" and kind ~= "thread" then
		if kind ~= "table" or (type(item.Destroy) ~= "function" and type(item.Disconnect) ~= "function") then
			error(`Trove can't clean up a {kind}`, 2)
		end
	end
	table.insert(self._items, item)
	return item
end

function TroveClass.Connect(self: any, signal: any, handler: (...any) -> ()): any
	return TroveClass.Add(self, signal:Connect(handler))
end

function TroveClass.Clean(self: any)
	local items = self._items
	self._items = {}
	for index = #items, 1, -1 do
		cleanUp(items[index])
	end
end

TroveClass.Destroy = TroveClass.Clean

local Trove = {}

function Trove.new(): Trove
	return setmetatable({ _items = {} }, TroveClass) :: any
end

return table.freeze(Trove)
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Folder" referent="RBX00000048"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX0000003E"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Bootstrap: the only server Script (bible Section 23). It creates the remotes, loads every
	service in ServerScriptService.Services, runs every Init in dependency order and then
	every Start, and marks the server ready.

	Never add another Script: write a service (see Documentation.ARCHITECTURE).
]]

local began = os.clock()

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BuildInfo = require(Shared:WaitForChild("BuildInfo")) :: any
local Constants = require(Shared:WaitForChild("Constants"))
local Loader = require(Shared.Utilities:WaitForChild("Loader"))
local Log = require(Shared.Utilities:WaitForChild("Log"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local log = Log.new("Bootstrap")
local place = Constants.PlaceKind()

Remotes.Setup()

local services = Loader.Collect(ServerScriptService:WaitForChild("Services"), "Service")
local report = Loader.Run(services, log)

local broken = {}
for name in report.Failed do
	table.insert(broken, name)
end
for name in report.Skipped do
	table.insert(broken, name)
end
table.sort(broken)

ReplicatedStorage:SetAttribute("PlaceKind", place)
ReplicatedStorage:SetAttribute("Build", BuildInfo.Label)
ReplicatedStorage:SetAttribute("ServerBroken", if #broken > 0 then table.concat(broken, ",") else nil)
ReplicatedStorage:SetAttribute("ServerReady", true)

if #broken > 0 then
	log:Error("%s server started with broken services: %s", place, table.concat(broken, ", "))
end
log:Info(
	"%s server ready: %d services (%s) in %.1f ms, build %s",
	place,
	#report.Order,
	table.concat(report.Order, ", "),
	(os.clock() - began) * 1000,
	BuildInfo.Label
)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000041"><Properties><string name="Name">DevTools</string></Properties><Item class="ModuleScript" referent="RBX00000040"><Properties><string name="Name">DataTests</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DataTests: tests for the shared modules and, from Prompt 1, the content data
	(bible Section 23: DevTools ... and data tests).

	Run with `/dev test [filter]` in a game, Invoke:Invoke("test") in a Studio playtest, or
	require it from the command bar (DataTests.Format(DataTests.Run())). In Studio they also
	run once when the server starts.

	Add tests with test("Area: what it proves", function() ... end), using expect,
	expectEqual and expectError. A test may yield (2 s limit).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Check = require(Shared.Utilities.Check)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Delta = require(Shared.Utilities.Delta)
local Loader = require(Shared.Utilities.Loader)
local Log = require(Shared.Utilities.Log)
local RateLimit = require(Shared.Utilities.RateLimit)
local Remotes = require(Shared.Remotes)
local Bunker = require(Shared.Rules.Bunker)
local CameraRig = require(Shared.Rules.CameraRig)
local Clock = require(Shared.Rules.Clock)
local Grid = require(Shared.Rules.Grid)
local RunState = require(Shared.RunState)
local Signal = require(Shared.Utilities.Signal)
local TableUtil = require(Shared.Utilities.TableUtil)
local Trove = require(Shared.Utilities.Trove)
local ProfileSchema = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("ProfileSchema")) :: any

export type Failure = { Name: string, Error: string }
export type Report = { Passed: number, Failed: { Failure }, Skipped: number, Ms: number }

type Test = { Name: string, Run: () -> () }

local TIMEOUT_SECONDS = 2
local tests: { Test } = {}

local function test(name: string, run: () -> ())
	table.insert(tests, { Name = name, Run = run })
end

local function show(value: any, depth: number?): string
	local level = depth or 0
	if type(value) == "string" then
		return string.format("%q", value)
	elseif type(value) ~= "table" then
		return tostring(value)
	elseif level > 3 then
		return "{...}"
	end
	local parts = {}
	for _, key in TableUtil.SortedKeys(value) do
		table.insert(parts, `{tostring(key)}={show(value[key], level + 1)}`)
	end
	return "{" .. table.concat(parts, ", ") .. "}"
end

local function expect(condition: any, label: string)
	if not condition then
		error(`expected {label}`, 2)
	end
end

local function expectEqual(actual: any, expected: any, label: string?)
	if not TableUtil.DeepEqual(actual, expected) then
		error(`{label or "value"}: expected {show(expected)}, got {show(actual)}`, 2)
	end
end

local function expectError(run: () -> (), pattern: string?)
	local ok, err = pcall(run)
	if ok then
		error("expected an error", 2)
	end
	if pattern and not string.find(tostring(err), pattern) then
		error(`error {show(tostring(err))} doesn't match {pattern}`, 2)
	end
end

local function rejects(check: Check.Checker, value: any, pattern: string?)
	local ok, why = check(value)
	if ok then
		error(`checker accepted {show(value)}`, 2)
	end
	if pattern and not string.find(why or "", pattern) then
		error(`reason {show(why)} doesn't match {pattern}`, 2)
	end
end

local function accepts(check: Check.Checker, value: any)
	local ok, why = check(value)
	if not ok then
		error(`checker rejected {show(value)}: {why}`, 2)
	end
end

local silent: Log.Logger = {
	Tag = "test",
	Debug = function() end,
	Info = function() end,
	Warn = function() end,
	Error = function() end,
} :: any

-- Signal ---------------------------------------------------------------------------------

test("Signal: handlers get the fired arguments", function()
	local signal = Signal.new()
	local got = nil
	signal:Connect(function(a, b)
		got = { a, b }
	end)
	signal:Fire(1, "two")
	expectEqual(got, { 1, "two" })
end)

test("Signal: Disconnect stops delivery and Once fires once", function()
	local signal = Signal.new()
	local count, onceCount = 0, 0
	local connection = signal:Connect(function()
		count += 1
	end)
	signal:Once(function()
		onceCount += 1
	end)
	signal:Fire()
	connection:Disconnect()
	signal:Fire()
	expectEqual(count, 1, "count")
	expectEqual(onceCount, 1, "once count")
	expect(not connection.Connected, "Connected = false")
end)

test("Signal: a handler disconnecting itself mid-fire doesn't skip the others", function()
	local signal = Signal.new()
	local ran = {}
	signal:Connect(function()
		table.insert(ran, "a")
	end)
	local middle
	middle = signal:Connect(function()
		table.insert(ran, "b")
		middle:Disconnect()
	end)
	signal:Connect(function()
		table.insert(ran, "c")
	end)
	signal:Fire()
	expectEqual(#ran, 3, "handlers run on the first fire")
	signal:Fire()
	expectEqual(#ran, 5, "handlers run after the second fire")
end)

test("Signal: a yielding handler doesn't hold up the others", function()
	local signal = Signal.new()
	local reached = false
	signal:Connect(function()
		task.wait(0.05)
	end)
	signal:Connect(function()
		reached = true
	end)
	signal:Fire()
	expect(reached, "the second handler to run before Fire returns")
end)

test("Signal: Wait returns the fired values", function()
	local signal = Signal.new()
	task.defer(function()
		signal:Fire(42, "x")
	end)
	local a, b = signal:Wait()
	expectEqual({ a, b }, { 42, "x" })
end)

-- Trove ----------------------------------------------------------------------------------

test("Trove: cleans newest first, and disconnects signals", function()
	local trove = Trove.new()
	local order = {}
	for index = 1, 3 do
		trove:Add(function()
			table.insert(order, index)
		end)
	end
	local signal = Signal.new()
	local heard = 0
	trove:Connect(signal, function()
		heard += 1
	end)
	local folder = trove:Add(Instance.new("Folder"))
	trove:Clean()
	signal:Fire()
	expectEqual(order, { 3, 2, 1 }, "cleanup order")
	expectEqual(heard, 0, "handler calls after Clean")
	expect(not pcall(function()
		folder.Parent = workspace
	end), "the folder to be destroyed")
end)

test("Trove: refuses things it can't clean", function()
	expectError(function()
		Trove.new():Add(5 :: any)
	end, "can't clean")
end)

-- TableUtil ------------------------------------------------------------------------------

test("TableUtil: DeepCopy shares nothing; DeepFreeze freezes every level", function()
	local original = { a = { b = { 1, 2 } } }
	local copy = TableUtil.DeepCopy(original)
	copy.a.b[1] = 99
	expectEqual(original.a.b[1], 1, "original")
	TableUtil.DeepFreeze(original)
	expect(table.isfrozen(original) and table.isfrozen(original.a) and table.isfrozen(original.a.b), "all frozen")
end)

test("TableUtil: DeepEqual compares structure, extra keys and NaN", function()
	expect(TableUtil.DeepEqual({ x = { 1, 2 } }, { x = { 1, 2 } }), "equal tables")
	expect(not TableUtil.DeepEqual({ x = 1 }, { x = 1, y = 2 }), "an extra key to differ")
	expect(not TableUtil.DeepEqual({ 1, 2 }, { 2, 1 }), "order to matter")
	expect(TableUtil.DeepEqual(0 / 0, 0 / 0), "NaN to equal NaN")
end)

test("TableUtil: SortedKeys puts numbers first, then strings", function()
	expectEqual(TableUtil.SortedKeys({ b = 1, a = 1, [2] = 1, [1] = 1 }), { 1, 2, "a", "b" })
end)

-- Check ----------------------------------------------------------------------------------

test("Check: numbers must be finite and in range", function()
	local check = Check.number({ min = 0, max = 10, integer = true })
	accepts(check, 5)
	rejects(check, 0 / 0, "number")
	rejects(check, math.huge, "number")
	rejects(check, -1, "minimum")
	rejects(check, 11, "maximum")
	rejects(check, 2.5, "integer")
	rejects(check, "5", "number")
end)

test("Check: strings have a length limit, valid UTF-8 and a pattern", function()
	local check = Check.string(5, { pattern = "^%a+$", min = 1 })
	accepts(check, "abc")
	rejects(check, "abcdef", "longer")
	rejects(check, "", "shorter")
	rejects(check, "ab1", "match")
	rejects(Check.string(10), "\255\254", "UTF%-8")
end)

test("Check: lists have no holes, no named keys and a maximum length", function()
	local check = Check.array(Check.number(), 3)
	accepts(check, { 1, 2, 3 })
	rejects(check, { 1, 2, 3, 4 }, "longer")
	rejects(check, { 1, nil :: any, 3 }, "holes")
	rejects(check, { 1, x = 2 }, "index")
	rejects(check, { 1, "2" }, "%[2%]")
end)

test("Check: shapes name the field that failed and reject unknown fields", function()
	local check = Check.shape({ Name = Check.string(10), Cost = Check.optional(Check.integer(0)) })
	accepts(check, { Name = "Crate" })
	accepts(check, { Name = "Crate", Cost = 3 })
	rejects(check, { Cost = 3 }, "^Name:")
	rejects(check, { Name = "Crate", Cost = -1 }, "^Cost:")
	rejects(check, { Name = "Crate", Extra = true }, "unknown field")
	accepts(Check.shape({ Name = Check.string(10) }, { open = true }), { Name = "Crate", Extra = true })
end)

test("Check: literals, unions, vectors and primitives", function()
	local kind = Check.enum({ "Gun", "Melee" })
	accepts(kind, "Gun")
	rejects(kind, "Laser", "one of")
	local either = Check.union(Check.number(), Check.boolean())
	accepts(either, true)
	rejects(either, "x")
	local vector = Check.vector3(10)
	accepts(vector, Vector3.new(1, 2, 3))
	rejects(vector, Vector3.new(0 / 0, 0, 0), "finite")
	rejects(vector, Vector3.new(100, 0, 0), "longer")
	local primitive = Check.primitive(8)
	accepts(primitive, "word")
	accepts(primitive, 3)
	rejects(primitive, 0 / 0, "finite")
	rejects(primitive, {}, "expected")
end)

-- RateLimit ------------------------------------------------------------------------------

test("RateLimit: a burst, then refills over time, per key", function()
	local now = 0
	local limiter = RateLimit.new(3, 1, function()
		return now
	end)
	expect(limiter:Take("a") and limiter:Take("a") and limiter:Take("a"), "a burst of 3")
	expect(not limiter:Take("a"), "the 4th call to be refused")
	expect(limiter:Take("b"), "another key to have its own bucket")
	now = 1.5
	expect(limiter:Take("a"), "a token back after a second")
	expect(not limiter:Take("a"), "only one token back")
	limiter:Forget("a")
	expect(limiter:Take("a"), "a fresh bucket after Forget")
end)

-- Loader ---------------------------------------------------------------------------------

test("Loader: dependencies come first, ties alphabetical", function()
	local order = Loader.Order({
		Gamma = { Name = "Gamma", Dependencies = { "Alpha" } },
		Beta = { Name = "Beta" },
		Alpha = { Name = "Alpha" },
	})
	expectEqual(order, { "Alpha", "Beta", "Gamma" })
	order = Loader.Order({
		Alpha = { Name = "Alpha", Dependencies = { "Gamma" } },
		Beta = { Name = "Beta" },
		Gamma = { Name = "Gamma" },
	})
	expectEqual(order, { "Beta", "Gamma", "Alpha" })
end)

test("Loader: names missing dependencies and cycles", function()
	local order, problem = Loader.Order({ A = { Name = "A", Dependencies = { "Nope" } } })
	expect(order == nil and string.find(problem or "", "Nope"), "a missing-dependency error")
	order, problem = Loader.Order({
		A = { Name = "A", Dependencies = { "B" } },
		B = { Name = "B", Dependencies = { "C" } },
		C = { Name = "C", Dependencies = { "A" } },
		D = { Name = "D" },
	})
	expect(order == nil and string.find(problem or "", "cycle"), "a cycle error")
	expect(string.find(problem or "", "A") and string.find(problem or "", "C"), "the cycle named")
end)

test("Loader: Init in order, registry limited to declared dependencies, failures skip dependents", function()
	local calls = {}
	local modules = {
		Base = {
			Name = "Base",
			Init = function()
				table.insert(calls, "Base.Init")
			end,
		},
		User = {
			Name = "User",
			Dependencies = { "Base" },
			Init = function(_self, registry)
				table.insert(calls, "User.Init")
				expect(registry.Base ~= nil, "the declared dependency")
			end,
		},
		Sneaky = {
			Name = "Sneaky",
			Init = function(_self, registry)
				local _ = registry.Base -- not declared: must fail
			end,
		},
		AfterSneaky = { Name = "AfterSneaky", Dependencies = { "Sneaky" } },
	}
	local report = Loader.Run(modules :: any, silent)
	expectEqual(calls, { "Base.Init", "User.Init" }, "Init calls")
	expect(report.Failed.Sneaky ~= nil, "Sneaky to fail")
	expect(string.find(report.Failed.Sneaky or "", "not in its Dependencies"), "the reason")
	expect(report.Skipped.AfterSneaky ~= nil, "AfterSneaky to be skipped")
end)

-- Config ---------------------------------------------------------------------------------

local function fixture(): { [string]: any }
	return {
		Weapons = {
			Schema = Check.shape({ Damage = Check.number({ min = 0 }) }),
			Entries = { Pistol = { Damage = 10 }, Rifle = { Damage = 25 } },
			Order = { "Rifle", "Pistol" },
		},
		Classes = {
			Schema = Check.shape({ Weapon = Check.ref("Weapons") }),
			Entries = { Security = { Weapon = "Pistol" } },
		},
	}
end

test("Config: builds, adds Id, freezes and keeps Order", function()
	local registry = Config.Build(fixture())
	expectEqual(registry.Errors, {}, "errors")
	local pistol = registry.Types.Weapons.Entries.Pistol
	expectEqual(pistol.Id, "Pistol", "Id")
	expect(table.isfrozen(pistol), "frozen entries")
	expectEqual(registry.Types.Weapons.Order, { "Rifle", "Pistol" }, "Order")
	expectEqual(registry.Types.Classes.Order, { "Security" }, "default order")
end)

test("Config: reports bad values, bad ids, broken refs and bad Order", function()
	local defs = fixture()
	defs.Weapons.Entries.Rifle.Damage = "lots"
	defs.Weapons.Entries["rifle-2"] = { Damage = 1 }
	defs.Classes.Entries.Medic = { Weapon = "Laser" }
	defs.Weapons.Order = { "Pistol", "Ghost" }
	local errors = table.concat(Config.Build(defs).Errors, "\n")
	expect(string.find(errors, "Weapons.Rifle: Damage:"), "the bad value")
	expect(string.find(errors, "bad id rifle%-2"), "the bad id")
	expect(string.find(errors, "Classes.Medic: Weapons.Laser doesn't exist"), "the broken ref")
	expect(string.find(errors, "Order lists Ghost"), "the bad Order")
end)

test("Config: the place's own content loads without errors", function()
	expectEqual(Config.Errors(), {}, "Config.Errors()")
end)

-- Content (Prompt 1): the data agrees with the bible and with itself ---------------------

local function all(typeName: string): { any }
	return Config.All(typeName)
end

test("Content: the starting bunker matches bible Section 6 and its diagram", function()
	local bunker = Bunker.FromStart() -- every room placed by the grid's rules, or this errors
	local function row(floor: number): { string }
		local tokens = {}
		for column = -3, 3 do
			local state = bunker:State(floor, column)
			local room = bunker:RoomAt(floor, column)
			table.insert(tokens, if room then room.Type else tostring(state))
		end
		return tokens
	end
	expectEqual(row(1), { "Rock", "BlastDoor", "BlastDoor", "Shaft", "Quarters", "Quarters", "Dug" }, "floor 1, columns -3 to 3")
	expectEqual(row(2), { "Rock", "Kitchen", "WaterPurifier", "Shaft", "ReactorCore", "Medbay", "Dug" }, "floor 2, columns -3 to 3")
	expectEqual(row(3), { "Rock", "Rock", "Rock", "Rock", "Rock", "Rock", "Rock" }, "floor 3")
	expectEqual(#bunker:AllRooms(), 8, "eight rooms (the Blast Door and the Quarters are 2 cells each)")
	expectEqual(bunker:RoomsOfType("BlastDoor")[1].Span, 2, "the Blast Door's cells")
	expectEqual(Config.Get("Tuning", "StartingBunker").Residents, 6, "starting residents")
end)

test("Content: starting stock is bible Section 6", function()
	local stock = {}
	for _, resource in all("Resources") do
		stock[resource.Id] = resource.Start
	end
	expectEqual(stock, { Power = 0, Food = 30, Water = 30, Scrap = 300, Iron = 0, Copper = 0, Crystal = 0, Medkits = 4, Ammo = 200 })
end)

test("Content: rooms have three levels and consistent output", function()
	for _, room in all("Rooms") do
		expectEqual(#room.Costs, 3, `{room.Id} cost levels`)
		expectEqual(#room.Power, 3, `{room.Id} power levels`)
		if room.Output then
			local isResource = room.Output.Kind == "Resource"
			expect(isResource == (room.Output.Resource ~= nil), `{room.Id}: only Resource output names a resource`)
		end
		if room.Unlock.Kind == "Era" then
			expect(room.Unlock.Era ~= nil, `{room.Id}: an Era unlock names the era`)
		end
	end
	local rules = Config.Get("Tuning", "Rooms")
	expectEqual(rules.HP, { 500, 800, 1200 }, "room HP")
	expectEqual(rules.WorkerSlotsPerCell, { 2, 3, 4 }, "worker slots")
end)

test("Content: every draft room has exactly one room card", function()
	local cards: { [string]: number } = {}
	for _, card in all("DraftCards") do
		if card.Kind == "Room" then
			cards[card.Room] = (cards[card.Room] or 0) + 1
		end
	end
	for _, room in all("Rooms") do
		local drafted = room.Unlock.Kind == "Draft" or room.Unlock.Kind == "DraftOrDepth"
		expectEqual(cards[room.Id] or 0, if drafted then 1 else 0, `{room.Id} room cards`)
	end
end)

test("Content: odds add up (dig results, wanderers)", function()
	local dig = 0
	for _, result in all("DigResults") do
		dig += result.Chance
	end
	expectEqual(dig, 100, "dig result weights")
	local wanderers = 0
	for _, outcome in all("WandererOutcomes") do
		wanderers += outcome.Chance
	end
	expect(math.abs(wanderers - 1) < 1e-9, "wanderer odds sum to 1")
end)

test("Content: eras cover the century and end in their boss's year", function()
	local nextYear = 1
	for _, era in all("Eras") do
		expectEqual(era.Years.From, nextYear, `{era.Id} starts where the last ended`)
		expectEqual(Config.Get("Bosses", era.Boss).Year, era.Years.To, `{era.Id} boss year`)
		nextYear = era.Years.To + 1
	end
	expectEqual(nextYear, 101, "the century ends at Year 100")
	local clock = Config.Get("Tuning", "Clock")
	expectEqual(clock.DaySeconds + clock.SurgeSeconds, clock.CycleSeconds, "a cycle is a day plus a Surge")
end)

test("Content: 18 buyable classes plus the Survivor, priced by tier", function()
	local prices = { Free = 0, Common = 40, Rare = 120, Epic = 300, Legendary = 500 }
	local buyable = 0
	for _, class in all("Classes") do
		expectEqual(class.Price, prices[class.Tier], `{class.Id} price`)
		if class.Tier ~= "Free" then
			buyable += 1
		end
	end
	expectEqual(buyable, 18, "buyable classes")
end)

test("Content: 30 traits (18 good, 12 bad), 12 Legends with one starter", function()
	local good, bad = 0, 0
	for _, trait in all("Traits") do
		if trait.Type == "Good" then
			good += 1
		else
			bad += 1
		end
	end
	expectEqual({ good, bad }, { 18, 12 }, "good and bad traits")
	local starters = 0
	for _, legend in all("Legends") do
		if legend.Get.Kind == "Starter" then
			starters += 1
		end
	end
	expectEqual(#all("Legends"), 12, "Legends")
	expectEqual(starters, 1, "starter Legends")
end)

test("Content: RoomOutput modifiers always name their room", function()
	local function checkList(where: string, modifiers: { any }?)
		for _, modifier in modifiers or {} do
			if modifier.Key == "RoomOutput" then
				expect(modifier.Room ~= nil, `{where}: RoomOutput names a room`)
			end
		end
	end
	for _, class in all("Classes") do
		for _, part in { class.Passive, class.Level2, class.Level3, class.Ability } do
			checkList(`Classes.{class.Id}`, part and part.Modifiers)
		end
	end
	for _, trait in all("Traits") do
		checkList(`Traits.{trait.Id}`, trait.Modifiers)
	end
	for _, legend in all("Legends") do
		checkList(`Legends.{legend.Id}`, legend.Signature.Modifiers)
	end
	for _, card in all("DraftCards") do
		checkList(`DraftCards.{card.Id}`, card.Modifiers)
	end
end)

test("Content: loot lines give one thing each, and ranges are ordered", function()
	for _, tableEntry in all("LootTables") do
		for index, line in tableEntry.Lines do
			local kinds = (if line.Resource then 1 else 0) + (if line.Item then 1 else 0) + (if line.Special then 1 else 0)
			expectEqual(kinds, 1, `{tableEntry.Id}[{index}] gives one thing`)
			expect(line.Min <= line.Max, `{tableEntry.Id}[{index}] Min <= Max`)
		end
	end
	for _, monster in all("Monsters") do
		expect(monster.Group.Min <= monster.Group.Max, `{monster.Id} group size`)
	end
end)

test("Content: name pools are big and have no repeats; morale states cover 0 to 100", function()
	for _, pool in all("ResidentNames") do
		local seen = {}
		for _, name in pool.Names do
			expect(not seen[name], `{pool.Id}: {name} once`)
			seen[name] = true
		end
	end
	expect(#Config.Get("ResidentNames", "First").Names >= 100, "100+ first names")
	expect(#Config.Get("ResidentNames", "Last").Names >= 100, "100+ last names")
	local nextValue = 0
	for _, state in all("MoraleStates") do
		expectEqual(state.From, nextValue, `{state.Id} starts where the last ended`)
		nextValue = state.To + 1
	end
	expectEqual(nextValue, 101, "morale states end at 100")
end)

test("Content: Glowshard packs get better per Robux (bible Section 17)", function()
	local last = 0
	for _, pack in all("GlowshardPacks") do
		local per100 = math.floor(pack.Glowshards / pack.Robux * 100 + 0.5)
		expect(per100 > last, `{pack.Id} gives more per Robux than the pack before`)
		last = per100
	end
end)

-- Profiles (Prompt 2) ----------------------------------------------------------------------

test("Profiles: a new profile owns the free class and the starter Legend, and validates", function()
	local data, status = ProfileSchema.Load(nil)
	expectEqual(status, "New", "status")
	expect(data.Classes.Survivor ~= nil, "the Survivor owned")
	expect(data.Legends[Config.Get("Tuning", "Legends").StarterLegend] ~= nil, "the starter Legend owned")
	expectEqual(data.Glowshards, 0, "Glowshards")
	expect((ProfileSchema.Validate(data)), "the default to validate")
end)

test("Profiles: newer versions are refused, missing fields reconciled, bad values rejected", function()
	local _, status = ProfileSchema.Load({ Version = ProfileSchema.VERSION + 1 })
	expectEqual(status, "TooNew", "a newer save")
	local old = ProfileSchema.Default()
	old.Stats = { Runs = 3 }
	old.ClassShop = nil
	old.FirstRunDone = nil
	local data, loaded = ProfileSchema.Load(old)
	expectEqual(loaded, "Loaded", "a save with missing fields")
	expectEqual(data.Stats.Runs, 3, "kept values")
	expectEqual(data.Stats.Wins, 0, "a missing record field filled")
	expect(data.ClassShop ~= nil and data.FirstRunDone == false, "missing fields filled")
	local bad = ProfileSchema.Default()
	bad.Glowshards = -5
	local none, invalid, why = ProfileSchema.Load(bad)
	expect(none == nil and invalid == "Invalid", "negative Glowshards refused")
	expect(string.find(why or "", "Glowshards"), "the reason names the field")
	local wrong = ProfileSchema.Default()
	wrong.Classes.Survivor.Level = 9
	expectEqual(select(2, ProfileSchema.Load(wrong)), "Invalid", "a class level out of range")
end)

test("Profiles: migrations run in order up to the current version", function()
	local migrations = ProfileSchema._MIGRATIONS
	local version = ProfileSchema.VERSION
	ProfileSchema.VERSION = version + 1
	migrations[version] = function(data)
		data.Glowshards += 10
		return data
	end
	local ok, result = pcall(function()
		local stored = ProfileSchema.Default()
		stored.Version = version
		return table.pack(ProfileSchema.Load(stored))
	end)
	migrations[version] = nil
	ProfileSchema.VERSION = version
	expect(ok, "the load not to error")
	local data, status = result[1], result[2]
	expectEqual(status, "Loaded", "status")
	expectEqual(data.Version, version + 1, "the migrated version")
	expectEqual(data.Glowshards, 10, "the migration ran")
end)

test("Profiles: receipts keep the newest 200; the player's copy has none", function()
	local data = ProfileSchema.Default()
	for index = 1, 205 do
		ProfileSchema.AddReceipt(data, `r{index}`)
	end
	expectEqual(#data.Receipts, 200, "kept receipts")
	expectEqual(data.Receipts[1], "r6", "oldest kept")
	expect((ProfileSchema.Validate(data)), "still valid")
	expectEqual(ProfileSchema.Public(data).Receipts, nil, "receipts hidden from the client")
end)

-- Delta ----------------------------------------------------------------------------------

test("Delta: only remote-safe values", function()
	expect(Delta.IsRemoteSafe({ a = 1, b = { 1, 2 }, at = Vector3.new(1, 2, 3) }), "plain data")
	expect(not Delta.IsRemoteSafe({ 1, x = 2 }), "mixed tables refused")
	expect(not Delta.IsRemoteSafe({ [1] = 1, [3] = 3 }), "sparse lists refused")
	expect(not Delta.IsRemoteSafe({ f = print }), "functions refused")
	expect(not Delta.IsRemoteSafe({ n = 0 / 0 }), "NaN refused")
	expect(not Delta.IsRemoteSafe({ [true] = 1 } :: any), "boolean keys refused")
end)

test("Delta: Diff sends only changed fields, NONE for removed ones", function()
	expectEqual(Delta.Diff({ a = 1, b = 2 }, { a = 1, b = 3, c = 4 }), { b = 3, c = 4 })
	expectEqual(Delta.Diff({ a = 1, b = 2 }, { a = 1 }), { b = Delta.NONE })
	expectEqual(Delta.Diff({ a = { 1 } }, { a = { 1 } }), nil, "equal tables")
end)

test("Delta: Apply runs set, patch, remove and clear on a mirror", function()
	local store = {}
	local changes = Delta.Apply(store, {
		{ Delta.SET, "Rooms", "R1", { Kind = "Kitchen", Level = 1, Fire = true } },
		{ Delta.PATCH, "Rooms", "R1", { Level = 2, Fire = Delta.NONE } },
		{ Delta.SET, "Rooms", "R2", { Kind = "Dorm" } },
		{ Delta.REMOVE, "Rooms", "R2" },
	})
	expectEqual(store.Rooms, { R1 = { Kind = "Kitchen", Level = 2 } }, "store")
	expectEqual(#changes, 4, "change count")
	expectEqual(changes[2].Old, { Kind = "Kitchen", Level = 1, Fire = true }, "the patch keeps the old value")
	expect(table.isfrozen(store.Rooms.R1), "applied values frozen")
	changes = Delta.Apply(store, { { Delta.CLEAR, "Rooms" } })
	expectEqual(store.Rooms, {}, "after clear")
	expectEqual(#changes, 1, "one clear change")
end)

-- The clock (Rules.Clock, bible Section 5) ----------------------------------------------

local function objectiveIds(kind: string): { string }
	local ids = {}
	for _, objective in all("Objectives") do
		if objective.Kind == kind then
			table.insert(ids, objective.Id)
		end
	end
	return ids
end

local function bossObjective(bossId: string): string
	for _, objective in all("Objectives") do
		if objective.Kind == "Boss" and objective.Boss == bossId then
			return objective.Id
		end
	end
	error(`no objective for {bossId}`)
end

-- Plays a century with the clock rules: Lost Crews rescued in the given cycles, era bosses
-- beaten when they come or not. Returns the cycle of the final Surge and the boss Surges.
local function century(crewCycles: { number }, beatBosses: boolean): (number, { string })
	local state = Clock.NewState()
	local crews = objectiveIds("LostCrew")
	local rescued = 0
	local bosses = {}
	for _ = 1, 200 do
		for _, cycle in crewCycles do
			if cycle == state.Cycle then
				rescued += 1
				state.Completed[crews[rescued]] = true
			end
		end
		local kind, boss = Clock.StartSurge(state)
		if kind == "Final" then
			return state.Cycle, bosses
		end
		if kind == "Boss" and boss then
			table.insert(bosses, `{boss}@{state.Cycle}`)
			if beatBosses then
				state.Completed[bossObjective(boss)] = true
			end
		end
		Clock.EndCycle(state)
	end
	error("the century never ended")
end

test("Clock: Years per Cycle starts at 1, +2 a Lost Crew, +1 an era boss, 12 with everything", function()
	local crews, bosses = objectiveIds("LostCrew"), objectiveIds("Boss")
	expectEqual({ #crews, #bosses }, { 4, 3 }, "four Lost Crews and three era bosses")
	expectEqual(Clock.YearsPerCycle({}), 1, "nothing done")
	expectEqual(Clock.YearsPerCycle({ [crews[1]] = true }), 3, "one crew")
	expectEqual(Clock.YearsPerCycle({ [bosses[1]] = true }), 2, "one boss")
	local everything: { [string]: boolean } = {}
	for _, id in crews do
		everything[id] = true
	end
	for _, id in bosses do
		everything[id] = true
	end
	expectEqual(Clock.YearsPerCycle(everything), Clock.Tuning().YearsPerCycleMax, "everything done reaches the cap")
	expectEqual(Clock.Tuning().YearsPerCycleMax, 12, "the cap")
	everything.NotAnObjective = true
	expectEqual(Clock.YearsPerCycle(everything), 12, "unknown ids count for nothing")
	local eras = all("Eras")
	expectEqual(Clock.Tuning().FinalYear, eras[#eras].Years.To, "the final year ends the last era")
end)

test("Clock: reaching or passing an era's last year makes its boss the next Surge, once", function()
	local state = Clock.NewState()
	state.Year = 24
	local before, due = Clock.EndCycle(state)
	expectEqual({ before, state.Year, state.Cycle, due }, { 24, 25, 2, "BroodMother" }, "24 -> 25")
	expectEqual({ Clock.SurgeKind(state) }, { "Boss", "BroodMother" }, "the next Surge")
	expectEqual({ Clock.StartSurge(state) }, { "Boss", "BroodMother" }, "the boss Surge")
	expectEqual(state.PendingBoss, nil, "the boss Surge comes once")
	expectEqual(Clock.SurgeKind(state), "Normal", "the Surge after it")

	local jump = Clock.NewState()
	jump.Year = 23
	jump.Completed = { [objectiveIds("LostCrew")[1]] = true } -- 3 years per cycle
	local _, passed = Clock.EndCycle(jump)
	expectEqual({ jump.Year, passed }, { 26, "BroodMother" }, "23 + 3 passes 25")

	local beaten = Clock.NewState()
	beaten.Year = 49
	beaten.Completed = { [bossObjective("Deluge")] = true } -- 2 years per cycle
	local _, none = Clock.EndCycle(beaten)
	expectEqual({ beaten.Year, none, beaten.PendingBoss }, { 51, nil, nil }, "a beaten boss doesn't come again")
end)

test("Clock: the year stops at 100 and the next Surge is the final one; Endless goes on", function()
	local state = Clock.NewState()
	state.Year = 99
	state.Completed = { [objectiveIds("LostCrew")[1]] = true } -- 3 years per cycle
	local _, due = Clock.EndCycle(state)
	expectEqual({ state.Year, due }, { 100, nil }, "capped at the final year, no era boss for it")
	expectEqual({ Clock.SurgeKind(state) }, { "Final", "Source" }, "the final Surge")
	state.Endless = true
	expectEqual(Clock.SurgeKind(state), "Endless", "Endless Surges")
	Clock.EndCycle(state)
	expectEqual(state.Year, 103, "Endless goes past 100")
end)

test("Clock: eras by year; the first Surge is the tutorial wave", function()
	expectEqual(
		{ Clock.EraOf(1), Clock.EraOf(25), Clock.EraOf(26), Clock.EraOf(100), Clock.EraOf(140) },
		{ "SettlingIn", "SettlingIn", "Expansion", "Reckoning", "Reckoning" },
		"eras"
	)
	local state = Clock.NewState()
	expectEqual(Clock.SurgeKind(state), "Tutorial", "cycle 1")
	Clock.EndCycle(state)
	expectEqual(Clock.SurgeKind(state), "Normal", "cycle 2")
end)

test("Clock: completing nothing takes 100 cycles; crews and bosses make it 13 to 20 (bible Section 5)", function()
	local cycles, bosses = century({}, false)
	expectEqual(cycles, 100, "cycles with nothing done")
	expectEqual(bosses, { "BroodMother@25", "Deluge@50", "CrystalColossus@75" }, "boss Surges")
	for _, schedule in { { 2, 4, 6, 8 }, { 3, 6, 9, 12 }, { 4, 8, 12, 16 } } do
		local fast = century(schedule, true)
		expect(fast >= 13 and fast <= 20, `13 to 20 cycles with crews rescued in cycles {table.concat(schedule, ", ")} (got {fast})`)
	end
end)

test("RunState: every value has one owner, a type and its allowed values", function()
	local owners = { RunDirector = true, CycleClock = true, ObjectiveService = true }
	for name, field in RunState.Fields do
		expect(owners[field.By], `{name} to have a known owner`)
	end
	expect(RunState.Check("Year", 12), "a number year")
	expect(not RunState.Check("Year", "12"), "a string year rejected")
	expect(not RunState.Check("Year", 0 / 0), "NaN rejected")
	expect(not RunState.Check("RunPhase", "Paused"), "an unknown phase rejected")
	expect(RunState.Check("SurgeBoss", nil), "nil clears a value")
	expect(not RunState.Check("Nope", 1), "unknown names rejected")
	expectError(function()
		RunState.Writer("ObjectiveService")("Year", 5)
	end, "belongs to CycleClock")
end)

-- The bunker grid (Rules.Grid, Rules.Bunker; bible Section 6) ---------------------------

test("Grid: cells sit 34 studs apart and 18 down; world positions map back to their cell", function()
	local pitch = Grid.Pitch()
	expectEqual({ pitch.X, pitch.Y, pitch.Z }, { 34, 18, 34 }, "pitch")
	local origin = Grid.Tuning().Origin
	expectEqual(Grid.CellPosition(1, 0), Vector3.new(origin.X, origin.Y, origin.Z), "floor 1, column 0 is the origin")
	for _, cell in { { 1, 0 }, { 2, -6 }, { 10, 6 }, { 5, 3 } } do
		local position = Grid.CellPosition(cell[1], cell[2])
		for _, offset in { Vector3.new(0, 1, 0), Vector3.new(15, 15.5, 15), Vector3.new(-15, -1.5, -15) } do
			expectEqual({ Grid.CellAt(position + offset) }, cell, `cell {cell[1]},{cell[2]} plus {offset}`)
		end
	end
	expectEqual({ Grid.CellAt(Grid.CellPosition(1, 6) + Vector3.new(40, 0, 0)) }, {}, "past the right edge")
	expectEqual({ Grid.Parse(Grid.Key(7, -4)) }, { 7, -4 }, "keys")
	expect(Grid.Buildable(9) and not Grid.Buildable(10), "nothing built on floor 10")
	expect(Grid.IsBandStart(4) and Grid.IsBandStart(7) and Grid.IsBandStart(10), "Push Deeper at floors 4, 7 and 10")
	expect(not Grid.IsBandStart(1) and not Grid.IsBandStart(3), "not at floors 1 and 3")
end)

test("Bunker: the starting bunker is one connected place; the shafts join floors 1 and 2", function()
	local bunker = Bunker.FromStart()
	local blast = bunker:RoomsOfType("BlastDoor")[1]
	local reach = bunker:Reachable(blast.Id)
	for _, unit in bunker:Units() do
		expect(reach[unit], `{unit} reachable from the Blast Door`)
	end
	local upper, lower = bunker:RoomAt(1, 0), bunker:RoomAt(2, 0)
	expect(upper and lower and upper.Type == "Shaft" and lower.Type == "Shaft", "shafts in column 0")
	expect(table.find(bunker:Neighbors((upper :: Bunker.Room).Id), (lower :: Bunker.Room).Id), "the shafts connect")
	local core = bunker:RoomsOfType("ReactorCore")[1]
	local medbay = bunker:RoomsOfType("Medbay")[1]
	local expected = { (lower :: Bunker.Room).Id, medbay.Id }
	table.sort(expected)
	expectEqual(bunker:Neighbors(core.Id), expected, "the Reactor Core's doorways")
	expectEqual(bunker:DeepestFloor(), 2, "deepest floor")
end)

test("Bunker: digging goes left, right or down from an open cell, never up or off the grid", function()
	local bunker = Bunker.FromStart()
	expect(bunker:CanDig(1, 4), "right of the dug cell on floor 1")
	expect(bunker:CanDig(1, -3), "left of the Blast Door")
	expect(bunker:CanDig(3, 0), "below the shaft")
	expect(not bunker:CanDig(3, 5), "floor 3 away from any open cell")
	expect(not bunker:CanDig(1, 0), "an open cell")
	expect(not bunker:CanDig(0, 0), "above floor 1")
	expect(not bunker:CanDig(1, 7), "past column 6")
	expect(bunker:Dig(3, 0), "dig below the shaft")
	expect(bunker:CanDig(4, 0), "and on down")
	expect(bunker:CanDig(3, 1) and bunker:CanDig(3, -1), "and sideways from the new cell")
	expectEqual(bunker:DeepestFloor(), 3, "deepest floor after digging")
end)

test("Bunker: rooms go on dug cells, within MaxCells, one of a unique room, never in the Source Chamber", function()
	local bunker = Bunker.FromStart()
	expect(not bunker:CanPlace("Kitchen", 3, 0, 1), "on rock")
	expect(not bunker:CanPlace("Kitchen", 1, 0, 1), "on a room")
	expect(not bunker:CanPlace("ReactorCore", 1, 3, 1), "a second Reactor Core")
	expect(not bunker:CanPlace("BlastDoor", 2, 3, 1), "a Blast Door off floor 1")
	expect(not bunker:CanPlace("Shaft", 1, 3, 2), "a 2-cell Shaft")
	expect(not bunker:CanPlace("Nope", 1, 3, 1), "an unknown room")
	local id = bunker:Place("Storage", 1, 3, 1)
	expect(id, "Storage on the dug cell")
	local room = bunker:Room(id :: string) :: Bunker.Room
	expectEqual({ room.Level, room.HP, room.MaxHP, room.Span }, { 1, 500, 500, 1 }, "a new level 1 room")
	for floor = 3, 10 do
		bunker:Open(floor, 0)
	end
	expect(not bunker:CanPlace("Storage", 10, 0, 1), "nothing is built in the Source Chamber")
	expect(bunker:CanPlace("Storage", 9, 0, 1), "the Crystal Hollows can be built on")
end)

test("Bunker: matching rooms side by side merge up to MaxCells; fixed rooms never merge or go", function()
	local bunker = Bunker.FromStart()
	expect(bunker:Dig(1, 4) and bunker:Dig(1, 5) and bunker:Dig(1, 6), "dig three cells")
	local a = bunker:Place("Storage", 1, 3, 1) :: string
	local b = bunker:Place("Storage", 1, 4, 2) :: string
	local c = bunker:Place("Storage", 1, 6, 1) :: string
	expectEqual(bunker:Merge(b, a), a, "the left room's id survives")
	expectEqual((bunker:Room(a) :: Bunker.Room).Span, 3, "three cells")
	expect(bunker:Room(b) == nil, "the right room is gone")
	expect(not bunker:CanMerge(a, c), "a fourth cell is past MaxCells")
	expect(not bunker:CanMerge(bunker:RoomsOfType("Quarters")[1].Id, a), "different types don't merge")
	expect(not bunker:CanRemove(bunker:RoomsOfType("BlastDoor")[1].Id), "the Blast Door stays")
	expect(not bunker:CanRemove(bunker:RoomsOfType("ReactorCore")[1].Id), "the Reactor Core stays")
	expect(bunker:Remove(a), "a Storage comes down")
	expectEqual({ bunker:State(1, 4) }, { "Dug" }, "its cells are dug again")

	expect(bunker:Dig(2, 4), "dig on floor 2")
	local g1 = bunker:Place("Generator", 2, 3, 1) :: string
	local g2 = bunker:Place("Generator", 2, 4, 1) :: string
	bunker:SetLevel(g2, 2)
	expect(not bunker:CanMerge(g1, g2), "different levels don't merge")
	bunker:SetLevel(g2, 1)
	expect(bunker:CanMerge(g1, g2), "the same level does")
end)

test("Bunker: levels set HP from Tuning.Rooms.HP, keeping its share; SetHP clamps", function()
	local bunker = Bunker.FromStart()
	local medbay = bunker:RoomsOfType("Medbay")[1]
	bunker:SetHP(medbay.Id, 250)
	expect(bunker:SetLevel(medbay.Id, 2), "level 2")
	expectEqual({ medbay.HP, medbay.MaxHP, medbay.Level }, { 400, 800, 2 }, "half HP stays half")
	expect(not bunker:SetLevel(medbay.Id, 4), "no level 4")
	expectEqual(bunker:SetHP(medbay.Id, 5000), 800, "clamped to the maximum")
	expectEqual(bunker:SetHP(medbay.Id, -3), 0, "0 is Wrecked")
end)

test("Bunker: HP is per cell; a merged room keeps both rooms' HP", function()
	local bunker = Bunker.FromStart()
	local perCell = Config.Get("Tuning", "Rooms").HP
	expectEqual(bunker:RoomsOfType("Quarters")[1].MaxHP, perCell[1] * 2, "the 2-cell Quarters")
	expect(bunker:Dig(1, 4) and bunker:Dig(1, 5), "dig two cells")
	local a = bunker:Place("Storage", 1, 3, 1) :: string
	local b = bunker:Place("Storage", 1, 4, 2) :: string
	expectEqual((bunker:Room(b) :: Bunker.Room).MaxHP, perCell[1] * 2, "a 2-cell room at level 1")
	bunker:SetHP(a, 300)
	expectEqual(bunker:Merge(a, b), a, "merged")
	local merged = bunker:Room(a) :: Bunker.Room
	expectEqual({ merged.HP, merged.MaxHP }, { 300 + perCell[1] * 2, perCell[1] * 3 }, "both parts keep their HP")
	expect(bunker:SetLevel(a, 2), "level 2")
	expectEqual(merged.MaxHP, perCell[2] * 3, "level 2, three cells")
	expectEqual(Bunker.MaxHP(1, 3), 1500, "a 3-cell room at level 1 (Landon's example)")
end)

-- Camera ---------------------------------------------------------------------------------

test("CameraRig: the camera sits behind the focus, over the right shoulder by default", function()
	local t = CameraRig.Tuning()
	local pivot = Vector3.new(0, 10, 0)
	local right = CameraRig.Focus(pivot, 0, 1, t.ShoulderOffset, t.ShoulderRaise)
	expect(right.X > 0, "right of the pivot at yaw 0 (the camera looks toward -Z)")
	local left = CameraRig.Focus(pivot, 0, -1, t.ShoulderOffset, t.ShoulderRaise)
	expect(math.abs(left.X + right.X) < 1e-6, "the left shoulder mirrors it")
	local turned = CameraRig.Focus(pivot, math.rad(90), 1, t.ShoulderOffset, 0)
	expect(math.abs(turned.Z + t.ShoulderOffset) < 1e-6, "the shoulder turns with the yaw")
	local at = CameraRig.Position(right, 0, 0, 10)
	expect((at - (right + Vector3.new(0, 0, 10))).Magnitude < 1e-6, "10 studs behind (+Z) at pitch 0")
	expect(CameraRig.Position(right, 0, math.rad(-30), 10).Y > right.Y, "looking down puts the camera above the focus")
	expectEqual(CameraRig.ClampPitch(math.rad(-120)), math.rad(t.PitchMin), "pitch clamps")
	expect(t.PitchMin < 0 and t.PitchMax > 0, "looks both up and down")
end)

test("CameraRig: zoom is capped indoors; the camera stays between a cell's floor and ceiling", function()
	local t = CameraRig.Tuning()
	local g = Grid.Tuning()
	local nearest, indoors = CameraRig.ZoomRange(true)
	local _, outdoors = CameraRig.ZoomRange(false)
	expectEqual(nearest, t.Distance.Min, "nearest")
	expect(indoors <= t.IndoorMax and indoors < outdoors, "indoors is shorter")
	expect(t.Distance.Min <= t.Distance.Default and t.Distance.Default <= t.Distance.Max, "the default is in range")
	expect(t.AimDistance >= t.Distance.Min and t.AimDistance <= t.IndoorMax, "aiming stays in range")
	local cell = Grid.CellPosition(2, 1)
	local low, high = CameraRig.CellHeights(cell + Vector3.new(0, 3, 0))
	expectEqual({ low, high }, { cell.Y + t.FloorMargin, cell.Y + g.CellHeight - t.CeilingMargin }, "cell 2,1")
	expect(CameraRig.CellHeights(Vector3.new(0, 500, 0)) == nil, "nothing outside the grid")
	local floorY, ceilingY = low :: number, high :: number
	local focus = Vector3.new(0, ceilingY - 2, 0)
	local down = CameraRig.Rotation(0, math.rad(-30)).LookVector
	local limit = CameraRig.HeightLimit(focus, down, floorY, ceilingY)
	expect(math.abs(limit - 4) < 1e-3, `looking 30 degrees down 2 under the limit allows 4, got {limit}`)
	expectEqual(CameraRig.HeightLimit(focus, Vector3.new(0, 0, -1), floorY, ceilingY), math.huge, "a level view has no limit")
end)

test("CameraRig: sticks have a dead zone and a squared response; easing is frame-rate free", function()
	expectEqual(CameraRig.Stick(Vector2.new(0.1, 0), 0.15), Vector2.zero, "inside the dead zone")
	expect(math.abs(CameraRig.Stick(Vector2.new(1, 0), 0.15).X - 1) < 1e-6, "full tilt is 1")
	expect(math.abs(CameraRig.Stick(Vector2.new(0.575, 0), 0.15).X - 0.25) < 1e-3, "half way is a quarter")
	local once = CameraRig.Approach(0, 10, 5, 0.2)
	local twice = CameraRig.Approach(CameraRig.Approach(0, 10, 5, 0.1), 10, 5, 0.1)
	expect(math.abs(once - twice) < 1e-9, "two half steps equal one step")
	expectEqual(CameraRig.MoveToward(0, 1, 0.25), 0.25, "steps toward")
	expectEqual(CameraRig.MoveToward(0.9, 1, 0.25), 1, "never past")
end)

test("Clock: boss Surges and the final Surge have no timer; the others do", function()
	expect(Clock.IsOpenEnded("Boss") and Clock.IsOpenEnded("Final"), "a boss Surge runs until the boss is beaten")
	for _, kind in { "Tutorial", "Normal", "Endless" } do
		expect(not Clock.IsOpenEnded(kind :: Clock.SurgeKind), `{kind} to be timed`)
	end
end)

-- Remotes and constants ------------------------------------------------------------------

test("Remotes: every definition is complete", function()
	for name, definition in Remotes.Definitions do
		expect(string.find(name, "^%u%w*$"), `{name} to be PascalCase`)
		expect(definition.To == "Server" or definition.To == "Client", `{name}.To`)
		expect(type(definition.Doc) == "string" and #definition.Doc > 10, `{name}.Doc`)
		expect(definition.Place == nil or definition.Place == "Lobby" or definition.Place == "Run", `{name}.Place`)
		if definition.To == "Server" then
			expect(definition.Args ~= nil and definition.Rate ~= nil, `{name} to have Args and Rate`)
		end
	end
	expectEqual(Remotes.InPlace("SetReady"), Constants.PlaceKind() == "Run", "SetReady only in the Run place")
end)

test("Constants: this place knows what it is", function()
	local kind = Constants.PlaceKind()
	expect(kind == "Lobby" or kind == "Run", "Lobby or Run")
end)

-- Runner ---------------------------------------------------------------------------------

local DataTests = {}

function DataTests.Run(filter: string?): Report
	local began = os.clock()
	local report: Report = { Passed = 0, Failed = {}, Skipped = 0, Ms = 0 }
	for _, item in tests do
		if filter and not string.find(string.lower(item.Name), string.lower(filter), 1, true) then
			report.Skipped += 1
			continue
		end
		local done, ok, message = false, false, nil :: string?
		local thread = task.spawn(function()
			local success, err = xpcall(item.Run, debug.traceback)
			ok, message, done = success, if success then nil else tostring(err), true
		end)
		local waited = 0
		while not done and waited < TIMEOUT_SECONDS do
			waited += task.wait()
		end
		if not done then
			pcall(task.cancel, thread)
			table.insert(report.Failed, { Name = item.Name, Error = `timed out after {TIMEOUT_SECONDS} s` })
		elseif ok then
			report.Passed += 1
		else
			table.insert(report.Failed, { Name = item.Name, Error = message or "?" })
		end
	end
	report.Ms = (os.clock() - began) * 1000
	return report
end

function DataTests.Format(report: Report): string
	local filtered = if report.Skipped > 0 then `, {report.Skipped} filtered out` else ""
	local lines = {
		`DataTests: {report.Passed} passed, {#report.Failed} failed{filtered} ({string.format("%.0f", report.Ms)} ms)`,
	}
	for _, failure in report.Failed do
		local firstLine = string.split(failure.Error, "\n")[1]
		table.insert(lines, `  FAIL {failure.Name}: {firstLine}`)
	end
	return table.concat(lines, "\n")
end

function DataTests.Count(): number
	return #tests
end

return DataTests
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000041"><Properties><string name="Name">StructureCheck</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	StructureCheck: is the place built the way Documentation.ARCHITECTURE says?

	Checks the code skeleton, every installed file in BuildInfo, the service dependency
	graph, stray scripts and remotes, Config data, place identity and leftovers that must
	never be here (ServerStorage.NS_Pipeline from the Night Shift importer plugin).

	Run({ Runtime = true }) inside a running server (DevService `structure`) also checks
	the remotes and the boot result. Run({ Sources = true }) from a Studio plugin or the
	command bar also compares every script's Source with the hash BuildInfo recorded, to
	catch edits made in Studio that the repo doesn't have.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

export type Options = { Runtime: boolean?, Sources: boolean? }
export type Result = { Errors: { string }, Warnings: { string }, Passed: number, Notes: { string } }

local SKELETON: { { string } } = {
	{ "ReplicatedStorage.Shared", "Folder" },
	{ "ReplicatedStorage.Shared.BuildInfo", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Constants", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Types", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Remotes", "ModuleScript" },
	{ "ReplicatedStorage.Shared.RunState", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Config", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Rules", "Folder" },
	{ "ReplicatedStorage.Shared.Rules.Bunker", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Rules.CameraRig", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Rules.Clock", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Rules.Grid", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Utilities", "Folder" },
	{ "ReplicatedStorage.Shared.Utilities.Check", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Utilities.Delta", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Utilities.Loader", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Utilities.Log", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Utilities.RateLimit", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Utilities.Signal", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Utilities.TableUtil", "ModuleScript" },
	{ "ReplicatedStorage.Shared.Utilities.Trove", "ModuleScript" },
	{ "ServerScriptService.Bootstrap", "Script" },
	{ "ServerScriptService.Services", "Folder" },
	{ "ServerScriptService.Lib", "Folder" },
	{ "ServerScriptService.Lib.ProfileSchema", "ModuleScript" },
	{ "ServerScriptService.DevTools", "Folder" },
	{ "ServerScriptService.DevTools.StructureCheck", "ModuleScript" },
	{ "ServerScriptService.DevTools.DataTests", "ModuleScript" },
	{ "StarterPlayer.StarterPlayerScripts.ClientBootstrap", "LocalScript" },
	{ "StarterPlayer.StarterPlayerScripts.Controllers", "Folder" },
	{ "StarterPlayer.StarterPlayerScripts.Controllers.CameraController", "ModuleScript" },
	{ "StarterPlayer.StarterPlayerScripts.Controllers.InputController", "ModuleScript" },
	{ "StarterPlayer.StarterPlayerScripts.Lib", "Folder" },
	{ "StarterPlayer.StarterPlayerScripts.Lib.Fade", "ModuleScript" },
	{ "StarterGui.Reticle", "ScreenGui" },
	{ "ServerStorage.Documentation", "Folder" },
	{ "ServerStorage.Documentation.ARCHITECTURE", "ModuleScript" },
}

-- What only one place has (from game/places/<Place>).
local PLACE_SKELETON: { [string]: { { string } } } = {
	Run = {
		{ "ServerScriptService.Services.RunDirector", "ModuleScript" },
		{ "ServerScriptService.Services.CycleClock", "ModuleScript" },
		{ "ServerScriptService.Services.ObjectiveService", "ModuleScript" },
		{ "ServerScriptService.Services.BunkerGrid", "ModuleScript" },
		{ "ServerScriptService.Lib.BunkerKit", "ModuleScript" },
	},
	Lobby = {},
}

-- The only scripts: everything else is a ModuleScript (bible Section 23).
local ENTRY_SCRIPTS: { [string]: string } = {
	["ServerScriptService.Bootstrap"] = "Script",
	["StarterPlayer.StarterPlayerScripts.ClientBootstrap"] = "LocalScript",
}

-- Roblox's own player and character scripts, which it inserts under StarterPlayer when a
-- playtest starts (PlayerModule also carries InputSetup and ServerAuthority scripts).
local ROBLOX_DEFAULTS: { [string]: boolean } = {
	PlayerModule = true,
	PlayerScriptsLoader = true,
	RbxCharacterSounds = true,
	Animate = true,
	Health = true,
}

-- Scripts inside a player's character (Roblox copies Animate and Health into it).
local function inCharacter(instance: Instance): boolean
	local players = game:GetService("Players")
	local model = instance:FindFirstAncestorOfClass("Model")
	while model do
		if players:GetPlayerFromCharacter(model) then
			return true
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function isRobloxDefault(instance: Instance): boolean
	local node: Instance? = instance
	while node and node.Parent ~= game do
		if ROBLOX_DEFAULTS[node.Name] then
			return node:FindFirstAncestorOfClass("StarterPlayer") ~= nil
		end
		node = node.Parent
	end
	return false
end

local SCRIPT_ROOTS = {
	"Workspace",
	"ReplicatedFirst",
	"ReplicatedStorage",
	"ServerScriptService",
	"ServerStorage",
	"StarterGui",
	"StarterPack",
	"StarterPlayer",
	"Lighting",
	"SoundService",
}

local function find(path: string): Instance?
	local node: Instance? = game
	for segment in string.gmatch(path, "[^%.]+") do
		if node == game then
			local ok, service = pcall(game.GetService, game, segment)
			node = if ok then service else nil
		else
			node = (node :: Instance):FindFirstChild(segment)
		end
		if not node then
			return nil
		end
	end
	return node
end

local function pathOf(instance: Instance): string
	return instance:GetFullName()
end

-- An art-pipeline sample (A0_Showroom, A0_HUD...): allowed until gameplay replaces it.
local function isSample(instance: Instance): boolean
	local node: Instance? = instance
	while node and node ~= game do
		if string.sub(node.Name, 1, 3) == "A0_" then
			return true
		end
		node = node.Parent
	end
	return false
end

local function fnv1a(text: string): string
	local hash = 2166136261
	for index = 1, #text do
		hash = bit32.bxor(hash, string.byte(text, index))
		hash = (bit32.lshift(hash, 24) + hash * 403) % 4294967296
	end
	return string.format("%08x", hash)
end

local StructureCheck = {}

StructureCheck.Hash = fnv1a

function StructureCheck.Run(options: Options?): Result
	local runtime = options ~= nil and options.Runtime == true
	local sources = options ~= nil and options.Sources == true
	local result: Result = { Errors = {}, Warnings = {}, Passed = 0, Notes = {} }
	local function pass()
		result.Passed += 1
	end
	local function fail(message: string)
		table.insert(result.Errors, message)
	end
	local function warnOf(message: string)
		table.insert(result.Warnings, message)
	end

	-- 1. The skeleton (shared, then this place's own)
	local placeKind: string? = nil
	do
		local constantsModule = find("ReplicatedStorage.Shared.Constants")
		if constantsModule and constantsModule:IsA("ModuleScript") then
			local ok, kind = pcall((require(constantsModule) :: any).PlaceKind)
			placeKind = if ok then kind else nil
		end
	end
	local skeleton = table.clone(SKELETON)
	for _, item in (if placeKind then PLACE_SKELETON[placeKind] else nil) or {} do
		table.insert(skeleton, item)
	end
	for _, item in skeleton do
		local path, className = item[1], item[2]
		local found = find(path)
		if not found then
			fail(`missing {path} ({className})`)
		elseif found.ClassName ~= className then
			fail(`{path} is a {found.ClassName}, should be a {className}`)
		else
			pass()
		end
	end
	for kind, items in PLACE_SKELETON do
		if kind ~= placeKind then
			for _, item in items do
				if find(item[1]) then
					fail(`{item[1]} belongs to the {kind} place only`)
				end
			end
		end
	end

	-- 2. Every installed file, and (from a plugin) whether it was edited after install
	local buildInfo: any = nil
	local buildModule = find("ReplicatedStorage.Shared.BuildInfo")
	if buildModule and buildModule:IsA("ModuleScript") then
		local ok, info = pcall(require, buildModule)
		if ok and type(info) == "table" and type(info.Files) == "table" then
			buildInfo = info
			pass()
		else
			fail("BuildInfo doesn't load or has no Files")
		end
	end
	if buildInfo then
		table.insert(result.Notes, `build {buildInfo.Label}`)
		for path, file in buildInfo.Files do
			local found = find(path)
			if not found then
				fail(`installed file missing: {path} ({file.Class})`)
			elseif found.ClassName ~= file.Class then
				fail(`{path} is a {found.ClassName}, installed as a {file.Class}`)
			else
				pass()
				if sources and found:IsA("LuaSourceContainer") then
					local ok, source = pcall(function()
						return (found :: any).Source
					end)
					if ok and fnv1a(source) ~= file.Hash then
						warnOf(`{path} was edited in Studio after install (the repo copy differs)`)
					end
				end
			end
		end
	end

	-- 3. Services: names, shape and a dependency order with no cycle
	local servicesFolder = find("ServerScriptService.Services")
	if servicesFolder then
		local Loader = require(ReplicatedStorage.Shared.Utilities.Loader) :: any
		local ok, modules = pcall(Loader.Collect, servicesFolder, "Service")
		if not ok then
			fail(tostring(modules))
		else
			local order, problem = Loader.Order(modules)
			if order then
				pass()
				table.insert(result.Notes, `services: {table.concat(order, ", ")}`)
			else
				fail(`services: {problem}`)
			end
		end
		for _, child in servicesFolder:GetChildren() do
			if not child:IsA("ModuleScript") then
				warnOf(`{pathOf(child)}: only ModuleScripts belong in Services`)
			end
		end
	end
	local controllers = find("StarterPlayer.StarterPlayerScripts.Controllers")
	if controllers then
		for _, child in controllers:GetChildren() do
			if not child:IsA("ModuleScript") then
				warnOf(`{pathOf(child)}: only ModuleScripts belong in Controllers`)
			else
				pass()
			end
		end
	end

	-- 4. Stray scripts: only the two bootstraps run code
	local samples = 0
	for _, rootName in SCRIPT_ROOTS do
		local ok, root = pcall(game.GetService, game, rootName)
		if not ok then
			continue
		end
		for _, descendant in (root :: Instance):GetDescendants() do
			if not descendant:IsA("BaseScript") then
				continue
			end
			local path = pathOf(descendant)
			if ENTRY_SCRIPTS[path] == descendant.ClassName then
				pass()
			elseif isSample(descendant) then
				samples += 1
			elseif isRobloxDefault(descendant) or inCharacter(descendant) then
				continue
			else
				warnOf(`stray {descendant.ClassName} {path}: only Bootstrap and ClientBootstrap are scripts; make it a module`)
			end
		end
	end
	if samples > 0 then
		table.insert(result.Notes, `{samples} script(s) in A0_ art samples (allowed until gameplay replaces them)`)
	end

	-- 5. Remotes: only the ones Shared.Remotes defines
	local remotesModule = find("ReplicatedStorage.Shared.Remotes")
	for _, rootName in { "ReplicatedStorage", "Workspace", "ReplicatedFirst" } do
		local root = game:GetService(rootName :: any) :: Instance
		for _, descendant in root:GetDescendants() do
			if
				(descendant:IsA("RemoteEvent") or descendant:IsA("RemoteFunction") or descendant:IsA("UnreliableRemoteEvent"))
				and descendant.Parent ~= remotesModule
			then
				warnOf(`stray remote {pathOf(descendant)}: add it to Shared.Remotes instead`)
			end
		end
	end
	if runtime and remotesModule then
		local Remotes = require(remotesModule :: ModuleScript) :: any
		for name, definition in Remotes.Definitions do
			local found = remotesModule:FindFirstChild(name)
			local className = if definition.Unreliable then "UnreliableRemoteEvent" else "RemoteEvent"
			if not Remotes.InPlace(name) then
				if found then
					fail(`remote {name} exists, but it belongs to the {definition.Place} place only`)
				else
					pass()
				end
			elseif not found then
				fail(`remote {name} wasn't created`)
			elseif found.ClassName ~= className then
				fail(`remote {name} is a {found.ClassName}, should be a {className}`)
			else
				pass()
			end
		end
		for _, child in remotesModule:GetChildren() do
			if Remotes.Definitions[child.Name] == nil then
				warnOf(`unknown remote {child.Name} under Shared.Remotes`)
			end
		end
	end

	-- 6. Config data
	local configModule = find("ReplicatedStorage.Shared.Config")
	if configModule and configModule:IsA("ModuleScript") then
		local ok, Config = pcall(require, configModule)
		if not ok then
			fail(`Config doesn't load: {Config}`)
		else
			local errors = (Config :: any).Errors()
			if #errors == 0 then
				pass()
				table.insert(result.Notes, `config types: {#(Config :: any).Types()}`)
			end
			for _, problem in errors do
				fail(`config: {problem}`)
			end
		end
	end

	-- 7. Place identity
	local constantsModule = find("ReplicatedStorage.Shared.Constants")
	if constantsModule and constantsModule:IsA("ModuleScript") then
		local Constants = require(constantsModule) :: any
		local ok, kind = pcall(Constants.PlaceKind)
		if not ok then
			fail(tostring(kind))
		else
			pass()
			table.insert(result.Notes, `place {kind} ({game.PlaceId})`)
			local attribute = workspace:GetAttribute("PlaceKind")
			if attribute ~= nil and attribute ~= kind then
				fail(`Workspace PlaceKind says {attribute} but this is {kind}`)
			end
			if buildInfo and buildInfo.Place ~= kind then
				fail(`installed build is for {buildInfo.Place}, but this place is {kind}`)
			end
		end
	end

	-- 8. Leftovers that must never be here
	if ServerStorage:FindFirstChild("NS_Pipeline") then
		fail("ServerStorage.NS_Pipeline exists: the Night Shift importer plugin is still active; delete the folder and disable the plugin")
	else
		pass()
	end

	-- 8b. Place settings the camera relies on (Prompt 5): Roblox's shift lock off (the camera
	-- locks the mouse itself) and Invisicam for Roblox's camera, the fallback
	local StarterPlayer = game:GetService("StarterPlayer")
	if StarterPlayer.EnableMouseLockOption then
		fail("StarterPlayer.EnableMouseLockOption must be off: the over-the-shoulder camera locks the mouse itself")
	else
		pass()
	end
	if StarterPlayer.DevCameraOcclusionMode ~= Enum.DevCameraOcclusionMode.Invisicam then
		fail("StarterPlayer.DevCameraOcclusionMode must be Invisicam (the camera's fallback, bible Section 9)")
	else
		pass()
	end

	-- 9. The architecture document
	local doc = find("ServerStorage.Documentation.ARCHITECTURE")
	if doc and doc:IsA("ModuleScript") then
		local ok, text = pcall(require, doc)
		if ok and type(text) == "string" and #text > 200 then
			pass()
		else
			fail("Documentation.ARCHITECTURE must return the document text")
		end
	end

	-- 10. The boot result
	if runtime then
		if ReplicatedStorage:GetAttribute("ServerReady") == true then
			pass()
		else
			fail("ServerReady isn't set: Bootstrap didn't finish")
		end
		local broken = ReplicatedStorage:GetAttribute("ServerBroken")
		if broken then
			fail(`services that failed to start: {broken}`)
		end
		local DevTools = ServerScriptService:FindFirstChild("DevTools")
		if DevTools and not DevTools:FindFirstChild("Invoke") and game:GetService("RunService"):IsStudio() then
			warnOf("DevTools.Invoke wasn't created (DevService didn't start?)")
		end
		-- The run's replicated values (Run place): set, and each one allowed
		local runStateModule = find("ReplicatedStorage.Shared.RunState")
		if placeKind == "Run" and runStateModule and runStateModule:IsA("ModuleScript") then
			local RunState = require(runStateModule) :: any
			if RunState.Get("RunPhase") == nil then
				fail("RunState.RunPhase isn't set: RunDirector didn't start")
			else
				pass()
			end
			for name, value in runStateModule:GetAttributes() do
				local ok, why = RunState.Check(name, value)
				if ok then
					pass()
				else
					fail(`RunState: {why}`)
				end
			end
		end
		-- The bunker's world (Run place): BunkerGrid built it
		if placeKind == "Run" then
			local bunker = workspace:FindFirstChild("Bunker")
			if not bunker then
				fail("workspace.Bunker is missing: BunkerGrid didn't build the bunker")
			else
				for _, name in { "Frame", "Rock", "Dug", "Rooms" } do
					if bunker:FindFirstChild(name) then
						pass()
					else
						fail(`workspace.Bunker.{name} is missing`)
					end
				end
				local rooms = bunker:FindFirstChild("Rooms")
				if rooms and #rooms:GetChildren() == 0 then
					fail("workspace.Bunker.Rooms is empty")
				end
				-- Every room carries its gameplay points; the art kit, when the place has it,
				-- built every room; the Medbay has the spawn and the Blast Door its exit.
				local ServerStorage = game:GetService("ServerStorage")
				local assets = ServerStorage:FindFirstChild("Assets")
				local kit = assets and assets:FindFirstChild("Kit")
				local hasArt = kit ~= nil and kit:FindFirstChild("Kit_Floor") ~= nil
				for _, room in if rooms then rooms:GetChildren() else {} do
					local kind = room:GetAttribute("RoomType")
					local sockets = room:FindFirstChild("Sockets")
					if sockets and sockets:IsA("BasePart") then
						pass()
					else
						fail(`room {room.Name} ({kind}) has no Sockets part`)
					end
					if hasArt and room:GetAttribute("Art") ~= true then
						fail(`room {room.Name} ({kind}) was built from the graybox although the art kit is in ServerStorage.Assets`)
					elseif hasArt then
						pass()
					end
					if kind == "Medbay" then
						if room:FindFirstChild("MedbaySpawn") then
							pass()
						else
							fail(`Medbay {room.Name} has no MedbaySpawn`)
						end
					elseif kind == "BlastDoor" then
						if sockets and sockets:FindFirstChild("SurfaceExit") then
							pass()
						else
							fail(`Blast Door {room.Name} has no SurfaceExit socket`)
						end
					end
				end
			end
		end
	end

	return result
end

function StructureCheck.Format(result: Result): string
	local lines = {
		`StructureCheck: {#result.Errors} errors, {#result.Warnings} warnings, {result.Passed} checks passed`,
	}
	for _, message in result.Errors do
		table.insert(lines, `  ERROR {message}`)
	end
	for _, message in result.Warnings do
		table.insert(lines, `  warn  {message}`)
	end
	for _, message in result.Notes do
		table.insert(lines, `  note  {message}`)
	end
	return table.concat(lines, "\n")
end

return StructureCheck
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000043"><Properties><string name="Name">Lib</string></Properties><Item class="ModuleScript" referent="RBX00000043"><Properties><string name="Name">ProfileSchema</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileSchema: the shape of a player's saved data (bible Section 23), its defaults, its
	migrations, and the load pipeline: migrate, then reconcile, then validate. Pure (no
	DataStores), so the data tests can run it on fixtures. ProfileService does the I/O.

	Version history:
	  1  2026-11-08  first version (Prompt 2)

	To change the shape: raise VERSION, add MIGRATIONS[old] that turns version old into old+1,
	and update Default() and SHAPE. Never rename or drop a field without a migration: during
	a rolling update old and new servers run side by side, and an old server refuses (never
	overwrites) data newer than it knows.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Check = require(Shared.Utilities.Check)
local Config = require(Shared.Config)
local TableUtil = require(Shared.Utilities.TableUtil)

local ProfileSchema = {}

ProfileSchema.VERSION = 1
ProfileSchema.RECEIPTS_KEPT = 200

-- version -> function turning a profile of that version into the next version
local MIGRATIONS: { [number]: (data: { [string]: any }) -> { [string]: any } } = {}

-- Fields whose value is a fixed-shape record (reconciled field by field); every other table
-- field is a map whose keys belong to the player (classes owned, badges earned...).
local RECORDS: { [string]: boolean } = {
	Talents = true,
	Cosmetics = true,
	Stats = true,
	Quests = true,
	ClassShop = true,
}

local Id = Check.string(64, { pattern = "^[%a][%w_]*$" })

local SHAPE = Check.shape({
	Version = Check.integer(1),
	Glowshards = Check.integer(0, 1e9),
	Classes = Check.map(Id, Check.shape({ Level = Check.integer(1, 3), XP = Check.number({ min = 0 }) }), 100),
	Talents = Check.shape({ Slots = Check.integer(0, 3), Equipped = Check.array(Id, 3) }),
	Legends = Check.map(Id, Check.shape({ Renown = Check.integer(1, 5) }), 200),
	Cosmetics = Check.shape({
		Owned = Check.map(Id, Check.boolean(), 2000),
		Equipped = Check.map(Id, Id, 32),
	}),
	Stats = Check.map(Id, Check.number({ min = 0 }), 64),
	Badges = Check.map(Id, Check.number({ min = 0 }), 500),
	Quests = Check.shape({
		Daily = Check.array(Check.any(), 10),
		Weekly = Check.array(Check.any(), 10),
		LastReset = Check.number({ min = 0 }),
	}),
	ClassShop = Check.shape({
		Day = Check.integer(0),
		Slots = Check.array(Id, 4),
		RerollsUsed = Check.integer(0),
		Wishlist = Check.optional(Id),
	}),
	AccountLevel = Check.integer(1, 100),
	AccountXP = Check.number({ min = 0 }),
	Settings = Check.map(Id, Check.primitive(64), 64),
	Receipts = Check.array(Check.string(64, { min = 1 }), 200),
	FirstRunDone = Check.boolean(),
})

-- A new player's profile: the free class and the starter Legend are theirs (bible Sections
-- 14 and 15).
function ProfileSchema.Default(): { [string]: any }
	local classes: { [string]: any } = {}
	for _, class in Config.All("Classes") do
		if class.Tier == "Free" then
			classes[class.Id] = { Level = 1, XP = 0 }
		end
	end
	local legends: { [string]: any } = {}
	local starter = Config.Get("Tuning", "Legends").StarterLegend
	legends[starter] = { Renown = 1 }
	return {
		Version = ProfileSchema.VERSION,
		Glowshards = 0,
		Classes = classes,
		Talents = { Slots = 0, Equipped = {} },
		Legends = legends,
		Cosmetics = { Owned = {}, Equipped = {} },
		Stats = { Runs = 0, Wins = 0, BestYear = 0, Deepest = 0 },
		Badges = {},
		Quests = { Daily = {}, Weekly = {}, LastReset = 0 },
		ClassShop = { Day = 0, Slots = {}, RerollsUsed = 0 },
		AccountLevel = 1,
		AccountXP = 0,
		Settings = {},
		Receipts = {},
		FirstRunDone = false,
	}
end

-- Runs every migration from data.Version up to VERSION. Errors if a step is missing.
function ProfileSchema.Migrate(data: { [string]: any }): { [string]: any }
	local version = data.Version
	if type(version) ~= "number" then
		version = 1
		data.Version = 1
	end
	while version < ProfileSchema.VERSION do
		local step = MIGRATIONS[version]
		if not step then
			error(`no migration from profile version {version}`)
		end
		data = step(data)
		version += 1
		data.Version = version
	end
	return data
end

-- Fills in fields the profile is missing (new fields, new record fields) from the defaults.
-- Never touches the player's own keys in maps.
function ProfileSchema.Reconcile(data: { [string]: any }): { [string]: any }
	local defaults = ProfileSchema.Default()
	for field, value in defaults do
		local current = data[field]
		if current == nil then
			data[field] = value
		elseif RECORDS[field] and type(current) == "table" and type(value) == "table" then
			for subField, subValue in value do
				if current[subField] == nil then
					current[subField] = subValue
				end
			end
		end
	end
	return data
end

function ProfileSchema.Validate(data: any): (boolean, string?)
	return SHAPE(data)
end

export type LoadStatus = "New" | "Loaded" | "TooNew" | "Invalid"

--[[
	The whole load pipeline for stored Data (nil for a new player): returns the profile to use
	and a status. TooNew and Invalid return no profile: the player must not play on it (and
	nothing may be written).
]]
function ProfileSchema.Load(stored: any): ({ [string]: any }?, LoadStatus, string?)
	if stored == nil then
		return ProfileSchema.Default(), "New", nil
	end
	if type(stored) ~= "table" then
		return nil, "Invalid", `stored data is a {type(stored)}`
	end
	if type(stored.Version) == "number" and stored.Version > ProfileSchema.VERSION then
		return nil, "TooNew", `version {stored.Version} is newer than {ProfileSchema.VERSION}`
	end
	local data = TableUtil.DeepCopy(stored)
	local ok, result = pcall(ProfileSchema.Migrate, data)
	if not ok then
		return nil, "Invalid", tostring(result)
	end
	data = ProfileSchema.Reconcile(result)
	local valid, why = ProfileSchema.Validate(data)
	if not valid then
		return nil, "Invalid", why
	end
	return data, "Loaded", nil
end

-- What the player's own client sees: everything except the receipt log.
function ProfileSchema.Public(data: { [string]: any }): { [string]: any }
	local copy = TableUtil.DeepCopy(data)
	copy.Receipts = nil
	return copy
end

-- Adds a receipt id, keeping the newest RECEIPTS_KEPT.
function ProfileSchema.AddReceipt(data: { [string]: any }, receiptId: string)
	local receipts = data.Receipts
	table.insert(receipts, receiptId)
	while #receipts > ProfileSchema.RECEIPTS_KEPT do
		table.remove(receipts, 1)
	end
end

ProfileSchema._MIGRATIONS = MIGRATIONS -- for the data tests

return ProfileSchema
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000048"><Properties><string name="Name">Services</string></Properties><Item class="ModuleScript" referent="RBX00000045"><Properties><string name="Name">DevService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DevService: DevTools commands (bible Section 23: test commands gated to Studio and
	admins).

	Services register their own commands in Init:

		registry.DevService:Register("year", {
			Description = "Set the year counter.",
			Usage = "year <number>",
			Run = function(player, args) ... return "Year is now 25" end,
		})

	Three ways in, all through Execute:
	* in a game, an allowed player types `/dev <command> [args]` in chat (DevController sends
	  the DevCommand remote; permission is checked here, never trusted from the client);
	* in a Studio playtest, tools call ServerScriptService.DevTools.Invoke (a
	  BindableFunction made only in Studio): `Invoke:Invoke("test")`;
	* in Studio, the data tests and StructureCheck run once when the server starts.

	Allowed: everyone in Studio; outside Studio only Constants.ADMIN_USER_IDS. Players get a
	DevAllowed attribute so their client can show the command.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local BuildInfo = require(Shared.BuildInfo) :: any
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local TableUtil = require(Shared.Utilities.TableUtil)
local Types = require(Shared.Types)

local log = Log.new("DevService")
local IS_STUDIO = RunService:IsStudio()
local MAX_OUTPUT = 3000

local DevService = {
	Name = "DevService",
	Dependencies = {},
}

local commands: { [string]: Types.DevCommand } = {}

function DevService:IsAllowed(player: Player?): boolean
	if IS_STUDIO then
		return true
	end
	return player ~= nil and Constants.ADMIN_USER_IDS[player.UserId] == true
end

function DevService:Register(name: string, command: Types.DevCommand)
	assert(type(name) == "string" and string.find(name, "^[%w_%.%-]+$"), "DevService: command names are words")
	assert(commands[name] == nil, `DevService: command {name} is already registered`)
	assert(type(command.Run) == "function" and type(command.Description) == "string", "DevService: bad command")
	commands[name] = command
end

-- Runs a command for a player (nil = Studio tooling). Returns ok and the output text.
function DevService:Execute(player: Player?, name: string, args: { any }): (boolean, string)
	if not DevService:IsAllowed(player) then
		return false, "not allowed"
	end
	local command = commands[name]
	if not command then
		return false, `no command {name}; try help`
	end
	local who = if player then player.Name else "studio"
	local shown = {}
	for _, arg in args do
		table.insert(shown, tostring(arg))
	end
	log:Info("%s ran %s %s", who, name, table.concat(shown, " "))
	local ok, result = xpcall(command.Run, debug.traceback, player, args)
	if not ok then
		log:Error("%s failed: %s", name, tostring(result))
		return false, `{name} failed: {tostring(result)}`
	end
	local text = if result == nil then "done" else tostring(result)
	if #text > MAX_OUTPUT then
		text = string.sub(text, 1, MAX_OUTPUT) .. "\n...(cut)"
	end
	return true, text
end

local function splitLine(line: string): (string, { any })
	local words = {}
	for word in string.gmatch(line, "%S+") do
		local number = tonumber(word)
		if word == "true" then
			table.insert(words, true)
		elseif word == "false" then
			table.insert(words, false)
		elseif number ~= nil and number == number and math.abs(number) ~= math.huge then
			table.insert(words, number)
		else
			table.insert(words, word)
		end
	end
	local name = table.remove(words, 1)
	return tostring(name or "help"), words
end

local function runChecks(): string
	local DevTools = ServerScriptService:FindFirstChild("DevTools")
	if not DevTools then
		return "DevTools folder missing"
	end
	local lines = {}
	local structure = require(DevTools:FindFirstChild("StructureCheck") :: ModuleScript) :: any
	local tests = require(DevTools:FindFirstChild("DataTests") :: ModuleScript) :: any
	table.insert(lines, structure.Format(structure.Run({ Runtime = true })))
	table.insert(lines, tests.Format(tests.Run()))
	return table.concat(lines, "\n")
end

local function registerBuiltIns()
	DevService:Register("help", {
		Description = "List commands.",
		Run = function(): string?
			local lines = {}
			for _, name in TableUtil.SortedKeys(commands) do
				local command = commands[name]
				table.insert(lines, `{command.Usage or name}: {command.Description}`)
			end
			return table.concat(lines, "\n")
		end,
	})
	DevService:Register("version", {
		Description = "Build, place and server.",
		Run = function(): string?
			return `{Constants.GAME_NAME} {BuildInfo.Label} | {Constants.PlaceKind()} | job {game.JobId} | Studio {IS_STUDIO}`
		end,
	})
	DevService:Register("ping", {
		Description = "Round trip check.",
		Run = function(player: Player?): string?
			local who = if player then player.Name else "studio"
			return `pong {who} at {string.format("%.3f", workspace:GetServerTimeNow())}`
		end,
	})
	DevService:Register("structure", {
		Description = "Run StructureCheck (instances, scripts, remotes, config).",
		Run = function(): string?
			local DevTools = ServerScriptService:FindFirstChild("DevTools")
			local structure = require((DevTools :: Instance):FindFirstChild("StructureCheck") :: ModuleScript) :: any
			return structure.Format(structure.Run({ Runtime = true }))
		end,
	})
	DevService:Register("test", {
		Description = "Run the data tests.",
		Usage = "test [name filter]",
		Run = function(_player: Player?, args: { any }): string?
			local DevTools = ServerScriptService:FindFirstChild("DevTools")
			local tests = require((DevTools :: Instance):FindFirstChild("DataTests") :: ModuleScript) :: any
			return tests.Format(tests.Run(if args[1] then tostring(args[1]) else nil))
		end,
	})
	DevService:Register("log", {
		Description = "Show or set the server log level (Debug, Info, Warn, Error).",
		Usage = "log [level]",
		Run = function(_player: Player?, args: { any }): string?
			local level = args[1]
			if level ~= nil then
				if not Log.IsLevel(level) then
					return "levels: Debug, Info, Warn, Error"
				end
				Log.SetLevel(level :: Log.Level)
			end
			return `server log level {Log.GetLevel()}`
		end,
	})
	DevService:Register("logs", {
		Description = "The last server log lines.",
		Usage = "logs [count]",
		Run = function(_player: Player?, args: { any }): string?
			local count = if type(args[1]) == "number" then args[1] else 20
			return table.concat(Log.Recent(count), "\n")
		end,
	})
	DevService:Register("remotes", {
		Description = "Traffic and rejections per remote.",
		Run = function(): string?
			local lines = {}
			local stats = Remotes.Stats()
			for _, name in TableUtil.SortedKeys(stats) do
				local s = stats[name]
				table.insert(
					lines,
					`{name}: received {s.Received}, rejected {s.Rejected}, rate-limited {s.Limited}, failed {s.Failed}`
				)
			end
			return table.concat(lines, "\n")
		end,
	})
	DevService:Register("players", {
		Description = "Players and their session state.",
		Run = function(): string?
			local lines = {}
			for _, player in Players:GetPlayers() do
				table.insert(
					lines,
					`{player.Name} ({player.UserId}) ready={tostring(player:GetAttribute("ClientReady") == true)}`
				)
			end
			return if #lines > 0 then table.concat(lines, "\n") else "no players"
		end,
	})
end

function DevService:Init(_registry)
	registerBuiltIns()
	Remotes.OnServer("DevCommand", function(player: Player, name: string, args: { any })
		local ok, text = DevService:Execute(player, name, args)
		if not ok and text == "not allowed" then
			log:Warn("%s (%d) tried dev command %s without permission", player.Name, player.UserId, name)
			return
		end
		local prefix = if ok then "" else "error: "
		Remotes.FireClient("Notice", player, prefix .. text)
	end)
end

function DevService:Start()
	local function mark(player: Player)
		player:SetAttribute("DevAllowed", DevService:IsAllowed(player))
	end
	Players.PlayerAdded:Connect(mark)
	for _, player in Players:GetPlayers() do
		mark(player)
	end

	if IS_STUDIO then
		local DevTools = ServerScriptService:FindFirstChild("DevTools")
		if DevTools then
			local invoke = Instance.new("BindableFunction")
			invoke.Name = "Invoke"
			invoke.OnInvoke = function(line: any, ...: any): string
				if type(line) ~= "string" then
					return "usage: Invoke:Invoke(\"command arg1 arg2\")"
				end
				local name, args = splitLine(line)
				for _, extra in { ... } do
					table.insert(args, extra)
				end
				local ok, text = DevService:Execute(nil, name, args)
				return (if ok then "" else "error: ") .. text
			end
			invoke.Parent = DevTools
			if DevTools:GetAttribute("RunChecksOnStart") ~= false then
				task.defer(function()
					log:Info("Studio start checks:\n%s", runChecks())
				end)
			end
		end
	end
end

return DevService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000046"><Properties><string name="Name">ProfileService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ProfileService: saved data (bible Section 23; Prompt 2). One profile per player, in both
	places.

	The stored value is a record { Data = profile, Lock = { Session, PlaceId, At }, Meta }.
	Every read-modify-write goes through UpdateAsync:
	* load claims the lock: a fresh lock held by another server means wait and retry (it may
	  be saving on the way out, as when a player teleports from the Lobby), and in the end
	  refuse; a stale lock (a crashed server) is taken over. Data newer than this server's
	  ProfileSchema.VERSION is never loaded or written.
	* the profile then goes through migrate, reconcile, validate (ProfileSchema.Load). A failed
	  or refused load kicks the player with a message and writes nothing.
	* saves happen every Constants.AUTOSAVE_SECONDS (staggered per player; each also refreshes
	  the lock), when the player leaves (and releases the lock) and on shutdown (BindToClose).
	  A save only writes if this server still holds the lock and the profile still validates.

	Gameplay never touches DataStores: it calls Update, AddGlowshards, SpendGlowshards and
	GrantPurchase. The player's own client sees their profile (minus receipts) in the
	"Profiles" collection of the delta channel. A session isn't ready until the profile loads
	(the "Profile" gate in SessionService).

	In Studio the store is PlayerProfiles_Studio, so tests never touch live saves; if Studio
	has no API access, an in-memory store stands in (and says so).
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")

local Shared = ReplicatedStorage.Shared
local Constants = require(Shared.Constants)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local TableUtil = require(Shared.Utilities.TableUtil)
local ProfileSchema = require(ServerScriptService:WaitForChild("Lib"):WaitForChild("ProfileSchema"))

local log = Log.new("ProfileService")

local IS_STUDIO = RunService:IsStudio()
local STORE_NAME = if IS_STUDIO then "PlayerProfiles_Studio" else "PlayerProfiles"
local SESSION_ID = if game.JobId ~= "" then game.JobId else "studio-" .. HttpService:GenerateGUID(false)
local LOCK_STALE_SECONDS = if IS_STUDIO then 30 else Constants.AUTOSAVE_SECONDS * 3
local CLAIM_ATTEMPTS = 8
local CLAIM_WAIT_SECONDS = 2
local CALL_ATTEMPTS = 4
local SHUTDOWN_WAIT_SECONDS = if IS_STUDIO then 8 else 25
local GATE = "Profile"

local MESSAGES: { [string]: string } = {
	Locked = "Your save is still being written by another server. Please rejoin in a moment.",
	TooNew = "Your save is from a newer version of the game. Please rejoin to get an up-to-date server.",
	Corrupt = "We couldn't read your save, so nothing was changed. Please rejoin; if this keeps happening, let us know.",
	Invalid = "We couldn't read your save, so nothing was changed. Please rejoin; if this keeps happening, let us know.",
	Error = "Saved data is unavailable right now (Roblox DataStores). Please rejoin in a few minutes.",
	LockLost = "Your save was opened in another server, so this one stopped. Please rejoin.",
}

export type Profile = { [string]: any }

type Session = {
	Player: Player,
	Key: string,
	Data: Profile,
	Receipts: { [string]: boolean },
	Saving: boolean,
	Released: boolean,
	LockLost: boolean,
	NextSave: number,
	Saves: number,
}

local ProfileService = {
	Name = "ProfileService",
	Dependencies = { "SessionService", "ReplicationService", "DevService" },
	Loaded = Signal.new() :: Signal.Signal<Player, Profile>,
	Releasing = Signal.new() :: Signal.Signal<Player>,
}

local sessions: { [Player]: Session } = {}
local loading: { [Player]: boolean } = {}
local sessionService: any = nil
local profiles: any = nil
local store: any = nil
local storeKind = "none"
local usingDataStore = false
local shuttingDown = false
local releasesInFlight = 0

-- An in-memory store with DataStore semantics (values go through JSON, as they would).
local function memoryStore(): any
	local values: { [string]: string } = {}
	local memory = {}
	function memory.UpdateAsync(_self: any, key: string, transform: (any) -> any): any
		local current = values[key]
		local result = transform(if current then HttpService:JSONDecode(current) else nil)
		if result ~= nil then
			values[key] = HttpService:JSONEncode(result)
		end
		return result
	end
	function memory.GetAsync(_self: any, key: string): any
		local current = values[key]
		return if current then HttpService:JSONDecode(current) else nil
	end
	function memory.RemoveAsync(_self: any, key: string): any
		local current = values[key]
		values[key] = nil
		return if current then HttpService:JSONDecode(current) else nil
	end
	return memory
end

local function keyFor(userId: number): string
	return `Player_{userId}`
end

-- Calls a DataStore function with retries and backoff. Returns ok and its result or error.
local function attempt(what: string, call: () -> any): (boolean, any)
	local delay = 1
	local lastError: any = nil
	for try = 1, CALL_ATTEMPTS do
		local ok, result = pcall(call)
		if ok then
			return true, result
		end
		lastError = result
		log:Warn("%s failed (try %d of %d): %s", what, try, CALL_ATTEMPTS, tostring(result))
		if try < CALL_ATTEMPTS then
			task.wait(delay)
			delay = math.min(delay * 2, 8)
		end
	end
	return false, lastError
end

local function isForeignLock(lock: any): boolean
	return type(lock) == "table"
		and lock.Session ~= SESSION_ID
		and type(lock.At) == "number"
		and os.time() - lock.At < LOCK_STALE_SECONDS
end

local function isTooNew(data: any): boolean
	return type(data) == "table" and type(data.Version) == "number" and data.Version > ProfileSchema.VERSION
end

-- Claims a key's lock. Returns "Claimed" and the stored Data (nil for a new player), or
-- "Locked", "TooNew", "Corrupt" or "Error" (and the error).
local function claim(key: string): (string, any)
	local status, stored = "Error", nil
	local ok, err = attempt(`claim {key}`, function(): any
		status, stored = "Error", nil
		return store:UpdateAsync(key, function(old: any): any
			if old ~= nil and (type(old) ~= "table" or (old.Data ~= nil and type(old.Data) ~= "table")) then
				status = "Corrupt"
				return nil
			end
			local record = old or {}
			if isForeignLock(record.Lock) then
				status = "Locked"
				return nil
			end
			if isTooNew(record.Data) then
				status = "TooNew"
				return nil
			end
			record.Lock = { Session = SESSION_ID, PlaceId = game.PlaceId, At = os.time() }
			if type(record.Meta) ~= "table" then
				record.Meta = { Created = os.time(), Saves = 0 }
			end
			status, stored = "Claimed", record.Data
			return record
		end)
	end)
	if not ok then
		return "Error", tostring(err)
	end
	return status, stored
end

-- Gives a lock back without touching the data (after a load we can't use).
local function releaseLockOnly(key: string)
	attempt(`release {key}`, function(): any
		return store:UpdateAsync(key, function(old: any): any
			if type(old) ~= "table" or type(old.Lock) ~= "table" or old.Lock.Session ~= SESSION_ID then
				return nil
			end
			old.Lock = nil
			return old
		end)
	end)
end

-- Writes the session's profile (and releases the lock if asked). Only if we still hold it.
local function write(session: Session, release: boolean): boolean
	local valid, why = ProfileSchema.Validate(session.Data)
	if not valid then
		log:Error("%s: not saving an invalid profile (%s)", session.Key, tostring(why))
		return false
	end
	local data = session.Data
	local status = "Error"
	local ok, err = attempt(`save {session.Key}`, function(): any
		status = "Error"
		return store:UpdateAsync(session.Key, function(old: any): any
			local record = if type(old) == "table" then old else {}
			local lock = record.Lock
			if type(lock) ~= "table" or lock.Session ~= SESSION_ID then
				status = "LockLost"
				return nil
			end
			if isTooNew(record.Data) then
				status = "TooNew"
				return nil
			end
			record.Data = data
			record.Lock = if release then nil else { Session = SESSION_ID, PlaceId = game.PlaceId, At = os.time() }
			local meta = if type(record.Meta) == "table" then record.Meta else {}
			meta.Saves = (tonumber(meta.Saves) or 0) + 1
			meta.LastSave = os.time()
			meta.LastPlace = game.PlaceId
			record.Meta = meta
			status = "Saved"
			return record
		end)
	end)
	if not ok then
		log:Error("couldn't save %s: %s", session.Key, tostring(err))
		return false
	end
	if status == "LockLost" then
		session.LockLost = true
		log:Error("%s: the save lock is gone; not writing over another server", session.Key)
		if session.Player.Parent == Players and not release then
			session.Player:Kick(MESSAGES.LockLost)
		end
		return false
	end
	if status ~= "Saved" then
		log:Error("%s: save refused (%s)", session.Key, status)
		return false
	end
	session.Saves += 1
	return true
end

-- One write at a time per player; a release waits for a running save, then finishes.
local function save(session: Session, release: boolean): boolean
	while session.Saving do
		task.wait(0.1)
	end
	if session.Released or session.LockLost then
		return false
	end
	session.Saving = true
	local ok = write(session, release)
	session.Saving = false
	session.NextSave = os.clock() + Constants.AUTOSAVE_SECONDS
	if release then
		session.Released = true
	end
	return ok
end

local function publish(session: Session)
	local key = tostring(session.Player.UserId)
	if profiles:Get(key) == nil then
		profiles:Set(key, ProfileSchema.Public(session.Data))
	else
		profiles:Patch(key, ProfileSchema.Public(session.Data))
	end
end

local function load(player: Player)
	if loading[player] or sessions[player] then
		return
	end
	loading[player] = true
	local key = keyFor(player.UserId)
	local status, stored = "Locked", nil
	for try = 1, CLAIM_ATTEMPTS do
		status, stored = claim(key)
		if status ~= "Locked" or player.Parent ~= Players then
			break
		end
		log:Info("%s's save is open in another server; waiting (%d of %d)", player.Name, try, CLAIM_ATTEMPTS)
		task.wait(CLAIM_WAIT_SECONDS)
	end
	loading[player] = nil
	if status ~= "Claimed" then
		log:Error("%s: profile not loaded (%s %s)", player.Name, status, tostring(stored))
		if player.Parent == Players then
			sessionService:Fail(player, MESSAGES[status] or MESSAGES.Error)
		end
		return
	end
	local data, loadStatus, why = ProfileSchema.Load(stored)
	if not data then
		releaseLockOnly(key)
		log:Error("%s: profile %s (%s); nothing written", player.Name, loadStatus, tostring(why))
		if player.Parent == Players then
			sessionService:Fail(player, MESSAGES[loadStatus] or MESSAGES.Invalid)
		end
		return
	end
	local session: Session = {
		Player = player,
		Key = key,
		Data = data,
		Receipts = {},
		Saving = false,
		Released = false,
		LockLost = false,
		NextSave = os.clock() + (player.UserId % Constants.AUTOSAVE_SECONDS) + 5,
		Saves = 0,
	}
	for _, receiptId in data.Receipts do
		session.Receipts[receiptId] = true
	end
	if player.Parent ~= Players then
		release(session) -- left while loading: write what we migrated and let go
		return
	end
	sessions[player] = session
	publish(session)
	player:SetAttribute("ProfileLoaded", true)
	log:Info("%s: profile %s, %d Glowshards", player.Name, loadStatus, data.Glowshards)
	ProfileService.Loaded:Fire(player, data)
	sessionService:Pass(player, GATE)
end

-- Saves and lets go of a session; shutdown waits for every release in flight.
local function release(session: Session)
	releasesInFlight += 1
	local ok, err = pcall(save, session, true)
	releasesInFlight -= 1
	if not ok then
		log:Error("%s: release failed: %s", session.Key, tostring(err))
	end
end

local function leave(player: Player)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	ProfileService.Releasing:Fire(player)
	profiles:Remove(tostring(player.UserId))
	release(session)
end

-- Public API --------------------------------------------------------------------------------

function ProfileService:IsLoaded(player: Player): boolean
	return sessions[player] ~= nil
end

-- The live profile (read it; change it only through Update).
function ProfileService:Get(player: Player): Profile?
	local session = sessions[player]
	return if session then session.Data else nil
end

--[[
	Changes a profile. `change` edits the table it is given and must not yield. If it errors or
	leaves the profile invalid, every change is undone and Update returns false. Changes are
	replicated to the player and saved with the next save.
]]
function ProfileService:Update(player: Player, change: (Profile) -> ()): boolean
	local session = sessions[player]
	if not session or session.Released then
		return false
	end
	local data = session.Data
	local backup = TableUtil.DeepCopy(data)
	local ok, err = pcall(change, data)
	local valid, why = true, nil
	if ok then
		valid, why = ProfileSchema.Validate(data)
	end
	if not ok or not valid then
		table.clear(data)
		for field, value in backup do
			data[field] = value
		end
		log:Error("%s: profile change undone (%s)", player.Name, tostring(if ok then why else err))
		return false
	end
	publish(session)
	return true
end

function ProfileService:AddGlowshards(player: Player, amount: number, reason: string): boolean
	assert(amount >= 0 and amount % 1 == 0, "AddGlowshards: a whole, positive amount")
	local ok = ProfileService:Update(player, function(data)
		data.Glowshards += amount
	end)
	if ok then
		log:Info("%s +%d Glowshards (%s)", player.Name, amount, reason)
	end
	return ok
end

-- Spends Glowshards if the player has enough. Returns false (and changes nothing) otherwise.
function ProfileService:SpendGlowshards(player: Player, amount: number, reason: string): boolean
	assert(amount >= 0 and amount % 1 == 0, "SpendGlowshards: a whole, positive amount")
	local data = ProfileService:Get(player)
	if not data or data.Glowshards < amount then
		return false
	end
	local ok = ProfileService:Update(player, function(profile)
		profile.Glowshards -= amount
	end)
	if ok then
		log:Info("%s -%d Glowshards (%s)", player.Name, amount, reason)
	end
	return ok
end

-- Saves now (yields). True when the profile is safely stored.
function ProfileService:SaveNow(player: Player): boolean
	local session = sessions[player]
	return session ~= nil and save(session, false)
end

function ProfileService:HasReceipt(player: Player, receiptId: string): boolean
	local session = sessions[player]
	return session ~= nil and session.Receipts[receiptId] == true
end

--[[
	For ProcessReceipt (bible Section 17): grant first, record the receipt id in the profile,
	save, and only then tell Roblox it was granted. A repeated receipt is never granted twice:
	if the id is already recorded, the grant is skipped and only the save is redone.
]]
function ProfileService:GrantPurchase(player: Player, receiptId: string, grant: (Profile) -> ()): Enum.ProductPurchaseDecision
	local session = sessions[player]
	if not session then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not session.Receipts[receiptId] then
		local ok = ProfileService:Update(player, function(data)
			grant(data)
			ProfileSchema.AddReceipt(data, receiptId)
		end)
		if not ok then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		session.Receipts[receiptId] = true
	end
	if save(session, false) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

-- DevTools ---------------------------------------------------------------------------------

local function targetOf(player: Player?, arg: any): Player?
	if type(arg) == "number" then
		return Players:GetPlayerByUserId(arg)
	end
	return player or Players:GetPlayers()[1]
end

local function summary(data: Profile): string
	local classes = TableUtil.SortedKeys(data.Classes)
	local legends = TableUtil.SortedKeys(data.Legends)
	return `v{data.Version}, {data.Glowshards} Glowshards, account level {data.AccountLevel}, `
		.. `classes {table.concat(classes :: { any }, "/")}, Legends {table.concat(legends :: { any }, "/")}, `
		.. `receipts {#data.Receipts}, first run done {tostring(data.FirstRunDone)}`
end

-- Runs the lock rules against a scratch key (Studio store only).
local function lockTest(): string
	local key = `Test_{SESSION_ID}`
	local lines = {}
	local function step(name: string, expected: string, got: string)
		table.insert(lines, `{if got == expected then "ok  " else "FAIL"} {name}: {got} (expected {expected})`)
	end
	store:RemoveAsync(key)
	step("new key", "Claimed", (claim(key)))
	store:UpdateAsync(key, function(old: any): any
		old.Lock = { Session = "another-server", PlaceId = 1, At = os.time() }
		return old
	end)
	step("fresh foreign lock", "Locked", (claim(key)))
	store:UpdateAsync(key, function(old: any): any
		old.Lock.At = os.time() - LOCK_STALE_SECONDS - 5
		return old
	end)
	step("stale foreign lock", "Claimed", (claim(key)))
	store:UpdateAsync(key, function(_old: any): any
		return { Data = { Version = ProfileSchema.VERSION + 1, Glowshards = 7 } }
	end)
	step("newer version", "TooNew", (claim(key)))
	local after = store:GetAsync(key)
	step("newer data untouched", "untouched", if after.Lock == nil and after.Data.Glowshards == 7 then "untouched" else "changed")
	store:UpdateAsync(key, function(_old: any): any
		return "garbage"
	end)
	step("corrupt record", "Corrupt", (claim(key)))
	store:RemoveAsync(key)
	return table.concat(lines, "\n")
end

local function registerCommands(dev: any)
	dev:Register("profile", {
		Description = "A player's profile (yours, or by user id).",
		Usage = "profile [userId]",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			local data = target and ProfileService:Get(target)
			if not target or not data then
				return "no loaded profile"
			end
			local session = sessions[target] :: Session
			return `{target.Name}: {summary(data)} | store {storeKind}, saves {session.Saves}`
		end,
	})
	dev:Register("profile.add", {
		Description = "Give Glowshards (testing).",
		Usage = "profile.add <amount> [userId]",
		Run = function(player: Player?, args: { any }): string?
			local amount = tonumber(args[1])
			local target = targetOf(player, args[2])
			if not amount or amount < 0 or amount % 1 ~= 0 or not target then
				return "usage: profile.add <whole amount> [userId]"
			end
			local ok = ProfileService:AddGlowshards(target, amount, "dev command")
			return if ok then `{target.Name} now has {(ProfileService:Get(target) :: Profile).Glowshards}` else "failed"
		end,
	})
	dev:Register("profile.save", {
		Description = "Save a profile now.",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			if not target then
				return "no player"
			end
			return if ProfileService:SaveNow(target) then `saved {target.Name}` else "save failed (see logs)"
		end,
	})
	dev:Register("profile.raw", {
		Description = "Read a stored record straight from the store (read-only).",
		Usage = "profile.raw [userId]",
		Run = function(player: Player?, args: { any }): string?
			local target = targetOf(player, args[1])
			local userId = if type(args[1]) == "number" then args[1] else target and target.UserId
			if not userId then
				return "no player"
			end
			local ok, record = attempt("read", function(): any
				return store:GetAsync(keyFor(userId))
			end)
			if not ok then
				return `read failed: {tostring(record)}`
			end
			if record == nil then
				return "no record"
			end
			local lock = record.Lock
			local lockText = if type(lock) == "table"
				then `{if lock.Session == SESSION_ID then "this server" else tostring(lock.Session)}, {os.time() - (lock.At or 0)} s ago`
				else "none"
			local data = record.Data
			local dataText = if type(data) == "table" then summary(data) else "no data yet"
			local meta = record.Meta or {}
			return `lock: {lockText} | saves {tostring(meta.Saves)} | {dataText}`
		end,
	})
	dev:Register("profile.receipt", {
		Description = "Grant a test purchase through the receipt path (Studio only).",
		Usage = "profile.receipt <receiptId> <glowshards>",
		Run = function(player: Player?, args: { any }): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			local target = targetOf(player, nil)
			local receiptId, amount = tostring(args[1] or ""), tonumber(args[2])
			if not target or receiptId == "" or not amount or amount < 0 or amount % 1 ~= 0 then
				return "usage: profile.receipt <receiptId> <whole amount>"
			end
			local decision = ProfileService:GrantPurchase(target, receiptId, function(data)
				data.Glowshards += amount
			end)
			return `{decision.Name}; {target.Name} has {(ProfileService:Get(target) :: Profile).Glowshards} Glowshards`
		end,
	})
	dev:Register("profile.locktest", {
		Description = "Run the lock rules against a scratch key (Studio only).",
		Run = function(): string?
			if not IS_STUDIO then
				return "Studio only"
			end
			return lockTest()
		end,
	})
end

-- Lifecycle --------------------------------------------------------------------------------

function ProfileService:Init(registry)
	sessionService = registry.SessionService
	sessionService:AddGate(GATE)
	profiles = registry.ReplicationService:Collection("Profiles", {
		Visible = function(player: Player, key: string): boolean
			return key == tostring(player.UserId)
		end,
	})
	registerCommands(registry.DevService)
end

function ProfileService:Start()
	local ok, result = pcall(function(): any
		local dataStore = DataStoreService:GetDataStore(STORE_NAME)
		dataStore:GetAsync("Probe")
		return dataStore
	end)
	if ok then
		store, storeKind, usingDataStore = result, `DataStore {STORE_NAME}`, true
	elseif IS_STUDIO then
		store, storeKind = memoryStore(), "memory (Studio has no DataStore access)"
		log:Warn("DataStores unavailable in this Studio session (%s): profiles live in memory only", tostring(result))
	else
		store, storeKind, usingDataStore = DataStoreService:GetDataStore(STORE_NAME), `DataStore {STORE_NAME}`, true
		log:Error("DataStore probe failed (%s); loads will retry", tostring(result))
	end
	log:Info("profiles in %s", storeKind)

	Players.PlayerAdded:Connect(load)
	for _, player in Players:GetPlayers() do
		task.spawn(load, player)
	end
	Players.PlayerRemoving:Connect(leave)

	game:BindToClose(function()
		shuttingDown = true
		for player, session in sessions do
			sessions[player] = nil
			task.spawn(release, session)
		end
		local waited = 0
		while (releasesInFlight > 0 or next(loading) ~= nil) and waited < SHUTDOWN_WAIT_SECONDS do
			waited += task.wait(0.2)
		end
		log:Info("shutdown: profiles released (%d still in flight after %.1f s)", releasesInFlight, waited)
	end)

	task.spawn(function()
		while not shuttingDown do
			task.wait(5)
			local now = os.clock()
			local budget = if usingDataStore
				then DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.UpdateAsync)
				else math.huge
			for _, session in sessions do
				if budget > 10 and not session.Saving and now >= session.NextSave then
					budget -= 1
					task.spawn(save, session, false)
				end
			end
		end
	end)
end

return ProfileService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000047"><Properties><string name="Name">ReplicationService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ReplicationService: the server end of the delta channel (bible Section 23: collections
	such as rooms, residents and votes go through one delta channel; small values replicate
	as attributes instead).

	A system keeps its replicated state in collections:

		local Rooms = ReplicationService:Collection("Rooms")
		Rooms:Set("R12", { Kind = "Kitchen", Level = 1, Cell = { 2, 3 } })
		Rooms:Patch("R12", { Level = 2 })          -- only Level travels
		Rooms:Remove("R12")

	Changes are batched and flushed Constants.DELTA_HZ times a second to every ready player
	(SessionService); a player who becomes ready first gets a snapshot. Values must be
	remote-safe (Utilities.Delta.IsRemoteSafe); they are copied and frozen when set, so later
	edits to the caller's table can't leak into replicated state.

	A collection can be per-player with `Visible = function(player, key) -> boolean`
	(an inventory only its owner sees). Clients read collections through ReplicaController.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage.Shared
local Constants = require(Shared.Constants)
local Delta = require(Shared.Utilities.Delta)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local TableUtil = require(Shared.Utilities.TableUtil)

local log = Log.new("ReplicationService")
local IS_STUDIO = RunService:IsStudio()

export type CollectionOptions = {
	Visible: ((player: Player, key: string) -> boolean)?,
}

export type Collection = {
	Name: string,
	Set: (self: Collection, key: string, value: any) -> (),
	Patch: (self: Collection, key: string, fields: { [string]: any }) -> (),
	Remove: (self: Collection, key: string) -> (),
	Clear: (self: Collection) -> (),
	Get: (self: Collection, key: string) -> any,
	All: (self: Collection) -> { [string]: any },
	Count: (self: Collection) -> number,
}

type State = {
	Name: string,
	Values: { [string]: any },
	Visible: ((player: Player, key: string) -> boolean)?,
}

local ReplicationService = {
	Name = "ReplicationService",
	Dependencies = { "SessionService", "DevService" },
}

local states: { [string]: State } = {}
local collections: { [string]: Collection } = {}
local pending: { Delta.Op } = {}
local counters = { Flushes = 0, OpsQueued = 0, EventsSent = 0, Snapshots = 0 }
local sessions: any = nil

local function queue(op: Delta.Op)
	table.insert(pending, op)
	counters.OpsQueued += 1
end

local function assertKey(state: State, key: any)
	if type(key) ~= "string" or key == "" then
		error(`{state.Name}: keys must be non-empty strings, got {tostring(key)}`, 3)
	end
end

local function assertSafe(state: State, key: string, value: any)
	local ok, why = Delta.IsRemoteSafe(value)
	if not ok then
		local message = `{state.Name}.{key} can't replicate: {why}`
		if IS_STUDIO then
			error(message, 3)
		end
		log:Error("%s", message)
	end
end

local CollectionClass = {}
CollectionClass.__index = CollectionClass

function CollectionClass.Set(self: any, key: string, value: any)
	local state: State = self._state
	assertKey(state, key)
	if value == nil then
		CollectionClass.Remove(self, key)
		return
	end
	assertSafe(state, key, value)
	if TableUtil.DeepEqual(state.Values[key], value) then
		return
	end
	local frozen = TableUtil.DeepFreeze(TableUtil.DeepCopy(value))
	state.Values[key] = frozen
	queue({ Delta.SET, state.Name, key, frozen })
end

function CollectionClass.Patch(self: any, key: string, fields: { [string]: any })
	local state: State = self._state
	assertKey(state, key)
	local old = state.Values[key]
	if type(old) ~= "table" then
		error(`{state.Name}.{key}: Patch needs an existing table value (use Set first)`, 2)
	end
	assertSafe(state, key, fields)
	local merged = Delta.Merge(old, TableUtil.DeepCopy(fields))
	local diff = Delta.Diff(old, merged)
	if not diff then
		return
	end
	state.Values[key] = TableUtil.DeepFreeze(merged)
	queue({ Delta.PATCH, state.Name, key, TableUtil.DeepFreeze(diff) })
end

function CollectionClass.Remove(self: any, key: string)
	local state: State = self._state
	assertKey(state, key)
	if state.Values[key] == nil then
		return
	end
	state.Values[key] = nil
	queue({ Delta.REMOVE, state.Name, key })
end

function CollectionClass.Clear(self: any)
	local state: State = self._state
	if next(state.Values) == nil then
		return
	end
	table.clear(state.Values)
	queue({ Delta.CLEAR, state.Name })
end

function CollectionClass.Get(self: any, key: string): any
	return self._state.Values[key]
end

-- A shallow copy of the whole collection (the values themselves are frozen).
function CollectionClass.All(self: any): { [string]: any }
	return table.clone(self._state.Values)
end

function CollectionClass.Count(self: any): number
	return TableUtil.Count(self._state.Values)
end

-- The named collection, created on first use. Options only apply when it's created.
function ReplicationService:Collection(name: string, options: CollectionOptions?): Collection
	assert(type(name) == "string" and string.find(name, "^[%a_][%w_]*$"), "Collection names are identifiers")
	local existing = collections[name]
	if existing then
		if options and options.Visible ~= states[name].Visible then
			error(`Collection {name} already exists with other options`, 2)
		end
		return existing
	end
	local state: State = { Name = name, Values = {}, Visible = options and options.Visible }
	states[name] = state
	local collection: Collection = setmetatable({ Name = name, _state = state }, CollectionClass) :: any
	collections[name] = collection
	return collection
end

local function visibleOps(player: Player, ops: { Delta.Op }): { Delta.Op }
	local list = {}
	for _, op in ops do
		local state = states[op[2]]
		local visible = state and state.Visible
		if visible == nil or op[1] == Delta.CLEAR then
			table.insert(list, op)
		else
			local ok, result = pcall(visible, player, op[3])
			if ok and result then
				table.insert(list, op)
			elseif not ok then
				log:Error("%s.Visible failed: %s", op[2], tostring(result))
			end
		end
	end
	return list
end

local function snapshotFor(player: Player): { Delta.Op }
	local ops: { Delta.Op } = {}
	for _, name in TableUtil.SortedKeys(states) do
		local state = states[name]
		for key, value in state.Values do
			table.insert(ops, { Delta.SET, name, key, value })
		end
	end
	return visibleOps(player, ops)
end

local function flush()
	if #pending == 0 then
		return
	end
	local ops = pending
	pending = {}
	counters.Flushes += 1
	local players = sessions:ReadyPlayers()
	if #players == 0 then
		return
	end
	local anyPerPlayer = false
	for _, op in ops do
		local state = states[op[2]]
		if state and state.Visible then
			anyPerPlayer = true
			break
		end
	end
	if not anyPerPlayer then
		Remotes.FireClients("Delta", players, ops, false)
		counters.EventsSent += #players
		return
	end
	for _, player in players do
		local list = visibleOps(player, ops)
		if #list > 0 then
			Remotes.FireClient("Delta", player, list, false)
			counters.EventsSent += 1
		end
	end
end

function ReplicationService:Init(registry)
	sessions = registry.SessionService
	local dev = registry.DevService

	dev:Register("rep", {
		Description = "Delta channel: collections, sizes and traffic.",
		Run = function(_player: Player?, _args: { any }): string?
			local lines = {
				("flushes %d, ops queued %d, events sent %d, snapshots %d, pending %d"):format(
					counters.Flushes,
					counters.OpsQueued,
					counters.EventsSent,
					counters.Snapshots,
					#pending
				),
			}
			for _, name in TableUtil.SortedKeys(states) do
				local state = states[name]
				local scope = if state.Visible then " (per player)" else ""
				table.insert(lines, `  {name}: {TableUtil.Count(state.Values)} values{scope}`)
			end
			return table.concat(lines, "\n")
		end,
	})

	dev:Register("rep.selftest", {
		Description = "Runs set, patch and remove on the _SelfTest collection; compare with `/dev replica _SelfTest` on a client.",
		Run = function(_player: Player?, _args: { any }): string?
			local test = ReplicationService:Collection("_SelfTest")
			test:Clear()
			test:Set("Alpha", { Count = 1, Label = "first", Tags = { "a", "b" } })
			test:Patch("Alpha", { Count = 2, Label = Delta.NONE })
			test:Set("Beta", { Count = 10 })
			test:Remove("Beta")
			test:Set("Gamma", { Where = Vector3.new(1, 2, 3), Done = true })
			test:Set("Stamp", { At = workspace:GetServerTimeNow() })
			return "queued: Alpha {Count=2, Tags={a,b}}, Gamma {Where=1,2,3, Done=true}, Stamp; Beta removed"
		end,
	})
end

function ReplicationService:Start()
	sessions.PlayerReady:Connect(function(player: Player)
		local ops = snapshotFor(player)
		Remotes.FireClient("Delta", player, ops, true)
		counters.Snapshots += 1
		log:Debug("snapshot to %s: %d values", player.Name, #ops)
	end)
	local interval = 1 / Constants.DELTA_HZ
	local elapsed = 0
	RunService.Heartbeat:Connect(function(dt: number)
		elapsed += dt
		if elapsed >= interval then
			elapsed = 0
			flush()
		end
	end)
end

-- Server-side view of a collection's values (for DevTools and tests).
function ReplicationService:Peek(name: string): { [string]: any }?
	local state = states[name]
	return if state then table.clone(state.Values) else nil
end

return ReplicationService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000048"><Properties><string name="Name">SessionService</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SessionService: player sessions in this server (infrastructure, Prompt 0; gates Prompt 2).

	A player is "ready" once every gate has passed: the client has bootstrapped (the
	ClientReady remote) and each gate a service added (ProfileService adds "Profile": the save
	has loaded). Services that send a player state wait for PlayerReady instead of
	PlayerAdded, so nothing is sent before the client can receive it or before the player's
	data exists.

	API:
		SessionService:AddGate(name)           -- in Init: one more thing a session waits for
		SessionService:Pass(player, name)      -- that thing is done for this player
		SessionService:Fail(player, message)   -- it can't be done: the player is kicked
		SessionService.PlayerReady: Signal<Player>
		SessionService.PlayerLeaving: Signal<Player>
		SessionService:IsReady(player): boolean
		SessionService:ReadyPlayers(): { Player }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("SessionService")

local SessionService = {
	Name = "SessionService",
	Dependencies = {},
	PlayerReady = Signal.new() :: Signal.Signal<Player>,
	PlayerLeaving = Signal.new() :: Signal.Signal<Player>,
}

local CLIENT_GATE = "Client"
local gates: { string } = { CLIENT_GATE }
local passed: { [Player]: { [string]: boolean } } = {}
local ready: { [Player]: number } = {}

local function checkReady(player: Player)
	if ready[player] or player.Parent ~= Players then
		return
	end
	local done = passed[player]
	if not done then
		return
	end
	for _, gate in gates do
		if not done[gate] then
			return
		end
	end
	ready[player] = os.clock()
	player:SetAttribute("SessionReady", true)
	log:Debug("%s ready", player.Name)
	SessionService.PlayerReady:Fire(player)
end

function SessionService:AddGate(name: string)
	assert(not table.find(gates, name), `SessionService: gate {name} already exists`)
	table.insert(gates, name)
end

function SessionService:Pass(player: Player, gate: string)
	assert(table.find(gates, gate), `SessionService: no gate {gate}`)
	local done = passed[player]
	if not done then
		done = {}
		passed[player] = done
	end
	if done[gate] then
		return
	end
	done[gate] = true
	checkReady(player)
end

function SessionService:Fail(player: Player, message: string)
	log:Warn("%s can't start a session: %s", player.Name, message)
	player:Kick(message)
end

function SessionService:Init(_registry)
	Remotes.OnServer("ClientReady", function(player: Player)
		if player.Parent ~= Players then
			return
		end
		player:SetAttribute("ClientReady", true)
		SessionService:Pass(player, CLIENT_GATE)
	end)
end

function SessionService:Start()
	Players.PlayerRemoving:Connect(function(player: Player)
		SessionService.PlayerLeaving:Fire(player)
		ready[player] = nil
		passed[player] = nil
	end)
end

function SessionService:IsReady(player: Player): boolean
	return ready[player] ~= nil
end

function SessionService:ReadyPlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if ready[player] then
			table.insert(list, player)
		end
	end
	return list
end

-- Which gates a player has passed (for DevTools).
function SessionService:Gates(player: Player): { [string]: boolean }
	local result: { [string]: boolean } = {}
	local done = passed[player] or {}
	for _, gate in gates do
		result[gate] = done[gate] == true
	end
	return result
end

return SessionService
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX0000004B"><Properties><string name="Name">ServerStorage</string></Properties><Item class="Folder" referent="RBX0000004B"><Properties><string name="Name">Documentation</string></Properties><Item class="ModuleScript" referent="RBX0000004B"><Properties><string name="Name">ARCHITECTURE</string><ProtectedString name="Source"><![CDATA[--!strict
return [=[
# 100 Years Of Fallout: ARCHITECTURE

The living map of the code (bible Section 23). Every prompt updates it. The bible wins: if
this document, the code and the bible disagree, the bible is right and the difference is a
bug or a Bible Question.

## Places

| Place | Id | Players | Role |
|---|---|---|---|
| Lobby (start place) | 135073046693952 | 30 | hub, shops, Legends Hall, quests, leaderboards, elevator pads |
| Run (reserved servers) | 72892455946761 | 6 | the bunker, the surface and the Deep |

Both places run the same shared code, bootstraps and infrastructure services. Each adds its
own services and controllers on top (Run: RunDirector, BunkerGrid...; Lobby: PadService,
ClassShopService...). `Constants.PlaceKind()` says which place is running.

## Where code lives (both places)

```
ReplicatedStorage
  Shared                         (Folder) code both sides run
    BuildInfo                    which build is installed; written by the installer
    Constants                    identity and engine limits (never gameplay numbers)
    Types                        types that cross module or network boundaries
    Remotes                      the one list of RemoteEvents + the only API to use them
    RunState                     the run's small values, replicated as attributes on it (Run)
    Config                       content aggregator; one child ModuleScript per content type
    Rules                        pure game rules both sides share (Clock, Grid, Bunker, CameraRig)
    Utilities                    Check, Delta, Loader, Log, RateLimit, Signal, TableUtil, Trove
ServerScriptService
  Bootstrap                      (Script) the only server script
  Services                       one ModuleScript per service
  Lib                            server-only modules that aren't services (ProfileSchema; Run: BunkerKit)
  DevTools                       StructureCheck, DataTests (+ Invoke in Studio playtests)
StarterPlayer.StarterPlayerScripts
  ClientBootstrap                (LocalScript) the only client script
  Controllers                    one ModuleScript per controller
  Lib                            client-only modules that aren't controllers (Fade)
StarterGui
  Reticle                        the aim sight (built in Studio, studio/ui/Reticle.lua)
ServerStorage
  Documentation.ARCHITECTURE     this document
  Assets                         models from the art pipeline (Run)
  ArtPipeline.AssetSetup         art pipeline helper (Run; not game code)
```

Rules: only the two bootstraps are scripts; everything else is a ModuleScript. No `_G`, no
`shared`: modules `require` each other. Server-only code never goes in ReplicatedStorage.
Objects named `A0_...` (showroom, sample screens) are art-pipeline samples, allowed until
gameplay replaces them.

## Where code comes from

The source of truth is the repo `landonhjones2020-bit/100years-assets`, folder `game/`
(Rojo naming: `init.luau` makes the folder a module, `.server.luau` is a Script,
`.client.luau` a LocalScript). `game/shared`, `game/server`, `game/client` and `game/docs`
go to both places; `game/places/<Place>/...` only to that place.

`tools/game_sync.py build` turns the tree into one Model asset (`exports/Code/GameCode.rbxmx`,
holding a Lobby and a Run variant), which is uploaded through Open Cloud like the art and
installed into each place by the Luau that `tools/game_sync.py install <assetId> <Place>`
prints. The install replaces the managed folders wholesale and refuses to run if a script was
edited in Studio since the last install (StructureCheck's Sources check), so nothing written
in Studio is lost: bring such edits back into the repo first.

## Lifecycle

Server: `Bootstrap` → `Remotes.Setup()` → `Loader.Collect(Services)` → every `Init` in
dependency order → every `Start` on its own thread → `ReplicatedStorage` attributes
`PlaceKind`, `Build`, `ServerReady` (and `ServerBroken` if a service failed).

Client: `ClientBootstrap` → every controller's `Init`, then `Start` → waits for `ServerReady`
→ fires `ClientReady` → the server marks the session ready and sends the snapshot.

## Writing a service or controller

```lua
--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage.Shared
local Log = require(Shared.Utilities.Log)

local log = Log.new("CycleClock")

local CycleClock = {
	Name = "CycleClock",                 -- must equal the ModuleScript name
	Dependencies = { "DevService" },    -- only these can be read from the registry
}

function CycleClock:Init(registry)     -- wire up: remotes, signals, dev commands. No loops.
	registry.DevService:Register("year", { Description = "...", Run = function(player, args) ... end })
end

function CycleClock:Start()            -- runs after every Init: loops, timers, world state
end

return CycleClock
```

* Top-level code in a module has no side effects (StructureCheck requires modules at edit
  time to validate them). Do the work in `Init` and `Start`.
* `Init` must not yield or loop; it is timed and anything over 0.5 s is reported.
* A module whose `Init` errors is reported; modules depending on it are skipped, and the
  server sets `ServerBroken`.
* Talk across modules through methods and Signals the other module exposes, never by
  reaching into its internals.

## Networking

* Every RemoteEvent is an entry in `Shared.Remotes` (`To`, `Args`, `Rate`, `Doc`, and `Place`
  for remotes only one place has). Nothing else creates remotes; StructureCheck flags any that
  appear elsewhere.
* Clients send intentions (propose this room, fire at this point), never results. Each
  client → server remote checks every argument (`Utilities.Check`: finite numbers, valid
  UTF-8, lists without holes, shapes without unknown fields) and rate-limits each player
  before its handler runs. Handlers still check ownership, ranges and game state.
* Small values (year, resources, cycle phase) replicate as attributes.
* Collections (rooms, residents, votes...) go through the delta channel:
  `ReplicationService:Collection("Rooms")` with `Set`, `Patch`, `Remove`, `Clear` on the
  server, `ReplicaController:Get/All/Changed` on the client. Changes are batched and sent
  `Constants.DELTA_HZ` times a second; a player gets a snapshot when their session becomes
  ready. Values must be remote-safe (`Delta.IsRemoteSafe`): lists or string-keyed tables,
  finite numbers, no Instances, no functions. Per-player collections pass `Visible`.

## The run (Run place)

`RunDirector` owns the lifecycle and how a run ends; `CycleClock` owns cycles, phases, the year
counter, Years per Cycle and skips; `ObjectiveService` keeps the Lost Crews rescued and era
bosses beaten (bible Sections 4, 5 and 23). The century's arithmetic is `Shared.Rules.Clock`,
pure functions the data tests hold to the bible.

```
Waiting --first player ready--> Intro (30 s) --> Playing --> Ended --Keep Going--> Playing (Endless)
                                                    |  Day 3:00 (siren at 2:40) -> Surge 1:30 -> year jump -> next Day
```

* The run clock starts at the 30-second mark for everyone; skipping the cutscene is personal.
* Years per Cycle = 1 + the `YearsPerCycle` of every objective done (`Config.Objectives`: +2 a
  Lost Crew, +1 an era boss), at most 12. The year jumps at the end of each cycle.
* A jump that reaches or passes 25, 50 or 75 makes that era's boss the next Surge (once, unless
  already beaten). At 100 the year stops and the next Surge is the final one (the Source); when
  it ends the clock halts and RunDirector declares a Century Victory.
* Surges end when their time is up, or earlier through `CycleClock:EndSurge()` (ThreatDirector,
  when the last monster is dead and the disaster fixed). A boss Surge (an era boss or the final
  Surge) has no timer (`PhaseOpen`) and ignores EndSurge: it ends when its boss is beaten,
  `ObjectiveService:BossBeaten(bossId)` -> `BossDefeated` (Landon, 2026-11-08).
* Skips: when every player in the run has pressed Ready (`SetReady` remote) or rests in a
  Quarters bed (`CycleClock:SetResting`), the day jumps to the siren. Both count only during a
  day before the siren and both reset at the siren (Landon, 2026-11-08).
* Keep Going after any victory, even an early Deep Victory, starts Endless at once (Landon).
* Defeat: `RunDirector:Lose("ReactorDestroyed" | "ResidentsLost")`; Deep Victory:
  `RunDirector:Win("Deep")`; Keep Going: `RunDirector:KeepGoing()` (no more era bosses or year
  cap, Endless Surges). The results screen reads `RunDirector:Summary()`.
* Signals for other systems: `CycleClock.CycleStarted` (residents eat and drink), `YearChanged`
  (aging), `EraChanged`, `SirenStarted`, `SurgeStarted`, `SurgeEnded` (the blueprint draft),
  `Skipped`; `RunDirector.PhaseChanged`, `RunEnded`; `ObjectiveService.Changed`.

**RunState** (`Shared.RunState`): the run's small values, replicated as attributes on that
ModuleScript. Each has one writer, which gets a setter from `RunState.Writer(name)`; anyone
reads `RunState.Get`, `RunState.Changed`, `RunState.TimeLeft()` (times are server time, so
every client counts down to the same moment).

| Writer | Values |
|---|---|
| RunDirector | RunPhase, IntroEndsAt, Difficulty, Outcome, DefeatReason, Victory, Endless |
| CycleClock | Cycle, Year, Era, YearsPerCycle, CyclePhase, PhaseLength, PhaseEndsAt, PhaseLeft, PhaseOpen, Siren, SurgeKind, SurgeBoss, ReadyCount, ReadyNeeded, Paused, TimeScale |
| ObjectiveService | LostCrews, BossesBeaten |

Players carry `Ready` and `Resting` attributes (CycleClock). In Studio, set the attribute
`SkipIntro` on `ServerScriptService.DevTools` to true to start runs without the 30 s intro.

## The bunker (Run place)

`BunkerGrid` holds the run's bunker (bible Section 6): the data and rules are
`Shared.Rules.Bunker`, the geometry `Shared.Rules.Grid`, and `Lib.BunkerKit` builds the world.

* Cells: columns -6 to 6, floors 1 to 10 (the depth; floor 10 is the Source Chamber). Every cell
  is Rock, Dug or part of a room. Rooms are 1 to 3 cells side by side on one floor.
* Rules (Rules.Bunker): dig a Rock cell left of, right of or below an open cell; place a room
  on Dug cells (MaxCells, Unique, a room's own Floor, never in the Source Chamber); merge two
  matching rooms of one level side by side (never different levels); Fixed rooms (Blast Door,
  Reactor Core) never merge or go; levels 1 to 3. HP is per cell: `Tuning.Rooms.HP[level]`
  times the cells (Landon, 2026-11-08); a merged room keeps both rooms' HP. Votes, costs,
  build and dig times come from BuildService and DigService.
* The room graph: a node per room (`R3`) and per Dug cell (`D:2,3`); edges through doorways
  (side-by-side open cells of different units) and between stacked Shafts. A dug cell is a step
  when power counts steps from a Reactor Core or a Generator (Landon, 2026-11-08).
* The run starts with `Tuning.StartingBunker`: floor 1 Blast Door (2 cells), Shaft, Quarters
  (2 cells), a dug cell; floor 2 Kitchen, Water Purifier, Shaft, Reactor Core, Medbay, a dug
  cell; the Shafts in column 0, rock at column -3 (the bible's diagram).
* World (Rules.Grid): `Tuning.Grid.Origin` is the interior floor centre of floor 1, column 0
  (0, -120, 0). Cells repeat every 34 studs along +X and 18 down; the front, where the Command
  View camera sits, faces +Z. Art models face -Z: place them with `Grid.CellCFrame`.
* `workspace.Bunker` (built at server start, rebuilt around each change) from the A1 art in
  `ServerStorage.Assets.Kit` and `.Rooms`, each piece falling back to the Prompt 4 graybox when
  missing: `Frame` (a ring of rock cells), `Rock` (models named by cell key), `Dug` (models
  `D:<key>`), `Rooms` (models named by room id, with RoomId, RoomType, Floor, Column, Span,
  Level and Art attributes). Every unit is Persistent. Players spawn in the Medbay; the place's
  other spawns are disabled when the server starts.
* Tags: `FrontWall` (front wall parts: hidden in the Command View), `CameraFade` (furniture,
  the Blast Door set, the stair, vents, lamps, cave props: the camera passes through and fades
  them), `RoomLight` (PointLights, with a `Unit` attribute, for the power system). Floors,
  walls, ceilings and rock stop the camera.
* Gameplay points: each room's `Sockets` part holds an Attachment per socket of its art
  (WorkSpot1.., Bed1.., Seat1.., Core, Valve1.., FuseBox, Breaker, Tap, Bench, Respawn, Door,
  SurfaceExit, Vent, Lift, Chute, Top, Bottom, Light1..), numbered across the room's cells.
  Read them with `BunkerKit.Socket(model, name)` and `BunkerKit.Sockets(model, pattern)`.
* Replication: the `Cells` collection (`"floor,column"` -> `{ Room = id }`, `{}` when Dug) and
  the `Rooms` collection (id -> Type, Floor, Column, Span, Level, HP, MaxHP).

## The camera and input (both places)

`InputController` turns PC, touch and gamepad input into actions; `CameraController` is the
over-the-shoulder camera (bible Section 9); `Lib.Fade` makes world parts see-through on this
client only. The camera's geometry is `Shared.Rules.CameraRig`, its numbers `Tuning.Camera`.

* Actions follow the bible's controls table (`BINDINGS` in InputController). Listen with
  `InputController:On(action, began, ended)`; HUD touch buttons join with
  `BindButton(action, button)`. Moving and jumping stay Roblox's.
* Right shoulder by default; `SwapShoulder` (V, right stick click) swaps. `Aim` (right mouse,
  left trigger; Run place only) narrows the view 70 to 50, brings the camera in, slows walking
  and turns the character with the camera.
* Zoom caps: the wheel or a pinch zooms between `Distance.Min` and `Distance.Max`, at most
  `IndoorMax` in a bunker cell. A spherecast from the shoulder stops the camera at floors, walls,
  ceilings and rock (in at once, out gently); in a cell it also stays between the floor and the
  ceiling panels (not in a Shaft, which is open overhead).
* Wall fade: `FrontWall` and `CameraFade` parts never stop the camera and fade while they hide
  the character or touch the camera; characters and `CameraIgnore` are passed through. The
  local character fades when the camera reaches its head.
* PC: the mouse is locked to the centre and `StarterGui.Reticle` shows the sight.
  `CameraController:FreeCursor(reason, true)` frees it for menus; `Suspend(reason)` and
  `Resume(reason)` hand the camera to another view (Command View, cutscenes).
* Fallback: repeated errors stop the controller and give the camera to Roblox's, set to
  Invisicam in both places (`StarterPlayer.DevCameraOcclusionMode`); `EnableMouseLockOption` is
  off. StructureCheck checks both settings and the Reticle.

## Saved data

One profile per player (bible Section 23), shape and migrations in `Lib.ProfileSchema`, I/O in
`ProfileService`. The stored record is `{ Data, Lock, Meta }` in the `PlayerProfiles` DataStore
(`PlayerProfiles_Studio` in Studio, so tests never touch live saves), key `Player_<userId>`.

* Load claims the lock through UpdateAsync. A fresh lock from another server: wait and retry
  (8 tries, 2 s apart), then kick with a message. A stale lock (3 autosaves old; 30 s in
  Studio): taken over. A newer version: refused, nothing written. Then migrate, reconcile,
  validate; a failure kicks the player and writes nothing.
* Saves: every 120 s (staggered; refreshes the lock), on leaving (releases it) and on
  shutdown (BindToClose waits for every release). A save writes only if this server still
  holds the lock and the profile validates; losing the lock kicks the player.
* Gameplay calls `ProfileService:Update(player, fn)` (undone if it errors or leaves the profile
  invalid), `AddGlowshards`, `SpendGlowshards`, and `GrantPurchase(player, receiptId, grant)`
  for ProcessReceipt: grant, record the receipt, save, then report granted; a repeated
  receipt is never granted twice.
* The player's client reads its own profile (minus receipts) from the `Profiles` collection.
* A session isn't ready until its profile loads (SessionService gate `Profile`).
* Changing the shape: raise `ProfileSchema.VERSION`, add a migration, update `Default` and the
  shape. Old servers refuse newer saves, so a rolling update can't corrupt them.

## Content

All content is data in `Shared.Config` (bible Section 23). Each content type is a child
ModuleScript returning `{ Schema = Check.shape(...), Entries = { Id = entry }, Order = {...}? }`
(or `Schemas`, one checker per entry, for Tuning). Config validates every entry at load
(fields, ids, `Check.ref` cross-references), freezes it and adds `Id`. Read with
`Config.Get(type, id)` (errors if missing), `Config.Find` (for ids from players or saves),
`Config.All(type)`, `Config.Ids(type)`. Problems are listed by `Config.Errors()`, logged, and
fail StructureCheck and the data tests. `Config._Fields` holds checkers the content modules
share (modules starting with `_` are helpers, not types).

Content types (Prompt 1): Badges, Bosses, Classes, Conditions, DepthBands, DigResults,
Difficulties, Disasters, DraftCards, Eras, GamePasses, GlowshardPacks, GlowshardRewards,
ItemRarities, Items, Leaderboards, Legends, LootTables, Modifiers, MoraleStates, Monsters,
Objectives, Quests, Recipes, ResidentNames, Resources, Rooms, Stats, SurfaceLocations,
TalentSlots, TeamBoosts, Tiers, Traits, Tuning, Votes, WandererOutcomes.

**Effects are data.** Classes, traits, Legends, draft cards and passes describe what they do
as modifiers: `{ Key = "RoomOutput", Value = 1.25, Room = "Medbay", Scope = "Bunker" }`.
`Config.Modifiers` is the vocabulary: each key's unit (Multiplier, Add, Set, Flag, Chance),
default scope, and the prompt whose system applies it. A system reads the keys it owns; a new
effect is a new key plus the code that honours it.

**Rule numbers** live in `Config.Tuning`, one entry per system (Clock, Grid, StartingBunker,
Rooms, Votes, Player, Digging, Disturbance, Threat, Residents, Aging, Morale, Trader,
Wanderers, Expeditions, Surface, Legends, ClassShop, Account, Lobby).

## DevTools

* `/dev <command>` in chat for allowed players (everyone in Studio; outside Studio only the
  admins in `Constants.ADMIN_USER_IDS`); `/dev help` lists commands. Services add their own
  in `Init` with `DevService:Register`.
* In a Studio playtest: `ServerScriptService.DevTools.Invoke:Invoke("test")` on the server,
  `PlayerScripts.DevInvoke:Invoke("replica Rooms")` on a client.
* `structure`: StructureCheck. `test [filter]`: DataTests. Both run once whenever a Studio
  playtest starts (set the `RunChecksOnStart` attribute on DevTools to false to stop that).
* Other built-ins: `version`, `ping`, `players`, `remotes`, `log [level]`, `logs [count]`,
  `rep`, `rep.selftest`; on the client `replica <collection>`, `client`, `clock`,
  `ready [true|false]` (fires SetReady like the HUD button), `camera`, `camera.shoulder`,
  `camera.aim [bool]`, `camera.look <yaw> <pitch>`, `camera.zoom <studs>`, `camera.cursor`.
* The bunker (Run place): `grid` (map), `grid.rooms`, `grid.graph`, `grid.dig <floor> <column>`,
  `grid.build <Type> <floor> <column> [span] [level]`, `grid.remove <id>`, `grid.merge <id> <id>`,
  `grid.level <id> <level>`, `grid.rebuild`, `grid.sockets <id>`, `grid.art`.
* The run (Run place): `run`, `run.skipintro`, `run.win <century|deep>`,
  `run.lose <reactor|residents>`, `run.keepgoing`; `clock`, `clock.speed <x>`, `clock.pause`,
  `clock.resume`, `clock.next`, `clock.clear`, `boss.beat [bossId]`, `year <n>`,
  `ready.all [bool]`, `rest.all [bool]`; `objectives`, `objective <id>`.

## Conventions

* `--!strict` in every file. Tabs. PascalCase for modules, types, methods and content ids;
  camelCase for locals. Content ids: letters, digits and `_`, starting with a letter.
* Logging through `Utilities.Log` (`Log.new("Tag")`), never bare `print`.
* Tunables are content (Config); identity and engine limits are `Constants`.
* Every prompt ends with Design Notes and a Delivery Report in `game/reports/`.

## Services and controllers

| Place | Name | Kind | Depends on | Owns |
|---|---|---|---|---|
| both | SessionService | service | | player sessions: gates (client ready, profile loaded), ready, leaving |
| both | DevService | service | | DevTools commands and permission |
| both | ReplicationService | service | SessionService, DevService | the delta channel (server) |
| both | ProfileService | service | SessionService, ReplicationService, DevService | saved data: session-locked profiles, Glowshards, purchase receipts |
| Run | ObjectiveService | service | DevService | Lost Crews rescued, era bosses beaten, their Years per Cycle bonuses |
| Run | CycleClock | service | SessionService, ObjectiveService, DevService | 4:30 cycles, day and Surge phases, the year counter, Years per Cycle, skips |
| Run | RunDirector | service | SessionService, CycleClock, DevService | the run's lifecycle (intro, playing, ended), win and lose, Endless, the summary |
| Run | BunkerGrid | service | ReplicationService, DevService | cells, rooms, levels, merges, the room graph; builds `workspace.Bunker` |
| both | ReplicaController | controller | | the delta channel mirror (client) |
| both | InputController | controller | | devices, the bible's action bindings, look and zoom input |
| both | CameraController | controller | InputController, ReplicaController | the over-the-shoulder camera: shoulder, aim, zoom caps, wall fade, the mouse lock and reticle |
| both | DevController | controller | ReplicaController, CameraController | `/dev` chat command, Studio DevInvoke |

## Prompt log

* **Prompt 0 (2026-11-08)**: architecture foundation in both places. Shared modules, Config
  aggregator, remotes with validation and rate limits, the delta channel, bootstraps with
  declared dependencies, DevTools, this document. No gameplay.
* **Prompt 1 (2026-11-08)**: content definitions. 36 content types with schemas and the
  bible's starter data (provisional numbers marked), the modifier vocabulary, Tuning for
  every system, and data tests that hold the content to the bible.
* **Prompt 2 (2026-11-08)**: saved data. ProfileService with session locks, migrations,
  autosave, release and shutdown saves, purchase receipts; SessionService gates.
* **Prompt 3 (2026-11-08)**: the run lifecycle and the cycle clock (Run place). RunDirector,
  CycleClock, ObjectiveService, Shared.Rules.Clock, Shared.RunState, the SetReady remote,
  place-only remotes and code (`game/places/Run`); win and lose stubs for later prompts.
* **Prompt 4 (2026-11-08)**: the bunker grid (Run place). BunkerGrid, Rules.Grid, Rules.Bunker,
  Lib.BunkerKit (graybox kit), the starting bunker centred on the Shaft column as the bible's
  diagram draws it, the Cells and Rooms collections, spawning in the Medbay.
* **A1 in the bunker (2026-11-08)**: BunkerKit builds from the art kit (graybox fallback per
  piece), a Sockets part per room, room lights, vents, the frame as rock cells.
* **Prompt 5 (2026-11-08)**: the over-the-shoulder camera with wall fade and zoom caps
  (CameraController, InputController, Lib.Fade, Rules.CameraRig, StarterGui.Reticle) in both
  places. Landon's answers to the Prompt 3 and 4 questions: boss Surges and the final Surge run
  until the boss is beaten, resting resets at the siren, HP per cell, dug cells count as power
  steps.
]=]
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="RBX00000054"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX0000004D"><Properties><string name="Name">ClientBootstrap</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ClientBootstrap: the only LocalScript (bible Section 23). It loads every controller in
	the Controllers folder beside it, runs every Init in dependency order and then every
	Start, waits for the server to be ready and tells it the client is ready (ClientReady),
	which makes the server send the replication snapshot.

	Never add another LocalScript: write a controller (see Documentation.ARCHITECTURE).
]]

local began = os.clock()

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Utilities = Shared:WaitForChild("Utilities")
local Loader = require(Utilities:WaitForChild("Loader"))
local Log = require(Utilities:WaitForChild("Log"))
local Remotes = require(Shared:WaitForChild("Remotes"))

local SERVER_WAIT_SECONDS = 30

local log = Log.new("ClientBootstrap")

local controllers = Loader.Collect(script.Parent:WaitForChild("Controllers"), "Controller")
local report = Loader.Run(controllers, log)

local waited = 0
while ReplicatedStorage:GetAttribute("ServerReady") ~= true and waited < SERVER_WAIT_SECONDS do
	waited += task.wait(0.1)
end
if ReplicatedStorage:GetAttribute("ServerReady") ~= true then
	log:Warn("the server isn't ready after %d s; continuing", SERVER_WAIT_SECONDS)
end

Remotes.FireServer("ClientReady")
log:Info(
	"client ready: %d controllers (%s) in %.1f ms",
	#report.Order,
	table.concat(report.Order, ", "),
	(os.clock() - began) * 1000
)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX00000052"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX0000004F"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	CameraController: the over-the-shoulder camera (bible Sections 9 and 26: "wall fade and zoom
	caps built and tested in prompt 5, before anything depends on them").

	* Over the right shoulder by default; SwapShoulder (V, the right stick click, the HUD's
	  Shoulder button) moves it to the other side in ShoulderSwapSeconds.
	* Aim (right mouse, the left trigger, the HUD's Aim button; Run place only) narrows the
	  field of view from 70 to 50 (Tuning.Player.AimFieldOfView), brings the camera in to
	  AimDistance, slows walking to AimWalkSpeed and turns the character to where the camera
	  looks.
	* Zoom (the wheel, a pinch) between Distance.Min and Distance.Max, capped at IndoorMax while
	  the character is in a bunker cell.
	* Zoom caps: a spherecast from the shoulder keeps the camera out of walls, slabs and rock: it
	  pulls in at once and eases back out. In a bunker cell the camera also stays between the
	  floor and the ceiling panels, sliding in along its view (Shafts are open overhead).
	* Wall fade: front walls (FrontWall tag) and furniture (CameraFade tag) never stop the
	  camera; when they stand between the camera and the character, or touch the camera, they
	  fade (Lib.Fade, this client only). So the camera can stand outside a room's open front.
	  Characters and anything tagged CameraIgnore are passed through.
	* The local character fades as the camera comes within CharacterFadeDistance of the head.
	* PC: the mouse is locked to the centre with the cursor hidden and the Reticle shown; any
	  controller frees the cursor with FreeCursor(reason, true) (menus, the Command View).
	* Other views take the camera with Suspend(reason) and give it back with Resume(reason).
	* Fallback: if the update errors ErrorsBeforeFallback times in a row, the controller stops
	  and hands the camera to Roblox's default camera, which the places set to Invisicam
	  (StarterPlayer.DevCameraOcclusionMode).
]]

local CollectionService = game:GetService("CollectionService")
local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CameraRig = require(Shared.Rules.CameraRig)
local Config = require(Shared.Config)
local Constants = require(Shared.Constants)
local Grid = require(Shared.Rules.Grid)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)
local Fade = require(script.Parent.Parent:WaitForChild("Lib"):WaitForChild("Fade"))

local log = Log.new("CameraController")

local FRONT_WALL_TAG = "FrontWall"
local FADE_TAG = "CameraFade"
local IGNORE_TAG = "CameraIgnore"
local FADE_SOURCE = "Camera"
local RENDER_NAME = "100Y_Camera"
local RENDER_PRIORITY = Enum.RenderPriority.Camera.Value + 1
local MAX_FADE_HITS = 4
local PIVOT_LAG = 2 -- the smoothed pivot never trails the head by more than this (studs)

local CameraController = {
	Name = "CameraController",
	Dependencies = { "InputController", "ReplicaController" },
	ShoulderChanged = Signal.new() :: Signal.Signal<number>,
	AimChanged = Signal.new() :: Signal.Signal<boolean>,
}

local input: any = nil
local replica: any = nil
local t: { [string]: any } = {}
local aimFieldOfView = 50
local inRun = false

local yaw = 0
local pitch = 0
local side = 1 -- 1: right shoulder, -1: left
local sideBlend = 1
local aiming = false
local aimBlend = 0
local wanted = 9 -- the zoom the player chose
local distance = 9 -- the camera's distance this frame
local pivotY: number? = nil
local sensitivity = 1
local suspended: { [string]: boolean } = {}
local cursorFree: { [string]: boolean } = {}
local errors = 0
local stopped = false
local wasActive = false
local faded: { [BasePart]: boolean } = {}
local characterFade = 0
local fadedCharacter: Model? = nil
local walkHumanoid: Humanoid? = nil
local baseWalkSpeed = 16
local slowed = false
local reticle: { Gui: ScreenGui, Hip: GuiObject?, Aim: GuiObject? }? = nil
local lastFrame = { Distance = 0, Blocked = false, Indoors = false, Fading = 0, Position = Vector3.zero }

local blockParams = RaycastParams.new()
blockParams.FilterType = Enum.RaycastFilterType.Exclude
blockParams.IgnoreWater = true
local fadeParams = RaycastParams.new()
fadeParams.FilterType = Enum.RaycastFilterType.Include
fadeParams.IgnoreWater = true
local nearParams = OverlapParams.new()
nearParams.FilterType = Enum.RaycastFilterType.Include
local filtersDirty = true

-- Filters ------------------------------------------------------------------------------------

-- The camera passes through characters, CameraIgnore, CameraFade and front walls; it fades
-- the last two.
local function rebuildFilters()
	filtersDirty = false
	local passThrough: { Instance } = {}
	local fadeable: { Instance } = {}
	for _, player in Players:GetPlayers() do
		if player.Character then
			table.insert(passThrough, player.Character)
		end
	end
	for _, item in CollectionService:GetTagged(IGNORE_TAG) do
		table.insert(passThrough, item)
	end
	for _, tag in { FADE_TAG, FRONT_WALL_TAG } do
		for _, item in CollectionService:GetTagged(tag) do
			table.insert(passThrough, item)
			table.insert(fadeable, item)
		end
	end
	blockParams.FilterDescendantsInstances = passThrough
	fadeParams.FilterDescendantsInstances = fadeable
	nearParams.FilterDescendantsInstances = fadeable
end

local function markDirty()
	filtersDirty = true
end

-- Fading -------------------------------------------------------------------------------------

-- A front wall fades as a whole piece; anything else fades alone.
local function fadeGroup(part: BasePart, into: { [BasePart]: number }, amount: number)
	if CollectionService:HasTag(part, FRONT_WALL_TAG) then
		local parent = part.Parent
		if parent and parent:IsA("Model") then
			for _, sibling in parent:GetChildren() do
				if sibling:IsA("BasePart") and CollectionService:HasTag(sibling, FRONT_WALL_TAG) then
					into[sibling] = math.max(into[sibling] or 0, t.FrontWallTransparency)
				end
			end
		end
		into[part] = math.max(into[part] or 0, t.FrontWallTransparency)
		return
	end
	into[part] = math.max(into[part] or 0, amount)
end

-- Fadeable parts on the lines from the camera to points on the character.
local function occluders(from: Vector3, targets: { Vector3 }, into: { [BasePart]: number })
	for _, target in targets do
		local origin = from
		for _ = 1, MAX_FADE_HITS do
			local delta = target - origin
			if delta.Magnitude < 0.05 then
				break
			end
			local hit = workspace:Raycast(origin, delta, fadeParams)
			if not hit then
				break
			end
			local part = hit.Instance
			if part:IsA("BasePart") then
				fadeGroup(part, into, t.FadeTransparency)
			end
			origin = hit.Position + delta.Unit * 0.05
		end
	end
end

local function applyFades(now: { [BasePart]: number })
	for part in faded do
		if now[part] == nil then
			Fade.Clear(part, FADE_SOURCE)
			faded[part] = nil
		end
	end
	for part, amount in now do
		Fade.Set(part, FADE_SOURCE, amount)
		faded[part] = true
	end
end

local function clearFades()
	Fade.ClearSource(FADE_SOURCE)
	table.clear(faded)
end

local function fadeCharacter(character: Model?, amount: number)
	if character ~= fadedCharacter then
		characterFade = -1
		fadedCharacter = character
	end
	if not character or math.abs(amount - characterFade) < 0.01 then
		return
	end
	characterFade = amount
	for _, item in character:GetDescendants() do
		if item:IsA("BasePart") or item:IsA("Decal") then
			local target: any = item
			target.LocalTransparencyModifier = amount
		end
	end
end

-- Mouse, reticle, walking --------------------------------------------------------------------

local function active(): boolean
	return not stopped and next(suspended) == nil
end

local function updateMouse()
	local locked = active() and next(cursorFree) == nil and input:Device() ~= "Touch" and not GuiService.MenuIsOpen
	local behavior = if locked then Enum.MouseBehavior.LockCenter else Enum.MouseBehavior.Default
	if UserInputService.MouseBehavior ~= behavior then
		UserInputService.MouseBehavior = behavior
	end
	if UserInputService.MouseIconEnabled == locked then
		UserInputService.MouseIconEnabled = not locked
	end
end

local function findReticle()
	local playerGui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
	local gui = playerGui and playerGui:FindFirstChild("Reticle")
	if gui and gui:IsA("ScreenGui") then
		local hip = gui:FindFirstChild("Hip", true)
		local aim = gui:FindFirstChild("Aim", true)
		reticle = {
			Gui = gui,
			Hip = if hip and hip:IsA("GuiObject") then hip else nil,
			Aim = if aim and aim:IsA("GuiObject") then aim else nil,
		}
	else
		reticle = nil
	end
end

local function updateReticle()
	local current = reticle
	if not current or current.Gui.Parent == nil then
		findReticle()
		current = reticle
	end
	if not current then
		return
	end
	local show = active() and next(cursorFree) == nil
	if current.Gui.Enabled ~= show then
		current.Gui.Enabled = show
	end
	local aimed = aimBlend >= 0.5
	if current.Hip and current.Hip.Visible ~= (inRun and not aimed) then
		current.Hip.Visible = inRun and not aimed
	end
	if current.Aim and current.Aim.Visible ~= (inRun and aimed) then
		current.Aim.Visible = inRun and aimed
	end
end

-- Aiming slows walking and turns the character with the camera.
local function updateWalking(humanoid: Humanoid, root: BasePart)
	if humanoid ~= walkHumanoid then
		walkHumanoid = humanoid
		baseWalkSpeed = humanoid.WalkSpeed
		slowed = false
	end
	if aiming ~= slowed then
		slowed = aiming
		humanoid.WalkSpeed = if aiming then baseWalkSpeed * t.AimWalkSpeed else baseWalkSpeed
		humanoid.AutoRotate = not aiming
	end
	if aiming then
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	end
end

local function releaseWalking()
	local humanoid = walkHumanoid
	if humanoid and slowed and humanoid.Parent then
		humanoid.WalkSpeed = baseWalkSpeed
		humanoid.AutoRotate = true
	end
	slowed = false
end

-- Is the cell at this point a Shaft (open overhead for the stair)?
local function inShaft(point: Vector3): boolean
	local floor, column = Grid.CellAt(point)
	if not floor or not column then
		return false
	end
	local cell = replica:Get("Cells", Grid.Key(floor, column))
	local roomId = if type(cell) == "table" then cell.Room else nil
	local room = if type(roomId) == "string" then replica:Get("Rooms", roomId) else nil
	return type(room) == "table" and room.Type == "Shaft"
end

-- The frame ----------------------------------------------------------------------------------

local function step(dt: number)
	updateMouse()
	updateReticle()
	if not active() then
		if wasActive then
			wasActive = false
			clearFades()
			releaseWalking()
			fadeCharacter(fadedCharacter, 0)
		end
		input:TakeLook(dt)
		input:TakeZoom()
		return
	end
	wasActive = true
	local camera = workspace.CurrentCamera
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = humanoid and humanoid.RootPart
	if not camera or not character or not humanoid or not root then
		input:TakeLook(dt)
		input:TakeZoom()
		return
	end
	if camera.CameraType ~= Enum.CameraType.Scriptable then
		camera.CameraType = Enum.CameraType.Scriptable
	end
	if filtersDirty then
		rebuildFilters()
	end

	-- Look, shoulder and aim
	local turn = input:TakeLook(dt) * sensitivity * (1 + (t.AimSensitivity - 1) * aimBlend)
	yaw -= math.rad(turn.X)
	pitch = CameraRig.ClampPitch(pitch - math.rad(turn.Y))
	sideBlend = CameraRig.MoveToward(sideBlend, side, dt * 2 / math.max(t.ShoulderSwapSeconds, 1e-3))
	aimBlend = CameraRig.MoveToward(aimBlend, if aiming then 1 else 0, dt / math.max(t.AimBlendSeconds, 1e-3))

	-- The pivot: head height, its height smoothed a little (stairs)
	local head = root.Position + Vector3.new(0, t.PivotHeight, 0)
	local smoothY = if pivotY then CameraRig.Approach(pivotY, head.Y, t.PivotFollowPerSecond, dt) else head.Y
	pivotY = math.clamp(smoothY, head.Y - PIVOT_LAG, head.Y + PIVOT_LAG)
	local pivot = Vector3.new(head.X, pivotY :: number, head.Z)

	-- Indoors: the bunker cell the character is in
	local low: number?, high: number? = nil, nil
	if inRun then
		low, high = CameraRig.CellHeights(pivot)
	end
	local indoors = low ~= nil
	if indoors and inShaft(pivot) then
		high = nil -- the Shaft is open overhead (the stair goes up through it)
	end

	-- Zoom
	local nearest, farthest = CameraRig.ZoomRange(indoors)
	local zoomInput = input:TakeZoom()
	if zoomInput ~= 0 then
		wanted = math.clamp(math.min(wanted, farthest) + zoomInput, nearest, if indoors then farthest else t.Distance.Max)
	end
	local zoomGoal = math.clamp(wanted, nearest, farthest)
	local goal = zoomGoal + (math.min(t.AimDistance, zoomGoal) - zoomGoal) * aimBlend

	-- The focus beside the head, kept out of a wall the character stands against
	local shoulder = t.ShoulderOffset * (1 + (t.AimShoulder - 1) * aimBlend)
	local focus = CameraRig.Focus(pivot, yaw, sideBlend, shoulder, t.ShoulderRaise)
	local toFocus = focus - pivot
	if toFocus.Magnitude > 1e-3 then
		local hit = workspace:Spherecast(pivot, t.CollisionRadius * 0.75, toFocus, blockParams)
		if hit then
			focus = pivot + toFocus.Unit * math.max(0, hit.Distance - t.WallMargin)
		end
	end

	-- How far back the camera can go: walls and rock, then the cell's floor and ceiling
	local rotation = CameraRig.Rotation(yaw, pitch)
	local look = rotation.LookVector
	local allowed = goal
	local blocked = false
	local hit = workspace:Spherecast(focus, t.CollisionRadius, -look * goal, blockParams)
	if hit then
		allowed = math.max(t.NearestDistance, hit.Distance - t.WallMargin)
		blocked = true
	end
	if indoors then
		local limit = CameraRig.HeightLimit(focus, look, low :: number, high or math.huge)
		if limit < allowed then
			allowed = math.max(t.NearestDistance, limit)
			blocked = true
		end
	end
	if allowed < distance then
		distance = allowed -- pull in at once
	else
		distance = CameraRig.Approach(distance, allowed, t.EaseOutPerSecond, dt)
	end

	local position = focus - look * distance
	camera.CFrame = CFrame.new(position) * rotation
	camera.Focus = CFrame.new(focus)
	camera.FieldOfView = t.FieldOfView + (aimFieldOfView - t.FieldOfView) * aimBlend

	-- Wall fade: between the camera and the character, and touching the camera
	local fades: { [BasePart]: number } = {}
	occluders(position, { head, root.Position, focus }, fades)
	for _, part in workspace:GetPartBoundsInRadius(position, t.NearFadeRadius, nearParams) do
		fadeGroup(part, fades, 1)
	end
	applyFades(fades)

	-- The character fades when the camera is at its head
	local gap = (position - head).Magnitude
	local closeness = math.clamp((t.CharacterFadeDistance - gap) / (t.CharacterFadeDistance * 0.5), 0, 1)
	fadeCharacter(character, closeness)

	updateWalking(humanoid, root)

	lastFrame.Distance = distance
	lastFrame.Blocked = blocked
	lastFrame.Indoors = indoors
	lastFrame.Fading = Fade.Count(FADE_SOURCE)
	lastFrame.Position = position
end

local function onRender(dt: number)
	if stopped then
		return
	end
	local ok, err = pcall(step, dt)
	if ok then
		errors = 0
		return
	end
	errors += 1
	log:Warn("camera update failed (%d): %s", errors, tostring(err))
	if errors >= t.ErrorsBeforeFallback then
		stopped = true
		clearFades()
		releaseWalking()
		local camera = workspace.CurrentCamera
		if camera then
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = t.FieldOfView
		end
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		log:Error("the over-the-shoulder camera stopped; Roblox's camera (Invisicam) takes over")
	end
end

-- API ----------------------------------------------------------------------------------------

function CameraController:SwapShoulder()
	side = -side
	CameraController.ShoulderChanged:Fire(side)
end

function CameraController:SetShoulder(value: number)
	local wantedSide = if value < 0 then -1 else 1
	if wantedSide ~= side then
		CameraController:SwapShoulder()
	end
end

function CameraController:SetAiming(on: boolean)
	local value = on and inRun and active() and next(cursorFree) == nil
	if value == aiming then
		return
	end
	aiming = value
	CameraController.AimChanged:Fire(value)
end

function CameraController:IsAiming(): boolean
	return aiming
end

-- Point the camera (degrees): yaw 0 looks toward -Z, pitch below 0 looks down.
function CameraController:SetLook(yawDegrees: number, pitchDegrees: number)
	yaw = math.rad(yawDegrees)
	pitch = CameraRig.ClampPitch(math.rad(pitchDegrees))
end

function CameraController:SetZoom(studs: number)
	wanted = math.clamp(studs, t.Distance.Min, t.Distance.Max)
end

-- A sensitivity multiplier from the player's settings (Settings screen, later).
function CameraController:SetSensitivity(value: number)
	sensitivity = math.clamp(value, 0.1, 4)
end

-- Another view takes the camera (the Command View, a cutscene) until Resume(reason).
function CameraController:Suspend(reason: string)
	suspended[reason] = true
end

function CameraController:Resume(reason: string)
	suspended[reason] = nil
end

-- A menu frees the mouse cursor while it is open.
function CameraController:FreeCursor(reason: string, on: boolean)
	cursorFree[reason] = if on then true else nil
end

function CameraController:State(): { [string]: any }
	return {
		Active = active(),
		Stopped = stopped,
		Yaw = math.deg(yaw) % 360,
		Pitch = math.deg(pitch),
		Shoulder = if side > 0 then "right" else "left",
		Aiming = aiming,
		Wanted = wanted,
		Distance = lastFrame.Distance,
		Blocked = lastFrame.Blocked,
		Indoors = lastFrame.Indoors,
		Fading = lastFrame.Fading,
		Position = lastFrame.Position,
		FieldOfView = if workspace.CurrentCamera then workspace.CurrentCamera.FieldOfView else 0,
		Device = input:Device(),
		Suspended = next(suspended) ~= nil,
		CursorFree = next(cursorFree) ~= nil,
	}
end

-- Lifecycle ----------------------------------------------------------------------------------

function CameraController:Init(registry)
	input = registry.InputController
	replica = registry.ReplicaController
	t = CameraRig.Tuning()
	aimFieldOfView = Config.Get("Tuning", "Player").AimFieldOfView[2]
	inRun = Constants.PlaceKind() == "Run"
	pitch = math.rad(t.StartPitch)
	wanted = t.Distance.Default
	distance = wanted
	Fade.SetSeconds(t.FadeSeconds)
end

function CameraController:Start()
	input:On("SwapShoulder", function()
		CameraController:SwapShoulder()
	end)
	input:On("Aim", function()
		CameraController:SetAiming(true)
	end, function()
		CameraController:SetAiming(false)
	end)

	for _, tag in { FADE_TAG, FRONT_WALL_TAG, IGNORE_TAG } do
		CollectionService:GetInstanceAddedSignal(tag):Connect(markDirty)
		CollectionService:GetInstanceRemovedSignal(tag):Connect(markDirty)
	end
	local function watch(player: Player)
		player.CharacterAdded:Connect(markDirty)
		player.CharacterRemoving:Connect(markDirty)
	end
	for _, player in Players:GetPlayers() do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(markDirty)

	-- A new character looks the way it spawned facing
	local function faceSpawn(character: Model)
		local root = character:WaitForChild("HumanoidRootPart", 10)
		if root and root:IsA("BasePart") then
			local lookVector = root.CFrame.LookVector
			yaw = math.atan2(-lookVector.X, -lookVector.Z)
			pitch = math.rad(t.StartPitch)
			pivotY = nil
			distance = math.min(wanted, select(2, CameraRig.ZoomRange(inRun)))
		end
		aiming = false
		aimBlend = 0
	end
	Players.LocalPlayer.CharacterAdded:Connect(faceSpawn)
	if Players.LocalPlayer.Character then
		task.spawn(faceSpawn, Players.LocalPlayer.Character)
	end

	RunService:BindToRenderStep(RENDER_NAME, RENDER_PRIORITY, onRender)
	log:Debug("over-the-shoulder camera on (%s)", if inRun then "Run" else "Lobby")
end

return CameraController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000050"><Properties><string name="Name">DevController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DevController: the client side of DevTools.

	For players the server marked DevAllowed (everyone in Studio, admins in a live game) it
	adds a chat command: `/dev <command> [args]` (or `/d`). Commands run on the server
	(DevService checks permission again); the answer comes back as a Notice, shown in the
	chat and the output. Four commands run on the client:
	* `/dev replica <collection>` prints this client's mirror of a collection;
	* `/dev client` prints the client's replication counters;
	* `/dev clock` prints the run state as this client sees it (Run place), with the time
	  left counted on this client from the replicated server time;
	* `/dev ready [true|false]` fires the SetReady remote, as the HUD's Ready button will,
	  and reports what the server did;
	* `/dev camera` prints the over-the-shoulder camera's state; `camera.shoulder`,
	  `camera.aim [true|false]`, `camera.look <yaw> <pitch>` (degrees), `camera.zoom <studs>`
	  and `camera.cursor` (frees or locks the mouse) drive it for tests.

	In Studio it also makes PlayerScripts.DevInvoke (a BindableFunction) so tools can run the
	same commands from the Client datamodel: DevInvoke:Invoke("replica _SelfTest").
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local RunState = require(Shared.RunState)
local TableUtil = require(Shared.Utilities.TableUtil)

local log = Log.new("DevController")
local CHAT_LINES = 12

local DevController = {
	Name = "DevController",
	Dependencies = { "ReplicaController", "CameraController" },
}

local replica: any = nil
local camera: any = nil
local devCursorFree = false
local lastNotice: string? = nil
local commandMade = false

local function dump(value: any, depth: number?): string
	local level = depth or 0
	if type(value) == "string" then
		return if value == "\0none" then "NONE" else string.format("%q", value)
	elseif typeof(value) == "Vector3" then
		return string.format("(%g, %g, %g)", value.X, value.Y, value.Z)
	elseif type(value) ~= "table" then
		return tostring(value)
	elseif level > 4 then
		return "{...}"
	end
	local parts = {}
	for _, key in TableUtil.SortedKeys(value) do
		table.insert(parts, `{tostring(key)}={dump(value[key], level + 1)}`)
	end
	return "{" .. table.concat(parts, ", ") .. "}"
end

local function escape(text: string): string
	return (string.gsub(string.gsub(string.gsub(text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end

local function show(text: string)
	print(`[100Y dev] {text}`)
	local channels = TextChatService:FindFirstChild("TextChannels")
	local system = channels and channels:FindFirstChild("RBXSystem")
	if system and system:IsA("TextChannel") then
		local lines = string.split(text, "\n")
		for index = 1, math.min(#lines, CHAT_LINES) do
			pcall(system.DisplaySystemMessage, system, escape(lines[index]))
		end
		if #lines > CHAT_LINES then
			pcall(system.DisplaySystemMessage, system, `... {#lines - CHAT_LINES} more lines in the output (F9)`)
		end
	end
end

local function parse(text: string): (string, { any })
	local words = {}
	for word in string.gmatch(text, "%S+") do
		local number = tonumber(word)
		if word == "true" or word == "false" then
			table.insert(words, word == "true")
		elseif number ~= nil and number == number and math.abs(number) ~= math.huge then
			table.insert(words, number)
		else
			table.insert(words, string.sub(word, 1, 120))
		end
	end
	local name = table.remove(words, 1)
	return if type(name) == "string" then name else "help", words
end

local function describeClock(): string
	local runPhase = RunState.Get("RunPhase")
	if runPhase == nil then
		return "no run state in this place"
	end
	local left = RunState.TimeLeft()
	local leftText = if RunState.Get("PhaseOpen") then "no timer (until its boss is beaten)"
		elseif left then string.format("%.1f s left", left)
		else "stopped"
	local boss = RunState.Get("SurgeBoss")
	local bossText = if boss then ` ({boss})` else ""
	return `client sees: {runPhase}, cycle {RunState.Get("Cycle")}, Year {RunState.Get("Year")} ({RunState.Get("Era")}), `
		.. `{RunState.Get("CyclePhase") or "-"} {leftText}, siren {tostring(RunState.Get("Siren") == true)}, `
		.. `Surge {RunState.Get("SurgeKind") or "-"}{bossText}, {RunState.Get("YearsPerCycle")} years per cycle, `
		.. `ready {RunState.Get("ReadyCount") or 0}/{RunState.Get("ReadyNeeded") or 0}`
end

local function pressReady(on: boolean): string
	if not Remotes.InPlace("SetReady") then
		return "there is no run clock in this place"
	end
	local player = Players.LocalPlayer
	Remotes.FireServer("SetReady", on)
	local waited = 0
	while waited < 2 and player:GetAttribute("Ready") ~= on and not (on and RunState.Get("Siren") == true) do
		waited += task.wait()
	end
	return `SetReady {on}: my Ready is {tostring(player:GetAttribute("Ready"))}\n{describeClock()}`
end

local function describeCamera(): string
	task.wait() -- let a frame apply what the command changed
	task.wait()
	local state = camera:State()
	local p = state.Position
	return string.format(
		"camera: %s, %s shoulder, yaw %.0f, pitch %.0f, zoom %.1f (wanted %.1f), %s%s, FOV %.0f, %s%s, %d faded, device %s%s at (%.1f, %.1f, %.1f)",
		if state.Stopped then "STOPPED (Roblox camera)" elseif state.Active then "on" else "suspended",
		state.Shoulder,
		state.Yaw,
		state.Pitch,
		state.Distance,
		state.Wanted,
		if state.Indoors then "indoors" else "outdoors",
		if state.Blocked then ", held in by a wall" else "",
		state.FieldOfView,
		if state.Aiming then "aiming" else "not aiming",
		if state.CursorFree then ", cursor free" else "",
		state.Fading,
		state.Device,
		if state.Suspended then ", suspended" else "",
		p.X,
		p.Y,
		p.Z
	)
end

-- Runs a command line; client-side commands answer here, the rest go to the server.
local function run(text: string): string?
	local name, args = parse(text)
	if name == "replica" then
		local collection = tostring(args[1] or "")
		local values = replica:All(collection)
		local keys = TableUtil.SortedKeys(values)
		if #keys == 0 then
			return `{collection}: empty on this client`
		end
		local lines = { `{collection}: {#keys} values` }
		for _, key in keys do
			table.insert(lines, `  {key} = {dump(values[key])}`)
		end
		return table.concat(lines, "\n")
	elseif name == "client" then
		local stats = replica:Stats()
		return `client: ready={tostring(replica:IsReady())}, delta events {stats.Events}, ops {stats.Ops}, snapshots {stats.Snapshots}`
	elseif name == "clock" then
		return describeClock()
	elseif name == "ready" then
		return pressReady(args[1] ~= false)
	elseif name == "camera" then
		return describeCamera()
	elseif name == "camera.shoulder" then
		camera:SwapShoulder()
		return describeCamera()
	elseif name == "camera.aim" then
		camera:SetAiming(args[1] ~= false)
		return describeCamera()
	elseif name == "camera.look" then
		camera:SetLook(tonumber(args[1]) or 0, tonumber(args[2]) or 0)
		return describeCamera()
	elseif name == "camera.zoom" then
		camera:SetZoom(tonumber(args[1]) or 9)
		return describeCamera()
	elseif name == "camera.cursor" then
		devCursorFree = not devCursorFree
		camera:FreeCursor("DevTools", devCursorFree)
		return describeCamera()
	end
	if #args > 8 then
		return "at most 8 arguments"
	end
	Remotes.FireServer("DevCommand", string.sub(name, 1, 48), args)
	return nil
end

local function makeChatCommand()
	if commandMade or Players.LocalPlayer:GetAttribute("DevAllowed") ~= true then
		return
	end
	commandMade = true
	local command = Instance.new("TextChatCommand")
	command.Name = "DevCommand"
	command.PrimaryAlias = "/dev"
	command.SecondaryAlias = "/d"
	command.Triggered:Connect(function(_source: TextSource, message: string)
		local rest = string.match(message, "^%S+%s*(.*)$") or ""
		local answer = run(if rest == "" then "help" else rest)
		if answer then
			show(answer)
		end
	end)
	command.Parent = TextChatService
	log:Debug("/dev ready")
end

function DevController:Init(registry)
	replica = registry.ReplicaController
	camera = registry.CameraController
	Remotes.OnClient("Notice", function(text: any)
		if type(text) == "string" then
			lastNotice = text
			show(text)
		end
	end)
end

function DevController:Start()
	local player = Players.LocalPlayer
	player:GetAttributeChangedSignal("DevAllowed"):Connect(makeChatCommand)
	makeChatCommand()

	if RunService:IsStudio() then
		local invoke = Instance.new("BindableFunction")
		invoke.Name = "DevInvoke"
		invoke.OnInvoke = function(line: any): string
			if type(line) ~= "string" then
				return "usage: DevInvoke:Invoke(\"replica Rooms\")"
			end
			lastNotice = nil
			local answer = run(line)
			if answer then
				return answer
			end
			local waited = 0
			while lastNotice == nil and waited < 5 do
				waited += task.wait()
			end
			return lastNotice or "no answer from the server within 5 s"
		end
		invoke.Parent = script.Parent.Parent
	end
end

return DevController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000051"><Properties><string name="Name">InputController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	InputController: turns PC, touch and gamepad input into the game's actions (bible Section 9,
	Controls; Section 23).

	* Device: "Keyboard" (mouse and keyboard), "Gamepad" or "Touch", from the last input used;
	  DeviceChanged fires when it changes.
	* Actions: the bible's controls table (BINDINGS). A controller listens with
	  InputController:On(action, began, ended?); the action is bound with ContextActionService
	  above Roblox's own bindings the first time someone listens. Touch buttons from the HUD
	  join with InputController:BindButton(action, button). Jump and moving stay Roblox's.
	* Look and zoom: mouse movement (while the mouse is locked), the right stick, a one-finger
	  drag on open screen and a two-finger pinch are gathered between frames; the camera takes
	  them with TakeLook(dt) (degrees) and TakeZoom() (studs, positive = farther).
	* Touches that start on a GUI or Roblox's thumbstick are the GUI's, never the camera's.
]]

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CameraRig = require(Shared.Rules.CameraRig)
local Log = require(Shared.Utilities.Log)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("InputController")

export type Device = "Keyboard" | "Gamepad" | "Touch"

-- Section 9's controls table. Touch buttons come from the HUD (BindButton).
local BINDINGS: { [string]: { Enum.KeyCode | Enum.UserInputType } } = {
	Fire = { Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2 },
	Aim = { Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2 },
	Melee = { Enum.KeyCode.F, Enum.KeyCode.ButtonR1 },
	Reload = { Enum.KeyCode.R, Enum.KeyCode.ButtonX }, -- a tap of X on console
	Interact = { Enum.KeyCode.E, Enum.KeyCode.ButtonX }, -- a hold of X on console
	Ability = { Enum.KeyCode.Q, Enum.KeyCode.ButtonL1 },
	Sprint = { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3 },
	Dodge = { Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB },
	SwapShoulder = { Enum.KeyCode.V, Enum.KeyCode.ButtonR3 },
	HotbarNext = { Enum.KeyCode.DPadRight },
	HotbarPrevious = { Enum.KeyCode.DPadLeft },
	Hotbar1 = { Enum.KeyCode.One },
	Hotbar2 = { Enum.KeyCode.Two },
	Hotbar3 = { Enum.KeyCode.Three },
	Hotbar4 = { Enum.KeyCode.Four },
	Hotbar5 = { Enum.KeyCode.Five },
	Ping = { Enum.KeyCode.G, Enum.KeyCode.DPadUp },
	CommandView = { Enum.KeyCode.Tab, Enum.KeyCode.ButtonSelect },
}
local PRIORITY = Enum.ContextActionPriority.High.Value + 10

type Listener = { Began: (() -> ())?, Ended: (() -> ())? }

local InputController = {
	Name = "InputController",
	Dependencies = {},
	DeviceChanged = Signal.new(),
}

local device: Device = "Keyboard"
local listeners: { [string]: { Listener } } = {}
local held: { [string]: { [any]: boolean } } = {}
local bound: { [string]: boolean } = {}

local mouseLook = Vector2.zero -- pixels since the last TakeLook
local touchLook = Vector2.zero
local stick = Vector2.zero -- the right stick, -1 to 1
local zoom = 0 -- studs since the last TakeZoom
local touches: { [InputObject]: Vector2 } = {} -- camera touches and where they were last
local pinchGap: number? = nil

-- The player's own Roblox camera sensitivity (Settings menu), read each frame.
local gameSettings: any = nil
local function robloxSensitivity(key: string): number
	if not gameSettings then
		return 1
	end
	local ok, value = pcall(function()
		return gameSettings[key]
	end)
	return if ok and type(value) == "number" and value > 0 then value else 1
end

local function deviceOf(inputType: Enum.UserInputType): Device?
	if inputType == Enum.UserInputType.Touch then
		return "Touch"
	elseif string.find(inputType.Name, "^Gamepad") then
		return "Gamepad"
	elseif inputType == Enum.UserInputType.Keyboard or string.find(inputType.Name, "^Mouse") then
		return "Keyboard"
	end
	return nil
end

local function setDevice(inputType: Enum.UserInputType)
	local found = deviceOf(inputType)
	if found and found ~= device then
		device = found
		InputController.DeviceChanged:Fire(device)
	end
end

-- An action's state from one source (a key, a button); began on the first, ended on the last.
local function press(action: string, source: any, down: boolean)
	local sources = held[action]
	if not sources then
		sources = {}
		held[action] = sources
	end
	local wasDown = next(sources) ~= nil
	sources[source] = if down then true else nil
	local isDown = next(sources) ~= nil
	if isDown == wasDown then
		return
	end
	for _, listener in listeners[action] or {} do
		local handler = if isDown then listener.Began else listener.Ended
		if handler then
			task.spawn(handler)
		end
	end
end

local function bind(action: string)
	local inputs = BINDINGS[action]
	if bound[action] or not inputs then
		return
	end
	bound[action] = true
	ContextActionService:BindActionAtPriority(
		"100Y_" .. action,
		function(_name: string, state: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
			if state == Enum.UserInputState.Begin then
				press(action, input.KeyCode.Name .. input.UserInputType.Name, true)
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				press(action, input.KeyCode.Name .. input.UserInputType.Name, false)
			end
			return Enum.ContextActionResult.Pass
		end,
		false,
		PRIORITY,
		table.unpack(inputs)
	)
end

-- Listens to an action. Returns a function that stops listening.
function InputController:On(action: string, began: (() -> ())?, ended: (() -> ())?): () -> ()
	assert(BINDINGS[action], `InputController: unknown action {action}`)
	local list = listeners[action]
	if not list then
		list = {}
		listeners[action] = list
	end
	local listener: Listener = { Began = began, Ended = ended }
	table.insert(list, listener)
	bind(action)
	return function()
		local index = table.find(list, listener)
		if index then
			table.remove(list, index)
		end
	end
end

-- Is the action held right now (by any key, button or touch button)?
function InputController:IsDown(action: string): boolean
	local sources = held[action]
	return sources ~= nil and next(sources) ~= nil
end

-- A HUD touch button drives an action while it is pressed. Returns a cleanup function.
function InputController:BindButton(action: string, button: GuiButton): () -> ()
	assert(BINDINGS[action], `InputController: unknown action {action}`)
	local down = button.MouseButton1Down:Connect(function()
		press(action, button, true)
	end)
	local up = button.MouseButton1Up:Connect(function()
		press(action, button, false)
	end)
	local left = button.MouseLeave:Connect(function()
		press(action, button, false)
	end)
	return function()
		down:Disconnect()
		up:Disconnect()
		left:Disconnect()
		press(action, button, false)
	end
end

-- Presses or releases an action from code (DevTools, tests, a toggle on touch).
function InputController:Press(action: string, down: boolean, source: string?)
	assert(BINDINGS[action], `InputController: unknown action {action}`)
	press(action, source or "code", down)
end

function InputController:Device(): Device
	return device
end

-- Look input since the last call, in degrees (X turns, Y tilts; positive = right and down).
function InputController:TakeLook(dt: number): Vector2
	local t = CameraRig.Tuning()
	local degrees = mouseLook * t.MouseDegreesPerPixel * robloxSensitivity("MouseSensitivity")
		+ touchLook * t.TouchDegreesPerPixel * robloxSensitivity("MouseSensitivity")
		+ CameraRig.Stick(stick, t.StickDeadzone) * Vector2.new(1, -1) * t.GamepadDegreesPerSecond * dt
			* robloxSensitivity("GamepadCameraSensitivity")
	mouseLook = Vector2.zero
	touchLook = Vector2.zero
	return degrees
end

-- Zoom input since the last call, in studs (positive = farther).
function InputController:TakeZoom(): number
	local value = zoom
	zoom = 0
	return value
end

function InputController:Init()
	local ok, settings = pcall(function()
		return UserSettings():GetService("UserGameSettings")
	end)
	gameSettings = if ok then settings else nil
	device = deviceOf(UserInputService:GetLastInputType())
		or (if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "Touch" else "Keyboard")
end

function InputController:Start()
	UserInputService.LastInputTypeChanged:Connect(setDevice)

	UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			if UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default then
				mouseLook += Vector2.new(input.Delta.X, input.Delta.Y)
			end
		elseif input.UserInputType == Enum.UserInputType.MouseWheel then
			if not processed then
				zoom -= input.Position.Z * CameraRig.Tuning().ZoomStep
			end
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.new(input.Position.X, input.Position.Y)
		end
	end)
	UserInputService.InputEnded:Connect(function(input: InputObject)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.zero
		end
	end)

	-- Touch: a drag on open screen looks around; two fingers pinch to zoom.
	UserInputService.TouchStarted:Connect(function(touch: InputObject, processed: boolean)
		if not processed then
			touches[touch] = Vector2.new(touch.Position.X, touch.Position.Y)
			pinchGap = nil
		end
	end)
	UserInputService.TouchMoved:Connect(function(touch: InputObject)
		local last = touches[touch]
		if not last then
			return
		end
		local now = Vector2.new(touch.Position.X, touch.Position.Y)
		touches[touch] = now
		local live = {}
		for other, at in touches do
			table.insert(live, at)
		end
		if #live >= 2 then
			local gap = (live[1] - live[2]).Magnitude
			if pinchGap then
				zoom -= (gap - pinchGap) * CameraRig.Tuning().PinchStudsPerPixel
			end
			pinchGap = gap
		else
			touchLook += now - last
		end
	end)
	UserInputService.TouchEnded:Connect(function(touch: InputObject)
		touches[touch] = nil
		pinchGap = nil
	end)
	log:Debug("input ready (%s)", device)
end

return InputController
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000052"><Properties><string name="Name">ReplicaController</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ReplicaController: the client end of the delta channel. It mirrors the server's
	collections (ReplicationService) and tells controllers what changed.

		local Rooms = registry.ReplicaController
		Rooms:Changed("Rooms"):Connect(function(key, value, old) ... end)  -- value nil = removed
		local room = Rooms:Get("Rooms", "R12")                              -- frozen; never edit
		Rooms:Ready():Wait()                                                -- first snapshot in

	A snapshot replaces the whole mirror: keys that disappeared fire a removal.
	A collection cleared on the server fires one change with key nil.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Delta = require(Shared.Utilities.Delta)
local Log = require(Shared.Utilities.Log)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Utilities.Signal)

local log = Log.new("ReplicaController")

export type ChangedSignal = Signal.Signal<string?, any, any>

local ReplicaController = {
	Name = "ReplicaController",
	Dependencies = {},
}

local store: Delta.Store = {}
local changedSignals: { [string]: ChangedSignal } = {}
local readySignal = Signal.new() :: Signal.Signal<()>
local isReady = false
local counters = { Events = 0, Ops = 0, Snapshots = 0 }

local function onDelta(ops: any, snapshot: any)
	if type(ops) ~= "table" then
		return
	end
	counters.Events += 1
	counters.Ops += #ops
	local changes: { Delta.Change }
	if snapshot == true then
		counters.Snapshots += 1
		local previous = store
		store = {}
		changes = Delta.Apply(store, ops)
		for _, change in changes do
			local before = previous[change.Collection]
			change.Old = if before and change.Key then before[change.Key] else nil
		end
		for collectionName, values in previous do
			local now = store[collectionName]
			for key, value in values do
				if not now or now[key] == nil then
					table.insert(changes, { Collection = collectionName, Key = key, Value = nil, Old = value })
				end
			end
		end
	else
		changes = Delta.Apply(store, ops)
	end
	for _, change in changes do
		local signal = changedSignals[change.Collection]
		if signal then
			signal:Fire(change.Key, change.Value, change.Old)
		end
	end
	if snapshot == true and not isReady then
		isReady = true
		log:Debug("snapshot: %d values", #ops)
		readySignal:Fire()
	end
end

function ReplicaController:Init(_registry)
	Remotes.OnClient("Delta", onDelta)
end

function ReplicaController:Get(collection: string, key: string): any
	local values = store[collection]
	return if values then values[key] else nil
end

-- A shallow copy of a collection (the values are frozen).
function ReplicaController:All(collection: string): { [string]: any }
	local values = store[collection]
	return if values then table.clone(values) else {}
end

function ReplicaController:Changed(collection: string): ChangedSignal
	local signal = changedSignals[collection]
	if not signal then
		signal = Signal.new() :: ChangedSignal
		changedSignals[collection] = signal
	end
	return signal :: ChangedSignal
end

function ReplicaController:IsReady(): boolean
	return isReady
end

-- Fires once, after the first snapshot. Check IsReady first: it won't fire again.
function ReplicaController:Ready(): Signal.Signal<()>
	return readySignal
end

function ReplicaController:Stats(): { Events: number, Ops: number, Snapshots: number }
	return table.clone(counters)
end

return ReplicaController
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX00000054"><Properties><string name="Name">Lib</string></Properties><Item class="ModuleScript" referent="RBX00000054"><Properties><string name="Name">Fade</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Fade: see-through world parts on this client only, shared by the camera (walls and
	furniture between the camera and the character) and the Command View (front walls).

	Each source asks for an amount per part (0 opaque, 1 hidden); a part shows the largest ask,
	eased over `seconds`, through BasePart.LocalTransparencyModifier, which is local to this
	client and never replicates. Parts that leave the game drop out by themselves.

		Fade.Set(part, "Camera", 0.8)
		Fade.Clear(part, "Camera")
		Fade.ClearSource("Camera")
]]

local RunService = game:GetService("RunService")

local Fade = {}

local DEFAULT_SECONDS = 0.12

local asks: { [BasePart]: { [string]: number } } = {}
local shown: { [BasePart]: number } = {}
local seconds = DEFAULT_SECONDS
local connection: RBXScriptConnection? = nil

local function target(part: BasePart): number
	local best = 0
	for _, amount in asks[part] or {} do
		best = math.max(best, amount)
	end
	return best
end

local function step(dt: number)
	local rate = if seconds > 0 then dt / seconds else 1
	local busy = false
	for part, current in shown do
		if part.Parent == nil then
			shown[part] = nil
			asks[part] = nil
			continue
		end
		local goal = target(part)
		local nextValue = if current < goal then math.min(current + rate, goal) else math.max(current - rate, goal)
		if nextValue ~= current then
			part.LocalTransparencyModifier = nextValue
		end
		if nextValue <= 0 and goal <= 0 then
			shown[part] = nil
			asks[part] = nil
		else
			shown[part] = nextValue
			busy = true
		end
	end
	if not busy and connection then
		connection:Disconnect()
		connection = nil
	end
end

local function wake()
	if not connection then
		connection = RunService.RenderStepped:Connect(step)
	end
end

-- How long a fade in or out takes (the camera sets this from Tuning.Camera.FadeSeconds).
function Fade.SetSeconds(value: number)
	seconds = math.max(0, value)
end

function Fade.Set(part: BasePart, source: string, amount: number)
	local list = asks[part]
	if not list then
		list = {}
		asks[part] = list
	end
	list[source] = math.clamp(amount, 0, 1)
	if shown[part] == nil then
		shown[part] = part.LocalTransparencyModifier
	end
	wake()
end

function Fade.Clear(part: BasePart, source: string)
	local list = asks[part]
	if list then
		list[source] = nil
	end
	if shown[part] ~= nil then
		wake()
	end
end

-- Drops every ask a source made (when the camera stops, or the Command View closes).
function Fade.ClearSource(source: string)
	for part, list in asks do
		if list[source] ~= nil then
			list[source] = nil
			wake()
		end
	end
end

-- The parts a source is fading now (DevTools).
function Fade.Count(source: string?): number
	local count = 0
	for _, list in asks do
		if source == nil or list[source] ~= nil then
			count += 1
		end
	end
	return count
end

return Fade
