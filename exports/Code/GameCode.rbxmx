			"VoteBanner.No.Content.Label",
		},
	},
	HUD = {
		Places = { "Run" },
		DisplayOrder = 1,
		Paths = {
			"Vitals.Health.Needle",
			"Vitals.Health.Value",
			"Vitals.Stamina.Needle",
			"Vitals.Radiation.Needle",
			"Vitals.Ability.Icon",
