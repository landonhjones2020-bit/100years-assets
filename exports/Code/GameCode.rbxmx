				Source = { 0, -152, 19.6 },
			},
			Beats = {
				SirenFrom = 0.8,
				RunStart = 1.6,
				BombFrom = 10,
				BombTo = 15,
				DoorFrom = 12.75,
				DoorTo = 14.35,
				WheelFrom = 14.35,
				WheelTo = 14.95,
				Sealed = 14.5,
				Flash = 15,
				FireballFrom = 15.15,
				FireballTo = 17.4,
				CloudFrom = 15.5,
				CloudTo = 21.5,
				WaveFrom = 16.1,
				WaveTo = 18.9,
				DustFrom = 18.45,
				DustTo = 19.5,
				DiveFrom = 21,
				DiveTo = 22.2,
				PlungeFrom = 22.2,
				PlungeTo = 25.7,
				EyesFrom = 25.95,
				EyesTo = 26.6,
				Title = 27,
				SettleFrom = 27,
				SettleTo = 28.4,
				ZoomFrom = 28.7,
