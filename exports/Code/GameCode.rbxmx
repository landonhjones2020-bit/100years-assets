			Talentable = false,
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000079"><Properties><string name="Name">Conditions</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Conditions on residents (bible Section 11). Amounts are provisional, for Prompts 10 and 26.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Text = F.Text,
		OutputMultiplier = Check.optional(F.NonNegative),
		HealthPerCycle = Check.optional(F.Number),
		MoraleNow = Check.optional(F.Number),
		Cycles = Check.optional(F.PositiveInt), -- how long it lasts on its own
		Contagious = F.Flag,
		StopsWork = F.Flag,
		Phase = Check.integer(1, 3), -- resident build phase (Section 11)
	}),
	Order = { "Injured", "Irradiated", "Panicked", "Inspired", "Sick", "Grieving", "Exhausted" },
	Entries = {
		Injured = { Name = "Injured", Text = "Works slowly until treated.", OutputMultiplier = 0.6, Phase = 2 },
		Irradiated = { Name = "Irradiated", Text = "Loses health until cleared.", HealthPerCycle = -10, Phase = 2 },
		Panicked = {
			Name = "Panicked",
			Text = "Flees danger and stops working. Brave and Cool Head residents never panic.",
			StopsWork = true,
			Phase = 2,
		},
		Inspired = { Name = "Inspired", Text = "Morale 90 or more: +20% output.", OutputMultiplier = 1.2, Phase = 2 },
		Sick = { Name = "Sick", Text = "Contagious until treated.", OutputMultiplier = 0.7, HealthPerCycle = -5, Contagious = true, Phase = 2 },
		Grieving = { Name = "Grieving", Text = "A friend died: -20 morale for 2 cycles.", MoraleNow = -20, Cycles = 2, Phase = 3 },
		Exhausted = { Name = "Exhausted", Text = "Rest at 0: works at half speed.", OutputMultiplier = 0.5, Phase = 1 },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000007A"><Properties><string name="Name">DepthBands</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DepthBands: the Deep in bands of floors (bible Sections 6 and 12). Opening a band's first
	floor needs a Push Deeper vote. DigSeconds is per cell for a player with a Drill or Pickaxe.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Floors = Check.shape({ From = Check.integer(1, 10), To = Check.integer(1, 10) }),
		Look = F.Text,
		Ore = Check.optional(Check.ref("Resources")),
		DigSeconds = Check.optional(F.Seconds),
		CavePieces = F.Count,
		Monsters = Check.array(Check.ref("Monsters"), 8),
		Hazards = Check.array(Check.ref("Disasters"), 6),
		LostCrew = F.Flag,
		Buildable = Check.boolean(),
	}),
	Order = { "Mines", "FloodedCaverns", "CrystalHollows", "SourceChamber" },
	Entries = {
		Mines = {
			Name = "Mines",
			Floors = { From = 1, To = 3 },
			Look = "Timber props, lanterns, old carts",
			Ore = "Iron",
			DigSeconds = 20,
			CavePieces = 8,
			Monsters = { "BurrowTick", "TunnelHound", "HollowMiner", "SpitterGrub" },
			Hazards = { "GasLeak", "CaveIn" },
			LostCrew = true,
			Buildable = true,
		},
		FloodedCaverns = {
			Name = "Flooded Caverns",
			Floors = { From = 4, To = 6 },
			Look = "Dripping rock, standing water, burst pipes",
			Ore = "Copper",
			DigSeconds = 30,
			CavePieces = 8,
			Monsters = { "Murkling", "BloatToad", "Lurker", "TideCrab" },
			Hazards = { "Flood", "GasLeak", "CaveIn" },
			LostCrew = true,
			Buildable = true,
		},
		CrystalHollows = {
			Name = "Crystal Hollows",
			Floors = { From = 7, To = 9 },
			Look = "Glowing crystal, radiation",
			Ore = "Crystal",
			DigSeconds = 45,
			CavePieces = 8,
			Monsters = { "Shardling", "PrismStalker", "GeodeGolem", "Resonator" },
			Hazards = { "RadiationLeak", "CaveIn" },
			LostCrew = true,
			Buildable = true,
		},
		SourceChamber = {
			Name = "Source Chamber",
			Floors = { From = 10, To = 10 },
			Look = "A living cavern around the Source",
			DigSeconds = 45,
			CavePieces = 1,
			Monsters = {},
			Hazards = {},
			Buildable = false,
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000007B"><Properties><string name="Name">Difficulties</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Difficulties (bible Sections 5 and 16): Normal at first; Hard unlocks after a Century
	Victory, Nightmare after a Hard win. Threat and resource multipliers are provisional.
	UpgradesTakeTime: upgrades become construction sites instead of applying at once (Landon,
	Nov 8, 2026: "maybe construction time on the hardest mode").
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Unlock = F.Short,
		ThreatMultiplier = F.NonNegative,
		ResourceMultiplier = F.NonNegative,
		PayoutMultiplier = F.NonNegative,
		Badge = Check.optional(Check.ref("Badges")),
		UpgradesTakeTime = F.Flag,
	}),
	Order = { "Normal", "Hard", "Nightmare" },
	Entries = {
		Normal = { Name = "Normal", Unlock = "From the start", ThreatMultiplier = 1, ResourceMultiplier = 1, PayoutMultiplier = 1 },
		Hard = { Name = "Hard", Unlock = "After a Century Victory", ThreatMultiplier = 1.35, ResourceMultiplier = 0.8, PayoutMultiplier = 1.5, Badge = "HardVictory" },
		Nightmare = { Name = "Nightmare", Unlock = "After a Hard win", ThreatMultiplier = 1.75, ResourceMultiplier = 0.65, PayoutMultiplier = 2, Badge = "NightmareVictory", UpgradesTakeTime = true },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000007C"><Properties><string name="Name">DigResults</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DigResults: what a newly dug cell holds, rolled when it opens (bible Section 6). Chances
	are weights out of 100 (provisional). MinEra keeps cryo pods to Era II onward.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Chance = F.NonNegative,
		MinEra = Check.optional(Check.integer(1, 4)),
		Effect = F.Text,
		Loot = Check.optional(Check.ref("LootTables")),
	}),
	Order = { "Empty", "OrePocket", "CaveOpening", "HazardPocket", "Cache", "CryoPod", "Nest" },
	Entries = {
		Empty = { Name = "Empty", Chance = 60, Effect = "Ready to build on" },
		OrePocket = { Name = "Ore pocket", Chance = 20, Effect = "Bonus ore", Loot = "OrePocket" },
		CaveOpening = { Name = "Cave opening", Chance = 8, Effect = "Opens a 3D cave area" },
		HazardPocket = { Name = "Hazard pocket", Chance = 6, Effect = "Gas or water bursts out" },
		Cache = { Name = "Cache", Chance = 4, Effect = "Scrap, gear or a radio log", Loot = "Cache" },
		CryoPod = { Name = "Cryo pod", Chance = 1, MinEra = 2, Effect = "A frozen survivor" },
		Nest = { Name = "Nest", Chance = 1, Effect = "Monsters pour out at once; destroying it pays well", Loot = "Nest" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000007D"><Properties><string name="Name">Disasters</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Disasters: one comes with every Surge (bible Section 10). Numbers are provisional, for
	Prompts 13, 23 and 24. BestClass names the class built to stop it. SurgeWeight: how often a
	Surge picks it as its one disaster (Section 10's "Caused by": only Surges' own disasters have
	one); a Surge picks among the weighted disasters of its era and before that its budget can
	pay for (ThreatCost). The rule numbers of each disaster are Tuning.Disasters.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		CausedBy = F.Short,
		Effect = F.Text,
		Fix = F.Text,
		BestClass = Check.ref("Classes"),
		Era = Check.integer(1, 4),
		ThreatCost = F.PositiveInt,
		RoomDamagePerSecond = Check.optional(F.NonNegative),
		SpreadSeconds = Check.optional(F.Seconds),
		TimerSeconds = Check.optional(F.Seconds),
		DurationSeconds = Check.optional(F.Seconds),
		SurgeWeight = Check.optional(F.NonNegative),
	}),
	Order = { "Fire", "Flood", "Blackout", "CaveIn", "GasLeak", "ReactorOverload", "RadiationLeak", "Outbreak", "ElectricalSurge" },
	Entries = {
		Fire = {
			Name = "Fire",
			CausedBy = "Surges, Reactor overload, Clumsy residents, electrical surges",
			Effect = "Spreads to the next room every 15 seconds, burning room HP and residents.",
			Fix = "Extinguisher, Foam Grenade, residents in the room.",
			BestClass = "Firefighter",
			Era = 1, ThreatCost = 10, RoomDamagePerSecond = 6, SpreadSeconds = 15, SurgeWeight = 1,
		},
		Flood = {
			Name = "Flood",
			CausedBy = "Flooded Caverns hazards, Bloat Toads, The Deluge",
			Effect = "Water rises in a room and pours down the Shaft.",
			Fix = "Patch the burst pipe, then the room drains.",
			BestClass = "Firefighter",
			Era = 2, ThreatCost = 10, RoomDamagePerSecond = 3, SpreadSeconds = 20,
		},
		Blackout = {
			Name = "Blackout",
			CausedBy = "Surges, electrical surges",
			Effect = "A floor or the whole grid goes dark.",
			Fix = "Reset the fuse box in the Reactor Core.",
			BestClass = "Engineer",
			Era = 1, ThreatCost = 8, DurationSeconds = 60, SurgeWeight = 1,
		},
		CaveIn = {
			Name = "Cave-in",
			CausedBy = "Digging, Tremors",
			Effect = "Rubble blocks a doorway or cell and can trap residents.",
			Fix = "Dig or smash through the rubble.",
			BestClass = "Driller",
			Era = 1, ThreatCost = 8,
		},
		GasLeak = {
			Name = "Gas leak",
			CausedBy = "Hazard pockets in the Mines",
			Effect = "Poison gas fills a room, hurting everyone inside.",
			Fix = "Seal the vent or air the room out.",
			BestClass = "HazmatTech",
			Era = 2, ThreatCost = 10, DurationSeconds = 90,
		},
		ReactorOverload = {
			Name = "Reactor overload",
			CausedBy = "A Reactor Core at 0 HP, or an overclocked one",
			Effect = "A 60-second meltdown timer.",
			Fix = "Three valves turned at the same time, so it takes teamwork; with 1 or 2 players each turned valve stays turned for 10 seconds.",
			BestClass = "Engineer",
			Era = 1, ThreatCost = 14, TimerSeconds = 60,
		},
		RadiationLeak = {
			Name = "Radiation leak",
			CausedBy = "Surface storms against a weak Blast Door",
			Effect = "Floor 1 fills with radiation.",
			Fix = "Seal or upgrade the door; Decon Room.",
			BestClass = "HazmatTech",
			Era = 3, ThreatCost = 12, DurationSeconds = 120,
		},
		Outbreak = {
			Name = "Outbreak",
			CausedBy = "Wanderers, the Deep",
			Effect = "A sickness spreads between residents.",
			Fix = "Medbay treatment and quarantine in Quarters.",
			BestClass = "Medic",
			Era = 3, ThreatCost = 12,
		},
		ElectricalSurge = {
			Name = "Electrical surge",
			CausedBy = "Random, more often in Era III",
			Effect = "Sparks damage the machines in one room.",
			Fix = "Repair with the Welder.",
			BestClass = "Engineer",
			Era = 1, ThreatCost = 6, RoomDamagePerSecond = 10, DurationSeconds = 20,
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000007E"><Properties><string name="Name">DraftCards</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	DraftCards: the blueprint card pool (bible Section 8 and the Appendix). After every Surge
	three cards are drawn and the team votes for one; a card taken leaves the pool for the run.
	Room cards weigh more early (EarlyWeight applies in Era I), so every run gets its key rooms.
	Weights are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function mod(key: string, value: number, extra: { [string]: any }?): { [string]: any }
	local t: { [string]: any } = { Key = key, Value = value }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

local function roomCard(room: string, name: string): { [string]: any }
	return { Name = name, Kind = "Room", Room = room, Text = `Unlocks the {name} for the run.`, Weight = 10, EarlyWeight = 20 }
end

local function card(kind: string, name: string, text: string, modifiers: { any }, weight: number?): { [string]: any }
	return { Name = name, Kind = kind, Text = text, Modifiers = modifiers, Weight = weight or 8 }
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "Room", "BunkerPerk", "ResidentBoon", "PlayerBoon", "RiskDeal" }),
		Text = F.Text,
		Room = Check.optional(Check.ref("Rooms")),
		Modifiers = Check.optional(F.Modifiers),
		Weight = F.NonNegative,
		EarlyWeight = Check.optional(F.NonNegative),
	}),
	Entries = {
		ArmoryCard = roomCard("Armory", "Armory"),
		RadioRoomCard = roomCard("RadioRoom", "Radio Room"),
		LoungeCard = roomCard("Lounge", "Lounge"),
		LabCard = roomCard("Lab", "Lab"),
		DrillBayCard = roomCard("DrillBay", "Drill Bay"),
		GreenhouseCard = roomCard("Greenhouse", "Greenhouse"),
		TrainingRoomCard = roomCard("TrainingRoom", "Training Room"),
		TradingPostCard = roomCard("TradingPost", "Trading Post"),
		MemorialCard = roomCard("Memorial", "Memorial"),

		ReinforcedWalls = card("BunkerPerk", "Reinforced Walls", "+25% room HP.", { mod("RoomHP", 1.25) }),
		Sprinklers = card("BunkerPerk", "Sprinklers", "Fire spreads 50% slower.", { mod("FireSpread", 0.5) }),
		SumpPumps = card("BunkerPerk", "Sump Pumps", "Floods drain twice as fast.", { mod("FloodDrainSpeed", 2) }),
		InsulatedGrid = card("BunkerPerk", "Insulated Grid", "Blackouts last half as long.", { mod("BlackoutDuration", 0.5) }),
		DeepLamps = card("BunkerPerk", "Deep Lamps", "Halves the extra monster spawns in dark rooms.", { mod("DarkSpawnBonus", 0.5) }),
		SteelBlastDoor = card("BunkerPerk", "Steel Blast Door", "Blast Door +1 level.", { mod("BlastDoorLevel", 1) }),
		GasFilters = card("BunkerPerk", "Gas Filters", "Gas leaks 50% weaker.", { mod("GasStrength", 0.5) }),

		FieldTraining = card("ResidentBoon", "Field Training", "Every resident +1 level.", { mod("ResidentLevels", 1) }),
		MoraleBroadcast = card("ResidentBoon", "Morale Broadcast", "+15 morale for everyone.", { mod("MoraleNow", 15) }),
		RadioBooster = card("ResidentBoon", "Radio Booster", "Two recruits arrive now.", { mod("RecruitsNow", 2) }),
		VeteranRecruit = card("ResidentBoon", "Veteran Recruit", "A Rare resident joins.", { mod("RareRecruitNow", 1) }),

		ArmoryShipment = card("PlayerBoon", "Armory Shipment", "Every player's weapons +1 rarity.", { mod("WeaponRarityUp", 1) }),
		MedCache = card("PlayerBoon", "Med Cache", "+2 Medkits for every player.", { mod("MedkitsPerPlayer", 2) }),
		AmmoPress = card("PlayerBoon", "Ammo Press", "Ammo crafting costs 30% less.", { mod("AmmoCraftCost", 0.7) }),
		FieldRations = card("PlayerBoon", "Field Rations", "+20% stamina for the rest of the run.", { mod("StaminaMult", 1.2) }),

		DeepCharges = card("RiskDeal", "Deep Charges", "Digging twice as fast, but +50% Disturbance.", {
			mod("DigSpeed", 2, { Scope = "Team" }),
			mod("DigDisturbance", 1.5, { Scope = "Team" }),
		}, 5),
		Overclock = card("RiskDeal", "Overclock", "Reactor Core +50% power, with a chance of overload.", {
			mod("RoomOutput", 1.5, { Room = "ReactorCore" }),
			mod("ReactorOverloadChance", 0.15),
		}, 5),
		BlackMarket = card("RiskDeal", "Black Market", "The trader arrives now with rare stock at +50% prices.", {
			mod("TraderNow", 1),
			mod("TraderRareStock", 1),
			mod("TraderPrices", 1.5),
		}, 5),
		BountyContract = card("RiskDeal", "Bounty Contract", "Kill 30 monsters before the next Surge for 500 Scrap.", {
			mod("BountyKills", 30),
			mod("BountyScrap", 500),
		}, 5),
		SalvageRights = card("RiskDeal", "Salvage Rights", "Double loot on the next surface trip, but the next storm hits 30 seconds early.", {
			mod("NextTripLoot", 2),
			mod("NextStormEarlySeconds", 30),
		}, 5),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000007F"><Properties><string name="Name">Eras</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Eras: the century in quarters, each ended by a boss (bible Section 5). When the year
	counter passes an era's last year, the next Surge is that era's boss.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Number = Check.integer(1, 4),
		Name = F.Name,
		Years = Check.shape({ From = Check.integer(1, 100), To = Check.integer(1, 100) }),
		Band = Check.ref("DepthBands"),
		NewMonsters = Check.array(Check.ref("Monsters"), 8),
		NewDisasters = Check.array(Check.ref("Disasters"), 8),
		Raids = F.Flag,
		Boss = Check.ref("Bosses"),
		Text = F.Short,
	}),
	Order = { "SettlingIn", "Expansion", "Upheaval", "Reckoning" },
	Entries = {
		SettlingIn = {
			Number = 1,
			Name = "Settling In",
			Years = { From = 1, To = 25 },
			Band = "Mines",
			NewMonsters = { "BurrowTick", "TunnelHound", "HollowMiner", "SpitterGrub" },
			NewDisasters = { "Fire", "Blackout", "CaveIn" },
			Boss = "BroodMother",
			Text = "Mines, depth 1 to 3",
		},
		Expansion = {
			Number = 2,
			Name = "Expansion",
			Years = { From = 26, To = 50 },
			Band = "FloodedCaverns",
			NewMonsters = { "Murkling", "BloatToad", "Lurker", "TideCrab", "AshRaider" },
			NewDisasters = { "Flood", "GasLeak" },
			Raids = true,
			Boss = "Deluge",
			Text = "Flooded Caverns, depth 4 to 6; raids on the blast door",
		},
		Upheaval = {
			Number = 3,
			Name = "Upheaval",
			Years = { From = 51, To = 75 },
			Band = "CrystalHollows",
			NewMonsters = { "Shardling", "PrismStalker", "GeodeGolem", "Resonator" },
			NewDisasters = { "RadiationLeak", "Outbreak" },
			Raids = true,
			Boss = "CrystalColossus",
			Text = "Crystal Hollows, depth 7 to 9",
		},
		Reckoning = {
			Number = 4,
			Name = "Reckoning",
			Years = { From = 76, To = 100 },
			Band = "SourceChamber",
			NewMonsters = {},
			NewDisasters = {},
			Raids = true,
			Boss = "Source",
			Text = "Source Chamber, depth 10: everything before, stronger",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000080"><Properties><string name="Name">GamePasses</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	GamePasses: bought once (bible Section 17). PassId is set when the passes are created
	(Prompt 28). Prices provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function mod(key: string, value: number): { [string]: any }
	return { Key = key, Value = value }
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Robux = F.PositiveInt,
		Text = F.Text,
		Modifiers = Check.optional(F.Modifiers),
		NewPlayersOnly = F.Flag,
		PassId = Check.optional(F.PositiveInt),
	}),
	Order = { "VIP", "BigBackpack", "HelperDrone", "ExtraTalentSlot", "QuickRevive", "StarterPack" },
	Entries = {
		VIP = {
			Name = "VIP",
			Robux = 399,
			Text = "+25% Glowshards from runs, a second free class shop reroll each day, VIP lounge and tag in the lobby.",
		},
		BigBackpack = { Name = "Big Backpack", Robux = 199, Text = "+5 backpack slots.", Modifiers = { mod("BackpackSlots", 5) } },
		HelperDrone = {
			Name = "Helper Drone",
			Robux = 299,
			Text = "A personal drone that picks up loot and lights dark rooms; it doesn't fight.",
		},
		ExtraTalentSlot = { Name = "Extra Talent Slot", Robux = 249, Text = "Talent slot 2 without spending Glowshards." },
		QuickRevive = { Name = "Quick Revive", Robux = 249, Text = "Downed timer +50% and one free self-revive per run." },
		StarterPack = {
			Name = "Starter Pack",
			Robux = 199,
			Text = "New players only: 150 Glowshards, a Rare class of your choice, a Steadfast outfit.",
			NewPlayersOnly = true,
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000081"><Properties><string name="Name">GlowshardPacks</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	GlowshardPacks: the premium currency for Robux (bible Section 17). ProductId is set when the
	developer products are created (Prompt 28); prices are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Glowshards = F.PositiveInt,
		Robux = F.PositiveInt,
		ProductId = Check.optional(F.PositiveInt),
	}),
	Order = { "Pack25", "Pack140", "Pack300", "Pack650", "Pack1800" },
	Entries = {
		Pack25 = { Glowshards = 25, Robux = 99 },
		Pack140 = { Glowshards = 140, Robux = 499 },
		Pack300 = { Glowshards = 300, Robux = 999 },
		Pack650 = { Glowshards = 650, Robux = 1999 },
		Pack1800 = { Glowshards = 1800, Robux = 4999 },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000082"><Properties><string name="Name">GlowshardRewards</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	GlowshardRewards: what a run and the meta pay (bible Section 16). A Normal Century Victory
	pays about 50 before quests. Badges, quests and chests carry their own amounts.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Text = F.Short,
		Per = Check.enum({ "YearsSurvived", "BandReached", "Win", "Boss", "Run" }),
		Amount = F.NonNegative,
		Every = Check.optional(F.PositiveInt), -- e.g. 1 per 4 years
		Victory = Check.optional(Check.enum({ "Century", "Deep" })),
		Multiplier = Check.optional(F.NonNegative),
	}),
	Entries = {
		Years = { Text = "1 per 4 years survived (25 for a full century)", Per = "YearsSurvived", Amount = 1, Every = 4 },
		Bands = { Text = "3 per depth band reached (12 for the Source Chamber)", Per = "BandReached", Amount = 3 },
		CenturyVictory = { Text = "Century Victory", Per = "Win", Amount = 15, Victory = "Century" },
		DeepVictory = { Text = "Deep Victory", Per = "Win", Amount = 30, Victory = "Deep" },
		Bosses = { Text = "2 per boss killed", Per = "Boss", Amount = 2 },
		FirstWinOfDay = { Text = "First win of the day doubles that run's payout", Per = "Run", Amount = 0, Multiplier = 2 },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000083"><Properties><string name="Name">ItemRarities</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ItemRarities: weapon and gear rarities (bible Section 9: Rusty, Standard, Reinforced,
	Prototype, Legendary; higher rarity adds damage and one extra perk). Resident outfits give
	+1 to +3 by rarity (Section 11). Multipliers are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Rank = Check.integer(1, 5),
		DamageMultiplier = F.NonNegative,
		Perks = Check.integer(0, 4),
		OutfitBonus = Check.integer(0, 3),
		Color = F.Hex,
	}),
	Order = { "Rusty", "Standard", "Reinforced", "Prototype", "Legendary" },
	Entries = {
		Rusty = { Name = "Rusty", Rank = 1, DamageMultiplier = 0.85, Perks = 0, OutfitBonus = 0, Color = "#8C5B3B" },
		Standard = { Name = "Standard", Rank = 2, DamageMultiplier = 1, Perks = 0, OutfitBonus = 1, Color = "#8E8C88" },
		Reinforced = { Name = "Reinforced", Rank = 3, DamageMultiplier = 1.15, Perks = 1, OutfitBonus = 2, Color = "#3F79B5" },
		Prototype = { Name = "Prototype", Rank = 4, DamageMultiplier = 1.3, Perks = 2, OutfitBonus = 3, Color = "#7D4C9E" },
		Legendary = { Name = "Legendary", Rank = 5, DamageMultiplier = 1.5, Perks = 3, OutfitBonus = 3, Color = "#D9A93A" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000084"><Properties><string name="Name">Items</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Items: weapons, throwables, tools, consumables and resident gear (bible Sections 9, 11 and
	the Appendix). Combat numbers are provisional starting points for the combat prompts
	(11 and 20); rarity scales damage (ItemRarities). AmmoPerShot follows bible Section 9.
	ClassKit marks items that only come in a class kit (Arc Rifle: or as a rare drop).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Melee = Check.shape({
	Damage = F.NonNegative,
	HeavyDamage = F.NonNegative,
	SwingSeconds = F.Seconds,
	Knockback = Check.optional(F.NonNegative),
	StunSeconds = Check.optional(F.Seconds),
	BreaksRubble = F.Flag,
	Digs = F.Flag,
})

local Gun = Check.shape({
	Damage = F.NonNegative,
	Pellets = Check.optional(F.PositiveInt),
	FireRate = F.NonNegative, -- shots (or flame ticks) per second
	Range = F.NonNegative,
	Magazine = F.PositiveInt,
	ReloadSeconds = F.Seconds,
	AmmoPerShot = F.Count,
	SpreadDegrees = F.NonNegative,
	Cone = F.Flag, -- flamethrower: a short cone, not a ray
	Projectile = F.Flag, -- grenade launcher: a real projectile
	BlastRadius = Check.optional(F.NonNegative),
	ChainTargets = Check.optional(F.Count),
	Automatic = F.Flag,
})

local Throwable = Check.shape({
	Radius = F.NonNegative,
	Damage = Check.optional(F.NonNegative),
	StunSeconds = Check.optional(F.Seconds),
	LightSeconds = Check.optional(F.Seconds),
	Extinguishes = F.Flag,
	RevealsHidden = F.Flag,
	Trap = F.Flag,
})

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "Melee", "Gun", "Throwable", "Tool", "Consumable", "Outfit", "ResidentTool", "Placeable" }),
		Text = F.Short,
		Melee = Check.optional(Melee),
		Gun = Check.optional(Gun),
		Throwable = Check.optional(Throwable),
		Outfit = Check.optional(Check.shape({ Stat = Check.ref("Stats"), Health = Check.optional(F.Count), IgnoresGas = F.Flag })),
		ResidentUse = Check.optional(F.Short), -- what a resident does with it as gear
		UsesResource = Check.optional(Check.ref("Resources")),
		HasRarity = F.Flag,
		ClassKit = F.Flag,
		Asset = F.Asset,
	}),
	Entries = {
		-- Melee
		Wrench = {
			Name = "Wrench",
			Kind = "Melee",
			Text = "Fast and light.",
			Melee = { Damage = 14, HeavyDamage = 26, SwingSeconds = 0.35 },
			ResidentUse = "Repairs their room faster",
			HasRarity = true,
			Asset = "Weapon_Wrench",
		},
		LeadPipe = {
			Name = "Lead Pipe",
			Kind = "Melee",
			Text = "Balanced.",
			Melee = { Damage = 20, HeavyDamage = 36, SwingSeconds = 0.5 },
			HasRarity = true,
			Asset = "Weapon_LeadPipe",
		},
		FireAxe = {
			Name = "Fire Axe",
			Kind = "Melee",
			Text = "Heavy; breaks rubble.",
			Melee = { Damage = 32, HeavyDamage = 58, SwingSeconds = 0.8, BreaksRubble = true },
			HasRarity = true,
			Asset = "Weapon_FireAxe",
		},
		Sledgehammer = {
			Name = "Sledgehammer",
			Kind = "Melee",
			Text = "Slow, big knockback.",
			Melee = { Damage = 45, HeavyDamage = 80, SwingSeconds = 1.1, Knockback = 30, BreaksRubble = true },
			HasRarity = true,
			Asset = "Weapon_Sledgehammer",
		},
		ShockBaton = {
			Name = "Shock Baton",
			Kind = "Melee",
			Text = "Stuns.",
			Melee = { Damage = 16, HeavyDamage = 28, SwingSeconds = 0.5, StunSeconds = 1.2 },
			HasRarity = true,
			Asset = "Weapon_ShockBaton",
		},
		Pickaxe = {
			Name = "Pickaxe",
			Kind = "Melee",
			Text = "Also digs.",
			Melee = { Damage = 22, HeavyDamage = 40, SwingSeconds = 0.7, Digs = true },
			HasRarity = true,
			Asset = "Weapon_Pickaxe",
		},
		-- Landon, 2026-11-08: every class kit has a melee weapon that matches it. These five are
		-- the kits that had none (the Engineer takes the Wrench). Numbers provisional.
		DefibPaddles = {
			Name = "Defib Paddles",
			Kind = "Melee",
			Text = "Zaps and stuns briefly.",
			Melee = { Damage = 12, HeavyDamage = 22, SwingSeconds = 0.45, StunSeconds = 0.8 },
			HasRarity = true,
			Asset = "Weapon_DefibPaddles",
		},
		AntennaWhip = {
			Name = "Antenna Whip",
			Kind = "Melee",
			Text = "Very fast and light.",
			Melee = { Damage = 11, HeavyDamage = 20, SwingSeconds = 0.3 },
			HasRarity = true,
			Asset = "Weapon_AntennaWhip",
		},
		HazardHook = {
			Name = "Hazard Hook",
			Kind = "Melee",
			Text = "Balanced, with a shove.",
			Melee = { Damage = 18, HeavyDamage = 32, SwingSeconds = 0.5, Knockback = 12 },
			HasRarity = true,
			Asset = "Weapon_HazardHook",
		},
		HuntingKnife = {
			Name = "Hunting Knife",
			Kind = "Melee",
			Text = "Quick and light.",
			Melee = { Damage = 13, HeavyDamage = 24, SwingSeconds = 0.3 },
			HasRarity = true,
			Asset = "Weapon_HuntingKnife",
		},
		PowerWrench = {
			Name = "Power Wrench",
			Kind = "Melee",
			Text = "Motorised; heavy hits.",
			Melee = { Damage = 22, HeavyDamage = 40, SwingSeconds = 0.55, Knockback = 15 },
			HasRarity = true,
			Asset = "Weapon_PowerWrench",
		},

		-- Guns
		PocketPistol = {
			Name = "Pocket Pistol",
			Kind = "Gun",
			Text = "Light ammo, quick.",
			Gun = { Damage = 12, FireRate = 4, Range = 120, Magazine = 10, ReloadSeconds = 1.2, AmmoPerShot = 1, SpreadDegrees = 1.5 },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_PocketPistol",
		},
		ServiceRevolver = {
			Name = "Service Revolver",
			Kind = "Gun",
			Text = "Heavy single shots.",
			Gun = { Damage = 34, FireRate = 1.4, Range = 160, Magazine = 6, ReloadSeconds = 2.2, AmmoPerShot = 1, SpreadDegrees = 0.8 },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_ServiceRevolver",
		},
		PumpShotgun = {
			Name = "Pump Shotgun",
			Kind = "Gun",
			Text = "Close range.",
			Gun = { Damage = 9, Pellets = 8, FireRate = 1, Range = 40, Magazine = 6, ReloadSeconds = 3, AmmoPerShot = 2, SpreadDegrees = 7 },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_PumpShotgun",
		},
		LeverRifle = {
			Name = "Lever Rifle",
			Kind = "Gun",
			Text = "Long range.",
			Gun = { Damage = 45, FireRate = 1.2, Range = 300, Magazine = 7, ReloadSeconds = 2.5, AmmoPerShot = 2, SpreadDegrees = 0.3 },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_LeverRifle",
		},
		RivetSMG = {
			Name = "Rivet SMG",
			Kind = "Gun",
			Text = "Fast fire, light ammo.",
			Gun = { Damage = 9, FireRate = 10, Range = 90, Magazine = 30, ReloadSeconds = 1.8, AmmoPerShot = 1, SpreadDegrees = 3, Automatic = true },
			UsesResource = "Ammo",
			HasRarity = true,
			Asset = "Weapon_RivetSMG",
		},
		Flamethrower = {
			Name = "Flamethrower",
			Kind = "Gun",
			Text = "Exterminator's kit; short cone.",
			Gun = { Damage = 6, FireRate = 10, Range = 18, Magazine = 100, ReloadSeconds = 3, AmmoPerShot = 1, SpreadDegrees = 20, Cone = true, Automatic = true },
			UsesResource = "Ammo",
			HasRarity = true,
			ClassKit = true,
			Asset = "Weapon_Flamethrower",
		},
		GrenadeLauncher = {
			Name = "Grenade Launcher",
			Kind = "Gun",
			Text = "Demolitionist's kit; explosive rounds.",
			Gun = { Damage = 80, FireRate = 0.8, Range = 150, Magazine = 4, ReloadSeconds = 3, AmmoPerShot = 3, SpreadDegrees = 0, Projectile = true, BlastRadius = 10 },
			UsesResource = "Ammo",
			HasRarity = true,
			ClassKit = true,
			Asset = "Weapon_GrenadeLauncher",
		},
		ArcRifle = {
			Name = "Arc Rifle",
			Kind = "Gun",
			Text = "Mad Scientist's kit; rare drop otherwise. Arcs jump between enemies.",
			Gun = { Damage = 28, FireRate = 2, Range = 100, Magazine = 12, ReloadSeconds = 2.4, AmmoPerShot = 2, SpreadDegrees = 0.5, ChainTargets = 1 },
			UsesResource = "Ammo",
			HasRarity = true,
			ClassKit = true,
			Asset = "Weapon_ArcRifle",
		},

		-- Throwables
		FragGrenade = {
			Name = "Frag Grenade",
			Kind = "Throwable",
			Text = "Area damage.",
			Throwable = { Radius = 12, Damage = 90 },
			Asset = "Throwable_FragGrenade",
		},
		Flare = {
			Name = "Flare",
			Kind = "Throwable",
			Text = "Lights an area and reveals Prism Stalkers.",
			Throwable = { Radius = 40, LightSeconds = 20, RevealsHidden = true },
			Asset = "Throwable_Flare",
		},
		FoamGrenade = {
			Name = "Foam Grenade",
			Kind = "Throwable",
			Text = "Puts out fires.",
			Throwable = { Radius = 14, Extinguishes = true },
			Asset = "Throwable_FoamGrenade",
		},
		ShockMine = {
			Name = "Shock Mine",
			Kind = "Throwable",
			Text = "Stuns whatever steps on it.",
			Throwable = { Radius = 6, StunSeconds = 3, Trap = true },
			Asset = "Throwable_ShockMine",
		},

		-- Tools
		Drill = { Name = "Drill", Kind = "Tool", Text = "Digs rock.", HasRarity = true, Asset = "Tool_Drill" },
		Welder = { Name = "Welder", Kind = "Tool", Text = "Repairs rooms.", HasRarity = true, Asset = "Tool_Welder" },
		Extinguisher = { Name = "Extinguisher", Kind = "Tool", Text = "Puts out fires.", Asset = "Tool_Extinguisher" },
		GeigerCounter = { Name = "Geiger Counter", Kind = "Tool", Text = "Shows radiation and hazards nearby.", Asset = "Tool_GeigerCounter" },
		Grapple = { Name = "Grapple", Kind = "Tool", Text = "Spelunker's kit; zip lines.", ClassKit = true, Asset = "Tool_Grapple" },

		-- Consumables
		Medkit = {
			Name = "Medkit",
			Kind = "Consumable",
			Text = "Heals a player or revives a resident.",
			UsesResource = "Medkits",
			Asset = "Item_Medkit",
		},
		ClearRadPills = { Name = "Clear-Rad pills", Kind = "Consumable", Text = "Clear radiation.", Asset = "Item_ClearRadPills" },

		-- Placeables (crafted at the Workshop)
		Lamp = { Name = "Lamp", Kind = "Placeable", Text = "A placeable lamp for dark rooms and caves.", Asset = "Prop_Lamp" },
		Barricade = { Name = "Barricade", Kind = "Placeable", Text = "Seals a breach point, making it less likely to open again.", Asset = "Prop_Barricade" },
		Turret = { Name = "Turret", Kind = "Placeable", Text = "An auto-turret; the Engineer deploys one with Deploy Turret.", Asset = "Prop_Turret" },

		-- Resident outfits (+1 to +3 by rarity)
		WorkOveralls = { Name = "Work Overalls", Kind = "Outfit", Text = "Strength.", Outfit = { Stat = "Strength" } },
		LabCoat = { Name = "Lab Coat", Kind = "Outfit", Text = "Smarts.", Outfit = { Stat = "Smarts" } },
		SecurityVest = { Name = "Security Vest", Kind = "Outfit", Text = "Grit and health.", Outfit = { Stat = "Grit", Health = 20 } },
		TrackJacket = { Name = "Track Jacket", Kind = "Outfit", Text = "Speed.", Outfit = { Stat = "Speed" } },
		SundayBest = { Name = "Sunday Best", Kind = "Outfit", Text = "Charm.", Outfit = { Stat = "Charm" } },
		HazmatSuit = {
			Name = "Hazmat Suit",
			Kind = "Outfit",
			Text = "Grit; ignores gas. Part of the Hazmat Tech's kit.",
			Outfit = { Stat = "Grit", IgnoresGas = true },
		},

		-- Resident tools
		Stethoscope = { Name = "Stethoscope", Kind = "ResidentTool", Text = "Medbay.", ResidentUse = "Better Medbay output" },
		HandDrill = { Name = "Hand Drill", Kind = "ResidentTool", Text = "Digging.", ResidentUse = "Digs faster in the Drill Bay queue" },
		RadioHeadset = {
			Name = "Radio Headset",
			Kind = "ResidentTool",
			Text = "Recruiting. Part of the Radio Operator's kit.",
			ResidentUse = "Better recruiting in the Radio Room",
		},
		Ladle = { Name = "Ladle", Kind = "ResidentTool", Text = "Kitchen.", ResidentUse = "Better Kitchen output" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000085"><Properties><string name="Name">Leaderboards</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Leaderboards on lobby billboards (bible Section 16), weekly and all-time.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Stat = Check.enum({ "DeepVictorySeconds", "EndlessYears", "ResidentsAtYear100" }),
		LowerIsBetter = F.Flag,
		Periods = Check.array(Check.enum({ "Weekly", "AllTime" }), 2),
	}),
	Order = { "FastestDeepVictory", "MostYearsEndless", "MostResidentsAtYear100" },
	Entries = {
		FastestDeepVictory = { Name = "Fastest Deep Victory", Stat = "DeepVictorySeconds", LowerIsBetter = true, Periods = { "Weekly", "AllTime" } },
		MostYearsEndless = { Name = "Most years in Endless", Stat = "EndlessYears", Periods = { "Weekly", "AllTime" } },
		MostResidentsAtYear100 = { Name = "Most residents alive at Year 100", Stat = "ResidentsAtYear100", Periods = { "Weekly", "AllTime" } },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000086"><Properties><string name="Name">Legends</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Legends: permanent legendary residents players collect and bring into runs (bible Section
	15). A Legend starts at level 5 with its signature trait, one good trait (rolled from
	Traits, Good) and signature gear; never ages; Renown 1 to 5 (Tuning.Legends). The first
	twelve of 24 are here; the rest arrive with Prompt 27. Each is one of a kind in looks too
	(Tiers.Legendary).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function mod(key: string, value: number, extra: { [string]: any }?): { [string]: any }
	local t: { [string]: any } = { Key = key, Value = value }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Signature = Check.shape({ Name = F.Name, Text = F.Text, Modifiers = Check.optional(F.Modifiers) }),
		Gear = Check.optional(F.ItemStacks),
		Get = Check.shape({
			Kind = Check.enum({ "Starter", "Badge", "Glowshards", "Event" }),
			Glowshards = F.Glowshards,
			Badge = Check.optional(Check.ref("Badges")),
		}),
		BestStat = Check.ref("Stats"),
	}),
	Order = {
		"RosieKowalski", "AbnerPrice", "EarlHutch", "MabelFitz", "JuneOkafor", "IngridVale",
		"LouMarchetti", "TexDelgado", "WrenHolloway", "OldManHiggins", "IvyAlvarez", "DutchVanDorn",
	},
	Entries = {
		RosieKowalski = {
			Name = "Rosie 'Rivets' Kowalski",
			Signature = { Name = "Rivet Queen", Text = "Slowly repairs every room on her floor.", Modifiers = { mod("RepairsRooms", 1, { Scope = "Floor" }) } },
			Gear = { { Item = "Wrench" }, { Item = "WorkOveralls" } },
			Get = { Kind = "Starter" },
			BestStat = "Strength",
		},
		AbnerPrice = {
			Name = "Doc Abner Price",
			Signature = { Name = "House Calls", Text = "Residents he treats heal twice as fast.", Modifiers = { mod("TreatedHealSpeed", 2) } },
			Gear = { { Item = "Stethoscope" }, { Item = "LabCoat" } },
			Get = { Kind = "Badge", Badge = "Rescue50" },
			BestStat = "Smarts",
		},
		EarlHutch = {
			Name = "Big Earl Hutch",
			Signature = { Name = "Doorman", Text = "The Blast Door takes 50% less damage while he guards it.", Modifiers = { mod("BlastDoorDamageTaken", 0.5) } },
			Gear = { { Item = "Sledgehammer" }, { Item = "SecurityVest" } },
			Get = { Kind = "Glowshards", Glowshards = 200 },
			BestStat = "Grit",
		},
		MabelFitz = {
			Name = "Mabel Fitz",
			Signature = { Name = "Sunday Pies", Text = "+10 morale for everyone after each Surge survived.", Modifiers = { mod("SurgeSurvivedMorale", 10) } },
			Gear = { { Item = "Ladle" }, { Item = "SundayBest" } },
			Get = { Kind = "Glowshards", Glowshards = 150 },
			BestStat = "Speed",
		},
		JuneOkafor = {
			Name = "Captain June Okafor",
			Signature = { Name = "Steady Orders", Text = "Armed residents deal +20% damage.", Modifiers = { mod("ArmedResidentDamage", 1.2) } },
			Gear = { { Item = "ServiceRevolver" }, { Item = "SecurityVest" } },
			Get = { Kind = "Badge", Badge = "CenturyVictory" },
			BestStat = "Grit",
		},
		IngridVale = {
			Name = "Professor Ingrid Vale",
			Signature = { Name = "Breakthrough", Text = "Lab research twice as fast.", Modifiers = { mod("ResearchSpeed", 2) } },
			Gear = { { Item = "LabCoat" } },
			Get = { Kind = "Glowshards", Glowshards = 300 },
			BestStat = "Smarts",
		},
		LouMarchetti = {
			Name = "Lucky Lou Marchetti",
			Signature = { Name = "Lucky Streak", Text = "Double loot from expeditions.", Modifiers = { mod("ExpeditionLoot", 2) } },
			Gear = { { Item = "TrackJacket" } },
			Get = { Kind = "Glowshards", Glowshards = 250 },
			BestStat = "Speed",
		},
		TexDelgado = {
			Name = "Tex Delgado",
			Signature = {
				Name = "Quick Draw",
				Text = "Fires twice as fast and defends any room he stands in.",
				Modifiers = { mod("FireRate", 2), mod("DefendsAnyRoom", 1) },
			},
			Gear = { { Item = "ServiceRevolver" } },
			Get = { Kind = "Glowshards", Glowshards = 300 },
			BestStat = "Grit",
		},
		WrenHolloway = {
			Name = "Wren Holloway",
			Signature = { Name = "Silver Tongue", Text = "Radio recruits arrive twice as often.", Modifiers = { mod("RecruitRate", 2) } },
			Gear = { { Item = "RadioHeadset" }, { Item = "SundayBest" } },
			Get = { Kind = "Badge", Badge = "LetIn10Wanderers" },
			BestStat = "Charm",
		},
		OldManHiggins = {
			Name = "Old Man Higgins",
			Signature = { Name = "Mentor", Text = "Residents in his room gain double experience.", Modifiers = { mod("ResidentXP", 2, { Scope = "Room" }) } },
			Get = { Kind = "Badge", Badge = "Year100With30" },
			BestStat = "Charm",
		},
		IvyAlvarez = {
			Name = "Ivy 'Torch' Alvarez",
			Signature = { Name = "Firewall", Text = "Fires can't spread out of the room she is in.", Modifiers = { mod("FireContained", 1) } },
			Gear = { { Item = "Extinguisher" }, { Item = "WorkOveralls" } },
			Get = { Kind = "Glowshards", Glowshards = 200 },
			BestStat = "Grit",
		},
		DutchVanDorn = {
			Name = "Dutch van Dorn",
			Signature = { Name = "Deep Nose", Text = "Every cell he digs holds at least an ore pocket.", Modifiers = { mod("OrePocketGuaranteed", 1) } },
			Gear = { { Item = "HandDrill" }, { Item = "WorkOveralls" } },
			Get = { Kind = "Badge", Badge = "Depth10" },
			BestStat = "Strength",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000087"><Properties><string name="Name">LootTables</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	LootTables: what containers, caches, nests, monsters, expeditions and crates give (bible
	Sections 6, 10, 12, 13, 17). Each roll picks one line by Weight and gives Min..Max of it.
	A line gives a Resource, an Item, or a Special: BandOre (the ore of the band it's in), Gear
	(a random weapon or outfit, rarity rolled), Blueprint (a draft card), RadioLog, Glowshards,
	Recruit. Every number is provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Line = Check.shape({
	Resource = Check.optional(Check.ref("Resources")),
	Item = Check.optional(Check.ref("Items")),
	Special = Check.optional(Check.enum({ "BandOre", "Gear", "Blueprint", "RadioLog", "Glowshards", "Recruit" })),
	Min = F.Count,
	Max = F.Count,
	Weight = F.NonNegative,
})

local function r(resource: string, min: number, max: number, weight: number)
	return { Resource = resource, Min = min, Max = max, Weight = weight }
end
local function i(item: string, min: number, max: number, weight: number)
	return { Item = item, Min = min, Max = max, Weight = weight }
end
local function s(special: string, min: number, max: number, weight: number)
	return { Special = special, Min = min, Max = max, Weight = weight }
end

return {
	Schema = Check.shape({
		Text = F.Short,
		Rolls = F.PositiveInt,
		Lines = Check.array(Line, 16),
	}),
	Entries = {
		-- Digging and the Deep
		OrePocket = { Text = "A dug cell with an ore pocket", Rolls = 1, Lines = { s("BandOre", 8, 15, 1) } },
		Cache = {
			Text = "A cache in a dug cell or a cave",
			Rolls = 2,
			Lines = { r("Scrap", 40, 90, 5), s("Gear", 1, 1, 2), s("RadioLog", 1, 1, 2), r("Ammo", 20, 40, 2), r("Medkits", 1, 2, 1),
				i("FragGrenade", 1, 2, 1), i("Flare", 1, 2, 1) }, -- throwables found exploring (Landon, 2026-11-08)
		},
		Nest = {
			Text = "A destroyed nest",
			Rolls = 2,
			Lines = { r("Scrap", 80, 150, 3), s("BandOre", 10, 20, 3) },
		},
		GlowshardChest = { Text = "A Glowshard chest in the Deep (rare)", Rolls = 1, Lines = { s("Glowshards", 1, 3, 1) } },

		-- Monster drops
		MinesMonster = { Text = "A Mines monster", Rolls = 1, Lines = { r("Scrap", 2, 6, 6), r("Iron", 1, 3, 3), r("Ammo", 2, 6, 1) } },
		FloodedMonster = { Text = "A Flooded Caverns monster", Rolls = 1, Lines = { r("Scrap", 3, 8, 6), r("Copper", 1, 3, 3), r("Ammo", 3, 8, 1) } },
		CrystalMonster = { Text = "A Crystal Hollows monster", Rolls = 1, Lines = { r("Scrap", 4, 10, 6), r("Crystal", 1, 2, 3), r("Ammo", 4, 10, 1) } },
		SurfaceMonster = { Text = "A surface creature", Rolls = 1, Lines = { r("Scrap", 2, 5, 6), r("Food", 1, 2, 2) } },
		Raider = { Text = "A beaten Ash Raider", Rolls = 1, Lines = { r("Scrap", 5, 12, 5), r("Ammo", 5, 15, 4), s("Gear", 1, 1, 1) } },

		-- Surface containers (refill every era)
		Diner = { Text = "Main Street diner", Rolls = 2, Lines = { r("Food", 3, 8, 6), r("Water", 2, 6, 4), r("Scrap", 5, 15, 2) } },
		HardwareStore = {
			Text = "Hardware store",
			Rolls = 2,
			Lines = { r("Scrap", 15, 40, 6), s("Gear", 1, 1, 2), i("Lamp", 1, 1, 1), s("Blueprint", 1, 1, 1), i("FoamGrenade", 1, 2, 1) },
		},
		Grocery = { Text = "Grocery", Rolls = 2, Lines = { r("Food", 5, 12, 6), r("Water", 4, 10, 4) } },
		GasStation = { Text = "Gas station", Rolls = 2, Lines = { r("Scrap", 10, 25, 5), r("Water", 2, 6, 3), i("Flare", 1, 2, 2) } },
		Motel = { Text = "Motel", Rolls = 2, Lines = { r("Medkits", 1, 2, 3), r("Food", 2, 6, 3), s("RadioLog", 1, 1, 1), r("Scrap", 5, 15, 3) } },
		RadioTower = { Text = "Radio tower", Rolls = 2, Lines = { s("RadioLog", 1, 1, 3), r("Scrap", 10, 25, 4), s("Blueprint", 1, 1, 1) } },
		WaterTower = { Text = "Water tower", Rolls = 2, Lines = { r("Water", 8, 16, 7), r("Scrap", 5, 10, 2) } },
		RailYard = { Text = "Rail yard and wrecked train", Rolls = 3, Lines = { r("Scrap", 20, 50, 6), s("Gear", 1, 1, 2), r("Iron", 3, 8, 2) } },
		Showroom = {
			Text = "The ruined Steadfast showroom",
			Rolls = 3,
			Lines = { s("Blueprint", 1, 1, 3), s("RadioLog", 1, 1, 3), s("Gear", 1, 1, 2), r("Scrap", 15, 35, 3) },
		},
		Checkpoint = {
			Text = "Military checkpoint (Era III)",
			Rolls = 3,
			Lines = { r("Ammo", 30, 70, 5), s("Gear", 1, 1, 4), r("Medkits", 2, 4, 3), i("FragGrenade", 1, 2, 2), i("ShockMine", 1, 1, 1) },
		},

		-- Expeditions (per cycle away)
		ExpeditionSurface = {
			Text = "A resident expedition to the surface, per cycle",
			Rolls = 2,
			Lines = { r("Scrap", 20, 50, 6), r("Food", 3, 8, 3), r("Water", 3, 8, 3), s("Gear", 1, 1, 1), s("Blueprint", 1, 1, 1), s("Recruit", 1, 1, 1) },
		},
		ExpeditionDeep = {
			Text = "A resident expedition into the Deep, per cycle",
			Rolls = 2,
			Lines = { r("Scrap", 15, 40, 4), s("BandOre", 5, 12, 5), s("Gear", 1, 1, 1), s("Recruit", 1, 1, 1) },
		},

		-- Crates
		SupplyDrop = {
			Text = "Supply Drop team boost: Food, Water, Ammo and Medkits at the Blast Door",
			Rolls = 4,
			Lines = { r("Food", 20, 20, 1), r("Water", 20, 20, 1), r("Ammo", 100, 100, 1), r("Medkits", 3, 3, 1) },
		},
		SupplyCall = {
			Text = "The Radio Operator's Supply Call crate",
			Rolls = 3,
			Lines = { r("Food", 10, 15, 2), r("Water", 10, 15, 2), r("Ammo", 50, 80, 2), r("Medkits", 2, 3, 1), r("Scrap", 60, 100, 2) },
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000088"><Properties><string name="Name">Modifiers</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Modifiers: the vocabulary of effects. Classes, traits, Legends, draft cards and passes
	describe what they do as a list of { Key, Value, Scope?, Room? }; the system that owns a
	key applies it. Prompt says which build prompt (bible Section 24) implements the key, so
	every effect in the data has a home.

	Unit: Multiplier (x Value), Add (+ Value), Set (becomes Value), Flag (1 = on),
	Chance (0 to 1). Scope (default here, can be overridden): Self (the holder), Presence
	(while the holder is in the room), Room (everyone in the holder's room), Nearby (around
	the holder), Floor, Team (all players), Bunker (the whole run).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function m(unit: string, scope: string, prompt: number, text: string)
	return { Unit = unit, Scope = scope, Prompt = prompt, Text = text }
end

return {
	Schema = Check.shape({
		Unit = Check.enum({ "Multiplier", "Add", "Set", "Flag", "Chance" }),
		Scope = F.Scope,
		Prompt = Check.integer(0, 40),
		Text = F.Short,
	}),
	Entries = {
		-- Player combat and survival (Prompts 11, 20)
		MaxHealth = m("Add", "Self", 11, "Max health"),
		MaxHealthMult = m("Multiplier", "Self", 11, "Max health"),
		StaminaMult = m("Multiplier", "Team", 11, "Max stamina"),
		SurfaceMoveSpeed = m("Multiplier", "Self", 16, "Move speed on the surface"),
		ReviveSeconds = m("Set", "Self", 11, "Seconds to revive a downed player"),
		TouchHeal = m("Flag", "Self", 20, "Heals residents by touch"),
		FireFloodDamageTaken = m("Multiplier", "Self", 13, "Damage taken from fire and floods"),
		NearbyResidentDamage = m("Multiplier", "Nearby", 20, "Damage dealt by residents near the holder"),
		ArmedResidentDamage = m("Multiplier", "Bunker", 20, "Damage dealt by armed residents"),
		CreatureDamage = m("Multiplier", "Self", 11, "Damage to monsters"),
		GunDamage = m("Multiplier", "Self", 11, "Gun damage"),
		FireRate = m("Multiplier", "Self", 11, "Gun fire rate"),
		WeakPointMultiplier = m("Set", "Self", 20, "Damage multiplier on weak-point hits"),
		AimZoom = m("Multiplier", "Self", 20, "Aim zoom"),
		CritsStaggerBosses = m("Flag", "Self", 20, "Critical hits stagger bosses"),
		BurnSpreadsBetweenMonsters = m("Flag", "Self", 20, "Burning spreads between monsters, never to rooms"),
		FuelUse = m("Multiplier", "Self", 20, "Flamethrower fuel use"),
		ExplosiveDamage = m("Multiplier", "Self", 20, "Explosive damage"),
		ExplosiveRadius = m("Multiplier", "Self", 20, "Explosive radius"),
		ExtraFragGrenades = m("Add", "Self", 20, "Extra Frag Grenades in the loadout"),
		ExplosionsStunBosses = m("Flag", "Self", 20, "Explosions stun bosses"),
		ArcChainTargets = m("Set", "Self", 20, "Enemies the Arc Rifle chains to"),
		DroneGuns = m("Set", "Self", 20, "Guns on the combat drone"),
		DroneRevivesPerSurge = m("Add", "Self", 20, "Times per Surge the drone revives its owner"),
		TurretDuration = m("Multiplier", "Self", 20, "How long turrets last"),
		TurretShock = m("Flag", "Self", 20, "Turrets shock"),
		BarricadeCost = m("Multiplier", "Self", 20, "Barricade cost"),
		TriagePulseClears = m("Flag", "Self", 20, "Triage Pulse also clears conditions"),
		InstantRally = m("Flag", "Self", 20, "Armed residents answer the holder's rally at once"),
		DefendsAnyRoom = m("Flag", "Self", 27, "Defends whatever room they stand in"),
		LightRadius = m("Multiplier", "Self", 17, "Light radius"),
		NoFallDamage = m("Flag", "Self", 17, "No fall damage"),
		RadiationGain = m("Multiplier", "Self", 16, "How fast radiation builds"),
		GasImmune = m("Flag", "Self", 23, "Immune to gas"),
		GasDamageTaken = m("Multiplier", "Self", 23, "Damage taken from gas"),
		StormWarningSeconds = m("Add", "Self", 16, "Seconds of extra warning before the storm siren"),
		KillsLowerDisturbance = m("Flag", "Self", 20, "Kills lower Disturbance"),
		MedkitsPerPlayer = m("Add", "Team", 19, "Medkits given to every player now"),
		WeaponRarityUp = m("Add", "Team", 19, "Every player's weapons go up this many rarities now"),

		-- Loot and backpack (Prompts 16, 20)
		BackpackSlots = m("Add", "Self", 16, "Backpack slots"),
		LootOutline = m("Flag", "Self", 16, "Loot is outlined"),
		ExtraLootRolls = m("Add", "Self", 16, "Extra loot rolls on containers"),
		RareGearOdds = m("Multiplier", "Self", 16, "Odds of rare gear"),
		KeepBackpackWhenDowned = m("Flag", "Self", 16, "Keeps the backpack when downed"),

		-- Building, rooms and economy (Prompts 8, 9)
		RoomOutput = m("Multiplier", "Bunker", 9, "Output of one room type (set Room)"),
		AllOutput = m("Multiplier", "Self", 9, "Output in any job"),
		DoubleOutputChance = m("Chance", "Self", 26, "Chance each cycle of double output"),
		StockpileCaps = m("Multiplier", "Bunker", 9, "Every stockpile cap"),
		BuildCost = m("Multiplier", "Bunker", 8, "Build and upgrade costs"),
		BuildSpeed = m("Multiplier", "Bunker", 8, "Construction speed"),
		RepairSpeed = m("Multiplier", "Self", 13, "Repair speed"),
		RepairsRooms = m("Flag", "Room", 26, "Slowly repairs rooms in scope"),
		FoodUse = m("Multiplier", "Self", 9, "Food eaten each cycle"),
		MealsHeal = m("Flag", "Self", 20, "Hearty Meal also heals"),
		RoomHP = m("Multiplier", "Bunker", 13, "Room HP"),
		BlastDoorHealth = m("Multiplier", "Bunker", 13, "Blast Door health"),
		BlastDoorDamageTaken = m("Multiplier", "Self", 27, "Damage the Blast Door takes while the holder guards it"),
		BlastDoorLevel = m("Add", "Bunker", 19, "Blast Door levels"),
		ReactorOverloadChance = m("Chance", "Bunker", 19, "Chance per Surge of a Reactor overload"),
		ResearchSpeed = m("Multiplier", "Self", 26, "Lab research speed"),
		CraftSpeed = m("Multiplier", "Self", 30, "Workshop crafting speed"),
		AmmoCraftCost = m("Multiplier", "Bunker", 30, "Cost of crafting ammo"),
		ScrapPerCycle = m("Add", "Self", 26, "Scrap found each cycle"),
		TraderPrices = m("Multiplier", "Bunker", 30, "Trader prices"),
		TraderNow = m("Flag", "Bunker", 30, "The trader arrives now"),
		TraderRareStock = m("Flag", "Bunker", 30, "The trader brings rare stock"),
		BreaksVoteTies = m("Flag", "Self", 8, "Breaks tied votes"),
		FreeDraftRerollsPerEra = m("Add", "Self", 19, "Free blueprint rerolls per era"),

		-- Disasters (Prompts 13, 23, 24)
		FireSpread = m("Multiplier", "Bunker", 13, "How fast fire spreads"),
		ExtinguishSpeed = m("Multiplier", "Self", 13, "How fast fires are put out"),
		FireContained = m("Flag", "Room", 27, "Fires can't spread out of the holder's room"),
		RubbleClearInstant = m("Flag", "Self", 20, "The Fire Axe clears rubble instantly"),
		FloodDrainSpeed = m("Multiplier", "Bunker", 23, "How fast floods drain"),
		BlackoutDuration = m("Multiplier", "Bunker", 13, "How long blackouts last"),
		GasStrength = m("Multiplier", "Bunker", 23, "Gas leak strength"),
		OutbreakCureSpeed = m("Multiplier", "Self", 24, "How fast outbreaks are cured"),
		DarkSpawnBonus = m("Multiplier", "Bunker", 12, "Extra monster spawns in dark rooms"),
		AccidentChance = m("Chance", "Self", 26, "Chance each cycle of a minor fire or flood in their room"),

		-- Digging (Prompt 14)
		DigSpeed = m("Multiplier", "Self", 14, "Digging speed"),
		DigDisturbance = m("Multiplier", "Self", 14, "Disturbance added by digging"),
		OreSightCells = m("Set", "Self", 14, "Cells into the rock where ore and caves show"),
		DugOre = m("Multiplier", "Self", 14, "Ore from dug cells"),
		OrePocketGuaranteed = m("Flag", "Self", 27, "Every cell dug holds at least an ore pocket"),

		-- Exploration, recruits and expeditions (Prompts 16, 17, 18)
		RevealCaveLayouts = m("Flag", "Self", 17, "Reveals cave layouts"),
		FindChance = m("Multiplier", "Self", 17, "Chance of finding cryo pods and caches"),
		RescuedFollowSpeed = m("Multiplier", "Self", 16, "Speed of rescued people following the holder"),
		RescuedDamageTaken = m("Multiplier", "Self", 16, "Damage rescued people take while following"),
		ExpeditionLoot = m("Multiplier", "Self", 18, "Expedition loot"),
		ExpeditionScrap = m("Multiplier", "Self", 18, "Scrap from expeditions"),
		ExpeditionCarry = m("Multiplier", "Self", 18, "How much they carry on expeditions"),
		NextTripLoot = m("Multiplier", "Team", 19, "Loot on the next surface trip"),
		NextStormEarlySeconds = m("Add", "Bunker", 19, "The next storm hits this many seconds early"),
		RecruitRate = m("Multiplier", "Bunker", 18, "How often radio recruits arrive"),
		RareRecruitChance = m("Multiplier", "Bunker", 18, "Odds a recruit is Rare"),
		DistressCallLeadSeconds = m("Add", "Bunker", 18, "Distress calls arrive this many seconds sooner"),
		SupplyCallsPerEra = m("Set", "Self", 20, "Supply Calls per era"),
		RecruitsNow = m("Add", "Bunker", 19, "Recruits who arrive now"),
		RareRecruitNow = m("Add", "Bunker", 19, "Rare residents who join now"),
		BountyKills = m("Set", "Team", 19, "Monsters to kill before the next Surge"),
		BountyScrap = m("Set", "Team", 19, "Scrap paid when the bounty is met"),

		-- Residents (Prompts 10, 26, 36)
		ResidentXP = m("Multiplier", "Self", 10, "Resident experience"),
		ChoosesLevelStat = m("Flag", "Self", 20, "Chooses the stat residents raise when they level"),
		ResidentLevels = m("Add", "Bunker", 19, "Levels every resident gains now"),
		MoraleNow = m("Add", "Bunker", 19, "Morale every resident gains now"),
		SurgeSurvivedMorale = m("Add", "Bunker", 27, "Morale for everyone after each Surge survived"),
		RoommateMorale = m("Add", "Room", 26, "Roommates' morale each cycle"),
		TreatedHealSpeed = m("Multiplier", "Self", 27, "Healing speed of residents the holder treats"),
		NeverPanics = m("Flag", "Self", 26, "Never panics"),
		DefendsUnarmed = m("Flag", "Self", 26, "Defends their room even without a weapon"),
		CalmsRoommates = m("Flag", "Room", 26, "Calms panicked roommates"),
		PanicChance = m("Multiplier", "Self", 26, "Chance to panic"),
		FleesBreaches = m("Flag", "Self", 26, "Flees breaches"),
		RunsIntoHazards = m("Flag", "Self", 26, "May run into hazards when panicked"),
		RestNeed = m("Multiplier", "Self", 10, "Rest needed"),
		NoDarkPenalty = m("Flag", "Self", 26, "No penalty in dark rooms"),
		Claustrophobic = m("Flag", "Self", 26, "Morale drops at depth 4 and below"),
		AfraidOfDark = m("Flag", "Self", 26, "Morale crashes in dark rooms and refuses to work there"),
		Hothead = m("Flag", "Self", 36, "Starts fights with rivals"),
		Homesick = m("Flag", "Self", 26, "Morale slowly drains unless they spend time in the Lounge"),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000089"><Properties><string name="Name">Monsters</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Monsters: the creatures (bible Section 10 and the Appendix; bosses are Config.Bosses).
	Monsters go for residents first, then machines, then players who hit them; Targets is each
	type's own order. ThreatCost is what the Threat Director pays to spawn one. Every number is
	provisional, for Prompts 12, 16, 17, 23 and 24.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Target = Check.enum({ "Residents", "Machines", "Players", "BlastDoor" })

return {
	Schema = Check.shape({
		Name = F.Name,
		Where = Check.array(Check.enum({ "Mines", "FloodedCaverns", "CrystalHollows", "Surface" }), 4),
		Role = Check.enum({ "Swarmer", "Runner", "Brute", "Ranged", "Exploder", "Ambusher", "Tank", "Support", "Fighter", "PackRunner", "Stalker" }),
		Text = F.Short,
		Health = F.PositiveInt,
		Damage = F.NonNegative,
		AttackSeconds = F.Seconds,
		Range = F.NonNegative,
		MoveSpeed = F.NonNegative,
		Targets = Check.array(Target, 4),
		ThreatCost = F.PositiveInt,
		Group = Check.shape({ Min = F.PositiveInt, Max = F.PositiveInt }),
		Traits = Check.optional(Check.array(Check.enum({
			"Latches", "Slows", "Explodes", "Floods", "Hides", "Grabs", "ArmoredFront", "WeakPointBack",
			"Shatters", "Invisible", "ShrugsSmallGuns", "Heals", "Hastes", "Fades", "StormOnly", "Radiates", "SmashesMachines",
		}), 6)),
		Drops = Check.optional(Check.ref("LootTables")),
		Era = Check.integer(1, 4),
		Asset = F.Asset,
	}),
	Entries = {
		BurrowTick = {
			Name = "Burrow Tick",
			Where = { "Mines" },
			Role = "Swarmer",
			Text = "Fast and weak, comes in packs, latches onto residents.",
			Health = 20, Damage = 4, AttackSeconds = 0.6, Range = 3, MoveSpeed = 20,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 1, Group = { Min = 4, Max = 8 },
			Traits = { "Latches" },
			Drops = "MinesMonster", Era = 1, Asset = "Monster_BurrowTick",
		},
		TunnelHound = {
			Name = "Tunnel Hound",
			Where = { "Mines" },
			Role = "Runner",
			Text = "Sprints past defenders to reach residents.",
			Health = 60, Damage = 10, AttackSeconds = 0.9, Range = 4, MoveSpeed = 26,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 3, Group = { Min = 1, Max = 3 },
			Drops = "MinesMonster", Era = 1, Asset = "Monster_TunnelHound",
		},
		HollowMiner = {
			Name = "Hollow Miner",
			Where = { "Mines" },
			Role = "Brute",
			Text = "Slow and tough; smashes machines and doors.",
			Health = 320, Damage = 30, AttackSeconds = 1.47, Range = 6, MoveSpeed = 9,
			Targets = { "Machines", "Residents", "Players" },
			ThreatCost = 8, Group = { Min = 1, Max = 1 },
			Traits = { "SmashesMachines" },
			Drops = "MinesMonster", Era = 1, Asset = "Monster_HollowMiner",
		},
		SpitterGrub = {
			Name = "Spitter Grub",
			Where = { "Mines" },
			Role = "Ranged",
			Text = "Spits glowing goo that slows from range.",
			Health = 70, Damage = 8, AttackSeconds = 1.6, Range = 45, MoveSpeed = 8,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 4, Group = { Min = 1, Max = 2 },
			Traits = { "Slows" },
			Drops = "MinesMonster", Era = 1, Asset = "Monster_SpitterGrub",
		},
		Murkling = {
			Name = "Murkling",
			Where = { "FloodedCaverns" },
			Role = "Swarmer",
			Text = "Pours out of water; weak alone.",
			Health = 30, Damage = 6, AttackSeconds = 0.7, Range = 3, MoveSpeed = 18,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 1, Group = { Min = 5, Max = 10 },
			Drops = "FloodedMonster", Era = 2, Asset = "Monster_Murkling",
		},
		BloatToad = {
			Name = "Bloat Toad",
			Where = { "FloodedCaverns" },
			Role = "Exploder",
			Text = "Bursts on death or contact and floods the room.",
			Health = 90, Damage = 40, AttackSeconds = 0, Range = 5, MoveSpeed = 12,
			Targets = { "Machines", "Residents", "Players" },
			ThreatCost = 5, Group = { Min = 1, Max = 2 },
			Traits = { "Explodes", "Floods" },
			Drops = "FloodedMonster", Era = 2, Asset = "Monster_BloatToad",
		},
		Lurker = {
			Name = "Lurker",
			Where = { "FloodedCaverns" },
			Role = "Ambusher",
			Text = "Hides in water or dark rooms and grabs residents.",
			Health = 180, Damage = 18, AttackSeconds = 1.2, Range = 7, MoveSpeed = 16,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 7, Group = { Min = 1, Max = 1 },
			Traits = { "Hides", "Grabs" },
			Drops = "FloodedMonster", Era = 2, Asset = "Monster_Lurker",
		},
		TideCrab = {
			Name = "Tide Crab",
			Where = { "FloodedCaverns" },
			Role = "Tank",
			Text = "Armoured front, weak point on its back.",
			Health = 420, Damage = 24, AttackSeconds = 1.4, Range = 6, MoveSpeed = 8,
			Targets = { "Machines", "Players", "Residents" },
			ThreatCost = 9, Group = { Min = 1, Max = 1 },
			Traits = { "ArmoredFront", "WeakPointBack" },
			Drops = "FloodedMonster", Era = 2, Asset = "Monster_TideCrab",
		},
		Shardling = {
			Name = "Shardling",
			Where = { "CrystalHollows" },
			Role = "Swarmer",
			Text = "Crystal bugs that shatter into stinging shards.",
			Health = 40, Damage = 8, AttackSeconds = 0.7, Range = 3, MoveSpeed = 20,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 2, Group = { Min = 5, Max = 9 },
			Traits = { "Shatters" },
			Drops = "CrystalMonster", Era = 3, Asset = "Monster_Shardling",
		},
		PrismStalker = {
			Name = "Prism Stalker",
			Where = { "CrystalHollows" },
			Role = "Ambusher",
			Text = "Invisible until lit by a flare or lamp.",
			Health = 220, Damage = 26, AttackSeconds = 1, Range = 5, MoveSpeed = 22,
			Targets = { "Residents", "Players", "Machines" },
			ThreatCost = 9, Group = { Min = 1, Max = 2 },
			Traits = { "Invisible" },
			Drops = "CrystalMonster", Era = 3, Asset = "Monster_PrismStalker",
		},
		GeodeGolem = {
			Name = "Geode Golem",
			Where = { "CrystalHollows" },
			Role = "Tank",
			Text = "Very slow with huge health; shrugs off small guns.",
			Health = 900, Damage = 45, AttackSeconds = 2, Range = 7, MoveSpeed = 6,
			Targets = { "Machines", "Players", "Residents" },
			ThreatCost = 14, Group = { Min = 1, Max = 1 },
			Traits = { "ShrugsSmallGuns", "SmashesMachines" },
			Drops = "CrystalMonster", Era = 3, Asset = "Monster_GeodeGolem",
		},
		Resonator = {
			Name = "Resonator",
			Where = { "CrystalHollows" },
			Role = "Support",
			Text = "Hums to heal and speed up nearby monsters; kill it first.",
			Health = 150, Damage = 0, AttackSeconds = 1, Range = 30, MoveSpeed = 10,
			Targets = { "Players", "Residents", "Machines" },
			ThreatCost = 8, Group = { Min = 1, Max = 1 },
			Traits = { "Heals", "Hastes" },
			Drops = "CrystalMonster", Era = 3, Asset = "Monster_Resonator",
		},
		AshRaider = {
			Name = "Ash Raider",
			Where = { "Surface" },
			Role = "Fighter",
			Text = "Melee or rifles; collapses and fades when beaten. Raids the Blast Door from Era II.",
			Health = 120, Damage = 14, AttackSeconds = 1, Range = 60, MoveSpeed = 16,
			Targets = { "BlastDoor", "Residents", "Players", "Machines" },
			ThreatCost = 5, Group = { Min = 2, Max = 5 },
			Traits = { "Fades" },
			Drops = "Raider", Era = 2, Asset = "Monster_AshRaider",
		},
		AshJackal = {
			Name = "Ash Jackal",
			Where = { "Surface" },
			Role = "PackRunner",
			Text = "Mutated animals that circle and dart in.",
			Health = 50, Damage = 9, AttackSeconds = 0.8, Range = 4, MoveSpeed = 24,
			Targets = { "Players", "Residents", "Machines" },
			ThreatCost = 2, Group = { Min = 3, Max = 6 },
			Drops = "SurfaceMonster", Era = 1, Asset = "Monster_AshJackal",
		},
		AshWraith = {
			Name = "Ash Wraith",
			Where = { "Surface" },
			Role = "Stalker",
			Text = "Appears only in storms; each hit adds radiation.",
			Health = 160, Damage = 12, AttackSeconds = 1.1, Range = 6, MoveSpeed = 18,
			Targets = { "Players", "Residents", "Machines" },
			ThreatCost = 7, Group = { Min = 1, Max = 2 },
			Traits = { "StormOnly", "Radiates" },
			Drops = "SurfaceMonster", Era = 1, Asset = "Monster_AshWraith",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000008A"><Properties><string name="Name">MoraleStates</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	MoraleStates: what a resident's morale (0 to 100, starting at 60) does (bible Section 11).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		From = Check.integer(0, 100),
		To = Check.integer(0, 100),
		OutputMultiplier = F.NonNegative,
		Text = F.Short,
	}),
	Order = { "Miserable", "Unhappy", "Settled", "Happy", "Inspired" },
	Entries = {
		Miserable = { Name = "Miserable", From = 0, To = 19, OutputMultiplier = 0.85, Text = "May refuse work, start fights or leave the bunker for good" },
		Unhappy = { Name = "Unhappy", From = 20, To = 39, OutputMultiplier = 0.85, Text = "-15% output" },
		Settled = { Name = "Settled", From = 40, To = 74, OutputMultiplier = 1, Text = "Normal" },
		Happy = { Name = "Happy", From = 75, To = 89, OutputMultiplier = 1.1, Text = "+10% output" },
		Inspired = { Name = "Inspired", From = 90, To = 100, OutputMultiplier = 1.2, Text = "+20% output" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000008B"><Properties><string name="Name">Objectives</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Objectives: what makes more years pass per cycle (bible Sections 5 and 12). Each Lost Crew
	rescued adds 2 to Years per Cycle and brings 3 residents, one of them Rare; each era boss
	beaten adds 1 (the cap is in Tuning.Clock).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "LostCrew", "Boss" }),
		Where = Check.enum({ "Surface", "Mines", "FloodedCaverns", "CrystalHollows", "Era" }),
		Guard = Check.optional(F.Short),
		Boss = Check.optional(Check.ref("Bosses")),
		YearsPerCycle = F.Count,
		Residents = F.Count,
		RareResidents = F.Count,
		Text = F.Text,
	}),
	Order = { "CrewSurface", "CrewMines", "CrewFlooded", "CrewCrystal", "BossBroodMother", "BossDeluge", "BossColossus" },
	Entries = {
		CrewSurface = {
			Name = "Lost Crew: the surface",
			Kind = "LostCrew",
			Where = "Surface",
			Guard = "A raider camp",
			YearsPerCycle = 2, Residents = 3, RareResidents = 1,
			Text = "A trapped Steadfast work crew in Brightwater Ruins. Free them and escort them home.",
		},
		CrewMines = {
			Name = "Lost Crew: the Mines",
			Kind = "LostCrew",
			Where = "Mines",
			Guard = "A nest or a mini-boss",
			YearsPerCycle = 2, Residents = 3, RareResidents = 1,
			Text = "A trapped Steadfast work crew somewhere in the Mines.",
		},
		CrewFlooded = {
			Name = "Lost Crew: the Flooded Caverns",
			Kind = "LostCrew",
			Where = "FloodedCaverns",
			Guard = "A nest or a mini-boss",
			YearsPerCycle = 2, Residents = 3, RareResidents = 1,
			Text = "A trapped Steadfast work crew somewhere in the Flooded Caverns.",
		},
		CrewCrystal = {
			Name = "Lost Crew: the Crystal Hollows",
			Kind = "LostCrew",
			Where = "CrystalHollows",
			Guard = "A nest or a mini-boss",
			YearsPerCycle = 2, Residents = 3, RareResidents = 1,
			Text = "A trapped Steadfast work crew somewhere in the Crystal Hollows.",
		},
		BossBroodMother = { Name = "Beat the Brood Mother", Kind = "Boss", Where = "Era", Boss = "BroodMother", YearsPerCycle = 1, Residents = 0, RareResidents = 0, Text = "Year 25." },
		BossDeluge = { Name = "Beat The Deluge", Kind = "Boss", Where = "Era", Boss = "Deluge", YearsPerCycle = 1, Residents = 0, RareResidents = 0, Text = "Year 50." },
		BossColossus = { Name = "Beat the Crystal Colossus", Kind = "Boss", Where = "Era", Boss = "CrystalColossus", YearsPerCycle = 1, Residents = 0, RareResidents = 0, Text = "Year 75." },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000008C"><Properties><string name="Name">Quests</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Quests (bible Section 16): 3 daily (3 to 5 Glowshards each) and 3 weekly (15 each) are drawn
	from these; both reset at 00:00 UTC. Goal.Event names the run event that counts toward it
	(Prompt 29 wires them); Class narrows it to playing one class.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function q(period: string, text: string, event: string, count: number, reward: number, class: string?): { [string]: any }
	return { Period = period, Text = text, Goal = { Event = event, Count = count, Class = class }, Glowshards = reward }
end

return {
	Schema = Check.shape({
		Period = Check.enum({ "Daily", "Weekly" }),
		Text = F.Short,
		Goal = Check.shape({
			Event = Check.enum({ "RescueSurvivor", "PassVote", "DigCell", "SurviveSurge", "DefeatMonster", "BuildRoom", "FinishExpedition", "ReachYear", "BeatBoss", "FreeLostCrew" }),
			Count = F.PositiveInt,
			Class = Check.optional(Check.ref("Classes")),
		}),
		Glowshards = Check.integer(3, 15),
	}),
	Entries = {
		Rescue2 = q("Daily", "Rescue 2 survivors", "RescueSurvivor", 2, 4),
		PassVotes3 = q("Daily", "Pass 3 votes", "PassVote", 3, 3),
		Dig15 = q("Daily", "Dig 15 cells", "DigCell", 15, 4),
		SurgesAsMedic = q("Daily", "Survive 3 Surges as a Medic", "SurviveSurge", 3, 5, "Medic"),
		Defeat50 = q("Daily", "Defeat 50 monsters", "DefeatMonster", 50, 4),
		Build5 = q("Daily", "Build 5 rooms", "BuildRoom", 5, 3),
		Expeditions2 = q("Daily", "Finish 2 resident expeditions", "FinishExpedition", 2, 4),
		Year25 = q("Daily", "Reach Year 25", "ReachYear", 25, 5),
		Rescue10 = q("Weekly", "Rescue 10 survivors", "RescueSurvivor", 10, 15),
		Dig100 = q("Weekly", "Dig 100 cells", "DigCell", 100, 15),
		BeatBoss = q("Weekly", "Beat an era boss", "BeatBoss", 1, 15),
		Surges20 = q("Weekly", "Survive 20 Surges", "SurviveSurge", 20, 15),
		FreeCrews = q("Weekly", "Free 2 Lost Crews", "FreeLostCrew", 2, 15),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000008D"><Properties><string name="Name">Recipes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Recipes: Workshop crafting (bible Section 13): weapon upgrades one rarity at a time (Scrap
	and ore), ammo (Scrap), throwables, tools, and the Engineer's turrets, barricades and traps.
	Residents working in the Workshop speed crafting and cut costs. Costs are provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "Upgrade", "Ammo", "Throwable", "Tool", "Placeable", "Consumable" }),
		Costs = F.Costs,
		Seconds = F.Seconds,
		Gives = Check.optional(F.ItemStack),
		GivesResource = Check.optional(Check.shape({ Resource = Check.ref("Resources"), Count = F.PositiveInt })),
		ToRarity = Check.optional(Check.ref("ItemRarities")),
		EngineerOnly = F.Flag,
	}),
	Order = {
		"UpgradeStandard", "UpgradeReinforced", "UpgradePrototype", "UpgradeLegendary", "Ammo",
		"FragGrenade", "Flare", "FoamGrenade", "ShockMine", "Drill", "Welder", "Lamp", "Medkit",
		"Barricade", "Turret", "Trap",
	},
	Entries = {
		UpgradeStandard = { Name = "Upgrade to Standard", Kind = "Upgrade", ToRarity = "Standard", Costs = { Scrap = 60 }, Seconds = 15 },
		UpgradeReinforced = { Name = "Upgrade to Reinforced", Kind = "Upgrade", ToRarity = "Reinforced", Costs = { Scrap = 150, Iron = 15 }, Seconds = 25 },
		UpgradePrototype = { Name = "Upgrade to Prototype", Kind = "Upgrade", ToRarity = "Prototype", Costs = { Scrap = 300, Copper = 20 }, Seconds = 40 },
		UpgradeLegendary = { Name = "Upgrade to Legendary", Kind = "Upgrade", ToRarity = "Legendary", Costs = { Scrap = 500, Crystal = 20 }, Seconds = 60 },
		Ammo = { Name = "Ammo", Kind = "Ammo", Costs = { Scrap = 20 }, Seconds = 5, GivesResource = { Resource = "Ammo", Count = 30 } },
		FragGrenade = { Name = "Frag Grenade", Kind = "Throwable", Costs = { Scrap = 40, Iron = 2 }, Seconds = 8, Gives = { Item = "FragGrenade", Count = 1 } },
		Flare = { Name = "Flare", Kind = "Throwable", Costs = { Scrap = 15 }, Seconds = 4, Gives = { Item = "Flare", Count = 2 } },
		FoamGrenade = { Name = "Foam Grenade", Kind = "Throwable", Costs = { Scrap = 30 }, Seconds = 6, Gives = { Item = "FoamGrenade", Count = 1 } },
		ShockMine = { Name = "Shock Mine", Kind = "Throwable", Costs = { Scrap = 45, Copper = 2 }, Seconds = 8, Gives = { Item = "ShockMine", Count = 1 } },
		Drill = { Name = "Drill", Kind = "Tool", Costs = { Scrap = 120, Iron = 10 }, Seconds = 20, Gives = { Item = "Drill", Count = 1 } },
		Welder = { Name = "Welder", Kind = "Tool", Costs = { Scrap = 100, Iron = 8 }, Seconds = 20, Gives = { Item = "Welder", Count = 1 } },
		Lamp = { Name = "Lamp", Kind = "Placeable", Costs = { Scrap = 25 }, Seconds = 6, Gives = { Item = "Lamp", Count = 1 } },
		Medkit = { Name = "Medkit", Kind = "Consumable", Costs = { Scrap = 50 }, Seconds = 10, GivesResource = { Resource = "Medkits", Count = 1 } },
		Barricade = { Name = "Barricade", Kind = "Placeable", Costs = { Scrap = 80, Iron = 5 }, Seconds = 10, Gives = { Item = "Barricade", Count = 1 }, EngineerOnly = true },
		Turret = { Name = "Turret", Kind = "Placeable", Costs = { Scrap = 200, Iron = 15 }, Seconds = 30, Gives = { Item = "Turret", Count = 1 }, EngineerOnly = true },
		Trap = { Name = "Shock Trap", Kind = "Placeable", Costs = { Scrap = 60, Copper = 3 }, Seconds = 10, Gives = { Item = "ShockMine", Count = 2 }, EngineerOnly = true },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000008E"><Properties><string name="Name">ResidentNames</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	ResidentNames: name pools for residents (bible Section 11: named people). Brightwater is an
	original 1950s American small town, so the names are period ones from many backgrounds.
	Nicknames are for Rare and Legendary residents ("Rosie 'Rivets' Kowalski"). A name is
	First + Last, never repeated within a run while the pool lasts.
]]

local Check = require(script.Parent.Parent.Utilities.Check)

local Names = Check.array(Check.string(24, { min = 2, pattern = "^[%a][%a' %-%.]*$" }), 300)

return {
	Schema = Check.shape({ Names = Names }),
	Order = { "First", "Last", "Nickname" },
	Entries = {
		First = {
			Names = {
				"Abe", "Ada", "Agnes", "Al", "Alice", "Alma", "Amos", "Angelo", "Annie", "Archie", "Arlene", "Arthur",
				"Audrey", "Bea", "Benny", "Bernice", "Bert", "Betty", "Bill", "Billie", "Bobbie", "Bud", "Buster",
				"Carl", "Carmen", "Cecil", "Charlotte", "Chester", "Clara", "Clarence", "Cliff", "Connie", "Cora",
				"Dale", "Dolores", "Donna", "Dot", "Doug", "Earl", "Edith", "Eddie", "Edna", "Elena", "Eli", "Ella",
				"Elmer", "Elsie", "Ernie", "Esther", "Ethel", "Eugene", "Faye", "Frank", "Freddie", "Gene", "Georgia",
				"Gertie", "Gil", "Gloria", "Gus", "Hank", "Harold", "Harriet", "Hazel", "Helen", "Herb", "Hiro",
				"Homer", "Howard", "Ida", "Irene", "Irving", "Jack", "Jean", "Jimmy", "Joan", "Joe", "Josie", "June",
				"Kay", "Kenji", "Lena", "Leon", "Leroy", "Lillian", "Lou", "Louise", "Luis", "Mabel", "Mae", "Marge",
				"Marvin", "Maxine", "Mel", "Mickey", "Mildred", "Milt", "Minnie", "Nadine", "Nell", "Norma", "Ollie",
				"Opal", "Oscar", "Otis", "Pat", "Pearl", "Pete", "Phyllis", "Ray", "Rita", "Roscoe", "Ruby", "Rudy",
				"Ruth", "Sal", "Sam", "Shirley", "Sid", "Stan", "Stella", "Sue", "Teddy", "Thelma", "Tomas", "Velma",
				"Vera", "Vern", "Viola", "Virgil", "Wally", "Walt", "Wanda", "Wendell", "Wilma", "Winnie", "Woody",
				"Yuki", "Zelda",
			},
		},
		Last = {
			Names = {
				"Abbott", "Alvarez", "Anders", "Baker", "Banks", "Barlow", "Becker", "Bell", "Bishop", "Brennan",
				"Brooks", "Bui", "Caldwell", "Carver", "Castillo", "Chen", "Clark", "Cobb", "Coleman", "Costa",
				"Crane", "Cruz", "Delgado", "Dixon", "Doyle", "Duffy", "Dunn", "Ellis", "Engel", "Esposito", "Farrell",
				"Fischer", "Fitz", "Flores", "Foster", "Fujita", "Gallo", "Garza", "Gibbs", "Gomez", "Grady", "Graves",
				"Haas", "Hale", "Harlan", "Hayes", "Hicks", "Holloway", "Hooper", "Hughes", "Hutch", "Ibarra", "Jansen",
				"Jennings", "Kaplan", "Keller", "Kim", "Kowalski", "Kramer", "Lambert", "Lang", "Larsen", "Lee", "Lowry",
				"Lund", "Maddox", "Malone", "Marchetti", "Marsh", "Mendez", "Meyer", "Miller", "Moreau", "Morales",
				"Murphy", "Nakamura", "Nash", "Novak", "Nowak", "O'Brien", "Okafor", "Olsen", "Ortiz", "Owens", "Park",
				"Patel", "Pike", "Price", "Quinn", "Ramos", "Reyes", "Rhodes", "Riley", "Rossi", "Russo", "Sato",
				"Schmidt", "Shaw", "Silva", "Sloane", "Sorensen", "Stone", "Sullivan", "Tanaka", "Torres", "Tucker",
				"Vale", "Vargas", "Vaughn", "Walsh", "Ward", "Webb", "Whitaker", "Wilder", "Wong", "Yates", "Zielinski",
			},
		},
		Nickname = {
			Names = {
				"Ace", "Bolts", "Buttons", "Chipper", "Copper", "Doc", "Dynamite", "Fizz", "Flash", "Gadget", "Gears",
				"Hammer", "Hotshot", "Lucky", "Moxie", "Patches", "Pepper", "Rivets", "Rocket", "Sarge", "Scoop",
				"Slim", "Smokey", "Socket", "Sparky", "Sprocket", "Sunny", "Tiny", "Torch", "Tumbler", "Whistle",
			},
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000008F"><Properties><string name="Name">Resources</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Resources: the team's shared stockpile (bible Section 13). Power is a live balance, not a
	stock. Starting stock is bible Section 6; caps are provisional (each Storage cell raises
	every cap; the Quartermaster adds 25%).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Kind = Check.enum({ "Live", "Stock" }),
		Start = F.Count,
		Cap = F.Count,
		CapPerStorageCell = F.Count,
		From = F.Text,
		SpentOn = F.Text,
	}),
	Order = { "Power", "Food", "Water", "Scrap", "Iron", "Copper", "Crystal", "Medkits", "Ammo" },
	Entries = {
		Power = {
			Name = "Power",
			Kind = "Live",
			Start = 0,
			Cap = 0,
			CapPerStorageCell = 0,
			From = "Reactor Core and Generators, as a live balance",
			SpentOn = "Every room, by level",
		},
		Food = {
			Name = "Food",
			Kind = "Stock",
			Start = 30,
			Cap = 100,
			CapPerStorageCell = 50,
			From = "Kitchen, Greenhouse, surface loot, expeditions",
			SpentOn = "1 per resident per cycle",
		},
		Water = {
			Name = "Water",
			Kind = "Stock",
			Start = 30,
			Cap = 100,
			CapPerStorageCell = 50,
			From = "Water Purifier, surface loot",
			SpentOn = "1 per resident per cycle",
		},
		Scrap = {
			Name = "Scrap",
			Kind = "Stock",
			Start = 300,
			Cap = 1000,
			CapPerStorageCell = 500,
			From = "Surface loot, monster drops, caches, expeditions, the trader",
			SpentOn = "Building, upgrades, repairs, crafting, the trader",
		},
		Iron = {
			Name = "Iron",
			Kind = "Stock",
			Start = 0,
			Cap = 100,
			CapPerStorageCell = 60,
			From = "Digging in the Mines, cave veins, the Drill Bay, Mines monsters",
			SpentOn = "Level 2 upgrades, crafting",
		},
		Copper = {
			Name = "Copper",
			Kind = "Stock",
			Start = 0,
			Cap = 60,
			CapPerStorageCell = 40,
			From = "Digging in the Flooded Caverns, cave veins, the Drill Bay, Flooded monsters",
			SpentOn = "Level 3 upgrades, crafting",
		},
		Crystal = {
			Name = "Crystal",
			Kind = "Stock",
			Start = 0,
			Cap = 40,
			CapPerStorageCell = 25,
			From = "Digging in the Crystal Hollows, cave veins, the Drill Bay, Crystal monsters",
			SpentOn = "Level 3 upgrades, crafting",
		},
		Medkits = {
			Name = "Medkits",
			Kind = "Stock",
			Start = 4,
			Cap = 20,
			CapPerStorageCell = 10,
			From = "Medbay, surface loot",
			SpentOn = "Healing players and residents",
		},
		Ammo = {
			Name = "Ammo",
			Kind = "Stock",
			Start = 200,
			Cap = 500,
			CapPerStorageCell = 250,
			From = "Armory, Workshop (from Scrap), surface loot",
			SpentOn = "Guns, for players and armed residents",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000090"><Properties><string name="Name">Rooms</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rooms: every room type (bible Section 6, rules in Tuning.Rooms).

	Output is per cell per cycle at level 1 with workers whose stats sum to 10 (the B in
	bible Section 13's formula); Power is what the room draws per cell at each level
	(Reactor Core and Generators give PowerOutput instead). Costs are per cell for each level:
	level 1 Scrap, level 2 adds Iron, level 3 adds Copper or Crystal plus Lab research.
	Every number here is provisional. Art: Asset .. "_L" .. level.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local Levels = function(item: Check.Checker): Check.Checker
	return Check.array(item, 3)
end

local function room(t: { [string]: any }): { [string]: any }
	t.MaxCells = t.MaxCells or 3
	return t
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Text = F.Text,
		WorkerStat = Check.optional(Check.ref("Stats")),
		TrainsChosenStat = F.Flag,
		Unlock = Check.shape({
			Kind = Check.enum({ "Start", "Draft", "DraftOrDepth", "Era", "CryoPod" }),
			Era = Check.optional(Check.integer(1, 4)),
			Depth = Check.optional(Check.integer(1, 10)),
		}),
		Unique = F.Flag,
		Fixed = F.Flag, -- can't be moved, merged further or torn down
		Floor = Check.optional(Check.integer(1, 9)), -- only on this floor
		MaxCells = Check.integer(1, 3),
		Output = Check.optional(Check.shape({
			Kind = Check.enum({ "Resource", "BandOre", "Research", "Morale", "Recruits", "Training", "Digging", "Crafting", "Thawing", "Decon" }),
			Resource = Check.optional(Check.ref("Resources")),
			Base = F.NonNegative,
		})),
		PowerOutput = Check.optional(Levels(F.Count)),
		Power = Levels(F.Count),
		Beds = Check.optional(Levels(F.Count)),
		Costs = Levels(F.Costs),
		Research = Check.optional(F.Count), -- Lab research needed for level 3
		Asset = F.Asset,
	}),
	Order = {
		"BlastDoor", "Shaft", "ReactorCore", "Generator", "Kitchen", "WaterPurifier", "Quarters", "Medbay",
		"Storage", "Workshop", "Armory", "RadioRoom", "Lounge", "Lab", "DrillBay", "Greenhouse",
		"TrainingRoom", "DeconRoom", "CryoBay", "TradingPost", "Memorial",
	},
	Entries = {
		BlastDoor = room({
			Name = "Blast Door",
			Text = "Entrance from the surface; holds off raids and storms. Guards stand watch here.",
			WorkerStat = "Grit",
			Unlock = { Kind = "Start" },
			Unique = true,
			Fixed = true,
			Floor = 1,
			MaxCells = 2,
			Power = { 1, 2, 3 },
			Costs = { {}, { Scrap = 300, Iron = 40 }, { Scrap = 600, Copper = 30 } },
			Research = 40,
			Asset = "Room_BlastDoor",
		}),
		Shaft = room({
			Name = "Shaft",
			Text = "Stairs, resident lift and drop chute between floors.",
			Unlock = { Kind = "Start" },
			MaxCells = 1,
			Power = { 0, 0, 0 },
			Costs = { { Scrap = 60 }, { Scrap = 120, Iron = 10 }, { Scrap = 240, Copper = 10 } },
			Research = 10,
			Asset = "Room_Shaft",
		}),
		ReactorCore = room({
			Name = "Reactor Core",
			Text = "Power. If it is destroyed the run is lost; it can't be moved or torn down.",
			WorkerStat = "Strength",
			Unlock = { Kind = "Start" },
			Unique = true,
			Fixed = true,
			MaxCells = 1,
			PowerOutput = { 24, 36, 48 },
			Power = { 0, 0, 0 },
			Costs = { {}, { Scrap = 400, Iron = 50 }, { Scrap = 800, Copper = 40 } },
			Research = 50,
			Asset = "Room_ReactorCore",
		}),
		Generator = room({
			Name = "Generator",
			Text = "Extra power.",
			WorkerStat = "Strength",
			Unlock = { Kind = "Start" },
			PowerOutput = { 10, 15, 20 },
			Power = { 0, 0, 0 },
			Costs = { { Scrap = 150 }, { Scrap = 250, Iron = 25 }, { Scrap = 450, Copper = 20 } },
			Research = 25,
			Asset = "Room_Generator",
		}),
		Kitchen = room({
			Name = "Kitchen",
			Text = "Food.",
			WorkerStat = "Speed",
			Unlock = { Kind = "Start" },
			Output = { Kind = "Resource", Resource = "Food", Base = 8 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 120 }, { Scrap = 220, Iron = 20 }, { Scrap = 400, Copper = 15 } },
			Research = 25,
			Asset = "Room_Kitchen",
		}),
		WaterPurifier = room({
			Name = "Water Purifier",
			Text = "Water.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "Start" },
			Output = { Kind = "Resource", Resource = "Water", Base = 8 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 120 }, { Scrap = 220, Iron = 20 }, { Scrap = 400, Copper = 15 } },
			Research = 25,
			Asset = "Room_WaterPurifier",
		}),
		Quarters = room({
			Name = "Quarters",
			Text = "Beds: residents rest here. A rest stop for players to skip the day.",
			Unlock = { Kind = "Start" },
			Beds = { 4, 6, 8 },
			Power = { 1, 1, 2 },
			Costs = { { Scrap = 100 }, { Scrap = 180, Iron = 15 }, { Scrap = 320, Copper = 10 } },
			Research = 20,
			Asset = "Room_Quarters",
		}),
		Medbay = room({
			Name = "Medbay",
			Text = "Medkits; player respawn point; revives residents.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "Start" },
			Output = { Kind = "Resource", Resource = "Medkits", Base = 1 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 150 }, { Scrap = 260, Iron = 25 }, { Scrap = 450, Copper = 20 } },
			Research = 30,
			Asset = "Room_Medbay",
		}),
		Storage = room({
			Name = "Storage",
			Text = "Raises every stockpile cap.",
			Unlock = { Kind = "Start" },
			Power = { 0, 1, 1 },
			Costs = { { Scrap = 100 }, { Scrap = 180, Iron = 20 }, { Scrap = 320, Copper = 15 } },
			Research = 20,
			Asset = "Room_Storage",
		}),
		Workshop = room({
			Name = "Workshop",
			Text = "Crafting station for gear, ammo, turrets and tools.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "Start" },
			Output = { Kind = "Crafting", Base = 1 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 150 }, { Scrap = 260, Iron = 30 }, { Scrap = 450, Copper = 20 } },
			Research = 30,
			Asset = "Room_Workshop",
		}),
		Armory = room({
			Name = "Armory",
			Text = "Ammo; armed residents gather here during Surges.",
			WorkerStat = "Grit",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Resource", Resource = "Ammo", Base = 40 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 180 }, { Scrap = 300, Iron = 30 }, { Scrap = 500, Copper = 25 } },
			Research = 30,
			Asset = "Room_Armory",
		}),
		RadioRoom = room({
			Name = "Radio Room",
			Text = "Recruits survivors, places supply calls, hears distress calls; sends expeditions.",
			WorkerStat = "Charm",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Recruits", Base = 0.15 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 200 }, { Scrap = 320, Iron = 30 }, { Scrap = 550, Copper = 25 } },
			Research = 35,
			Asset = "Room_RadioRoom",
		}),
		Lounge = room({
			Name = "Lounge",
			Text = "Morale for the whole bunker.",
			WorkerStat = "Charm",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Morale", Base = 3 },
			Power = { 1, 2, 3 },
			Costs = { { Scrap = 180 }, { Scrap = 300, Iron = 25 }, { Scrap = 500, Copper = 20 } },
			Research = 30,
			Asset = "Room_Lounge",
		}),
		Lab = room({
			Name = "Lab",
			Text = "Research that unlocks level 3 upgrades and tech cards.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Research", Base = 10 },
			Power = { 3, 4, 5 },
			Costs = { { Scrap = 220 }, { Scrap = 360, Iron = 35 }, { Scrap = 600, Crystal = 20 } },
			Research = 40,
			Asset = "Room_Lab",
		}),
		DrillBay = room({
			Name = "Drill Bay",
			Text = "Digs queued cells slowly and mines ore from nearby rock.",
			WorkerStat = "Strength",
			Unlock = { Kind = "DraftOrDepth", Depth = 2 },
			Output = { Kind = "BandOre", Base = 3 },
			Power = { 3, 4, 5 },
			Costs = { { Scrap = 220 }, { Scrap = 360, Iron = 40 }, { Scrap = 600, Copper = 30 } },
			Research = 40,
			Asset = "Room_DrillBay",
		}),
		Greenhouse = room({
			Name = "Greenhouse",
			Text = "Food plus morale.",
			WorkerStat = "Speed",
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Resource", Resource = "Food", Base = 6 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 180 }, { Scrap = 300, Iron = 25 }, { Scrap = 500, Copper = 20 } },
			Research = 30,
			Asset = "Room_Greenhouse",
		}),
		TrainingRoom = room({
			Name = "Training Room",
			Text = "Residents train one chosen stat.",
			TrainsChosenStat = true,
			Unlock = { Kind = "Draft" },
			Output = { Kind = "Training", Base = 1 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 200 }, { Scrap = 320, Iron = 30 }, { Scrap = 550, Copper = 25 } },
			Research = 35,
			Asset = "Room_TrainingRoom",
		}),
		DeconRoom = room({
			Name = "Decon Room",
			Text = "Clears radiation from players and residents; slows leaks.",
			WorkerStat = "Grit",
			Unlock = { Kind = "Era", Era = 2 },
			Output = { Kind = "Decon", Base = 10 },
			Power = { 2, 3, 4 },
			Costs = { { Scrap = 220 }, { Scrap = 360, Iron = 30 }, { Scrap = 600, Copper = 30 } },
			Research = 40,
			Asset = "Room_DeconRoom",
		}),
		CryoBay = room({
			Name = "Cryo Bay",
			Text = "Thaws cryo pods into Rare or Legendary residents.",
			WorkerStat = "Smarts",
			Unlock = { Kind = "CryoPod" },
			Output = { Kind = "Thawing", Base = 1 },
			Power = { 3, 4, 5 },
			Costs = { { Scrap = 250 }, { Scrap = 400, Iron = 40 }, { Scrap = 650, Crystal = 25 } },
			Research = 45,
			Asset = "Room_CryoBay",
		}),
		TradingPost = room({
			Name = "Trading Post",
			Text = "The trader visits more often and charges less.",
			WorkerStat = "Charm",
			Unlock = { Kind = "Draft" },
			Power = { 1, 2, 3 },
			Costs = { { Scrap = 200 }, { Scrap = 320, Iron = 25 }, { Scrap = 550, Copper = 20 } },
			Research = 30,
			Asset = "Room_TradingPost",
		}),
		Memorial = room({
			Name = "Memorial",
			Text = "Faster morale recovery after deaths; one per bunker. Names of the fallen.",
			Unlock = { Kind = "Draft" },
			Unique = true,
			MaxCells = 1,
			Power = { 0, 1, 1 },
			Costs = { { Scrap = 150 }, { Scrap = 250, Iron = 20 }, { Scrap = 400, Copper = 15 } },
			Research = 20,
			Asset = "Room_Memorial",
		}),
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000091"><Properties><string name="Name">Stats</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Stats: the five resident stats (bible Section 11). 1 to 10 on arrival; gear and training
	can push a stat to 15. Which rooms use a stat is on each room (Rooms.WorkerStat).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({ Name = F.Name, AlsoAffects = F.Text }),
	Order = { "Strength", "Smarts", "Grit", "Speed", "Charm" },
	Entries = {
		Strength = { Name = "Strength", AlsoAffects = "Melee damage, building speed, carrying on expeditions" },
		Smarts = { Name = "Smarts", AlsoAffects = "Repair speed, crafting" },
		Grit = { Name = "Grit", AlsoAffects = "Max health, resisting radiation and gas" },
		Speed = { Name = "Speed", AlsoAffects = "Moving, fleeing, expedition length" },
		Charm = { Name = "Charm", AlsoAffects = "Roommates' morale, recruiting, trade prices" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000092"><Properties><string name="Name">SurfaceLocations</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	SurfaceLocations: places to search in Brightwater Ruins, the launch region (bible Section
	12). The map is the lobby's town after the bomb. Containers refill every era.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Loot = Check.ref("LootTables"),
		Containers = F.PositiveInt,
		MinEra = Check.integer(1, 4),
		Text = F.Short,
	}),
	Order = { "Diner", "HardwareStore", "Grocery", "GasStation", "Motel", "RadioTower", "WaterTower", "RailYard", "Showroom", "Checkpoint" },
	Entries = {
		Diner = { Name = "Main Street diner", Loot = "Diner", Containers = 4, MinEra = 1, Text = "Soda fountain, booths, a kitchen out back." },
		HardwareStore = { Name = "Hardware store", Loot = "HardwareStore", Containers = 5, MinEra = 1, Text = "Tools, lamps and spare parts." },
		Grocery = { Name = "Grocery", Loot = "Grocery", Containers = 5, MinEra = 1, Text = "Canned food and bottled water." },
		GasStation = { Name = "Gas station", Loot = "GasStation", Containers = 3, MinEra = 1, Text = "Scrap and flares." },
		Motel = { Name = "Motel", Loot = "Motel", Containers = 6, MinEra = 1, Text = "Rooms to search; sometimes a survivor." },
		RadioTower = { Name = "Radio tower", Loot = "RadioTower", Containers = 3, MinEra = 1, Text = "Radio logs and a view of the town." },
		WaterTower = { Name = "Water tower", Loot = "WaterTower", Containers = 2, MinEra = 1, Text = "Water, if you can reach it." },
		RailYard = { Name = "Rail yard", Loot = "RailYard", Containers = 6, MinEra = 1, Text = "A wrecked train full of salvage." },
		Showroom = { Name = "Steadfast showroom", Loot = "Showroom", Containers = 4, MinEra = 1, Text = "The ruined showroom: blueprints and the company's secrets." },
		Checkpoint = { Name = "Military checkpoint", Loot = "Checkpoint", Containers = 5, MinEra = 3, Text = "Opens in Era III: ammo and military gear." },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000093"><Properties><string name="Name">TalentSlots</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TalentSlots: a slot adds the passive of another owned class to the current one (bible
	Section 14). Talents are passives only (Classes.Talentable, Classes.TalentExclude).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Slot = Check.integer(1, 3),
		AccountLevel = Check.optional(F.PositiveInt),
		Glowshards = F.Glowshards,
		Pass = Check.optional(Check.ref("GamePasses")),
		Text = F.Short,
	}),
	Order = { "Slot1", "Slot2", "Slot3" },
	Entries = {
		Slot1 = { Slot = 1, AccountLevel = 5, Text = "Unlocks at account level 5" },
		Slot2 = { Slot = 2, Glowshards = 150, Pass = "ExtraTalentSlot", Text = "150 Glowshards or the Extra Talent Slot pass" },
		Slot3 = { Slot = 3, Glowshards = 300, Text = "300 Glowshards" },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000094"><Properties><string name="Name">TeamBoosts</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	TeamBoosts: developer products bought during a run (bible Section 17). Every one helps the
	whole team and is announced with the buyer's name. Never a way around the team vote.
	ProductId is set in Prompt 28; prices provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Robux = F.PositiveInt,
		Text = F.Text,
		Banner = F.Short, -- "{player} called a Supply Drop!"
		Loot = Check.optional(Check.ref("LootTables")),
		ProductId = Check.optional(F.PositiveInt),
	}),
	Order = { "Revive", "RushConstruction", "BlueprintReroll", "StormShield", "SupplyDrop", "InstantRecruit", "EmergencyRepair" },
	Entries = {
		Revive = { Name = "Revive", Robux = 49, Text = "Brings a downed player back at once, yourself or a teammate.", Banner = "{player} revived {target}!" },
		RushConstruction = { Name = "Rush Construction", Robux = 49, Text = "Finishes every build in progress.", Banner = "{player} rushed construction!" },
		BlueprintReroll = { Name = "Blueprint Reroll", Robux = 49, Text = "Redraws the three draft cards.", Banner = "{player} rerolled the blueprints!" },
		StormShield = { Name = "Storm Shield", Robux = 79, Text = "Calms the surface storm during the next Surge.", Banner = "{player} raised a Storm Shield!" },
		SupplyDrop = {
			Name = "Supply Drop",
			Robux = 99,
			Text = "A crate of Food, Water, Ammo and Medkits at the Blast Door.",
			Banner = "{player} called a Supply Drop!",
			Loot = "SupplyDrop",
		},
		InstantRecruit = { Name = "Instant Recruit", Robux = 99, Text = "A Rare resident arrives now.", Banner = "{player} brought in a recruit!" },
		EmergencyRepair = {
			Name = "Emergency Repair",
			Robux = 149,
			Text = "Repairs every room and ends every fire and flood.",
			Banner = "{player} called an Emergency Repair!",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000095"><Properties><string name="Name">Tiers</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Tiers: the rarity tiers of classes, residents, Legends and cosmetics (bible Sections 11,
	14, 15, 19). The colours are UI enamels (STYLE.md), never model swatches. Rarity shows in
	the look (Section 19): the Look line says how far a character's design goes.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		Rank = Check.integer(0, 4),
		Color = Check.optional(F.Hex),
		Look = F.Text,
	}),
	Order = { "Free", "Common", "Rare", "Epic", "Legendary" },
	Entries = {
		Free = { Name = "Free", Rank = 0, Color = "#8E8C88", Look = "The Survivor: whatever they ran in with." },
		Common = { Name = "Common", Rank = 1, Color = "#8E8C88", Look = "A clean work outfit." },
		Rare = {
			Name = "Rare",
			Rank = 2,
			Color = "#3F79B5",
			Look = "Its own outfit, one signature piece (a hat, tool or pack) and an accent colour.",
		},
		Epic = {
			Name = "Epic",
			Rank = 3,
			Color = "#7D4C9E",
			Look = "A new silhouette (a coat, armour or harness), two or more signature pieces, brass or chrome detailing and a small effect.",
		},
		Legendary = {
			Name = "Legendary",
			Rank = 4,
			Color = "#D9A93A",
			Look = "One of a kind: a silhouette nothing else has, a hand-made head or hair, glowing or moving parts and its own idle.",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000096"><Properties><string name="Name">Traits</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Traits: two per resident (bible Section 11 and the Appendix). Commons roll one good and one
	bad; Rares two good, or one good with higher stats; Legendaries a signature trait plus one
	good. Amounts the bible leaves open are provisional (Notes).
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local function mod(key: string, value: number, extra: { [string]: any }?): { [string]: any }
	local t: { [string]: any } = { Key = key, Value = value }
	if extra then
		for k, v in extra do
			t[k] = v
		end
	end
	return t
end

local function good(text: string, modifiers: { any }, notes: string?): { [string]: any }
	return { Type = "Good", Text = text, Modifiers = modifiers, Notes = notes }
end

local function bad(text: string, modifiers: { any }, notes: string?): { [string]: any }
	return { Type = "Bad", Text = text, Modifiers = modifiers, Notes = notes }
end

local entries = {
	Brave = good("Never panics; defends their room even without a weapon.", { mod("NeverPanics", 1), mod("DefendsUnarmed", 1) }),
	Tough = good("+25% max health.", { mod("MaxHealthMult", 1.25) }),
	FastLearner = good("+25% experience.", { mod("ResidentXP", 1.25) }),
	GreenThumb = good("+20% output in the Kitchen and Greenhouse.", {
		mod("RoomOutput", 1.2, { Room = "Kitchen", Scope = "Self" }),
		mod("RoomOutput", 1.2, { Room = "Greenhouse", Scope = "Self" }),
	}),
	Tinkerer = good("+20% Workshop speed; slowly repairs their room.", { mod("CraftSpeed", 1.2), mod("RepairsRooms", 1, { Scope = "Room" }) }),
	SteadyHands = good("+20% output in the Medbay and Lab.", {
		mod("RoomOutput", 1.2, { Room = "Medbay", Scope = "Self" }),
		mod("RoomOutput", 1.2, { Room = "Lab", Scope = "Self" }),
	}),
	StrongBack = good("+20% output in the Reactor Core, Generators and Drill Bay; carries more on expeditions.", {
		mod("RoomOutput", 1.2, { Room = "ReactorCore", Scope = "Self" }),
		mod("RoomOutput", 1.2, { Room = "Generator", Scope = "Self" }),
		mod("RoomOutput", 1.2, { Room = "DrillBay", Scope = "Self" }),
		mod("ExpeditionCarry", 1.25),
	}, "Expedition carry x1.25 is provisional"),
	Firefighter = good("Puts out fires 3x faster; fire spreads slower from their room.", {
		mod("ExtinguishSpeed", 3),
		mod("FireSpread", 0.5, { Scope = "Room" }),
	}, "Spread x0.5 from their room is provisional"),
	Lucky = good("Chance of double output each cycle; better expedition loot.", {
		mod("DoubleOutputChance", 0.1),
		mod("ExpeditionLoot", 1.25),
	}, "10% double output and x1.25 loot are provisional"),
	Chatterbox = good("Raises roommates' morale.", { mod("RoommateMorale", 3) }, "+3 a cycle is provisional"),
	NaturalLeader = good("+10% output for everyone in their room.", { mod("AllOutput", 1.1, { Scope = "Room" }) }),
	Hardy = good("Resists radiation and gas.", { mod("RadiationGain", 0.5), mod("GasDamageTaken", 0.5) }, "Halved is provisional"),
	NightVision = good("No penalty in dark rooms.", { mod("NoDarkPenalty", 1) }),
	IronStomach = good("Eats half as much.", { mod("FoodUse", 0.5) }),
	Scrounger = good("Extra Scrap from expeditions and a small Scrap find each cycle.", {
		mod("ExpeditionScrap", 1.5),
		mod("ScrapPerCycle", 5),
	}, "x1.5 and +5 a cycle are provisional"),
	Sharpshooter = good("+30% gun damage.", { mod("GunDamage", 1.3) }),
	CoolHead = good("Never panics and calms panicked roommates.", { mod("NeverPanics", 1), mod("CalmsRoommates", 1) }),
	HardWorker = good("+10% output in any job.", { mod("AllOutput", 1.1) }),
	Coward = bad("Panics easily and flees breaches.", { mod("PanicChance", 2), mod("FleesBreaches", 1) }, "Panic x2 is provisional"),
	Clumsy = bad("Small chance each cycle of a minor fire or flood in their room.", { mod("AccidentChance", 0.04) }, "4% is provisional"),
	Glutton = bad("Eats twice as much.", { mod("FoodUse", 2) }),
	Lazy = bad("-15% output.", { mod("AllOutput", 0.85) }),
	Grumpy = bad("Lowers roommates' morale.", { mod("RoommateMorale", -3) }, "-3 a cycle is provisional"),
	Jumpy = bad("Panics at the first sign of danger and may run into hazards.", { mod("PanicChance", 3), mod("RunsIntoHazards", 1) }, "Panic x3 is provisional"),
	Sleepyhead = bad("Needs 50% more rest.", { mod("RestNeed", 1.5) }),
	Frail = bad("-25% max health.", { mod("MaxHealthMult", 0.75) }),
	Claustrophobic = bad("Morale drops at depth 4 and below.", { mod("Claustrophobic", 1) }),
	AfraidOfTheDark = bad("Morale crashes in dark rooms and refuses to work there.", { mod("AfraidOfDark", 1) }),
	Hothead = bad("Starts fights with rivals.", { mod("Hothead", 1) }),
	Homesick = bad("Morale slowly drains unless they spend time in the Lounge.", { mod("Homesick", 1) }),
}

local names = {
	Brave = "Brave", Tough = "Tough", FastLearner = "Fast Learner", GreenThumb = "Green Thumb", Tinkerer = "Tinkerer",
	SteadyHands = "Steady Hands", StrongBack = "Strong Back", Firefighter = "Firefighter", Lucky = "Lucky",
	Chatterbox = "Chatterbox", NaturalLeader = "Natural Leader", Hardy = "Hardy", NightVision = "Night Vision",
	IronStomach = "Iron Stomach", Scrounger = "Scrounger", Sharpshooter = "Sharpshooter", CoolHead = "Cool Head",
	HardWorker = "Hard Worker", Coward = "Coward", Clumsy = "Clumsy", Glutton = "Glutton", Lazy = "Lazy",
	Grumpy = "Grumpy", Jumpy = "Jumpy", Sleepyhead = "Sleepyhead", Frail = "Frail", Claustrophobic = "Claustrophobic",
	AfraidOfTheDark = "Afraid of the Dark", Hothead = "Hothead", Homesick = "Homesick",
}
for id, entry in entries do
	entry.Name = names[id]
end

return {
	Schema = Check.shape({
		Name = F.Name,
		Type = Check.enum({ "Good", "Bad" }),
		Text = F.Text,
		Modifiers = F.Modifiers,
		Notes = Check.optional(F.Short),
	}),
	Order = {
		"Brave", "Tough", "FastLearner", "GreenThumb", "Tinkerer", "SteadyHands", "StrongBack", "Firefighter",
		"Lucky", "Chatterbox", "NaturalLeader", "Hardy", "NightVision", "IronStomach", "Scrounger", "Sharpshooter",
		"CoolHead", "HardWorker", "Coward", "Clumsy", "Glutton", "Lazy", "Grumpy", "Jumpy", "Sleepyhead", "Frail",
		"Claustrophobic", "AfraidOfTheDark", "Hothead", "Homesick",
	},
	Entries = entries,
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000097"><Properties><string name="Name">Tuning</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Tuning: the rule numbers of every system, one entry per system, each with its own schema
	(Config.Schemas). Values come from the bible where it gives them (section noted); the rest
	are provisional starting points for playtests, marked "prov." in comments.

		local Clock = Config.Get("Tuning", "Clock")
		Clock.DaySeconds -- 180
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

local N, I, S, Fr = F.NonNegative, F.Count, F.Seconds, F.Fraction
local function list(item: Check.Checker, max: number): Check.Checker
	return Check.array(item, max)
end
local function shape(fields: { [string]: Check.Checker }): Check.Checker
	return Check.shape(fields)
end

local Cell = Check.shape({
	Floor = Check.integer(1, 10),
	Column = Check.integer(-6, 6),
	Room = Check.optional(Check.ref("Rooms")),
	Span = Check.optional(Check.integer(1, 3)),
	Dug = F.Flag,
})

local Schemas: { [string]: Check.Checker } = {
	Clock = shape({
		CycleSeconds = S, DaySeconds = S, SurgeSeconds = S,
		YearsPerCycleStart = I, YearsPerCycleMax = I, -- the bonuses are Config.Objectives' YearsPerCycle
		FinalYear = I, IntroSeconds = S, IntroSkipAfterSeconds = S,
		SurgeSirenSeconds = S, TutorialFirstSurge = Check.boolean(),
	}),
	Grid = shape({
		ColumnMin = Check.integer(-20, 0), ColumnMax = Check.integer(0, 20), FloorMin = I, FloorMax = I,
		CellWidth = N, CellHeight = N, CellDepth = N, SlabThickness = N, WallThickness = N, SourceFloor = I,
		Origin = shape({ X = F.Number, Y = F.Number, Z = F.Number }),
	}),
	StartingBunker = shape({
		Cells = list(Cell, 20),
		Residents = I,
		ResidentLevels = F.Range,
		ResidentTier = Check.ref("Tiers"),
	}),
	Rooms = shape({
		WorkerSlotsPerCell = list(I, 3), HP = list(I, 3), LevelMultiplier = list(N, 3), MergeMultiplier = list(N, 3),
		BuildSecondsPerCell = S, HelperBuildSpeed = N, ResidentRepairPerSecond = N,
		DarkSpawnMultiplier = N, DarkMoralePerCycle = F.Number, TearDownRefund = Fr, PowerWarnAt = Fr,
	}),
	Votes = shape({
		TiesFail = Check.boolean(), BigSpendFraction = Fr, OpenProposalsPerPlayer = I, FailedCooldownSeconds = S,
		PassEarlyWhenAllYes = Check.boolean(), SoloSkipsVotes = Check.boolean(), RecheckCostsOnPass = Check.boolean(),
		ResultSeconds = S,
	}),
	Player = shape({
		Health = I, Stamina = I, SprintStaminaPerSecond = N, DodgeStamina = N, HeavySwingStamina = N,
		StaminaRegenPerSecond = N, RadiationMax = I, RadiationHealthDrainPerSecond = N,
		Loadout = shape({ Guns = I, Melee = I, Tool = I, Throwables = I, Medkits = I }),
		BackpackSlots = I, AimFieldOfView = list(N, 2), DownedSeconds = S, ReviveSeconds = S,
		RespawnSeconds = S, AimAssistDegrees = N, MedkitHeal = N, MedkitSeconds = S, HealWalkMultiplier = Fr,
	}),
	Combat = shape({
		LagSeconds = S, HistorySeconds = S, HistoryHz = N, HitTolerance = N, RayTolerance = N,
		OriginTolerance = N, RateTolerance = Fr,
		SprintMultiplier = N, StaminaRegenDelay = S,
		DodgeSeconds = S, DodgeInvulnerableSeconds = S, DodgeDistance = N, DodgeCooldownSeconds = S,
		MeleeReach = N, MeleeArcDegrees = N, MeleeReachTolerance = N, MeleeWindupFraction = Fr,
		ComboWindowSeconds = S, ComboSteps = I, HeavyChargeSeconds = S, HeavySwingMultiplier = N,
		CrawlSpeed = N, ReviveHealthFraction = Fr,
		CarriedAmmo = shape({ Start = I, Max = I }), RestockSeconds = S,
		ProjectileSpeed = N, ProjectileGravity = N, AssistPullPerSecond = N,
		Unarmed = shape({ Damage = N, HeavyDamage = N, SwingSeconds = S }),
		ThrowSpeed = N, ThrowGravity = N, ThrowCooldownSeconds = S, ThrowableStack = I, MineArmSeconds = S,
		MineLifetimeSeconds = S, TapHoldSeconds = S,
	}),
	Camera = shape({
		FieldOfView = N, PivotHeight = N, ShoulderOffset = N, ShoulderRaise = F.Number,
		Distance = shape({ Min = N, Max = N, Default = N }), IndoorMax = N, AimDistance = N, AimShoulder = N,
		PitchMin = F.Number, PitchMax = F.Number, StartPitch = F.Number,
		MouseDegreesPerPixel = N, TouchDegreesPerPixel = N, GamepadDegreesPerSecond = N, StickDeadzone = Fr,
		AimSensitivity = Fr, AimWalkSpeed = Fr, ZoomStep = N, PinchStudsPerPixel = N,
		CollisionRadius = N, WallMargin = N, FloorMargin = N, CeilingMargin = N, NearestDistance = N,
		EaseOutPerSecond = N, PivotFollowPerSecond = N, ShoulderSwapSeconds = S, AimBlendSeconds = S,
		FadeTransparency = Fr, FrontWallTransparency = Fr, FadeSeconds = S, NearFadeRadius = N,
		CharacterFadeDistance = N, ErrorsBeforeFallback = I,
	}),
	CommandView = shape({
		FieldOfView = N, MaxDistance = N, StartFloors = N, MinFloors = N, MaxFloors = N, MoveSeconds = S, ZoomStep = Fr,
		PanFloorsPerSecond = N, DragPixels = N, StickDeadzone = Fr,
		Ambient = F.Hex, OutdoorAmbient = F.Hex, ExposureCompensation = F.Number,
	}),
	Ping = shape({ Seconds = S }),
	Digging = shape({
		DisturbancePerCell = N, StackPlayers = Check.boolean(), PushDeeperFloors = list(I, 3),
		ResidentDigMultiplier = N,
		-- Prompt 14
		Tools = list(Check.ref("Items"), 4), PromptReach = N, TickSeconds = S, CaveInChance = Fr,
		NestHealth = N, NestBudget = N, NestPerCycle = N, CacheOpenSeconds = S, VoteRetrySeconds = S,
	}),
	Disturbance = shape({
		Max = N, DecayPerCycle = N, NestDestroyed = N, Explosive = N, ExtraBreachAt = N, TremorAt = N, AfterTremor = N,
	}),
	-- Prompt 15: boss fights in general, the Brood Mother's, and the results screen
	Bosses = shape({
		ArrivalWarningSeconds = S, RiseSeconds = S, FirstRunHealth = Fr, ArmourMultiplier = Fr, WeakPointMultiplier = N,
		WeakPointTolerance = N, PublishSeconds = S, DeathSeconds = S, TickSeconds = S,
	}),
	BroodMother = shape({
		MoveSpeed = list(N, 4), AttackSeconds = list(S, 4), SlamDamage = N, SlamRadius = N, SlamReach = N,
		LaySeconds = list(S, 4), SacsPerLay = list(I, 4), MaxSacs = I, SacHealth = N, HatchSeconds = S, HatchCount = I,
		BurnMultiplier = N, StaggerFraction = Fr, StaggerWindowSeconds = S, StaggerSeconds = S, RoarSeconds = S,
		ArenaMargin = N, TurnDegreesPerSecond = N,
	}),
	Results = shape({
		OpenDelaySeconds = S, StoriesMax = I,
		MVP = shape({ Damage = N, Kills = N, Revives = N, CellsDug = N, Repairs = N, BossDamage = N }),
	}),
	Threat = shape({
		Base = N, PerYear = N, PerDeepestFloor = N, PerDisturbance = N, PerRoom = N,
		PlayerScale = list(N, 6), BetweenSurgesFraction = N, BreachWarningSeconds = S,
		TutorialSurgeBudget = N, FirstRunEraIMultiplier = N,
		MaxMonsters = I, WaveSpacingSeconds = S, SpawnSpacingSeconds = S, TrickleCheckSeconds = S, DarkRoomWeight = N,
		BarricadeWeight = Fr, MaxBreachPointsPerSurge = I,
	}),
	Disasters = shape({
		TickSeconds = S, SurgeDelaySeconds = S, FuseSeconds = S, ValveSeconds = S,
		Fire = shape({
			StartStrength = N, GrowPerSecond = N, SpreadMinStrength = N,
			ResidentPerSecond = N, ExtinguisherPerSecond = N, ExtinguisherReach = N,
			PlayerDamagePerSecond = N, ResidentDamagePerSecond = N, ResidentFleeHealth = Fr,
			Fireproof = list(Check.ref("Rooms"), 21),
		}),
		Blackout = shape({ WholeGridChance = Fr }),
		CaveIn = shape({
			DoorwayHP = N, TunnelHP = N, BreakerMultiplier = N, DigSeconds = S, TunnelDigSeconds = S, Damage = N,
			DigItems = list(Check.ref("Items"), 4),
		}),
		Meltdown = shape({ SoloPlayers = I, SoloValveSeconds = S, HeldGraceSeconds = S, StartsFire = Check.boolean() }),
		ElectricalSurge = shape({ EraChance = list(Fr, 4), FireChance = Fr, BlackoutChance = Fr }),
	}),
	Repairs = shape({ RepairedAt = Fr, WelderPerSecond = N, WelderReach = N, ResidentSmartsBase = N, ToolTickSeconds = S }),
	MonsterAI = shape({
		TickSeconds = S, AggroSeconds = S, ProximityAggro = N, SmashMultiplier = N, StuckSeconds = S, KeepDistanceFraction = Fr,
		RoomDamageMultiplier = N, LatchDamageMultiplier = N, LatchIntervalMultiplier = N,
		GooSpeed = N, GooSlowSeconds = S, GooSlowMultiplier = Fr, WindupFraction = Fr,
		ResidentFleeRadius = N, ResidentCalmSeconds = S, ResidentSwatDamage = N, ResidentSwatSeconds = S,
	}),
	Residents = shape({
		StatMin = I, StatMax = I, StatCap = I, LevelMax = I, MoraleStart = N, FoodPerCycle = N, WaterPerCycle = N,
		ShortfallHealth = N, ShortfallMorale = N, RestDrainPerShift = N, RestRefillPerCycle = N,
		NoBedRestMultiplier = N, FriendsMax = I, FriendThreshold = N, GrievingMorale = N, GrievingCycles = I,
		SurgeSurvivedMorale = N, DeathReviveSeconds = S, XPPerWorkCycle = N, XPPerKill = N,
		XPPerExpeditionCycle = N, XPToLevelBase = N, XPToLevelStep = N,
		RareStatBonus = I, HealthBase = N, HealthPerGrit = N, MedbayHealPerCycle = N,
		AutoAssignOrder = list(Check.ref("Rooms"), 21), MealSeconds = S, WalkSpeedBase = N, WalkSpeedPerSpeed = N,
	}),
	Aging = shape({
		StartAge = F.Range, YoungUntil = I, YoungXP = N, VeteranFrom = I, VeteranSpeed = N,
		ElderFrom = I, ElderKeptOutput = N, DeathAge = F.Range,
	}),
	Morale = shape({
		JobFit = F.Number, PoorFit = F.Number, FriendInRoom = F.Number, FedCycle = F.Number, Hungry = F.Number,
		DarkRoom = F.Number, NoBed = F.Number, Injured = F.Number,
	}),
	Trader = shape({
		EveryCycles = I, EveryCyclesWithPost = I, PostDiscount = N,
		Buys = Check.map(Check.ref("Resources"), N, 9),
	}),
	Wanderers = shape({ EveryCycles = F.Range, InspectCharm = I }),
	Expeditions = shape({
		Size = F.Range, Cycles = F.Range, DistressChance = Fr, BaseLossChance = Fr,
		SurfaceLoot = Check.ref("LootTables"), DeepLoot = Check.ref("LootTables"),
	}),
	Surface = shape({
		StormSirenSeconds = S, RadiationPerSecond = N, StormRadiationPerSecond = N, RefillEvery = Check.enum({ "Era" }),
	}),
	Legends = shape({ StartLevel = I, RenownMax = I, RenownStatBonus = I, StarterLegend = Check.ref("Legends") }),
	ClassShop = shape({
		Slots = I, ResetHourUTC = I, FreeRerolls = I, VIPFreeRerolls = I, RerollRobux = I, WishlistDays = I,
		FreeTrialRunsPerDay = I, ClassLevelRuns = list(I, 2),
	}),
	Account = shape({ LevelMax = I, XPPerYear = N, XPToLevelBase = N, XPToLevelStep = N, VIPGlowshardBonus = N }),
	Lobby = shape({ PadCountdownSeconds = S, PartyMax = I }),
}

return {
	Schemas = Schemas,
	Entries = {
		Clock = { -- Section 5
			CycleSeconds = 270, DaySeconds = 180, SurgeSeconds = 90,
			YearsPerCycleStart = 1, YearsPerCycleMax = 12, -- +2 per Lost Crew, +1 per era boss: Config.Objectives
			FinalYear = 100, IntroSeconds = 30, IntroSkipAfterSeconds = 2, -- era ends: Config.Eras
			SurgeSirenSeconds = 20, TutorialFirstSurge = true,
		},
		Grid = { -- Section 6; walls (the A0 kit's) and where the grid sits in the Run place are ours
			ColumnMin = -6, ColumnMax = 6, FloorMin = 1, FloorMax = 10,
			CellWidth = 32, CellHeight = 16, CellDepth = 32, SlabThickness = 2, WallThickness = 1, SourceFloor = 10,
			Origin = { X = 0, Y = -120, Z = 0 }, -- the interior floor centre of floor 1, column 0
		},
		StartingBunker = { -- Section 6 and its diagram: the shafts in the middle column (0), rock at -3
			Cells = {
				{ Floor = 1, Column = -2, Room = "BlastDoor", Span = 2 },
				{ Floor = 1, Column = 0, Room = "Shaft" },
				{ Floor = 1, Column = 1, Room = "Quarters", Span = 2 },
				{ Floor = 1, Column = 3, Dug = true },
				{ Floor = 2, Column = -2, Room = "Kitchen" },
				{ Floor = 2, Column = -1, Room = "WaterPurifier" },
				{ Floor = 2, Column = 0, Room = "Shaft" },
				{ Floor = 2, Column = 1, Room = "ReactorCore" },
				{ Floor = 2, Column = 2, Room = "Medbay" },
				{ Floor = 2, Column = 3, Dug = true },
			},
			Residents = 6,
			ResidentLevels = { Min = 1, Max = 3 },
			ResidentTier = "Common",
		},
		Rooms = { -- Section 6; build helpers, repair and dark-room morale prov.
			WorkerSlotsPerCell = { 2, 3, 4 }, HP = { 500, 800, 1200 }, LevelMultiplier = { 1, 1.5, 2 },
			MergeMultiplier = { 1, 1.1, 1.2 }, BuildSecondsPerCell = 20, HelperBuildSpeed = 0.25,
			ResidentRepairPerSecond = 2, DarkSpawnMultiplier = 2, DarkMoralePerCycle = -5,
			-- Landon, 2026-11-08: tearing a room down gives part of its cost back (half, prov.)
			TearDownRefund = 0.5,
			PowerWarnAt = 0.85, -- prov.: the HUD's power lamp turns amber past this share of the power made
		},
		Votes = { -- Section 8
			TiesFail = true, BigSpendFraction = 0.4, OpenProposalsPerPlayer = 1, FailedCooldownSeconds = 20,
			PassEarlyWhenAllYes = true, SoloSkipsVotes = true, RecheckCostsOnPass = true,
			ResultSeconds = 3, -- prov.: how long the banner shows PASSED or FAILED
		},
		Player = { -- Section 9; stamina costs, radiation drain, aim assist and Medkit heal prov.
			Health = 100, Stamina = 100, SprintStaminaPerSecond = 12, DodgeStamina = 20, HeavySwingStamina = 20,
			StaminaRegenPerSecond = 18, RadiationMax = 100, RadiationHealthDrainPerSecond = 2,
			Loadout = { Guns = 2, Melee = 1, Tool = 1, Throwables = 2, Medkits = 3 },
			BackpackSlots = 10, AimFieldOfView = { 70, 50 }, DownedSeconds = 20, ReviveSeconds = 3,
			RespawnSeconds = 15, AimAssistDegrees = 6, MedkitHeal = 60,
			MedkitSeconds = 1.5, HealWalkMultiplier = 0.6, -- Landon, 2026-11-08: the Heal button uses one Medkit over 1.5 s
		},
		Combat = { -- Section 23 (the server checks shots against where targets were over the last 250 ms); the rest prov.
			LagSeconds = 0.25, HistorySeconds = 1, HistoryHz = 20, HitTolerance = 2.5, RayTolerance = 1.5,
			OriginTolerance = 8, RateTolerance = 0.15,
			SprintMultiplier = 1.45, StaminaRegenDelay = 0.8,
			DodgeSeconds = 0.45, DodgeInvulnerableSeconds = 0.35, DodgeDistance = 14, DodgeCooldownSeconds = 0.6,
			MeleeReach = 6, MeleeArcDegrees = 110, MeleeReachTolerance = 2, MeleeWindupFraction = 0.4,
			ComboWindowSeconds = 0.6, ComboSteps = 3, HeavyChargeSeconds = 0.35, HeavySwingMultiplier = 1.6,
			CrawlSpeed = 3, ReviveHealthFraction = 0.3,
			CarriedAmmo = { Start = 60, Max = 150 }, RestockSeconds = 1.5,
			ProjectileSpeed = 90, ProjectileGravity = 30, AssistPullPerSecond = 4,
			Unarmed = { Damage = 8, HeavyDamage = 14, SwingSeconds = 0.4 }, -- a fallback: every kit has a melee weapon (Landon, 2026-11-08)
			-- Landon, 2026-11-08: a throwable is thrown with Fire while its slot is held; the gamepad's
			-- D-pad up pings on a tap and heals on a hold (TapHoldSeconds). Numbers provisional.
			ThrowSpeed = 55, ThrowGravity = 60, ThrowCooldownSeconds = 0.8, ThrowableStack = 3, MineArmSeconds = 0.8,
			MineLifetimeSeconds = 120, TapHoldSeconds = 0.35,
		},
		Camera = { -- Section 9 (right shoulder, aim narrows Player.AimFieldOfView, wall fade, zoom capped indoors); numbers prov.
			FieldOfView = 70, PivotHeight = 1.6, ShoulderOffset = 2.2, ShoulderRaise = 0.3,
			Distance = { Min = 4, Max = 16, Default = 9 }, IndoorMax = 11, AimDistance = 6, AimShoulder = 1.25,
			PitchMin = -70, PitchMax = 60, StartPitch = -12,
			MouseDegreesPerPixel = 0.22, TouchDegreesPerPixel = 0.3, GamepadDegreesPerSecond = 220, StickDeadzone = 0.15,
			AimSensitivity = 0.6, AimWalkSpeed = 0.6, ZoomStep = 1.5, PinchStudsPerPixel = 0.04,
			CollisionRadius = 0.6, WallMargin = 0.25, FloorMargin = 1.2, CeilingMargin = 1.9, NearestDistance = 0.8,
			EaseOutPerSecond = 6, PivotFollowPerSecond = 18, ShoulderSwapSeconds = 0.18, AimBlendSeconds = 0.15,
			FadeTransparency = 0.8, FrontWallTransparency = 1, FadeSeconds = 0.12, NearFadeRadius = 1.4,
			CharacterFadeDistance = 2.2, ErrorsBeforeFallback = 5,
		},
		CommandView = { -- Section 7 (a far camera with a narrow field of view, a 0.3 s move in and out); the rest prov.
			-- MaxDistance: at the lowest graphics level Roblox stops drawing parts about 500 studs from
			-- the camera (measured in Studio, 2026-11-08), so the camera never backs off further; past
			-- it the field of view widens instead (Rules.CommandView.Lens).
			FieldOfView = 8, MaxDistance = 440, StartFloors = 6, MinFloors = 1.5, MaxFloors = 11, MoveSeconds = 0.3, ZoomStep = 0.12,
			PanFloorsPerSecond = 2.5, DragPixels = 6, StickDeadzone = 0.2,
			Ambient = "#6E7680", OutdoorAmbient = "#8C949E", ExposureCompensation = 0.4,
		},
		Ping = { Seconds = 6 }, -- Section 7: a pinged cell shows on every player's mini-map; prov.
		Digging = { -- Section 6 (dig times are Config.DepthBands' DigSeconds), Section 10 (Disturbance)
			DisturbancePerCell = 5, StackPlayers = true, PushDeeperFloors = { 4, 7, 10 }, ResidentDigMultiplier = 0.25,
			-- Prompt 14, prov. A Drill or a Pickaxe digs; a dig prompt answers within PromptReach. A Drill
			-- Bay digs the queue at ResidentDigMultiplier of a player's speed for each unit of its crew's
			-- output (two average workers are one unit). A dug cell's passage caves in CaveInChance of the
			-- time (Section 10: digging causes cave-ins). A nest: NestHealth, NestBudget of a normal
			-- Surge's budget in monsters pouring out when it opens, NestPerCycle Disturbance each cycle it lives
			-- (Section 10: nests left alive raise it). A cache opens after CacheOpenSeconds of holding
			-- Interact. A failed Push Deeper vote can be asked again after VoteRetrySeconds.
			Tools = { "Drill", "Pickaxe" }, PromptReach = 8, TickSeconds = 0.25, CaveInChance = 0.05,
			NestHealth = 600, NestBudget = 0.35, NestPerCycle = 10, CacheOpenSeconds = 1, VoteRetrySeconds = 30,
		},
		Disturbance = { -- Section 10
			Max = 100, DecayPerCycle = 10, NestDestroyed = 20, Explosive = 10, ExtraBreachAt = 50, TremorAt = 100, AfterTremor = 40,
		},
		Bosses = { -- Prompt 15, prov. (Section 10's boss table; Section 22: the first run's Brood Mother is weaker)
			-- A boss Surge's boss breaks in ArrivalWarningSeconds after the Surge starts (cracks, dust, an
			-- alert) and rises out of the floor over RiseSeconds. Its health is Config.Bosses' Health times
			-- Threat.PlayerScale for the team, times FirstRunHealth on an account's first run. Hits on its
			-- armour do ArmourMultiplier; hits within WeakPointTolerance of a WeakPoint part do
			-- WeakPointMultiplier (the Sharpshooter's WeakPointMultiplier replaces it). Its bar updates
			-- every PublishSeconds; dead, it collapses for DeathSeconds before it dissolves.
			ArrivalWarningSeconds = 8, RiseSeconds = 2, FirstRunHealth = 0.7, ArmourMultiplier = 0.5, WeakPointMultiplier = 2,
			WeakPointTolerance = 1, PublishSeconds = 0.25, DeathSeconds = 4, TickSeconds = 0.1,
		},
		BroodMother = { -- Section 10: lays egg sacs that hatch Burrow Ticks; break or burn the sacs and hit her
			-- glowing belly. Prompt 15, prov. Lists are by phase (Config.Bosses' Phases: 2, the second
			-- from half health). She slams whoever is within SlamReach of her front (SlamDamage within
			-- SlamRadius of the blow), every AttackSeconds; every LaySeconds she lays SacsPerLay egg sacs
			-- behind her (MaxSacs at once). A sac has SacHealth (fire does BurnMultiplier) and hatches
			-- HatchCount Burrow Ticks after HatchSeconds. StaggerFraction of her health dealt to her belly
			-- within StaggerWindowSeconds staggers her for StaggerSeconds. She roars RoarSeconds as she
			-- arrives and as her second phase starts. She stays ArenaMargin from her arena's ends.
			MoveSpeed = { 5, 7 }, AttackSeconds = { 3.2, 2.4 }, SlamDamage = 30, SlamRadius = 9, SlamReach = 14,
			LaySeconds = { 16, 10 }, SacsPerLay = { 1, 2 }, MaxSacs = 6, SacHealth = 90, HatchSeconds = 14, HatchCount = 3,
			BurnMultiplier = 2, StaggerFraction = 0.05, StaggerWindowSeconds = 3, StaggerSeconds = 2.5, RoarSeconds = 2.5,
			ArenaMargin = 10, TurnDegreesPerSecond = 120,
		},
		Results = { -- Prompt 15, prov. (Section 18: Results; Section 16's payouts are Config.GlowshardRewards)
			-- The screen opens OpenDelaySeconds after the run ends; StoriesMax lines of the run's story.
			-- MVP: a player's score adds each stat times its weight.
			OpenDelaySeconds = 4, StoriesMax = 8,
			MVP = { Damage = 0.1, Kills = 10, Revives = 25, CellsDug = 15, Repairs = 0.05, BossDamage = 0.1 },
		},
		Threat = { -- Section 10 lists the inputs; weights prov. First-run Era I is 30% easier (Section 22)
			Base = 12, PerYear = 1.2, PerDeepestFloor = 4, PerDisturbance = 0.25, PerRoom = 1,
			PlayerScale = { 1, 1.6, 2.1, 2.5, 2.8, 3 }, BetweenSurgesFraction = 0.1, BreachWarningSeconds = 10,
			TutorialSurgeBudget = 6, FirstRunEraIMultiplier = 0.7,
			-- Prompt 12: Section 23's cap of 25 monsters (the rest queue); a Surge's groups open
			-- WaveSpacingSeconds apart, each after its BreachWarningSeconds; dark rooms' vents are
			-- picked DarkRoomWeight times as often (Section 6: dark rooms spawn monsters twice as
			-- often); a barricaded point less often (Section 10). Spacing and counts provisional.
			MaxMonsters = 25, WaveSpacingSeconds = 14, SpawnSpacingSeconds = 0.45, TrickleCheckSeconds = 15,
			DarkRoomWeight = 2, BarricadeWeight = 0.25, MaxBreachPointsPerSurge = 3,
		},
		Disasters = { -- Prompt 13 (Section 10's disasters; each disaster's own numbers are in Config.Disasters); prov.
			-- The Surge's one disaster starts SurgeDelaySeconds into the Surge; a fuse box resets after
			-- FuseSeconds of holding Interact, a valve turns after ValveSeconds.
			TickSeconds = 0.25, SurgeDelaySeconds = 8, FuseSeconds = 2, ValveSeconds = 1,
			-- Fire (Section 10: spreads to the next room every 15 s, burning room HP and residents; put out
			-- by an Extinguisher, a Foam Grenade, or residents in the room). Strength runs 0 to 100: it
			-- starts at StartStrength and grows; residents in the room beat it down ResidentPerSecond each,
			-- an Extinguisher ExtinguisherPerSecond (the Firefighter 3x); at 0 it is out. A fire weaker
			-- than SpreadMinStrength doesn't spread. Damage scales with strength. Fires stay on their floor:
			-- the Shaft's bare steel doesn't burn. Residents fight it until their health falls below
			-- ResidentFleeHealth, then flee.
			Fire = {
				StartStrength = 40, GrowPerSecond = 1, SpreadMinStrength = 30,
				ResidentPerSecond = 2, ExtinguisherPerSecond = 14, ExtinguisherReach = 16,
				PlayerDamagePerSecond = 5, ResidentDamagePerSecond = 3, ResidentFleeHealth = 0.4,
				Fireproof = { "Shaft" },
			},
			Blackout = { WholeGridChance = 0.3 }, -- Section 10: a floor or the whole grid
			-- Cave-in (Section 10: rubble blocks a doorway or cell and can trap residents; dig or smash
			-- through it). Melee smashes it (BreaksRubble weapons, the Fire Axe and Sledgehammer, do
			-- BreakerMultiplier times their damage); a Drill or a Pickaxe digs through it in one hold.
			CaveIn = {
				DoorwayHP = 300, TunnelHP = 600, BreakerMultiplier = 3, DigSeconds = 5, TunnelDigSeconds = 8, Damage = 15,
				DigItems = { "Drill", "Pickaxe" },
			},
			-- The meltdown (Section 10's Reactor overload; Landon, 2026-11-08): the three valves turned
			-- together stop it. With SoloPlayers or fewer each turned valve stays turned SoloValveSeconds;
			-- with more, a valve counts while its player holds it (HeldGraceSeconds of slack for the
			-- network). Section 10: a Reactor overload causes a fire (StartsFire).
			Meltdown = { SoloPlayers = 2, SoloValveSeconds = 10, HeldGraceSeconds = 0.6, StartsFire = true },
			-- Electrical surges (Section 10: random, more often in Era III; they cause fires and blackouts):
			-- a day's chance by era; an unwelded one may end in a fire or a blackout of its floor.
			ElectricalSurge = { EraChance = { 0.2, 0.25, 0.45, 0.35 }, FireChance = 0.3, BlackoutChance = 0.25 },
		},
		Repairs = { -- Prompt 13 (Section 6: a wrecked room stops until repaired with the Welder; residents slowly
			-- repair the room they work in; Section 11: Smarts is repair speed). prov.
			-- A wrecked room works again once it is back to RepairedAt of its HP. The Welder repairs
			-- the room it points at, WelderPerSecond (the Engineer twice as fast); a worker repairs
			-- Tuning.Rooms.ResidentRepairPerSecond, scaled by Smarts over ResidentSmartsBase.
			RepairedAt = 0.25, WelderPerSecond = 25, WelderReach = 10, ResidentSmartsBase = 5, ToolTickSeconds = 0.1,
		},
		MonsterAI = { -- Prompt 12 (Section 10: residents first, then machines, then players who hit them); prov.
			-- Playtest, Nov 8: one Hollow Miner wrecked a 500-HP room in 12 s at full damage, and three
			-- latched ticks downed a resident in 5 s; rooms now take half a monster's damage (the Hollow
			-- Miner 1.25x that) and a latched tick bites at 0.4x, half as often.
			TickSeconds = 0.2, AggroSeconds = 10, ProximityAggro = 9, SmashMultiplier = 1.25, StuckSeconds = 2.5,
			RoomDamageMultiplier = 0.5, LatchDamageMultiplier = 0.4, LatchIntervalMultiplier = 2,
			KeepDistanceFraction = 0.7, GooSpeed = 60, GooSlowSeconds = 3, GooSlowMultiplier = 0.6, WindupFraction = 0.45,
			-- Section 11: the unarmed flee to the nearest safe room; a lone Burrow Tick they swat themselves
			ResidentFleeRadius = 22, ResidentCalmSeconds = 6, ResidentSwatDamage = 6, ResidentSwatSeconds = 1,
		},
		Residents = { -- Section 11; needs and experience prov.
			StatMin = 1, StatMax = 10, StatCap = 15, LevelMax = 20, MoraleStart = 60, FoodPerCycle = 1, WaterPerCycle = 1,
			ShortfallHealth = 10, ShortfallMorale = 10, RestDrainPerShift = 60, RestRefillPerCycle = 100,
			NoBedRestMultiplier = 0.4, FriendsMax = 3, FriendThreshold = 100, GrievingMorale = 20, GrievingCycles = 2,
			SurgeSurvivedMorale = 5, DeathReviveSeconds = 20, XPPerWorkCycle = 30, XPPerKill = 5,
			XPPerExpeditionCycle = 40, XPToLevelBase = 100, XPToLevelStep = 40, RareStatBonus = 2,
			-- Prompt 10, prov.: max health = HealthBase + Grit x HealthPerGrit (Grit 5: 100); a staffed, lit
			-- Medbay heals every hurt resident this much a cycle; Auto-Assign fills rooms in this order
			-- (power first, so the lights stay on), then any other room with a job
			HealthBase = 70, HealthPerGrit = 6, MedbayHealPerCycle = 20,
			AutoAssignOrder = { "ReactorCore", "Generator", "WaterPurifier", "Kitchen", "Medbay", "Greenhouse",
				"Armory", "Workshop", "Lab", "DrillBay", "RadioRoom", "Lounge", "DeconRoom", "CryoBay", "TradingPost",
				"BlastDoor" },
			-- the routine (Section 11: work a shift, eat at the Kitchen, rest in Quarters), prov.: the first
			-- MealSeconds of each day at the Kitchen, the rest of the day at work, the Surge in bed; walking
			-- speed grows with Speed (Section 11: Speed affects moving)
			MealSeconds = 20, WalkSpeedBase = 8, WalkSpeedPerSpeed = 0.6,
		},
		Aging = { -- Section 11
			StartAge = { Min = 18, Max = 50 }, YoungUntil = 29, YoungXP = 1.1, VeteranFrom = 55, VeteranSpeed = 0.9,
			ElderFrom = 70, ElderKeptOutput = 0.7, DeathAge = { Min = 80, Max = 100 },
		},
		Morale = { -- Section 11 lists the causes; amounts prov. (Grieving is a Condition)
			JobFit = 2, PoorFit = -2, FriendInRoom = 2, FedCycle = 1, Hungry = -10, DarkRoom = -5, NoBed = -5, Injured = -5,
		},
		Trader = { -- Section 13; what he pays in Scrap per unit prov.
			EveryCycles = 3, EveryCyclesWithPost = 2, PostDiscount = 0.85,
			Buys = { Food = 2, Water = 2, Iron = 6, Copper = 10, Crystal = 16 },
		},
		Wanderers = { EveryCycles = { Min = 2, Max = 3 }, InspectCharm = 7 }, -- Section 10
		Expeditions = { -- Section 12; distress and loss odds prov.
			Size = { Min = 1, Max = 3 }, Cycles = { Min = 1, Max = 3 }, DistressChance = 0.15, BaseLossChance = 0.05,
			SurfaceLoot = "ExpeditionSurface", DeepLoot = "ExpeditionDeep",
		},
		Surface = { StormSirenSeconds = 20, RadiationPerSecond = 0.2, StormRadiationPerSecond = 2, RefillEvery = "Era" }, -- Section 12; rates prov.
		Legends = { StartLevel = 5, RenownMax = 5, RenownStatBonus = 1, StarterLegend = "RosieKowalski" }, -- Section 15
		ClassShop = { -- Section 14
			Slots = 4, ResetHourUTC = 0, FreeRerolls = 1, VIPFreeRerolls = 2, RerollRobux = 99, WishlistDays = 3,
			FreeTrialRunsPerDay = 1, ClassLevelRuns = { 3, 10 },
		},
		Account = { LevelMax = 100, XPPerYear = 10, XPToLevelBase = 200, XPToLevelStep = 50, VIPGlowshardBonus = 0.25 }, -- Section 16; XP prov.
		Lobby = { PadCountdownSeconds = 20, PartyMax = 6 }, -- Section 21
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000098"><Properties><string name="Name">Votes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Votes: what the team votes on and how each passes (bible Section 8). General rules
	(abstaining, ties, the 40% rule, cooldowns, solo runs, the Warden) are in Tuning.Votes.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({
		Name = F.Name,
		StartsWhen = F.Short,
		Seconds = F.Seconds,
		Rule = Check.enum({ "MoreYes", "WholeTeamMajority", "MostVotes", "TwoThirdsOfOthers" }),
		Text = F.Short,
	}),
	Order = { "Build", "PushDeeper", "Draft", "LetThemIn", "KeepGoing", "PlayAgain", "Kick" },
	Entries = {
		Build = {
			Name = "Build, upgrade, merge or tear down",
			StartsWhen = "A player proposes it in the Command View",
			Seconds = 15,
			Rule = "MoreYes",
			Text = "More yes than no after 15 seconds",
		},
		PushDeeper = {
			Name = "Push Deeper",
			StartsWhen = "Someone tries to open the first cell of floor 4, 7 or 10",
			Seconds = 20,
			Rule = "WholeTeamMajority",
			Text = "A majority of the whole team says yes",
		},
		Draft = {
			Name = "Blueprint draft",
			StartsWhen = "After every Surge",
			Seconds = 20,
			Rule = "MostVotes",
			Text = "Most votes after 20 seconds; ties are picked at random",
		},
		LetThemIn = {
			Name = "Let them in?",
			StartsWhen = "A wanderer knocks at the blast door",
			Seconds = 15,
			Rule = "MoreYes",
			Text = "More yes than no after 15 seconds",
		},
		KeepGoing = {
			Name = "Keep Going",
			StartsWhen = "After a victory",
			Seconds = 20,
			Rule = "WholeTeamMajority",
			Text = "A majority of the whole team",
		},
		PlayAgain = { -- Section 21: after a run, a vote sends the same party to a fresh Run server (Prompt 15)
			Name = "Play Again",
			StartsWhen = "Someone presses Play Again on the results screen",
			Seconds = 20,
			Rule = "WholeTeamMajority",
			Text = "A majority of the whole team",
		},
		Kick = {
			Name = "Kick a player",
			StartsWhen = "Any player starts it against one person",
			Seconds = 20,
			Rule = "TwoThirdsOfOthers",
			Text = "Two thirds of the other players",
		},
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000099"><Properties><string name="Name">WandererOutcomes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	WandererOutcomes: who is really knocking (bible Section 10). Every 2 to 3 cycles someone
	knocks and the team votes Let them in? The Warden, or a resident with Charm 7 or more, can
	inspect newcomers (Tuning.Wanderers). Odds provisional.
]]

local Check = require(script.Parent.Parent.Utilities.Check)
local F = require(script.Parent._Fields)

return {
	Schema = Check.shape({ Name = F.Name, Chance = F.Fraction, Text = F.Text }),
	Order = { "Survivor", "Raider", "Carrier" },
	Entries = {
		Survivor = { Name = "Survivor", Chance = 0.7, Text = "A real survivor who becomes a resident, sometimes a Rare one." },
		Raider = {
			Name = "Raider in disguise",
			Chance = 0.2,
			Text = "Later steals supplies or opens the door during a raid, unless unmasked first.",
		},
		Carrier = { Name = "Carrier", Chance = 0.1, Text = "Starts an Outbreak." },
	},
}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000009A"><Properties><string name="Name">_Fields</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	_Fields: checkers shared by the content modules (a helper, not a content type: Config
	skips child modules whose names start with _).
]]

local Check = require(script.Parent.Parent.Utilities.Check)

local Fields = {}

Fields.Name = Check.string(60, { min = 1 })
Fields.Short = Check.string(160)
Fields.Text = Check.string(600)
Fields.Count = Check.integer(0)
Fields.PositiveInt = Check.integer(1)
Fields.Number = Check.number()
Fields.NonNegative = Check.number({ min = 0 })
Fields.Fraction = Check.number({ min = 0, max = 1 })
Fields.Seconds = Check.number({ min = 0, max = 36000 })
Fields.Hex = Check.string(7, { pattern = "^#%x%x%x%x%x%x$" })
Fields.Flag = Check.optional(Check.boolean())

-- An art asset name from the pipeline (Category_Name or Category_Name_Variant).
Fields.Asset = Check.optional(Check.string(64, { pattern = "^%u%w*_%u[%w_]*$" }))

-- Where something comes from or how it unlocks.
Fields.Robux = Check.optional(Check.integer(0, 100000))
Fields.Glowshards = Check.optional(Check.integer(0, 100000))

-- A price or cost in stockpile resources: { Scrap = 100, Iron = 20 }
Fields.Costs = Check.map(Check.ref("Resources"), Check.integer(0), 9)

-- A low..high range of whole numbers.
Fields.Range = Check.shape({ Min = Check.number(), Max = Check.number() })

-- What an effect changes. Key names the modifier (Config.Modifiers says what it means, its
-- unit and which system applies it); Scope says who it reaches; Room narrows RoomOutput-style
-- keys to one room type.
Fields.Scope = Check.enum({ "Self", "Presence", "Room", "Nearby", "Floor", "Team", "Bunker" })
Fields.Modifier = Check.shape({
	Key = Check.ref("Modifiers"),
	Value = Check.number(),
	Room = Check.optional(Check.ref("Rooms")),
	Scope = Check.optional(Fields.Scope),
})
Fields.Modifiers = Check.array(Fields.Modifier, 12)

-- A described effect: the text players read and the modifiers systems apply.
Fields.Effect = Check.shape({
	Text = Fields.Text,
	Modifiers = Check.optional(Fields.Modifiers),
})

-- A list of item ids with counts (starting kits, loot, rewards).
Fields.ItemStack = Check.shape({ Item = Check.ref("Items"), Count = Check.optional(Check.integer(1, 999)) })
Fields.ItemStacks = Check.array(Fields.ItemStack, 12)

return table.freeze(Fields)
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX0000009B"><Properties><string name="Name">Constants</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Constants: identity and engine limits that every module may need.

	Gameplay numbers (costs, timings, stats) are content and live in Config, never here.
	These are the facts about the game itself and the provisional limits from bible
	Section 23 that size the simulation.
]]

export type PlaceKind = "Lobby" | "Run"

local Constants = {}

Constants.GAME_NAME = "100 Years Of Fallout"
Constants.UNIVERSE_ID = 10775267993
Constants.OWNER_USER_ID = 9768530298

-- Place ids (bible Section 23: two places, Lobby is the start place)
Constants.PLACE_IDS = table.freeze({
	Lobby = 135073046693952,
	Run = 72892455946761,
})

Constants.MAX_PLAYERS = table.freeze({
	Lobby = 30,
	Run = 6,
})

-- Simulation caps (provisional, bible Section 23)
Constants.CAPS = table.freeze({
	Residents = 40,
	Monsters = 25,
	Players = 6,
})

Constants.RESIDENT_TICK_HZ = 5 -- residents are simulated at 5 Hz along the room graph
Constants.SHOT_HISTORY_SECONDS = 0.25 -- gun checks look this far back for the target
Constants.AUTOSAVE_SECONDS = 120 -- profiles autosave this often (plus on leave and shutdown)
Constants.DELTA_HZ = 10 -- the delta channel flushes this often

-- Who may run DevTools commands outside Studio (Studio allows everyone in a playtest)
Constants.ADMIN_USER_IDS = table.freeze({
	[9768530298] = true,
})

--[[
	Which place this is. The PlaceId decides; a copied or local place falls back on the
	`PlaceKind` attribute the installer sets on Workspace.
]]
function Constants.PlaceKind(): PlaceKind
	local placeId = game.PlaceId
	if placeId == Constants.PLACE_IDS.Lobby then
		return "Lobby"
	elseif placeId == Constants.PLACE_IDS.Run then
		return "Run"
	end
	local attribute = workspace:GetAttribute("PlaceKind")
	if attribute == "Lobby" then
		return "Lobby"
	elseif attribute == "Run" then
		return "Run"
	end
	error(`Unknown place: PlaceId {placeId} and no PlaceKind attribute on Workspace`)
end

return table.freeze(Constants)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000009C"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Remotes: the one list of network events, and the only way code touches them
	(bible Section 23: a small set of typed RemoteEvents, each checked on the server and
	rate-limited per player; clients send intentions, never results).

	Adding a remote is one entry in DEFINITIONS:
	* To = "Server" (client -> server): Args holds one checker per argument (extra arguments
	  are rejected), Rate limits each player. The handler only runs for calls that pass.
	* To = "Client" (server -> client): the server is trusted; no checks.
	* Unreliable = true makes an UnreliableRemoteEvent (cosmetic, high-frequency traffic).
	* Place = "Run" or "Lobby" makes it exist in that place only (default: both).

	Server: Remotes.Setup() once (Bootstrap), then Remotes.OnServer(name, handler) and
	Remotes.FireClient / FireClients / FireAllClients. Client: Remotes.OnClient(name, handler)
	and Remotes.FireServer(name, ...). The RemoteEvents live under this ModuleScript.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Check = require(script.Parent.Utilities.Check)
local Constants = require(script.Parent.Constants)
local Log = require(script.Parent.Utilities.Log)
local RateLimit = require(script.Parent.Utilities.RateLimit)

export type Definition = {
	To: "Server" | "Client",
	Args: { Check.Checker }?,
	Rate: { Burst: number, PerSecond: number }?,
	Unreliable: boolean?,
	Place: Constants.PlaceKind?,
	Doc: string,
}

local DEFINITIONS: { [string]: Definition } = {
	-- client -> server
	ClientReady = {
		To = "Server",
		Args = {},
		Rate = { Burst = 2, PerSecond = 0.05 },
		Doc = "The client finished bootstrapping; the server sends it the replication snapshot.",
	},
	DevCommand = {
		To = "Server",
		Args = {
			Check.string(48, { pattern = "^[%w_%.%-]+$", min = 1 }),
			Check.array(Check.primitive(120), 8),
		},
		Rate = { Burst = 6, PerSecond = 2 },
		Doc = "A DevTools command (name, arguments) from a player; DevService checks permission.",
	},
	SetReady = {
		To = "Server",
		Place = "Run",
		Args = { Check.boolean() },
		Rate = { Burst = 4, PerSecond = 1 },
		Doc = "Ready (true) or not (false) to skip the rest of the day phase to the Surge siren (CycleClock).",
	},
	PingCell = {
		To = "Server",
		Place = "Run",
		Args = { Check.integer(1, 10), Check.integer(-6, 6) },
		Rate = { Burst = 3, PerSecond = 0.5 },
		Doc = "Ping a bunker cell (floor, column) from the Command View; PingService shows it to the team.",
	},

	Propose = {
		To = "Server",
		Place = "Run",
		Args = {
			Check.enum({ "Build", "Upgrade", "Merge", "TearDown" }),
			Check.integer(1, 10),
			Check.integer(-6, 6),
			Check.string(24, { pattern = "^%w*$" }),
		},
		Rate = { Burst = 3, PerSecond = 0.5 },
		Doc = "Propose construction from the Command View: action, floor, column, and the room type (Build) or the other room's id (Merge); BuildService checks it and VoteService puts it to the team.",
	},
	CastVote = {
		To = "Server",
		Place = "Run",
		Args = { Check.string(12, { pattern = "^V%d+$", min = 2 }), Check.enum({ "Yes", "No" }) },
		Rate = { Burst = 6, PerSecond = 2 },
		Doc = "Vote yes or no on the vote on the banner (VoteService); a player can change their vote until it closes.",
	},

	AssignResident = {
		To = "Server",
		Place = "Run",
		Args = { Check.string(12, { pattern = "^N%d+$", min = 2 }), Check.string(12, { pattern = "^R?%d*$" }) },
		Rate = { Burst = 8, PerSecond = 3 },
		Doc = "Give a resident a job (a room id) or take it away (\"\"); no vote (Section 8). ResidentService checks the room has a job and a free slot.",
	},
	AutoAssign = {
		To = "Server",
		Place = "Run",
		Args = {},
		Rate = { Burst = 2, PerSecond = 0.5 },
		Doc = "Auto-Assign (Section 7): fill empty job slots with idle residents by best stat.",
	},
	ReviveResident = {
		To = "Server",
		Place = "Run",
		Args = { Check.string(12, { pattern = "^N%d+$", min = 2 }) },
		Rate = { Burst = 3, PerSecond = 1 },
		Doc = "Revive a downed resident with a Medkit from the stockpile (the resident's prompt; Section 11).",
	},
	SelectSlot = {
		To = "Server",
		Place = "Run",
		Args = { Check.integer(0, 5) },
		Rate = { Burst = 10, PerSecond = 8 },
		Doc = "Hold a hotbar slot's item (1 to 5; 0 = the melee weapon) (WeaponService, Section 9).",
	},
	FireWeapon = {
		To = "Server",
		Place = "Run",
		Args = {
			Check.integer(1, 2), -- the gun's hotbar slot
			Check.integer(1, 2 ^ 30), -- the shot's number
			Check.vector3(20000), -- where it left the muzzle
			Check.vector3(1.01), -- the aim, before spread
			Check.number({ min = 0 }), -- the client's server time when it fired
			Check.array(Check.shape({
				Id = Check.string(12, { pattern = "^M%d+$", min = 2 }), -- monsters only: no friendly fire
				Point = Check.vector3(20000),
				Pellet = Check.integer(1, 16),
			}), 16),
		},
		Rate = { Burst = 24, PerSecond = 16 },
		Doc = "A shot: slot, shot number, origin, aim, time and the hits the client saw; the server checks it all (Section 23).",
	},
	ReloadWeapon = {
		To = "Server",
		Place = "Run",
		Args = {},
		Rate = { Burst = 4, PerSecond = 2 },
		Doc = "Reload the held gun from carried ammo (Section 9).",
	},
	MeleeSwing = {
		To = "Server",
		Place = "Run",
		Args = { Check.boolean(), Check.vector3(1.01) },
		Rate = { Burst = 6, PerSecond = 5 },
		Doc = "A melee swing: heavy or light, and the way the player faces; the hit is checked when it lands (Section 9).",
	},
	Dodge = {
		To = "Server",
		Place = "Run",
		Args = { Check.vector3(1.01) },
		Rate = { Burst = 3, PerSecond = 2 },
		Doc = "A dodge roll: costs stamina and gives a moment of invulnerability; the client moves the character (Section 9).",
	},
	Sprint = {
		To = "Server",
		Place = "Run",
		Args = { Check.boolean() },
		Rate = { Burst = 8, PerSecond = 4 },
		Doc = "Sprinting on or off, for the stamina it drains (Section 9).",
	},
	ThrowItem = {
		To = "Server",
		Place = "Run",
		Args = {
			Check.integer(4, 5), -- the throwable's hotbar slot
			Check.vector3(20000), -- where it leaves the hand
			Check.vector3(1.01), -- the aim
		},
		Rate = { Burst = 3, PerSecond = 2 },
		Doc = "Throw one of the held slot's throwables toward the aim (Landon, 2026-11-08: Fire throws).",
	},
	UseMedkit = {
		To = "Server",
		Place = "Run",
		Args = {},
		Rate = { Burst = 3, PerSecond = 2 },
		Doc = "Use a carried Medkit: it heals over Tuning.Player.MedkitSeconds (Landon, 2026-11-08: the Heal button).",
	},
	UseTool = {
		To = "Server",
		Place = "Run",
		Args = { Check.boolean() },
		Rate = { Burst = 8, PerSecond = 6 },
		Doc = "Start (true) or stop (false) using the held tool while Fire is held: the Extinguisher sprays, the Welder repairs what the player faces (WeaponService; Prompt 13).",
	},
	MarkDig = {
		To = "Server",
		Place = "Run",
		Args = { Check.integer(1, 10), Check.integer(-6, 6), Check.boolean() },
		Rate = { Burst = 6, PerSecond = 2 },
		Doc = "Put a rock cell (floor, column) on the Drill Bay's dig queue (true) or take it off (false) from the Command View; no vote (Section 7; DigService, Prompt 14).",
	},
	PlayAgain = {
		To = "Server",
		Place = "Run",
		Args = {},
		Rate = { Burst = 2, PerSecond = 0.2 },
		Doc = "Press Play Again on the results screen: a team vote to go again on a fresh Run server (Section 21; ResultsService, Prompt 15).",
	},
	KeepGoing = {
		To = "Server",
		Place = "Run",
		Args = {},
		Rate = { Burst = 2, PerSecond = 0.2 },
		Doc = "Press Keep Going on the results screen after a victory: a team vote to carry on in Endless (Section 5; ResultsService, Prompt 15).",
	},
	ReturnToLobby = {
		To = "Server",
		Place = "Run",
		Args = {},
		Rate = { Burst = 2, PerSecond = 0.2 },
		Doc = "Press Return to Lobby on the results screen: back to the lobby (Section 21; ResultsService, Prompt 15).",
	},

	-- server -> client
	Delta = {
		To = "Client",
		Doc = "The delta channel: batched collection ops (see Utilities.Delta), plus a snapshot flag.",
	},
	Notice = {
		To = "Client",
		Doc = "A text message for one player (DevTools output for now).",
	},
	Alert = {
		To = "Client",
		Doc = "A message for the HUD's alert feed: kind (Danger, Warning, Info) and text (a refused proposal, a vote that failed...).",
	},
	CellPinged = {
		To = "Client",
		Place = "Run",
		Doc = "A player pinged a cell: floor, column, the player's UserId and display name (PingService).",
	},
	BreachWarning = {
		To = "Client",
		Place = "Run",
		Doc = "A breach is coming (Section 10): floor, column, seconds of warning, where (text), how many monsters, and the room id if it is a vent (BreachService).",
	},
	HitConfirmed = {
		To = "Client",
		Place = "Run",
		Doc = "What the player's shot or swing did: the combatant id, the damage, whether it died, and where (WeaponService).",
	},
}

local log = Log.new("Remotes")
local IS_SERVER = RunService:IsServer()
local WAIT_SECONDS = 15
local REJECTION_LOG_SECONDS = 10

export type Stats = { Received: number, Rejected: number, Limited: number, Failed: number }

local stats: { [string]: Stats } = {}
local limiters: { [string]: RateLimit.Limiter } = {}
local handled: { [string]: boolean } = {}
local lastRejectionLog: { [Player]: number } = {}

for name, definition in DEFINITIONS do
	assert(definition.To == "Server" or definition.To == "Client", `Remote {name}: To must be Server or Client`)
	assert(definition.Place == nil or definition.Place == "Lobby" or definition.Place == "Run", `Remote {name}: Place must be Lobby or Run`)
	if definition.To == "Server" then
		assert(definition.Args, `Remote {name}: a client -> server remote needs Args`)
		assert(definition.Rate, `Remote {name}: a client -> server remote needs a Rate`)
	end
	stats[name] = { Received = 0, Rejected = 0, Limited = 0, Failed = 0 }
	table.freeze(definition)
end
table.freeze(DEFINITIONS)

local Remotes = {}

Remotes.Definitions = DEFINITIONS

-- Does this remote exist in this place?
function Remotes.InPlace(name: string): boolean
	local definition = DEFINITIONS[name]
	return definition ~= nil and (definition.Place == nil or definition.Place == Constants.PlaceKind())
end

local function definitionOf(name: string, direction: "Server" | "Client"): Definition
	local definition = DEFINITIONS[name]
	if not definition then
		error(`Unknown remote {tostring(name)}`, 3)
	end
	if definition.To ~= direction then
		error(`Remote {name} goes to the {definition.To:lower()}, not the {direction:lower()}`, 3)
	end
	if definition.Place ~= nil and definition.Place ~= Constants.PlaceKind() then
		error(`Remote {name} only exists in the {definition.Place} place`, 3)
	end
	return definition
end

local function instanceOf(name: string): RemoteEvent
	local found = script:FindFirstChild(name)
	if not found then
		if IS_SERVER then
			error(`Remote {name} doesn't exist yet: call Remotes.Setup() first`, 3)
		end
		found = script:WaitForChild(name, WAIT_SECONDS)
		if not found then
			error(`Remote {name} didn't arrive within {WAIT_SECONDS} s`, 3)
		end
	end
	return found :: any
end

-- Server: create every RemoteEvent. Idempotent.
function Remotes.Setup()
	assert(IS_SERVER, "Remotes.Setup runs on the server")
	local place = Constants.PlaceKind()
	for name, definition in DEFINITIONS do
		local className = if definition.Unreliable then "UnreliableRemoteEvent" else "RemoteEvent"
		local existing = script:FindFirstChild(name)
		if definition.Place ~= nil and definition.Place ~= place then
			if existing then
				existing:Destroy()
			end
			continue
		end
		if existing and existing.ClassName ~= className then
			existing:Destroy()
			existing = nil
		end
		if not existing then
			local remote = Instance.new(className)
			remote.Name = name
			remote.Parent = script
		end
		if definition.Rate then
			limiters[name] = RateLimit.new(definition.Rate.Burst, definition.Rate.PerSecond)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		for _, limiter in limiters do
			limiter:Forget(player)
		end
		lastRejectionLog[player] = nil
	end)
end

local function noteRejection(player: Player, name: string, why: string)
	local now = os.clock()
	local last = lastRejectionLog[player]
	if last and now - last < REJECTION_LOG_SECONDS then
		return
	end
	lastRejectionLog[player] = now
	log:Warn("rejected %s from %s (%d): %s", name, player.Name, player.UserId, why)
end

-- Server: the handler for a client -> server remote. One handler per remote.
function Remotes.OnServer(name: string, handler: (player: Player, ...any) -> ())
	assert(IS_SERVER, "Remotes.OnServer runs on the server")
	local definition = definitionOf(name, "Server")
	assert(not handled[name], `Remote {name} already has a handler`)
	handled[name] = true
	local checks = definition.Args :: { Check.Checker }
	local limiter = limiters[name]
	local counters = stats[name]
	instanceOf(name).OnServerEvent:Connect(function(player: Player, ...: any)
		counters.Received += 1
		if limiter and not limiter:Take(player) then
			counters.Limited += 1
			noteRejection(player, name, "rate limit")
			return
		end
		local count = select("#", ...)
		if count > #checks then
			counters.Rejected += 1
			noteRejection(player, name, `{count} arguments, expected at most {#checks}`)
			return
		end
		local args = { ... }
		for index, check in checks do
			local ok, why = check(args[index])
			if not ok then
				counters.Rejected += 1
				noteRejection(player, name, `argument {index}: {why}`)
				return
			end
		end
		local ok, err = xpcall(handler, debug.traceback, player, table.unpack(args, 1, count))
		if not ok then
			counters.Failed += 1
			log:Error("%s handler failed for %s: %s", name, player.Name, tostring(err))
		end
	end)
end

function Remotes.FireClient(name: string, player: Player, ...: any)
	definitionOf(name, "Client")
	instanceOf(name):FireClient(player, ...)
end

function Remotes.FireClients(name: string, players: { Player }, ...: any)
	definitionOf(name, "Client")
	local remote = instanceOf(name)
	for _, player in players do
		remote:FireClient(player, ...)
	end
end

function Remotes.FireAllClients(name: string, ...: any)
	definitionOf(name, "Client")
	instanceOf(name):FireAllClients(...)
end

-- Client: the handler for a server -> client remote.
function Remotes.OnClient(name: string, handler: (...any) -> ()): RBXScriptConnection
	assert(not IS_SERVER, "Remotes.OnClient runs on the client")
	definitionOf(name, "Client")
	return instanceOf(name).OnClientEvent:Connect(handler)
end

function Remotes.FireServer(name: string, ...: any)
	assert(not IS_SERVER, "Remotes.FireServer runs on the client")
	definitionOf(name, "Server")
	instanceOf(name):FireServer(...)
end

-- Server: counters per remote, for DevTools.
function Remotes.Stats(): { [string]: Stats }
	return stats
end

return table.freeze(Remotes)
]]></ProtectedString></Properties></Item><Item class="Folder" referent="RBX000000AF"><Properties><string name="Name">Rules</string></Properties><Item class="ModuleScript" referent="RBX0000009E"><Properties><string name="Name">Boss</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Boss: boss fights as arithmetic (bible Sections 10 and 22; Prompt 15). Pure, so BossService,
	BossController, WeaponService and the data tests agree. The numbers are Config.Bosses (health,
	phases), Tuning.Bosses (every boss) and Tuning.<BossId> (one boss's fight), provisional.

	* Health: Config.Bosses' Health times Threat.PlayerScale for the team (Section 5: the threat
	  scales with player count), times FirstRunHealth on an account's first run for an Era I boss
	  (Section 22: the Brood Mother is weaker).
	* Phases: a boss with N phases moves to the next at each Nth of its health lost.
	* The arena (Section 10: the Brood Mother bursts up through the deepest tunnel): on the deepest
	  floor, the longest run of side-by-side dug cells (a tunnel: nothing walls them apart); with
	  none, the widest room there that isn't the Reactor Core or a Shaft; with none, any open cell.
	  A boss can't fit through a doorway, so it fights in its arena.
	* Hits: armour takes ArmourMultiplier, a weak point WeakPointMultiplier (or a class's own).
	* Staggers: enough weak-point damage inside a short window staggers the boss.
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

local Boss = {}

export type Arena = {
	Floor: number,
	From: number, -- first column
	To: number, -- last column
	Kind: "Tunnel" | "Room" | "Cell",
	RoomId: string?,
}

function Boss.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Bosses")
end

-- A boss's own fight numbers (Tuning.<BossId>), or nil before its fight exists.
function Boss.Fight(bossId: string): { [string]: any }?
	return Config.Find("Tuning", bossId)
end

-- The value for this phase from a by-phase list (the last one carries on).
function Boss.ByPhase(list: { any }, phase: number): any
	return list[math.clamp(phase, 1, #list)]
end

function Boss.Health(bossId: string, players: number, firstRun: boolean): number
	local entry = Config.Get("Bosses", bossId)
	local scale = Config.Get("Tuning", "Threat").PlayerScale
	local n = math.clamp(math.floor(players), 1, #scale)
	local health = entry.Health * scale[n]
	if firstRun and entry.Year <= 25 then
		health *= Boss.Tuning().FirstRunHealth
	end
	return math.floor(health + 0.5)
end

-- The phase at this share of health left (1 at full health, Phases near the end).
function Boss.Phase(bossId: string, fraction: number): number
	local phases = Config.Get("Bosses", bossId).Phases
	local lost = 1 - math.clamp(fraction, 0, 1)
	return math.clamp(math.floor(lost * phases + 1e-9) + 1, 1, phases)
end

-- Where a boss breaks in: see the header. `bunker` is a Rules.Bunker.
function Boss.Arena(bunker: any): Arena?
	local floor = bunker:DeepestFloor()
	if floor < 1 then
		return nil
	end
	local t = Grid.Tuning()
	-- runs of dug cells side by side
	local best: Arena? = nil
	local column = t.ColumnMin
	while column <= t.ColumnMax do
		if bunker:State(floor, column) == "Dug" then
			local from = column
			while column + 1 <= t.ColumnMax and bunker:State(floor, column + 1) == "Dug" do
				column += 1
			end
			if not best or column - from > best.To - best.From then
				best = { Floor = floor, From = from, To = column, Kind = "Tunnel" }
			end
		end
		column += 1
	end
	if best then
		return best
	end
	-- the widest room on the floor that isn't the Reactor Core or a Shaft
	local room: any = nil
	for _, r in bunker:AllRooms() do
		if r.Floor == floor and r.Type ~= "ReactorCore" and r.Type ~= "Shaft" then
			if not room or r.Span > room.Span or (r.Span == room.Span and r.Column < room.Column) then
				room = r
			end
		end
	end
	if room then
		return { Floor = floor, From = room.Column, To = room.Column + room.Span - 1, Kind = "Room", RoomId = room.Id }
	end
	for c = t.ColumnMin, t.ColumnMax do
		if bunker:IsOpen(floor, c) then
			return { Floor = floor, From = c, To = c, Kind = "Cell" }
		end
	end
	return nil
end

-- The middle column of an arena (where the boss breaks in).
function Boss.ArenaMiddle(arena: Arena): number
	return math.floor((arena.From + arena.To) / 2)
end

-- How far along X the boss's centre may go: `margin` studs inside the arena's end walls.
function Boss.ArenaSpan(arena: Arena, margin: number): (number, number)
	local half = Grid.Tuning().CellWidth / 2
	local left = Grid.CellPosition(arena.Floor, arena.From).X - half + margin
	local right = Grid.CellPosition(arena.Floor, arena.To).X + half - margin
	if left > right then
		local mid = (left + right) / 2
		return mid, mid
	end
	return left, right
end

-- A hit's multiplier: the weak point's (a class's own if it has one), else the armour's.
function Boss.HitMultiplier(weak: boolean, classWeakPoint: number?): number
	local t = Boss.Tuning()
	if weak then
		return classWeakPoint or t.WeakPointMultiplier
	end
	return t.ArmourMultiplier
end

-- Is `point` on a weak point part? (`size` and `cframe` are the part's; tolerance in studs.)
function Boss.OnPart(point: Vector3, cframe: CFrame, size: Vector3, tolerance: number): boolean
	local p = cframe:PointToObjectSpace(point)
	local h = size / 2 + Vector3.one * tolerance
	return math.abs(p.X) <= h.X and math.abs(p.Y) <= h.Y and math.abs(p.Z) <= h.Z
end

-- Weak-point damage inside the window (hits are { At, Amount }) reaching `threshold` staggers.
function Boss.Staggers(hits: { { At: number, Amount: number } }, now: number, window: number, threshold: number): boolean
	local sum = 0
	for _, hit in hits do
		if now - hit.At <= window then
			sum += hit.Amount
		end
	end
	return sum >= threshold
end

return table.freeze(Boss)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000009F"><Properties><string name="Name">Bunker</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Bunker: the bunker as data, with the grid's rules (bible Section 6). Pure (no
	Instances), so BunkerGrid on the server, the Command View on the client (ghost outlines,
	what can be dug) and the data tests share it.

	Every cell on the grid is Rock, Dug (empty) or part of a room. `Cells` holds the open ones:
	"" for a Dug cell, the room's id for a room cell; a cell that isn't there is Rock.

	The rules:
	* Dig: a Rock cell to the left of, right of or below an open cell.
	* Place: a room on Dug cells side by side on one floor, at most its MaxCells, in a band
	  that can be built on (not the Source Chamber), on its own Floor if it has one, and only
	  one of a Unique room.
	* Merge: two rooms of one type and level side by side, at most MaxCells together (rooms at
	  different levels never merge; Landon, Nov 8, 2026). Fixed rooms (the Blast Door, the
	  Reactor Core) never merge, move or go. The merged room keeps both rooms' HP.
	* HP is per cell (Landon, Nov 8, 2026): a room's maximum is Tuning.Rooms.HP for its level
	  times its cells, so a 3-cell room at level 1 has 1,500. RoomHP and BlastDoorHealth
	  modifiers scale it (SetHPScale; Prompt 13).
	* Wrecked (Section 6: at 0 HP a room is wrecked and stops until repaired): a room is
	  Wrecked from the moment its HP reaches 0 until repairs bring it back to Tuning.Repairs
	  .RepairedAt of its maximum (Prompt 13). Wrecked rooms make nothing and draw nothing.
	* SetLevel: 1 to 3; HP keeps its share of the new maximum.
	* The room graph: a node per room ("R3") and per Dug cell ("D:2,3"), with an edge between
	  side-by-side open cells of different units (a doorway) and between stacked Shafts. A dug
	  cell is a step like a room when power counts steps from a Reactor Core or a Generator
	  (Section 6; Landon, Nov 8, 2026).

	Votes, costs and build time (BuildService, Prompt 8), dig time and Push Deeper (DigService,
	Prompt 14) are not here.
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

export type CellState = "Rock" | "Dug" | "Room"
export type Room = {
	Id: string,
	Type: string,
	Floor: number,
	Column: number, -- the leftmost cell
	Span: number, -- cells, side by side
	Level: number,
	HP: number,
	MaxHP: number,
	Wrecked: boolean, -- from 0 HP until repaired to RepairedAt of MaxHP (Prompt 13)
}

type Data = {
	Cells: { [string]: string },
	Rooms: { [string]: Room },
	NextId: number,
	HPScale: { [string]: number }, -- "All" or a room type -> HP multiplier (RoomHP, BlastDoorHealth)
}

local Bunker = {}
Bunker.__index = Bunker

export type Bunker = typeof(setmetatable({} :: Data, Bunker))

local DUG_PREFIX = "D:"

-- A room's maximum HP: per cell, by level.
local function maxHP(level: number, span: number): number
	return Config.Get("Tuning", "Rooms").HP[level] * span
end

Bunker.MaxHP = maxHP

-- HP a wrecked room needs before it works again.
local function repairedAt(maxHPValue: number): number
	return math.ceil(maxHPValue * Config.Get("Tuning", "Repairs").RepairedAt)
end

Bunker.RepairedAt = repairedAt

local function idNumber(id: string): number
	return tonumber(string.sub(id, 2)) or 0
end

function Bunker.new(): Bunker
	return setmetatable({ Cells = {}, Rooms = {}, NextId = 1, HPScale = {} } :: Data, Bunker)
end

-- The starting bunker (Tuning.StartingBunker), built by the same rules.
function Bunker.FromStart(): Bunker
	local bunker = Bunker.new()
	local start = Config.Get("Tuning", "StartingBunker")
	for _, cell in start.Cells do
		for column = cell.Column, cell.Column + (cell.Span or 1) - 1 do
			bunker:Open(cell.Floor, column)
		end
	end
	for _, cell in start.Cells do
		if cell.Room then
			local id, why = bunker:Place(cell.Room, cell.Floor, cell.Column, cell.Span or 1)
			if not id then
				error(`Tuning.StartingBunker: {cell.Room} at {Grid.Key(cell.Floor, cell.Column)}: {why}`)
			end
		end
	end
	return bunker
end

-- A copy of the bunker from the replicated collections, for client previews (the Command
-- View's build menu): Cells maps "floor,column" to { Room = id } or {}, Rooms maps an id to
-- { Type, Floor, Column, Span, Level, HP, MaxHP }.
function Bunker.FromSnapshot(cells: { [string]: any }, rooms: { [string]: any }): Bunker
	local bunker = Bunker.new()
	for key, cell in cells do
		local roomId = if type(cell) == "table" then cell.Room else nil
		bunker.Cells[key] = if type(roomId) == "string" then roomId else ""
	end
	for id, room in rooms do
		bunker.Rooms[id] = {
			Id = id,
			Type = room.Type,
			Floor = room.Floor,
			Column = room.Column,
			Span = room.Span,
			Level = room.Level,
			HP = room.HP,
			MaxHP = room.MaxHP,
			Wrecked = if room.Wrecked ~= nil then room.Wrecked == true else room.HP <= 0,
		}
		bunker.NextId = math.max(bunker.NextId, idNumber(id) + 1)
	end
	return bunker
end

-- Cells ---------------------------------------------------------------------------------

-- Rock, Dug or Room (and the room's id); nil off the grid.
function Bunker.State(self: Bunker, floor: number, column: number): (CellState?, string?)
	if not Grid.OnGrid(floor, column) then
		return nil, nil
	end
	local value = self.Cells[Grid.Key(floor, column)]
	if value == nil then
		return "Rock", nil
	elseif value == "" then
		return "Dug", nil
	end
	return "Room", value
end

function Bunker.IsOpen(self: Bunker, floor: number, column: number): boolean
	local state = self:State(floor, column)
	return state == "Dug" or state == "Room"
end

-- Opens a cell with no questions asked: for the starting bunker and tests only.
function Bunker.Open(self: Bunker, floor: number, column: number)
	assert(Grid.OnGrid(floor, column), `Rules.Bunker: {Grid.Key(floor, column)} is off the grid`)
	local key = Grid.Key(floor, column)
	if self.Cells[key] == nil then
		self.Cells[key] = ""
	end
end

function Bunker.CanDig(self: Bunker, floor: number, column: number): (boolean, string?)
	if not Grid.OnGrid(floor, column) then
		return false, "off the grid"
	elseif self:IsOpen(floor, column) then
		return false, "already open"
	elseif self:IsOpen(floor, column - 1) or self:IsOpen(floor, column + 1) or self:IsOpen(floor - 1, column) then
		return true, nil
	end
	return false, "nothing dug beside or above it (dig left, right or down from a dug cell or room)"
end

function Bunker.Dig(self: Bunker, floor: number, column: number): (boolean, string?)
	local ok, why = self:CanDig(floor, column)
	if ok then
		self.Cells[Grid.Key(floor, column)] = ""
	end
	return ok, why
end

-- The deepest floor with an open cell.
function Bunker.DeepestFloor(self: Bunker): number
	local deepest = 0
	for key in self.Cells do
		local floor = Grid.Parse(key)
		if floor and floor > deepest then
			deepest = floor
		end
	end
	return deepest
end

-- Rooms ---------------------------------------------------------------------------------

-- A room's maximum HP here: per cell by level, times this bunker's RoomHP scale and its type's.
function Bunker.MaxHPOf(self: Bunker, roomType: string, level: number, span: number): number
	local scale = (self.HPScale.All or 1) * (self.HPScale[roomType] or 1)
	return math.floor(maxHP(level, span) * scale + 0.5)
end

-- Sets an HP multiplier ("All" rooms, or one room type) and rescales every room it touches,
-- each keeping its share of its maximum (RoomHP: Reinforced Walls; BlastDoorHealth).
function Bunker.SetHPScale(self: Bunker, key: string, value: number)
	self.HPScale[key] = if value == 1 then nil else value
	for _, room in self.Rooms do
		local newMax = self:MaxHPOf(room.Type, room.Level, room.Span)
		if newMax ~= room.MaxHP then
			room.HP = math.floor(room.HP / math.max(room.MaxHP, 1) * newMax + 0.5)
			room.MaxHP = newMax
		end
	end
end

-- Is the room wrecked? (Section 6: it stops until repaired.)
function Bunker.IsWrecked(room: Room?): boolean
	return room ~= nil and room.Wrecked == true
end

-- The live record: read it, never edit it (use the methods).
function Bunker.Room(self: Bunker, id: string): Room?
	return self.Rooms[id]
end

function Bunker.RoomAt(self: Bunker, floor: number, column: number): Room?
	local state, id = self:State(floor, column)
	return if state == "Room" and id then self.Rooms[id] else nil
end

function Bunker.IsShaft(self: Bunker, floor: number, column: number): boolean
	local room = self:RoomAt(floor, column)
	return room ~= nil and room.Type == "Shaft"
end

-- Every room, oldest first.
function Bunker.AllRooms(self: Bunker): { Room }
	local list = {}
	for _, room in self.Rooms do
		table.insert(list, room)
	end
	table.sort(list, function(a, b)
		return idNumber(a.Id) < idNumber(b.Id)
	end)
	return list
end

function Bunker.RoomsOfType(self: Bunker, roomType: string): { Room }
	local list = {}
	for _, room in self:AllRooms() do
		if room.Type == roomType then
			table.insert(list, room)
		end
	end
	return list
end

function Bunker.CanPlace(self: Bunker, roomType: string, floor: number, column: number, span: number): (boolean, string?)
	local info = Config.Find("Rooms", roomType)
	if not info then
		return false, `no room type {tostring(roomType)}`
	elseif span ~= math.floor(span) or span < 1 or span > info.MaxCells then
		return false, `{info.Name} takes 1 to {info.MaxCells} cells`
	end
	for offset = 0, span - 1 do
		local state = self:State(floor, column + offset)
		if state == nil then
			return false, "off the grid"
		elseif state ~= "Dug" then
			return false, `cell {Grid.Key(floor, column + offset)} isn't dug and empty`
		end
	end
	if not Grid.Buildable(floor) then
		return false, "nothing is built in the Source Chamber"
	elseif info.Floor and info.Floor ~= floor then
		return false, `{info.Name} only goes on floor {info.Floor}`
	elseif info.Unique and #self:RoomsOfType(roomType) > 0 then
		return false, `there is already a {info.Name}`
	end
	return true, nil
end

function Bunker.Place(self: Bunker, roomType: string, floor: number, column: number, span: number, level: number?): (string?, string?)
	local ok, why = self:CanPlace(roomType, floor, column, span)
	if not ok then
		return nil, why
	end
	local startLevel = level or 1
	if startLevel ~= 1 and startLevel ~= 2 and startLevel ~= 3 then
		return nil, "levels go from 1 to 3"
	end
	local id = `R{self.NextId}`
	self.NextId += 1
	local hp = self:MaxHPOf(roomType, startLevel, span)
	self.Rooms[id] = {
		Id = id,
		Type = roomType,
		Floor = floor,
		Column = column,
		Span = span,
		Level = startLevel,
		HP = hp,
		MaxHP = hp,
		Wrecked = false,
	}
	for offset = 0, span - 1 do
		self.Cells[Grid.Key(floor, column + offset)] = id
	end
	return id, nil
end

function Bunker.CanRemove(self: Bunker, id: string): (boolean, string?)
	local room = self.Rooms[id]
	if not room then
		return false, `no room {tostring(id)}`
	elseif Config.Get("Rooms", room.Type).Fixed then
		return false, `the {Config.Get("Rooms", room.Type).Name} can't be torn down`
	end
	return true, nil
end

-- Tears a room down; its cells become Dug again.
function Bunker.Remove(self: Bunker, id: string): (boolean, string?)
	local ok, why = self:CanRemove(id)
	if not ok then
		return false, why
	end
	local room = self.Rooms[id]
	for offset = 0, room.Span - 1 do
		self.Cells[Grid.Key(room.Floor, room.Column + offset)] = ""
	end
	self.Rooms[id] = nil
	return true, nil
end

function Bunker.CanMerge(self: Bunker, a: string, b: string): (boolean, string?)
	local first, second = self.Rooms[a], self.Rooms[b]
	if not first or not second then
		return false, "no such room"
	elseif a == b then
		return false, "a room can't merge with itself"
	end
	local info = Config.Get("Rooms", first.Type)
	if first.Type ~= second.Type then
		return false, "only matching rooms merge"
	elseif info.Fixed then
		return false, `the {info.Name} can't be merged`
	elseif first.Floor ~= second.Floor
		or (first.Column + first.Span ~= second.Column and second.Column + second.Span ~= first.Column)
	then
		return false, "the rooms aren't side by side"
	elseif first.Level ~= second.Level then
		return false, "the rooms are at different levels"
	elseif first.Span + second.Span > info.MaxCells then
		return false, `{info.Name} takes at most {info.MaxCells} cells`
	end
	return true, nil
end

-- Merges two rooms into one (the left room's id survives). Returns that id.
function Bunker.Merge(self: Bunker, a: string, b: string): (string?, string?)
	local ok, why = self:CanMerge(a, b)
	if not ok then
		return nil, why
	end
	local left, right = self.Rooms[a], self.Rooms[b]
	if right.Column < left.Column then
		left, right = right, left
	end
	for offset = 0, right.Span - 1 do
		self.Cells[Grid.Key(right.Floor, right.Column + offset)] = left.Id
	end
	left.Span += right.Span
	left.HP += right.HP -- HP is per cell: each part keeps what it had
	left.MaxHP = self:MaxHPOf(left.Type, left.Level, left.Span)
	left.HP = math.min(left.HP, left.MaxHP)
	left.Wrecked = (left.Wrecked or right.Wrecked) and left.HP < repairedAt(left.MaxHP)
	self.Rooms[right.Id] = nil
	return left.Id, nil
end

function Bunker.SetLevel(self: Bunker, id: string, level: number): (boolean, string?)
	local room = self.Rooms[id]
	if not room then
		return false, `no room {tostring(id)}`
	elseif level ~= 1 and level ~= 2 and level ~= 3 then
		return false, "levels go from 1 to 3"
	end
	local newMax = self:MaxHPOf(room.Type, level, room.Span)
	room.HP = math.floor(room.HP / room.MaxHP * newMax + 0.5)
	room.MaxHP = newMax
	room.Level = level
	if room.Wrecked and room.HP >= repairedAt(room.MaxHP) then
		room.Wrecked = false
	end
	return true, nil
end

-- Sets a room's HP. At 0 it is Wrecked; a wrecked room works again once repairs bring it back
-- to RepairedAt of its maximum (Prompt 13). Returns the HP it now has.
function Bunker.SetHP(self: Bunker, id: string, hp: number): number?
	local room = self.Rooms[id]
	if not room then
		return nil
	end
	room.HP = math.clamp(math.floor(hp + 0.5), 0, room.MaxHP)
	if room.HP <= 0 then
		room.Wrecked = true
	elseif room.Wrecked and room.HP >= repairedAt(room.MaxHP) then
		room.Wrecked = false
	end
	return room.HP
end

-- The room graph ------------------------------------------------------------------------

-- The graph node a cell belongs to: a room id, "D:<key>" for a Dug cell, nil for Rock.
function Bunker.UnitAt(self: Bunker, floor: number, column: number): string?
	local state, id = self:State(floor, column)
	if state == "Room" then
		return id
	elseif state == "Dug" then
		return DUG_PREFIX .. Grid.Key(floor, column)
	end
	return nil
end

-- The cells of a node, as { floor, column } pairs.
function Bunker.CellsOf(self: Bunker, unit: string): { { number } }
	if string.sub(unit, 1, #DUG_PREFIX) == DUG_PREFIX then
		local floor, column = Grid.Parse(string.sub(unit, #DUG_PREFIX + 1))
		if floor and column and self:State(floor, column) == "Dug" then
			return { { floor, column } }
		end
		return {}
	end
	local room = self.Rooms[unit]
	local cells = {}
	if room then
		for offset = 0, room.Span - 1 do
			table.insert(cells, { room.Floor, room.Column + offset })
		end
	end
	return cells
end

-- Every node: rooms oldest first, then Dug cells by key.
function Bunker.Units(self: Bunker): { string }
	local units = {}
	for _, room in self:AllRooms() do
		table.insert(units, room.Id)
	end
	local dug = {}
	for key, value in self.Cells do
		if value == "" then
			table.insert(dug, DUG_PREFIX .. key)
		end
	end
	table.sort(dug)
	table.move(dug, 1, #dug, #units + 1, units)
	return units
end

function Bunker.Neighbors(self: Bunker, unit: string): { string }
	local found: { [string]: boolean } = {}
	local list = {}
	local function add(other: string?)
		if other and other ~= unit and not found[other] then
			found[other] = true
			table.insert(list, other)
		end
	end
	for _, cell in self:CellsOf(unit) do
		local floor, column = cell[1], cell[2]
		add(self:UnitAt(floor, column - 1))
		add(self:UnitAt(floor, column + 1))
		if self:IsShaft(floor, column) then
			if self:IsShaft(floor - 1, column) then
				add(self:UnitAt(floor - 1, column))
			end
			if self:IsShaft(floor + 1, column) then
				add(self:UnitAt(floor + 1, column))
			end
		end
	end
	table.sort(list)
	return list
end

function Bunker.Graph(self: Bunker): { [string]: { string } }
	local graph = {}
	for _, unit in self:Units() do
		graph[unit] = self:Neighbors(unit)
	end
	return graph
end

-- Every node reachable from `from` (including it).
function Bunker.Reachable(self: Bunker, from: string): { [string]: boolean }
	local seen: { [string]: boolean } = { [from] = true }
	local queue = { from }
	local index = 1
	while index <= #queue do
		for _, other in self:Neighbors(queue[index]) do
			if not seen[other] then
				seen[other] = true
				table.insert(queue, other)
			end
		end
		index += 1
	end
	return seen
end

return Bunker
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A0"><Properties><string name="Name">CameraRig</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.CameraRig: the over-the-shoulder camera's geometry (bible Section 9), shared so the
	CameraController and the data tests agree. Pure functions, no instances.

	Angles are radians. Yaw turns about +Y; pitch tilts the view up (+) or down (-). The rig
	looks along its -Z, so at yaw 0 the camera looks toward -Z and its right is +X. `side` is
	1 for the right shoulder and -1 for the left (values between blend a swap).
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

local CameraRig = {}

function CameraRig.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Camera")
end

-- The camera's rotation for a yaw and a pitch.
function CameraRig.Rotation(yaw: number, pitch: number): CFrame
	return CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
end

function CameraRig.ClampPitch(pitch: number): number
	local t = CameraRig.Tuning()
	return math.clamp(pitch, math.rad(t.PitchMin), math.rad(t.PitchMax))
end

-- The point the camera orbits: beside the pivot (the character's head height), on the
-- camera's side, turned with the yaw only so looking up or down never swings it.
function CameraRig.Focus(pivot: Vector3, yaw: number, side: number, shoulder: number, raise: number): Vector3
	return pivot + CFrame.Angles(0, yaw, 0):VectorToWorldSpace(Vector3.new(side * shoulder, raise, 0))
end

-- Where the camera sits `distance` behind the focus.
function CameraRig.Position(focus: Vector3, yaw: number, pitch: number, distance: number): Vector3
	return focus - CameraRig.Rotation(yaw, pitch).LookVector * distance
end

-- A stick reading after a radial dead zone, with a squared response (0 to 1).
function CameraRig.Stick(input: Vector2, deadzone: number): Vector2
	local size = input.Magnitude
	if size <= deadzone or size == 0 then
		return Vector2.zero
	end
	local scaled = math.min((size - deadzone) / (1 - deadzone), 1)
	return input.Unit * scaled * scaled
end

-- The zoom range: the far end is capped indoors (in a bunker cell) so the camera stays in
-- the room.
function CameraRig.ZoomRange(indoors: boolean): (number, number)
	local t = CameraRig.Tuning()
	return t.Distance.Min, if indoors then math.min(t.Distance.Max, t.IndoorMax) else t.Distance.Max
end

-- The lowest and highest the camera may sit while its subject is in a bunker cell: above the
-- floor and under the ceiling panels. Nil outside the grid.
function CameraRig.CellHeights(pivot: Vector3): (number?, number?)
	local floor, column = Grid.CellAt(pivot)
	if not floor or not column then
		return nil, nil
	end
	local t = CameraRig.Tuning()
	local y = Grid.CellPosition(floor, column).Y
	return y + t.FloorMargin, y + Grid.Tuning().CellHeight - t.CeilingMargin
end

-- The farthest the camera can go back along its view from `focus` and stay between `low` and
-- `high` (it slides in along the view rather than leaving the aim point).
function CameraRig.HeightLimit(focus: Vector3, look: Vector3, low: number, high: number): number
	local limit = math.huge
	if look.Y < -1e-3 then -- looking down: the camera is above the focus
		limit = math.max(0, (high - focus.Y) / -look.Y)
	elseif look.Y > 1e-3 then -- looking up: the camera is below the focus
		limit = math.max(0, (focus.Y - low) / look.Y)
	end
	return limit
end

-- Eases `current` toward `target` at `rate` per second, frame-rate independent.
function CameraRig.Approach(current: number, target: number, rate: number, dt: number): number
	return target + (current - target) * math.exp(-rate * dt)
end

-- Moves `current` toward `target` by at most `step`.
function CameraRig.MoveToward(current: number, target: number, step: number): number
	if current < target then
		return math.min(current + step, target)
	end
	return math.max(current - step, target)
end

return table.freeze(CameraRig)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A1"><Properties><string name="Name">Clock</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Clock: the century's arithmetic (bible Section 5). Pure functions over a State
	table, so CycleClock, the client and the data tests share one copy. CycleClock owns the
	timers; these functions only decide numbers and kinds.

	* A cycle is a day phase, then a Surge. At the end of each cycle the year counter jumps by
	  Years per Cycle: Tuning.Clock.YearsPerCycleStart (1) plus the YearsPerCycle of every
	  objective done (Config.Objectives: each Lost Crew rescued +2, each era boss beaten +1),
	  at most Tuning.Clock.YearsPerCycleMax (12).
	* When the counter reaches or passes the last year of era I, II or III (25, 50, 75), the
	  next Surge is that era's boss, unless it is already beaten. The boss Surge comes once.
	* When the counter reaches Tuning.Clock.FinalYear (100) it stops there, and the next
	  Surge is the final one (the Source rises into the bunker).
	* A boss Surge (an era boss, or the final Surge's Source) has no timer: it lasts until
	  its boss is beaten (Landon, Nov 8, 2026). Other Surges end on the timer, or earlier when
	  cleared.
	* The first cycle's Surge is a small tutorial wave.
	* Endless (Keep Going after a victory): no cap, no era bosses, every Surge an Endless one.

	In cycle order:
		local state = Clock.NewState()               -- Cycle 1, Year 1
		local coming = Clock.SurgeKind(state)        -- during the day: what the Surge will be
		local kind, boss = Clock.StartSurge(state)   -- the Surge begins (uses up a due boss)
		local before, due = Clock.EndCycle(state)    -- Year += Years per Cycle, Cycle += 1
]]

local Config = require(script.Parent.Parent.Config)

export type SurgeKind = "Tutorial" | "Normal" | "Boss" | "Final" | "Endless"

export type State = {
	Cycle: number, -- from 1
	Year: number, -- from 1
	Completed: { [string]: boolean }, -- objective ids done (Config.Objectives)
	PendingBoss: string?, -- an era boss due at the next Surge (Config.Bosses)
	Endless: boolean,
}

local Clock = {}

function Clock.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Clock")
end

function Clock.NewState(): State
	return { Cycle = 1, Year = 1, Completed = {}, PendingBoss = nil, Endless = false }
end

-- Years per Cycle when these objectives are done.
function Clock.YearsPerCycle(completed: { [string]: boolean }): number
	local tuning = Clock.Tuning()
	local years = tuning.YearsPerCycleStart
	for id, done in completed do
		local objective = Config.Find("Objectives", id)
		if done and objective then
			years += objective.YearsPerCycle
		end
	end
	return math.min(years, tuning.YearsPerCycleMax)
end

-- Has this era boss been beaten (its objective done)?
function Clock.BossBeaten(completed: { [string]: boolean }, bossId: string): boolean
	for _, objective in Config.All("Objectives") do
		if objective.Kind == "Boss" and objective.Boss == bossId and completed[objective.Id] then
			return true
		end
	end
	return false
end

-- The era a year belongs to; past Year 100 (Endless), the last era.
function Clock.EraOf(year: number): string
	local eras = Config.All("Eras")
	for _, era in eras do
		if year <= era.Years.To then
			return era.Id
		end
	end
	return eras[#eras].Id
end

-- The boss of the final Surge: the boss of the era that ends in the final year.
function Clock.FinalBoss(): string?
	local finalYear = Clock.Tuning().FinalYear
	for _, era in Config.All("Eras") do
		if era.Years.To == finalYear then
			return era.Boss
		end
	end
	return nil
end

-- What the coming Surge is, and its boss (an era boss, or the final boss).
function Clock.SurgeKind(state: State): (SurgeKind, string?)
	local tuning = Clock.Tuning()
	if state.Endless then
		return "Endless", nil
	elseif state.PendingBoss ~= nil then
		return "Boss", state.PendingBoss
	elseif state.Year >= tuning.FinalYear then
		return "Final", Clock.FinalBoss()
	elseif state.Cycle == 1 and tuning.TutorialFirstSurge then
		return "Tutorial", nil
	end
	return "Normal", nil
end

-- Does a Surge of this kind run until its boss is beaten, with no timer?
function Clock.IsOpenEnded(kind: SurgeKind): boolean
	return kind == "Boss" or kind == "Final"
end

-- The Surge begins: its kind and boss. A due era boss is used up (its Surge comes once).
function Clock.StartSurge(state: State): (SurgeKind, string?)
	local kind, boss = Clock.SurgeKind(state)
	if kind == "Boss" then
		state.PendingBoss = nil
	end
	return kind, boss
end

--[[
	The end of a cycle: the year counter jumps by Years per Cycle (stopping at the final year
	outside Endless) and the cycle number goes up. Returns the year before the jump, and the
	era boss that became due because the jump reached or passed the end of its era.
]]
function Clock.EndCycle(state: State): (number, string?)
	local tuning = Clock.Tuning()
	local before = state.Year
	local after = before + Clock.YearsPerCycle(state.Completed)
	if not state.Endless then
		after = math.min(after, tuning.FinalYear)
	end
	state.Year = after
	state.Cycle += 1
	if state.Endless then
		return before, nil
	end
	local due: string? = nil
	for _, era in Config.All("Eras") do
		local last = era.Years.To
		if last < tuning.FinalYear and before < last and after >= last and not Clock.BossBeaten(state.Completed, era.Boss) then
			due = era.Boss
		end
	end
	if due then
		state.PendingBoss = due
	end
	return before, due
end

return table.freeze(Clock)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A2"><Properties><string name="Name">Combat</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Combat: the rules of fighting (bible Section 9, and Section 23's server checks). Pure:
	CombatService and WeaponService run them on the server, CombatController on the client, so
	both sides agree on spread, timing and reach; DataTests hold them to the bible.

	* Items: Gun(itemId) and Melee(itemId) read Config.Items; Damage(itemId, rarity, heavy?)
	  scales by Config.ItemRarities (Standard is 1).
	* Guns: Interval(itemId) between shots (1 / FireRate). ShotSeed(salt, shot) and
	  Spread(seed, direction, itemId) give every pellet's direction, the same on both sides, so a
	  client can't choose its own spread. Reload(magazine, carried, itemId) moves whole shots
	  from the player's carried ammo into the magazine, AmmoPerShot each (Section 9).
	* Hits (Section 23): a claimed hit must sit near the shot's ray, within the gun's range, and
	  near where the target was over the last LagSeconds (PathDistance over its position
	  history). The server checks the line of sight itself.
	* Melee: InArc (reach and arc in front of the attacker); the light combo's next step
	  (ComboSteps hits, each within ComboWindowSeconds of the last); Swing(itemId, heavy) gives
	  the windup (MeleeWindupFraction of the swing, when the hit lands) and the length (a heavy
	  swing takes HeavySwingMultiplier times as long and costs HeavySwingStamina).
	* Cones (the flamethrower's flame, aim assist): InCone, AssistTarget.
	* Stamina(current, max, dt, sprinting, sinceSpent): sprinting drains it; it grows back after
	  StaminaRegenDelay without spending.
	* Nearest(from, places): the closest place (the respawn Medbay).
]]

local Config = require(script.Parent.Parent.Config)

export type Sample = { T: number, P: Vector3 }
export type Place = { Id: string, Position: Vector3 }

local Combat = {}

Combat.UNARMED = "Unarmed"

local function tuning(): { [string]: any }
	return Config.Get("Tuning", "Combat")
end
Combat.Tuning = tuning

-- Items ------------------------------------------------------------------------------------

function Combat.Gun(itemId: string?): { [string]: any }?
	local item = Config.Find("Items", itemId)
	return if item and item.Kind == "Gun" then item.Gun else nil
end

-- A melee weapon's numbers; "Unarmed" is a punch, for kits with no melee weapon.
function Combat.Melee(itemId: string?): { [string]: any }?
	if itemId == Combat.UNARMED then
		return tuning().Unarmed
	end
	local item = Config.Find("Items", itemId)
	return if item and item.Kind == "Melee" then item.Melee else nil
end

function Combat.RarityMultiplier(rarity: string?): number
	local found = Config.Find("ItemRarities", rarity or "Standard")
	return if found then found.DamageMultiplier else 1
end

-- Damage of one hit (one pellet, one flame tick, one swing).
function Combat.Damage(itemId: string, rarity: string?, heavy: boolean?): number
	local gun = Combat.Gun(itemId)
	if gun then
		return gun.Damage * Combat.RarityMultiplier(rarity)
	end
	local melee = Combat.Melee(itemId)
	if melee then
		return (if heavy then melee.HeavyDamage else melee.Damage) * Combat.RarityMultiplier(rarity)
	end
	return 0
end

-- Guns -------------------------------------------------------------------------------------

function Combat.Interval(itemId: string): number
	local gun = Combat.Gun(itemId)
	return if gun and gun.FireRate > 0 then 1 / gun.FireRate else math.huge
end

function Combat.Pellets(itemId: string): number
	local gun = Combat.Gun(itemId)
	return if gun then gun.Pellets or 1 else 0
end

-- A shot's seed from the player's salt (given by the server when the gun is handed out) and the
-- shot's number, so the spread is fixed before the client fires.
function Combat.ShotSeed(salt: number, shot: number): number
	local mixed = bit32.bxor(salt % 2 ^ 31, (shot * 2654435761) % 2 ^ 32)
	return mixed % 2 ^ 31
end

-- A direction turned by `degrees` around an axis at `roll` radians about it.
local function deflect(direction: Vector3, degrees: number, roll: number): Vector3
	if degrees <= 0 then
		return direction
	end
	local d = direction.Unit
	local helper = if math.abs(d.Y) < 0.95 then Vector3.yAxis else Vector3.xAxis
	local right = d:Cross(helper).Unit
	local up = right:Cross(d).Unit
	local axis = right * math.cos(roll) + up * math.sin(roll)
	local angle = math.rad(degrees)
	-- Rodrigues: rotate d about the axis (perpendicular to d)
	return (d * math.cos(angle) + axis:Cross(d) * math.sin(angle)).Unit
end

-- Each pellet's direction: spread evenly over a disc of SpreadDegrees around the aim.
function Combat.Spread(seed: number, direction: Vector3, itemId: string): { Vector3 }
	local gun = Combat.Gun(itemId)
	if not gun then
		return {}
	end
	local rng = Random.new(seed)
	local out = {}
	for _ = 1, gun.Pellets or 1 do
		local degrees = gun.SpreadDegrees * math.sqrt(rng:NextNumber())
		local roll = rng:NextNumber() * 2 * math.pi
		table.insert(out, deflect(direction, degrees, roll))
	end
	return out
end

-- Whole shots loaded from carried ammo: the new magazine and what is left carried.
function Combat.Reload(magazine: number, carried: number, itemId: string): (number, number)
	local gun = Combat.Gun(itemId)
	if not gun then
		return magazine, carried
	end
	local per = math.max(gun.AmmoPerShot, 1)
	local room = math.max(gun.Magazine - magazine, 0)
	local shots = math.min(room, math.floor(carried / per))
	return magazine + shots, carried - shots * per
end

-- Hits -------------------------------------------------------------------------------------

-- How far a point is from a ray (perpendicular), and how far along the ray it is.
function Combat.RayDistance(origin: Vector3, direction: Vector3, point: Vector3): (number, number)
	local d = direction.Unit
	local offset = point - origin
	local along = offset:Dot(d)
	local closest = origin + d * math.max(along, 0)
	return (point - closest).Magnitude, along
end

-- Where a combatant was at time `t`, from its history (oldest first).
function Combat.PositionAt(history: { Sample }, t: number): Vector3?
	local count = #history
	if count == 0 then
		return nil
	end
	if t <= history[1].T then
		return history[1].P
	end
	if t >= history[count].T then
		return history[count].P
	end
	for i = 2, count do
		local b = history[i]
		if b.T >= t then
			local a = history[i - 1]
			local span = b.T - a.T
			local alpha = if span > 0 then (t - a.T) / span else 1
			return a.P:Lerp(b.P, alpha)
		end
	end
	return history[count].P
end

-- The nearest a point came to a combatant between `from` and `to` (its path over that time).
function Combat.PathDistance(history: { Sample }, from: number, to: number, point: Vector3): number
	local best = math.huge
	local start = Combat.PositionAt(history, from)
	if start then
		best = (start - point).Magnitude
	end
	local finish = Combat.PositionAt(history, to)
	if finish then
		best = math.min(best, (finish - point).Magnitude)
	end
	for _, sample in history do
		if sample.T >= from and sample.T <= to then
			best = math.min(best, (sample.P - point).Magnitude)
		end
	end
	return best
end

-- Is a claimed hit believable? `reach` is how far the target's body goes from its centre.
-- Returns false and why when it isn't.
function Combat.CheckHit(
	origin: Vector3,
	direction: Vector3,
	point: Vector3,
	range: number,
	history: { Sample },
	from: number,
	to: number,
	reach: number
): (boolean, string?)
	local t = tuning()
	local off, along = Combat.RayDistance(origin, direction, point)
	if along < -t.RayTolerance then
		return false, "behind the shot"
	elseif along > range + t.RayTolerance then
		return false, "out of range"
	elseif off > t.RayTolerance then
		return false, "off the shot's line"
	end
	if #history > 0 and Combat.PathDistance(history, from, to, point) > reach + t.HitTolerance then
		return false, "not where the target was"
	end
	return true, nil
end

-- Cones and arcs ---------------------------------------------------------------------------

-- Is a point (with a body of `radius`) in a cone of `halfDegrees` around the direction, within
-- `range`?
function Combat.InCone(origin: Vector3, direction: Vector3, point: Vector3, range: number, halfDegrees: number, radius: number?): boolean
	local offset = point - origin
	local distance = offset.Magnitude
	local r = radius or 0
	if distance - r > range then
		return false
	end
	if distance <= r or distance < 1e-6 then
		return true
	end
	local cos = offset.Unit:Dot(direction.Unit)
	local angle = math.deg(math.acos(math.clamp(cos, -1, 1)))
	local widen = math.deg(math.atan2(r, distance)) -- the body's own width
	return angle <= halfDegrees + widen
end

-- Is a point (with a body of `radius`) inside a swing: within reach of the attacker and inside
-- the arc in front of it (judged flat, and no higher or lower than the reach)?
function Combat.InArc(attacker: CFrame, point: Vector3, reach: number, arcDegrees: number, radius: number?): boolean
	local r = radius or 0
	local offset = point - attacker.Position
	if math.abs(offset.Y) > reach + r then
		return false
	end
	local flat = Vector3.new(offset.X, 0, offset.Z)
	local distance = flat.Magnitude
	if distance - r > reach then
		return false
	end
	if distance <= r or distance < 1e-6 then
		return true
	end
	local look = Vector3.new(attacker.LookVector.X, 0, attacker.LookVector.Z)
	if look.Magnitude < 1e-6 then
		return true
	end
	local cos = flat.Unit:Dot(look.Unit)
	local angle = math.deg(math.acos(math.clamp(cos, -1, 1)))
	local widen = math.deg(math.atan2(r, distance))
	return angle <= arcDegrees / 2 + widen
end

-- The target aim assist pulls toward: the one closest to the aim within `maxDegrees`.
-- Returns its index and how far off the aim it is (degrees), or nil.
function Combat.AssistTarget(origin: Vector3, look: Vector3, points: { Vector3 }, maxDegrees: number, range: number): (number?, number)
	local best, bestAngle = nil, math.huge
	for i, point in points do
		local offset = point - origin
		local distance = offset.Magnitude
		if distance > 1e-3 and distance <= range then
			local angle = math.deg(math.acos(math.clamp(offset.Unit:Dot(look.Unit), -1, 1)))
			if angle <= maxDegrees and angle < bestAngle then
				best, bestAngle = i, angle
			end
		end
	end
	return best, bestAngle
end

-- Melee --------------------------------------------------------------------------------------

-- The light combo's next step: the next hit if the last one landed within the window,
-- otherwise the first again.
function Combat.NextCombo(lastStep: number, sinceLast: number): number
	local t = tuning()
	if lastStep >= 1 and lastStep < t.ComboSteps and sinceLast <= t.ComboWindowSeconds then
		return lastStep + 1
	end
	return 1
end

-- A swing's windup (when its hit lands) and its whole length, in seconds.
function Combat.Swing(itemId: string, heavy: boolean?): (number, number)
	local melee = Combat.Melee(itemId)
	if not melee then
		return 0, 0
	end
	local t = tuning()
	local length = melee.SwingSeconds * (if heavy then t.HeavySwingMultiplier else 1)
	return length * t.MeleeWindupFraction, length
end

-- Stamina ------------------------------------------------------------------------------------

-- Stamina after `dt` seconds: sprinting drains SprintStaminaPerSecond; otherwise it grows back
-- at StaminaRegenPerSecond once StaminaRegenDelay has passed since it was last spent.
function Combat.Stamina(current: number, max: number, dt: number, sprinting: boolean, sinceSpent: number): number
	local player = Config.Get("Tuning", "Player")
	if sprinting then
		return math.max(current - player.SprintStaminaPerSecond * dt, 0)
	end
	local t = tuning()
	if sinceSpent < t.StaminaRegenDelay then
		return current
	end
	return math.min(current + player.StaminaRegenPerSecond * dt, max)
end

-- Respawn ------------------------------------------------------------------------------------

function Combat.Nearest(from: Vector3, places: { Place }): Place?
	local best, bestDistance = nil, math.huge
	for _, place in places do
		local distance = (place.Position - from).Magnitude
		if distance < bestDistance or (distance == bestDistance and best and place.Id < best.Id) then
			best, bestDistance = place, distance
		end
	end
	return best
end

return Combat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A3"><Properties><string name="Name">CommandView</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.CommandView: the Command View's arithmetic and build-menu rules (bible Section 7),
	pure so the data tests can check them.

	* The view is a far camera with a narrow field of view, so the bunker looks nearly flat.
	  VisibleHeight and DistanceFor convert between the camera's distance and how many studs
	  fit on screen; Lens caps the distance (the lowest graphics level draws about 500 studs)
	  and widens the field of view past it; CellBox is a cell's interior; Bounds and Clamp keep
	  the view over the grid.
	* RoomChoice says whether a room type can be proposed on an open cell, and why not: its
	  unlock (Rules.Construction.Unlock: start, a blueprint draft, a draft or a depth, an era,
	  the first cryo pod), then the placement rules (Rules.Bunker.CanPlace).
	* CostText: "120 SCRAP · 20 IRON", in Config.Resources order (Rules.Construction).
]]

local Config = require(script.Parent.Parent.Config)
local Construction = require(script.Parent.Construction)
local Grid = require(script.Parent.Grid)

export type Bounds = { Left: number, Right: number, Top: number, Bottom: number }
export type Context = {
	Era: number, -- the current era's place in Config.Eras (1 to 4)
	Deepest: number, -- the deepest open floor
	Unlocked: { [string]: boolean }?, -- room types won from drafts or cryo pods
}

local CommandView = {}

function CommandView.Tuning(): { [string]: any }
	return Config.Get("Tuning", "CommandView")
end

function CommandView.VisibleHeight(distance: number, fieldOfView: number): number
	return 2 * distance * math.tan(math.rad(fieldOfView) / 2)
end

function CommandView.DistanceFor(height: number, fieldOfView: number): number
	return height / (2 * math.tan(math.rad(fieldOfView) / 2))
end

-- The camera for a visible height (studs at the cells' plane): the narrow field of view while
-- that fits within MaxDistance, then MaxDistance with a wider field of view. Roblox stops drawing
-- parts about 500 studs away at the lowest graphics level, so a farther camera shows nothing on
-- phones set to low graphics.
function CommandView.Lens(height: number): (number, number)
	local t = CommandView.Tuning()
	local distance = CommandView.DistanceFor(height, t.FieldOfView)
	if distance <= t.MaxDistance then
		return distance, t.FieldOfView
	end
	return t.MaxDistance, 2 * math.deg(math.atan(height / 2 / t.MaxDistance))
end

-- A cell's box in world studs: Grid.CellPosition is the centre of its interior floor, so the
-- interior runs from that floor up to the ceiling (CellHeight).
function CommandView.CellBox(floor: number, column: number, span: number?): (Vector2, Vector2)
	local pitch = Grid.Pitch()
	local first = Grid.CellPosition(floor, column)
	local last = Grid.CellPosition(floor, column + (span or 1) - 1)
	return Vector2.new(first.X - pitch.X / 2, first.Y), Vector2.new(last.X + pitch.X / 2, first.Y + Grid.Tuning().CellHeight)
end

-- The grid's outer edges in world studs: the top floor's ceiling to the slab under the bottom floor.
function CommandView.Bounds(): Bounds
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local topLeft = Grid.CellPosition(t.FloorMin, t.ColumnMin)
	local bottomRight = Grid.CellPosition(t.FloorMax, t.ColumnMax)
	return {
		Left = topLeft.X - pitch.X / 2,
		Right = bottomRight.X + pitch.X / 2,
		Top = topLeft.Y + t.CellHeight,
		Bottom = bottomRight.Y - t.SlabThickness,
	}
end

-- Keeps the view's centre (world X and Y) over the grid.
function CommandView.Clamp(center: Vector2, bounds: Bounds): Vector2
	return Vector2.new(math.clamp(center.X, bounds.Left, bounds.Right), math.clamp(center.Y, bounds.Bottom, bounds.Top))
end

-- Can `roomType` be proposed on an open cell? Its unlock (Rules.Construction.Unlock), then the
-- placement rules (Rules.Bunker.CanPlace). The server checks the same with Construction.Plan.
function CommandView.RoomChoice(bunker: any, roomType: string, floor: number, column: number, context: Context): (boolean, string?)
	local ok, why = Construction.Unlock(roomType, context)
	if not ok then
		return false, why
	end
	return bunker:CanPlace(roomType, floor, column, 1)
end

CommandView.CostText = Construction.CostText

return CommandView
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A4"><Properties><string name="Name">Construction</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Construction: what a construction proposal needs and how long a build takes (bible
	Sections 6 and 8). Pure, so BuildService, the Command View and the data tests share it.

	* Actions:
	  * Build: a room on an open cell, paying its level-1 costs.
	  * Upgrade: the next level's costs for every cell of the room; level 3 also needs Lab
	    research (a threshold the Lab reaches, not spent).
	  * Merge: a room with a matching neighbour (free).
	  * TearDown: a room goes and its cells become open cells (free). Part of what the room cost
	    comes back (Landon, Nov 8, 2026): Tuning.Rooms.TearDownRefund of every level's cost so
	    far, per cell (Refund). Lab research doesn't come back.
	* Unlocks (Section 6), for Build: Start; a blueprint draft; a draft or reaching depth N; an
	  era; the first cryo pod. Rooms won from drafts or cryo pods come in `Context.Unlocked`.
	* Reserved cells: a cell in an open vote or under construction can't be in another
	  proposal.
	* Construction time: BuildSecondsPerCell (20) for each cell. Each helper nearby adds
	  HelperBuildSpeed (25%) to the speed (players now, residents with Prompt 10).
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)
local Hud = require(script.Parent.Hud)

export type Action = "Build" | "Upgrade" | "Merge" | "TearDown"
export type Proposal = {
	Action: Action,
	Floor: number,
	Column: number,
	RoomType: string?, -- Build
	Other: string?, -- Merge: the room it joins
}
export type Context = {
	Era: number, -- the current era's place in Config.Eras (1 to 4)
	Deepest: number, -- the deepest open floor
	Unlocked: { [string]: boolean }?, -- room types won from drafts or cryo pods
	Stock: { [string]: number }?, -- the stockpile; nil skips the cost check
	Research: number?, -- Lab research so far; nil skips the research check
	Reserved: { [string]: boolean }?, -- cell keys in open votes or under construction
}
export type Plan = {
	Action: Action,
	Floor: number,
	Column: number,
	Span: number, -- the cells it covers (a merge: both rooms)
	RoomType: string, -- what it builds or changes
	RoomId: string?, -- the room it changes
	Other: string?, -- Merge: the other room
	Level: number?, -- Upgrade: the new level
	Costs: { [string]: number },
	Research: number?, -- Upgrade to level 3: the research it needs
	Refund: { [string]: number }?, -- TearDown: what comes back
	Label: string, -- "KITCHEN", "QUARTERS TO LEVEL 2", "MERGE STORAGE", "TEAR DOWN MEDBAY"
}

local Construction = {}

local function rooms(): { [string]: any }
	return Config.Get("Tuning", "Rooms")
end

local function nameOf(roomType: string): string
	local info = Config.Find("Rooms", roomType)
	return if info then info.Name else roomType
end

function Construction.Seconds(span: number): number
	return rooms().BuildSecondsPerCell * span
end

-- How fast a site builds with `helpers` nearby (1 alone, 1.25 with one helper...).
function Construction.Rate(helpers: number): number
	return 1 + rooms().HelperBuildSpeed * math.max(0, helpers)
end

-- A room type's costs at `level` (1 to 3) for `span` cells (Config.Rooms costs are per cell,
-- like HP and power, so a merged room pays for every cell it upgrades).
function Construction.CostsAt(roomType: string, level: number, span: number?): { [string]: number }
	local costs = {}
	for id, amount in Config.Get("Rooms", roomType).Costs[level] or {} do
		costs[id] = amount * (span or 1)
	end
	return costs
end

-- What tearing a room down gives back: a share (Tuning.Rooms.TearDownRefund) of every level's
-- cost so far, per cell, rounded down. Lab research isn't given back.
function Construction.Refund(roomType: string, level: number, span: number): { [string]: number }
	local total: { [string]: number } = {}
	for l = 1, level do
		for id, amount in Construction.CostsAt(roomType, l, span) do
			total[id] = (total[id] or 0) + amount
		end
	end
	local share = rooms().TearDownRefund
	local refund: { [string]: number } = {}
	for id, amount in total do
		local back = math.floor(amount * share)
		if back > 0 then
			refund[id] = back
		end
	end
	return refund
end

-- Research needed to upgrade a room type to `level`: its Research for level 3, else none.
function Construction.ResearchFor(roomType: string, level: number): number
	if level >= 3 then
		return Config.Get("Rooms", roomType).Research or 0
	end
	return 0
end

-- Can `stock` pay `costs`? If not, the first short resource and how much is missing.
function Construction.CanAfford(costs: { [string]: number }, stock: { [string]: number }): (boolean, string?, number?)
	for _, id in Config.Ids("Resources") do
		local amount = costs[id]
		if amount and amount > 0 and (stock[id] or 0) < amount then
			return false, id, amount - (stock[id] or 0)
		end
	end
	return true, nil, nil
end

-- "120 SCRAP · 20 IRON" in Config.Resources order, or "FREE".
function Construction.CostText(costs: { [string]: number }?): string
	local parts = {}
	for _, id in Config.Ids("Resources") do
		local amount = if costs then costs[id] else nil
		if amount and amount > 0 then
			table.insert(parts, `{amount} {string.upper(Config.Get("Resources", id).Name)}`)
		end
	end
	return if #parts > 0 then table.concat(parts, " · ") else "FREE"
end

-- Is a room type unlocked for building? If not, what unlocks it.
function Construction.Unlock(roomType: string, context: Context): (boolean, string?)
	local unlock = Config.Get("Rooms", roomType).Unlock
	local won = context.Unlocked ~= nil and context.Unlocked[roomType] == true
	if unlock.Kind == "Draft" and not won then
		return false, "Unlock: a blueprint draft"
	elseif unlock.Kind == "DraftOrDepth" and not won and context.Deepest < (unlock.Depth or 10) then
		return false, `Unlock: a blueprint draft, or reach depth {unlock.Depth}`
	elseif unlock.Kind == "Era" and context.Era < (unlock.Era or 1) then
		return false, `Unlock: Era {Hud.Numeral(unlock.Era or 1)}`
	elseif unlock.Kind == "CryoPod" and not won then
		return false, "Unlock: find the first cryo pod"
	end
	return true, nil
end

local function reservedRoom(bunker: any, roomId: string, reserved: { [string]: boolean }?): boolean
	if not reserved then
		return false
	end
	local room = bunker:Room(roomId)
	if room then
		for offset = 0, room.Span - 1 do
			if reserved[Grid.Key(room.Floor, room.Column + offset)] then
				return true
			end
		end
	end
	return false
end

-- Checks a proposal against the bunker and the context. Returns the plan, or nil and why not
-- (a sentence for the player).
function Construction.Plan(bunker: any, proposal: Proposal, context: Context): (Plan?, string?)
	local floor, column = proposal.Floor, proposal.Column
	if not Grid.OnGrid(floor, column) then
		return nil, "That cell is off the grid."
	end
	local plan: Plan
	if proposal.Action == "Build" then
		local roomType = proposal.RoomType
		if not roomType or not Config.Find("Rooms", roomType) then
			return nil, "That isn't a room type."
		end
		local info = Config.Get("Rooms", roomType)
		if info.Fixed then
			return nil, `The {info.Name} comes with the bunker.`
		end
		if context.Reserved and context.Reserved[Grid.Key(floor, column)] then
			return nil, "Something is already proposed or being built there."
		end
		local unlocked, why = Construction.Unlock(roomType, context)
		if not unlocked then
			return nil, `{info.Name}: {why}.`
		end
		local ok, reason = bunker:CanPlace(roomType, floor, column, 1)
		if not ok then
			return nil, `Can't build a {info.Name} there: {reason}.`
		end
		plan = {
			Action = "Build", Floor = floor, Column = column, Span = 1, RoomType = roomType,
			Costs = Construction.CostsAt(roomType, 1), Label = string.upper(info.Name),
		}
	else
		local room = bunker:RoomAt(floor, column)
		if not room then
			return nil, "There's no room there."
		end
		if reservedRoom(bunker, room.Id, context.Reserved) then
			return nil, `The {nameOf(room.Type)} already has a proposal open.`
		end
		local name = nameOf(room.Type)
		if proposal.Action == "Upgrade" then
			if room.Level >= 3 then
				return nil, `The {name} is at level 3 already.`
			end
			local level = room.Level + 1
			plan = {
				Action = "Upgrade", Floor = room.Floor, Column = room.Column, Span = room.Span, RoomType = room.Type,
				RoomId = room.Id, Level = level, Costs = Construction.CostsAt(room.Type, level, room.Span),
				Research = Construction.ResearchFor(room.Type, level), Label = `{string.upper(name)} TO LEVEL {level}`,
			}
			local needs = plan.Research or 0
			if needs > 0 and context.Research ~= nil and context.Research < needs then
				return nil, `Level 3 needs {needs} Lab research ({math.floor(context.Research)} so far).`
			end
		elseif proposal.Action == "Merge" then
			local other = if proposal.Other then bunker:Room(proposal.Other) else nil
			if not other then
				return nil, "There's no room to merge with."
			end
			if reservedRoom(bunker, other.Id, context.Reserved) then
				return nil, `The other {nameOf(other.Type)} already has a proposal open.`
			end
			local ok, why = bunker:CanMerge(room.Id, other.Id)
			if not ok then
				return nil, `Can't merge: {why}.`
			end
			plan = {
				Action = "Merge", Floor = room.Floor, Column = math.min(room.Column, other.Column),
				Span = room.Span + other.Span, RoomType = room.Type, RoomId = room.Id, Other = other.Id,
				Costs = {}, Label = `MERGE {string.upper(name)}`,
			}
		elseif proposal.Action == "TearDown" then
			local ok, why = bunker:CanRemove(room.Id)
			if not ok then
				return nil, `Can't tear down the {name}: {why}.`
			end
			plan = {
				Action = "TearDown", Floor = room.Floor, Column = room.Column, Span = room.Span, RoomType = room.Type,
				RoomId = room.Id, Costs = {}, Refund = Construction.Refund(room.Type, room.Level, room.Span),
				Label = `TEAR DOWN {string.upper(name)}`,
			}
		else
			return nil, "That isn't something to propose."
		end
	end
	if context.Stock then
		local ok, short, missing = Construction.CanAfford(plan.Costs, context.Stock)
		if not ok and short then
			return nil, `The stockpile is {missing} {Config.Get("Resources", short).Name} short.`
		end
	end
	return plan, nil
end

-- The cells a plan covers, as keys.
function Construction.Cells(plan: Plan): { string }
	local keys = {}
	for offset = 0, plan.Span - 1 do
		table.insert(keys, Grid.Key(plan.Floor, plan.Column + offset))
	end
	return keys
end

return Construction
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A5"><Properties><string name="Name">Dig</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Dig: digging, the dug cell's roll, Push Deeper and Disturbance as arithmetic (bible
	Sections 6 and 10). Pure, so DigService, the Command View, the HUD and the data tests agree.
	The numbers are Tuning.Digging, Tuning.Disturbance, Config.DepthBands (dig seconds per band)
	and Config.DigResults (the roll); provisional ones are marked there.

	* Digging (Section 6): a Rock cell left of, right of or below an open cell can be dug
	  (Rules.Bunker.CanDig) from that cell: Faces. Players hold Interact with a Drill or a
	  Pickaxe (CanDigWith); a cell takes its band's DigSeconds; the Driller digs twice as fast
	  (DigSpeed) and players on one cell stack (Rate). A Drill Bay digs its queue at
	  ResidentDigMultiplier of a player for each unit of its crew's output (DrillBaySpeed).
	* Push Deeper (Section 6): the first cell of a new band (floors 4, 7 and 10) needs a vote.
	  Cells down to Limit can be dug without one: the last floor of the Mines at the start, the
	  last floor of each band the team has voted into after that (LimitAfter).
	* The roll (Section 6: rolled when it opens): Roll is the same for a cell every time in one
	  run (seeded by the run and the cell), so the Driller can see ore and caves before they are
	  dug (Hint). Results whose systems aren't built yet, and those of a later era, count as
	  Empty, so the others keep the bible's odds.
	* Disturbance (Section 10): 0 to Max; Add clamps; Crossed says whether a change set off the
	  extra breach (crossing ExtraBreachAt upward) or a Tremor (reaching TremorAt, after which it
	  drops to AfterTremor). Level names the reading for the seismograph.
]]

local Config = require(script.Parent.Parent.Config)
local Grid = require(script.Parent.Grid)

local Dig = {}

export type Face = { Side: "Left" | "Right" | "Above", Floor: number, Column: number } -- the open cell it's dug from

function Dig.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Digging")
end

function Dig.DisturbanceTuning(): { [string]: any }
	return Config.Get("Tuning", "Disturbance")
end

-- Digging ------------------------------------------------------------------------------------

-- Seconds for one player to dig a cell on this floor (Config.DepthBands).
function Dig.Seconds(floor: number): number
	return Grid.BandOf(floor).DigSeconds or 45
end

-- Does what a player carries dig? (a Drill or a Pickaxe)
function Dig.CanDigWith(items: { string }): boolean
	local tools = Dig.Tuning().Tools
	for _, id in items do
		if table.find(tools, id) then
			return true
		end
	end
	return false
end

-- Progress a second (0 to 1 is the whole cell) for diggers with these speeds (1 = a player, the
-- Driller 2): stacked, or the fastest alone when StackPlayers is off.
function Dig.Rate(speeds: { number }, floor: number): number
	local total = 0
	for _, speed in speeds do
		if Dig.Tuning().StackPlayers then
			total += speed
		else
			total = math.max(total, speed)
		end
	end
	return total / Dig.Seconds(floor)
end

-- A Drill Bay's digging speed in players, from its output rate (Rules.Economy) and its Base.
function Dig.DrillBaySpeed(rate: number, base: number): number
	if rate <= 0 or base <= 0 then
		return 0
	end
	return Dig.Tuning().ResidentDigMultiplier * rate / base
end

-- The open cells a rock cell can be dug from: beside it on its floor, or above it.
function Dig.Faces(bunker: any, floor: number, column: number): { Face }
	local faces: { Face } = {}
	if bunker:State(floor, column) ~= "Rock" then
		return faces
	end
	if bunker:IsOpen(floor, column - 1) then
		table.insert(faces, { Side = "Left", Floor = floor, Column = column - 1 })
	end
	if bunker:IsOpen(floor, column + 1) then
		table.insert(faces, { Side = "Right", Floor = floor, Column = column + 1 })
	end
	if bunker:IsOpen(floor - 1, column) then
		table.insert(faces, { Side = "Above", Floor = floor - 1, Column = column })
	end
	return faces
end

-- Where a face's dig prompt stands: on the wall line at chest height for a side, on the floor of
-- the cell above (towards the front) for digging down.
function Dig.FacePoint(face: Face, floor: number, column: number): Vector3
	local from = Grid.CellPosition(face.Floor, face.Column)
	if face.Side == "Above" then
		return from + Vector3.new(0, 1, Grid.Tuning().CellDepth / 4)
	end
	local rock = Grid.CellPosition(floor, column)
	return Vector3.new((from.X + rock.X) / 2, from.Y + 3.5, from.Z)
end

-- Push Deeper -----------------------------------------------------------------------------------

-- The deepest floor the team may dig to without a vote at the start: the first band's last.
function Dig.StartLimit(): number
	return Grid.BandOf(Grid.Tuning().FloorMin).Floors.To
end

-- After a Push Deeper vote into this floor's band: its last floor.
function Dig.LimitAfter(floor: number): number
	return Grid.BandOf(floor).Floors.To
end

function Dig.NeedsVote(floor: number, limit: number): boolean
	return floor > limit
end

-- The roll -----------------------------------------------------------------------------------------

-- The same Random for a cell every time in one run.
function Dig.CellRandom(seed: number, floor: number, column: number): Random
	local n = (math.floor(seed) * 92821 + floor * 1000003 + (column + 64) * 7919) % 2147483647
	return Random.new(n)
end

-- What opening this cell finds. `available` names the results that can happen now (systems
-- built); the rest, and those of a later era, are Empty.
function Dig.Roll(seed: number, floor: number, column: number, era: number, available: { [string]: boolean }): string
	local rng = Dig.CellRandom(seed, floor, column)
	local total = 0
	for _, entry in Config.All("DigResults") do
		total += entry.Chance
	end
	local pick = rng:NextNumber() * total
	for _, id in Config.Ids("DigResults") do
		local entry = Config.Get("DigResults", id)
		pick -= entry.Chance
		if pick <= 0 then
			if available[id] and era >= (entry.MinEra or 1) then
				return id
			end
			return "Empty"
		end
	end
	return "Empty"
end

-- What the Driller sees in rock before it is dug (Section 14: ore and caves): the roll when it is
-- an ore pocket or a cave opening, else nil.
function Dig.Hint(seed: number, floor: number, column: number, era: number, available: { [string]: boolean }): string?
	local result = Dig.Roll(seed, floor, column, era, available)
	return if result == "OrePocket" or result == "CaveOpening" then result else nil
end

-- How far into rock a cell is: steps from the nearest open cell (left, right, up, down), up to max.
function Dig.Depth(bunker: any, floor: number, column: number, max: number): number?
	for d = 1, max do
		for df = -d, d do
			local dc = d - math.abs(df)
			for _, c in { column - dc, column + dc } do
				if bunker:IsOpen(floor + df, c) then
					return d
				end
			end
		end
	end
	return nil
end

-- Disturbance -------------------------------------------------------------------------------------

function Dig.AddDisturbance(value: number, amount: number): number
	return math.clamp(value + amount, 0, Dig.DisturbanceTuning().Max)
end

-- What a change from `before` to `after` sets off.
function Dig.Crossed(before: number, after: number): (boolean, boolean)
	local t = Dig.DisturbanceTuning()
	local extra = before < t.ExtraBreachAt and after >= t.ExtraBreachAt and after < t.TremorAt
	local tremor = after >= t.TremorAt
	return extra, tremor
end

function Dig.AfterTremor(): number
	return Dig.DisturbanceTuning().AfterTremor
end

-- The seismograph's reading: CALM, RISING, UNSETTLED or DANGER, by quarters of the meter.
function Dig.Level(value: number): string
	local t = Dig.DisturbanceTuning()
	local fraction = value / t.Max
	if fraction < 0.25 then
		return "CALM"
	elseif fraction < t.ExtraBreachAt / t.Max then
		return "RISING"
	elseif fraction < 0.75 then
		return "UNSETTLED"
	end
	return "DANGER"
end

return table.freeze(Dig)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A6"><Properties><string name="Name">Disasters</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Disasters: the arithmetic of disasters and repairs (bible Sections 6 and 10). Pure, so
	DisasterService and BuildService on the server, the HUD and the Command View on the client
	and the data tests share it. Prompt 13. Numbers: Config.Disasters (each disaster's own) and
	Tuning.Disasters / Tuning.Repairs (the rules), all provisional.

	* Fire: a room burns with a strength from 0 to 100. It grows on its own; residents in the
	  room beat it down; an Extinguisher sprays it down faster; at 0 it is out. Room damage,
	  and the harm to residents and players inside, scale with strength. Every SpreadSeconds
	  (15; FireSpread multipliers slow it) a fire strong enough spreads to a room next door
	  through a doorway; the Shaft doesn't burn, so fires stay on their floor.
	* The Surge's one disaster (Section 5): a weighted pick among the disasters a Surge causes
	  (Config.Disasters SurgeWeight), of this era and before, that the budget can pay for.
	* Blackout: a floor, or the whole grid, dark for DurationSeconds (BlackoutDuration
	  multipliers), unless the fuse box in the Reactor Core is reset first.
	* The meltdown (Section 10's Reactor overload; Landon): three valves turned together stop
	  it. A turned valve counts while its player holds it; with SoloPlayers or fewer in the run,
	  a turned valve stays turned SoloValveSeconds.
	* Cave-in: rubble blocks a doorway (the passage between two units side by side) or fills a
	  dug cell (a tunnel: every passage into it). Melee smashes it, more with weapons that break
	  rubble; a Drill or a Pickaxe digs through it.
	* Repairs (Section 6): the Welder repairs WelderPerSecond (RepairSpeed: the Engineer twice
	  as fast); a worker in the room ResidentRepairPerSecond times Smarts over
	  ResidentSmartsBase (Section 11: Smarts is repair speed).
]]

local Config = require(script.Parent.Parent.Config)

local Disasters = {}

export type Shape = "Doorway" | "Tunnel"

-- A valve held by a player right now (a turned valve otherwise stores until when, server time).
Disasters.HELD = -1

function Disasters.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Disasters")
end

function Disasters.Repairs(): { [string]: any }
	return Config.Get("Tuning", "Repairs")
end

-- Fire ----------------------------------------------------------------------------------------

-- A fire's strength after dt seconds: it grows, `residents` beat it down, `extinguish` (strength a
-- second from Extinguishers) sprays it down. 0 is out.
function Disasters.FireStep(strength: number, dt: number, residents: number, extinguish: number?): number
	local f = Disasters.Tuning().Fire
	local change = f.GrowPerSecond - residents * f.ResidentPerSecond - (extinguish or 0)
	return math.clamp(strength + change * dt, 0, 100)
end

-- HP a burning room loses in dt seconds.
function Disasters.FireRoomDamage(strength: number, dt: number): number
	return (Config.Get("Disasters", "Fire").RoomDamagePerSecond or 0) * strength / 100 * dt
end

-- Health a player inside loses in dt seconds; `taken` is their FireFloodDamageTaken (the
-- Firefighter's 0.25).
function Disasters.FirePlayerDamage(strength: number, dt: number, taken: number?): number
	return Disasters.Tuning().Fire.PlayerDamagePerSecond * strength / 100 * dt * (taken or 1)
end

function Disasters.FireResidentDamage(strength: number, dt: number): number
	return Disasters.Tuning().Fire.ResidentDamagePerSecond * strength / 100 * dt
end

-- Seconds between a fire's spreads (Section 10: every 15 s). FireSpread multipliers below 1
-- slow it: 0.5 is "50% slower", 30 s.
function Disasters.SpreadSeconds(spread: number?): number
	return (Config.Get("Disasters", "Fire").SpreadSeconds or 15) / math.max(spread or 1, 0.05)
end

function Disasters.CanSpread(strength: number): boolean
	return strength >= Disasters.Tuning().Fire.SpreadMinStrength
end

function Disasters.Burns(roomType: string): boolean
	return table.find(Disasters.Tuning().Fire.Fireproof, roomType) == nil
end

-- The rooms a fire in `roomId` can spread to: rooms through a doorway (never dug cells, never
-- up or down: the Shaft doesn't burn) that burn and aren't burning yet. Sorted.
function Disasters.SpreadTargets(bunker: any, roomId: string, burning: { [string]: any }): { string }
	local list = {}
	for _, other in bunker:Neighbors(roomId) do
		local room = bunker:Room(other)
		if room and burning[other] == nil and Disasters.Burns(room.Type) then
			table.insert(list, other)
		end
	end
	table.sort(list)
	return list
end

-- The Surge's disaster -------------------------------------------------------------------------

-- Section 5: every Surge brings one disaster. A weighted pick among the disasters with a
-- SurgeWeight, of era `era` and before, whose ThreatCost `budget` covers; nil when none fits.
function Disasters.SurgePick(era: number, budget: number, rng: Random): string?
	local options: { string } = {}
	local total = 0
	for _, id in Config.Ids("Disasters") do
		local d = Config.Get("Disasters", id)
		if (d.SurgeWeight or 0) > 0 and d.Era <= era and d.ThreatCost <= budget then
			table.insert(options, id)
			total += d.SurgeWeight
		end
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, id in options do
		roll -= Config.Get("Disasters", id).SurgeWeight
		if roll <= 0 then
			return id
		end
	end
	return options[#options]
end

-- Blackouts ------------------------------------------------------------------------------------

-- How long a blackout lasts (BlackoutDuration multipliers: Insulated Grid's 0.5 halves it).
function Disasters.BlackoutSeconds(duration: number?): number
	return (Config.Get("Disasters", "Blackout").DurationSeconds or 60) * math.max(duration or 1, 0.05)
end

-- Which floor goes dark: nil for the whole grid (WholeGridChance), else one of `floors`.
function Disasters.BlackoutFloor(floors: { number }, rng: Random): number?
	if #floors == 0 or rng:NextNumber() < Disasters.Tuning().Blackout.WholeGridChance then
		return nil
	end
	return floors[rng:NextInteger(1, #floors)]
end

-- The units (rooms and dug cells) a blackout darkens: those on `floor`, or all of them.
function Disasters.BlackoutUnits(bunker: any, floor: number?): { [string]: boolean }
	local units: { [string]: boolean } = {}
	for _, unit in bunker:Units() do
		local cell = bunker:CellsOf(unit)[1]
		if cell and (floor == nil or cell[1] == floor) then
			units[unit] = true
		end
	end
	return units
end

-- The meltdown -----------------------------------------------------------------------------------

-- A valve a player has just turned: until when it counts (server time), or HELD (while held).
function Disasters.ValveTurned(players: number, now: number): number
	local m = Disasters.Tuning().Meltdown
	if players <= m.SoloPlayers then
		return now + m.SoloValveSeconds
	end
	return Disasters.HELD
end

-- A valve let go of: alone or in two, it keeps its SoloValveSeconds; in a team, a held valve
-- counts a moment longer (network slack), then it is open again.
function Disasters.ValveReleased(value: number, players: number, now: number): number
	local m = Disasters.Tuning().Meltdown
	if value ~= Disasters.HELD then
		return value
	end
	return now + (if players <= m.SoloPlayers then m.SoloValveSeconds else m.HeldGraceSeconds)
end

function Disasters.ValveOn(value: number, now: number): boolean
	return value == Disasters.HELD or value > now
end

function Disasters.ValvesOn(valves: { number }, now: number): number
	local n = 0
	for _, value in valves do
		if Disasters.ValveOn(value, now) then
			n += 1
		end
	end
	return n
end

-- All three valves turned at once: the meltdown stops (Section 10).
function Disasters.MeltdownStopped(valves: { number }, now: number): boolean
	return #valves >= 3 and Disasters.ValvesOn(valves, now) == #valves
end

-- Cave-ins --------------------------------------------------------------------------------------

function Disasters.RubbleHP(shape: Shape): number
	local c = Disasters.Tuning().CaveIn
	return if shape == "Tunnel" then c.TunnelHP else c.DoorwayHP
end

-- Seconds of digging that clear rubble (DigSpeed multipliers: the Driller's 2 halves it).
function Disasters.DigSeconds(shape: Shape, digSpeed: number?): number
	local c = Disasters.Tuning().CaveIn
	return (if shape == "Tunnel" then c.TunnelDigSeconds else c.DigSeconds) / math.max(digSpeed or 1, 0.05)
end

-- What a melee hit does to rubble: weapons that break rubble (the Fire Axe, the Sledgehammer)
-- do BreakerMultiplier times their damage; others their damage.
function Disasters.RubbleDamage(itemId: string, damage: number): number
	local item = Config.Find("Items", itemId)
	local breaks = item ~= nil and item.Melee ~= nil and item.Melee.BreaksRubble == true
	return damage * (if breaks then Disasters.Tuning().CaveIn.BreakerMultiplier else 1)
end

-- Can someone carrying `items` dig through rubble? (A Drill or a Pickaxe.)
function Disasters.CanDig(items: { string }): boolean
	for _, id in items do
		if table.find(Disasters.Tuning().CaveIn.DigItems, id) then
			return true
		end
	end
	return false
end

-- The passages rubble blocks, as pairs of graph units. A doorway: between (floor, column) and
-- its neighbour to the Left or Right, two open cells of different units. A tunnel: a dug cell,
-- every passage into it. Empty when there is nothing to block.
function Disasters.RubbleEdges(bunker: any, shape: Shape, floor: number, column: number, side: string?): { { string } }
	local here = bunker:UnitAt(floor, column)
	if not here then
		return {}
	end
	if shape == "Tunnel" then
		if bunker:State(floor, column) ~= "Dug" then
			return {}
		end
		local edges = {}
		for _, other in bunker:Neighbors(here) do
			table.insert(edges, { here, other })
		end
		return edges
	end
	local otherColumn = if side == "Left" then column - 1 else column + 1
	local other = bunker:UnitAt(floor, otherColumn)
	if not other or other == here then
		return {}
	end
	return { { here, other } }
end

-- Every doorway in the bunker, for cave-ins to fall in (Prompt 14's Tremors): { Floor, Column,
-- Side = "Right" } for each pair of open cells side by side in different units.
function Disasters.Doorways(bunker: any): { { Floor: number, Column: number, Side: string } }
	local list = {}
	for _, unit in bunker:Units() do
		for _, cell in bunker:CellsOf(unit) do
			local right = bunker:UnitAt(cell[1], cell[2] + 1)
			if right and right ~= unit then
				table.insert(list, { Floor = cell[1], Column = cell[2], Side = "Right" })
			end
		end
	end
	table.sort(list, function(a, b)
		return if a.Floor ~= b.Floor then a.Floor < b.Floor else a.Column < b.Column
	end)
	return list
end

-- Electrical surges ------------------------------------------------------------------------------

-- The chance a day brings an electrical surge (Section 10: random, more often in Era III).
function Disasters.ElectricalChance(era: number): number
	local chances = Disasters.Tuning().ElectricalSurge.EraChance
	return chances[math.clamp(math.floor(era), 1, #chances)] or 0
end

-- What an unwelded surge leaves behind when it ends (Section 10: they cause fires and
-- blackouts): "Fire", "Blackout" or nil.
function Disasters.SurgeAftermath(rng: Random): string?
	local e = Disasters.Tuning().ElectricalSurge
	local roll = rng:NextNumber()
	if roll < e.FireChance then
		return "Fire"
	elseif roll < e.FireChance + e.BlackoutChance then
		return "Blackout"
	end
	return nil
end

-- Repairs -----------------------------------------------------------------------------------------

-- HP a second from a Welder (RepairSpeed: the Engineer's 2).
function Disasters.WelderPerSecond(repairSpeed: number?): number
	return Disasters.Repairs().WelderPerSecond * (repairSpeed or 1)
end

-- HP a second from one resident working in the room, by their Smarts.
function Disasters.ResidentRepairPerSecond(smarts: number): number
	return Config.Get("Tuning", "Rooms").ResidentRepairPerSecond * math.max(smarts, 0) / Disasters.Repairs().ResidentSmartsBase
end

-- HP a wrecked room needs before it works again.
function Disasters.RepairedAt(maxHP: number): number
	return math.ceil(maxHP * Disasters.Repairs().RepairedAt)
end

return table.freeze(Disasters)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A7"><Properties><string name="Name">Economy</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Economy: the arithmetic of production, power and food (bible Sections 5, 6 and 13).
	EconomyService and PowerService run it on the server; the HUD and the Command View show
	its numbers. Nothing here touches the world, so DataTests can check every rule.

	Production (Section 13, provisional):
		Output per cycle = B x (sum of worker stat / 10) x L x M x R x P
	B is the room's Output.Base (what one cell's worth of workers with stats summing to 10
	makes), L Tuning.Rooms.LevelMultiplier, M Tuning.Rooms.MergeMultiplier by span, R the crew's
	average morale effect (Config.MoraleStates) and P 1 when lit, 0 when dark. The crew's own
	multiplier (traits, from ResidentService) and bunker-wide ones (a draft card, a class, the
	difficulty) come on top. A room with no crew, a dark room and a wrecked room (0 HP) make
	nothing. Rooms make it all the time (Section 5): the output per cycle is spread over a full
	cycle (Tuning.Clock.CycleSeconds), so a skipped day makes less.

	Power (Section 6): the Reactor Core and Generators (rooms with PowerOutput) need residents
	working in them, like every other room (Landon, Nov 8, 2026), and make PowerOutput[level]
	(the level is already in it) x (crew stat / 10) x M x R. Every room
	draws Power[level] per cell. When the draw passes what is made, rooms go dark farthest
	first: steps along the room graph from the nearest Reactor Core or Generator, dug cells
	counting as steps (Landon, Nov 7, 2026). A room nothing can reach is farthest of all; at the
	same distance the room drawing the most goes dark first (Landon, Nov 8, 2026), then the newest.
	Rooms that draw nothing (Shafts, Storage at level 1) never go dark, and a wrecked room (0 HP)
	draws nothing until it is repaired (Landon, Nov 8, 2026).

	Food and water (Section 5): every resident eats FoodPerCycle and drinks WaterPerCycle at the
	start of each cycle (food times their FoodUse). Whole units come off the stockpile and the
	rest carries to the next cycle, so someone who eats half takes 1 every other cycle.
]]

local Config = require(script.Parent.Parent.Config)

export type Crew = {
	Workers: number, -- residents working in the room
	StatSum: number, -- the sum of their stat for the room's job (Strength in the Reactor Core)
	Morale: number, -- their average morale effect: 0.85 to 1.2 (Config.MoraleStates)
	Multiplier: number?, -- their traits and the like (Green Thumb, Lazy), from ResidentService
}

export type Consumer = { Id: string, Draw: number, Steps: number?, Order: number }

export type Balance = {
	Made: number, -- power made
	Needed: number, -- power every room would draw
	Used: number, -- power the lit rooms draw
	Dark: { [string]: boolean }, -- dark room ids
	Draw: { [string]: number }, -- room id -> its draw (rooms that draw something)
	MadeBy: { [string]: number }, -- room id -> power it makes (the Reactor Core, Generators)
	Steps: { [string]: number }, -- graph node -> steps from the nearest power room (absent: unreachable)
}

local Economy = {}

local EPSILON = 1e-6

local function rooms(): { [string]: any }
	return Config.Get("Tuning", "Rooms")
end

function Economy.CycleSeconds(): number
	return Config.Get("Tuning", "Clock").CycleSeconds
end

-- The ore of the depth band a floor is in (Iron in the Mines), or nil.
function Economy.BandOre(floor: number): string?
	for _, band in Config.All("DepthBands") do
		if floor >= band.Floors.From and floor <= band.Floors.To then
			return band.Ore
		end
	end
	return nil
end

--[[
	What a room makes: "Resource" with the stocked resource ("Food"; a Drill Bay makes its band's
	ore), or its Output kind ("Research", "Morale", "Recruits"...) with no resource. nil for rooms
	that make nothing (Quarters, Storage, the Shaft) and for the power rooms (see PowerMade).
]]
function Economy.Makes(roomType: string, floor: number): (string?, string?)
	local output = Config.Get("Rooms", roomType).Output
	if not output then
		return nil, nil
	end
	if output.Kind == "Resource" then
		return "Resource", output.Resource
	elseif output.Kind == "BandOre" then
		local ore = Economy.BandOre(floor)
		return if ore then "Resource" else nil, ore
	end
	return output.Kind, nil
end

-- The crew's part of the formula: (stat sum / 10) x morale x their multiplier; 0 with no crew.
function Economy.CrewFactor(crew: Crew?): number
	if not crew or crew.Workers <= 0 or crew.StatSum <= 0 then
		return 0
	end
	return (crew.StatSum / 10) * crew.Morale * (crew.Multiplier or 1)
end

-- A room's output per cycle (Section 13). `multiplier` is everything bunker-wide on top.
function Economy.Output(roomType: string, level: number, span: number, crew: Crew?, lit: boolean, multiplier: number?): number
	local output = Config.Get("Rooms", roomType).Output
	if not output or not lit then
		return 0
	end
	local t = rooms()
	return output.Base * Economy.CrewFactor(crew) * t.LevelMultiplier[level] * t.MergeMultiplier[span] * (multiplier or 1)
end

-- Power a Reactor Core or Generator makes; 0 for any other room.
function Economy.PowerMade(roomType: string, level: number, span: number, crew: Crew?, multiplier: number?): number
	local made = Config.Get("Rooms", roomType).PowerOutput
	if not made then
		return 0
	end
	return made[level] * Economy.CrewFactor(crew) * rooms().MergeMultiplier[span] * (multiplier or 1)
end

-- Power a room draws: Power[level] for each of its cells.
function Economy.Draw(roomType: string, level: number, span: number): number
	return Config.Get("Rooms", roomType).Power[level] * span
end

function Economy.IsPowerRoom(roomType: string): boolean
	return Config.Get("Rooms", roomType).PowerOutput ~= nil
end

-- Steps from the nearest power room along the room graph (dug cells count), for every node
-- that can be reached from one.
function Economy.Steps(bunker: any): { [string]: number }
	local steps: { [string]: number } = {}
	local queue: { string } = {}
	for _, room in bunker:AllRooms() do
		if Economy.IsPowerRoom(room.Type) then
			steps[room.Id] = 0
			table.insert(queue, room.Id)
		end
	end
	local index = 1
	while index <= #queue do
		local unit = queue[index]
		for _, other in bunker:Neighbors(unit) do
			if steps[other] == nil then
				steps[other] = steps[unit] + 1
				table.insert(queue, other)
			end
		end
		index += 1
	end
	return steps
end

-- A room id's place in build order (R12 -> 12), for ties: the newest goes dark first.
function Economy.Order(roomId: string): number
	return tonumber(string.match(roomId, "%d+")) or 0
end

-- The rooms that go dark: farthest first (unreachable first of all), then the biggest draw, then
-- the newest, until what the rest draw fits in `made`.
function Economy.Shed(consumers: { Consumer }, made: number): { [string]: boolean }
	local needed = 0
	for _, consumer in consumers do
		needed += consumer.Draw
	end
	local dark: { [string]: boolean } = {}
	if needed <= made + EPSILON then
		return dark
	end
	local order = table.clone(consumers)
	table.sort(order, function(a: Consumer, b: Consumer): boolean
		local sa, sb = a.Steps or math.huge, b.Steps or math.huge
		if sa ~= sb then
			return sa > sb
		end
		if a.Draw ~= b.Draw then
			return a.Draw > b.Draw
		end
		return a.Order > b.Order
	end)
	for _, consumer in order do
		if needed <= made + EPSILON then
			break
		end
		dark[consumer.Id] = true
		needed -= consumer.Draw
	end
	return dark
end

--[[
	The whole power balance of a bunker. `crewOf(roomId)` gives a power room's crew;
	`multiplierOf(roomType)` bunker-wide power on top (the Overclock card). A wrecked power room
	(Rules.Bunker: from 0 HP until repaired) makes nothing and a wrecked room draws nothing.
]]
-- Wrecked (Prompt 13: from 0 HP until repaired); a record without the flag is wrecked at 0 HP.
local function wrecked(room: any): boolean
	if room.Wrecked ~= nil then
		return room.Wrecked == true
	end
	return room.HP <= 0
end

function Economy.Balance(bunker: any, crewOf: (string) -> Crew?, multiplierOf: ((string) -> number)?): Balance
	local steps = Economy.Steps(bunker)
	local made = 0
	local consumers: { Consumer } = {}
	local draw: { [string]: number } = {}
	local madeBy: { [string]: number } = {}
	for _, room in bunker:AllRooms() do
		if Economy.IsPowerRoom(room.Type) then
			local amount = 0
			if not wrecked(room) then
				amount = Economy.PowerMade(room.Type, room.Level, room.Span, crewOf(room.Id),
					if multiplierOf then multiplierOf(room.Type) else 1)
			end
			madeBy[room.Id] = amount
			made += amount
		end
		local d = if not wrecked(room) then Economy.Draw(room.Type, room.Level, room.Span) else 0 -- wrecked: none
		if d > 0 then
			draw[room.Id] = d
			table.insert(consumers, { Id = room.Id, Draw = d, Steps = steps[room.Id], Order = Economy.Order(room.Id) })
		end
	end
	local dark = Economy.Shed(consumers, made)
	local needed, used = 0, 0
	for id, d in draw do
		needed += d
		if not dark[id] then
			used += d
		end
	end
	return { Made = made, Needed = needed, Used = used, Dark = dark, Draw = draw, MadeBy = madeBy, Steps = steps }
end

-- Whole units eaten this cycle and the carry to the next: `uses` is each resident's use (1
-- normally; FoodUse changes it), `per` FoodPerCycle or WaterPerCycle.
function Economy.Eat(uses: { number }, per: number, carry: number): (number, number)
	local need = carry
	for _, use in uses do
		need += per * use
	end
	local take = math.floor(need + EPSILON)
	return take, math.max(0, need - take)
end

-- Progress toward whole units: `rate` per cycle for `seconds` of a cycle `cycle` seconds long.
-- Returns the whole units made and the fraction left over.
function Economy.Accrue(progress: number, rate: number, seconds: number, cycle: number): (number, number)
	local total = progress + rate * seconds / cycle
	local whole = math.floor(total + EPSILON)
	return whole, math.max(0, total - whole)
end

return Economy
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A8"><Properties><string name="Name">Grid</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Grid: the bunker grid's geometry (bible Section 6), shared so BunkerGrid, the
	Command View (Prompt 7) and the data tests agree on where every cell is.

	* Columns Tuning.Grid.ColumnMin..ColumnMax (-6 to 6), left to right as seen from the
	  front; floors 1 to 10, where the floor number is the depth. Floor 10 is the Source
	  Chamber.
	* A cell is 32 wide, 16 tall and 32 deep inside. Walls are WallThickness (1) on each side
	  and slabs SlabThickness (2) between floors, so cells repeat every 34 studs across and
	  18 down.
	* In the world, Tuning.Grid.Origin is the interior floor centre of floor 1, column 0.
	  Columns grow along +X, floors go down -Y, and the front (the Command View camera's
	  side) faces +Z. Models from the art pipeline face -Z, so CellCFrame turns them half a
	  turn.
]]

local Config = require(script.Parent.Parent.Config)

local Grid = {}

function Grid.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Grid")
end

-- "floor,column", the key cells go by everywhere (collections, models, the delta channel).
function Grid.Key(floor: number, column: number): string
	return `{floor},{column}`
end

function Grid.Parse(key: string): (number?, number?)
	local floor, column = string.match(key, "^(%-?%d+),(%-?%d+)$")
	if not floor then
		return nil, nil
	end
	return tonumber(floor), tonumber(column)
end

function Grid.OnGrid(floor: number, column: number): boolean
	local t = Grid.Tuning()
	return floor == math.floor(floor)
		and column == math.floor(column)
		and floor >= t.FloorMin
		and floor <= t.FloorMax
		and column >= t.ColumnMin
		and column <= t.ColumnMax
end

-- How far apart cells are: across (X), down (Y), and a cell's full depth (Z).
function Grid.Pitch(): Vector3
	local t = Grid.Tuning()
	return Vector3.new(t.CellWidth + 2 * t.WallThickness, t.CellHeight + t.SlabThickness, t.CellDepth + 2 * t.WallThickness)
end

-- The centre of a cell's interior floor, in the world.
function Grid.CellPosition(floor: number, column: number): Vector3
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	return Vector3.new(t.Origin.X + column * pitch.X, t.Origin.Y - (floor - 1) * pitch.Y, t.Origin.Z)
end

-- A cell's interior floor centre, turned so a model that faces -Z faces the front (+Z).
function Grid.CellCFrame(floor: number, column: number): CFrame
	return CFrame.new(Grid.CellPosition(floor, column)) * CFrame.Angles(0, math.pi, 0)
end

-- The cell a world position is in (its interior, or the slab under it), or nil off the grid.
function Grid.CellAt(position: Vector3): (number?, number?)
	local t = Grid.Tuning()
	local pitch = Grid.Pitch()
	local floor = math.floor((t.Origin.Y + t.CellHeight - position.Y) / pitch.Y) + 1
	local column = math.floor((position.X - t.Origin.X) / pitch.X + 0.5)
	if math.abs(position.Z - t.Origin.Z) > pitch.Z / 2 or not Grid.OnGrid(floor, column) then
		return nil, nil
	end
	return floor, column
end

-- The depth band a floor is in (Config.DepthBands).
function Grid.BandOf(floor: number): { [string]: any }
	for _, band in Config.All("DepthBands") do
		if floor >= band.Floors.From and floor <= band.Floors.To then
			return band
		end
	end
	error(`Rules.Grid: no depth band holds floor {floor}`)
end

-- The first floor of a band below the first one (4, 7, 10): opening it needs Push Deeper.
function Grid.IsBandStart(floor: number): boolean
	local band = Grid.BandOf(floor)
	return band.Floors.From == floor and floor > Grid.Tuning().FloorMin
end

-- Can rooms be built on this floor? (Not in the Source Chamber.)
function Grid.Buildable(floor: number): boolean
	return Grid.BandOf(floor).Buildable == true
end

return table.freeze(Grid)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000A9"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Hud: the HUD's arithmetic (bible Section 18), pure so the data tests can check it.

	* Clock(seconds): "m:ss", rounded up, so "0:01" shows until the very end.
	* YearDigits(year): the three tiles of the year flip counter.
	* DialPosition(...): where the cycle dial's pointer sits across the face. The day fills the
	  first DaySeconds / CycleSeconds of the scale and the Surge the rest, as the dial is printed.
	  A Surge with no timer (a boss Surge) parks at the start of its part.
	* NeedleRotation(fraction): a gauge needle's rotation (the sweep runs -135 to +135 degrees).
	* Numeral(n): Roman numerals for the eras.
	* MapWindow(...): which cells the side-view mini-map shows around the player.
]]

local Hud = {}

-- The printed face of the cycle dial spans this much of the sprite's width.
Hud.DialFace = table.freeze({ From = 0.023, To = 0.977 })

function Hud.Clock(seconds: number?): string
	if seconds == nil then
		return "--:--"
	end
	local whole = math.max(0, math.ceil(seconds - 1e-6))
	return string.format("%d:%02d", whole // 60, whole % 60)
end

function Hud.YearDigits(year: number): { string }
	local text = string.format("%03d", math.clamp(math.floor(year), 0, 999))
	return { string.sub(text, 1, 1), string.sub(text, 2, 2), string.sub(text, 3, 3) }
end

-- phase: "Day", "Surge" or nil (before the first day); timeLeft in seconds (nil if unknown);
-- open: the phase has no timer.
function Hud.DialPosition(
	phase: string?,
	phaseLength: number?,
	timeLeft: number?,
	open: boolean?,
	daySeconds: number,
	surgeSeconds: number
): number
	local split = daySeconds / (daySeconds + surgeSeconds)
	local done = 0
	if phaseLength and phaseLength > 0 and timeLeft then
		done = math.clamp(1 - timeLeft / phaseLength, 0, 1)
	end
	local value = 0
	if phase == "Day" then
		value = done * split
	elseif phase == "Surge" then
		value = if open then split else split + done * (1 - split)
	end
	return Hud.DialFace.From + (Hud.DialFace.To - Hud.DialFace.From) * value
end

function Hud.NeedleRotation(fraction: number): number
	return -135 + 270 * math.clamp(fraction, 0, 1)
end

local ROMAN = { "I", "II", "III", "IV", "V", "VI", "VII", "VIII", "IX", "X" }

function Hud.Numeral(n: number): string
	return ROMAN[n] or tostring(n)
end

-- The window of `columns` columns centred on the player's column and `rows` floors starting
-- one above the player's floor, kept on the grid. Returns the first column and first floor.
function Hud.MapWindow(
	floor: number,
	column: number,
	grid: { ColumnMin: number, ColumnMax: number, FloorMin: number, FloorMax: number },
	columns: number,
	rows: number
): (number, number)
	local half = (columns - 1) // 2
	local firstColumn = math.clamp(column - half, grid.ColumnMin, math.max(grid.ColumnMin, grid.ColumnMax - columns + 1))
	local firstFloor = math.clamp(floor - 1, grid.FloorMin, math.max(grid.FloorMin, grid.FloorMax - rows + 1))
	return firstColumn, firstFloor
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AA"><Properties><string name="Name">Loot</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Loot: rolling Config.LootTables (bible Sections 6, 10, 12 and 13). Pure, so the data
	tests and every service that hands out loot share it.

	Roll(tableId, rng, context) draws the table's Rolls lines by Weight; each gives Min..Max.
	Drops with the same resource, item or special add up:

		Loot.Roll("Cache", rng, { BandOre = "Iron" })
		-- { { Resource = "Scrap", Count = 62 }, { Item = "Flare", Count = 1 } }

	* context.BandOre is the ore a BandOre line gives (the band the loot is in). With none (the
	  Source Chamber) BandOre lines are left out of the draw.
	* context.Skip names Specials that nothing hands out yet (Gear before Prompt 26, RadioLog
	  before the Codex): their lines are left out of the draw too, so the rest keep their odds
	  between them.
	* context.OreMultiplier scales the ore a BandOre line gives (the Driller's DugOre).
]]

local Config = require(script.Parent.Parent.Config)

local Loot = {}

export type Drop = { Resource: string?, Item: string?, Special: string?, Count: number }
export type Context = { BandOre: string?, Skip: { [string]: boolean }?, OreMultiplier: number? }

-- The lines a table can give here, with their weights.
function Loot.Lines(tableId: string, context: Context?): { any }
	local entry = Config.Get("LootTables", tableId)
	local skip = if context then context.Skip else nil
	local list = {}
	for _, line in entry.Lines do
		local usable = line.Weight > 0
		if line.Special == "BandOre" and not (context and context.BandOre) then
			usable = false
		elseif line.Special and line.Special ~= "BandOre" and skip and skip[line.Special] then
			usable = false
		end
		if usable then
			table.insert(list, line)
		end
	end
	return list
end

local function keyOf(drop: Drop): string
	return `{drop.Resource or ""}|{drop.Item or ""}|{drop.Special or ""}`
end

function Loot.Roll(tableId: string, rng: Random, context: Context?): { Drop }
	local entry = Config.Get("LootTables", tableId)
	local lines = Loot.Lines(tableId, context)
	local total = 0
	for _, line in lines do
		total += line.Weight
	end
	local byKey: { [string]: Drop } = {}
	local order: { string } = {}
	if total <= 0 then
		return {}
	end
	for _ = 1, entry.Rolls do
		local pick = rng:NextNumber() * total
		local chosen = lines[#lines]
		for _, line in lines do
			pick -= line.Weight
			if pick <= 0 then
				chosen = line
				break
			end
		end
		local count = rng:NextInteger(chosen.Min, math.max(chosen.Min, chosen.Max))
		local drop: Drop
		if chosen.Special == "BandOre" then
			local ore = (context :: Context).BandOre
			count = math.floor(count * ((context :: Context).OreMultiplier or 1) + 0.5)
			drop = { Resource = ore, Count = count }
		elseif chosen.Resource then
			drop = { Resource = chosen.Resource, Count = count }
		elseif chosen.Item then
			drop = { Item = chosen.Item, Count = count }
		else
			drop = { Special = chosen.Special, Count = count }
		end
		if count > 0 then
			local key = keyOf(drop)
			local have = byKey[key]
			if have then
				have.Count += count
			else
				byKey[key] = drop
				table.insert(order, key)
			end
		end
	end
	local drops = {}
	for _, key in order do
		table.insert(drops, byKey[key])
	end
	return drops
end

-- "62 SCRAP · 1 FLARE" for alerts.
function Loot.Text(drops: { Drop }): string
	local parts = {}
	for _, drop in drops do
		local name = if drop.Resource then Config.Get("Resources", drop.Resource).Name
			elseif drop.Item then Config.Get("Items", drop.Item).Name
			else drop.Special or "?"
		table.insert(parts, `{drop.Count} {string.upper(name)}`)
	end
	return table.concat(parts, " · ")
end

return table.freeze(Loot)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AB"><Properties><string name="Name">Modifiers</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Modifiers: reading the effects a player carries (bible Sections 14 and 23: effects are
	data, Config.Modifiers is the vocabulary). Pure, so both sides and the data tests share it.

	A class's Passive (and, from Prompt 20, its level 2 and 3 effects; talents come with Prompt
	27) lists modifiers. ClassValue folds the ones with a key into one number by the key's
	unit: Multiplier and Chance multiply (1 when none), Add adds (0), Set and Flag take the last
	(nil when none).

		Modifiers.ClassValue("Firefighter", "ExtinguishSpeed") -- 3
		Modifiers.ClassValue("Engineer", "RepairSpeed")        -- 2
		Modifiers.ClassValue("Survivor", "RepairSpeed")        -- 1
]]

local Config = require(script.Parent.Parent.Config)

local Modifiers = {}

-- The starting value of a key with nothing applied.
function Modifiers.Neutral(key: string): number?
	local info = Config.Find("Modifiers", key)
	if not info then
		return nil
	end
	if info.Unit == "Multiplier" or info.Unit == "Chance" then
		return 1
	elseif info.Unit == "Add" then
		return 0
	end
	return nil
end

-- Folds a list of { Key, Value } modifiers for one key.
function Modifiers.Fold(list: { any }?, key: string): number?
	local info = Config.Find("Modifiers", key)
	local value = Modifiers.Neutral(key)
	if not info then
		return nil
	end
	for _, modifier in list or {} do
		if modifier.Key == key then
			if info.Unit == "Multiplier" or info.Unit == "Chance" then
				value = (value or 1) * modifier.Value
			elseif info.Unit == "Add" then
				value = (value or 0) + modifier.Value
			else
				value = modifier.Value
			end
		end
	end
	return value
end

-- A class's value for a key: its Passive, plus Level2 and Level3 at those class levels.
function Modifiers.ClassValue(classId: string?, key: string, level: number?): number?
	local class = Config.Find("Classes", classId or "")
	local list = {}
	if class then
		local parts = { class.Passive }
		if (level or 1) >= 2 then
			table.insert(parts, class.Level2)
		end
		if (level or 1) >= 3 then
			table.insert(parts, class.Level3)
		end
		for _, part in parts do
			for _, modifier in (part and part.Modifiers) or {} do
				table.insert(list, modifier)
			end
		end
	end
	return Modifiers.Fold(list, key)
end

return table.freeze(Modifiers)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AC"><Properties><string name="Name">Residents</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Residents: the rules of residents, phase 1 (bible Section 11: identity, stats, jobs, levels,
	needs, routine and death). ResidentService runs them on the server; the Residents screen and
	the Command View show their numbers; DataTests hold them to the bible.

	* Identity: a first and last name from Config.ResidentNames (no repeats in a run while the
	  pool lasts), an age from Tuning.Aging.StartAge, a tier (the six founders are Common).
	* Stats: Strength, Smarts, Grit, Speed and Charm, StatMin to StatMax when they arrive (Rares
	  add RareStatBonus to their best two), never past StatCap. Max health grows with Grit
	  (HealthBase + Grit x HealthPerGrit, provisional).
	* Levels 1 to LevelMax: XPToLevelBase + XPToLevelStep x (level - 1) to the next; each level
	  adds 1 to the stat their job uses (Section 11). Founders above level 1 put theirs into
	  their best stat.
	* Jobs: one room each, if the room has a worker stat and a free slot
	  (Tuning.Rooms.WorkerSlotsPerCell x span). AutoAssign picks the empty slots to fill in
	  Tuning.Residents.AutoAssignOrder (power first, so the lights stay on), then fills them with
	  the best matches by stat.
	* A room's crew for Section 13's formula: workers, the sum of their job stat (an Exhausted
	  resident counts half), and their average morale effect (Config.MoraleStates).
	* Needs once a cycle: rest drains with work and refills in a Quarters bed (less without
	  one); food and water come from the stockpile, and the hungry lose health and morale;
	  morale moves with job fit, meals, dark rooms and beds (Tuning.Morale).
	* Death: at 0 health a resident is down for DeathReviveSeconds; then gone for the run.
]]

local Config = require(script.Parent.Parent.Config)

export type Stats = { [string]: number }
export type State = "Alive" | "Down" | "Dead"
export type Resident = {
	Id: string,
	First: string,
	Last: string,
	Age: number,
	Tier: string,
	Level: number,
	XP: number,
	Stats: Stats,
	Job: string?, -- a room id
	Health: number,
	MaxHealth: number,
	Rest: number, -- 0 to 100
	Morale: number, -- 0 to 100
	State: State,
	Hungry: boolean, -- missed the last meal
	Trapped: boolean?, -- cave-in rubble cuts them off from where they need to be (Prompt 13)
	Log: { string }, -- the run log (Section 11)
}
export type Crew = { Workers: number, StatSum: number, Morale: number, Multiplier: number? }
export type Rng = { NextInteger: (self: any, number, number) -> number, NextNumber: (self: any) -> number }

local Residents = {}

local function tuning(): { [string]: any }
	return Config.Get("Tuning", "Residents")
end

function Residents.StatIds(): { string }
	return Config.Ids("Stats")
end

function Residents.MaxHealth(stats: Stats): number
	local t = tuning()
	return t.HealthBase + (stats.Grit or 0) * t.HealthPerGrit
end

function Residents.XPToLevel(level: number): number
	local t = tuning()
	return t.XPToLevelBase + t.XPToLevelStep * (level - 1)
end

-- Their best stat (ties: the order of Config.Stats) and their worst.
function Residents.Best(stats: Stats): string
	local best, value = "Strength", -1
	for _, id in Residents.StatIds() do
		if (stats[id] or 0) > value then
			best, value = id, stats[id] or 0
		end
	end
	return best
end

function Residents.Worst(stats: Stats): string
	local worst, value = "Strength", math.huge
	for _, id in Residents.StatIds() do
		if (stats[id] or 0) < value then
			worst, value = id, stats[id] or 0
		end
	end
	return worst
end

-- The stat a room's job uses (nil: nobody works there).
function Residents.JobStat(roomType: string): string?
	return Config.Get("Rooms", roomType).WorkerStat
end

function Residents.Slots(roomType: string, level: number, span: number): number
	if not Residents.JobStat(roomType) then
		return 0
	end
	return Config.Get("Tuning", "Rooms").WorkerSlotsPerCell[level] * span
end

local function bump(stats: Stats, stat: string)
	stats[stat] = math.min(tuning().StatCap, (stats[stat] or 0) + 1)
end

--[[
	A new resident. `used` holds the full names taken this run (it is updated). Founders above
	level 1 have put each level into their best stat.
]]
function Residents.Roll(rng: Rng, id: string, tier: string, level: number, used: { [string]: boolean }): Resident
	local t = tuning()
	local names = Config.Get("ResidentNames", "First").Names
	local lasts = Config.Get("ResidentNames", "Last").Names
	local first, last = "", ""
	for _ = 1, 40 do
		first, last = names[rng:NextInteger(1, #names)], lasts[rng:NextInteger(1, #lasts)]
		if not used[`{first} {last}`] then
			break
		end
	end
	used[`{first} {last}`] = true
	local stats: Stats = {}
	for _, stat in Residents.StatIds() do
		stats[stat] = rng:NextInteger(t.StatMin, t.StatMax)
	end
	if tier ~= "Common" and tier ~= "Free" then -- Rares and above: their best two get a bonus
		local order = table.clone(Residents.StatIds())
		table.sort(order, function(a: string, b: string): boolean
			return stats[a] > stats[b]
		end)
		for i = 1, 2 do
			stats[order[i]] = math.min(t.StatCap, stats[order[i]] + t.RareStatBonus)
		end
	end
	for _ = 2, level do
		bump(stats, Residents.Best(stats))
	end
	local aging = Config.Get("Tuning", "Aging")
	local maxHealth = Residents.MaxHealth(stats)
	return {
		Id = id,
		First = first,
		Last = last,
		Age = rng:NextInteger(aging.StartAge.Min, aging.StartAge.Max),
		Tier = tier,
		Level = level,
		XP = 0,
		Stats = stats,
		Job = nil,
		Health = maxHealth,
		MaxHealth = maxHealth,
		Rest = 100,
		Morale = t.MoraleStart,
		State = "Alive",
		Hungry = false,
		Log = {},
	}
end

-- Experience: returns the levels gained; each adds 1 to `jobStat` (their best stat if nil).
function Residents.AddXP(resident: Resident, xp: number, jobStat: string?): number
	local t = tuning()
	local gained = 0
	resident.XP += xp
	while resident.Level < t.LevelMax and resident.XP >= Residents.XPToLevel(resident.Level) do
		resident.XP -= Residents.XPToLevel(resident.Level)
		resident.Level += 1
		gained += 1
		bump(resident.Stats, jobStat or Residents.Best(resident.Stats))
	end
	if resident.Level >= t.LevelMax then
		resident.XP = 0
	end
	resident.MaxHealth = Residents.MaxHealth(resident.Stats)
	return gained
end

-- Morale's state (Config.MoraleStates) and its output effect (R in Section 13).
function Residents.MoraleState(morale: number): (string, number)
	for _, id in Config.Ids("MoraleStates") do
		local state = Config.Get("MoraleStates", id)
		if morale >= state.From and morale <= state.To + 0.999 then
			return id, state.OutputMultiplier
		end
	end
	return "Settled", 1
end

function Residents.IsExhausted(resident: Resident): boolean
	return resident.Rest <= 0
end

-- A room's crew: who works there, alive, with their job stat (Exhausted counts half).
function Residents.Crew(workers: { Resident }, roomType: string): Crew?
	local stat = Residents.JobStat(roomType)
	if not stat then
		return nil
	end
	local count, sum, morale = 0, 0, 0
	for _, resident in workers do
		if resident.State == "Alive" then
			count += 1
			local exhausted = Config.Get("Conditions", "Exhausted").OutputMultiplier
			sum += (resident.Stats[stat] or 0) * (if Residents.IsExhausted(resident) then exhausted else 1)
			local _, effect = Residents.MoraleState(resident.Morale)
			morale += effect
		end
	end
	if count == 0 then
		return nil
	end
	return { Workers = count, StatSum = sum, Morale = morale / count }
end

export type Room = { Id: string, Type: string, Level: number, Span: number }

--[[
	Auto-Assign (Section 7: "fills empty slots by best stat"). Which slots get filled: the empty
	ones in Tuning.Residents.AutoAssignOrder (power first, so the lights stay on), then any other
	working room, as many as there are free residents. Who fills them: the best matches first
	across all of those slots (the highest stat for a slot's job wins it), so a fast cook ends up
	in the Kitchen rather than at the reactor. `free` is changed in place: assigned residents leave
	it. Returns { residentId = roomId }.
]]
function Residents.AutoAssign(rooms: { Room }, taken: { [string]: number }, free: { Resident }): { [string]: string }
	local order = tuning().AutoAssignOrder
	local sorted = table.clone(rooms)
	table.sort(sorted, function(a: Room, b: Room): boolean
		local ia, ib = table.find(order, a.Type) or #order + 1, table.find(order, b.Type) or #order + 1
		if ia ~= ib then
			return ia < ib
		end
		return a.Id < b.Id
	end)
	local alive = {}
	for _, resident in free do
		if resident.State == "Alive" then
			table.insert(alive, resident)
		end
	end
	-- the slots to fill, in priority order
	local slots: { { Room: string, Stat: string, Rank: number } } = {}
	for _, room in sorted do
		local stat = Residents.JobStat(room.Type)
		if stat then
			for _ = 1, Residents.Slots(room.Type, room.Level, room.Span) - (taken[room.Id] or 0) do
				if #slots < #alive then
					table.insert(slots, { Room = room.Id, Stat = stat, Rank = #slots + 1 })
				end
			end
		end
	end
	-- the best matches first
	local pairs_ = {}
	for i, resident in alive do
		for j, slot in slots do
			table.insert(pairs_, { R = i, S = j, Value = resident.Stats[slot.Stat] or 0 })
		end
	end
	table.sort(pairs_, function(a: any, b: any): boolean
		if a.Value ~= b.Value then
			return a.Value > b.Value
		end
		if a.S ~= b.S then
			return a.S < b.S
		end
		return a.R < b.R
	end)
	local result: { [string]: string } = {}
	local usedResident, usedSlot = {}, {}
	for _, pair in pairs_ do
		if not usedResident[pair.R] and not usedSlot[pair.S] then
			usedResident[pair.R] = true
			usedSlot[pair.S] = true
			local resident, slot = alive[pair.R], slots[pair.S]
			result[resident.Id] = slot.Room
			taken[slot.Room] = (taken[slot.Room] or 0) + 1
		end
	end
	for i = #free, 1, -1 do
		if result[free[i].Id] then
			table.remove(free, i)
		end
	end
	return result
end

--[[
	One cycle of needs for a resident (Section 11), at the cycle's start:
	* rest: -RestDrainPerShift for a worker, +RestRefillPerCycle in a bed (x NoBedRestMultiplier
	  without one), 0 to 100;
	* food and water: `fed` false means they missed the meal: -ShortfallHealth health and
	  Tuning.Morale.Hungry morale;
	* morale: JobFit or PoorFit for their job, FedCycle, DarkRoom for a dark job room, NoBed.
	Returns what changed for the run log.
]]
function Residents.Cycle(resident: Resident, worked: boolean, jobStat: string?, bed: boolean, fed: boolean, darkJob: boolean): { string }
	local t = tuning()
	local m = Config.Get("Tuning", "Morale")
	local notes = {}
	local rest = resident.Rest
	if worked then
		rest -= t.RestDrainPerShift
	end
	rest += t.RestRefillPerCycle * (if bed then 1 else t.NoBedRestMultiplier)
	resident.Rest = math.clamp(rest, 0, 100)
	local morale = resident.Morale
	if jobStat then
		if jobStat == Residents.Best(resident.Stats) then
			morale += m.JobFit
		elseif jobStat == Residents.Worst(resident.Stats) then
			morale += m.PoorFit
		end
	end
	if fed then
		morale += m.FedCycle
		resident.Hungry = false
	else
		morale += m.Hungry
		resident.Health = math.max(0, resident.Health - t.ShortfallHealth)
		resident.Hungry = true
		table.insert(notes, "went hungry")
	end
	if darkJob then
		morale += m.DarkRoom
	end
	if not bed then
		morale += m.NoBed
		table.insert(notes, "had no bed")
	end
	resident.Morale = math.clamp(morale, 0, 100)
	return notes
end

-- The full name, as the HUD and the run log write it.
function Residents.Name(resident: Resident): string
	return `{resident.First} {resident.Last}`
end

return Residents
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AD"><Properties><string name="Name">Results</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Results: what a run pays and who was its MVP (bible Sections 16 and 18; Prompt 15). Pure,
	so ResultsService, the results screen and the data tests agree. The amounts are
	Config.GlowshardRewards, Config.Difficulties' PayoutMultiplier and Tuning.Account (account
	experience); the MVP weights are Tuning.Results.

	* Payout(run, paid, facts): the lines a player is owed and the new ledger. `paid` is what this
	  run has already paid them, so a run that ends twice (a victory, then Keep Going and a later
	  end in Endless) only pays what is new: more years, deeper bands, a victory, bosses.
	    - Years survived: Amount per Every years (1 per 4).
	    - Depth bands reached: Amount each (a band counts once its first floor is open).
	    - A Century or a Deep Victory.
	    - Each boss killed.
	    - The difficulty's PayoutMultiplier, then the first win of the day doubles it all.
	* Account experience: XPPerYear for each new year survived; levels from XPToLevelBase plus
	  XPToLevelStep a level, up to LevelMax.
	* Score and MVP: a player's stats times Tuning.Results.MVP's weights; the highest wins (ties:
	  the lower user id, so every server agrees).
]]

local Config = require(script.Parent.Parent.Config)

local Results = {}

export type Run = {
	Year: number,
	DeepestFloor: number,
	Victory: string?, -- "Century" | "Deep"
	Bosses: { string }, -- bosses beaten this run
	Difficulty: string,
}
export type Ledger = { Years: number, Bands: number, Victory: boolean, Bosses: { [string]: boolean } }
export type Line = { Text: string, Amount: number }
export type Payout = { Lines: { Line }, Total: number, Ledger: Ledger }

function Results.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Results")
end

function Results.EmptyLedger(): Ledger
	return { Years = 0, Bands = 0, Victory = false, Bosses = {} }
end

-- Bands whose first floor is open (the Mines count from the start).
function Results.BandsReached(deepestFloor: number): number
	local n = 0
	for _, band in Config.All("DepthBands") do
		if deepestFloor >= band.Floors.From then
			n += 1
		end
	end
	return n
end

local function reward(id: string): any
	return Config.Get("GlowshardRewards", id)
end

function Results.Payout(run: Run, paid: Ledger, facts: { FirstWinToday: boolean }): Payout
	local lines: { Line } = {}
	local ledger: Ledger = { Years = paid.Years, Bands = paid.Bands, Victory = paid.Victory, Bosses = table.clone(paid.Bosses) }
	local subtotal = 0
	local function add(text: string, amount: number)
		if amount > 0 then
			table.insert(lines, { Text = text, Amount = amount })
			subtotal += amount
		end
	end
	-- years survived
	local years = reward("Years")
	local yearsOwed = math.floor(math.max(run.Year, 0) / years.Every)
	local paidYears = math.floor(paid.Years / years.Every)
	if yearsOwed > paidYears then
		add(`Years survived: {run.Year}`, (yearsOwed - paidYears) * years.Amount)
	end
	ledger.Years = math.max(paid.Years, run.Year)
	-- depth bands
	local bands = Results.BandsReached(run.DeepestFloor)
	if bands > paid.Bands then
		add(`Depth bands reached: {bands}`, (bands - paid.Bands) * reward("Bands").Amount)
	end
	ledger.Bands = math.max(paid.Bands, bands)
	-- a victory
	if run.Victory and not paid.Victory then
		local id = if run.Victory == "Deep" then "DeepVictory" else "CenturyVictory"
		add(reward(id).Text, reward(id).Amount)
		ledger.Victory = true
	end
	-- bosses
	for _, bossId in run.Bosses do
		if not ledger.Bosses[bossId] then
			ledger.Bosses[bossId] = true
			add(`{Config.Get("Bosses", bossId).Name} killed`, reward("Bosses").Amount)
		end
	end
	local total = subtotal
	local difficulty = Config.Find("Difficulties", run.Difficulty)
	local multiplier = if difficulty then difficulty.PayoutMultiplier else 1
	if subtotal > 0 and multiplier ~= 1 then
		local extra = math.floor(subtotal * multiplier + 0.5) - subtotal
		table.insert(lines, { Text = `{difficulty.Name} difficulty x{multiplier}`, Amount = extra })
		total += extra
	end
	if total > 0 and facts.FirstWinToday and run.Victory then
		local double = reward("FirstWinOfDay").Multiplier or 2
		local extra = math.floor(total * double + 0.5) - total
		table.insert(lines, { Text = "First win of the day", Amount = extra })
		total += extra
	end
	return { Lines = lines, Total = math.floor(total + 0.5), Ledger = ledger }
end

-- Account experience for years survived since `paidYears`.
function Results.AccountXP(year: number, paidYears: number): number
	return math.max(0, year - paidYears) * Config.Get("Tuning", "Account").XPPerYear
end

-- Experience to go from `level` to the next.
function Results.XPToNext(level: number): number
	local t = Config.Get("Tuning", "Account")
	return t.XPToLevelBase + t.XPToLevelStep * (level - 1)
end

-- An account's level and experience after gaining `gained`.
function Results.LevelUp(level: number, xp: number, gained: number): (number, number)
	local t = Config.Get("Tuning", "Account")
	xp += gained
	while level < t.LevelMax and xp >= Results.XPToNext(level) do
		xp -= Results.XPToNext(level)
		level += 1
	end
	if level >= t.LevelMax then
		xp = math.min(xp, Results.XPToNext(level))
	end
	return level, xp
end

function Results.Score(stats: { [string]: number }): number
	local score = 0
	for key, weight in Results.Tuning().MVP do
		score += (stats[key] or 0) * weight
	end
	return math.floor(score + 0.5)
end

-- The MVP's user id (players: user id -> stats), or nil with nobody scoring.
function Results.MVP(players: { [number]: { [string]: number } }): number?
	local best: number? = nil
	local bestScore = 0
	for userId, stats in players do
		local score = Results.Score(stats)
		if score > bestScore or (score == bestScore and best ~= nil and score > 0 and userId < best) then
			best, bestScore = userId, score
		end
	end
	return best
end

-- The UTC day a moment falls on (for the first win of the day).
function Results.Day(unixSeconds: number): number
	return math.floor(unixSeconds / 86400)
end

return table.freeze(Results)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AE"><Properties><string name="Name">Threat</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Threat: the Threat Director's arithmetic (bible Section 10), pure so DataTests can hold
	it to the bible. Prompt 12.

	* Level: threat rises with the year, the deepest floor reached, Disturbance, bunker size and
	  player count (Tuning.Threat, provisional).
	* SurgeBudget: what a Surge spends on monster groups; the first cycle's Surge is a small
	  tutorial wave (Section 5), and a player's first run is 30% easier in Era I (Section 22).
	* Roster: the monsters an era sends (Section 5's eras: each brings its band's creatures, Era
	  IV everything before). Surface monsters come with storms and raids (Prompt 16), not breaches.
	* Groups: a budget spent on groups of monsters (each type's Group size and ThreatCost), with
	  variety; Pick: one breach point, weighted.
]]

local Config = require(script.Parent.Parent.Config)

local Threat = {}

export type Inputs = {
	Year: number,
	DeepestFloor: number,
	Disturbance: number,
	Rooms: number,
	Players: number,
}

export type Group = { Type: string, Count: number }

local function tuning(): { [string]: any }
	return Config.Get("Tuning", "Threat")
end

function Threat.Level(inputs: Inputs): number
	local t = tuning()
	local players = math.clamp(math.floor(inputs.Players), 1, #t.PlayerScale)
	local base = t.Base + t.PerYear * inputs.Year + t.PerDeepestFloor * inputs.DeepestFloor
		+ t.PerDisturbance * inputs.Disturbance + t.PerRoom * inputs.Rooms
	return base * t.PlayerScale[players]
end

-- What a Surge spends. kind is the CycleClock's Surge kind; boss Surges bring their boss
-- instead (Prompt 15), so they spend nothing here.
function Threat.SurgeBudget(level: number, kind: string, firstRunEraI: boolean): number
	local t = tuning()
	if kind == "Tutorial" then
		return t.TutorialSurgeBudget
	elseif kind == "Boss" or kind == "Final" then
		return 0
	end
	return level * (if firstRunEraI then t.FirstRunEraIMultiplier else 1)
end

-- Between Surges: a small amount each cycle (spread over the day).
function Threat.TrickleBudget(level: number, firstRunEraI: boolean): number
	local t = tuning()
	return level * t.BetweenSurgesFraction * (if firstRunEraI then t.FirstRunEraIMultiplier else 1)
end

function Threat.EraNumber(era: string | number): number
	if type(era) == "number" then
		return math.clamp(math.floor(era), 1, 4)
	end
	local entry = Config.Find("Eras", era)
	return if entry then entry.Number else 1
end

-- The monsters that come through breaches by an era: every era's NewMonsters up to it (Section
-- 5's era table; Era IV brings "everything before, stronger"). Sorted, so picks repeat with a seed.
-- Surface monsters come with storms and raids (Prompt 16), not breaches.
function Threat.Roster(era: string | number): { string }
	local n = Threat.EraNumber(era)
	local list = {}
	for _, entry in Config.All("Eras") do
		if entry.Number <= n then
			for _, id in entry.NewMonsters or {} do
				local monster = Config.Find("Monsters", id)
				local surfaceOnly = monster ~= nil and #monster.Where == 1 and monster.Where[1] == "Surface"
				if monster and not surfaceOnly and not table.find(list, id) then
					table.insert(list, id)
				end
			end
		end
	end
	table.sort(list)
	return list
end

-- Spends a budget on groups: each pick is a type whose cost fits what is left, the types used
-- least so far first (variety), then a group size from its Group range that the budget covers.
-- Leftovers smaller than the cheapest monster are dropped. rng: a Random.
function Threat.Groups(budget: number, roster: { string }, rng: Random): { Group }
	local groups: { Group } = {}
	local left = budget
	local used: { [string]: number } = {}
	local guard = 0
	while guard < 40 do
		guard += 1
		local fits = {}
		for _, id in roster do
			local monster = Config.Get("Monsters", id)
			if monster.ThreatCost <= left then
				table.insert(fits, id)
			end
		end
		if #fits == 0 then
			break
		end
		local fewest = math.huge
		for _, id in fits do
			fewest = math.min(fewest, used[id] or 0)
		end
		local least = {}
		for _, id in fits do
			if (used[id] or 0) == fewest then
				table.insert(least, id)
			end
		end
		local id = least[rng:NextInteger(1, #least)]
		local monster = Config.Get("Monsters", id)
		local most = math.min(monster.Group.Max, math.floor(left / monster.ThreatCost))
		local least_ = math.min(monster.Group.Min, most)
		local count = rng:NextInteger(least_, most)
		table.insert(groups, { Type = id, Count = count })
		used[id] = (used[id] or 0) + 1
		left -= count * monster.ThreatCost
	end
	return groups
end

-- The total cost of some groups.
function Threat.Cost(groups: { Group }): number
	local total = 0
	for _, group in groups do
		total += Config.Get("Monsters", group.Type).ThreatCost * group.Count
	end
	return total
end

export type Point = { Id: string, Weight: number }

-- One point, by weight (dark rooms count double, barricaded points less: BreachService).
function Threat.Pick(points: { Point }, rng: Random): Point?
	local total = 0
	for _, point in points do
		total += math.max(point.Weight, 0)
	end
	if total <= 0 then
		return nil
	end
	local roll = rng:NextNumber() * total
	for _, point in points do
		roll -= math.max(point.Weight, 0)
		if roll <= 0 then
			return point
		end
	end
	return points[#points]
end

-- Target priority: which of a monster's Targets it goes for, given what is available. Targets
-- is the type's own order (Section 10: residents first, then machines, then players who hit
-- them; each type its own); available says which kinds have a reachable target now.
function Threat.Choose(targets: { string }, available: { [string]: boolean }): string?
	for _, kind in targets do
		if available[kind] then
			return kind
		end
	end
	return nil
end

return Threat
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000AF"><Properties><string name="Name">Votes</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Rules.Votes: how a vote is decided (bible Section 8). Pure, so VoteService, the vote banner
	and the data tests share it.

	* Each kind of vote has a rule (Config.Votes):
	  * MoreYes: more yes than no when time is up.
	  * WholeTeamMajority: more than half of the whole team says yes.
	  * TwoThirdsOfOthers: a kick needs two thirds of the other players.
	  * MostVotes: a draft goes to the most votes, ties picked at random (Winner).
	* Not voting is abstaining. Ties fail, unless a tie-breaker (the Warden, Prompt 20) says yes.
	  A whole-team vote ties when the team splits evenly (2 yes and 2 no of 4).
	* Everyone saying yes passes a vote at once (Tuning.Votes.PassEarlyWhenAllYes).
	* Spending more than BigSpendFraction (40%) of any stock needs a majority of the whole team.
]]

local Config = require(script.Parent.Parent.Config)

export type Rule = "MoreYes" | "WholeTeamMajority" | "TwoThirdsOfOthers" | "MostVotes"
export type Result = "Pass" | "Fail" | "Tie"

local Votes = {}

function Votes.Tuning(): { [string]: any }
	return Config.Get("Tuning", "Votes")
end

-- The yes votes a majority of `team` needs: more than half.
function Votes.Majority(team: number): number
	return math.floor(team / 2) + 1
end

-- Two thirds of `others`, rounded up.
function Votes.TwoThirds(others: number): number
	return math.ceil(others * 2 / 3 - 1e-9)
end

-- The result when time is up. `team` is everyone who can vote, abstainers included (for a
-- kick, the players other than the one it's against).
function Votes.Outcome(rule: Rule, yes: number, no: number, team: number): Result
	if rule == "MoreYes" then
		return if yes > no then "Pass" elseif yes < no then "Fail" else "Tie"
	elseif rule == "WholeTeamMajority" then
		if yes * 2 > team then
			return "Pass"
		elseif yes == no and yes * 2 == team then
			return "Tie"
		end
		return "Fail"
	elseif rule == "TwoThirdsOfOthers" then
		return if team > 0 and yes >= Votes.TwoThirds(team) then "Pass" else "Fail"
	end
	error(`Rules.Votes.Outcome: a {rule} vote is decided by Winner`)
end

-- Everyone has said yes: the vote passes at once.
function Votes.AllYes(yes: number, team: number): boolean
	return team > 0 and yes >= team and Votes.Tuning().PassEarlyWhenAllYes == true
end

-- Does spending `costs` take more than BigSpendFraction of any stock?
function Votes.BigSpend(costs: { [string]: number }?, stock: { [string]: number }): boolean
	local fraction = Votes.Tuning().BigSpendFraction
	for id, amount in costs or {} do
		if amount > 0 and amount > fraction * (stock[id] or 0) then
			return true
		end
	end
	return false
end

-- The rule a vote of `kind` follows; a big spend turns "more yes than no" into a whole-team majority.
function Votes.RuleFor(kind: string, bigSpend: boolean): Rule
	local rule: Rule = Config.Get("Votes", kind).Rule
	if bigSpend and rule == "MoreYes" then
		return "WholeTeamMajority"
	end
	return rule
end

-- What the banner says a vote needs.
function Votes.NeedText(rule: Rule, team: number): string
	if rule == "MoreYes" then
		return "MORE YES THAN NO"
	elseif rule == "WholeTeamMajority" then
		return `{Votes.Majority(team)} OF {team} MUST SAY YES`
	elseif rule == "TwoThirdsOfOthers" then
		return `{Votes.TwoThirds(team)} OF {team} MUST SAY YES`
	end
	return "MOST VOTES WINS"
end

-- A MostVotes vote: the option with the most votes, ties picked at random. `order` lists the
-- options (so ties break the same way for the same Random); nil when there are none.
function Votes.Winner(counts: { [string]: number }, order: { string }, random: Random): string?
	local best, tied = -1, {}
	for _, option in order do
		local n = counts[option] or 0
		if n > best then
			best, tied = n, { option }
		elseif n == best then
			table.insert(tied, option)
		end
	end
	if #tied == 0 then
		return nil
	end
	return tied[random:NextInteger(1, #tied)]
end

return Votes
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="RBX000000B0"><Properties><string name="Name">RunState</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	RunState: the run's small values, replicated as attributes on this ModuleScript (bible
	Section 23: small values such as the year and the cycle phase replicate as attributes;
	collections go through the delta channel).

	One list of names, types, meanings and owners, like Remotes for events. Each value has
	one writer: the service that owns it gets a setter with RunState.Writer("CycleClock") and
	can only set its own values. Anything on either side reads with RunState.Get and
	RunState.Changed. In the Lobby nothing is set.

	Times are server time (workspace:GetServerTimeNow()), so every client counts down to the
	same moment; RunState.TimeLeft() does the sum.

	Players also carry two attributes the clock reads for skips (CycleClock writes them):
	Ready (pressed Ready this day) and Resting (lying in a Quarters bed).

	The stockpile (EconomyService): one value per stocked resource in Config.Resources (Food,
	Water, Scrap, Iron, Copper, Crystal, Medkits, Ammo), plus Research.
	Power (PowerService): PowerMade, PowerUsed, PowerNeeded and DarkRooms.
	Threat (ThreatDirector): Threat and Monsters.
	Disasters (DisasterService, Prompt 13): Fires, BlackoutRooms, Rubble, Meltdown, MeltdownEndsAt
	and ValvesTurned.
	Digging (DigService, Prompt 14): Disturbance, DigLimit, DigSeed, TremorAt and Nests.
]]

local RunService = game:GetService("RunService")

local Config = require(script.Parent.Config)

export type RunPhase = "Waiting" | "Intro" | "Playing" | "Ended"
export type CyclePhase = "Day" | "Surge"
export type Outcome = "CenturyVictory" | "DeepVictory" | "Defeat"
export type Writer = "RunDirector" | "CycleClock" | "ObjectiveService" | "EconomyService" | "PowerService" | "ThreatDirector"
	| "DisasterService" | "DigService"

type Field = {
	Type: "string" | "number" | "boolean",
	By: Writer,
	Values: { string }?,
	Doc: string,
}

local FIELDS: { [string]: Field } = {
	-- RunDirector: the run's lifecycle
	RunPhase = { Type = "string", By = "RunDirector", Values = { "Waiting", "Intro", "Playing", "Ended" }, Doc = "where the run is" },
	IntroEndsAt = { Type = "number", By = "RunDirector", Doc = "server time the intro ends and the run clock starts (Intro only)" },
	Difficulty = { Type = "string", By = "RunDirector", Doc = "Normal, Hard or Nightmare (Config.Difficulties)" },
	Outcome = { Type = "string", By = "RunDirector", Values = { "CenturyVictory", "DeepVictory", "Defeat" }, Doc = "how the run ended (Ended only)" },
	DefeatReason = { Type = "string", By = "RunDirector", Values = { "ReactorDestroyed", "ResidentsLost" }, Doc = "why the bunker fell (Defeat only): the Reactor Core melted down, or the last resident died" },
	Victory = { Type = "string", By = "RunDirector", Values = { "Century", "Deep" }, Doc = "the victory this run won; kept through Endless" },
	Endless = { Type = "boolean", By = "RunDirector", Doc = "Keep Going passed: the run carries on past Year 100 with stronger Surges" },

	-- CycleClock: cycles, phases and the year counter
	Cycle = { Type = "number", By = "CycleClock", Doc = "the cycle number, from 1" },
	Year = { Type = "number", By = "CycleClock", Doc = "the year counter, from 1" },
	Era = { Type = "string", By = "CycleClock", Doc = "the era the year is in (Config.Eras)" },
	YearsPerCycle = { Type = "number", By = "CycleClock", Doc = "how far the year jumps at the end of this cycle" },
	CyclePhase = { Type = "string", By = "CycleClock", Values = { "Day", "Surge" }, Doc = "the phase of the cycle (from the first day on)" },
	PhaseLength = { Type = "number", By = "CycleClock", Doc = "seconds the current phase lasts in all" },
	PhaseEndsAt = { Type = "number", By = "CycleClock", Doc = "server time the phase ends; nil while the clock is stopped or the phase has no timer" },
	PhaseLeft = { Type = "number", By = "CycleClock", Doc = "seconds left, only while the clock is stopped" },
	PhaseOpen = { Type = "boolean", By = "CycleClock", Doc = "the phase has no timer: a boss Surge lasts until its boss is beaten" },
	Siren = { Type = "boolean", By = "CycleClock", Doc = "the Surge siren is sounding: the last 20 seconds of a day" },
	SurgeKind = { Type = "string", By = "CycleClock", Values = { "Tutorial", "Normal", "Boss", "Final", "Endless" }, Doc = "the coming Surge (during a day) or the current one" },
	SurgeBoss = { Type = "string", By = "CycleClock", Doc = "the boss of a Boss or Final Surge (Config.Bosses)" },
	ReadyCount = { Type = "number", By = "CycleClock", Doc = "players ready to skip: Ready pressed, or resting in a Quarters bed" },
	ReadyNeeded = { Type = "number", By = "CycleClock", Doc = "players in the run; when all are ready, the day skips to the siren" },
	Paused = { Type = "boolean", By = "CycleClock", Doc = "DevTools paused the clock" },
	TimeScale = { Type = "number", By = "CycleClock", Doc = "DevTools time scale (nil means 1)" },

	-- ObjectiveService: what makes more years pass per cycle
	LostCrews = { Type = "number", By = "ObjectiveService", Doc = "Lost Crews rescued" },
	BossesBeaten = { Type = "number", By = "ObjectiveService", Doc = "era bosses beaten" },

	-- EconomyService: Lab research so far (the stock amounts are added below from Config.Resources)
	Research = { Type = "number", By = "EconomyService", Doc = "Lab research so far (level 3 upgrades need it)" },

	-- PowerService: the live power balance (Power is not a stock)
	PowerMade = { Type = "number", By = "PowerService", Doc = "power the Reactor Core and Generators make now" },
	PowerUsed = { Type = "number", By = "PowerService", Doc = "power the lit rooms draw" },
	PowerNeeded = { Type = "number", By = "PowerService", Doc = "power every room would draw" },
	DarkRooms = { Type = "number", By = "PowerService", Doc = "rooms dark for want of power" },
	-- ThreatDirector (Prompt 12): the danger now
	Threat = { Type = "number", By = "ThreatDirector", Doc = "the threat level (Section 10), rounded" },
	Monsters = { Type = "number", By = "ThreatDirector", Doc = "monsters on the map plus those queued at the cap" },

	-- DisasterService (Prompt 13): disasters now (the details are the Disasters collection)
	Fires = { Type = "number", By = "DisasterService", Doc = "rooms on fire" },
	BlackoutRooms = { Type = "number", By = "DisasterService", Doc = "rooms and tunnels dark in a blackout (0: none)" },
	Rubble = { Type = "number", By = "DisasterService", Doc = "piles of rubble blocking the way" },
	Meltdown = { Type = "boolean", By = "DisasterService", Doc = "the Reactor Core is melting down (Section 10)" },
	MeltdownEndsAt = { Type = "number", By = "DisasterService", Doc = "server time the meltdown loses the run (Meltdown only)" },
	ValvesTurned = { Type = "number", By = "DisasterService", Doc = "the meltdown valves turned now, 0 to 3 (Meltdown only)" },

	-- DigService (Prompt 14): Disturbance and digging
	Disturbance = { Type = "number", By = "DigService", Doc = "the Disturbance meter, 0 to 100 (Section 10): the HUD's seismograph" },
	DigLimit = { Type = "number", By = "DigService", Doc = "the deepest floor the team may dig without a Push Deeper vote (3, then 6, 9, 10)" },
	DigSeed = { Type = "number", By = "DigService", Doc = "the run's seed for what dug cells hold (Rules.Dig.Roll), so the Driller's hints match" },
	TremorAt = { Type = "number", By = "DigService", Doc = "server time of the last Tremor (clients shake the camera)" },
	Nests = { Type = "number", By = "DigService", Doc = "nests alive in the bunker" },
}

-- EconomyService: one value per stocked resource (Config.Resources, Kind "Stock"), its amount
-- in the team's stockpile. Power is a live balance, not a stock.
for _, id in Config.Ids("Resources") do
	local resource = Config.Get("Resources", id)
	if resource.Kind == "Stock" then
		assert(FIELDS[id] == nil, `RunState: the resource {id} clashes with a RunState value`)
		FIELDS[id] = { Type = "number", By = "EconomyService", Doc = `{resource.Name} in the stockpile` }
	end
end

for name, field in FIELDS do
	local values = field.Values
	if values then
		table.freeze(values)
	end
	table.freeze(field)
	assert(string.find(name, "^%u%w*$"), `RunState: {name} must be PascalCase`)
end
table.freeze(FIELDS)

local IS_SERVER = RunService:IsServer()

local RunState = {}

RunState.Fields = FIELDS

-- Is `value` allowed for `name`? (nil always is: it clears the value.)
function RunState.Check(name: string, value: any): (boolean, string?)
	local field = FIELDS[name]
	if not field then
		return false, `no RunState value {tostring(name)}`
	end
	if value == nil then
		return true
	end
	if type(value) ~= field.Type then
		return false, `{name} is a {field.Type}, got a {typeof(value)}`
	end
	if field.Type == "number" and (value ~= value or math.abs(value) == math.huge) then
		return false, `{name} must be a finite number`
	end
	if field.Values and not table.find(field.Values, value) then
		return false, `{name} can't be {tostring(value)}`
	end
	return true
end

-- Server: a setter for the values `writer` owns. Setting anything else is an error.
function RunState.Writer(writer: Writer): (name: string, value: any) -> ()
	return function(name: string, value: any)
		local field = FIELDS[name]
		if not field then
			error(`RunState: no value {tostring(name)}`, 2)
		end
		if field.By ~= writer then
			error(`RunState: {name} belongs to {field.By}, not {writer}`, 2)
		end
		local ok, why = RunState.Check(name, value)
		if not ok then
			error(`RunState: {why}`, 2)
		end
		if not IS_SERVER then
			error("RunState: values are set on the server", 2)
		end
		script:SetAttribute(name, value)
	end
end

function RunState.Get(name: string): any
	assert(FIELDS[name], `RunState: no value {tostring(name)}`)
	return script:GetAttribute(name)
end

function RunState.Changed(name: string): RBXScriptSignal
	assert(FIELDS[name], `RunState: no value {tostring(name)}`)
	return script:GetAttributeChangedSignal(name)
end

-- Every value that is set.
function RunState.All(): { [string]: any }
	local values = {}
	for name in FIELDS do
		values[name] = script:GetAttribute(name)
	end
	return values
end

-- Seconds left in the intro or the current cycle phase (nil when nothing is counting down).
function RunState.TimeLeft(): number?
	if script:GetAttribute("RunPhase") == "Intro" then
		local introEndsAt = script:GetAttribute("IntroEndsAt")
		if type(introEndsAt) == "number" then
			return math.max(0, introEndsAt - workspace:GetServerTimeNow())
		end
		return nil
	end
	local endsAt = script:GetAttribute("PhaseEndsAt")
	if type(endsAt) == "number" then
		return math.max(0, endsAt - workspace:GetServerTimeNow())
	end
	local left = script:GetAttribute("PhaseLeft")
	return if type(left) == "number" then left else nil
end

return table.freeze(RunState)
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B1"><Properties><string name="Name">Types</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	Types: definitions that cross module or network boundaries.

	Require this module for its types only (`local Types = require(Shared.Types)`, then
	`Types.Module`). Content entry types arrive with Prompt 1 (Config schemas).
]]

export type PlaceKind = "Lobby" | "Run"

-- The registry a service or controller receives in Init: only its declared dependencies
-- can be read from it (Loader enforces this).
export type Registry = { [string]: any }

-- A service (server) or controller (client). Every ModuleScript in Services/ or
-- Controllers/ returns one of these, with Name equal to the ModuleScript's name.
export type Module = {
	Name: string,
	Dependencies: { string }?,
	Init: ((self: any, registry: Registry) -> ())?,
	Start: ((self: any) -> ())?,
	[string]: any,
}

-- One change on the delta channel: { op, collection, key, value } (see Utilities.Delta).
export type DeltaOp = { any }

-- A DevTools command (DevService:Register).
export type DevCommand = {
	Description: string,
	Usage: string?,
	Run: (player: Player?, args: { any }) -> string?,
}

return {}
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX000000B2"><Properties><string name="Name">UIContract</string><ProtectedString name="Source"><![CDATA[--!strict
--[[
	UIContract: what the UI layout must provide for the code (bible Section 18).

	The layout is real instances in StarterGui, built through the Studio connector
	(studio/ui/Frame.lua and HUD.lua) and then given Landon's AutoScale Lite pass; code only
	clones templates and sets text and images. This list is the contract between the two: the
	controllers find these paths, and StructureCheck fails if one is missing, so a rebuilt or
	hand-edited screen can't drift away from the code.

	Paths are relative to the ScreenGui, with "." between names.
]]

export type Screen = {
	Places: { string }, -- "Lobby", "Run"
	DisplayOrder: number,
	Paths: { string },
}

local UIContract: { [string]: Screen } = {
	Frame = {
		Places = { "Lobby", "Run" },
		DisplayOrder = 5,
		Paths = {
			"Dim",
			"Cabinet.Backplate",
			"Cabinet.DockPlates",
			"Cabinet.TopBar.Title.Text",
			"Cabinet.TopBar.Subtitle",
			"Cabinet.TopBar.Chips",
			"Cabinet.TopBar.Close",
			"Cabinet.Pages",
			"Cabinet.MainAction.Content.Label",
			"Cabinet.MainAction.Content.Icon",
			"Cabinet.MainAction.Content.Price",
			"Cabinet.Footer.Actions",
			"Cabinet.Footer.Hint",
			"Cabinet.Footer.Keys",
			"Templates.Page.Tabs",
			"Templates.Page.Content.Grid",
			"Templates.Page.Content.List",
			"Templates.Page.Content.Empty",
			"Templates.Page.Detail.Hero.Image",
			"Templates.Page.Detail.Tag",
			"Templates.Page.Detail.Name",
			"Templates.Page.Detail.Sub",
			"Templates.Page.Detail.Body",
			"Templates.Tab.Content.Icon",
			"Templates.Tab.Content.Label",
			"Templates.Chip.Icon",
			"Templates.Chip.Amount",
			"Templates.Card.Portrait",
			"Templates.Card.Tag",
			"Templates.Card.Name",
			"Templates.Card.Sub",
			"Templates.Card.Lamp",
			"Templates.Card.Price.Amount",
			"Templates.Card.Stamp",
			"Templates.Row.Icon",
			"Templates.Row.Name",
			"Templates.Row.Value",
			"Templates.Section.Label",
			"Templates.Section.Body",
			"Templates.FooterButton.Content.Label",
			-- the Command View (Prompt 7)
			"DamageEdge",
			"Cabinet.Pages.CommandView.Tabs",
			"Cabinet.Pages.CommandView.View.Marks",
			"Cabinet.Pages.CommandView.View.Labels",
			"Cabinet.Pages.CommandView.View.Cursor",
			"Cabinet.Pages.CommandView.View.Help.Text",
			"Cabinet.Pages.CommandView.Detail.Name",
			"Cabinet.Pages.CommandView.Detail.Sub",
			"Cabinet.Pages.CommandView.Detail.Body",
			"Cabinet.Pages.CommandView.Detail.Options",
			"Templates.RoomLabel.Name",
			"Templates.RoomLabel.Lamp",
			"Templates.RoomLabel.Reading", -- Prompt 9: the overlay reading under a room label
			"Templates.RoomLabel.Reading.Text",
			"Templates.CellMark.Label",
			"Templates.PingMark",
			"Templates.OptionRow.Name",
			"Templates.OptionRow.Value",
			"Templates.OptionRow.Lamp",
		},
	},
	Votes = { -- the vote telegram (Prompt 8), above The Frame so a vote can be answered from any screen
		Places = { "Run" },
		DisplayOrder = 6,
		Paths = {
			"VoteBanner",
			"VoteBanner.Proposal",
			"VoteBanner.Tally",
			"VoteBanner.Timer",
			"VoteBanner.Timer.Fill",
			"VoteBanner.Yes",
			"VoteBanner.Yes.Content.Label",
			"VoteBanner.Yes.Key", -- Prompt 9: the controller's key chips (tap Y, hold Y)
			"VoteBanner.Yes.Key.Text",
			"VoteBanner.No",
			"VoteBanner.No.Content.Label",
			"VoteBanner.No.Key",
			"VoteBanner.No.Key.Text",
		},
	},
	HUD = {
		Places = { "Run" },
		DisplayOrder = 1,
		Paths = {
			"Vitals.Health.Needle",
			"Vitals.Health.Value",
			"Vitals.Stamina.Needle",
			"Vitals.Radiation.Needle",
			"Vitals.Ability.Icon",
			"Vitals.Ability.Cooldown",
			"Vitals.Ability.Key.Text",
			"Vitals.AbilityName",
			"Vitals.Class",
			"YearClock.Tile1.Digit",
			"YearClock.Tile2.Digit",
			"YearClock.Tile3.Digit",
