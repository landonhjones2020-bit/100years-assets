"Chest","parent":"Pelvis","jointName":"ChestJoint","joint":[0.0,2.03,-0.7]},{"name":"Head","parent":"Chest","jointName":"HeadJoint","joint":[0.0,2.33,-1.85]},{"name":"Jaw","parent":"Head","jointName":"JawJoint","joint":[0.0,2.13,-2.1]},{"name":"FrontLeftLeg","parent":"Chest","jointName":"FrontLeftLegJoint","joint":[-0.55,1.83,-1.35]},{"name":"FrontLeftPaw","parent":"FrontLeftLeg","jointName":"FrontLeftPawJoint","joint":[-0.6,0.98,-1.45]},{"name":"FrontRightLeg","parent":"Chest","jointName":"FrontRightLegJoint","joint":[0.55,1.83,-1.35]},{"name":"FrontRightPaw","parent":"FrontRightLeg","jointName":"FrontRightPawJoint","joint":[0.6,0.98,-1.45]},{"name":"Tail","parent":"Pelvis","jointName":"TailJoint","joint":[0.0,2.03,1.35]},{"name":"BackLeftLeg","parent":"Pelvis","jointName":"BackLeftLegJoint","joint":[-0.58,1.73,0.75]},{"name":"BackLeftPaw","parent":"BackLeftLeg","jointName":"BackLeftPawJoint","joint":[-0.62,0.93,0.9]},{"name":"BackRightLeg","parent":"Pelvis","jointName":"BackRightLegJoint","joint":[0.58,1.73,0.75]},{"name":"BackRightPaw","parent":"BackRightLeg","jointName":"BackRightPawJoint","joint":[0.62,0.93,0.9]}],"root":"HumanoidRootPart","rigType":"Custom","hrpSize":[1.6,1.4,3.6],"hrpCenter":[0.0,1.93,-0.3],"hipHeight":1.1},"fbx_sha1":"06b902410290c6af","attrs":{"Role":"Runner","Band":"Mines","HitTime":0.45}}]==]), { assetId = "111045663637462", swatchHex = hexes, clips = {Walk = "rbxassetid://87238019294136", Attack = "rbxassetid://134469102219911"} }) table.insert(report, "Monster_TunnelHound: " .. tostring(r)) end end
do local m = pipe:FindFirstChild("Monster_BurrowTick") if not m then table.insert(report, "Monster_BurrowTick: not in Pipeline") else local ok, r = pcall(AssetSetup.rig, m, HttpService:JSONDecode([==[{"asset":"Monster_BurrowTick","category":"Monsters","size":[3.492,1.766,3.213],"tris":2028,"parts":[{"name":"Body","material":"SmoothPlastic","transparency":0.0,"collision":"query","castShadow":true,"bone":"Body","swatches":["basalt"],"offset":[0.0,1.084,0.312],"size":[2.195,1.308,2.589]},{"name":"BodyGlow","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"bone":"Body","swatches":["glow"],"offset":[0.0,1.101,0.678],"size":[1.4,1.235,1.248]},{"name":"Head","material":"SmoothPlastic","transparency":0.0,"collision":"query","castShadow":true,"bone":"Head","swatches":["basalt"],"offset":[0.0,0.775,-1.036],"size":[0.985,0.857,1.142]},{"name":"HeadGlow","material":"Neon","transparency":0.0,"collision":"none","castShadow":false,"bone":"Head","swatches":["glow"],"offset":[0.0,0.948,-1.134],"size":[0.757,0.182,0.261]},{"name":"LeftLeg1","material":"SmoothPlastic","transparency":0.0,"collision":"query","castShadow":true,"bone":"LeftLeg1","swatches":["basalt"],"offset":[-1.18,0.732,-0.416],"size":[1.099,1.438,0.5]},{"name":"RightLeg1","material":"SmoothPlastic","transparency":0.0,"collision":"query","castShadow":true,"bone":"RightLeg1","swatches":["basalt"],"offset":[1.18,0.732,-0.416],"size":[1.099,1.438,0.5]},{"name":"LeftLeg2","material":"SmoothPlastic","transparency":0.0,"collision":"query","castShadow":true,"bone":"LeftLeg2","swatches":["basalt"],"offset":[-1.181,0.729,0.308],"size":[1.111,1.446,0.26]},{"name":"RightLeg2","material":"SmoothPlastic","transparency":0.0,"collision":"query","castShadow":true,"bone":"RightLeg2","swatches":["basalt"],"offset":[1.181,0.729,0.308],"size":[1.111,1.446,0.26]},{"name":"LeftLeg3","material":"SmoothPlastic","transparency":0.0,"collision":"query","castShadow":true,"bone":"LeftLeg3","swatches":["basalt"],"offset":[-